#Область ОписаниеПеременных

Перем КэшОтбораПоПрефиксу;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Запоминает флажок формы узла после записи настроек.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
Процедура СохранитьОтборПоПрефиксу(Форма) Экспорт

	ЗначениеОтбора = ЗначениеОтбораНаФорме(Форма);
	Если ЗначениеОтбора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СсылкаУзла = СсылкаУзлаФормы(Форма);
	Если Не ЗначениеЗаполнено(СсылкаУзла) Тогда
		Возврат;
	КонецЕсли;

	Ключ = КлючУзла(СсылкаУзла);
	СохраненноеЗначение = Кэш().Получить(Ключ);
	Если СохраненноеЗначение = Неопределено Тогда
		СохраненноеЗначение = бит_РегистрацияДокументовБПВызовСервера.ОтборПоПрефиксуВключен(СсылкаУзла);
	КонецЕсли;
	Если СохраненноеЗначение = ЗначениеОтбора Тогда
		Кэш().Вставить(Ключ, ЗначениеОтбора);
		Возврат;
	КонецЕсли;

	бит_РегистрацияДокументовБПВызовСервера.УстановитьОтборПоПрефиксу(СсылкаУзла, ЗначениеОтбора);
	Кэш().Вставить(Ключ, ЗначениеОтбора);

КонецПроцедуры

// Пишет флажок, если форма узла уже записана, а признак на ней отличается от сохраненного.
// Форма настроек синхронизации не отдает поле в общий модуль при записи, поэтому значение
// читается с открытой формы после того, как модифицированность снята.
//
Процедура ПроверитьСохранениеОтбораПоПрефиксу() Экспорт

	Попытка
		Для Каждого Форма Из ОткрытыеФормы() Цикл
			СохранитьОтборЕслиФормаЗаписана(Форма);
		КонецЦикла;
	Исключение
		Возврат;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СохранитьОтборЕслиФормаЗаписана(Форма)

	ЗначениеОтбора = ЗначениеОтбораНаФорме(Форма);
	Если ЗначениеОтбора = Неопределено Или Форма.Модифицированность Тогда
		Возврат;
	КонецЕсли;

	СсылкаУзла = СсылкаУзлаФормы(Форма);
	Если Не ЗначениеЗаполнено(СсылкаУзла) Тогда
		Возврат;
	КонецЕсли;

	Ключ = КлючУзла(СсылкаУзла);
	СохраненноеЗначение = Кэш().Получить(Ключ);
	Если СохраненноеЗначение = Неопределено Тогда
		СохраненноеЗначение = бит_РегистрацияДокументовБПВызовСервера.ОтборПоПрефиксуВключен(СсылкаУзла);
		Кэш().Вставить(Ключ, СохраненноеЗначение);
	КонецЕсли;

	Если ЗначениеОтбора = СохраненноеЗначение Тогда
		Возврат;
	КонецЕсли;

	бит_РегистрацияДокументовБПВызовСервера.УстановитьОтборПоПрефиксу(СсылкаУзла, ЗначениеОтбора);
	Кэш().Вставить(Ключ, ЗначениеОтбора);

КонецПроцедуры

Функция ОткрытыеФормы()

	Формы = Новый Массив;
	Для Каждого ОкноПриложения Из ПолучитьОкна() Цикл
		Попытка
			Содержимое = ОкноПриложения.Содержимое;
			Если Содержимое = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(Содержимое) = Тип("ФормаКлиентскогоПриложения") Тогда
				Формы.Добавить(Содержимое);
			Иначе
				Для Каждого Форма Из Содержимое Цикл
					Формы.Добавить(Форма);
				КонецЦикла;
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	Возврат Формы;

КонецФункции

Функция ЗначениеОтбораНаФорме(Форма)

	Попытка
		ЗначениеОтбора = Форма["бит_ОтбиратьДокументыПоПрефиксу"];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(ЗначениеОтбора) <> Тип("Булево") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЗначениеОтбора;

КонецФункции

Функция СсылкаУзлаФормы(Форма)

	Попытка
		Возврат Форма.Объект.Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция КлючУзла(СсылкаУзла)

	Возврат Строка(СсылкаУзла.УникальныйИдентификатор());

КонецФункции

Функция Кэш()

	Если КэшОтбораПоПрефиксу = Неопределено Тогда
		КэшОтбораПоПрефиксу = Новый Соответствие;
	КонецЕсли;

	Возврат КэшОтбораПоПрефиксу;

КонецФункции

#КонецОбласти
