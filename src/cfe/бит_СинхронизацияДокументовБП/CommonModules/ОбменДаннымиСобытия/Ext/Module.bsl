
&После("МеханизмРегистрацииОбъектовПередЗаписьюДокумента")
Процедура бит_МеханизмРегистрацииОбъектовПередЗаписьюДокумента(ИмяПланаОбмена, Источник, Отказ, РежимЗаписи, РежимПроведения)

	Если Отказ Или ИмяПланаОбмена <> "СинхронизацияДанныхЧерезУниверсальныйФормат" Тогда
		Возврат;
	КонецЕсли;

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Типовая подписка уже отработала. Отбор по префиксу и проводкам 41.01
	// решает, останется ли регистрация на узлах УТ.
	бит_РегистрацияДокументовБП.ПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения);

КонецПроцедуры

&После("ВыполнитьПравилаРегистрацииОбъектовДляПланаОбмена")
Процедура бит_ВыполнитьПравилаРегистрацииОбъектовДляПланаОбмена(МассивУзловРезультат, Объект, ИмяПланаОбмена, ДополнительныеПараметры)

	бит_РегистрацияДокументовБП.ОграничитьУзлыРегистрацииДокумента(
		МассивУзловРезультат, Объект, ИмяПланаОбмена, ДополнительныеПараметры);

КонецПроцедуры

&После("МеханизмРегистрацииОбъектовПередУдалением")
Процедура бит_МеханизмРегистрацииОбъектовПередУдалением(ИмяПланаОбмена, Источник, Отказ)

	Если Отказ Или ИмяПланаОбмена <> "СинхронизацияДанныхЧерезУниверсальныйФормат" Тогда
		Возврат;
	КонецЕсли;

	Если Не ОбщегоНазначения.ЭтоДокумент(Источник.Метаданные()) Тогда
		Возврат;
	КонецЕсли;

	бит_РегистрацияДокументовБП.ОграничитьРегистрациюДокумента(Источник);

КонецПроцедуры

&После("ПриОтправкеДанныхКорреспонденту")
Процедура бит_ПриОтправкеДанныхКорреспонденту(ЭлементДанных, ОтправкаЭлемента, СозданиеНачальногоОбраза, Получатель, Анализ)

	// Очередь сама по себе документ не пропускает: списание без 41.01
	// типовая синхронизация тоже регистрирует. Решение принимается здесь.
	Если Получатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ОтправкаЭлемента = ОтправкаЭлементаДанных.Игнорировать Тогда
		Возврат;
	КонецЕсли;

	// Присваивание здесь, в перехватчике: вложенная процедура может не донести
	// Игнорировать, и типовая выгрузка тогда отправляет документ как Авто или Удалить.
	Решение = бит_РегистрацияДокументовБП.РешениеОбОтправкеВУТ(ЭлементДанных, Получатель, Анализ);
	Если Решение <> Неопределено Тогда
		ОтправкаЭлемента = Решение;
	КонецЕсли;

КонецПроцедуры
