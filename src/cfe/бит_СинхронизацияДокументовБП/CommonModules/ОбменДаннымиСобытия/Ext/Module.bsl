
&После("МеханизмРегистрацииОбъектовПередЗаписьюДокумента")
Процедура бит_МеханизмРегистрацииОбъектовПередЗаписьюДокумента(ИмяПланаОбмена, Источник, Отказ, РежимЗаписи, РежимПроведения)

	Если Отказ Или ИмяПланаОбмена <> "СинхронизацияДанныхЧерезУниверсальныйФормат" Тогда
		Возврат;
	КонецЕсли;

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Типовая подписка уже отработала. Проводки 41.01 запоминаем, пока старые
	// движения еще лежат в регистре, и ограничиваем получателей.
	бит_РегистрацияДокументовБП.ПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения);
	бит_РегистрацияДокументовБП.ПриЗаписиДокумента(Источник, Отказ);

КонецПроцедуры

&После("МеханизмРегистрацииОбъектовПередУдалением")
Процедура бит_МеханизмРегистрацииОбъектовПередУдалением(ИмяПланаОбмена, Источник, Отказ)

	Если Отказ Или ИмяПланаОбмена <> "СинхронизацияДанныхЧерезУниверсальныйФормат" Тогда
		Возврат;
	КонецЕсли;

	Если Не ОбщегоНазначения.ЭтоДокумент(Источник.Метаданные()) Тогда
		Возврат;
	КонецЕсли;

	бит_РегистрацияДокументовБП.ОграничитьРегистрациюДокумента(Источник);

КонецПроцедуры

&После("ПриОтправкеДанныхКорреспонденту")
Процедура бит_ПриОтправкеДанныхКорреспонденту(ЭлементДанных, ОтправкаЭлемента, СозданиеНачальногоОбраза, Получатель, Анализ)

	// Анализ только показывает состав выгрузки. Начальный образ фильтруется так же, как обычная отправка.
	Если Анализ Или Получатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ОтправкаЭлемента = ОтправкаЭлементаДанных.Игнорировать
		Или ОтправкаЭлемента = ОтправкаЭлементаДанных.Удалить Тогда
		Возврат;
	КонецЕсли;

	бит_РегистрацияДокументовБП.ОграничитьОтправкуПоСчету4101(ЭлементДанных, ОтправкаЭлемента, Получатель);

КонецПроцедуры
