#Область ПрограммныйИнтерфейс

// Включает автоматическую отправку документов в узлы управления торговлей,
// если для них выбран ручной режим. Режим «не отправлять» не меняется.
// Если после записи снова включили ручную отправку, следующий запуск переключит ее опять.
//
Процедура ВключитьАвтоматическуюОтправкуВУТ() Экспорт

	ОтключитьБезопасныйРежимРасширения();
	ВключитьАвтоматическуюОтправкуВУТВнутр(Неопределено);

КонецПроцедуры

Процедура ВключитьАвтоматическуюОтправкуВУТВнутр(УзелОткрытойФормы)

	БылПривилегированныйРежим = ПривилегированныйРежим();
	Попытка
		Если Не БылПривилегированныйРежим Тогда
			УстановитьПривилегированныйРежим(Истина);
		КонецЕсли;

		Для Каждого Узел Из УзлыУправленияТорговлей() Цикл

			Попытка
				ПодготовитьАвтоотправкуУзла(Узел, УзелОткрытойФормы);
			Исключение
				ЗаписьЖурналаРегистрации(
					"бит_СинхронизацияДокументовБП",
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат,
					Узел,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;

		КонецЦикла;

		ВыключитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		ВыключитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Истина, если узел синхронизации относится к управлению торговлей.
//
// Параметры:
//  Узел - ПланОбменаСсылка.СинхронизацияДанныхЧерезУниверсальныйФормат
//       - ПланОбменаОбъект.СинхронизацияДанныхЧерезУниверсальныйФормат
//       - ДанныеФормыСтруктура
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоУзелУправленияТорговлей(Узел) Экспорт

	Если Узел = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	// На форме узла Объект — данные формы, у них нет метода Метаданные.
	Если ТипЗнч(Узел) = Тип("ДанныеФормыСтруктура") Тогда
		Если Узел.Свойство("ЭтотУзел") И Узел.ЭтотУзел Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Узел.Свойство("Ссылка") И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Узел.Ссылка)) И ЗначениеЗаполнено(Узел.Ссылка) Тогда
			Если ЭтоУзелУправленияТорговлей(Узел.Ссылка) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
		ВариантНастройки = Неопределено;
		Узел.Свойство("ВариантНастройки", ВариантНастройки);
		Если ЭтоКодВариантаУправленияТорговлей(ВариантНастройки) Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат НаименованиеУзлаУправленияТорговлей(НаименованиеДанныхФормы(Узел));
	КонецЕсли;

	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Узел)) И Не ЗначениеЗаполнено(Узел) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Узел.ЭтотУзел Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЭтоКодВариантаУправленияТорговлей(Узел.ВариантНастройки) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат НаименованиеУзлаУправленияТорговлей(Узел.Наименование);

КонецФункции

// Признак хранится в реквизите узла и записывается вместе с узлом.
//
// Параметры:
//  Узел - ПланОбменаСсылка.СинхронизацияДанныхЧерезУниверсальныйФормат
//       - ПланОбменаОбъект.СинхронизацияДанныхЧерезУниверсальныйФормат
//
// Возвращаемое значение:
//  Булево
//
Функция ОтборПоПрефиксуВключен(Узел) Экспорт

	Если Узел = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Узел)) И Не ЗначениеЗаполнено(Узел) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Узел.бит_ОтбиратьДокументыПоПрефиксу;

КонецФункции

// Снимает регистрацию удаления с узлов управления торговлей, если отбор включен,
// а в номере нет префикса информационной базы.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект
//
Процедура ОграничитьРегистрациюДокумента(ДокументОбъект) Экспорт

	Если ДокументОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если НомерСодержитПрефиксИнформационнойБазы(ДокументОбъект.Номер) Тогда
		Возврат;
	КонецЕсли;

	ИсключитьУзлыИзПолучателей(ДокументОбъект, УзлыУТСОтборомПоПрефиксу());

КонецПроцедуры

// Начальный образ не проходит через проведение, поэтому документы без текущих
// проводок 41.01 в него не попадают. Обычная отправка берет уже решенную очередь.
//
// Параметры:
//  ЭлементДанных - ДокументОбъект
//                - УдалениеОбъекта
//  ОтправкаЭлемента - ОтправкаЭлементаДанных
//  Получатель - ПланОбменаСсылка
//             - ПланОбменаОбъект
//
Процедура ОграничитьНачальныйОбразПоСчету4101(ЭлементДанных, ОтправкаЭлемента, Получатель) Экспорт

	Если ТипЗнч(ЭлементДанных) = Тип("УдалениеОбъекта") Тогда
		Возврат;
	КонецЕсли;

	ОбъектМетаданных = ЭлементДанных.Метаданные();
	Если Не ОбщегоНазначения.ЭтоДокумент(ОбъектМетаданных) Тогда
		Возврат;
	КонецЕсли;

	Узел = УзелПолучателя(Получатель);
	Если Не ЭтоУзелУправленияТорговлей(Узел) Тогда
		Возврат;
	КонецЕсли;

	Если ЕстьПроводкиПоСчету4101(ЭлементДанных.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ОтправкаЭлемента = ОтправкаЭлементаДанных.Игнорировать;
	Если ЗначениеЗаполнено(ЭлементДанных.Ссылка) Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, ЭлементДанных.Ссылка);
	КонецЕсли;

КонецПроцедуры

// Запись набора хозрасчетного выполняется в конце проведения и отмены проведения,
// когда новые строки уже сформированы, а старые проводки еще лежат в регистре.
//
// Параметры:
//  Источник - РегистрБухгалтерииНаборЗаписей.Хозрасчетный
//  Отказ - Булево
//  Замещение - Булево
//
Процедура ПередЗаписьюДвиженийХозрасчетный(Источник, Отказ, Замещение) Экспорт

	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Регистратор = РегистраторНабора(Источник);
	Если Регистратор = Неопределено Или Не ОбщегоНазначения.ЭтоДокумент(Регистратор.Метаданные()) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Регистратор) Тогда
		Возврат;
	КонецЕсли;

	// Чтение плана обмена и регистра идет от имени пользователя, который проводит документ.
	// Привилегированный режим включается до первого такого чтения и снимается даже при ошибке.
	БылПривилегированныйРежим = ПривилегированныйРежим();
	Попытка
		Если Не БылПривилегированныйРежим Тогда
			УстановитьПривилегированныйРежим(Истина);
		КонецЕсли;
		ЗарегистрироватьДвиженияХозрасчетного(Источник, Регистратор);
		ВыключитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		ВыключитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Добавляет признак отбора на форму узла синхронизации.
// Узел открытой формы отдельно не записывается: режим и флажок ставятся в данные формы,
// чтобы запись формы не вернула ручную отправку.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
Процедура ВывестиПризнакОтбора(Форма) Экспорт

	Если Не ЭтоУзелУправленияТорговлей(Форма.Объект) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьФлажокОтбораНаФорму(Форма);

	БылаМодифицированность = Форма.Модифицированность;
	СсылкаУзла = Неопределено;
	Форма.Объект.Свойство("Ссылка", СсылкаУзла);
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(СсылкаУзла)) И ЗначениеЗаполнено(СсылкаУзла) Тогда
		ВключитьАвтоматическуюОтправкуВУТВнутр(СсылкаУзла);
	Иначе
		ВключитьАвтоматическуюОтправкуВУТВнутр(Неопределено);
	КонецЕсли;

	ИзменилиДанные = ПрименитьАвтоотправкуКДаннымФормы(Форма.Объект);
	Если ИзменилиДанные Тогда
		Форма.Модифицированность = Истина;
	ИначеЕсли Не БылаМодифицированность Тогда
		Форма.Модифицированность = Ложь;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьФлажокОтбораНаФорму(Форма)

	Если Форма.Элементы.Найти("бит_ОтбиратьДокументыПоПрефиксу") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Колонка «Документы» формы узла плана обмена Бухгалтерии:
	// страница ПравилаОтправкиДанных, группа ГруппаДокументы.
	Родитель = ГруппаДокументовФормы(Форма);
	// Пустой родитель не даст открыть форму узла.
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Поле = Форма.Элементы.Добавить("бит_ОтбиратьДокументыПоПрефиксу", Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеФлажка;
	Поле.ПутьКДанным = "Объект.бит_ОтбиратьДокументыПоПрефиксу";
	Поле.Заголовок = НСтр("ru = 'Отбирать документы по префиксу информационной базы'");
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	Поле.Видимость = Истина;

КонецПроцедуры

// При включенном флажке номер без префикса базы снимается с узлов УТ.
// Проведение и отмена проведения с префиксом не трогают получателей:
// решение принимает запись набора хозрасчетного, когда новые строки уже есть,
// а старые проводки еще лежат в регистре.
// Обычная запись с префиксом снимает узел только если текущих проводок 41.01 нет.
// При выключенном флажке документ без проводок 41.01 снимается,
// кроме проведения и отмены проведения.
//
// Параметры:
//  Источник - ДокументОбъект
//  Отказ - Булево
//  РежимЗаписи - РежимЗаписиДокумента
//
Процедура ПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Подписка вызывается из привилегированного модуля ОбменДаннымиСобытия,
	// но код расширения сам привилегию не наследует. Если вызов пойдет мимо него,
	// чтение плана обмена и регистра все равно выполняется в привилегированном режиме.
	БылПривилегированныйРежим = ПривилегированныйРежим();
	Попытка
		Если Не БылПривилегированныйРежим Тогда
			УстановитьПривилегированныйРежим(Истина);
		КонецЕсли;
		ОграничитьПолучателейПередЗаписьюДокумента(Источник, РежимЗаписи);
		ВыключитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		ВыключитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ПриДобавленииПодсистемы(Описание) Экспорт

	Описание.Имя = "бит_СинхронизацияДокументовБП";
	Описание.Версия = "1.0.0.6";

КонецПроцедуры

Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.Процедура = "бит_РегистрацияДокументовБП.ВключитьАвтоматическуюОтправкуВУТ";
	Обработчик.НачальноеЗаполнение = Истина;
	Обработчик.РежимВыполнения = "Оперативно";

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "1.0.0.5";
	Обработчик.Процедура = "бит_РегистрацияДокументовБП.ИнициализироватьОтборДокументовПоПрефиксу";
	Обработчик.РежимВыполнения = "Оперативно";

	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "1.0.0.6";
	Обработчик.Процедура = "бит_РегистрацияДокументовБП.ВключитьАвтоматическуюОтправкуВУТ";
	Обработчик.РежимВыполнения = "Оперативно";

КонецПроцедуры

// Один раз включает флажок на уже существующих узлах управления торговлей.
// Повторно обработчик обновления не выполняется, поэтому выключенный флажок не возвращается.
//
Процедура ИнициализироватьОтборДокументовПоПрефиксу() Экспорт

	БылПривилегированныйРежим = ПривилегированныйРежим();
	Попытка
		Если Не БылПривилегированныйРежим Тогда
			УстановитьПривилегированныйРежим(Истина);
		КонецЕсли;

		Для Каждого Узел Из УзлыУправленияТорговлей() Цикл
			УстановитьПризнакОтбораНаУзле(Узел);
		КонецЦикла;

		ВыключитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		ВыключитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;

	ВключитьАвтоматическуюОтправкуВУТ();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Расширение, загруженное из файлов, включается в безопасном режиме.
// В нем УстановитьПривилегированныйРежим вызывает исключение и обрывает проведение.
// Флажок снимается при обновлении информационной базы. Новому сеансу он уже не мешает.
//
Процедура ОтключитьБезопасныйРежимРасширения()

	Отбор = Новый Структура("Имя", "бит_СинхронизацияДокументовБП");
	Найденные = РасширенияКонфигурации.Получить(Отбор);
	Если Найденные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Расширение = Найденные[0];
	НужноЗаписать = Ложь;
	Если Расширение.БезопасныйРежим Тогда
		Расширение.БезопасныйРежим = Ложь;
		НужноЗаписать = Истина;
	КонецЕсли;

	Защита = Расширение.ЗащитаОтОпасныхДействий;
	Если Защита.ПредупреждатьОбОпасныхДействиях Тогда
		Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
		Расширение.ЗащитаОтОпасныхДействий = Защита;
		НужноЗаписать = Истина;
	КонецЕсли;

	Если Не НужноЗаписать Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Расширение.Записать();
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось выключить безопасный режим расширения бит_СинхронизацияДокументовБП. Снимите у расширения флажки «Безопасный режим» и «Защита от опасных действий».'");
		ВызватьИсключение ТекстОшибки + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ВыключитьПривилегированныйРежим(БылПривилегированныйРежим)

	Если Не БылПривилегированныйРежим И ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

Процедура ЗарегистрироватьДвиженияХозрасчетного(Источник, Регистратор)

	Узлы = УзлыУправленияТорговлей();
	Если Узлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	НомерДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Регистратор, "Номер");
	ПрефиксПодходит = НомерСодержитПрефиксИнформационнойБазы(НомерДокумента);
	ЕстьПроводки = ЕстьПроводкиВНаборе(Источник) Или ЕстьПроводкиПоСчету4101(Регистратор);

	Для Каждого Узел Из Узлы Цикл
		Если ОтборПоПрефиксуВключен(Узел) И Не ПрефиксПодходит Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Регистратор);
			Продолжить;
		КонецЕсли;
		Если ЕстьПроводки Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Регистратор);
		Иначе
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Регистратор);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОграничитьПолучателейПередЗаписьюДокумента(Источник, РежимЗаписи)

	ПроведениеИлиОтмена = РежимЗаписи = РежимЗаписиДокумента.Проведение
		Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
	ЕстьПрефикс = НомерСодержитПрефиксИнформационнойБазы(Источник.Номер);

	УзлыСОтбором = УзлыУТСОтборомПоПрефиксу();
	Если УзлыСОтбором.Количество() > 0 Тогда
		Если Не ЕстьПрефикс Тогда
			ИсключитьУзлыИзПолучателей(Источник, УзлыСОтбором);
		ИначеЕсли Не ПроведениеИлиОтмена И Не ЕстьПроводкиПоСчету4101(Источник.Ссылка) Тогда
			ИсключитьУзлыИзПолучателей(Источник, УзлыСОтбором);
		КонецЕсли;
	КонецЕсли;

	УзлыБезОтбора = УзлыУТБезОтбораПоПрефиксу();
	Если УзлыБезОтбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ДокументДвигаетХозрасчетный(Источник) И ПроведениеИлиОтмена Тогда
		Возврат;
	КонецЕсли;

	Если Не ЕстьПроводкиПоСчету4101(Источник.Ссылка) Тогда
		ИсключитьУзлыИзПолучателей(Источник, УзлыБезОтбора);
	КонецЕсли;

КонецПроцедуры

Функция НомерСодержитПрефиксИнформационнойБазы(Номер)

	Если ТипЗнч(Номер) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	ПрефиксИБ = "";
	Попытка
		ПрефиксИБ = ВРег(СокрЛП(ОбменДаннымиСервер.ПрефиксИнформационнойБазы()));
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если ПустаяСтрока(ПрефиксИБ) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Номер не обрезаем: пробелы в префиксе организации стоят на своих позициях.
	// Пятизначный префикс БСП — дефис на пятой позиции, вид 00БП-000123.
	Если Сред(Номер, 5, 1) = "-" Тогда
		ПрефиксВНомере = Сред(Номер, 3, 2);
	Иначе
		ПрефиксВНомере = Лев(Номер, 2);
	КонецЕсли;

	Возврат ВРег(СокрЛП(ПрефиксВНомере)) = ПрефиксИБ;

КонецФункции

Процедура СнятьРегистрациюСУзлов(ДокументСсылка, Узлы)

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Узел Из Узлы Цикл
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, ДокументСсылка);
	КонецЦикла;

КонецПроцедуры

Функция УзлыУправленияТорговлей()

	Результат = Новый Массив;
	Для Каждого Узел Из УзлыПланаОбмена() Цикл
		Если ЭтоУзелУправленияТорговлей(Узел) Тогда
			Результат.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция УзлыПланаОбмена()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Узлы.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК Узлы
	|ГДЕ
	|	НЕ Узлы.ЭтотУзел
	|	И НЕ Узлы.ПометкаУдаления";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция УзлыУТСОтборомПоПрефиксу()

	Результат = Новый Массив;
	Для Каждого Узел Из УзлыУправленияТорговлей() Цикл
		Если ОтборПоПрефиксуВключен(Узел) Тогда
			Результат.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция УзлыУТБезОтбораПоПрефиксу()

	Результат = Новый Массив;
	Для Каждого Узел Из УзлыУправленияТорговлей() Цикл
		Если Не ОтборПоПрефиксуВключен(Узел) Тогда
			Результат.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ИсключитьУзлыИзПолучателей(ДокументОбъект, УзлыИсключения)

	Если УзлыИсключения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Получатели = ДокументОбъект.ОбменДанными.Получатели;
	БылоАвтоЗаполнение = Получатели.АвтоЗаполнение;
	СоставУзлов = Новый Массив;
	Для Каждого Узел Из Получатели Цикл
		СоставУзлов.Добавить(Узел);
	КонецЦикла;

	Если БылоАвтоЗаполнение И СоставУзлов.Количество() = 0 Тогда
		СоставУзлов = УзлыПланаОбмена();
	КонецЕсли;

	Получатели.АвтоЗаполнение = Ложь;
	Получатели.Очистить();

	Исключенные = Новый Соответствие;
	Для Каждого Узел Из УзлыИсключения Цикл
		Исключенные.Вставить(Узел, Истина);
	КонецЦикла;

	Для Каждого Узел Из СоставУзлов Цикл
		Если Исключенные.Получить(Узел) = Неопределено Тогда
			Получатели.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;

	СнятьРегистрациюСУзлов(ДокументОбъект.Ссылка, УзлыИсключения);

КонецПроцедуры

Процедура УстановитьПризнакОтбораНаУзле(Узел)

	УзелОбъект = Узел.ПолучитьОбъект();
	Если УзелОбъект = Неопределено Или УзелОбъект.бит_ОтбиратьДокументыПоПрефиксу Тогда
		Возврат;
	КонецЕсли;

	УзелОбъект.бит_ОтбиратьДокументыПоПрефиксу = Истина;
	УзелОбъект.ОбменДанными.Загрузка = Истина;
	УзелОбъект.Записать();

КонецПроцедуры

// Переключает ручную отправку документов на автоматическую.
// Значение переключателя формы — строка ПравилаОтправкиДокументов:
// ИнтерактивнаяСинхронизация → АвтоматическаяСинхронизация.
// НеСинхронизировать не меняется.
//
// Возвращаемое значение:
//  Булево - режим узла записан
//
Функция ВключитьАвтоматическуюРегистрациюДокументов(Узел)

	УзелОбъект = Узел.ПолучитьОбъект();
	Если УзелОбъект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Изменен = Ложь;
	Правила = СокрЛП(УзелОбъект.ПравилаОтправкиДокументов);
	Если Правила = "" Или Правила = "ИнтерактивнаяСинхронизация" Тогда
		УзелОбъект.ПравилаОтправкиДокументов = "АвтоматическаяСинхронизация";
		Изменен = Истина;
		Правила = "АвтоматическаяСинхронизация";
	КонецЕсли;

	Если Правила <> "НеСинхронизировать"
		И УзелОбъект.РежимВыгрузкиДокументов = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВручную Тогда
		УзелОбъект.РежимВыгрузкиДокументов = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию;
		Изменен = Истина;
	КонецЕсли;

	Если Не Изменен Тогда
		Возврат Ложь;
	КонецЕсли;

	УзелОбъект.ОбменДанными.Загрузка = Истина;
	УзелОбъект.Записать();
	Возврат Истина;

КонецФункции

Процедура ПодготовитьАвтоотправкуУзла(Узел, УзелОткрытойФормы)

	УзелОткрыт = УзелОткрытойФормы <> Неопределено И Узел = УзелОткрытойФормы;

	// Пока форма узла открыта, его пишет сама форма. Отдельная запись вернет ручной режим.
	Если Не УзелОткрыт И НужноВключитьАвтоматическуюОтправку(Узел) Тогда
		ВключитьАвтоматическуюРегистрациюДокументов(Узел);
	КонецЕсли;

	Если РежимОтправкиДокументовАвтоматический(Узел) Или НужноВключитьАвтоматическуюОтправку(Узел) Тогда
		ДобавитьВыгрузкуВСценарий(Узел);
	КонецЕсли;

КонецПроцедуры

Функция НужноВключитьАвтоматическуюОтправку(Узел)

	Правила = СокрЛП(Узел.ПравилаОтправкиДокументов);
	Если Правила = "НеСинхронизировать" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Правила = "" Или Правила = "ИнтерактивнаяСинхронизация" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Правила = "АвтоматическаяСинхронизация"
		И Узел.РежимВыгрузкиДокументов = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВручную;

КонецФункции

Функция РежимОтправкиДокументовАвтоматический(Узел)

	Возврат СокрЛП(Узел.ПравилаОтправкиДокументов) = "АвтоматическаяСинхронизация";

КонецФункции

Функция ПрименитьАвтоотправкуКДаннымФормы(ДанныеФормы)

	Изменили = Ложь;
	Правила = "";
	Если ДанныеФормы.Свойство("ПравилаОтправкиДокументов") Тогда
		Правила = СокрЛП(ДанныеФормы.ПравилаОтправкиДокументов);
		Если Правила = "" Или Правила = "ИнтерактивнаяСинхронизация" Тогда
			ДанныеФормы.ПравилаОтправкиДокументов = "АвтоматическаяСинхронизация";
			Изменили = Истина;
			Правила = "АвтоматическаяСинхронизация";
		КонецЕсли;
	КонецЕсли;

	Если Правила <> "НеСинхронизировать"
		И ДанныеФормы.Свойство("РежимВыгрузкиДокументов")
		И ДанныеФормы.РежимВыгрузкиДокументов = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВручную Тогда
		ДанныеФормы.РежимВыгрузкиДокументов = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию;
		Изменили = Истина;
	КонецЕсли;

	Возврат Изменили;

КонецФункции

Процедура ДобавитьВыгрузкуВСценарий(Узел)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Настройки.Ссылка КАК Ссылка,
	|	Настройки.Ссылка.ИспользоватьРегламентноеЗадание КАК ИспользоватьРегламентноеЗадание,
	|	Настройки.Ссылка.РегламентноеЗаданиеGUID КАК РегламентноеЗаданиеGUID
	|ИЗ
	|	Справочник.СценарииОбменовДанными.НастройкиОбмена КАК Настройки
	|ГДЕ
	|	Настройки.УзелИнформационнойБазы = &Узел
	|	И НЕ Настройки.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Узел", Узел);

	ЕстьРасписание = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.ИспользоватьРегламентноеЗадание Тогда
			Продолжить;
		КонецЕсли;
		ЕстьРасписание = Истина;
		ДобавитьСтрокуВыгрузки(Выборка.Ссылка, Узел);
		Если Не ЗначениеЗаполнено(СокрЛП(Выборка.РегламентноеЗаданиеGUID)) Тогда
			ОбеспечитьРегламентноеЗаданиеСценария(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьРасписание Тогда
		СоздатьСценарийВыгрузки(Узел);
	КонецЕсли;

КонецПроцедуры

Функция ЕстьСтрокаВыгрузкиВСценарии(Узел)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьСтрока
	|ИЗ
	|	Справочник.СценарииОбменовДанными.НастройкиОбмена КАК Настройки
	|ГДЕ
	|	Настройки.УзелИнформационнойБазы = &Узел
	|	И НЕ Настройки.Ссылка.ПометкаУдаления
	|	И Настройки.ВыполняемоеДействие = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных)";
	Запрос.УстановитьПараметр("Узел", Узел);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Процедура ДобавитьСтрокуВыгрузки(СценарийСсылка, Узел)

	Сценарий = СценарийСсылка.ПолучитьОбъект();
	ИдентификаторТранспорта = Неопределено;
	Для Каждого СтрокаНастройки Из Сценарий.НастройкиОбмена Цикл
		Если СтрокаНастройки.УзелИнформационнойБазы <> Узел Тогда
			Продолжить;
		КонецЕсли;
		ИдентификаторТранспорта = СтрокаНастройки.ИдентификаторТранспорта;
		Если СтрокаНастройки.ВыполняемоеДействие = Перечисления.ДействияПриОбмене.ВыгрузкаДанных Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	НоваяСтрока = Сценарий.НастройкиОбмена.Добавить();
	НоваяСтрока.УзелИнформационнойБазы = Узел;
	НоваяСтрока.ВыполняемоеДействие = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;
	НоваяСтрока.ИдентификаторТранспорта = ИдентификаторТранспорта;
	Сценарий.Записать();

КонецПроцедуры

Процедура СоздатьСценарийВыгрузки(Узел)

	Сценарий = Справочники.СценарииОбменовДанными.СоздатьЭлемент();
	Сценарий.Наименование = Лев(
		НСтр("ru = 'Отправка документов в управление торговлей'") + ": " + Строка(Узел), 100);
	Сценарий.ИспользоватьРегламентноеЗадание = Истина;
	Сценарий.УстановитьНовыйКод();

	СтрокаВыгрузки = Сценарий.НастройкиОбмена.Добавить();
	СтрокаВыгрузки.УзелИнформационнойБазы = Узел;
	СтрокаВыгрузки.ВыполняемоеДействие = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;
	СтрокаВыгрузки.ИдентификаторТранспорта = ТранспортСообщенийОбмена.ТранспортПоУмолчанию(Узел);
	// Штатный ПриЗаписи сценария отрабатывает при записи. Методов
	// РасписаниеРегламентногоЗаданияПоУмолчанию и ОбновитьДанныеРегламентногоЗадания
	// в публичном API этой редакции нет, поэтому задание создается отдельно,
	// если после записи идентификатор так и не заполнен.
	Сценарий.Записать();
	Сценарий.Прочитать();
	Если Не ЗначениеЗаполнено(СокрЛП(Сценарий.РегламентноеЗаданиеGUID)) Тогда
		УстановитьРегламентноеЗаданиеСценария(Сценарий);
		Сценарий.Записать();
	КонецЕсли;

КонецПроцедуры

Процедура ОбеспечитьРегламентноеЗаданиеСценария(СценарийСсылка)

	Сценарий = СценарийСсылка.ПолучитьОбъект();
	Если Сценарий = Неопределено Или ЗначениеЗаполнено(СокрЛП(Сценарий.РегламентноеЗаданиеGUID)) Тогда
		Возврат;
	КонецЕсли;

	УстановитьРегламентноеЗаданиеСценария(Сценарий);
	Сценарий.Записать();

КонецПроцедуры

Процедура УстановитьРегламентноеЗаданиеСценария(Сценарий)

	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ПериодПовтораВТечениеДня = 900;
	Расписание.ПериодПовтораДней = 1;
	ДниНедели = Новый Массив;
	Для НомерДня = 1 По 7 Цикл
		ДниНедели.Добавить(НомерДня);
	КонецЦикла;
	Расписание.ДниНедели = ДниНедели;
	Месяцы = Новый Массив;
	Для НомерМесяца = 1 По 12 Цикл
		Месяцы.Добавить(НомерМесяца);
	КонецЦикла;
	Расписание.Месяцы = Месяцы;

	ОтборЗаданий = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.СинхронизацияДанных);
	Для Каждого СуществующееЗадание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания(ОтборЗаданий) Цикл
		Если СуществующееЗадание.Параметры.Количество() > 0
			И СуществующееЗадание.Параметры[0] = Сценарий.Код Тогда
			Сценарий.РегламентноеЗаданиеGUID = Строка(СуществующееЗадание.УникальныйИдентификатор);
			СуществующееЗадание.Использование = Истина;
			СуществующееЗадание.Расписание = Расписание;
			СуществующееЗадание.Записать();
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание(
		Метаданные.РегламентныеЗадания.СинхронизацияДанных);
	Задание.Наименование = Лев(
		НСтр("ru = 'Выполнение обмена по сценарию: '") + СокрЛП(Сценарий.Наименование), 120);
	Задание.Использование = Истина;
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(Сценарий.Код);
	Задание.Параметры = ПараметрыЗадания;
	Задание.Расписание = Расписание;
	Задание.Записать();
	Сценарий.РегламентноеЗаданиеGUID = Строка(Задание.УникальныйИдентификатор);

КонецПроцедуры

Функция ЕстьПроводкиПоСчету4101(ДокументСсылка)

	Счет = Счет4101();
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьПроводки
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный КАК Проводки
	|ГДЕ
	|	Проводки.Регистратор = &Регистратор
	|	И (Проводки.СчетДт = &Счет
	|		ИЛИ Проводки.СчетКт = &Счет)";
	Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
	Запрос.УстановитьПараметр("Счет", Счет);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ЕстьПроводкиВНаборе(НаборЗаписей)

	Счет = Счет4101();
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого СтрокаДвижения Из НаборЗаписей Цикл
		Если СтрокаДвижения.СчетДт = Счет Или СтрокаДвижения.СчетКт = Счет Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция РегистраторНабора(НаборЗаписей)

	ОтборРегистратора = НаборЗаписей.Отбор.Найти("Регистратор");
	Если ОтборРегистратора = Неопределено Или Не ОтборРегистратора.Использование Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОтборРегистратора.Значение;

КонецФункции

Функция ДокументДвигаетХозрасчетный(ДокументОбъект)

	Возврат ДокументОбъект.Метаданные().Движения.Содержит(Метаданные.РегистрыБухгалтерии.Хозрасчетный);

КонецФункции

Функция Счет4101()

	Возврат ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01");

КонецФункции

// Коды ВариантНастройки синхронизации с управлением торговлей.
// ОбменУТ11 и ОбменУТБП пишет Бухгалтерия 3.0.91, ОбменБП30УТ11 — Бухгалтерия 3.0.208.
// Сравнение по хранимому коду. Если в строке варианта оказался синоним, его тоже узнаём.
//
Функция ЭтоКодВариантаУправленияТорговлей(ВариантНастройки)

	Код = СокрЛП(Строка(ВариантНастройки));
	Если Код = "ОбменБП30УТ11" Или Код = "ОбменУТ11" Или Код = "ОбменУТБП" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат НаименованиеУзлаУправленияТорговлей(Код);

КонецФункции

Функция НаименованиеУзлаУправленияТорговлей(Наименование)

	Возврат СтрНайти(ВРег(СокрЛП(Строка(Наименование))), "УПРАВЛЕНИЕ ТОРГОВЛЕЙ") > 0;

КонецФункции

Функция НаименованиеДанныхФормы(Данные)

	Наименование = "";
	Если Данные.Свойство("Description", Наименование) И Не ПустаяСтрока(СокрЛП(Строка(Наименование))) Тогда
		Возврат Наименование;
	КонецЕсли;

	Данные.Свойство("Наименование", Наименование);
	Возврат Наименование;

КонецФункции

Функция УзелПолучателя(Получатель)

	Если Получатель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Получатель) = Тип("ДанныеФормыСтруктура") Тогда
		СсылкаУзла = Неопределено;
		Получатель.Свойство("Ссылка", СсылкаУзла);
		Возврат СсылкаУзла;
	КонецЕсли;

	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Получатель)) Тогда
		Возврат Получатель;
	КонецЕсли;

	Возврат Получатель.Ссылка;

КонецФункции

Функция ГруппаДокументовФормы(Форма)

	// Форма узла СинхронизацияДанныхЧерезУниверсальныйФормат Бухгалтерии:
	// колонка «Документы» на странице «Правила отправки данных».
	Группа = Форма.Элементы.Найти("ГруппаДокументы");
	Если Группа <> Неопределено Тогда
		Возврат Группа;
	КонецЕсли;

	Переключатель = Форма.Элементы.Найти("ПереключательДокументыНеОтправлять");
	Если Переключатель = Неопределено Тогда
		Переключатель = Форма.Элементы.Найти("ПереключательДокументыОтправлятьАвтоматически");
	КонецЕсли;
	Если Переключатель <> Неопределено И Переключатель.Родитель <> Неопределено Тогда
		Родитель = Переключатель.Родитель;
		// Переключатель «начиная с даты» лежит в горизонтальной строке вместе с полем даты.
		// Флажок нужен колонке документов, а не этой строке.
		Если ТипЗнч(Родитель) = Тип("ГруппаФормы")
			И Родитель.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная
			И Родитель.Родитель <> Неопределено Тогда
			Возврат Родитель.Родитель;
		КонецЕсли;
		Возврат Родитель;
	КонецЕсли;

	Возврат ГруппаПравилДокументов(Форма.Элементы);

КонецФункции

Функция ГруппаПравилДокументов(Элементы)

	Для Каждого Элемент Из Элементы Цикл
		Если ТипЗнч(Элемент) <> Тип("ГруппаФормы") Тогда
			Продолжить;
		КонецЕсли;

		ИмяЭлемента = ВРег(Элемент.Имя);
		ЗаголовокЭлемента = ВРег(Строка(Элемент.Заголовок));
		Если СтрНайти(ИмяЭлемента, "ДОКУМЕНТ") > 0 Или СтрНайти(ЗаголовокЭлемента, "ДОКУМЕНТ") > 0 Тогда
			Возврат Элемент;
		КонецЕсли;

		ВложеннаяГруппа = ГруппаПравилДокументов(Элемент.ПодчиненныеЭлементы);
		Если ВложеннаяГруппа <> Неопределено Тогда
			Возврат ВложеннаяГруппа;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
