// Документ может уйти в узел управления торговлей не только как зарегистрированный объект,
// но и как объект, на который ссылается другой выгружаемый объект (выгрузка по ссылке).
// Такая выгрузка не вызывает ПриОтправкеДанныхКорреспонденту, поэтому решение принимается здесь.
&Вместо("ВыгрузкаОбъектаВыборки")
Процедура бит_ВыгрузкаОбъектаВыборки(КомпонентыОбмена, Объект, ПравилоОбработки = Неопределено)

	Если ТипЗнч(Объект) <> Тип("Структура") Тогда
		Решение = бит_РегистрацияДокументовБП.РешениеОбОтправкеВУТ(
			Объект, КомпонентыОбмена.УзелКорреспондента, Ложь);
		Если Решение = ОтправкаЭлементаДанных.Игнорировать Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПродолжитьВызов(КомпонентыОбмена, Объект, ПравилоОбработки);

КонецПроцедуры
