
&После("ВыполнитьПравилаРегистрацииОбъектовДляПланаОбмена")
Процедура бит_ВыполнитьПравилаРегистрацииОбъектовДляПланаОбмена(МассивУзловРезультат, Объект, ИмяПланаОбмена, ДополнительныеПараметры)

	бит_РегистрацияДокументовБП.ОграничитьУзлыРегистрацииДокумента(
		МассивУзловРезультат, Объект, ИмяПланаОбмена, ДополнительныеПараметры);

КонецПроцедуры

&После("ПриОтправкеДанныхКорреспонденту")
Процедура бит_ПриОтправкеДанныхКорреспонденту(ЭлементДанных, ОтправкаЭлемента, СозданиеНачальногоОбраза, Получатель, Анализ)

	// Документ без проводок 41.01 типовая синхронизация тоже регистрирует и отправляет.
	// Решение об отправке принимается здесь, когда проводки уже записаны.
	Если Получатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ОтправкаЭлемента = ОтправкаЭлементаДанных.Игнорировать Тогда
		Возврат;
	КонецЕсли;

	// Присваивание здесь, в перехватчике: вложенная процедура может не донести
	// Игнорировать, и типовая выгрузка тогда отправляет документ как Авто или Удалить.
	Решение = бит_РегистрацияДокументовБП.РешениеОбОтправкеВУТ(ЭлементДанных, Получатель, Анализ);
	Если Решение <> Неопределено Тогда
		ОтправкаЭлемента = Решение;
	КонецЕсли;

КонецПроцедуры
