// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Формирует контракт адреса по строке JSON контактной информации БСП.
//
// Алгоритм работы:
// 1. Выполняется разбор входного JSON в структуру "Сведения".
// 2. Если в JSON отсутствует value - адрес собирается локально из полей.
// 3. При формировании сведений используются уровни:
//    - munLevels, если адрес муниципального типа;
//    - admLevels, если муниципальные уровни отсутствуют в JSON или тип не муниципальный;
//    - фиксированный список уровней, если оба массива отсутствуют.
// 4. На основе уровней формируется строковое представление адреса.
// 5. Выполняется сравнение сформированного представления с тем, что формируется в 1С (если передали).
// 6. Определяется ТипАдреса (Административный / Муниципальный / Свободная форма).
// 7. Заполняется соответствующая часть контракта в зависимости от ТипАдреса.
// 8. Если второй параметр метода не передан и поле "Представление"
//    в контракте пустое - оно заполняется из "Представления" той части контракта,
//    которая соответствует выбранному ТипАдреса.
//
// Параметры:
//  ЗначениеJSON - Строка - JSON адреса.
//  Представление - Строка - печатное представление адреса как оно сформировано в 1С.
//
// Возвращаемое значение:
//  Структура - контракт адреса (см. КонтентКонтрактыПровайдеров.НовыйАдрес).
//
Функция ИзJSON(ЗначениеJSON, Представление = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ЗначениеJSON) Тогда
		ВызватьИсключение "Не указан JSON адреса.";
	КонецЕсли;
	
	Сведения = СведенияОбАдресеИзJSON(ЗначениеJSON);
	Если Сведения = Неопределено Тогда
		ВызватьИсключение "Не удалось разобрать JSON адреса.";
	КонецЕсли;
	
	Возврат КонтрактАдресаПоСведениям(Сведения, Представление);
	
КонецФункции

// Формирует контракт адреса по строке XML контактной информации БСП.
// Адрес РФ из XML - только административный или свободная форма (не муниципальный).
// Муниципальный тип контракта - только при входе JSON (см. КонтрактАдресаИзJSON).
//
// Параметры:
//  ТекстXML - Строка - XML адреса.
//  Представление - Строка - печатное представление адреса как оно сформировано в 1С.
//
// Возвращаемое значение:
//  Структура - контракт адреса (см. КонтентКонтрактыПровайдеров.НовыйАдрес).
//
Функция ИзXML(ТекстXML, Представление = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ТекстXML) Тогда
		ВызватьИсключение "Не указан XML адреса.";
	КонецЕсли;
	
	Сведения = СведенияОбАдресеИзXML(ТекстXML);
	Если Сведения = Неопределено Тогда
		ВызватьИсключение "Не удалось разобрать XML адреса.";
	КонецЕсли;
	
	Возврат КонтрактАдресаПоСведениям(Сведения, Представление);
	
КонецФункции

// Формирует контракт адреса по полям строки контактной информации (Поле1 … Поле10, типы дома/корпуса/квартиры).
//
// Параметры:
//  ДанныеПолей - Структура - поля адреса (имена как в ТЧ КИ: Представление, Поле1 … Поле10,
//								ТипДома, ТипКорпуса, ТипКвартиры).
//  Представление - Строка - печатное представление адреса как оно сформировано в 1С
//								(если пусто - из ДанныеПолей.Представление).
//
// Возвращаемое значение:
//  Структура - контракт адреса (см. КонтентКонтрактыПровайдеров.НовыйАдрес).
//
Функция ИзКонтактнойИнформации(ДанныеПолей, Представление = "") Экспорт
	
	Если ТипЗнч(ДанныеПолей) <> Тип("Структура") Тогда
		ВызватьИсключение "Данные полей адреса должны быть структурой.";
	КонецЕсли;

	ПредставлениеАдреса = Представление;
	Если Не ЗначениеЗаполнено(ПредставлениеАдреса) Тогда
		ПредставлениеАдреса = ЗначениеПоляСтруктуры(ДанныеПолей, "Представление");
	КонецЕсли;
	
	Сведения = СведенияОбАдресеИзПолейКонтактнойИнформации(ДанныеПолей);
	Если Сведения = Неопределено Тогда
		ВызватьИсключение "Не удалось разобрать поля адреса.";
	КонецЕсли;
	
	Возврат КонтрактАдресаПоСведениям(Сведения, ПредставлениеАдреса);
	
КонецФункции

