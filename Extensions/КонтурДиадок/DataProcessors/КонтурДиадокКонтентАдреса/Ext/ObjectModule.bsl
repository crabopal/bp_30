////////////////////////////////////////////////////////////////////////////////
// РАЗБОР JSON

Функция СведенияОбАдресеИзJSON(ЗначениеJSON)
	
	АдресJSON = РазобратьАдресJSON(ЗначениеJSON);
	Если АдресJSON = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Сведения = НовыйСведенияАдреса();
	ЗаполнитьСведенияИзПолейАдресаБСП(Сведения, АдресJSON);
	ДополнитьПредставлениеПоСтруктурнымПолям(Сведения, АдресJSON);
	
	Возврат Сведения;
	
КонецФункции

Функция РазобратьАдресJSON(ЗначениеJSON)
	
	Попытка
		Результат = СтдJSON().ПрочитатьЗначение(ЗначениеJSON, Истина);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСведенияИзПолейАдресаБСП(Сведения, ПоляАдресаБСП)
	
	Сведения.ТипАдресаВJSON = ПолеСтрокаJSON(ПоляАдресаБСП, "addressType");
	Сведения.Представление = ПолеСтрокаJSON(ПоляАдресаБСП, "value");
	Сведения.МуниципальноеПредставление = Сведения.Представление;
	
	Сведения.Индекс = ПолеСтрокаJSON(ПоляАдресаБСП, "ZIPcode");
	Сведения.Страна = ПолеСтрокаJSON(ПоляАдресаБСП, "country");
	Сведения.КодСтраны = ПолеСтрокаJSON(ПоляАдресаБСП, "countryCode");
	
	Сведения.КодРегиона = ПолеСтрокаJSON(ПоляАдресаБСП, "areaCode");
	Сведения.Регион = ПолеСтрокаJSON(ПоляАдресаБСП, "area");
	Сведения.РегионЗначение = ПолеСтрокаJSON(ПоляАдресаБСП, "areaValue");
	Сведения.КраткийТипРегиона = КраткийТипРегиона(ПолеСтрокаJSON(ПоляАдресаБСП, "areaType"));
	Сведения.ПолныйТипРегиона = ПолныйТипРегиона(Сведения.КраткийТипРегиона);
	Если Не ЗначениеЗаполнено(Сведения.КодРегиона) Тогда
		Сведения.КодРегиона = КодРегионаПоНаименованию(ТекстРегионаДляОпределенияКода(Сведения));
	КонецЕсли;
	
	Сведения.Район = ПолеСтрокаJSON(ПоляАдресаБСП, "district");
	Сведения.Город = ПолеСтрокаJSON(ПоляАдресаБСП, "city");
	Сведения.НаселенныйПункт = ПолеСтрокаJSON(ПоляАдресаБСП, "locality");
	Сведения.Улица = ПолеСтрокаJSON(ПоляАдресаБСП, "street");
	ЗаполнитьСокращенияАдминистративныхУровнейИзJSON(Сведения, ПоляАдресаБСП);
	
	ЗаполнитьУровеньСведенийНаименованиеКодВидИзJSON(
		Сведения.МуниципальныйРайон,
		ПоляАдресаБСП,
		"munDistrict",
		ВидУровняСведенийМуниципальныйРайон());
	ЗаполнитьУровеньСведенийНаименованиеКодВидИзJSON(Сведения.Поселение, ПоляАдресаБСП, "settlement", "Поселение");
	ЗаполнитьПланировочнуюСтруктуруИзJSON(Сведения, ПоляАдресаБСП);
	ЗаполнитьНаселенныйПунктИВидИзJSON(Сведения, ПоляАдресаБСП);
	
	Сведения.НомерЗемельногоУчастка = ПолеСтрокаJSON(ПоляАдресаБСП, "stead");
	Сведения.Комментарий = ПолеСтрокаJSON(ПоляАдресаБСП, "comment");
	Сведения.ИдентификаторДома = ПолеСтрокаJSON(ПоляАдресаБСП, "houseId");
	Сведения.ИдентификаторАдресногоОбъекта = ИдентификаторАдресногоОбъектаИзJSON(ПоляАдресаБСП);
	
	Сведения.Здание.ТипЗдания = ПолеСтрокаJSON(ПоляАдресаБСП, "houseType");
	Сведения.Здание.Номер = ПолеСтрокаJSON(ПоляАдресаБСП, "houseNumber");
	
	Сведения.Корпуса = ЭлементыКорпусовИзJSON(ПоляАдресаБСП);
	Сведения.Помещения = ЭлементыПомещенийИзJSON(ПоляАдресаБСП);
	
КонецПроцедуры

Процедура ДополнитьПредставлениеПоСтруктурнымПолям(Сведения, АдресJSON)
	
	Если ЗначениеЗаполнено(Сведения.Представление) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьСтруктурныеПоляАдресаВСведениях(Сведения) Тогда
		Возврат;
	КонецЕсли;
	
	Сведения.Представление = ПредставлениеАдресаПоJSON(АдресJSON);
	Сведения.МуниципальноеПредставление = Сведения.Представление;
	
КонецПроцедуры

Функция ЕстьСтруктурныеПоляАдресаВСведениях(Сведения)
	
	Возврат ЗначениеЗаполнено(Сведения.Индекс)
		Или ЗначениеЗаполнено(Сведения.Страна)
		Или ЗначениеЗаполнено(Сведения.Регион)
		Или ЗначениеЗаполнено(Сведения.Район)
		Или УровеньСведенийЗаполнен(Сведения.МуниципальныйРайон)
		Или УровеньСведенийЗаполнен(Сведения.Поселение)
		Или УровеньСведенийЗаполнен(Сведения.ПланировочнаяСтруктура)
		Или ЗначениеЗаполнено(Сведения.Город)
		Или ЗначениеЗаполнено(Сведения.НаселенныйПункт)
		Или ЗначениеЗаполнено(Сведения.Улица)
		Или ЗначениеЗаполнено(Сведения.НомерЗемельногоУчастка)
		Или ЗначениеЗаполнено(Сведения.Здание.Номер)
		Или Сведения.Корпуса.Количество() > 0
		Или Сведения.Помещения.Количество() > 0;
	
КонецФункции

Функция ПредставлениеАдресаПоJSON(АдресJSON)
	
	ТипАдресаВJSON = ПолеСтрокаJSON(АдресJSON, "addressType");
	
	Если ЭтоАдресВСвободнойФорме(ТипАдресаВJSON) Тогда
		Возврат ПредставлениеАдресаВСвободнойФормеПоJSON(АдресJSON);
	КонецЕсли;
	
	Части = Новый Массив;
	Индекс = ПолеСтрокаJSON(АдресJSON, "ZIPcode");
	Если ЗначениеЗаполнено(Индекс) Тогда
		Части.Добавить(Индекс);
	КонецЕсли;
	
	ПорядокУровней = ИменаУровнейАдресаПоJSON(АдресJSON, ТипАдресаВJSON);
	
	Для Каждого ИмяУровня Из ПорядокУровней Цикл
		Часть = ПредставлениеУровняАдресаПоJSON(АдресJSON, ИмяУровня, ТипАдресаВJSON);
		ДобавитьЧастьПредставленияЕслиЗаполнена(Части, Часть);
	КонецЦикла;
	
	НомерДома = ПолеСтрокаJSON(АдресJSON, "houseNumber");
	Если ЗначениеЗаполнено(НомерДома) Тогда
		
		ТипДома = ПолеСтрокаJSON(АдресJSON, "houseType");
		НомерИТипЗначения = СоединитьНомерИТипЗдания(НомерДома, ТипДома, ТипАдресаВJSON);
			
		ДобавитьЧастьПредставленияЕслиЗаполнена(Части, НомерИТипЗначения);
		
	Иначе
		
		Участок = ПолеСтрокаJSON(АдресJSON, "stead");
		Если ЗначениеЗаполнено(Участок) Тогда
			
			ТипУчастка = НаименованиеЗемельногоУчасткаДляПредставления();
			НомерИТипЗначения = СоединитьНомерИТипЗдания(Участок, ТипУчастка, ТипАдресаВJSON);
				
			ДобавитьЧастьПредставленияЕслиЗаполнена(Части, НомерИТипЗначения);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Корпуса = ПолеJSON(АдресJSON, "buildings");
	Если ЭтоМассив(Корпуса) Тогда
		Для Каждого Строение Из Корпуса Цикл
			ДобавитьСтроениеВЧастиПредставления(Части, Строение, ТипАдресаВJSON);
		КонецЦикла;
	КонецЕсли;
	
	Помещения = ПолеJSON(АдресJSON, "apartments");
	Если ЭтоМассив(Помещения) Тогда
		Для Каждого Помещение Из Помещения Цикл
			ДобавитьПомещениеВЧастиПредставления(Части, Помещение, ТипАдресаВJSON);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтдСтр().СтрСоединитьЛок(Части, ", ");
	
КонецФункции

Функция ПредставлениеАдресаВСвободнойФормеПоJSON(АдресJSON)
	
	Текст = ПолеСтрокаJSON(АдресJSON, "value");
	Страна = ПолеСтрокаJSON(АдресJSON, "country");
	Результат = Текст;
	
	Если ЗначениеЗаполнено(Страна) И Не СтдСтр().СтрНачинаетсяСЛок(ВРег(Текст), ВРег(Страна)) Тогда
		Если ЗначениеЗаполнено(Текст) Тогда
			Результат = Страна + ", " + Текст;
		Иначе
			Результат = Страна;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоАдресВСвободнойФорме(ТипАдресаВJSON)
	
	Возврат СтдСтр().СтрНайтиЛок(ВРег(ТипАдресаВJSON), "СВОБОДН") > 0;
	
КонецФункции

Функция ЭтоМуниципальныйАдрес(ТипАдресаВJSON)
	
	Возврат СтдСтр().СтрНайтиЛок(ВРег(ТипАдресаВJSON), "МУНИЦИП") > 0;
	
КонецФункции

Функция ЭтоАдминистративныйАдрес(ТипАдресаВJSON)
	
	Возврат СтдСтр().СтрНайтиЛок(ВРег(ТипАдресаВJSON), "АДМИНИСТР") > 0;
	
КонецФункции

Функция ЭтоСтруктурированныйАдресПоJSON(ТипАдресаВJSON)
	
	Возврат ЭтоМуниципальныйАдрес(ТипАдресаВJSON)
		Или ЭтоАдминистративныйАдрес(ТипАдресаВJSON);
	
КонецФункции

Функция ЭтоУровеньРегионаJSON(ИмяУровня)
	
	Возврат СтдСтр().СтрСравнитьЛок(ИмяУровня, "area") = 0;
	
КонецФункции

Функция ЭтоУровеньМуниципальногоРайонаJSON(ИмяУровня)
	
	Возврат СтдСтр().СтрСравнитьЛок(ИмяУровня, "munDistrict") = 0;
	
КонецФункции

Функция ЭтоУровеньПоселенияJSON(ИмяУровня)
	
	Возврат СтдСтр().СтрСравнитьЛок(ИмяУровня, "settlement") = 0;
	
КонецФункции

Функция ЭтоТипПомещенияДругоеJSON(ТипПомещения)
	
	Возврат СтдСтр().СтрСравнитьЛок(ТипПомещения, "Другое") = 0;
	
КонецФункции

Функция ЭтоТипЗданияДомJSON(ТипЗданияИлиПомещения)
	
	Возврат СтдСтр().СтрСравнитьЛок(ТипЗданияИлиПомещения, "ДОМ") = 0;
	
КонецФункции

Функция ЭтоМуниципальныйДомДляПредставленияПоJSON(ТипАдресаВJSON, ТипЗданияИлиПомещения)
	
	Результат = ЭтоМуниципальныйАдрес(ТипАдресаВJSON) И ЭтоТипЗданияДомJSON(ТипЗданияИлиПомещения);
	Возврат Результат;
	
КонецФункции

Функция ЭтоТипКорпусаКорпусJSON(ТипКорпуса)
	
	Возврат СтдСтр().СтрСравнитьЛок(ТипКорпуса, "КОРПУС") = 0;
	
КонецФункции

Функция ЭтоТипКвартирыКвJSON(ТипКвартиры)
	
	Возврат СтдСтр().СтрНачинаетсяСЛок(ВРег(ТипКвартиры), "КВ");
	
КонецФункции

Функция ИменаУровнейАдресаПоJSON(АдресJSON, ТипАдресаВJSON)
	
	Если ЭтоМуниципальныйАдрес(ТипАдресаВJSON) Тогда
		Уровни = УровниМассивИзJSON(АдресJSON, "munLevels");
	ИначеЕсли ЭтоАдминистративныйАдрес(ТипАдресаВJSON) Тогда
		Уровни = УровниМассивИзJSON(АдресJSON, "admLevels");
	Иначе
		Уровни = Новый Массив;
	КонецЕсли;
	
	Если Уровни.Количество() > 0 Тогда
		ИсключитьДомИУчастокИзПорядкаУровнейJSON(Уровни);
		УдалитьНераспознанныеУровниJSON(Уровни);
		Возврат Уровни;
	КонецЕсли;
	
	Уровни = Новый Массив;
	Уровни.Добавить("area");
	Если ЭтоМуниципальныйАдрес(ТипАдресаВJSON) Тогда
		Уровни.Добавить("munDistrict");
		Уровни.Добавить("settlement");
	Иначе
		Уровни.Добавить("district");
	КонецЕсли;
	Уровни.Добавить("city");
	Уровни.Добавить("locality");
	Уровни.Добавить("territory");
	Уровни.Добавить("street");
	
	Возврат Уровни;
	
КонецФункции

Функция УровниМассивИзJSON(АдресJSON, ИмяМассива)
	
	Результат = Новый Массив;

	Уровни = ПолеJSON(АдресJSON, ИмяМассива);
	Если ЭтоМассив(Уровни) Тогда
		Для Каждого Элемент Из Уровни Цикл
			Результат.Добавить(НРег(СокрЛП(Строка(Элемент))));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ИсключитьДомИУчастокИзПорядкаУровнейJSON(Уровни)
	
	Позиция = Уровни.Найти("house");
	Если Позиция <> Неопределено Тогда
		Уровни.Удалить(Позиция);
	КонецЕсли;
	
	Позиция = Уровни.Найти("stead");
	Если Позиция <> Неопределено Тогда
		Уровни.Удалить(Позиция);
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьНераспознанныеУровниJSON(Уровни)
	
	Для Позиция = 0 По Уровни.ВГраница() Цикл
		Индекс = Уровни.ВГраница() - Позиция;
		ИмяУровня = Строка(Уровни[Индекс]);
		Если ТипЗнч(Уровни[Индекс]) <> Тип("Строка")
			Или НЕ ЭтоРаспознанныйУровеньАдресаJSON(ИмяУровня) Тогда
			Уровни.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоРаспознанныйУровеньАдресаJSON(ИмяУровня)
	
	Возврат ИдентификаторУровняАдресаJSON(ИмяУровня) <> Неопределено;
	
КонецФункции

Функция ИдентификаторУровняАдресаJSON(ИмяУровня)
	
	// BSLLS:MagicNumber-off
	Уровни = Новый Соответствие;
	Уровни.Вставить("AREA", 1);
	Уровни.Вставить("DISTRICT", 2);
	Уровни.Вставить("MUNDISTRICT", 3);
	Уровни.Вставить("SETTLEMENT", 4);
	Уровни.Вставить("CITY", 5);
	Уровни.Вставить("LOCALITY", 6);
	Уровни.Вставить("TERRITORY", 7);
	Уровни.Вставить("STREET", 8);
	Уровни.Вставить("HOUSE", 9);
	Уровни.Вставить("STEAD", 10);
	// BSLLS:MagicNumber-on
	
	Возврат Уровни.Получить(ВРег(ИмяУровня));
	
КонецФункции

Функция ПредставлениеРегионаИзПоляРегионаПоJSON(АдресJSON, ИмяУровня, ТипАдресаВJSON)
	
	Если Не ЭтоУровеньРегионаJSON(ИмяУровня) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не ЭтоСтруктурированныйАдресПоJSON(ТипАдресаВJSON) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ПолеСтрокаJSON(АдресJSON, "areaValue");
	
КонецФункции

Функция ПредставлениеУровняАдресаПоJSON(АдресJSON, ИмяУровня, ТипАдресаВJSON)
	
	Результат = ПредставлениеРегионаИзПоляРегионаПоJSON(АдресJSON, ИмяУровня, ТипАдресаВJSON);
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Наименование = ПолеСтрокаJSON(АдресJSON, ИмяУровня);
		Тип = ПолеСтрокаJSON(АдресJSON, ИмяУровня + "Type");
		Если ЭтоУровеньМуниципальногоРайонаJSON(ИмяУровня) Тогда
			Результат = КраткоеНаписаниеМуниципальныхРайонов(Наименование, Тип);
		ИначеЕсли ЭтоУровеньПоселенияJSON(ИмяУровня) Тогда
			Результат = КраткоеНаписаниеПоселений(Наименование, Тип);
		Иначе
			Результат = СоединитьНаименованиеИТипАдресногоОбъекта(Наименование, Тип, ЭтоУровеньРегионаJSON(ИмяУровня));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоединитьНаименованиеИТипАдресногоОбъекта(Наименование, Тип, ЭтоРегион)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		
		ТипВначале = Ложь;
		Если Не ЭтоРегион Тогда
			ТипВначале = СтдСтр().СтрЗаканчиваетсяНаЛок(Тип, ".") Или СтдСтр().СтрНайтиЛок(Тип, "-") > 0;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Тип) Тогда
			Результат = Наименование;
		ИначеЕсли ТипВначале Тогда
			Результат = СокрЛП(Тип + " " + Наименование);
		Иначе
			Результат = СокрЛП(Наименование + " " + Тип);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КраткоеНаписаниеМуниципальныхРайонов(Наименование, Сокращение)
	
	// BSLLS:Typo-off
	Если СтдСтр().СтрСравнитьЛок(Сокращение, "г.о.") = 0 Тогда
		Результат = СокрЛП(СтрЗаменить(Наименование, "Городской округ", ""));
	ИначеЕсли СтдСтр().СтрСравнитьЛок(Сокращение, "м.р-н") = 0 Тогда
		Результат = СокрЛП(СтрЗаменить(Наименование, "муниципальный район", ""));
	ИначеЕсли СтдСтр().СтрСравнитьЛок(Сокращение, "вн.тер.") = 0
		Или СтдСтр().СтрСравнитьЛок(Сокращение, "вн.тер.г.") = 0 Тогда
		Результат = СокрЛП(СтрЗаменить(Наименование, "Внутригородская территория", ""));
	ИначеЕсли СтдСтр().СтрСравнитьЛок(Сокращение, "м.о.") = 0
		Или СтдСтр().СтрСравнитьЛок(Сокращение, "мун. окр.") = 0 Тогда
		Результат = СокрЛП(СтрЗаменить(Наименование, "Муниципальный округ", ""));
	Иначе
		Результат = Наименование;
	КонецЕсли;
	// BSLLS:Typo-on
	
	Возврат Результат;
	
КонецФункции

Функция КраткоеНаписаниеПоселений(Наименование, Сокращение)
	
	Если СтдСтр().СтрСравнитьЛок(Сокращение, "г.п.") = 0
		Или СтдСтр().СтрСравнитьЛок(Сокращение, "г. п.") = 0 Тогда
		Результат = СокрЛП(СтрЗаменить(Наименование, "Городское поселение", ""));
	ИначеЕсли СтдСтр().СтрСравнитьЛок(Сокращение, "вн.р-н") = 0 Тогда
		Результат = СокрЛП(СтрЗаменить(Наименование, "Внутригородская территория", ""));
	ИначеЕсли СтдСтр().СтрСравнитьЛок(Сокращение, "с.п.") = 0 Тогда
		Результат = СокрЛП(СтрЗаменить(Наименование, "Сельское поселение", ""));
	ИначеЕсли СтдСтр().СтрСравнитьЛок(Сокращение, "меж.тер.") = 0 Тогда
		Результат = СокрЛП(СтрЗаменить(Наименование, "Межселенная территория", ""));
	Иначе
		Результат = Наименование;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьЧастьПредставленияЕслиЗаполнена(Части, Часть)
	
	Если ЗначениеЗаполнено(Часть) Тогда
		Части.Добавить(Часть);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтроениеВЧастиПредставления(Части, Строение, ТипАдресаВJSON)
	
	Номер = ПолеСтрокаJSON(Строение, "number");
	Если Не ЗначениеЗаполнено(Номер) Тогда
		Возврат;
	КонецЕсли;
	
	НомерИТипЗдания = СоединитьНомерИТипЗдания(Номер, ПолеСтрокаJSON(Строение, "type"), ТипАдресаВJSON);
	ДобавитьЧастьПредставленияЕслиЗаполнена(Части, НомерИТипЗдания);
	
КонецПроцедуры

Процедура ДобавитьПомещениеВЧастиПредставления(Части, Помещение, ТипАдресаВJSON)
	
	Номер = ПолеСтрокаJSON(Помещение, "number");
	Если Не ЗначениеЗаполнено(Номер) Тогда
		Возврат;
	КонецЕсли;
	
	ТипПомещения = ПолеСтрокаJSON(Помещение, "type");
	Если ЭтоТипПомещенияДругоеJSON(ТипПомещения) Тогда
		ДобавитьЧастьПредставленияЕслиЗаполнена(Части, Номер);
	Иначе
		НомерИТипЗдания = СоединитьНомерИТипЗдания(Номер, ТипПомещения, ТипАдресаВJSON);
		ДобавитьЧастьПредставленияЕслиЗаполнена(Части, НомерИТипЗдания);
	КонецЕсли;
	
КонецПроцедуры

Функция СоединитьНомерИТипЗдания(Номер, ТипЗданияИлиПомещения, ТипАдресаВJSON = "")
	
	Результат = Номер;
	Если Не ПустаяСтрока(ТипЗданияИлиПомещения) Тогда
		Если ЭтоМуниципальныйДомДляПредставленияПоJSON(ТипАдресаВJSON, ТипЗданияИлиПомещения) Тогда
			Результат = "дом " + Номер;
		Иначе
			Сокращения = СокращенияЗданийИПомещений();
			Сокращение = Сокращения.Получить(ВРег(ТипЗданияИлиПомещения));
			Если Сокращение = Неопределено Тогда
				Результат = НРег(ТипЗданияИлиПомещения) + " " + Номер;
			Иначе
				Результат = Сокращение + " " + Номер;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НаименованиеЗемельногоУчасткаДляПредставления()
	
	Возврат "Зем. участок";
	
КонецФункции

Функция СокращенияЗданийИПомещений()
	
	Сокращения = Новый Соответствие;
	// BSLLS:Typo-off
	Сокращения.Вставить("ВЛАДЕНИЕ", "влд.");
	Сокращения.Вставить("ГАРАЖ", "г-ж");
	Сокращения.Вставить("ДОМ", "д.");
	Сокращения.Вставить("ДОМОВЛАДЕНИЕ", "двлд.");
	Сокращения.Вставить("ЗДАНИЕ", "зд.");
	Сокращения.Вставить("ЗЕМЕЛЬНЫЙ УЧАСТОК", "з/у");
	Сокращения.Вставить("ЗЕМ. УЧАСТОК", "з/у");
	Сокращения.Вставить("КВАРТИРА", "кв.");
	Сокращения.Вставить("КОМНАТА", "ком.");
	Сокращения.Вставить("ПОДВАЛ", "подв.");
	Сокращения.Вставить("КОТЕЛЬНАЯ", "кот.");
	Сокращения.Вставить("ПОГРЕБ", "п-б");
	Сокращения.Вставить("КОРПУС", "к.");
	Сокращения.Вставить("МАШИНО-МЕСТО", "м/м");
	Сокращения.Вставить("ОБЪЕКТ НЕЗАВЕРШЕННОГО СТРОИТЕЛЬСТВА", "ОНС");
	Сокращения.Вставить("ОФИС", "офис");
	Сокращения.Вставить("ПАВИЛЬОН", "пав.");
	Сокращения.Вставить("ПОМЕЩЕНИЕ", "помещ.");
	Сокращения.Вставить("РАБОЧИЙ УЧАСТОК", "раб.уч.");
	Сокращения.Вставить("СКЛАД", "скл.");
	Сокращения.Вставить("СООРУЖЕНИЕ", "соор.");
	Сокращения.Вставить("СТРОЕНИЕ", "стр.");
	Сокращения.Вставить("ТОРГОВЫЙ ЗАЛ", "торг.зал");
	Сокращения.Вставить("ЦЕХ", "цех");
	// BSLLS:Typo-on
	
	Возврат Сокращения;
	
КонецФункции

Функция ВерсияФорматаАдресаJSON()
	
	Результат = "4";
	Возврат Число(Результат);
	
КонецФункции

Функция ПолеСтрокаJSON(ДанныеJSON, ИмяПоля)
	
	Значение = ПолеJSON(ДанныеJSON, ИмяПоля);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

Функция ПолеJSON(ДанныеJSON, ИмяПоля)
	
	Если ЭтоСоответствие(ДанныеJSON) Тогда
		Возврат ПолеСоответствияJSON(ДанныеJSON, ИмяПоля);
	КонецЕсли;
	
	Если ТипЗнч(ДанныеJSON) = Тип("Структура") Тогда
		Возврат ПолеСтруктурыJSON(ДанныеJSON, ИмяПоля);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолеСоответствияJSON(СоответствиеJSON, ИмяПоля)
	
	Значение = СоответствиеJSON.Получить(ИмяПоля);
	Если Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	
	ИмяВРег = ВРег(ИмяПоля);
	Для Каждого КлючЗначение Из СоответствиеJSON Цикл
		Если ВРег(Строка(КлючЗначение.Ключ)) = ИмяВРег Тогда
			Возврат КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолеСтруктурыJSON(СтруктураJSON, ИмяПоля)
	
	Если СтруктураJSON.Свойство(ИмяПоля) Тогда
		Возврат СтруктураJSON[ИмяПоля];
	КонецЕсли;
	
	ИмяВРег = ВРег(ИмяПоля);
	Для Каждого КлючЗначение Из СтруктураJSON Цикл
		Если ВРег(КлючЗначение.Ключ) = ИмяВРег Тогда
			Возврат КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЭлементыКорпусовИзJSON(АдресJSON)
	
	Возврат ЭлементыМассиваJSON(АдресJSON, "buildings", "ТипКорпуса", "Номер");
	
КонецФункции

Функция ЭлементыПомещенийИзJSON(АдресJSON)
	
	Возврат ЭлементыМассиваJSON(АдресJSON, "apartments", "ТипПомещения", "Номер");
	
КонецФункции

Функция ЭлементыМассиваJSON(АдресJSON, ИмяМассива, ИмяПоляТипа, ИмяПоляНомера)
	
	Результат = Новый Массив;
	Элементы = ПолеJSON(АдресJSON, ИмяМассива);
	Если НЕ ЭтоМассив(Элементы) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Элемент Из Элементы Цикл
		СтрокаЭлемента = СтрокаТипаНомераИзJSON(Элемент, ИмяПоляТипа, ИмяПоляНомера);
		Если СтрокаЭлемента <> Неопределено Тогда
			Результат.Добавить(СтрокаЭлемента);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаТипаНомераИзJSON(Элемент, ИмяПоляТипа, ИмяПоляНомера)
	
	Если НЕ ЭтоСоответствие(Элемент) И ТипЗнч(Элемент) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаЭлемента = Новый Структура;
	СтрокаЭлемента.Вставить(ИмяПоляТипа, ПолеСтрокаJSON(Элемент, "type"));
	СтрокаЭлемента.Вставить(ИмяПоляНомера, ПолеСтрокаJSON(Элемент, "number"));
	
	Возврат СтрокаЭлемента;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// РАЗБОР XML

Функция СведенияОбАдресеИзXML(ТекстXML)
	
	ДанныеXML = РазобратьКонтактнуюИнформациюXML(ТекстXML);
	Если ДанныеXML = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	АдресJSON = СоответствиеАдресаПоДаннымXML(ДанныеXML);
	Сведения = НовыйСведенияАдреса();
	ЗаполнитьСведенияИзПолейАдресаБСП(Сведения, АдресJSON);
	ДополнитьПредставлениеПоСтруктурнымПолям(Сведения, АдресJSON);
	
	Возврат Сведения;
	
КонецФункции

Функция РазобратьКонтактнуюИнформациюXML(ТекстXML)
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ТекстXML);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Результат = НовыйДанныеРазбораXML();
	СостояниеРазбора = НовыйСостояниеРазбораXML();
	ТекстУзла = "";
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Имя = ЛокальноеИмяЭлементаXML(Чтение.Имя);
			ОбработатьНачалоЭлементаРазбораXML(Имя, Чтение, Результат, СостояниеРазбора);
			ТекстУзла = "";
		КонецЕсли;
		
		Если Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			ТекстУзла = ТекстУзла + Чтение.Значение;
		КонецЕсли;
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Имя = ЛокальноеИмяЭлементаXML(Чтение.Имя);
			ОбработатьКонецЭлементаРазбораXML(Имя, СокрЛП(ТекстУзла), Результат, СостояниеРазбора);
			ТекстУзла = "";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйСостояниеРазбораXML()
	
	Состояние = Новый Структура;
	Состояние.Вставить("ВАдресеРФ", Ложь);
	Состояние.Вставить("ГлубинаСвРайМО", 0);
	Возврат Состояние;
	
КонецФункции

Процедура ОбработатьНачалоЭлементаРазбораXML(Имя, Чтение, Результат, СостояниеРазбора)
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ИмяУзлаРавноИмениXML(Имя, "КонтактнаяИнформация") Тогда
		Результат.Представление = СокрЛП(ЗначениеАтрибутаXML(Чтение, "Представление"));
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "Состав") Тогда
		ОбработатьНачалоСоставаРазбораXML(Чтение, Результат, СостояниеРазбора);
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "СвРайМО") Тогда
		СостояниеРазбора.ГлубинаСвРайМО = СостояниеРазбора.ГлубинаСвРайМО + 1;
	ИначеЕсли СостояниеРазбора.ВАдресеРФ Тогда
		ОбработатьНачалоЭлементаАдресаРФРазбораXML(Имя, Чтение, Результат);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Процедура ОбработатьНачалоСоставаРазбораXML(Чтение, Результат, СостояниеРазбора)
	
	// BSLLS:IfElseIfEndsWithElse-off
	ТипСостава = ЗначениеАтрибутаXML(Чтение, "type");
	Если СтдСтр().СтрНайтиЛок(ТипСостава, "АдресРФ") > 0 Тогда
		СостояниеРазбора.ВАдресеРФ = Истина;
		Результат.АдресРФ = Истина;
	ИначеЕсли СтдСтр().СтрНайтиЛок(ТипСостава, "Адрес") > 0 Тогда
		Страна = ЗначениеАтрибутаXML(Чтение, "Страна");
		Если ЗначениеЗаполнено(Страна) Тогда
			Результат.Страна = Страна;
		КонецЕсли;
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on

КонецПроцедуры

Процедура ОбработатьНачалоЭлементаАдресаРФРазбораXML(Имя, Чтение, Результат)
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ИмяУзлаРавноИмениXML(Имя, "СубъектРФ") Тогда
		Результат.СубъектРФ = "";
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "Район") Тогда
		Результат.Район = "";
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "ГородСелПоселен") Тогда
		Результат.Поселение = "";
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "НаимРайМО") Тогда
		Результат.МуниципальныйРайон = "";
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "Город") Тогда
		Результат.Город = "";
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "НаселПункт") Тогда
		Результат.НаселПункт = "";
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "Улица") Тогда
		Результат.Улица = "";
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "ОКТМО") Тогда
		Результат.ОКТМО = "";
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "ДопАдрЭл") Тогда
		ОбработатьДопАдрЭлВНачалеРазбораXML(Чтение, Результат);
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "Номер") Тогда
		ОбработатьНомерАдресаXML(Результат,
			ЗначениеАтрибутаXML(Чтение, "Тип"),
			ЗначениеАтрибутаXML(Чтение, "Значение"));
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Процедура ОбработатьДопАдрЭлВНачалеРазбораXML(Чтение, Результат)
	
	ТипАдрЭл = ЗначениеАтрибутаXML(Чтение, "ТипАдрЭл");
	Если ТипАдрЭл = "10100000" Тогда
		Результат.Индекс = ЗначениеАтрибутаXML(Чтение, "Значение");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьКонецЭлементаРазбораXML(Имя, ЗначениеТекста, Результат, СостояниеРазбора)
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ИмяУзлаРавноИмениXML(Имя, "СвРайМО") Тогда
		СостояниеРазбора.ГлубинаСвРайМО = СостояниеРазбора.ГлубинаСвРайМО - 1;
		Если СостояниеРазбора.ГлубинаСвРайМО < 0 Тогда
			СостояниеРазбора.ГлубинаСвРайМО = 0;
		КонецЕсли;
	Иначе
		ЗаполнитьПолеАдресаРФПоКонцуЭлементаXML(Имя, ЗначениеТекста, Результат, СостояниеРазбора);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Процедура ЗаполнитьПолеАдресаРФПоКонцуЭлементаXML(Имя, ЗначениеТекста, Результат, СостояниеРазбора)
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ИмяУзлаРавноИмениXML(Имя, "СубъектРФ") Тогда
		Результат.СубъектРФ = ЗначениеТекста;
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "Район") Тогда
		Результат.Район = ЗначениеТекста;
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "ГородСелПоселен") Тогда
		Результат.Поселение = ЗначениеТекста;
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "НаимРайМО") Тогда
		Результат.МуниципальныйРайон = ЗначениеТекста;
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "Город") Тогда
		Результат.Город = ЗначениеТекста;
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "НаселПункт") Тогда
		Результат.НаселПункт = ЗначениеТекста;
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "Улица") Тогда
		Результат.Улица = ЗначениеТекста;
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "ОКТМО") Тогда
		Результат.ОКТМО = ЗначениеТекста;
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "Состав") И ЗначениеЗаполнено(ЗначениеТекста) И Не Результат.АдресРФ Тогда
		Результат.ТекстСвободнойФормы = ЗначениеТекста;
	ИначеЕсли ИмяУзлаРавноИмениXML(Имя, "Состав") Тогда
		СостояниеРазбора.ВАдресеРФ = Ложь;
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Функция НовыйДанныеРазбораXML()
	
	Результат = Новый Структура;
	Результат.Вставить("Представление", "");
	Результат.Вставить("Страна", "");
	Результат.Вставить("ТекстСвободнойФормы", "");
	Результат.Вставить("АдресРФ", Ложь);
	Результат.Вставить("СубъектРФ", "");
	Результат.Вставить("Район", "");
	Результат.Вставить("МуниципальныйРайон", "");
	Результат.Вставить("Поселение", "");
	Результат.Вставить("Город", "");
	Результат.Вставить("НаселПункт", "");
	Результат.Вставить("Улица", "");
	Результат.Вставить("ОКТМО", "");
	Результат.Вставить("Индекс", "");
	Результат.Вставить("Дом", "");
	Результат.Вставить("ТипДома", "Дом");
	Результат.Вставить("Корпуса", Новый Массив);
	Результат.Вставить("Квартира", "");
	Результат.Вставить("ТипКвартиры", "Квартира");
	
	Возврат Результат;
	
КонецФункции

Функция КодТипаОбъектаАдресацииЗдание()
	
	Результат = 1;
	Возврат Результат;
	
КонецФункции

Функция КодТипаОбъектаАдресацииКорпус()
	
	Результат = 2;
	Возврат Результат;
	
КонецФункции

Функция КодТипаОбъектаАдресацииКвартира()
	
	Результат = 3;
	Возврат Результат;
	
КонецФункции

Функция КодТипаОбъектаАдресацииНеЗадан()

	Результат = 0;
	Возврат Результат;

КонецФункции

Функция ЭтоТипОбъектаАдресацииЗдание(ТипОбъекта)
	
	Возврат ТипОбъекта = КодТипаОбъектаАдресацииЗдание();
	
КонецФункции

Функция ЭтоТипОбъектаАдресацииКорпус(ТипОбъекта)
	
	Возврат ТипОбъекта = КодТипаОбъектаАдресацииКорпус();
	
КонецФункции

Функция ЭтоТипОбъектаАдресацииКвартира(ТипОбъекта)
	
	Возврат ТипОбъекта = КодТипаОбъектаАдресацииКвартира();
	
КонецФункции

Функция ТипОбъектаИзОписанияКодаАдресации(ОписаниеКода)
	
	ТипОбъекта = КодТипаОбъектаАдресацииНеЗадан();
	Если ОписаниеКода.Свойство("type") Тогда
		ТипОбъекта = ОписаниеКода.type;
	КонецЕсли;
	
	Возврат ТипОбъекта;
	
КонецФункции

Процедура ОбработатьНомерАдресаТипКорпусаXML(ДанныеXML, Номер, Знач Наименование)
	
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = "Корпус";
	КонецЕсли;
	
	ДобавитьКорпусВДанныеXML(ДанныеXML, Наименование, Номер);
	
КонецПроцедуры

Процедура ОбработатьНомерАдресаТипКвартирыXML(ДанныеXML, Номер, Знач Наименование)
	
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = "Квартира";
	КонецЕсли;
	
	ДанныеXML.Квартира = Номер;
	ДанныеXML.ТипКвартиры = Наименование;
	
КонецПроцедуры

Процедура ОбработатьНомерАдресаXML(ДанныеXML, ТипНомера, Номер)
	
	Если Не ЗначениеЗаполнено(Номер) Тогда
		Возврат;
	КонецЕсли;
	
	Инфо = ОписаниеКодаОбъектаАдресации(ТипНомера);
	Если Инфо = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипОбъекта = ТипОбъектаИзОписанияКодаАдресации(Инфо);
	
	Наименование = "";
	Если Инфо.Свойство("name") Тогда
		Наименование = Инфо.name;
	КонецЕсли;
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ЭтоТипОбъектаАдресацииЗдание(ТипОбъекта) Тогда
		ОбработатьНомерАдресаТипЗданияXML(ДанныеXML, ТипНомера, Номер, Наименование);
	ИначеЕсли ЭтоТипОбъектаАдресацииКорпус(ТипОбъекта) Тогда
		ОбработатьНомерАдресаТипКорпусаXML(ДанныеXML, Номер, Наименование);
	ИначеЕсли ЭтоТипОбъектаАдресацииКвартира(ТипОбъекта) Тогда
		ОбработатьНомерАдресаТипКвартирыXML(ДанныеXML, Номер, Наименование);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Процедура ОбработатьНомерАдресаТипЗданияXML(ДанныеXML, ТипНомера, Номер, Знач Наименование)
	
	Если ЭтоКодОсновногоВладенияАдреса(ТипНомера) Тогда
		
		Если Не ЗначениеЗаполнено(Наименование) Тогда
			Наименование = "Дом";
		КонецЕсли;
		
		ДанныеXML.Дом = Номер;
		ДанныеXML.ТипДома = Наименование;
		
	Иначе
		
		Если Не ЗначениеЗаполнено(Наименование) Тогда
			Наименование = "Корпус";
		КонецЕсли;
		
		ДобавитьКорпусВДанныеXML(ДанныеXML, Наименование, Номер);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКорпусВДанныеXML(ДанныеXML, ТипКорпуса, Номер)
	
	СтрокаКорпуса = ЭлементАдресаПоТипуИНомеру(ТипКорпуса, Номер);
	ДанныеXML.Корпуса.Добавить(СтрокаКорпуса);
	
КонецПроцедуры

Функция СоответствиеАдресаПоДаннымXML(ДанныеXML)
	
	Результат = Новый Соответствие;
	Результат.Вставить("version", ВерсияФорматаАдресаJSON());
	Результат.Вставить("type", "Адрес");
	
	Если ДанныеXML.АдресРФ Тогда
		
		Результат.Вставить("addressType", "Административно-территориальный");
		Результат.Вставить("country", "РОССИЯ");
		Результат.Вставить("countryCode", КодСтраныРоссии());
		Результат.Вставить("value", ДанныеXML.Представление);
		
		ЗаполнитьУровеньАдресаИзСтрокиJSON(Результат, "area", ДанныеXML.СубъектРФ);
		ДобавитьКодРегионаВПоляАдресаБСП(Результат, ДанныеXML.СубъектРФ);
		
		РайонАдминистративный = ДанныеXML.Район;
		Если Не ЗначениеЗаполнено(РайонАдминистративный) Тогда
			РайонАдминистративный = ДанныеXML.МуниципальныйРайон;
		КонецЕсли;
		
		ЗаполнитьУровеньАдресаИзСтрокиJSON(Результат, "district", РайонАдминистративный);
		ЗаполнитьУровеньАдресаИзСтрокиJSON(Результат, "settlement", ДанныеXML.Поселение);
		ЗаполнитьУровеньАдресаИзСтрокиJSON(Результат, "city", ДанныеXML.Город);
		ЗаполнитьУровеньАдресаИзСтрокиJSON(Результат, "locality", ДанныеXML.НаселПункт);
		ЗаполнитьУровеньАдресаИзСтрокиJSON(Результат, "street", ДанныеXML.Улица);
		
		Результат.Вставить("ZIPcode", ДанныеXML.Индекс);
		Результат.Вставить("oktmo", ДанныеXML.ОКТМО);
		Результат.Вставить("houseNumber", ДанныеXML.Дом);
		Результат.Вставить("houseType", ДанныеXML.ТипДома);
		
		Если ДанныеXML.Корпуса.Количество() > 0 Тогда
			Результат.Вставить("buildings", ДанныеXML.Корпуса);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеXML.Квартира) Тогда
			
			Помещение = ЭлементАдресаПоТипуИНомеру(ДанныеXML.ТипКвартиры, ДанныеXML.Квартира);
			
			Помещения = Новый Массив;
			Помещения.Добавить(Помещение);
			
			Результат.Вставить("apartments", Помещения);
			
		КонецЕсли;
		
	Иначе
		
		Страна = "";
		Если ЗначениеЗаполнено(ДанныеXML.Страна) Тогда
			Страна = ДанныеXML.Страна;
		КонецЕсли;
		
		КодСтраны = КодСтраныПоНаименованию(Страна);
		
		ПредставлениеАдреса = ДанныеXML.Представление;
		Если ЗначениеЗаполнено(ДанныеXML.ТекстСвободнойФормы) Тогда
			ПредставлениеАдреса = ДанныеXML.ТекстСвободнойФормы;
		КонецЕсли;
		
		Результат.Вставить("addressType", "ВСвободнойФорме");
		Результат.Вставить("country", Страна);
		Результат.Вставить("countryCode", КодСтраны);
		Результат.Вставить("value", ПредставлениеАдреса);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЛокальноеИмяЭлементаXML(Имя)
	
	Результат = Имя;
	
	Позиция = СтдСтр().СтрНайтиЛок(Имя, ":");
	Если Позиция > 0 Тогда
		Результат = Сред(Имя, Позиция + 1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяУзлаРавноИмениXML(ЛокальноеИмя, Эталон)
	
	Возврат СтдСтр().СтрСравнитьЛок(ЛокальноеИмя, Эталон) = 0;
	
КонецФункции

Функция ЗначениеАтрибутаXML(Чтение, ИмяАтрибута)
	
	Значение = Чтение.ЗначениеАтрибута(ИмяАтрибута);
	Если Значение = Неопределено Тогда
		Значение = Чтение.ЗначениеАтрибута(ИмяАтрибута, "http://www.w3.org/2001/XMLSchema-instance");
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// РАЗБОР ПОЛЕЙ КОНТАКТНОЙ ИНФОРМАЦИИ

Функция СведенияОбАдресеИзПолейКонтактнойИнформации(ДанныеПолей)
	
	АдресJSON = СоответствиеАдресаПоПолямКонтактнойИнформации(ДанныеПолей);
	
	Сведения = НовыйСведенияАдреса();
	
	ЗаполнитьСведенияИзПолейАдресаБСП(Сведения, АдресJSON);
	ДополнитьПредставлениеПоСтруктурнымПолям(Сведения, АдресJSON);
	
	Возврат Сведения;
	
КонецФункции

Функция ЭлементАдресаПоТипуИНомеру(Тип, Номер)
	
	Возврат Новый Структура("type, number", Тип, Номер);
	
КонецФункции

Функция СоответствиеАдресаПоПолямКонтактнойИнформации(ДанныеПолей)
	
	ДанныеJSON = Новый Соответствие;
	ДанныеJSON.Вставить("version", ВерсияФорматаАдресаJSON());
	ДанныеJSON.Вставить("type", "Адрес");
	ДанныеJSON.Вставить("addressType", "Административно-территориальный");
	ДанныеJSON.Вставить("country", "РОССИЯ");
	ДанныеJSON.Вставить("countryCode", "643");
	
	Представление = ЗначениеПоляСтруктуры(ДанныеПолей, "Представление");
	Если ЭтоПредставлениеКИСПотерейСтруктуры(Представление) Тогда
		ДанныеJSON.Вставить("value", "");
	Иначе
		ДанныеJSON.Вставить("value", Представление);
	КонецЕсли;
	ДанныеJSON.Вставить("ZIPcode", ЗначениеПоляСтруктуры(ДанныеПолей, "Поле1"));
	
	ЗаполнитьУровеньАдресаИзСтрокиJSON(ДанныеJSON, "area", ЗначениеПоляСтруктуры(ДанныеПолей, "Поле2"));
	ДобавитьКодРегионаВПоляАдресаБСП(ДанныеJSON, ЗначениеПоляСтруктуры(ДанныеПолей, "Поле2"));
	ЗаполнитьУровеньАдресаИзСтрокиJSON(ДанныеJSON, "district", ЗначениеПоляСтруктуры(ДанныеПолей, "Поле3"));
	ЗаполнитьУровеньАдресаИзСтрокиJSON(ДанныеJSON, "city", ЗначениеПоляСтруктуры(ДанныеПолей, "Поле4"));
	ЗаполнитьУровеньАдресаИзСтрокиJSON(ДанныеJSON, "locality", ЗначениеПоляСтруктуры(ДанныеПолей, "Поле5"));
	ЗаполнитьУровеньАдресаИзСтрокиJSON(ДанныеJSON, "street", ЗначениеПоляСтруктуры(ДанныеПолей, "Поле6"));
	
	ДанныеJSON.Вставить("houseNumber", ЗначениеПоляСтруктуры(ДанныеПолей, "Поле7"));
	ДанныеJSON.Вставить("houseType", НормализоватьТипДомаJSON(ЗначениеПоляСтруктуры(ДанныеПолей, "ТипДома")));
	
	НомерКорпуса = ЗначениеПоляСтруктуры(ДанныеПолей, "Поле8");
	Если ЗначениеЗаполнено(НомерКорпуса) Тогда
		ТипКорпуса = НормализоватьТипКорпусаJSON(ЗначениеПоляСтруктуры(ДанныеПолей, "ТипКорпуса"));
		СтрокаКорпуса = ЭлементАдресаПоТипуИНомеру(ТипКорпуса, НомерКорпуса);
		Корпуса = Новый Массив;
		Корпуса.Добавить(СтрокаКорпуса);
		ДанныеJSON.Вставить("buildings", Корпуса);
	КонецЕсли;
	
	НомерКвартиры = ЗначениеПоляСтруктуры(ДанныеПолей, "Поле9");
	Если Не ЗначениеЗаполнено(НомерКвартиры) Тогда
		НомерКвартиры = ЗначениеПоляСтруктуры(ДанныеПолей, "Поле10");
	КонецЕсли;
	Если ЗначениеЗаполнено(НомерКвартиры) Тогда
		ТипКвартиры = НормализоватьТипКвартирыJSON(ЗначениеПоляСтруктуры(ДанныеПолей, "ТипКвартиры"));
		СтрокаПомещения = ЭлементАдресаПоТипуИНомеру(ТипКвартиры, НомерКвартиры);
		Помещения = Новый Массив;
		Помещения.Добавить(СтрокаПомещения);
		ДанныеJSON.Вставить("apartments", Помещения);
	КонецЕсли;
	
	Возврат ДанныеJSON;
	
КонецФункции

Функция ЭтоПредставлениеКИСПотерейСтруктуры(Представление)
	
	ПредставлениеВРег = ВРег(СокрЛП(Представление));
	Если Не ЗначениеЗаполнено(ПредставлениеВРег) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СтдСтр().СтрНайтиЛок(ПредставлениеВРег, "ДВЛД") > 0
		Или СтдСтр().СтрНайтиЛок(ПредставлениеВРег, "ДОМОВЛАД") > 0;
	
КонецФункции

Функция ЗначениеПоляСтруктуры(Данные, ИмяПоля)
	
	ЗначениеПоУмолчанию = "";
	Результат = СтдКоллекции().СвойствоСтруктурыЛок(Данные, ИмяПоля, ЗначениеПоУмолчанию);
	Возврат СокрЛП(Результат);
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СБОРКА КОНТРАКТА И ВСПОМОГАТЕЛЬНЫЕ ПРЕОБРАЗОВАНИЯ

Функция КонтрактАдресаПоСведениям(Сведения, Представление)
	
	Результат = КонтрактыПровайдеров().НовыйАдрес();
	Результат.Представление = СокрЛП(Представление);
	
	ЗаполнитьПредставленияПоТипам(Результат, Сведения);
	УчестьРасхождениеПредставлений(Результат, Сведения);
	
	ТипАдреса = ТипАдресаПоСведениям(Результат, Сведения);
	ЗаполнитьАдресПоТипу(Результат, Сведения, ТипАдреса);
	Результат.ТипАдреса = ТипАдреса;
	
	Если Не ЗначениеЗаполнено(Результат.Представление) Тогда
		Если Результат.ТипАдреса = ТипАдресаАдминистративный() Тогда
			Результат.Представление = Результат.Административный.Представление;
		ИначеЕсли Результат.ТипАдреса = ТипАдресаМуниципальный() Тогда
			Результат.Представление = Результат.Муниципальный.Представление;
		Иначе
			Результат.Представление = Результат.ВСвободнойФорме.Представление;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьУровеньАдресаИзСтрокиJSON(ДанныеJSON, ИмяУровня, ПолнаяСтрока)
	
	Если Не ЗначениеЗаполнено(ПолнаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	Наименование = "";
	Тип = "";
	РазделитьНаименованиеИТипАдресногоОбъекта(ПолнаяСтрока, Наименование, Тип);
	ДанныеJSON.Вставить(ИмяУровня, Наименование);
	Если ЗначениеЗаполнено(Тип) Тогда
		ДанныеJSON.Вставить(ИмяУровня + "Type", Тип);
	КонецЕсли;
	
КонецПроцедуры

Процедура РазделитьНаименованиеИТипАдресногоОбъекта(ПолнаяСтрока, Наименование, Тип)
	
	Строка = СокрЛП(ПолнаяСтрока);
	Наименование = Строка;
	Тип = "";
	
	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат;
	КонецЕсли;
	
	Части = СтдСтр().СтрРазделитьЛок(Строка, " ", Ложь);
	МинимумЧастей = 2;
	Если Части.Количество() < МинимумЧастей Тогда
		Возврат;
	КонецЕсли;
	
	Тип = Части[Части.ВГраница()];
	МаксимальнаяДлинаТипа = 6;
	Если СтрДлина(Тип) > МаксимальнаяДлинаТипа
		И СтдСтр().СтрНайтиЛок(Тип, ".") = 0 Тогда
		Тип = "";
		Возврат;
	КонецЕсли;
	
	Наименование = "";
	Для Индекс = 0 По Части.ВГраница() - 1 Цикл
		Если Индекс > 0 Тогда
			Наименование = Наименование + " ";
		КонецЕсли;
		Наименование = Наименование + Части[Индекс];
	КонецЦикла;
	
КонецПроцедуры

Функция НормализоватьТипДомаJSON(ТипДома)
	
	Результат = ТипДома;
	
	Если Не ЗначениеЗаполнено(ТипДома)
		Или ЭтоТипЗданияДомJSON(ТипДома) Тогда
		Результат = "Дом";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НормализоватьТипКорпусаJSON(ТипКорпуса)
	
	Результат = ТипКорпуса;
	
	Если Не ЗначениеЗаполнено(ТипКорпуса)
		Или ЭтоТипКорпусаКорпусJSON(ТипКорпуса) Тогда
		Результат = "Корпус";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НормализоватьТипКвартирыJSON(ТипКвартиры)
	
	Результат = ТипКвартиры;
	
	Если Не ЗначениеЗаполнено(ТипКвартиры)
		Или ЭтоТипКвартирыКвJSON(ТипКвартиры) Тогда
		Результат = "Квартира";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КодСтраныПоНаименованию(Страна)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(Страна) Тогда
		
		ПодготовитьКэшАдресныхСправочников();
		Код = КэшОКСМПоНаименованию.Получить(ВРег(СокрЛП(Страна)));
		Если Код <> Неопределено Тогда
			Результат = Код;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ТИП АДРЕСА И ПРЕДСТАВЛЕНИЯ

Функция ТипАдресаВСвободнойФорме()
	
	Возврат "ВСвободнойФорме";
	
КонецФункции

Функция ТипАдресаАдминистративный()
	
	Возврат "Административный";
	
КонецФункции

Функция ТипАдресаМуниципальный()
	
	Возврат "Муниципальный";
	
КонецФункции

Процедура ЗаполнитьПредставленияПоТипам(КонтрактАдреса, Сведения)
	
	КонтрактАдреса.Административный.Представление = Сведения.Представление;
	КонтрактАдреса.Муниципальный.Представление = ПредставлениеМуниципального(Сведения);
	КонтрактАдреса.ВСвободнойФорме.Представление = Сведения.Представление;
	
КонецПроцедуры

Функция ПредставлениеМуниципального(Сведения)
	
	Если ЗначениеЗаполнено(Сведения.МуниципальноеПредставление) Тогда
		Возврат Сведения.МуниципальноеПредставление;
	КонецЕсли;
	
	Возврат Сведения.Представление;
	
КонецФункции

Функция ПредставлениеТипаДляСравнения(КонтрактАдреса, Сведения)
	
	Если ЭтоМуниципальныйАдрес(Сведения.ТипАдресаВJSON) Тогда
		Возврат КонтрактАдреса.Муниципальный.Представление;
	КонецЕсли;
	
	Если ЭтоАдминистративныйАдрес(Сведения.ТипАдресаВJSON) Тогда
		Возврат КонтрактАдреса.Административный.Представление;
	КонецЕсли;
	
	Возврат КонтрактАдреса.ВСвободнойФорме.Представление;
	
КонецФункции

Процедура УчестьРасхождениеПредставлений(КонтрактАдреса, Сведения)
	
	Если Не ЗначениеЗаполнено(КонтрактАдреса.Представление) Тогда
		КонтрактАдреса.РасхождениеПредставлений = Ложь;
		Возврат;
	КонецЕсли;
	
	ПредставлениеТипа = ПредставлениеТипаДляСравнения(КонтрактАдреса, Сведения);
	КонтрактАдреса.РасхождениеПредставлений = Не ПредставленияСовпадают(
		ПредставлениеТипа,
		КонтрактАдреса.Представление);
	
КонецПроцедуры

Функция ТипАдресаПоСведениям(КонтрактАдреса, Сведения)
	
	Результат = ТипАдресаВСвободнойФорме();
	Если Не КонтрактАдреса.РасхождениеПредставлений Тогда
		Если ЭтоМуниципальныйАдрес(Сведения.ТипАдресаВJSON)
			И МуниципальныйАдресСоответствуетАдресуГАР(Сведения) Тогда
			Результат = ТипАдресаМуниципальный();
		КонецЕсли;
		Если Результат = ТипАдресаВСвободнойФорме()
			И ЭтоАдминистративныйАдрес(Сведения.ТипАдресаВJSON)
			И АдминистративныйАдресСоответствуетАдресуРФ(Сведения) Тогда
			Результат = ТипАдресаАдминистративный();
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МуниципальныйАдресСоответствуетАдресуГАР(Сведения)

	ЕстьКодРегиона = ЗначениеЗаполнено(Сведения.КодРегиона);
	ЕстьМуниципальныйРайон = ЗначениеЗаполнено(Сведения.МуниципальныйРайон.Наименование)
		И ЗначениеЗаполнено(Сведения.МуниципальныйРайон.Код);
	ЕстьИдентификаторГАР = ЗначениеЗаполнено(ИдентификаторГАРИзСведений(Сведения));
	Если Не ЕстьКодРегиона Или Не ЕстьМуниципальныйРайон Или Не ЕстьИдентификаторГАР Тогда
		Возврат Ложь;
	КонецЕсли;

	КоличествоПомещенийЗдания = 0;
	КоличествоПомещенийКвартиры = 0;
	Для Каждого Помещение Из Сведения.Помещения Цикл
		Если ЭтоТипПомещенияЗдания(Помещение.ТипПомещения) Тогда
			КоличествоПомещенийЗдания = КоличествоПомещенийЗдания + 1;
		Иначе
			КоличествоПомещенийКвартиры = КоличествоПомещенийКвартиры + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат КоличествоПомещенийЗдания <= 1 И КоличествоПомещенийКвартиры <= 1;

КонецФункции

Функция АдминистративныйАдресСоответствуетАдресуРФ(Сведения)

	// В адресе РФ есть только дом, один корпус и одна квартира.
	ТипДома = ВРег(СокрЛП(Сведения.Здание.ТипЗдания));
	Результат = Не ЗначениеЗаполнено(ТипДома) Или ТипДома = "ДОМ";
	Результат = Результат И Не УровеньСведенийЗаполнен(Сведения.Поселение);
	Результат = Результат И Не УровеньСведенийЗаполнен(Сведения.ПланировочнаяСтруктура);
	Результат = Результат И Не ЗначениеЗаполнено(Сведения.НомерЗемельногоУчастка);
	Результат = Результат И Не ЗначениеЗаполнено(Сведения.Комментарий);
	Результат = Результат И Сведения.Корпуса.Количество() <= 1;
	Если Результат И Сведения.Корпуса.Количество() = 1 Тогда
		Результат = ВРег(СокрЛП(Сведения.Корпуса[0].ТипКорпуса)) = "КОРПУС";
	КонецЕсли;

	Результат = Результат И Сведения.Помещения.Количество() <= 1;
	Если Результат И Сведения.Помещения.Количество() = 1 Тогда
		Результат = ВРег(СокрЛП(Сведения.Помещения[0].ТипПомещения)) = "КВАРТИРА";
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьАдресПоТипу(КонтрактАдреса, Сведения, ТипАдреса)
	
	Если ТипАдреса = ТипАдресаАдминистративный() Тогда
		ЗаполнитьАдминистративныйИзСведений(КонтрактАдреса, Сведения);
	ИначеЕсли ТипАдреса = ТипАдресаМуниципальный() Тогда
		ЗаполнитьМуниципальныйИзСведений(КонтрактАдреса, Сведения);
	Иначе
		ЗаполнитьВСвободнойФормеИзСведений(КонтрактАдреса, Сведения);
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставленияСовпадают(Представление1, Представление2)
	
	Возврат НормализованноеПредставление(Представление1)
		= НормализованноеПредставление(Представление2);
	
КонецФункции

