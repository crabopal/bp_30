// Возвращает свойства набора номенклатур информационной базы.
// Определяет обязательность использования характеристики и упаковки.
//
// Параметры:
//  СсылкаИлиМассив - Массив - ссылки на номенклатуру ИБ, для которой требуется определить свойства.
//  Если передается ссылка, преобразуется в массив
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события
//
// Возвращаемое значение:
//  - Соответствие:
//     * Ключ - ОпределяемыйТип.НоменклатураБЭД - ссылка на номенклатуру ИБ
//     * Значение - Структура - содержит свойства номенклатуры ИБ:
//        * ИспользоватьХарактеристики - Булево - Истина, если ведется учет по характеристикам
//        * ИспользоватьУпаковки - Булево - Истина, если используются упаковки
//        * ОбязательноеЗаполнениеХарактеристики - Булево - Истина, если требуется обязательно указывать характеристику
//  - Неопределено - если типовой не подключен или не указана номенклатура
//
Функция СвойстваНоменклатурыИнформационнойБазы(СсылкаИлиМассив, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь; // BSLLS:FunctionOutParameter-off
	
	Если НЕ ЗначениеЗаполнено(СсылкаИлиМассив) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Соответствие;
	
	Если ТипЗнч(СсылкаИлиМассив) <> Тип("Массив") Тогда
		НаборНоменклатуры = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаИлиМассив);
	Иначе
		НаборНоменклатуры = СсылкаИлиМассив;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаборНоменклатуры) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	ЛОЖЬ КАК ИспользоватьХарактеристики,
		|	ЛОЖЬ КАК ИспользоватьУпаковки,
		|	ЛОЖЬ КАК ОбязательноеЗаполнениеХарактеристики
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В(&НаборНоменклатуры)";
		
		Запрос.УстановитьПараметр("НаборНоменклатуры", НаборНоменклатуры);
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СвойстваНоменклатуры = НовыйСвойстваНоменклатурыИБ();
			ЗаполнитьЗначенияСвойств(СвойстваНоменклатуры, Выборка);
			
			Результат.Вставить(Выборка.Номенклатура, СвойстваНоменклатуры);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает варианты сопоставления номенклатуры по номенклатуре электронного документа
//
// Параметры:
//  НоменклатураЭД - Структура - Номенклатура электронного документа
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события
// 
// Возвращаемое значение:
//  Массив из Структура - см. Контракт_НоменклатураИнформационнойБазы
//
Функция ВариантыСопоставленияНоменклатуры(НоменклатураЭД, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь; // BSLLS:FunctionOutParameter-off
	
	Результат = Новый Массив;
	ЗаполнитьВариантыСопоставленияНоменклатурыПоУмолчанию(Результат, НоменклатураЭД);
	
	Возврат Результат;
	
КонецФункции

// Возвращает описание и взаимосвязь объектов, составляющих номенклатуру информационной базы.
// Используется для типизации полей в мастере сопоставления номенклатуры и установки
// связей праметров выбора
//
// Параметры:
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события.
// 
// Возвращаемое значение:
//  - Структура - данные о структуре номенклатуры информационной базы:
//     * ВладелецНоменклатурыПредставлениеОбъекта - Строка - представление единичного объекта владельца номенклатуры.
//     * НоменклатураПредставлениеОбъекта - Строка - представление единичного объекта номенклатуры.
//     * ХарактеристикаПредставлениеОбъекта - Строка - представление единичного объекта характеристики.
//     * УпаковкаПредставлениеОбъекта - Строка - представление единичного объекта упаковки.
//     * ИмяПараметраСвязиХарактеристики - Строка - имя параметра связи характеристики от номенклатуры.
//     * ИмяПараметраСвязиУпаковки - Строка - имя параметра связи упаковки от номенклатуры.
//  - Неопределено - если типовой модуль не подключен
//
Функция МетаданныеСопоставленияНоменклатуры(СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь; // BSLLS:FunctionOutParameter-off
	
	Результат = НовыйМетаданныеСопоставленияНоменклатуры();
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов") Тогда
		МодульСопоставленияНоменклатуры = ОбщегоНазначения.ОбщийМодуль("СопоставлениеНоменклатурыКонтрагентовСлужебный");
	Иначе
		МодульСопоставленияНоменклатуры = ОбщегоНазначения.ОбщийМодуль("ОбменСКонтрагентамиСлужебный");
	КонецЕсли;
	
	МетаданныеСопоставленияБЭД = МодульСопоставленияНоменклатуры.МетаданныеСопоставленияНоменклатуры();
	
	ЗаполнитьЗначенияСвойств(Результат, МетаданныеСопоставленияБЭД);
	
	Результат.ВладелецНоменклатурыТип = Метаданные.ОпределяемыеТипы.ВладелецНоменклатурыБЭД.Тип;
	Результат.НоменклатураТип = НовыйТипНоменклатурыБЭДДляСопоставления(Метаданные.ОпределяемыеТипы.НоменклатураБЭД.Тип);
	Результат.ХарактеристикаТип = Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатурыБЭД.Тип;
	Результат.УпаковкаТип = Метаданные.ОпределяемыеТипы.УпаковкаНоменклатурыБЭД.Тип;
	
	Возврат Результат;
	
КонецФункции

// Получает номенклатуру информационной базы, соответствующую идентификаторам номенклатуры контрагента
//
// Параметры:
//  ВладелецНоменклатуры - СправочникСсылка - Владелец номенклатуры (контрагент/партнер)
//  ИдентификаторыНоменклатуры - Строка, Массив из Строка - идентификаторы номенклатуры контрагента
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события
// 
// Возвращаемое значение:
//  Соответствие - содержит:
//    * Ключ - Строка - идентификатор номенклатуры контрагента
//    * Значение - Структура - номенклатура информационной базы (см. Контракт_НоменклатураИнформационнойБазы)
//
Функция Номенклатура_СопоставлениеПрочитать(ВладелецНоменклатуры, ИдентификаторыНоменклатуры,
	СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь; // BSLLS:FunctionOutParameter-off
	
	Результат = Новый Соответствие;
	
	Если Не ЗначениеЗаполнено(ИдентификаторыНоменклатуры) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ИдентификаторыНоменклатуры) = Тип("Массив") Тогда
		КоллекцияИдентификаторов = ИдентификаторыНоменклатуры;
	Иначе
		КоллекцияИдентификаторов = Новый Массив;
		КоллекцияИдентификаторов.Добавить(ИдентификаторыНоменклатуры);
	КонецЕсли;
	
	ПрочитатьСоответствиеНоменклатурыБЭД(Результат, ВладелецНоменклатуры, КоллекцияИдентификаторов);
	
	Возврат Результат;
	
КонецФункции

// Записывает сопоставление номенклатуры электронного документа с номенклатурой информационной базы.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - см. Контракт_НоменклатураКонтрагента
//  НоменклатураИБ - Структура - см. Контракт_НоменклатураИнформационнойБазы
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события
//
Процедура ЗаписатьСопоставлениеНоменклатуры(НоменклатураКонтрагента, НоменклатураИБ, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ЗаполнитьИдентификаторНоменклатурыКонтрагента(НоменклатураКонтрагента);
	ЗаписатьСоответствиеНоменклатурыБЭД(НоменклатураКонтрагента, НоменклатураИБ);
	
КонецПроцедуры

// Типовой обработчик события "СписокТиповДокументовДляСоздания"
//
// Параметры:
//  ФорматЭД - Структура - описание типа электронного документа (см. Контракт_ФорматЭлектронногоДокумента)
//  ЭтоФормализованныйДокумент - Булево - Истина, есди это формализованный тип документа
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события
// 
// Возвращаемое значение:
//  СписокЗначений - :
//  * Значение - Строка - идентификатор правила обработки электронного документа
//  * Представление - Строка - пользовательское представление операции
//
Функция ПравилаСозданияДокументовУчета(ФорматЭД, ЭтоФормализованныйДокумент, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь; // BSLLS:FunctionOutParameter-off
	
	Результат = Новый СписокЗначений;
	
	НастройкиВходящих = НастройкиВходящихДокументов();
	Для Каждого Элемент Из НастройкиВходящих Цикл
		Если Элемент.ТипЭлектронногоДокумента = ФорматЭД.ИмяТипа Тогда
			
			ИдентификаторВидаДокумента1С = Элемент.ВидДокумента1С.УникальныйИдентификатор();
			ПредставлениеДокумента1С = Элемент.ВидДокумента1С.Наименование;
			
			ИдентификаторОперации = СтрШаблон(
				"%1#%2",
				Строка(ТипЗнч(Элемент.ВидДокумента1С)),
				Строка(ИдентификаторВидаДокумента1С)
			);
			
			Результат.Добавить(ИдентификаторОперации, ПредставлениеДокумента1С);
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

