	ГенерацияXML = Неопределено;
	ПечатныеФормы = Неопределено;
	РаботаСМаркировкой = Неопределено;
	// BSLLS:UnusedLocalVariable-on
	
КонецПроцедуры

// Инициализирует библиотеку интеграции
//
// Параметры:
//  ИдентификаторИнтеграции - Строка - (Необязательный) идентификатор семейства конфигураций (см. Конфигурации).
//                                     Если не указан, предпринимается попытка вычислить идентификатор по
//                                     метаданным текущей конфигурации (имя, версия, представление и т.д.).
//                                     Если указано невалидное значение, вызывается исключение.
// 
// Возвращаемое значение:
//  ОбработкаОбъект, ВнешняяОбработкаОбъект - инициализированный экземпляр библиотеки
//
Функция КлиентИнформационнойБазы(Знач ИдентификаторИнтеграции = "") Экспорт
	
	Если ТипЗнч(ИдентификаторИнтеграции) <> Тип("Строка") Тогда
		Ошибка = СтдСтрЛок.СтрШаблонЛок("Несоответствие типов ('%1')", ТипЗнч(ИдентификаторИнтеграции));
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	ИдентификаторИнтеграцииКэш = ИдентификаторИнтеграции;
	Если ПустаяСтрока(ИдентификаторИнтеграцииКэш) Тогда
		ИдентификаторИнтеграцииКэш = ВычислитьИдентификаторИнтеграции();
	КонецЕсли;
	
	Если Не Конфигурации.Свойство(ИдентификаторИнтеграцииКэш) Тогда
		Ошибка = СтдСтрЛок.СтрШаблонЛок("Неизвестный идентификатор интеграции ('%1')", ИдентификаторИнтеграции);
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Возврат ЭтотОбъект;
	
КонецФункции

Функция СправочникДокументыНаОтправкуПоУмолчанию() Экспорт
	
	ИнтеграцияСлужебный = ИнтеграционныйМодульДокументооборот();
	Результат = ИнтеграцияСлужебный.СправочникДокументыНаОтправку();
	
	Возврат Результат;
	
КонецФункции

Функция СправочникДокументыВходящиеПоУмолчанию() Экспорт
	
	ИнтеграцияСлужебный = ИнтеграционныйМодульДокументооборот();
	Результат = ИнтеграцияСлужебный.СправочникДокументыВходящие();
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
//{ СОБЫТИЯ ПОДКЛЮЧАЕМОГО МОДУЛЯ

Функция ОбработатьСобытие(ИмяСобытия, Параметры) Экспорт // BSLLS:TooManyReturns-off
	
	// BSLLS:TooManyReturns-off
	Если ИмяСобытия = "ПолучитьТаблицуИспользуемыхВидовДокументов" Тогда
		
		Возврат ПолучитьТаблицуИспользуемыхВидовДокументов(Параметры);
		
	ИначеЕсли ИмяСобытия = "ПодготовитьПакет" Тогда
		
		Возврат ПодготовитьПакет(Параметры);
		
	ИначеЕсли ИмяСобытия = "ПодготовитьЭлектронныйДокумент" Тогда
		
		Возврат ПодготовитьЭлектронныйДокумент(Параметры);
		
	ИначеЕсли ИмяСобытия = "НайтиСопоставлениеДокумента" Тогда
		
		Возврат НайтиСопоставлениеДокумента(Параметры);
		
	ИначеЕсли ИмяСобытия = "ПолучитьЗаполненныйОбъектДокумента1С" Тогда
		
		Возврат ПолучитьЗаполненныйОбъектДокумента1С(Параметры);
		
	ИначеЕсли ИмяСобытия = "ЗаполнитьТаблицуСопоставленияНоменклатуры" Тогда
		
		Возврат ЗаполнитьТаблицуСопоставленияНоменклатуры(Параметры);
		
	ИначеЕсли ИмяСобытия = "ПравилаСопоставленияДокумента" Тогда
		
		Возврат ПравилаСопоставленияДокумента(Параметры);
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	// BSLLS:TooManyReturns-on
	
КонецФункции

// Исходящие

// В функции определяется название видов документов на отправку и их характеристики
//
// Параметры:
//  Параметры - Структура - Параметр оставлен для совместимости
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. Ядро.ПредопределенныеСписки_ОписаниеВидовДокументов
//
Функция ПолучитьТаблицуИспользуемыхВидовДокументов(Параметры)
	
	ТЗ = ТаблицаЗначенийСКолонками(
		"ID, Наименование, ТипДокументаAPI, ТипКонтентаAPI, ФункцияДокументаAPI, БазовыйВидДокумента");
	
	ОсновнойМодуль.ЭДО_Служебные_ДобавитьСтрокуВТаблицуЗначений(ТЗ,
		"ID_Договор", "Договор", "Contract", "");
	ОсновнойМодуль.ЭДО_Служебные_ДобавитьСтрокуВТаблицуЗначений(ТЗ,
		"ID_ДопСоглашение", "Дополнительное соглашение", "SupplementaryAgreement", "");
	ОсновнойМодуль.ЭДО_Служебные_ДобавитьСтрокуВТаблицуЗначений(ТЗ,
		"ID_Письмо", "Письмо", "Letter", "nonformalizedletter");
	ОсновнойМодуль.ЭДО_Служебные_ДобавитьСтрокуВТаблицуЗначений(ТЗ,
		"ID_Счет", "Счет на оплату", "ProformaInvoice", "");
	ОсновнойМодуль.ЭДО_Служебные_ДобавитьСтрокуВТаблицуЗначений(ТЗ,
		"ID_АктСверки", "Акт сверки", "ReconciliationAct", "");
	ОсновнойМодуль.ЭДО_Служебные_ДобавитьСтрокуВТаблицуЗначений(ТЗ,
		"ID_Прочее", "Неформализованный", "Nonformalized", "");
	
	Возврат ТЗ;
	
КонецФункции

// Используется для формирования правил, по которым каждый из пакетов на отправку будет наполняться документами
//
// Параметры:
//  Параметры - Структура:
//   * ВидПакетаРазвернутый - Структура - реквизиты вида пакета из функции ПолучитьТаблицуИспользуемыхПакетов
//   * СтрокаСписка - Структура - структура, соответствующая строке из списка пакетов для отправки
//   * Пакет - Структура - структура, которая содержит основные сведения о пакете и его составе
// 
// Возвращаемое значение:
//  Булево - Истина, Стандартное значение
//
Функция ПодготовитьПакет(Параметры)
	
	Документ1С = Параметры.СтрокаСписка.Документ;
	ВидДокумента = Параметры.ВидПакетаРазвернутый.ID;
	Файлы = ФайлыДокумента(Документ1С);
	
	ДопПараметры = Новый Структура;
	
	ДопПараметры.Вставить("НомерДокумента", Параметры.СтрокаСписка.НомерДокумента);
	ДопПараметры.Вставить("ДатаДокумента", Параметры.СтрокаСписка.ДатаДокумента);
	ДопПараметры.Вставить("СуммаДокумента", Параметры.СтрокаСписка.СуммаДокумента);
	
	Для Каждого ДанныеФайла Из Файлы Цикл
		
		ДопПараметры.Вставить("Файл", ДанныеФайла.Файл);
		
		ОсновнойМодуль.ЭДО_ДокументМенеджер_ПодготовитьИДобавитьДокументВПакет(
			Параметры.Пакет,
			Документ1С,
			ВидДокумента,
			ДопПараметры
		);
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Заполнение контента всех документов, которые необходимо включить в пакет для отправки
//
// Параметры:
//  Параметры - Структура:
//   * Результат - Структура - Элементы структуры определяются
//     в функции основного модуля "ЭДО_ДокументМенеджер_РеквизитыДокументаСтрокой"
//   * ВидДокументаРазвернутый - Структура-  реквизиты вида документа из функции 
//     ПолучитьТаблицуИспользуемыхВидовДокументов, см. ВидЭлектронногоДокумента
//   * ДополнительныеПараметры - Структура - дополнительные параметры,
//     которые могут потребоваться при сборе контента. Передаются из события ПодготовитьПакет
//   * ДанныеСотрудника - Структура - ФИО, должность, Id, ИНН сертификата пользователя текущего сеанса
// 
// Возвращаемое значение:
//  Булево - Истина, Стандартное значение
//
Функция ПодготовитьЭлектронныйДокумент(Параметры)
	
	Результат = Параметры.Результат;
	
	ДопПараметры = Параметры.ДополнительныеПараметры;
	
	МодульРаботаСФайламиВызовСервера = ОбщийМодульПоИмениЛок("РаботаСФайламиВызовСервера");
	ДанныеФайла = МодульРаботаСФайламиВызовСервера.ДанныеФайлаИДвоичныеДанные(ДопПараметры.Файл);
	
	Результат.ДвоичныеДанные = ДанныеФайла.ДвоичныеДанные;
	Результат.ДвоичныеДанныеПодписи = ДвоичныеДанныеПодписи(ДопПараметры.Файл);
	
	Если Параметры.ВидДокументаРазвернутый.ID = "ID_Прочее" Тогда
		
		Результат.Метаданные.DocumentNumber = ДопПараметры.НомерДокумента;
		Результат.Метаданные.DocumentDate = ДопПараметры.ДатаДокумента;
		Результат.Метаданные.FileName = СтрШаблон(
			"%1.%2",
			ДанныеФайла.ДанныеФайла.ПолноеНаименованиеВерсии,
			ДанныеФайла.ДанныеФайла.Расширение
		);
		
	ИначеЕсли Параметры.ВидДокументаРазвернутый.ID = "ID_Договор" Тогда
		
		Результат.Метаданные.DocumentNumber = ДопПараметры.НомерДокумента;
		Результат.Метаданные.DocumentDate = ДопПараметры.ДатаДокумента;
		Результат.Метаданные.ContractPrice = ДопПараметры.СуммаДокумента;
		Результат.Метаданные.FileName = СтрШаблон(
			"%1.%2",
			ДанныеФайла.ДанныеФайла.ПолноеНаименованиеВерсии,
			ДанныеФайла.ДанныеФайла.Расширение
		);
		
	ИначеЕсли Параметры.ВидДокументаРазвернутый.ID = "ID_ДопСоглашение" Тогда
		
		Результат.Метаданные.DocumentNumber = ДопПараметры.НомерДокумента;
		Результат.Метаданные.DocumentDate = ДопПараметры.ДатаДокумента;
		Результат.Метаданные.TotalSum = ДопПараметры.СуммаДокумента;
		Результат.Метаданные.FileName = СтрШаблон(
			"%1.%2",
			ДанныеФайла.ДанныеФайла.ПолноеНаименованиеВерсии,
			ДанныеФайла.ДанныеФайла.Расширение
		);
		
	ИначеЕсли Параметры.ВидДокументаРазвернутый.ID = "ID_Письмо" Тогда
		
		Результат.Метаданные.DocumentNumber = ДопПараметры.НомерДокумента;
		Результат.Метаданные.DocumentDate = ДопПараметры.ДатаДокумента;
		Результат.Метаданные.FileName = СтрШаблон(
			"%1.%2",
			ДанныеФайла.ДанныеФайла.ПолноеНаименованиеВерсии,
			ДанныеФайла.ДанныеФайла.Расширение
		);
		
	ИначеЕсли Параметры.ВидДокументаРазвернутый.ID = "ID_Счет" Тогда
		
		Результат.Метаданные.DocumentNumber = ДопПараметры.НомерДокумента;
		Результат.Метаданные.DocumentDate = ДопПараметры.ДатаДокумента;
		Результат.Метаданные.TotalSum = ДопПараметры.СуммаДокумента;
		Результат.Метаданные.FileName = СтрШаблон(
			"%1.%2",
			ДанныеФайла.ДанныеФайла.ПолноеНаименованиеВерсии,
			ДанныеФайла.ДанныеФайла.Расширение
		);
		
	ИначеЕсли Параметры.ВидДокументаРазвернутый.ID = "ID_АктСверки" Тогда
		
		Результат.Метаданные.DocumentNumber = ДопПараметры.НомерДокумента;
		Результат.Метаданные.FileName = СтрШаблон(
			"%1.%2",
			ДанныеФайла.ДанныеФайла.ПолноеНаименованиеВерсии,
			ДанныеФайла.ДанныеФайла.Расширение
		);
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ДвоичныеДанныеПодписи(Файл)
	
	Результат = Неопределено;
	
	МодульРаботаСЭП = ОбщийМодульПоИмениЛок("РаботаСЭП");
	ДанныеПодписиВыборка = МодульРаботаСЭП.ПолучитьЭлектронныеПодписи(Файл.ТекущаяВерсия);
	
	Если ДанныеПодписиВыборка.Следующий() Тогда
		
		Подпись = ДанныеПодписиВыборка.Подпись;
		
		Результат = Подпись.Получить();
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

// Входящие

// Создание документа по данным из Диадока
//
// Параметры:
//  Параметры - Структура:
//   * Документ - Структура - данные электронного документа, для которого необходимо создать документ в 1С
//   * ДокументДД - СправочникСсылка.Диадок_Документы - Устарел. Используется для совместимости с 3.2.47 и ниже
//   * ДополнительныеПараметры - Структура - дополнительные параметры, необходимые для создания документа 1С
//   * ИдентификаторОперации - Строка - значение выбранного элемента из СписокТиповДокументовДляСоздания
//   * ПакетДД - СправочникСсылка - содержит описание пакета, к которому относится электронный документ
//   * Контент - Структура - двоичные данные контента электронного документа, полученные с сервера Диадока
// 
// Возвращаемое значение:
//  Структура - См. ОсновнойМодуль.НовыйРезультатФункции
//
Функция ПолучитьЗаполненныйОбъектДокумента1С(Параметры)
	
	Если НЕ ЗначениеЗаполнено(Параметры.ИдентификаторОперации) Тогда
		ТекстОшибки = НСтр("ru='Не найдено правило создания для выбранного вида электронного документа'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Результат = ОсновнойМодуль.НовыйРезультатФункции();
	
	ИнтеграцияСлужебный = ИнтеграционныйМодульДокументооборот();
	ОсновнойОбъект = ИнтеграцияСлужебный.НовыйДокумент1С(Параметры.Документ, Параметры.ИдентификаторОперации);
	
	ДобавитьПечатнуюФормуЭлектронногоДокумента(
		Параметры.Документ.Идентификаторы,
		Параметры.Документ.ИмяФайла,
		ОсновнойОбъект.Ссылка
	);
	
	Результат.ОсновнойОбъект = ОсновнойОбъект;
	Параметры.ДополнительныеПараметры.Вставить("ДокументОснование", ОсновнойОбъект);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьПечатнуюФормуЭлектронногоДокумента(ИдентификаторыДокумента, ИмяФайла, ВладелецФайлов)
	
	АдресДвоичныхДанныхПФ = ПечатнаяФормаЭлектронногоДокумента(ИдентификаторыДокумента);
	Если ЗначениеЗаполнено(АдресДвоичныхДанныхПФ) Тогда
		
		МодульРаботаСФайлами = ОбщийМодульПоИмениЛок("РаботаСФайлами");
		
		ПараметрыДобавленияФайла = МодульРаботаСФайлами.ПараметрыДобавленияФайла();
		ПараметрыДобавленияФайла.ВладелецФайлов = ВладелецФайлов;
		ПараметрыДобавленияФайла.Служебный = Ложь;
		ПараметрыДобавленияФайла.Автор = Пользователи.ТекущийПользователь();
		ПараметрыДобавленияФайла.ИмяБезРасширения = ИмяФайла;
		ПараметрыДобавленияФайла.РасширениеБезТочки = ФорматPDF();
		
		МодульРаботаСФайлами.ДобавитьФайл(ПараметрыДобавленияФайла, АдресДвоичныхДанныхПФ);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатнаяФормаЭлектронногоДокумента(ИдентификаторыДокумента)
	
	Результат = Неопределено;
	
	Попытка
		ДвоичныеДанныеПФ = Ядро.Документы_ПечатнаяФормаСервераДиадок(ИдентификаторыДокумента);
	Исключение
		
		ОшибкаИнфо = ИнформацияОбОшибке();
		Если ЯвляетсяОшибкойКатегории(ОшибкаИнфо, ОшибкаНеПоддерживаетсяГенерацияПечатнойФормы()) Тогда
			ОбработатьОшибкуНеПоддерживаетсяГенерацияПечатнойФормы();
		ИначеЕсли ЯвляетсяОшибкойКатегории(ОшибкаИнфо, ОшибкаОжиданияГенерацииПечатнойФормы()) Тогда
			ОбработатьОшибкуОжиданияГенерацииПечатнойФормы();
			ВызватьИсключение;
		Иначе
			ВызватьИсключение;
		КонецЕсли;
		
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ДвоичныеДанныеПФ) Тогда
		Результат = ПоместитьВоВременноеХранилище(ДвоичныеДанныеПФ, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

