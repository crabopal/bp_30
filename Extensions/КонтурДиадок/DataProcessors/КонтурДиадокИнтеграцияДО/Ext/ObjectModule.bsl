Функция ВидыПредопределенныхДокументовДляПоискаВМодуле() Экспорт
	
	ИнтеграцияСлужебный = ИнтеграционныйМодульДокументооборот();
	Результат = ИнтеграцияСлужебный.ВидыПредопределенныхДокументовДляПоискаВМодуле();
	
	Возврат Результат;
	
КонецФункции

// Значения реквизитов документов учета организация контрагент
//
// Параметры:
//  КоллекцияДокументов - Соответствие - Соотвествие типов документов
//  где ключ это Тип документа а значение это массив документов
// 
// Возвращаемое значение:
//  Соотвествие - Соответствие в котором ключом является сам документ,
//  а в значении структура ревизитов (Организация, Контрагент)
//
Функция ЗначенияРеквизитовДокументовУчета_ОрганизацияКонтрагент(КоллекцияДокументов) Экспорт
	
	ПервыйЭлемент = КоллекцияДокументов[0];
	МетаданныеЭлемента = ПервыйЭлемент.Метаданные();
	
	Реквизиты = Новый Массив;
	Если ЕстьРеквизитОбъектаЛок("Организация", МетаданныеЭлемента) Тогда
		Реквизиты.Добавить("Организация");
	КонецЕсли;
	
	Если ЕстьРеквизитОбъектаЛок("Контрагент", МетаданныеЭлемента) Тогда
		Реквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Результат = ЗначенияРеквизитовОбъектовЛок(КоллекцияДокументов, Реквизиты);
	
	Возврат Результат;
	
КонецФункции

