Процедура ЗаписатьСоответствиеНоменклатурыБЭД(НоменклатураКонтрагента, НоменклатураИБ)
	
	Набор = РегистрыСведений.НоменклатураКонтрагентовБЭД.СоздатьНаборЗаписей();
	Набор.Отбор.Владелец.Установить(НоменклатураКонтрагента.Владелец);
	Набор.Отбор.Идентификатор.Установить(НоменклатураКонтрагента.Идентификатор);
	
	Запись = Набор.Добавить();
	
	ЗаполнитьЗначенияСвойств(Запись, НоменклатураКонтрагента);
	ЗаполнитьЗначенияСвойств(Запись, НоменклатураИБ);
	
	Набор.Записать();
	
КонецПроцедуры

// Запоняет варианты сопоставления номенклатурыИБ по полям НоменклатураКонтрагента
//
// Параметры:
//  Результат - Массив - Используется для заполнения контрактами НоваяНоменклатураИнформационнойБазы
//  НоменклатураКонтрагента - Структура - Структура полей см. Контракт_НоменклатураКонтрагента
//
Процедура ЗаполнитьВариантыСопоставленияНоменклатурыПоУмолчанию(Результат, НоменклатураКонтрагента)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ИменаВТ = Новый Массив;
	
	ДобавитьЗапросПоАртикулу(МенеджерВТ, ИменаВТ, НоменклатураКонтрагента.Артикул);
	ДобавитьЗапросПоАртикулу(МенеджерВТ, ИменаВТ, НоменклатураКонтрагента.Код);
	ДобавитьЗапросПоНаименованию(МенеджерВТ, ИменаВТ, НоменклатураКонтрагента.Наименование);
	
	Если НЕ ЗначениеЗаполнено(ИменаВТ) Тогда
		Возврат;
	КонецЕсли;
	
	МассивЗапросов = Новый Массив;
	Для Каждого ИмяВТ Из ИменаВТ Цикл
		МассивЗапросов.Добавить("ВЫБРАТЬ * ИЗ " + ИмяВТ);
	КонецЦикла;
	Разделитель = " ОБЪЕДИНИТЬ ";
	
	ИтоговыйТекст = СтдСтр().СтрСоединитьЛок(МассивЗапросов, Разделитель);
	
	Запрос = Новый Запрос(ИтоговыйТекст);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НоменклатураИБ = НоваяНоменклатураИнформационнойБазы(ВыборкаДетальныеЗаписи.НоменклатураСсылка);
		
		Результат.Добавить(НоменклатураИБ);
		
	КонецЦикла;
	
КонецПроцедуры

// Добавить запрос по артикулу
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц запроса на варианты сопоставления номенклатуры
//  ИменаВТ - Массив - Массив имен временных таблиц
//  Артикул - Строка - Искомый артикул
//
Процедура ДобавитьЗапросПоАртикулу(МенеджерВТ, ИменаВТ, Артикул)
	
	Если Не ЗначениеЗаполнено(Артикул) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВТ = "ВТ_ПоАртикулу" + XMLСтрока(ИменаВТ.Количество());
	
	Текст = 
	"ВЫБРАТЬ
	|  Т.Ссылка КАК НоменклатураСсылка
	|ПОМЕСТИТЬ ИмяВТ
	|ИЗ
	|  Справочник.Номенклатура КАК Т
	|ГДЕ
	|  Т.Артикул = &Артикул
	|  И НЕ Т.ЭтоГруппа
	|  И НЕ Т.ПометкаУдаления";
	
	Запрос = Новый Запрос(Текст);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяВТ", ИмяВТ);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Параметры.Вставить("Артикул", Артикул); 
	
	Запрос.Выполнить();
	
	ИменаВТ.Добавить(ИмяВТ);
	
КонецПроцедуры

// Добавить запрос по наименованию
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц запроса на варианты сопоставления номенклатуры
//  ИменаВТ - Массив - Массив имен временных таблиц
//  Наименование - Строка - Искомое наименование
//
Процедура ДобавитьЗапросПоНаименованию(МенеджерВТ, ИменаВТ, Наименование)
	
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВТ = "ВТ_ПоНаименованию" + XMLСтрока(ИменаВТ.Количество());
	
	Текст =
		"ВЫБРАТЬ
		|  Т.Ссылка КАК НоменклатураСсылка
		|ПОМЕСТИТЬ ИмяВТ
		|ИЗ
		|  Справочник.Номенклатура КАК Т
		|ГДЕ
		|  Т.Наименование = ВЫРАЗИТЬ(&Наименование КАК Строка(1024))
		|  И НЕ Т.ЭтоГруппа
		|  И НЕ Т.ПометкаУдаления";
	
	Запрос = Новый Запрос(Текст);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяВТ", ИмяВТ);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Параметры.Вставить("Наименование", Наименование);
	
	Запрос.Выполнить();
	
	ИменаВТ.Добавить(ИмяВТ);
	
КонецПроцедуры

// Возвращает набор данных, представляющий номенклатуру информационной базы
//
// Параметры:
//  Номенклатура - ОпределяемыйТип.НоменклатураБЭД - значение для инициализации свойства Номенклатура
//  Характеристика - ОпределяемыйТип.ХарактеристикаНоменклатурыБЭД - значение для инициализации свойства Характеристика
//  Упаковка - ОпределяемыйТип.УпаковкаНоменклатурыБЭД - значение для инициализации свойства Упаковка
// 
// Возвращаемое значение:
//  Структура - данные, представляющие номенклатуру информационной базы:
//  * Номенклатура - ОпределяемыйТип.НоменклатураБЭД, Неопределено - Номенклатура ИБ.
//    Неопределено, если не инициализировано
//  * Характеристика - ОпределяемыйТип.ХарактеристикаНоменклатурыБЭД, Неопределено - характеристика номенклатуры ИБ.
//    Неопределено, если не инициализировано
//  * Упаковка - ОпределяемыйТип.УпаковкаНоменклатурыБЭД, Неопределено - упаковка номенклатуры информационной базы.
//    Неопределено, если не инициализировано
//
Функция НоваяНоменклатураИнформационнойБазы(Номенклатура = Неопределено, Характеристика = Неопределено,
	Упаковка = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Номенклатура);
	Результат.Вставить("Характеристика", Характеристика);
	Результат.Вставить("Упаковка", Упаковка);
	
	Возврат Результат;
	
КонецФункции

Функция НастройкиВходящихДокументов()
	
	ОписаниеТиповДокументов = ДоступныеТипыДокументов();
	
	МодульХранение = Модуль_ХранениеДанныхДО();
	РасширенныеНастройкиВходящих = МодульХранение.РасширенныеНастройкиВходящих(ОписаниеТиповДокументов);
	
	Результат = Новый Массив;
	
	Для Каждого Элемент Из РасширенныеНастройкиВходящих Цикл
		
		Настройка = Новый Структура;
		Настройка.Вставить("ТипЭлектронногоДокумента", Элемент.Значение);
		Настройка.Вставить("ВидДокумента1С", Элемент.Ключ);
		
		Результат.Добавить(Настройка);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДоступныеТипыДокументов()
	
	Ядро.ТипыДокументовAPI_Обновить();
	ОписаниеТиповЭД = Ядро.ПредопределенныеСписки_ТипыДокументовAPI();
	
	ТипыЭД = ОписаниеТиповЭД.Скопировать(, "Title, TypeNamedId");
	ТипыЭД.Свернуть("Title, TypeNamedId");
	
	Результат = Новый Структура;
	Для Каждого Элемент Из ТипыЭД Цикл
		
		Если ЗначениеЗаполнено(Элемент.TypeNamedId) Тогда
			Результат.Вставить(Элемент.TypeNamedId, Элемент.Title);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

