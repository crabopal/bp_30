		"ru='Не удалось получить печатную форму документа из сервиса Диадок.
		|Попробуйте выполнить операцию позже. При повторении ошибки обратитесь в поддержку.'"
	);
	
	Ядро.Ошибка_Обработать(
		ВидОперацииГенерацияПечатнойФормы(),
		ТекстОшибки
	);
	
КонецПроцедуры

Функция ВидОперацииГенерацияПечатнойФормы()
	
	Возврат "ГенерацияПечатнойФормы";
	
КонецФункции

//} Обработчики ошибок

////////////////////////////////////////////////////////////////////////////////
//{ Обработка ошибок

Функция ЯвляетсяОшибкойКатегории(Знач Ошибка, Знач Категория)
	
	Если Категория = ОшибкаНеПоддерживаетсяГенерацияПечатнойФормы() Тогда
		Результат = ЭтоОшибкаНеПоддерживаетсяГенерацияПечатнойФормы(Ошибка);
	ИначеЕсли Категория = ОшибкаОжиданияГенерацииПечатнойФормы() Тогда
		Результат = ЭтоОшибкаОжиданияГенерацииПечатнойФормы(Ошибка);
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоОшибкаНеПоддерживаетсяГенерацияПечатнойФормы(Знач Ошибка)
	
	Если ТипЗнч(Ошибка) = Тип("Строка") Тогда
		ТекстОшибки = НРег(Ошибка);
	Иначе
		ТекстОшибки = НРег(ПодробноеПредставлениеОшибки(Ошибка));
	КонецЕсли;
	
	// HTTP-ответ с ошибкой вида "409 generating print form for this type of document is not supported"
	Результат = (
		СтдСтрЛок.СтрНайтиЛок(ТекстОшибки, "409")
		И СтдСтрЛок.СтрНайтиЛок(ТекстОшибки, "generating print form for this type of document is not supported")
	);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоОшибкаОжиданияГенерацииПечатнойФормы(Знач Ошибка)
	
	Если ТипЗнч(Ошибка) = Тип("Строка") Тогда
		ТекстОшибки = НРег(Ошибка);
	Иначе
		ТекстОшибки = НРег(ПодробноеПредставлениеОшибки(Ошибка));
	КонецЕсли;
	
	// HTTP-ответ с ошибкой вида "Превышено максимальное время ожидания генерации печатной формы документа"
	Результат = СтдСтрЛок.СтрНайтиЛок(
		ТекстОшибки,
		"Превышено максимальное время ожидания генерации печатной формы документа"
	);
	
	Возврат Результат;
	
КонецФункции

Функция ОшибкаНеПоддерживаетсяГенерацияПечатнойФормы()
	
	Возврат "GeneratePrintFormNotSupported";
	
КонецФункции

Функция ОшибкаОжиданияГенерацииПечатнойФормы()
	
	Возврат "WaitGeneratePrintForm";
	
КонецФункции

//} Обработка ошибок

////////////////////////////////////////////////////////////////////////////////
//{ ПОДКЛЮЧЕНИЕ ВО ВНЕШНИЕ ОБРАБОТКИ

Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "Диадок (СКБ Контур): Подключаемый модуль");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Версия", ЭДО_ВерсияAPIПодключаемогоМодуля());
	ПараметрыРегистрации.Вставить("Информация",
		"Модуль работы с электронными первичными документами через Диадок (подключаемая часть)");
	
	ТаблицаКоманд = ТаблицуКомандОбработки();
	
	ДобавитьКоманду(ТаблицаКоманд, "Выполнение регламентных операций подключаемого модуля Диадок",
		"ПМ_ВыполнитьРегламентныеДействия", "ВызовСерверногоМетода");
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция ТаблицуКомандОбработки()
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", ТипСтрока);
	Команды.Колонки.Добавить("Идентификатор", ТипСтрока);
	Команды.Колонки.Добавить("Использование", ТипСтрока);
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", ТипСтрока);
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь,
	Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

//} ПОДКЛЮЧЕНИЕ ВО ВНЕШНИЕ ОБРАБОТКИ

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция СтдСтр()
	
	Если СтдСтрЛок = Неопределено Тогда
		
		Если ЭтоВнешняяОбработкаЛок() Тогда
			СтдСтрЛок = Новый("ExternalDataProcessorObject.КонтурДиадокСтдСтр");
		Иначе
			СтдСтрЛок = Новый("DataProcessorObject.КонтурДиадокСтдСтр");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтдСтрЛок;
	
КонецФункции

Функция СтдКоллекции()
	
	Если СтдКоллекцииЛок = Неопределено Тогда
		
		Если ЭтоВнешняяОбработкаЛок() Тогда
			СтдКоллекцииЛок = Новый("ExternalDataProcessorObject.КонтурДиадокСтдКоллекции");
		Иначе
			СтдКоллекцииЛок = Новый("DataProcessorObject.КонтурДиадокСтдКоллекции");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтдКоллекцииЛок;
	
КонецФункции

Функция ЭтоВнешняяОбработкаЛок() Экспорт
	
	Если ЭтоВнешняяОбработкаКэш = Неопределено Тогда
		
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
		ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
		
		ЭтоВнешняяОбработкаКэш = ПараметрыПроверки.ИспользуемоеИмяФайла <> Неопределено;
		
	КонецЕсли;
	
	Возврат ЭтоВнешняяОбработкаКэш;
	
КонецФункции 

Функция МаркерыКонфигураций()
	
	Значения = Новый Структура;
	Значения.Вставить("ДО30", "ДО30");
	Значения.Вставить("ДО21", "ДО21");
	
	Результат = СтдКоллекции().ФиксированныеДанныеЛок(Значения);
	
	Возврат Результат;
	
КонецФункции

Функция ВычислитьИдентификаторИнтеграции()
	
	ЭтоКонфигурацияДО30 = (
		СтдСтрЛок.СтрНачинаетсяСЛок(Метаданные.Имя, "Документооборот")
		И СтдСтрЛок.СтрНачинаетсяСЛок(Метаданные.Версия, "3.0")
	);
	
	ЭтоКонфигурацияДО21 = (
		СтдСтрЛок.СтрНачинаетсяСЛок(Метаданные.Имя, "Документооборот")
		И СтдСтрЛок.СтрНачинаетсяСЛок(Метаданные.Версия, "2.1")
	);
	
	Если ЭтоКонфигурацияДО30 Тогда
		Результат = Конфигурации.ДО30;
	ИначеЕсли ЭтоКонфигурацияДО21 Тогда
		Результат = Конфигурации.ДО21;
	Иначе
		Ошибка = СтдСтрЛок.СтрШаблонЛок(
			"Не удалось вычислить идентификатор интеграции ДО (Имя = '%1'; Версия = '%2')",
			Метаданные.Имя,
			Метаданные.Версия
		);
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИнтеграционныйМодульДокументооборот() Экспорт
	
	Если ПустаяСтрока(ИдентификаторИнтеграцииКэш) Тогда
		ИдентификаторИнтеграцииКэш = ВычислитьИдентификаторИнтеграции();
	КонецЕсли;
	
	Если ИдентификаторИнтеграцииКэш = Конфигурации.ДО30 Тогда
		ИмяИМ = "ИнтеграцияСлужебныйДО30";
	ИначеЕсли ИдентификаторИнтеграцииКэш = Конфигурации.ДО21 Тогда
		ИмяИМ = "ИнтеграцияСлужебныйДО21";
	ИначеЕсли Не ЗначениеЗаполнено(ИдентификаторИнтеграцииКэш) Тогда
		ВызватьИсключение "Не указан идентификатор интеграции ДО";
	Иначе
		ВызватьИсключение СтдСтрЛок.СтрШаблонЛок("Неожиданное значение идентификатора интеграции ДО ('%1')",
			ИдентификаторИнтеграцииКэш);
	КонецЕсли;
	
	Если ЭтоВнешняяОбработкаЛок() Тогда
		Результат = Новый("ExternalDataProcessorObject.КонтурДиадок" + ИмяИМ);
	Иначе
		Результат = Новый("DataProcessorObject.КонтурДиадок" + ИмяИМ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Модуль_ХранениеДанныхДО()
	
	Если МодульХранениеКэш = Неопределено Тогда
		
		ПолноеИмяТипа = "DataProcessorObject.КонтурДиадокИнтеграцияХранениеДанныхДО";
		Если ЭтоВнешняяОбработкаЛок() Тогда
			ПолноеИмяТипа = "ExternalDataProcessorObject.КонтурДиадокИнтеграцияХранениеДанныхДО";
		КонецЕсли;
		
		МодульХранениеКэш = Новый(ПолноеИмяТипа);
		МодульХранениеКэш.УстановитьМодульИнтеграции(
			ИнтеграционныйМодульДокументооборот()
		);
		
	КонецЕсли;
	
	Возврат МодульХранениеКэш;
	
КонецФункции

Функция ЭДО_ВерсияAPIПодключаемогоМодуля() Экспорт
	
	Возврат 4; // Основной модуль проверяет указанную тут версию, в целях контроля совместимости с ПМ.
	
КонецФункции

