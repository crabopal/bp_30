// { Обработчики прямых вызовов ПМ

Функция ДопСвойствоПризнакНаОтправку()
	
	МодульХранение = Модуль_ХранениеДанныхДО();
	ИмяСвойстваОбъектаУчета = МодульХранение.НастройкаПризнакПоДокументу();
	
	ТочноеСоответствие = Истина;
	Результат = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(
		ИмяСвойстваОбъектаУчета,
		ТочноеСоответствие
	);
	
	Возврат Результат;
	
КонецФункции

Процедура ПрочитатьСоответствиеНоменклатурыБЭД(СоответствиеНоменклатуры, ВладелецНоменклатуры,
	ИдентификаторыНоменклатуры)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СопоставленнаяНоменклатура.Идентификатор КАК Идентификатор,
	|	СопоставленнаяНоменклатура.Номенклатура КАК Номенклатура,
	|	СопоставленнаяНоменклатура.Характеристика КАК Характеристика,
	|	СопоставленнаяНоменклатура.Упаковка КАК Упаковка
	|ИЗ
	|	РегистрСведений.НоменклатураКонтрагентовБЭД КАК СопоставленнаяНоменклатура
	|ГДЕ
	|	СопоставленнаяНоменклатура.Владелец = &Владелец
	|	И СопоставленнаяНоменклатура.Идентификатор В(&ИдентификаторыНоменклатуры)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Владелец", ВладелецНоменклатуры);
	Запрос.УстановитьПараметр("ИдентификаторыНоменклатуры", ИдентификаторыНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоменклатураИБ = НоваяНоменклатураИнформационнойБазы();
		ЗаполнитьЗначенияСвойств(НоменклатураИБ, Выборка);
		СоответствиеНоменклатуры.Вставить(Выборка.Идентификатор, НоменклатураИБ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИдентификаторНоменклатурыКонтрагента(НоменклатураКонтрагента)
	
	Если ЗначениеЗаполнено(НоменклатураКонтрагента.Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	ФрагментыПредставления = Новый Массив;
	ФрагментыПредставления.Добавить(НоменклатураКонтрагента.Наименование);
	ФрагментыПредставления.Добавить(НоменклатураКонтрагента.Характеристика);
	ФрагментыПредставления.Добавить(НоменклатураКонтрагента.Код);
	ФрагментыПредставления.Добавить(НоменклатураКонтрагента.Артикул);
	
	Представление = СтдСтр().СтрСоединитьЛок(ФрагментыПредставления, "#");
	
	Если Представление = "###" Тогда
		Представление = "";
	КонецЕсли;
	
	НоменклатураКонтрагента.Идентификатор = ИдентификаторПоСтроке(Представление);
	
КонецПроцедуры

// Генерирует уникальный строковый идентификатор с ограниченной длиной.
//  Входная строка приводится к верхнему регистру, из нее удаляются все пробелы.
//  Если длина нормализованной строки превышает заданное ограничение,
//  её "хвост" заменяется на хеш-строку, вычисленную по алгоритму MD5
//
// Параметры:
//  ВходнаяСтрока - Строка - произвольная строка
//  МаксимальнаяДлина - Число - максимальная длина формируемого идентификатора
// 
// Возвращаемое значение:
//  Строка - идентификатор входной строки
//
Функция ИдентификаторПоСтроке(Знач ВходнаяСтрока, Знач МаксимальнаяДлина = Неопределено)
	
	Если Не ЗначениеЗаполнено(МаксимальнаяДлина) Тогда 
		МаксимальнаяДлина = 110;
	КонецЕсли;
	
	Идентификатор = СокрЛП(ВходнаяСтрока);
	Идентификатор = ВРег(Идентификатор);
	Идентификатор = СтрЗаменить(Идентификатор, " ", "");
	
	Длина = СтрДлина(Идентификатор);
	
	Если Длина > МаксимальнаяДлина Тогда
		
		Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
		Хеширование.Добавить(Идентификатор);
		
		ХешСтрока = Строка(Хеширование.ХешСумма);
		ХешСтрока = СтрЗаменить(ХешСтрока, " ", "");
		
		ДлинаХешСтроки = СтрДлина(ХешСтрока);
		
		Идентификатор = Лев(Идентификатор, МаксимальнаяДлина - ДлинаХешСтроки) + ХешСтрока;
		
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

