
////////////////////////////////////////////////////////////////////////////////
// ОПИСАНИЕ ПЕРЕМЕННЫХ

// BSLLS:MissingVariablesDescription-off
// BSLLS:UnusedLocalVariable-off

// Служебные свойства
&НаКлиенте
Перем КлиентСтдЛок; // Библиотека СтдСтр

&НаСервере
Перем __МодульХранение; // Библиотека хранилище
// BSLLS:UnusedLocalVariable-on
// BSLLS:MissingVariablesDescription-on

&НаСервере
Функция Объект_()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат ЭтотОбъект;
	#Иначе
		Возврат РеквизитФормыВЗначение("Объект");
	#КонецЕсли
	
КонецФункции

&НаСервере
Функция Модуль_ИнтеграцияДОСлужебныйНаСервере()
	
	ПолноеИмяТипа = "DataProcessorObject.КонтурДиадокИнтеграцияДО";
	Если ЭтоВнешняяОбработка Тогда
		ПолноеИмяТипа = "ExternalDataProcessorObject.КонтурДиадокИнтеграцияДО";
	КонецЕсли;
	
	Результат = Новый(ПолноеИмяТипа);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция Модуль_ХранениеДанныхДО()
	
	Если __МодульХранение = Неопределено Тогда
		
		ПолноеИмяТипа = "DataProcessorObject.КонтурДиадокИнтеграцияХранениеДанныхДО";
		Если ЭтоВнешняяОбработка Тогда
			ПолноеИмяТипа = "ExternalDataProcessorObject.КонтурДиадокИнтеграцияХранениеДанныхДО";
		КонецЕсли;
		
		ИнтеграцияДО = Модуль_ИнтеграцияДОСлужебныйНаСервере();
		
		__МодульХранение = Новый(ПолноеИмяТипа);
		__МодульХранение.УстановитьМодульИнтеграции(
			ИнтеграцияДО.ИнтеграционныйМодульДокументооборот()
		);
		
	КонецЕсли;
	
	Возврат __МодульХранение;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// BSLLS:UnusedLocalVariable-off
	Объект_ = Объект_();
	ЭтоВнешняяОбработка = Объект_.ЭтоВнешняяОбработкаЛок();
	__МодульХранение = Модуль_ХранениеДанныхДО();
	// BSLLS:UnusedLocalVariable-on
	
	УстановитьПараметрыФормы();
	УстановитьТипЗначенияВидДокумента1С();
	УстановитьОписаниеДокументовНаОтправку();
	УстановитьОписаниеДокументовВходящих();
	УстановитьПризнакПодготовленногоДокумента();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыФормы()
	
	Параметры.Свойство("ВидыДокументов", ВидыДокументов);
	Параметры.Свойство("ТипыДокументов", ТипыДокументов);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипЗначенияВидДокумента1С()
	
	ЭлементУправленияИсходящие = Элементы.ВидДокумента1СИсходящие;
	ЭлементУправленияИсходящие.ОграничениеТипа = ОграничениеТипаВидыДокументовНаОтправкуПоУмолчанию();
	
	ЭлементУправленияВходящие = Элементы.ВидДокумента1СВходящие;
	ЭлементУправленияВходящие.ОграничениеТипа = ОграничениеТипаВидыДокументовВходящиеПоУмолчанию();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОписаниеДокументовНаОтправку()
	
	СписокВыбора = Элементы.ВидДокументаДиадокПредставление.СписокВыбора;
	СписокВыбора.Очистить();
	
	Для Каждого Элемент Из ВидыДокументов Цикл
		СписокВыбора.Добавить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	СопоставленныеДокументыНаОтправку.Очистить();
	
	МодульХранение = Модуль_ХранениеДанныхДО();
	РасширенныеНастройкиОтправки = МодульХранение.РасширенныеНастройкиОтправки(ВидыДокументов);
	Для Каждого Настройка Из РасширенныеНастройкиОтправки Цикл
		
		ВидДокументаДиадок = СписокВыбора.НайтиПоЗначению(Настройка.Значение);
		
		Если ВидДокументаДиадок <> Неопределено Тогда
			
			НоваяСтрока = СопоставленныеДокументыНаОтправку.Добавить();
			НоваяСтрока.ВидДокументаДиадокИдентификатор = ВидДокументаДиадок.Значение;
			НоваяСтрока.ВидДокументаДиадокПредставление = ВидДокументаДиадок.Представление;
			НоваяСтрока.ВидДокумента1СИсходящие = Настройка.Ключ;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОписаниеДокументовВходящих()
	
	СписокВыбора = Элементы.ВидЭлектронногоДокументаПредставление.СписокВыбора;
	СписокВыбора.Очистить();
	
	Для Каждого Элемент Из ТипыДокументов Цикл
		СписокВыбора.Добавить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	СопоставленныеДокументыВходящие.Очистить();
	
	МодульХранение = Модуль_ХранениеДанныхДО();
	РасширенныеНастройкиВходящих = МодульХранение.РасширенныеНастройкиВходящих(ТипыДокументов);
	Для Каждого Настройка Из РасширенныеНастройкиВходящих Цикл
		
		ТипЭлектронногоДокумента = СписокВыбора.НайтиПоЗначению(Настройка.Значение);
		
		Если ТипЭлектронногоДокумента <> Неопределено Тогда
			
			НоваяСтрока = СопоставленныеДокументыВходящие.Добавить();
			НоваяСтрока.ВидЭлектронногоДокументаИдентификатор = ТипЭлектронногоДокумента.Значение;
			НоваяСтрока.ВидЭлектронногоДокументаПредставление = ТипЭлектронногоДокумента.Представление;
			НоваяСтрока.ВидДокумента1СВходящие = Настройка.Ключ;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПризнакПодготовленногоДокумента()
	
	МодульХранение = Модуль_ХранениеДанныхДО();
	ПризнакПоДокументу = МодульХранение.НастройкаПризнакПоДокументу();
	
	// BSLLS:UnusedLocalVariable-off
	ТочноеСоответствие = Истина;
	ПризнакПодготовленногоДокумента = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(
		ПризнакПоДокументу,
		ТочноеСоответствие
	);
	// BSLLS:UnusedLocalVariable-on
	
КонецПроцедуры

// Вызывает открытие формы расширенных настроек
//
&НаКлиенте
Процедура НачатьОткрытие() Экспорт
	
	// BSLLS:UnusedLocalVariable-off
	РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	// BSLLS:UnusedLocalVariable-on
	
	ЭтаФорма.Модифицированность = Ложь;
	
	Открыть();
	
КонецПроцедуры

&НаСервере
Функция ОграничениеТипаВидыДокументовНаОтправкуПоУмолчанию()
	
	ТипыЗначения = СправочникДокументыНаОтправкуПоУмолчанию();
	Результат = Новый ОписаниеТипов(ТипыЗначения);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СправочникДокументыНаОтправкуПоУмолчанию()
	
	Интеграция = Объект_().КлиентИнформационнойБазы();
	Результат = Интеграция.СправочникДокументыНаОтправкуПоУмолчанию();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОграничениеТипаВидыДокументовВходящиеПоУмолчанию()
	
	ТипыЗначения = СправочникДокументыВходящиеПоУмолчанию();
	Результат = Новый ОписаниеТипов(ТипыЗначения);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СправочникДокументыВходящиеПоУмолчанию()
	
	Интеграция = Объект_().КлиентИнформационнойБазы();
	Результат = Интеграция.СправочникДокументыВходящиеПоУмолчанию();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура КолонкаВидДокументаДиадокОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные,
	ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеСписка = Элементы.ВидДокументаДиадокПредставление.СписокВыбора.НайтиПоЗначению(ВыбранноеЗначение);
	
	ТекущаяСтрока = Элементы.СопоставленныеДокументыНаОтправку.ТекущиеДанные;
	ТекущаяСтрока.ВидДокументаДиадокПредставление = ЗначениеСписка.Представление;
	ТекущаяСтрока.ВидДокументаДиадокИдентификатор = ЗначениеСписка.Значение;
	
	Модифицированность = Истина; // BSLLS:UnusedLocalVariable-off
	
КонецПроцедуры

&НаКлиенте
Процедура КолонкаВидЭлектронногоДокументаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные,
	ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеСписка = Элементы.ВидЭлектронногоДокументаПредставление.СписокВыбора.НайтиПоЗначению(ВыбранноеЗначение);
	
	ТекущаяСтрока = Элементы.СопоставленныеДокументыВходящие.ТекущиеДанные;
	ТекущаяСтрока.ВидЭлектронногоДокументаПредставление = ЗначениеСписка.Представление;
	ТекущаяСтрока.ВидЭлектронногоДокументаИдентификатор = ЗначениеСписка.Значение;
	
	Модифицированность = Истина; // BSLLS:UnusedLocalVariable-off
	
КонецПроцедуры

&НаКлиенте
Процедура ПризнакПодготовленногоДокументаОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПризнакПодготовленногоДокумента = Неопределено; // BSLLS:UnusedLocalVariable-off
	
КонецПроцедуры

&НаКлиенте
Процедура ПризнакПодготовленногоДокументаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуВыбораДопСвойства(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораДопСвойства(ВладелецФормы)
	
	ПолноеИмяФормы = "ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ФормаВыбора";
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ПометкаУдаления", Ложь);
	ПараметрыОтбора.Вставить("Виден", Истина);
	ПараметрыОтбора.Вставить("ТипЗначения", Тип("Булево"));
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтбора);
	
	ОткрытьФорму(ПолноеИмяФормы, ПараметрыФормы, ВладелецФормы, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьНастройки(Команда)
	
	ЭтаФорма.Модифицированность = Ложь;
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРасширенныеНастройкиВызовСервера()
	
	ЗаписатьНастройкиНаОтправку();
	ЗаписатьНастройкиВходящих();
	ЗаписатьНастройкиПризнакПоДокументу();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиНаОтправку()
	
	НастройкиОтправки = Новый Соответствие;
	Для Каждого Элемент Из СопоставленныеДокументыНаОтправку Цикл
		
		ЗначениеНастройкиЗаполнено = (
			Элемент.ВидДокументаДиадокИдентификатор <> Неопределено
			И Элемент.ВидДокументаДиадокПредставление <> Неопределено
			И Элемент.ВидДокумента1СИсходящие <> Неопределено
		);
		
		Если ЗначениеНастройкиЗаполнено Тогда
			НастройкиОтправки.Вставить(Элемент.ВидДокумента1СИсходящие, Элемент.ВидДокументаДиадокИдентификатор);
		КонецЕсли;
		
	КонецЦикла;
	
	МодульХранение = Модуль_ХранениеДанныхДО();
	МодульХранение.ЗаписатьНастройкиОтправки(НастройкиОтправки, ВидыДокументов);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиВходящих()
	
	НастройкиВходящих = Новый Соответствие;
	Для Каждого Элемент Из СопоставленныеДокументыВходящие Цикл
		
		ЗначениеНастройкиЗаполнено = (
			Элемент.ВидЭлектронногоДокументаИдентификатор <> Неопределено
			И Элемент.ВидЭлектронногоДокументаПредставление <> Неопределено
			И Элемент.ВидДокумента1СВходящие <> Неопределено
		);
		
		Если ЗначениеНастройкиЗаполнено Тогда
			НастройкиВходящих.Вставить(Элемент.ВидДокумента1СВходящие, Элемент.ВидЭлектронногоДокументаИдентификатор);
		КонецЕсли;
		
	КонецЦикла;
	
	МодульХранение = Модуль_ХранениеДанныхДО();
	МодульХранение.ЗаписатьНастройкиВходящих(НастройкиВходящих, ТипыДокументов);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиПризнакПоДокументу()
	
	МодульХранение = Модуль_ХранениеДанныхДО();
	МодульХранение.ЗаписатьНастройкиПризнакПоДокументу(ПризнакПодготовленногоДокумента.Наименование);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Этаформа.Модифицированность Тогда
		
		ОписаниеОповещенияЗакрытияЛок = НовыйОписаниеОповещения(
			"СохранитьРасширенныеНастройкиОтправки",
			ЭтаФорма,
			Новый Структура
		);
		
		СтдЛок().ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияЗакрытияЛок);
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик сохранения расширенных настроек
//
// Параметры:
//  Результат - Неопределено - Не используется
//  ДопПараметры - Неопределено - Не используется
//
&НаКлиенте
Процедура СохранитьРасширенныеНастройкиОтправки(Результат, ДопПараметры) Экспорт
	
	ЗаписатьРасширенныеНастройкиВызовСервера();
	
КонецПроцедуры

&НаКлиенте
Функция НовыйОписаниеОповещения(Знач ИмяПроцедуры,
	Знач Модуль = Неопределено,
	Знач ДополнительныеПараметры = Неопределено,
	Знач ИмяПроцедурыОбработкиОшибки = "",
	Знач МодульОбработкиОшибки = Неопределено) Экспорт // BSLLS:NumberOfOptionalParams-off
	
	Если Модуль = Неопределено Тогда
		Модуль = ЭтаФорма;
	КонецЕсли;
	
	Результат = СтдЛок().ОбщегоНазначения().ОписаниеОповещения(
		ИмяПроцедуры,
		Модуль,
		ДополнительныеПараметры,
		ИмяПроцедурыОбработкиОшибки,
		МодульОбработкиОшибки
	);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СтдЛок()
	
	Если КлиентСтдЛок = Неопределено Тогда	
		Если ЭтоВнешняяОбработка Тогда
			// BSLLS:GetFormMethod-off
			КлиентСтдЛок = ПолучитьФорму("ВнешняяОбработка.КонтурДиадокСтд.Форма.Клиент");
			// BSLLS:GetFormMethod-on
		Иначе
			// BSLLS:GetFormMethod-off
			КлиентСтдЛок = ПолучитьФорму("Обработка.КонтурДиадокСтд.Форма.Клиент");
			// BSLLS:GetFormMethod-on
		КонецЕсли;
	КонецЕсли;
	
	Возврат КлиентСтдЛок;
	
КонецФункции
