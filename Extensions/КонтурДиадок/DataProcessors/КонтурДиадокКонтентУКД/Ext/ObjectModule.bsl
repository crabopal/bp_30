Функция НовыйКонтракт()
	
	Результат = Новый Структура;
	Результат.Вставить("РеквизитыШапки", НовыйРеквизитыШапки());
	Результат.Вставить("Таблица", НовыйТаблица());
	Результат.Вставить("ТоварныеДокументыДоКорректировки", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

