Функция ЭтоВнешняяОбработка()

	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
	ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);

	Возврат ПараметрыПроверки.ИспользуемоеИмяФайла <> Неопределено;

КонецФункции

Функция СтдОбщегоНазначения()

	// BSLLS:Typo-off
	Если СтдОбщегоНазначенияЛок = Неопределено Тогда
		Если ЭтоВнешняяОбработка() Тогда
			СтдОбщегоНазначенияЛок = Новый("ExternalDataProcessorObject.КонтурДиадокСтдОбщегоНазначения");
		Иначе
			СтдОбщегоНазначенияЛок = Новый("DataProcessorObject.КонтурДиадокСтдОбщегоНазначения");
		КонецЕсли;
	КонецЕсли;

	Возврат СтдОбщегоНазначенияЛок;
	// BSLLS:Typo-on

КонецФункции

Функция СтдСтр()

	// BSLLS:Typo-off
	Если СтдСтрЛок = Неопределено Тогда
		Если ЭтоВнешняяОбработка() Тогда
			СтдСтрЛок = Новый("ExternalDataProcessorObject.КонтурДиадокСтдСтр");
		Иначе
			СтдСтрЛок = Новый("DataProcessorObject.КонтурДиадокСтдСтр");
		КонецЕсли;
	КонецЕсли;

	Возврат СтдСтрЛок;
	// BSLLS:Typo-on

КонецФункции
