	Результат = Новый Структура;
	Результат.Вставить("Банк", НовыйБанк());
	Результат.Вставить("НомерСчета", "");
	
	Возврат Результат;
	
КонецФункции

Функция НовыйБанк()
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", "");
	Результат.Вставить("БИК", "");
	Результат.Вставить("КорреспондентскийСчет", "");
	
	Возврат Результат;
	
КонецФункции

Функция НовыйКонтакты()
	
	Результат = Новый Структура;
	Результат.Вставить("Телефоны", Новый Массив);
	Результат.Вставить("ЭлектроннаяПочта", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

