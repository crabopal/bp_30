// ШАПКА

Процедура ЗаполнитьШапку(Контракт, Провайдер)
	
	ИсходныеДанные = Провайдер.РеквизитыШапкиУКД();
	
	КонтрактШапки = Контракт.РеквизитыШапки;
	
	ДатаДокумента = НачалоДня(ИсходныеДанные.Дата);
	
	КонтрактШапки.Ссылка = ИсходныеДанные.Ссылка;
	КонтрактШапки.Номер = ИсходныеДанные.Номер;
	КонтрактШапки.ПредставлениеНомера = ИсходныеДанные.ПредставлениеНомера;
	КонтрактШапки.Дата = ДатаДокумента;
	
	КонтрактШапки.Исправление.Номер = Строка(ИсходныеДанные.НомерИсправления);
	КонтрактШапки.Исправление.Дата = НачалоДня(ИсходныеДанные.ДатаИсправления);
	
	ЗаполнитьОснованиеШапкиУКД(КонтрактШапки, ИсходныеДанные, Провайдер);
	
	КонтрактШапки.КодВидаОперации = ИсходныеДанные.КодВидаОперации;
	КонтрактШапки.ВидОперации = ИсходныеДанные.ВидОперации;
	КонтрактШапки.Налогообложение = ИсходныеДанные.Налогообложение;
	
	ДопСведения = КонтрактШапки.ДополнительныеСведения;
	ДопСведения.ИдентификаторГосконтракта = ИсходныеДанные.ИдентификаторГосКонтракта;
	ДопСведения.ЭтоВозвратТоваровОтКлиента = ИсходныеДанные.ЭтоВозвратТоваровОтКлиента;
	ДопСведения.ВариантВыбытияМаркированнойПродукции = ИсходныеДанные.ВариантВыбытияМаркированнойПродукции;
	ДопСведения.СопроводительныеДокументы = ИсходныеДанные.СопроводительныеДокументы;
	
	КонтрактШапки.СопроводительныеДокументы = ИсходныеДанные.СопроводительныеДокументы;
	
	Если ЗначениеЗаполнено(ИсходныеДанные.ВалютаДокумента) Тогда
		РеквизитыВалюты = Провайдер.РеквизитыВалюты(ИсходныеДанные.ВалютаДокумента);
		КонтрактШапки.Валюта.Код = РеквизитыВалюты.Код;
		КонтрактШапки.Валюта.Наименование = РеквизитыВалюты.Наименование;
		КонтрактШапки.Валюта.Курс = 1;
	КонецЕсли;
	
	ДатаРеквизитовУчастников = ДатаДокумента;
	Если ЗначениеЗаполнено(КонтрактШапки.Исправление.Дата) Тогда
		ДатаРеквизитовУчастников = КонтрактШапки.Исправление.Дата;
	КонецЕсли;
	
	РеквизитыПродавца = Провайдер.ДанныеЮрФизЛица(ИсходныеДанные.Продавец, ДатаРеквизитовУчастников);
	БанковскийСчетПродавца = Провайдер.БанковскиеРеквизиты(ИсходныеДанные.БанковскийСчетПродавца);
	АдресПродавца = Провайдер.ЮридическийАдресЮрФизЛица(ИсходныеДанные.Продавец, ДатаРеквизитовУчастников);
	ЗаполнитьУчастника(КонтрактШапки.Продавец, РеквизитыПродавца, АдресПродавца, БанковскийСчетПродавца);
	
	РеквизитыПокупателя = Провайдер.ДанныеЮрФизЛица(ИсходныеДанные.Покупатель, ДатаРеквизитовУчастников);
	БанковскийСчетПокупателя = Провайдер.БанковскиеРеквизиты(ИсходныеДанные.БанковскийСчетПокупателя);
	АдресПокупателя = Провайдер.ЮридическийАдресЮрФизЛица(ИсходныеДанные.Покупатель, ДатаРеквизитовУчастников);
	ЗаполнитьУчастника(КонтрактШапки.Покупатель, РеквизитыПокупателя, АдресПокупателя, БанковскийСчетПокупателя);
	
	ЗаполнитьКППУчастникаИзШапки(КонтрактШапки.Продавец, ИсходныеДанные.КПППродавца);
	ЗаполнитьКППУчастникаИзШапки(КонтрактШапки.Покупатель, ИсходныеДанные.КПППокупателя);
	
	ЗаполнитьПервичныеДокументы(КонтрактШапки.ПервичныеДокументы, ИсходныеДанные.ПервичныеДокументы);
	ЗаполнитьДокументыОснования(КонтрактШапки.ДокументыОснования, ИсходныеДанные.ДокументыОснования);
	ЗаполнитьСоставителяШапкиУКД(КонтрактШапки, ИсходныеДанные, Провайдер, ДатаРеквизитовУчастников);
	
КонецПроцедуры

Процедура ЗаполнитьПервичныеДокументы(Приемник, Источник)
	
	Для Каждого ПервичныйДокументПровайдера Из Источник Цикл
		
		ПервичныйДокумент = НовыйПервичныйДокумент();
		ПервичныйДокумент.Номер = ПервичныйДокументПровайдера.Номер;
		ПервичныйДокумент.Дата = НачалоДня(ПервичныйДокументПровайдера.Дата);
		ПервичныйДокумент.Ссылка = ПервичныйДокументПровайдера.Ссылка;
		Приемник.Добавить(ПервичныйДокумент);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокументыОснования(Приемник, Источник)
	
	Для Каждого ДокументОснованияПровайдера Из Источник Цикл
		
		ДокументОснования = НовыйДокументОснования();
		ДокументОснования.Номер = ДокументОснованияПровайдера.Номер;
		ДокументОснования.Дата = НачалоДня(ДокументОснованияПровайдера.Дата);
		ДокументОснования.НомерИсправления = ДокументОснованияПровайдера.НомерИсправления;
		ДокументОснования.ДатаИсправления = НачалоДня(ДокументОснованияПровайдера.ДатаИсправления);
		Приемник.Добавить(ДокументОснования);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСоставителяШапкиУКД(КонтрактШапки, ИсходныеДанные, Провайдер, ДатаДокумента)
	
	Если Не ЗначениеЗаполнено(ИсходныеДанные.Составитель) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыСоставителя = Провайдер.ДанныеЮрФизЛица(
		ИсходныеДанные.Составитель,
		ДатаДокумента);
		
	Представление = ПредставлениеСоставителя(РеквизитыСоставителя);
	Если ЗначениеЗаполнено(Представление)
		И ОснованиеУКДЗаполнено(КонтрактШапки.Основание) Тогда
		
		ЭлементОснования = КонтрактШапки.Основание[0];
		КонтрактШапки.ОснованиеПолномочийСоставителя.Наименование = ЭлементОснования.Наименование;
		КонтрактШапки.ОснованиеПолномочийСоставителя.Номер = ЭлементОснования.Номер;
		КонтрактШапки.ОснованиеПолномочийСоставителя.Дата = ЭлементОснования.Дата;

		КонтрактШапки.Составитель = Представление;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОснованиеУКДЗаполнено(Основание)
	
	Результат = Ложь;

	Если Основание.Количество() > 0 Тогда
		ЭлементОснования = Основание[0];
		Результат = (ЗначениеЗаполнено(ЭлементОснования.Наименование)
			И ЗначениеЗаполнено(ЭлементОснования.Номер)
			И ЗначениеЗаполнено(ЭлементОснования.Дата));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьОснованиеПолномочийСоставителя(КонтрактШапки)
	
	Результат = Ложь;
	Основание = КонтрактШапки.Основание;
	Если Основание.Количество() > 0 Тогда
		ЭлементОснования = Основание[0];
		Если ЗначениеЗаполнено(ЭлементОснования.Наименование)
			И ЗначениеЗаполнено(ЭлементОснования.Номер)
			И ЗначениеЗаполнено(ЭлементОснования.Дата) Тогда
			КонтрактШапки.ОснованиеПолномочийСоставителя.Наименование = ЭлементОснования.Наименование;
			КонтрактШапки.ОснованиеПолномочийСоставителя.Номер = ЭлементОснования.Номер;
			КонтрактШапки.ОснованиеПолномочийСоставителя.Дата = ЭлементОснования.Дата;
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеСоставителя(РеквизитыУчастника)
	
	Результат = "";
	Если РеквизитыУчастника <> Неопределено Тогда
		
		РеквизитыПредставления = ИмяИННКППСоставителя(РеквизитыУчастника);
		Наименование = РеквизитыПредставления.Наименование;
		ИНН = РеквизитыПредставления.ИНН;
		КПП = РеквизитыПредставления.КПП;
		
		Если ЗначениеЗаполнено(Наименование) Или ЗначениеЗаполнено(ИНН) Тогда
			Если ЗначениеЗаполнено(КПП) Тогда
				Результат = СтдСтр().СтрШаблонЛок("%1, ИНН/КПП %2/%3", Наименование, ИНН, КПП);
			Иначе
				Результат = СтдСтр().СтрШаблонЛок("%1, ИНН %2", Наименование, ИНН);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяИННКППСоставителя(РеквизитыУчастника)
	
	Результат = Новый Структура("Наименование, ИНН, КПП", "", "", "");
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если РеквизитыУчастника.ЮрЛицо <> Неопределено Тогда
		Результат.Наименование = СокрЛП(РеквизитыУчастника.ЮрЛицо.Наименование);
		Если ЗначениеЗаполнено(РеквизитыУчастника.ЮрЛицо.НаименованиеПолное) Тогда
			Результат.Наименование = СокрЛП(РеквизитыУчастника.ЮрЛицо.НаименованиеПолное);
		КонецЕсли;
		Результат.ИНН = СокрЛП(РеквизитыУчастника.ЮрЛицо.ИНН);
		Результат.КПП = СокрЛП(РеквизитыУчастника.ЮрЛицо.КПП);
	ИначеЕсли РеквизитыУчастника.ИП <> Неопределено Тогда
		Результат.Наименование = ПредставлениеФИО(РеквизитыУчастника.ИП.ФИО);
		Результат.ИНН = СокрЛП(РеквизитыУчастника.ИП.ИНН);
	ИначеЕсли РеквизитыУчастника.ФизЛицо <> Неопределено Тогда
		Результат.Наименование = ПредставлениеФИО(РеквизитыУчастника.ФизЛицо.ФИО);
		Результат.ИНН = СокрЛП(РеквизитыУчастника.ФизЛицо.ИНН);
	ИначеЕсли РеквизитыУчастника.ИностранноеЮрЛицо <> Неопределено Тогда
		Результат.Наименование = СокрЛП(РеквизитыУчастника.ИностранноеЮрЛицо.Наименование);
	ИначеЕсли РеквизитыУчастника.ИностранноеФизЛицо <> Неопределено Тогда
		Результат.Наименование = СокрЛП(РеквизитыУчастника.ИностранноеФизЛицо.Наименование);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеФИО(ФИО)
	
	Части = Новый Массив;
	Если ЗначениеЗаполнено(ФИО.Фамилия) Тогда
		Части.Добавить(СокрЛП(ФИО.Фамилия));
	КонецЕсли;
	Если ЗначениеЗаполнено(ФИО.Имя) Тогда
		Части.Добавить(СокрЛП(ФИО.Имя));
	КонецЕсли;
	Если ЗначениеЗаполнено(ФИО.Отчество) Тогда
		Части.Добавить(СокрЛП(ФИО.Отчество));
	КонецЕсли;
	
	Возврат СтдСтр().СтрСоединитьЛок(Части, " ");
	
КонецФункции

Процедура ЗаполнитьКППУчастникаИзШапки(Участник, КПП)
	
	Если Не ЗначениеЗаполнено(КПП) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не УчастникЗаполненКакЮрЛицо(Участник) Тогда
		Возврат;
	КонецЕсли;
	
	ЮрЛицо = Участник.ОсновныеСведения.ЮридическоеЛицо;
	ЮрЛицо.КПП = КПП;
	
КонецПроцедуры

Функция УчастникЗаполненКакЮрЛицо(Участник)
	
	ЮрЛицо = Участник.ОсновныеСведения.ЮридическоеЛицо;
	Возврат ЗначениеЗаполнено(ЮрЛицо.ИНН) Или ЗначениеЗаполнено(ЮрЛицо.Наименование);
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ТАБЛИЦА

Процедура ЗаполнитьТаблицу(Контракт, Провайдер)
	
	СтрокиПровайдера = Провайдер.СтрокиТабличнойЧастиУКД();
	
	Для Каждого СтрокаПровайдера Из СтрокиПровайдера Цикл
		
		СтрокаКонтракта = НовыйСтрока();
		
		СтрокаКонтракта.НомерСтроки = СтрокаПровайдера.НомерСтрокиДокумента;
		СтрокаКонтракта.НомерИсходнойСтроки = СтрокаПровайдера.НомерИсходнойСтроки;
		СтрокаКонтракта.ИдентификаторСтроки = СтрокаПровайдера.ИдентификаторСтроки;
		
		СтрокаКонтракта.Номенклатура = СтрокаПровайдера.НоменклатураПредставление;
		СтрокаКонтракта.НоменклатураКод = СтрокаПровайдера.НоменклатураКод;
		СтрокаКонтракта.НоменклатураТип = СтрокаПровайдера.ТипНоменклатуры;
		СтрокаКонтракта.Характеристика = СтрокаПровайдера.ХарактеристикаНаименование;
		СтрокаКонтракта.Серия = СтрокаПровайдера.СерияПредставление;
		
		СтрокаКонтракта.КодТНВЭД = СтрокаПровайдера.КодТНВЭД;
		
		СтрокаКонтракта.ЕдиницаИзмерения = СтрокаПровайдера.ЕдиницаИзмеренияНаименование;
		СтрокаКонтракта.ЕдиницаИзмеренияКод = СтрокаПровайдера.ЕдиницаИзмеренияКод;
		
		СтрокаКонтракта.КоличествоДо = СтрокаПровайдера.КоличествоДо;
		СтрокаКонтракта.Количество = СтрокаПровайдера.Количество;
		СтрокаКонтракта.ЦенаДо = ОкруглитьРасчетнуюЦену(СтрокаПровайдера.ЦенаДо);
		СтрокаКонтракта.Цена = ОкруглитьРасчетнуюЦену(СтрокаПровайдера.Цена);
		
		СтрокаКонтракта.СтавкаНДС = Провайдер.ПредставлениеСтавкиНДС(СтрокаПровайдера.СтавкаНДС);
		
		СтрокаКонтракта.СуммаБезНДСДо = СтрокаПровайдера.СуммаБезНДСДо;
		СтрокаКонтракта.СуммаБезНДС = СтрокаПровайдера.СуммаБезНДС;
		СтрокаКонтракта.СуммаНДСДо = СтрокаПровайдера.СуммаНДСДо;
		СтрокаКонтракта.СуммаНДС = СтрокаПровайдера.СуммаНДС;
		СтрокаКонтракта.СуммаСНДСДо = СтрокаПровайдера.СуммаСНДСДо;
		СтрокаКонтракта.СуммаСНДС = СтрокаПровайдера.СуммаСНДС;
		СтрокаКонтракта.АкцизДо = СтрокаПровайдера.АкцизДо;
		СтрокаКонтракта.Акциз = СтрокаПровайдера.Акциз;

		СтрокаКонтракта.РазницаБезНДСУвеличение = СтрокаПровайдера.РазницаБезНДСУвеличение;
		СтрокаКонтракта.РазницаБезНДСУменьшение = СтрокаПровайдера.РазницаБезНДСУменьшение;
		СтрокаКонтракта.РазницаНДСУвеличение = СтрокаПровайдера.РазницаНДСУвеличение;
		СтрокаКонтракта.РазницаНДСУменьшение = СтрокаПровайдера.РазницаНДСУменьшение;
		СтрокаКонтракта.РазницаСНДСУвеличение = СтрокаПровайдера.РазницаСНДСУвеличение;
		СтрокаКонтракта.РазницаСНДСУменьшение = СтрокаПровайдера.РазницаСНДСУменьшение;
		СтрокаКонтракта.РазницаАкцизУвеличение = СтрокаПровайдера.РазницаАкцизУвеличение;
		СтрокаКонтракта.РазницаАкцизУменьшение = СтрокаПровайдера.РазницаАкцизУменьшение;
		
		ЗаполнитьСведенияДекларацииСтроки(СтрокаКонтракта.СведенияДТ, СтрокаПровайдера.СведенияДТ);
		
		ЗаполнитьПрослеживаемостьСтроки(
			СтрокаКонтракта.СведенияПрослеживаемости,
			СтрокаПровайдера.СведенияПрослеживаемости);
			
		ЗаполнитьДополнительныеСведения(СтрокаКонтракта.ДополнительныеСведения, СтрокаПровайдера);
		
		Контракт.Таблица.Строки.Добавить(СтрокаКонтракта);
		
	КонецЦикла;
	
	ЗаполнитьИтогиТаблицы(Контракт.Таблица);
	
КонецПроцедуры

Функция ОкруглитьРасчетнуюЦену(Цена)
	
	РазрядностьЦены = 2;
	
	Если ТипЗнч(Цена) = Тип("Число") Тогда
		Результат = Окр(Цена, РазрядностьЦены);
	Иначе
		Результат = Цена;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ

Процедура ЗаполнитьСведенияДекларацииСтроки(Приемник, Источник)
	
	Для Каждого СведениеДТ Из Источник Цикл
		
		Контракт = НовыйСведениеДТ();
		
		Контракт.НомерГТДДо = СведениеДТ.НомерГТДДо;
		Контракт.НомерГТД = СведениеДТ.НомерГТД;
		Контракт.Страна = СведениеДТ.СтранаНаименование;
		Контракт.СтранаКод = СведениеДТ.СтранаКод;
		
		Приемник.Добавить(Контракт);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПрослеживаемостьСтроки(Приемник, Источник)
	
	Для Каждого СведениеПровайдера Из Источник Цикл
		
		Контракт = НовыйСведениеПрослеживаемости();
		
		Контракт.ИдентификаторСтроки = СведениеПровайдера.ИдентификаторСтроки;
		Контракт.НомерРНПТ = СокрЛП(СведениеПровайдера.НомерРНПТ);
		Контракт.Страна = СведениеПровайдера.СтранаНаименование;
		Контракт.СтранаКод = СведениеПровайдера.СтранаКод;
		Контракт.КоличествоДо = СведениеПровайдера.КоличествоДо;
		Контракт.Количество = СведениеПровайдера.Количество;
		Контракт.КоличествоУвеличение = СведениеПровайдера.КоличествоУвеличение;
		Контракт.КоличествоУменьшение = СведениеПровайдера.КоличествоУменьшение;
		Контракт.СтоимостьБезНДСДо = СведениеПровайдера.СтоимостьБезНДСДо;
		Контракт.СтоимостьБезНДС = СведениеПровайдера.СтоимостьБезНДС;
		Контракт.СтоимостьБезНДСУвеличение = СведениеПровайдера.СтоимостьБезНДСУвеличение;
		Контракт.СтоимостьБезНДСУменьшение = СведениеПровайдера.СтоимостьБезНДСУменьшение;
		Контракт.ЕдиницаИзмерения = СведениеПровайдера.ЕдиницаИзмеренияНаименование;
		Контракт.ЕдиницаИзмеренияКод = СведениеПровайдера.ЕдиницаИзмеренияКод;
		
		Приемник.Добавить(Контракт);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИтогиТаблицы(ТаблицаКонтракта)
	
	Для Каждого СтрокаКонтракта Из ТаблицаКонтракта.Строки Цикл
		
		ИтогУвеличение = ТаблицаКонтракта.ИтогУвеличение;
		ИтогУвеличение.СуммаБезНДС = ИтогУвеличение.СуммаБезНДС + СтрокаКонтракта.РазницаБезНДСУвеличение;
		ИтогУвеличение.СуммаСНДС = ИтогУвеличение.СуммаСНДС + СтрокаКонтракта.РазницаСНДСУвеличение;
		ИтогУвеличение.СуммаНДС = ИтогУвеличение.СуммаНДС + СтрокаКонтракта.РазницаНДСУвеличение;
		
		ИтогУменьшение = ТаблицаКонтракта.ИтогУменьшение;
		ИтогУменьшение.СуммаБезНДС = ИтогУменьшение.СуммаБезНДС + СтрокаКонтракта.РазницаБезНДСУменьшение;
		ИтогУменьшение.СуммаСНДС = ИтогУменьшение.СуммаСНДС + СтрокаКонтракта.РазницаСНДСУменьшение;
		ИтогУменьшение.СуммаНДС = ИтогУменьшение.СуммаНДС + СтрокаКонтракта.РазницаНДСУменьшение;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДополнительныеСведения(ДопСведения, СтрокаПровайдера)

	ДопСведения.ПрослеживаемыйТовар = СтрокаПровайдера.ПрослеживаемыйТовар;
	ДопСведения.ТоварныйДокумент = СтрокаПровайдера.ТоварныйДокумент;
	ДопСведения.Номенклатура = СтрокаПровайдера.Номенклатура;
	ДопСведения.Характеристика = СтрокаПровайдера.Характеристика;
	ДопСведения.Серия = СтрокаПровайдера.Серия;
	ДопСведения.Упаковка = СтрокаПровайдера.Упаковка;
	ДопСведения.ЕдиницаИзмерения = СтрокаПровайдера.ЕдиницаИзмерения;
	ДопСведения.СтавкаНДС = СтрокаПровайдера.СтавкаНДС;
	ДопСведения.НомерГТД = СтрокаПровайдера.НомерГТД;
	ДопСведения.СтранаПроисхождения = СтрокаПровайдера.СтранаПроисхождения;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ТОВАРНЫЕ ДОКУМЕНТЫ ДО КОРРЕКТИРОВКИ

Процедура ЗаполнитьТоварныеДокументыДоКорректировки(Контракт, Провайдер)

	Контракт.ТоварныеДокументыДоКорректировки = СтдОбщегоНазначения().СкопироватьРекурсивноЛок(
		Провайдер.ТоварныеДокументыДоКорректировкиУКД());

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// УНИВЕРСАЛЬНЫЕ МАППЕРЫ

Процедура ЗаполнитьОснованиеШапкиУКД(КонтрактШапки, ИсходныеДанныеШапки, Провайдер)
	
	ЭлементОснования = ЭлементОснованияШапкиУКД(ИсходныеДанныеШапки, Провайдер);
	Если ЭлементОснования = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтрактШапки.Основание.Добавить(ЭлементОснования);
	
КонецПроцедуры

Функция ЭлементОснованияШапкиУКД(ИсходныеДанныеШапки, Провайдер)

	Результат = Неопределено;

	ЭлементОснования = НовыйРеквизитыСвязанногоДокумента();
	ЭлементОснования.Наименование = СокрЛП(ИсходныеДанныеШапки.Основание);
	ЭлементОснования.Номер = СокрЛП(ИсходныеДанныеШапки.ОснованиеНомер);

	Если ЗначениеЗаполнено(ИсходныеДанныеШапки.ОснованиеДата) Тогда
		ЭлементОснования.Дата = НачалоДня(ИсходныеДанныеШапки.ОснованиеДата);
	КонецЕсли;

	УдалитьДатуНомерИзНаименованияОснования(ЭлементОснования);

	Если ЗначениеЗаполнено(ЭлементОснования.Наименование)
		И ЗначениеЗаполнено(ЭлементОснования.Номер)
		И ЗначениеЗаполнено(ЭлементОснования.Дата) Тогда

		Результат = ЭлементОснования;

	ИначеЕсли Провайдер.ИспользуютсяДоговорыКонтрагентов(ИсходныеДанныеШапки.Соглашение) Тогда

		Если ЗначениеЗаполнено(ИсходныеДанныеШапки.Договор) Тогда
			РеквизитыДоговора = Провайдер.РеквизитыДоговора(ИсходныеДанныеШапки.Договор);
			Результат = ЭлементОснованияИзРеквизитовСвязанногоДокумента(РеквизитыДоговора, "Договор");
		КонецЕсли;

	Иначе

		РеквизитыСоглашения = Провайдер.РеквизитыСоглашения(ИсходныеДанныеШапки.Соглашение);
		Результат = ЭлементОснованияИзРеквизитовСвязанногоДокумента(РеквизитыСоглашения, "Соглашение");

КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЭлементОснованияИзРеквизитовСвязанногоДокумента(РеквизитыСвязанногоДокумента, НаименованиеПоУмолчанию)

	ЭлементОснования = НовыйРеквизитыСвязанногоДокумента();
	ЭлементОснования.Наименование = СокрЛП(РеквизитыСвязанногоДокумента.Наименование);
	ЭлементОснования.Номер = СокрЛП(РеквизитыСвязанногоДокумента.Номер);

	Если ЗначениеЗаполнено(РеквизитыСвязанногоДокумента.Дата) Тогда
		ЭлементОснования.Дата = НачалоДня(РеквизитыСвязанногоДокумента.Дата);
	КонецЕсли;

	УдалитьДатуНомерИзНаименованияОснования(ЭлементОснования);

	Если Не ЗначениеЗаполнено(ЭлементОснования.Наименование) Тогда
		ЭлементОснования.Наименование = НаименованиеПоУмолчанию;
	КонецЕсли;
	
	Возврат ЭлементОснования;
	
КонецФункции

Процедура УдалитьДатуНомерИзНаименованияОснования(ЭлементОснования)

	ПозНомера = СтдСтр().СтрНайтиЛок(ЭлементОснования.Наименование, "№");
	Если ПозНомера > 0 Тогда
		ЭлементОснования.Наименование = СокрЛП(Лев(ЭлементОснования.Наименование, ПозНомера - 1));
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// УЧАСТНИКИ

Процедура ЗаполнитьУчастника(
	Контракт,
	РеквизитыУчастника,
	АдресЮрФизЛица,
	РеквизитыБанковскогоСчета = Неопределено)
	
	Если Не ЗначениеЗаполнено(РеквизитыУчастника) Тогда
		Возврат;
	КонецЕсли;
	
	Контракт = НовыйУчастник();
	Контракт.Ссылка = РеквизитыУчастника.Ссылка;
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если РеквизитыУчастника.ЮрЛицо <> Неопределено Тогда
		ЗаполнитьОсновныеСведенияУчастникаЮрЛицо(Контракт, РеквизитыУчастника);
	ИначеЕсли РеквизитыУчастника.ИП <> Неопределено Тогда
		ЗаполнитьОсновныеСведенияУчастникаИП(Контракт, РеквизитыУчастника);
	ИначеЕсли РеквизитыУчастника.ФизЛицо <> Неопределено Тогда
		ЗаполнитьОсновныеСведенияУчастникаФизЛицо(Контракт, РеквизитыУчастника);
	ИначеЕсли РеквизитыУчастника.ИностранноеЮрЛицо <> Неопределено Тогда
		ЗаполнитьОсновныеСведенияУчастникаИностранноеЮрЛицо(Контракт, РеквизитыУчастника);
	ИначеЕсли РеквизитыУчастника.ИностранноеФизЛицо <> Неопределено Тогда
		ЗаполнитьОсновныеСведенияУчастникаИностранноеФизЛицо(Контракт, РеквизитыУчастника);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
	Для Каждого Телефон Из РеквизитыУчастника.Контакты.Телефоны Цикл
		Контракт.Контакты.Телефоны.Добавить(Телефон);
	КонецЦикла;
	Для Каждого ЭлПочта Из РеквизитыУчастника.Контакты.ЭлектроннаяПочта Цикл
		Контракт.Контакты.ЭлектроннаяПочта.Добавить(ЭлПочта);
	КонецЦикла;
	
	Если РеквизитыБанковскогоСчета <> Неопределено Тогда
		Контракт.БанковскиеРеквизиты = НовыйБанковскиеРеквизиты();
		Контракт.БанковскиеРеквизиты.НомерСчета = РеквизитыБанковскогоСчета.НомерСчета;
		Контракт.БанковскиеРеквизиты.Банк.Наименование = РеквизитыБанковскогоСчета.Банк;
		Контракт.БанковскиеРеквизиты.Банк.БИК = РеквизитыБанковскогоСчета.БИК;
		Контракт.БанковскиеРеквизиты.Банк.КорреспондентскийСчет = РеквизитыБанковскогоСчета.КоррСчет;
	КонецЕсли;
	
	Если АдресЮрФизЛица <> Неопределено Тогда
		Контракт.Адрес = НовыйАдрес();
		ЗаполнитьАдресУчастника(Контракт.Адрес, АдресЮрФизЛица);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОсновныеСведенияУчастникаЮрЛицо(УчастникКонтракта, РеквизитыУчастника)
	
	ЮрЛицо = НовыйЮрЛицо();
	ЮрЛицо.Наименование = РеквизитыУчастника.ЮрЛицо.Наименование;
	ЮрЛицо.ИНН = РеквизитыУчастника.ЮрЛицо.ИНН;
	ЮрЛицо.КПП = РеквизитыУчастника.ЮрЛицо.КПП;
	ЮрЛицо.ОКПО = РеквизитыУчастника.ЮрЛицо.КодПоОКПО;
	
	УчастникКонтракта.ОсновныеСведения.ЮридическоеЛицо = ЮрЛицо;
	
КонецПроцедуры

Процедура ЗаполнитьОсновныеСведенияУчастникаИП(УчастникКонтракта, РеквизитыУчастника)
	
	ИП = НовыйИП();
	ИП.ИНН = РеквизитыУчастника.ИП.ИНН;
	ИП.ОГРН = РеквизитыУчастника.ИП.ОГРН;
	ИП.ДатаОГРН = РеквизитыУчастника.ИП.ДатаРегистрации;
	ИП.СведенияГосРегистрации = РеквизитыУчастника.ИП.Свидетельство;
	
	ЗаполнитьФИОИзПровайдера(ИП.ФИО, РеквизитыУчастника.ИП.ФИО);
	
	УчастникКонтракта.ОсновныеСведения.ИП = ИП;
	
КонецПроцедуры

Процедура ЗаполнитьОсновныеСведенияУчастникаФизЛицо(УчастникКонтракта, РеквизитыУчастника)
	
	ФизЛицо = НовыйФизЛицо();
	ФизЛицо.ИНН = РеквизитыУчастника.ФизЛицо.ИНН;

	ЗаполнитьФИОИзПровайдера(ФизЛицо.ФИО, РеквизитыУчастника.ФизЛицо.ФИО);

	УчастникКонтракта.ОсновныеСведения.ФизическоеЛицо = ФизЛицо;
	
КонецПроцедуры

Процедура ЗаполнитьОсновныеСведенияУчастникаИностранноеЮрЛицо(УчастникКонтракта, РеквизитыУчастника)
	
	ДанныеИностранногоЛица = РеквизитыУчастника.ИностранноеЮрЛицо;
	
	ИностранноеЮрЛицо = НовыйИностранноеЮрЛицо();
	ИностранноеЮрЛицо.Наименование = ДанныеИностранногоЛица.Наименование;
	ИностранноеЮрЛицо.Идентификатор = ДанныеИностранногоЛица.НалоговыйНомер;
	ИностранноеЮрЛицо.ИныеСведения = ДанныеИностранногоЛица.ИныеСведения;
	
	ЗаполнитьСтрануИностранногоЛица(ИностранноеЮрЛицо, ДанныеИностранногоЛица.Страна);
	
	УчастникКонтракта.ОсновныеСведения.ИностранноеЮрЛицо = ИностранноеЮрЛицо;
	
КонецПроцедуры

Процедура ЗаполнитьОсновныеСведенияУчастникаИностранноеФизЛицо(УчастникКонтракта, РеквизитыУчастника)
	
	ДанныеИностранногоЛица = РеквизитыУчастника.ИностранноеФизЛицо;
	
	ИностранноеФизЛицо = НовыйИностранноеФизЛицо();
	ИностранноеФизЛицо.Наименование = ДанныеИностранногоЛица.Наименование;
	ИностранноеФизЛицо.Идентификатор = ДанныеИностранногоЛица.НалоговыйНомер;
	
	ЗаполнитьСтрануИностранногоЛица(ИностранноеФизЛицо, ДанныеИностранногоЛица.Страна);
	
	УчастникКонтракта.ОсновныеСведения.ИностранноеФизЛицо = ИностранноеФизЛицо;
	
КонецПроцедуры

Процедура ЗаполнитьСтрануИностранногоЛица(ИностранноеЛицо, СтранаПровайдера)
	
	Если СтранаПровайдера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИностранноеЛицо.КодСтраны = СтранаПровайдера.Код;
	ИностранноеЛицо.НаименованиеСтраны = СтранаПровайдера.Наименование;
	
КонецПроцедуры

Процедура ЗаполнитьАдресУчастника(АдресУчастника, АдресЮрФизЛица)
	
	Если АдресЮрФизЛица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АдресУчастника.ГЛНМеста = АдресЮрФизЛица.ГЛНМеста;
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если АдресЮрФизЛица.ТипАдреса = "Административный" Тогда
		ЗаполнитьАдресРФИзАдминистративного(АдресУчастника.АдресРФ, АдресЮрФизЛица.Административный);
	ИначеЕсли АдресЮрФизЛица.ТипАдреса = "Муниципальный" Тогда
		ЗаполнитьАдресГАРИзМуниципального(АдресУчастника.АдресГАР, АдресЮрФизЛица.Муниципальный);
	ИначеЕсли АдресЮрФизЛица.ТипАдреса = "ВСвободнойФорме" Тогда
		ЗаполнитьАдресВСвободнойФормеИзПровайдера(АдресУчастника.АдресВСвободнойФорме, АдресЮрФизЛица.ВСвободнойФорме);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Процедура ЗаполнитьАдресРФИзАдминистративного(АдресРФ, Административный)
	
	АдресРФ = НовыйАдресРФ();
	АдресРФ.Индекс = Административный.Индекс;
	АдресРФ.КодРегион = Административный.КодРегиона;
	АдресРФ.НаименованиеРегиона = Административный.НаименованиеРегиона;
	АдресРФ.Район = Административный.Район;
	АдресРФ.РайонСокращение = Административный.РайонСокращение;
	АдресРФ.Город = Административный.Город;
	АдресРФ.ГородСокращение = Административный.ГородСокращение;
	АдресРФ.НаселенныйПункт = Административный.НаселенныйПункт;
	АдресРФ.НаселенныйПунктСокращение = Административный.НаселенныйПунктСокращение;
	АдресРФ.Улица = Административный.Улица;
	АдресРФ.УлицаСокращение = Административный.УлицаСокращение;
	АдресРФ.Дом = Административный.Дом;
	АдресРФ.Корпус = Административный.Корпус;
	АдресРФ.Квартира = Административный.Квартира;
	АдресРФ.ИныеСведения = Административный.ИныеСведения;
	
КонецПроцедуры

Процедура ЗаполнитьАдресГАРИзМуниципального(АдресГАР, Муниципальный)
	
	АдресГАР = НовыйАдресГАР();
	АдресГАР.ИдентификаторАдресногоОбъекта = Муниципальный.ИдентификаторГАР;
	АдресГАР.Индекс = Муниципальный.Индекс;
	АдресГАР.КодРегиона = Муниципальный.КодРегиона;
	АдресГАР.НаименованиеРегиона = Муниципальный.НаименованиеРегиона;
	АдресГАР.КраткийТипРегиона = Муниципальный.КраткийТипРегиона;
	АдресГАР.ПолныйТипРегиона = Муниципальный.ПолныйТипРегиона;
	
	ЗаполнитьВидНаименованиеКод(АдресГАР.МуниципальныйРайон, Муниципальный.МуниципальныйРайон);
	ЗаполнитьВидНаименованиеКод(АдресГАР.ГородСелениеПоселение, Муниципальный.ГородПоселение);
	ЗаполнитьВидНаименование(АдресГАР.НаселенныйПункт, Муниципальный.НаселенныйПункт);
	ЗаполнитьТипНаименование(АдресГАР.ЭлементПланировочнойСтруктуры, Муниципальный.ЭлементПланировочнойСтруктуры);
	ЗаполнитьТипНаименование(АдресГАР.ЭлементУличноДорожнойСети, Муниципальный.Улица);
	АдресГАР.ЗемельныйУчасток = Муниципальный.ЗемельныйУчасток;
	ЗаполнитьТипНомер(АдресГАР.ПомещениеЗдания, Муниципальный.ПомещениеВЗдании);
	ЗаполнитьТипНомер(АдресГАР.ПомещениеКвартиры, Муниципальный.ПомещениеКвартиры);
	
	Для Каждого ЗданиеПровайдера Из Муниципальный.Здания Цикл
		ЗданиеУКД = НовыйТипНомер();
		ЗаполнитьТипНомер(ЗданиеУКД, ЗданиеПровайдера);
		АдресГАР.Здание.Добавить(ЗданиеУКД);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьАдресВСвободнойФормеИзПровайдера(АдресВСвободнойФорме, ВСвободнойФорме)
	
	АдресВСвободнойФорме = НовыйАдресВСвободнойФорме();
	АдресВСвободнойФорме.КодСтраны = ВСвободнойФорме.КодСтраны;
	АдресВСвободнойФорме.НаименованиеСтраны = ВСвободнойФорме.НаименованиеСтраны;
	
	Представление = ВСвободнойФорме.Представление;
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Представление = ВСвободнойФорме.Текст;
	КонецЕсли;
	АдресВСвободнойФорме.Представление = Представление;
	
КонецПроцедуры

Процедура ЗаполнитьВидНаименованиеКод(Приемник, Источник)
	
	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Приемник.ВидКод = Источник.Код;

	Приемник.Наименование = Источник.Наименование;
	
КонецПроцедуры

Процедура ЗаполнитьВидНаименование(Приемник, Источник)
	
	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Приемник.Вид = Источник.Вид;
	Приемник.Наименование = Источник.Наименование;
	
КонецПроцедуры

Процедура ЗаполнитьТипНаименование(Приемник, Источник)
	
	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Приемник.Тип = Источник.Тип;
	Приемник.Наименование = Источник.Наименование;
	
КонецПроцедуры

Процедура ЗаполнитьТипНомер(Приемник, Источник)
	
	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Приемник.Тип = Источник.Тип;
	Приемник.Номер = Источник.Номер;
	
КонецПроцедуры

Процедура ЗаполнитьФИОИзПровайдера(ФИОКонтракта, ФИОПровайдера)
	
	ФИОКонтракта.Фамилия = ФИОПровайдера.Фамилия;
	ФИОКонтракта.Имя = ФИОПровайдера.Имя;
	ФИОКонтракта.Отчество = ФИОПровайдера.Отчество;
	
КонецПроцедуры

