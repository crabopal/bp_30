// Подключенная библиотека строк для текущего режима обработки.
// Переменная используется в другом методе корневого модуля.
// BSLLS:UnusedLocalVariable-off
Перем СтдСтрКэш;
// Библиотека генерации XML для текущего режима обработки.
Перем КонтурДиадокГенерацияXMLКэш;
// BSLLS:UnusedLocalVariable-on

// #Область ПрограммныйИнтерфейс

// Проверяет возможность редактирования документа.
//
// Параметры:
//  Документ - Структура - документ пакета Диадока.
//
// Возвращаемое значение:
//  Булево - Истина для поддерживаемого УПД 970, УКД 29 или УКД 736.
//
Функция ЭтоПоддерживаемыйДокумент(Документ) Экспорт

	ИмяТипаСтруктуры = "Структура";
	ТипКонтентаУПД = "utd970";

	ТипДокумента = СвойствоСтруктуры(Документ, "Тип");
	Если ТипЗнч(Документ) <> Тип(ИмяТипаСтруктуры)
		ИЛИ ТипЗнч(ТипДокумента) <> Тип(ИмяТипаСтруктуры) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТипКонтента = НРег(СвойствоСтруктуры(ТипДокумента, "ТипКонтента", ""));
	ПоддерживаемыйФормат = ТипКонтента = ТипКонтентаУПД ИЛИ ТипКонтента = "ucd29" ИЛИ ТипКонтента = "ucd736";
	Если СвойствоСтруктуры(ТипДокумента, "Формализованный", Ложь) <> Истина ИЛИ НЕ ПоддерживаемыйФормат Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяТипа = НРег(СвойствоСтруктуры(ТипДокумента, "ТипДокумента", ""));
	ДопустимыеТипы = ?(ТипКонтента = ТипКонтентаУПД,
		СтдСтр().СтрРазделитьЛок(
			"universaltransferdocument,universaltransferdocumentrevision,invoice,invoicerevision,"
				+ "xmltorg12,xmlacceptancecertificate", ","),
		СтдСтр().СтрРазделитьЛок(
			"universalcorrectiondocument,universalcorrectiondocumentrevision,invoicecorrection,invoicecorrectionrevision", ","));
	ПоддерживаемыйТип = ДопустимыеТипы.Найти(ИмяТипа) <> Неопределено;

	СлужебнаяИнформация = СвойствоСтруктуры(Документ, "СлужебнаяИнформация");
	Контент = СвойствоСтруктуры(СлужебнаяИнформация, "Контент");
	Таблица = ?(ТипКонтента = ТипКонтентаУПД,
		СвойствоСтруктуры(Контент, "Table"),
		СвойствоСтруктуры(Контент, "InvoiceCorrectionTable"));
	Товары = СвойствоСтруктуры(Таблица, "Items");

	Возврат ПоддерживаемыйТип
		И ТипЗнч(Контент) = Тип(ИмяТипаСтруктуры)
		И ТипЗнч(Таблица) = Тип(ИмяТипаСтруктуры)
		И ТипЗнч(Товары) = Тип("Массив");

КонецФункции

// Создает модель формы без изменения исходного документа.
//
// Параметры:
//  Документ - Структура - документ пакета Диадока.
//
// Возвращаемое значение:
//  Структура - редактируемая модель документа.
//
Функция МодельРедактирования(Документ) Экспорт

	ТипКонтентаУПД = "utd970";

	ПроверитьПоддерживаемыйДокумент(Документ);

	Контент = Документ.СлужебнаяИнформация.Контент;
	ТипКонтента = НРег(Документ.Тип.ТипКонтента);
	Модель = Новый Структура;
	Модель.Вставить("ТипКонтента", ТипКонтента);
	НомерДокумента = ?(ТипКонтента = ТипКонтентаУПД,
		СвойствоСтруктуры(Контент, "DocumentNumber", ""), СвойствоСтруктуры(Контент, "Number", ""));
	ДатаДокумента = ?(ТипКонтента = ТипКонтентаУПД,
		СвойствоСтруктуры(Контент, "DocumentDate"), СвойствоСтруктуры(Контент, "Date"));
	Модель.Вставить("НомерДокумента", НомерДокумента);
	Модель.Вставить("ДатаДокумента", ДатаДокумента);
	Модель.Вставить("ФункцияДокумента", СвойствоСтруктуры(Контент, "Function", ""));
	Модель.Вставить("ИдентификаторФайлаИнформационногоПоля", "");
	Модель.Вставить("ИдентификаторГосударственногоКонтракта", СвойствоСтруктуры(Контент, "GovernmentContractInfo", ""));
	ОбстоятельствоФормирования = ?(ТипКонтента = ТипКонтентаУПД,
		СвойствоСтруктуры(Контент, "CircumFormatInvoice", ""), СвойствоСтруктуры(Контент, "CircumFormat", ""));
	Если Не ЗначениеЗаполнено(ОбстоятельствоФормирования) Тогда
		НастройкаОбстоятельства = НастройкаОбстоятельстваФормирования(
			ТипКонтента, СвойствоСтруктуры(Контент, "Function", ""));
		ОбстоятельствоФормирования = НастройкаОбстоятельства.ЗначениеПоУмолчанию;
	КонецЕсли;
	Модель.Вставить("ОбстоятельствоФормирования", ОбстоятельствоФормирования);
	Модель.Вставить("Продавцы", НоваяТаблицаСторон());
	Модель.Вставить("Покупатели", НоваяТаблицаСторон());
	Модель.Вставить("Грузоотправители", НоваяТаблицаСторон());
	Модель.Вставить("Грузополучатели", НоваяТаблицаСторон());
	Модель.Вставить("Товары", НоваяТаблицаТоваров());
	Модель.Вставить("Декларации", НоваяТаблицаДеклараций());
	Модель.Вставить("Прослеживаемость", НоваяТаблицаПрослеживаемости());
	Модель.Вставить("ГруппыМаркировки", НоваяТаблицаГруппМаркировки());
	Модель.Вставить("КодыМаркировки", НоваяТаблицаКодовМаркировки());
	Модель.Вставить("ДополнительныеСведенияДокумента", НоваяТаблицаИнформационныхПолей());
	Модель.Вставить("ДополнительныеСведенияТоваров", НоваяТаблицаИнформационныхПолей());
	ДополнительнаяИнформация = СвойствоСтруктуры(Контент, "AdditionalInfoId");
	Если ТипЗнч(ДополнительнаяИнформация) = Тип("Структура") Тогда
		Модель.ИдентификаторФайлаИнформационногоПоля = СвойствоСтруктуры(ДополнительнаяИнформация, "InfoFileId", "");
		ЗаполнитьИнформационныеПоля(Модель.ДополнительныеСведенияДокумента,
			СвойствоСтруктуры(ДополнительнаяИнформация, "StructedAdditionalInfos", Новый Массив), 0, "");
	КонецЕсли;

	Если ТипКонтента = ТипКонтентаУПД Тогда
		ЗаполнитьСтороны(Модель.Продавцы, СвойствоСтруктуры(Контент, "Sellers", Новый Массив));
		ЗаполнитьСтороны(Модель.Покупатели, СвойствоСтруктуры(Контент, "Buyers", Новый Массив));
		ЗаполнитьГрузоотправителей(Модель.Грузоотправители,
			СвойствоСтруктуры(Контент, "Shippers", Новый Массив), Модель.Продавцы);
		ЗаполнитьСтороны(Модель.Грузополучатели,
			СвойствоСтруктуры(Контент, "Consignees", Новый Массив));
		ТоварыКонтента = Контент.Table.Items;
	Иначе
		ЗаполнитьСторону(Модель.Продавцы, СвойствоСтруктуры(Контент, "Seller"));
		ЗаполнитьСторону(Модель.Покупатели, СвойствоСтруктуры(Контент, "Buyer"));
		ТоварыКонтента = Контент.InvoiceCorrectionTable.Items;
	КонецЕсли;

	ЗаполнитьТоварыМодели(Модель, ТоварыКонтента, ТипКонтента);
	ОбновитьПредставленияСлужебныхДанных(Модель);

	Возврат Модель;

КонецФункции

Процедура ЗаполнитьТоварыМодели(Модель, ТоварыКонтента, ТипКонтента)

	ТипКонтентаУПД = "utd970";
	Индекс = 0;
	Для Каждого СтрокаКонтента Из ТоварыКонтента Цикл
		СтрокаМодели = Модель.Товары.Добавить();
		СтрокаМодели.Индекс = Индекс;
		СтрокаМодели.ЭтоУслуга = СвойствоСтруктуры(СтрокаКонтента, "ItemMark", "") = "Service";
		СтрокаМодели.ИсходныйНомер = Индекс + 1;
		СтрокаМодели.Наименование = СвойствоСтруктуры(СтрокаКонтента, "Product", "");
		Если ТипКонтента = ТипКонтентаУПД Тогда
			ЗаполнитьЗначенияСтроки(СтрокаМодели, СтрокаКонтента);
			ЗаполнитьПрослеживаемость(Модель.Прослеживаемость, СтрокаКонтента, Индекс, СтрокаМодели.Наименование, ТипКонтента);
			ЗаполнитьМаркировку(Модель, СтрокаКонтента, Индекс, СтрокаМодели.Наименование, "ItemIdentificationNumbers", "");
		Иначе
			СтрокаМодели.ИсходныйНомер = СвойствоСтруктуры(СтрокаКонтента, "OriginalNumber", Индекс + 1);
			ЗаполнитьЗначенияСтрокиУКД(СтрокаМодели,
				СвойствоСтруктуры(СтрокаКонтента, "OriginalValues", Новый Структура), Истина);
			ЗаполнитьЗначенияСтрокиУКД(СтрокаМодели,
				СвойствоСтруктуры(СтрокаКонтента, "CorrectedValues", Новый Структура), Ложь);
			ЗаполнитьРазницыСтрокиУКД(СтрокаМодели);
			ЗаполнитьПрослеживаемость(Модель.Прослеживаемость, СтрокаКонтента, Индекс, СтрокаМодели.Наименование, ТипКонтента);
			ЗаполнитьМаркировку(Модель, СтрокаКонтента, Индекс, СтрокаМодели.Наименование,
				"OriginalItemIdentificationNumbers", "До");
			ЗаполнитьМаркировку(Модель, СтрокаКонтента, Индекс, СтрокаМодели.Наименование,
				"CorrectedItemIdentificationNumbers", "После");
		КонецЕсли;
		Если ТипКонтента = "ucd736" Тогда
			ИсправитьКоличествоОСУПослеВозврата(Модель.ГруппыМаркировки, СтрокаМодели, Индекс + 1);
			ЗаполнитьПартииУКД736(Модель, СтрокаКонтента, Индекс + 1);
		КонецЕсли;
		Если ТипКонтента <> "ucd736" Тогда
			ЗаполнитьДекларации(Модель.Декларации, СтрокаКонтента, Индекс,
				СтрокаМодели.Наименование, ТипКонтента);
		КонецЕсли;
		ЗаполнитьИнформационныеПоля(Модель.ДополнительныеСведенияТоваров,
			СвойствоСтруктуры(СтрокаКонтента, "StructedAdditionalInfos", Новый Массив),
			Индекс + 1, СтрокаМодели.Наименование);
		Индекс = Индекс + 1;
	КонецЦикла;

КонецПроцедуры

Процедура ИсправитьКоличествоОСУПослеВозврата(ГруппыМаркировки, СтрокаМодели, НомерСтроки)

	ГруппыДо = ГруппыМаркировки.НайтиСтроки(
		Новый Структура("НомерСтроки,Состояние", НомерСтроки, "До"));
	ГруппыПосле = ГруппыМаркировки.НайтиСтроки(
		Новый Структура("НомерСтроки,Состояние", НомерСтроки, "После"));
	СовпадаетКоличествоВозврата = ГруппыДо.Количество() = 1 И ГруппыПосле.Количество() = 1;
	Если СовпадаетКоличествоВозврата Тогда
		СовпадаетКоличествоВозврата = ЗначениеЗаполнено(ГруппыПосле[0].GTIN)
			И ГруппыДо[0].GTIN = ГруппыПосле[0].GTIN
			И ГруппыДо[0].КоличествоМаркированныхТоваров = СтрокаМодели.КоличествоДо
			И ГруппыПосле[0].КоличествоМаркированныхТоваров = СтрокаМодели.КоличествоДо - СтрокаМодели.Количество;
	КонецЕсли;
	Если СовпадаетКоличествоВозврата Тогда
		ГруппыПосле[0].КоличествоМаркированныхТоваров = СтрокаМодели.Количество;
	КонецЕсли;

КонецПроцедуры

// Общая модель дерева для управляемой и обычной форм.
//
// Параметры:
//  ТипКонтента - Строка - тип поддерживаемого документа.
//  Группы - ТаблицаЗначений - группы идентификации.
//  Коды - ТаблицаЗначений - КИЗ и исходные упаковки.
//
// Возвращаемое значение:
//  ДеревоЗначений - плоские строки внутри разделов до/после для УКД.
Функция ДеревоМаркировкиДляРедактора(ТипКонтента, Группы, Коды) Экспорт
	
	МодульСтрокРедактора = СтдСтр();
	Дерево = Новый ДеревоЗначений;
	Для Каждого ИмяКолонки Из МодульСтрокРедактора.СтрРазделитьЛок(
			"ВидСтроки,ИсходныйИндекс,НомерГруппы,Представление,Состояние,ТранспортнаяУпаковка,GTIN,"
			+ "КоличествоМаркированныхТоваров,ВесМаркированныхТоваров,КодПартии,ВидКода,Код,ВидУчета,КодПЭУ", ",") Цикл
		Если Группы.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			ТипКолонки = Группы.Колонки[ИмяКолонки].ТипЗначения;
		ИначеЕсли ИмяКолонки = "Код" ИЛИ ИмяКолонки = "КодПЭУ" Тогда
			ТипКолонки = Коды.Колонки.Код.ТипЗначения;
		Иначе
			ТипКолонки = Новый ОписаниеТипов("Строка");
		КонецЕсли;
		Дерево.Колонки.Добавить(ИмяКолонки, ТипКолонки);
	КонецЦикла;
	
	Разделы = Новый Соответствие;
	Если НРег(ТипКонтента) <> "utd970" Тогда
		Для Каждого Состояние Из МодульСтрокРедактора.СтрРазделитьЛок("До,После", ",") Цикл
			Раздел = Дерево.Строки.Добавить();
			Раздел.ВидСтроки = "Раздел";
			Раздел.Состояние = Состояние;
			Раздел.Представление = Состояние + " изменения";
			Разделы.Вставить(Состояние, Раздел);
		КонецЦикла;
	КонецЕсли;
	ПоказанныеГруппы = Новый Соответствие;
	СформироватьСтрокиГруппМаркировки(Дерево, Группы, Коды, Разделы,
		ПоказанныеГруппы, НРег(ТипКонтента) <> "utd970");
	
	СформироватьСтрокиКодовМаркировки(Дерево, Группы, Коды, Разделы, ПоказанныеГруппы);
	
	Возврат Дерево;
	
КонецФункции

// Переносит плоские узлы дерева в таблицы общей модели и проверяет маркировку.
// Разделы до/после определяют состояние, но не создают дополнительные группы.
//
// Параметры:
//  Дерево - ДеревоЗначений - строки маркировки.
//  Данные - Структура - номер строки, товар, тип контента и исходные таблицы.
//
// Возвращаемое значение:
//  Структура - проверенные группы и коды маркировки.
Функция ДанныеМаркировкиИзДерева(Дерево, Данные) Экспорт
	
	Группы = Данные.ГруппыМаркировки.СкопироватьКолонки();
	Коды = Данные.КодыМаркировки.СкопироватьКолонки();
	СтрокиУчета = СтрокиУчетаИзДерева(Дерево, Данные.ТипКонтента <> "utd970");
	НомераГрупп = Новый Соответствие;
	Для Каждого СтрокаУчета Из СтрокиУчета Цикл
		Если НомераГрупп.Получить(СтрокаУчета.НомерГруппы) = Неопределено Тогда
			Группа = Группы.Добавить();
			СкопироватьСведенияГруппы(СтрокаУчета, Группа);
			// Упаковка восстанавливается из исходных данных, а не копируется при смене вида учета.
			Группа.ТранспортнаяУпаковка = "";
			Если СтрокаУчета.ВидСтроки = "Группа" Тогда
				Группа.GTIN = СтрокаУчета.Код;
			КонецЕсли;
			Если Группа.ВидУчета = "ПЭУ (КИЗ)" Тогда
				Группа.GTIN = "";
				Группа.КоличествоМаркированныхТоваров = 0;
				Группа.ВесМаркированныхТоваров = 0;
			КонецЕсли;
			Если Группа.ВидУчета = "ОСУ" Тогда
				Группа.КодПартии = "";
			КонецЕсли;
			Группа.НомерСтроки = Данные.НомерСтроки;
			Группа.Товар = Данные.Товар;
			НомераГрупп.Вставить(Группа.НомерГруппы, Истина);
		КонецЕсли;
		Если СтрокаУчета.ВидСтроки = "Код" Тогда
			Код = Коды.Добавить();
			ЗаполнитьЗначенияСвойств(Код, СтрокаУчета, "НомерГруппы,ВидКода,Код");
		КонецЕсли;
	КонецЦикла;
	СохранитьИсходныеУпаковки(Данные, Группы, Коды);
	ПроверитьДанныеСтроки("Маркировка", Данные.ТипКонтента, Новый Структура("Группы,Коды", Группы, Коды));
	Возврат Новый Структура("НомерСтроки,ГруппыМаркировки,КодыМаркировки", Данные.НомерСтроки, Группы, Коды);
	
КонецФункции

// Сохраняет скрытые данные упаковок независимо от изменения видимых записей учета.
//
// Параметры:
//  Данные - Структура - исходные таблицы маркировки товарной строки.
//  Группы - ТаблицаЗначений - результат редактирования групп учета.
//  Коды - ТаблицаЗначений - результат редактирования кодов маркировки.
Процедура СохранитьИсходныеУпаковки(Данные, Группы, Коды)
	
	// Скрытые упаковки не редактируются и не удаляются вместе с видимыми записями учета.
	Для Каждого ИсходнаяГруппа Из Данные.ГруппыМаркировки Цикл
		КодыУпаковок = Данные.КодыМаркировки.НайтиСтроки(
				Новый Структура("НомерГруппы,ВидКода", ИсходнаяГруппа.НомерГруппы, "Упаковка"));
		Если КодыУпаковок.Количество() = 0 И НЕ ЗначениеЗаполнено(ИсходнаяГруппа.ТранспортнаяУпаковка) Тогда
			Продолжить;
		КонецЕсли;
		Группа = Группы.Найти(ИсходнаяГруппа.НомерГруппы, "НомерГруппы");
		Если Группа = Неопределено Тогда
			Группа = Группы.Добавить();
			ЗаполнитьЗначенияСвойств(Группа, ИсходнаяГруппа);
			// Не восстанавливаем удаленные пользователем сведения учета.
			Группа.GTIN = "";
			Группа.КоличествоМаркированныхТоваров = 0;
			Группа.ВесМаркированныхТоваров = 0;
			Группа.КодПартии = "";
			Группа.ВидУчета = "";
		КонецЕсли;
		Группа.ТранспортнаяУпаковка = ИсходнаяГруппа.ТранспортнаяУпаковка;
		Для Каждого ИсходныйКод Из КодыУпаковок Цикл
			ЗаполнитьЗначенияСвойств(Коды.Добавить(), ИсходныйКод);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет размещение кодов в разделах документа перед переносом в таблицы.
//
// Параметры:
//  Дерево - ДеревоЗначений - отображаемые строки маркировки.
//  ЭтоУКД - Булево - требуется размещение в разделах до/после.
//
// Возвращаемое значение:
//  Массив из СтрокаДереваЗначений - строки кодов и групп учета.
Функция СтрокиУчетаИзДерева(Дерево, ЭтоУКД)
	
	СтрокиУчета = Новый Массив;
	Для Каждого КорневаяСтрока Из Дерево.Строки Цикл
		Если КорневаяСтрока.ВидСтроки = "Раздел" Тогда
			Для Каждого СтрокаРаздела Из КорневаяСтрока.Строки Цикл
				СтрокаРаздела.Состояние = КорневаяСтрока.Состояние;
				СтрокиУчета.Добавить(СтрокаРаздела);
			КонецЦикла;
		Иначе
			Если ЭтоУКД Тогда
				ВызватьИсключение "Маркировка УКД должна находиться в разделе до или после изменения.";
			КонецЕсли;
			КорневаяСтрока.Состояние = "";
			СтрокиУчета.Добавить(КорневаяСтрока);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрокиУчета;
	
КонецФункции

Процедура СформироватьСтрокиГруппМаркировки(Дерево, Группы, Коды, Разделы, ПоказанныеГруппы, ЭтоУКД)
	
	Для Каждого Группа Из Группы Цикл
		Если ЭтоУКД И Разделы.Получить(Группа.Состояние) = Неопределено Тогда
			ВызватьИсключение "Для маркировки УКД не указано состояние до или после изменения.";
		КонецЕсли;
		ЕстьКИЗ = Коды.НайтиСтроки(
				Новый Структура("НомерГруппы,ВидКода", Группа.НомерГруппы, "КИЗ")).Количество() > 0;
		ЕстьКоличественныеРеквизиты = ЗначениеЗаполнено(Группа.КоличествоМаркированныхТоваров)
			ИЛИ ЗначениеЗаполнено(Группа.ВесМаркированныхТоваров);
		ЕстьВидимыеРеквизитыГруппы = ЗначениеЗаполнено(Группа.GTIN) ИЛИ ЕстьКоличественныеРеквизиты
			ИЛИ НЕ ЕстьКИЗ И ЗначениеЗаполнено(Группа.КодПартии);
		Если ЕстьВидимыеРеквизитыГруппы Тогда
			Раздел = Разделы.Получить(Группа.Состояние);
			СтрокиНазначения = ?(Раздел = Неопределено, Дерево.Строки, Раздел.Строки);
			СоздатьУзелГруппыМаркировки(СтрокиНазначения, Группа);
			ПоказанныеГруппы.Вставить(Группа.НомерГруппы, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьСтрокиКодовМаркировки(Дерево, Группы, Коды, Разделы, ПоказанныеГруппы)
	
	Для Каждого Код Из Коды Цикл
		Если Код.ВидКода <> "КИЗ" Тогда
			Продолжить;
		КонецЕсли;
		Группа = Группы.Найти(Код.НомерГруппы, "НомерГруппы");
		Если Группа = Неопределено Тогда
			ВызватьИсключение "Не найдена группа идентификации для кода маркировки.";
		КонецЕсли;
		Раздел = Разделы.Получить(Группа.Состояние);
		СтрокиНазначения = ?(Раздел = Неопределено, Дерево.Строки, Раздел.Строки);
		УзелКода = СтрокиНазначения.Добавить();
		УзелКода.ВидСтроки = "Код";
		УзелКода.НомерГруппы = Код.НомерГруппы;
		УзелКода.ВидКода = Код.ВидКода;
		УзелКода.Представление = "ПЭУ (КИЗ)";
		УзелКода.Код = Код.Код;
		Если Код.ВидКода = "КИЗ" Тогда
			УзелКода.КодПЭУ = Код.Код;
		КонецЕсли;
		УзелКода.ИсходныйИндекс = Группа.ИсходныйИндекс;
		УзелКода.Состояние = Группа.Состояние;
		УзелКода.ТранспортнаяУпаковка = Группа.ТранспортнаяУпаковка;
		УзелКода.КодПартии = Группа.КодПартии;
		Если ПоказанныеГруппы.Получить(Группа.НомерГруппы) = Неопределено Тогда
			СкопироватьСведенияГруппы(Группа, УзелКода);
		КонецЕсли;
		УзелКода.ВидУчета = УзелКода.Представление;
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьУзелГруппыМаркировки(СтрокиНазначения, Группа)
	
	Узел = СтрокиНазначения.Добавить();
	СкопироватьСведенияГруппы(Группа, Узел);
	Узел.ВидСтроки = "Группа";
	Узел.Код = Группа.GTIN;
	Узел.Представление = ПредставлениеГруппы(Группа);
	Если ЗначениеЗаполнено(Группа.GTIN) Тогда
		Узел.ВидУчета = Узел.Представление;
	КонецЕсли;
	
КонецПроцедуры

Процедура СкопироватьСведенияГруппы(Источник, Приемник)
	
	Приемник.ИсходныйИндекс = Источник.ИсходныйИндекс;
	Приемник.НомерГруппы = Источник.НомерГруппы;
	Приемник.Состояние = Источник.Состояние;
	Приемник.ТранспортнаяУпаковка = Источник.ТранспортнаяУпаковка;
	Приемник.GTIN = Источник.GTIN;
	Приемник.КоличествоМаркированныхТоваров = Источник.КоличествоМаркированныхТоваров;
	Приемник.ВесМаркированныхТоваров = Источник.ВесМаркированныхТоваров;
	Приемник.КодПартии = Источник.КодПартии;
	Приемник.ВидУчета = Источник.ВидУчета;
	
КонецПроцедуры

Функция ПредставлениеГруппы(Группа)
	
	Если ЗначениеЗаполнено(Группа.ВидУчета) Тогда
		Возврат Группа.ВидУчета;
	КонецЕсли;
	Если ЗначениеЗаполнено(Группа.КодПартии) Тогда
		Возврат "Партионный учет";
	КонецЕсли;
	Возврат "ОСУ";
	
КонецФункции

// Возвращает страны ОКСМ в транспортном формате клиент-серверного вызова.
//
// Возвращаемое значение:
//  Массив - структуры с кодом и наименованием страны.
//
Функция СтраныМира() Экспорт

	ОКСМ = КонтурДиадокГенерацияXML().ПолучитьОКСМ();
	ВременнаяТаблица = Новый ТаблицаЗначений;
	ВременнаяТаблица.Колонки.Добавить("Код");
	ВременнаяТаблица.Колонки.Добавить("Наименование");
	ДобавленныеКоды = Новый Соответствие;
	Для Каждого Страна Из ОКСМ Цикл
		Код = СокрЛП(Строка(Страна.Код));
		Если Не ЗначениеЗаполнено(Код) Или ДобавленныеКоды.Получить(Код) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавленныеКоды.Вставить(Код, Истина);
		НоваяСтрана = ВременнаяТаблица.Добавить();
		НоваяСтрана.Код = Код;
		НоваяСтрана.Наименование = СокрЛП(Строка(Страна.НаименованиеКраткое));
	КонецЦикла;

	ВременнаяТаблица.Сортировать("Наименование");
	Результат = Новый Массив;
	Для Каждого Страна Из ВременнаяТаблица Цикл
		Результат.Добавить(Новый Структура("Код,Наименование", Страна.Код, Страна.Наименование));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Переносит проверенные значения модели в протоконтент без неявного пересчета сумм.
//
// Параметры:
//  Документ - Структура - изменяемый документ пакета Диадока.
//  Модель - Структура - модель редактора.
//  ТолькоМаркировка - Булево - изменять только маркировку и регистрационные реквизиты покупателя-ИП УКД29.
//
// Возвращаемое значение:
//  Структура - измененный документ.
//
Функция ПрименитьМодель(Документ, Модель, ТолькоМаркировка = Ложь) Экспорт

	ИмяРеквизитаГосударственногоКонтракта = "GovernmentContractInfo";
	ТипКонтентаУПД = "utd970";

	ПроверитьПоддерживаемыйДокумент(Документ);
	ПроверитьМодель(Документ, Модель);

	Контент = Документ.СлужебнаяИнформация.Контент;
	ТипКонтента = НРег(Документ.Тип.ТипКонтента);
	Если ТолькоМаркировка Тогда
		Если ТипКонтента = "ucd29" И СвойствоСтруктуры(Контент.Buyer, "Type", "") = "IndividualEntity" Тогда
			ПрименитьРеквизитыСтороны(Контент.Buyer, Модель.Покупатели[0]);
		КонецЕсли;
		ПрименитьМаркировкуВсехСтрок(Контент, Модель, ТипКонтента);
		// Валидатор продукта обращается к необязательному реквизиту напрямую.
		// Восстанавливаем только отсутствующее поле, не меняя существующее значение.
		Если НЕ Контент.Свойство(ИмяРеквизитаГосударственногоКонтракта) Тогда
			Контент.Вставить(ИмяРеквизитаГосударственногоКонтракта, "");
		КонецЕсли;
		ОбновитьПризнакиТоваровДокумента(Контент);
		Возврат Документ;
	КонецЕсли;
	ПрименитьШапкуДокумента(Контент, Модель, ТипКонтента);

	ИтогоБезНДС = 0;
	ИтогоНДС = 0;
	Итого = 0;

	Для Каждого СтрокаМодели Из Модель.Товары Цикл
		СтрокаКонтента = ?(ТипКонтента = ТипКонтентаУПД,
			Контент.Table.Items[СтрокаМодели.Индекс],
			Контент.InvoiceCorrectionTable.Items[СтрокаМодели.Индекс]);
		СтрокаКонтента.Вставить("Product", СокрЛП(СтрокаМодели.Наименование));
		Если ТипКонтента = ТипКонтентаУПД Тогда
			ПрименитьЗначенияСтроки(СтрокаКонтента, СтрокаМодели);
			ПрименитьПрослеживаемость(СтрокаКонтента, Модель.Прослеживаемость, СтрокаМодели.Индекс + 1, ТипКонтента);
			ПрименитьМаркировку(СтрокаКонтента, Модель, СтрокаМодели.Индекс + 1, "ItemIdentificationNumbers", "");
		Иначе
			ПрименитьЗначенияСтрокиУКД(СтрокаКонтента, СтрокаМодели);
			ПрименитьПрослеживаемость(СтрокаКонтента, Модель.Прослеживаемость, СтрокаМодели.Индекс + 1, ТипКонтента);
			ПрименитьИнформационныеПоля(СтрокаКонтента, "StructedAdditionalInfos",
				Модель.ДополнительныеСведенияТоваров, СтрокаМодели.Индекс + 1);
			ПрименитьМаркировку(СтрокаКонтента, Модель, СтрокаМодели.Индекс + 1,
				"OriginalItemIdentificationNumbers", "До");
			ПрименитьМаркировку(СтрокаКонтента, Модель, СтрокаМодели.Индекс + 1,
				"CorrectedItemIdentificationNumbers", "После");
		КонецЕсли;
		Если ТипКонтента <> "ucd736" Тогда
			ПрименитьДекларации(СтрокаКонтента, Модель.Декларации,
				СтрокаМодели.Индекс + 1, ТипКонтента);
		КонецЕсли;
		Если ТипКонтента = ТипКонтентаУПД Тогда
			ПрименитьИнформационныеПоля(СтрокаКонтента, "StructedAdditionalInfos",
				Модель.ДополнительныеСведенияТоваров, СтрокаМодели.Индекс + 1);
		КонецЕсли;

		ИтогоБезНДС = ИтогоБезНДС + СтрокаМодели.СуммаБезНДС;
		ИтогоНДС = ИтогоНДС + СтрокаМодели.СуммаНДС;
		Итого = Итого + СтрокаМодели.Сумма;
	КонецЦикла;

	Если ТипКонтента = ТипКонтентаУПД Тогда
		Контент.Table.Вставить("TotalWithVatExcluded", ИтогоБезНДС);
		Контент.Table.Вставить("Vat", ИтогоНДС);
		Контент.Table.Вставить("Total", Итого);
	Иначе
		ПрименитьИтогиУКД(Контент.InvoiceCorrectionTable, Модель.Товары);
	КонецЕсли;
	ОбновитьПризнакиТоваровДокумента(Контент);

	Возврат Документ;

КонецФункции

// Явно пересчитывает суммы модели для обычных числовых ставок НДС.
//
// Параметры:
//  Модель - Структура - модель редактора.
//
Процедура ПересчитатьМодель(Модель) Экспорт

	ПроцентовВЦелом = 100;

	ТочностьДенежнойСуммы = 2;

	Для Каждого СтрокаМодели Из Модель.Товары Цикл
		ПроверитьСтавкуНДС(СтрокаМодели.СтавкаНДС);
		Если Модель.ТипКонтента = "utd970"
			Или СтрокаМодели.Количество <> 0 Или СтрокаМодели.Цена <> 0 Тогда
			СтрокаМодели.СуммаБезНДС = Окр(СтрокаМодели.Количество * СтрокаМодели.Цена, ТочностьДенежнойСуммы);
		КонецЕсли;
		Ставка = СтавкаНДСЧислом(СтрокаМодели.СтавкаНДС, СтрокаМодели.БезНДС);
		Если Ставка = Неопределено Тогда
			ВызватьИсключение СтдСтр().СтрШаблонЛок(
				"Автоматический пересчет расчетной ставки НДС %1 не поддерживается. Укажите суммы вручную.",
				СтрокаМодели.СтавкаНДС);
		КонецЕсли;
		СтрокаМодели.СуммаНДС = Окр(СтрокаМодели.СуммаБезНДС * Ставка / ПроцентовВЦелом, ТочностьДенежнойСуммы);
		СтрокаМодели.Сумма = СтрокаМодели.СуммаБезНДС + СтрокаМодели.СуммаНДС;
		Если Модель.ТипКонтента = "ucd29" Или Модель.ТипКонтента = "ucd736" Тогда
			ЗаполнитьРазницыСтрокиУКД(СтрокаМодели);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает ставки НДС, разрешенные форматами редактора.
//
// Возвращаемое значение:
//  Массив - строковые представления ставок.
//
Функция ДопустимыеСтавкиНДС() Экспорт

	Возврат СтдСтр().СтрРазделитьЛок(
		"0,5,7,9.09,10,16.67,18,18.03,20,22,5/105,7/107,10/110,18/118,20/120,22/122,без НДС,ИсчНалАг", ",");

КонецФункции

// Возвращает правила заполнения специального обстоятельства для функции документа.
//
// Параметры:
//  ТипКонтента - Строка - utd970, ucd29 или ucd736.
//  ФункцияДокумента - Строка - функция УПД или УКД.
//
// Возвращаемое значение:
//  Структура - ТолькоВыбор, ЗначениеПоУмолчанию и ДопустимыеЗначения.
//
Функция НастройкаОбстоятельстваФормирования(Знач ТипКонтента, Знач ФункцияДокумента) Экспорт

	ТипКонтентаУПД = "utd970";

	ДопустимыеЗначения = Новый Массив;
	Результат = Новый Структура(
		"ТолькоВыбор,ЗначениеПоУмолчанию,ДопустимыеЗначения",
		Ложь, "", ДопустимыеЗначения);
	ФункцияДокумента = НормализованнаяФункцияДокумента(ФункцияДокумента, НРег(ТипКонтента) = ТипКонтентаУПД);
	Если НРег(ТипКонтента) = ТипКонтентаУПД Тогда
		Если ФункцияДокумента = "СЧФ" Тогда
			Результат.ТолькоВыбор = Истина;
			Результат.ЗначениеПоУмолчанию = "1";
			Для Каждого Код Из СтдСтр().СтрРазделитьЛок("1,2,3,4,5,6", ",") Цикл
				ДопустимыеЗначения.Добавить(Код);
			КонецЦикла;
		ИначеЕсли ФункцияДокумента = "СЧФДОП" Или ФункцияДокумента = "ДОП" Тогда
			Результат.ЗначениеПоУмолчанию = "00005";
		Иначе
			Возврат Результат;
		КонецЕсли;
	ИначеЕсли ФункцияДокумента = "КСЧФ" Тогда
		Результат.ТолькоВыбор = Истина;
		Для Каждого Код Из СтдСтр().СтрРазделитьЛок("1,3,4,5,6", ",") Цикл
			ДопустимыеЗначения.Добавить(Код);
		КонецЦикла;
	Иначе
		Возврат Результат;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет данные дочернего редактора по единым правилам объектного модуля.
//
// Параметры:
//  ВидДанных - Строка - ДополнительныеСведения, Сторона, Декларации, Прослеживаемость или Маркировка.
//  ТипКонтента - Строка - utd970, ucd29 или ucd736.
//  Данные - ТаблицаЗначений, СтрокаТаблицыЗначений, Структура - проверяемые данные.
//  ДополнительныеДанные - Произвольный - ОКСМ для проверки деклараций.
//
Процедура ПроверитьДанныеСтроки(ВидДанных, ТипКонтента, Данные, ДополнительныеДанные = Неопределено) Экспорт

	ТипКонтента = НРег(ТипКонтента);
	Если ВидДанных = "ДополнительныеСведения" Тогда
		ПроверитьИнформационныеПоля(Данные, 0, ТипКонтента);
	ИначеЕсли ВидДанных = "Сторона" Тогда
		ОГРНИП = Данные.ОГРНИП;
		ДатаОГРНИП = Данные.ДатаОГРНИП;
		ДлинаОГРНИП = 15;
		МинимальнаяДатаРегистрации = '19000101';
		ГраницаДатыРегистрации = '21000101';
		Если НЕ ЗначениеЗаполнено(ОГРНИП) Тогда
			ВызватьИсключение "Заполните ОГРНИП стороны.";
		КонецЕсли;
		Если СтрДлина(ОГРНИП) <> ДлинаОГРНИП ИЛИ НЕ СтрокаСодержитТолькоЦифры(ОГРНИП) Тогда
			ВызватьИсключение "ОГРНИП стороны должен содержать 15 цифр.";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДатаОГРНИП) Тогда
			ВызватьИсключение "Заполните дату ОГРНИП стороны.";
		КонецЕсли;
		Если ТипЗнч(ДатаОГРНИП) <> Тип("Дата")
			ИЛИ ДатаОГРНИП < МинимальнаяДатаРегистрации ИЛИ ДатаОГРНИП >= ГраницаДатыРегистрации Тогда
			ВызватьИсключение "Дата ОГРНИП стороны должна находиться в интервале 01.01.1900 - 31.12.2099.";
		КонецЕсли;
	ИначеЕсли ВидДанных = "Декларации" Тогда
		ПроверитьДекларации(Данные, 0, ТипКонтента, ДополнительныеДанные);
	ИначеЕсли ВидДанных = "Прослеживаемость" Тогда
		ПроверитьПрослеживаемость(Данные, 0, ТипКонтента);
	ИначеЕсли ВидДанных = "Маркировка" И ТипЗнч(Данные) = Тип("Структура") Тогда
		ПроверитьМаркировку(Данные.Группы, Данные.Коды, 0, ТипКонтента);
	Иначе
		ВызватьИсключение "Неизвестный вид данных редактора.";
	КонецЕсли;

КонецПроцедуры

// Обновляет краткие представления дочерних данных в строках товаров.
//
// Параметры:
//  Модель - Структура - модель редактора.
//
Процедура ОбновитьПредставленияСлужебныхДанных(Модель) Экспорт

	КоличествоРНПТПоСтрокам = Новый Соответствие;
	КоличествоДекларацийПоСтрокам = Новый Соответствие;
	КоличествоСведенийПоСтрокам = Новый Соответствие;
	СтрокиСМаркировкой = Новый Соответствие;
	СтрокиГрупп = Новый Соответствие;

	Для Каждого Строка Из Модель.Прослеживаемость Цикл
		УвеличитьСчетчик(КоличествоРНПТПоСтрокам, Строка.НомерСтроки);
	КонецЦикла;
	Для Каждого Строка Из Модель.Декларации Цикл
		УвеличитьСчетчик(КоличествоДекларацийПоСтрокам, Строка.НомерСтроки);
	КонецЦикла;
	Для Каждого Строка Из Модель.ДополнительныеСведенияТоваров Цикл
		УвеличитьСчетчик(КоличествоСведенийПоСтрокам, Строка.НомерСтроки);
	КонецЦикла;
	Для Каждого Группа Из Модель.ГруппыМаркировки Цикл
		СтрокиГрупп.Вставить(Группа.НомерГруппы, Группа.НомерСтроки);
		СтрокиСМаркировкой.Вставить(Группа.НомерСтроки, Истина);
	КонецЦикла;
	Для Каждого Код Из Модель.КодыМаркировки Цикл
		НомерСтроки = СтрокиГрупп.Получить(Код.НомерГруппы);
		Если НомерСтроки <> Неопределено Тогда
			СтрокиСМаркировкой.Вставить(НомерСтроки, Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТовара Из Модель.Товары Цикл
		НомерСтроки = СтрокаТовара.Индекс + 1;
		КоличествоРНПТ = ЗначениеСчетчика(КоличествоРНПТПоСтрокам, НомерСтроки);
		КоличествоДеклараций = ЗначениеСчетчика(КоличествоДекларацийПоСтрокам, НомерСтроки);
		КоличествоДополнительныхСведений = ЗначениеСчетчика(КоличествоСведенийПоСтрокам, НомерСтроки);

		СтрокаТовара.ПредставлениеПрослеживаемости = ПредставлениеСведенийСтроки(
			КоличествоРНПТ, "Добавить РНПТ", "РНПТ: %1");
		СтрокаТовара.ПредставлениеДеклараций = ПредставлениеСведенийСтроки(
			КоличествоДеклараций, "Указать страну и ДТ", "ДТ: %1");
		СтрокаТовара.ПредставлениеДополнительныхСведений = ПредставлениеСведенийСтроки(
			КоличествоДополнительныхСведений, "Добавить сведения", "Сведений: %1");
		СтрокаТовара.ПредставлениеМаркировки = ?(
			СтрокиСМаркировкой.Получить(НомерСтроки) = Неопределено,
			"Добавить маркировку", "Изменить маркировку");
		Если СтрокаТовара.ЭтоУслуга Тогда
			СтрокаТовара.ПредставлениеМаркировки = "";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Поля трех вариантов AddressInfo970 из Proto_xsd. Общие для УПД 970 и УКД 29.
//
// Возвращаемое значение:
//  Массив из Структура - описания полей: ТипАдреса, Поле, Реквизит, Заголовок, Длина.
Функция ПоляАдреса() Экспорт

	ОписаниеПолей = "AddressRF|ZipCode|РФИндекс|Индекс|6
	|AddressRF|RegionCode|РФКодРегиона|Код региона|2
	|AddressRF|Region|РФРегион|Регион|51
	|AddressRF|Territory|РФРайон|Район|255
	|AddressRF|City|РФГород|Город|255
	|AddressRF|Locality|РФНаселенныйПункт|Населенный пункт|255
	|AddressRF|Street|РФУлица|Улица|255
	|AddressRF|Building|РФДом|Дом|50
	|AddressRF|Block|РФКорпус|Корпус|50
	|AddressRF|Apartment|РФКвартира|Квартира / помещение|0
	|AddressRF|AdditionalInfo|РФДополнительно|Дополнительные сведения|1000
	|AddressSAR|ID|ГАРИдентификатор|Идентификатор ГАР|36
	|AddressSAR|ZipCode|ГАРИндекс|Индекс|6
	|AddressSAR|RegionCode|ГАРКодРегиона|Код региона|2
	|AddressSAR|Region|ГАРРегион|Регион|51
	|AddressSAR|MunicipalDistrictCode|ГАРВидРайона|Вид муниципального района (код)|1
	|AddressSAR|MunicipalDistrict|ГАРРайон|Муниципальный район / округ|255
	|AddressSAR|SettlementCode|ГАРВидПоселения|Вид поселения (код)|1
	|AddressSAR|Settlement|ГАРПоселение|Городское / сельское поселение|255
	|AddressSAR|LocalityType|ГАРВидНаселенногоПункта|Вид населенного пункта|50
	|AddressSAR|Locality|ГАРНаселенныйПункт|Населенный пункт|255
	|AddressSAR|PlanningElementType|ГАРТипПланировочногоЭлемента|Тип планировочного элемента|50
	|AddressSAR|PlanningElement|ГАРПланировочныйЭлемент|Планировочный элемент|255
	|AddressSAR|StreetElementType|ГАРТипУлицы|Тип элемента уличной сети|50
	|AddressSAR|StreetElement|ГАРУлица|Элемент уличной сети|255
	|AddressSAR|LandPlot|ГАРУчасток|Земельный участок|50
	|AddressSAR|HouseType|ГАРТипПомещенияЗдания|Тип помещения в здании|50
	|AddressSAR|House|ГАРПомещениеЗдания|Помещение в здании|255
	|AddressSAR|ApartmentType|ГАРТипПомещенияКвартиры|Тип помещения в квартире|50
	|AddressSAR|Apartment|ГАРПомещениеКвартиры|Помещение в квартире|0
	|AddressText|CountryCode|ТекстКодСтраны|Код страны|3
	|AddressText|Country|ТекстСтрана|Страна|255
	|AddressText|AddressText|ТекстАдреса|Адрес|1000";
	Результат = Новый Массив;
	Для Каждого СтрокаОписания Из СтдСтр().СтрРазделитьЛок(ОписаниеПолей, Символы.ПС, Ложь) Цикл
		Части = СтдСтр().СтрРазделитьЛок(СтрокаОписания, "|", Истина);
		ОписаниеПоля = Новый Структура;
		ОписаниеПоля.Вставить("ТипАдреса", Части[0]);
		ОписаниеПоля.Вставить("Поле", Части[1]);
		ОписаниеПоля.Вставить("Реквизит", Части[2]);
		ОписаниеПоля.Вставить("Заголовок", Части[3]);
		ОписаниеПоля.Вставить("Длина", Число(Части[4]));
		Результат.Добавить(ОписаниеПоля);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Создает независимые черновики полей каждого представления адреса.
//
// Параметры:
//  Адрес - Структура, Неопределено - исходный AddressInfo из контента документа.
//
// Возвращаемое значение:
//  Структура - поля адреса, выбранный вид, исходные данные и таблица зданий ГАР.
Функция МодельАдреса(Адрес) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ДанныеИсходногоАдреса", ЗначениеВСтрокуВнутр(Адрес));
	ВидАдреса = СвойствоСтруктуры(Адрес, "Type", "");
	Если Не ЗначениеЗаполнено(ВидАдреса) Тогда
		ВидАдреса = "AddressRF";
		Для Каждого Вид Из СтдСтр().СтрРазделитьЛок("AddressRF,AddressSAR,AddressText", ",") Цикл
			Если ТипЗнч(СвойствоСтруктуры(Адрес, Вид)) = Тип("Структура") Тогда
				ВидАдреса = Вид;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Результат.Вставить("ВидАдреса", ВидАдреса);
	Результат.Вставить("ГлобальныйНомерМеста", СвойствоСтруктуры(Адрес, "GLN", ""));
	Для Каждого Поле Из ПоляАдреса() Цикл
		Результат.Вставить(Поле.Реквизит,
			СвойствоСтруктуры(СвойствоСтруктуры(Адрес, Поле.ТипАдреса), Поле.Поле, ""));
	КонецЦикла;

	Здания = Новый ТаблицаЗначений;
	Здания.Колонки.Добавить("ИсходныйИндекс", Новый ОписаниеТипов("Число"));
	Здания.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка"));
	Здания.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Для Каждого Здание Из СвойствоСтруктуры(
		СвойствоСтруктуры(Адрес, "AddressSAR"), "Buildings", Новый Массив) Цикл
		СтрокаЗдания = Здания.Добавить();
		СтрокаЗдания.ИсходныйИндекс = Здания.Количество() - 1;
		СтрокаЗдания.Тип = СвойствоСтруктуры(Здание, "Type", "");
		СтрокаЗдания.Номер = СвойствоСтруктуры(Здание, "Number", "");
	КонецЦикла;
	Результат.Вставить("Здания", Здания);
	Возврат Результат;

КонецФункции

// Собирает независимый адрес. Исходный документ и черновики других типов не изменяются.
//
// Параметры:
//  Модель - Структура - черновик, созданный методом МодельАдреса.
//  ПроверятьНеизмененный - Булево - проверять также адрес, в который не внесены правки.
//
// Возвращаемое значение:
//  Структура - адрес для контента документа с сохраненными неизвестными полями.
Функция АдресИзМодели(Модель, ПроверятьНеизмененный = Ложь) Экспорт

	ИмяТипаСтруктуры = "Структура";

	Если СтдСтр().СтрРазделитьЛок("AddressRF,AddressSAR,AddressText", ",").Найти(Модель.ВидАдреса) = Неопределено Тогда
		ВызватьИсключение "Выберите тип адреса.";
	КонецЕсли;
	Поля = ПоляАдреса();
	ИсходныйАдрес = ЗначениеИзСтрокиВнутр(Модель.ДанныеИсходногоАдреса);
	Если НЕ ПроверятьНеизмененный И ТипЗнч(ИсходныйАдрес) = Тип(ИмяТипаСтруктуры)
		И Не АдресИзменен(Модель, МодельАдреса(ИсходныйАдрес), Поля) Тогда
		Возврат ИсходныйАдрес;
	КонецЕсли;
	ПроверитьПоляАдреса(Модель, Поля);

	Результат = ИсходныйАдрес;
	Если ТипЗнч(Результат) <> Тип(ИмяТипаСтруктуры) Тогда
		Результат = Новый Структура;
	КонецЕсли;
	ВыбранныйАдрес = СвойствоСтруктуры(Результат, Модель.ВидАдреса, Новый Структура);
	Если ТипЗнч(ВыбранныйАдрес) <> Тип(ИмяТипаСтруктуры) Тогда
		ВыбранныйАдрес = Новый Структура;
	КонецЕсли;
	Для Каждого Поле Из Поля Цикл
		Если Поле.ТипАдреса = Модель.ВидАдреса Тогда
			ВыбранныйАдрес.Вставить(Поле.Поле, СокрЛП(Модель[Поле.Реквизит]));
		КонецЕсли;
	КонецЦикла;
	Если Модель.ВидАдреса = "AddressSAR" Тогда
		ИсходныеЗдания = СвойствоСтруктуры(ВыбранныйАдрес, "Buildings", Новый Массив);
		ВыбранныйАдрес.Вставить("Buildings", ЗданияАдресаИзМодели(Модель.Здания, ИсходныеЗдания));
	КонецЕсли;
	Для Каждого Вид Из СтдСтр().СтрРазделитьЛок("AddressRF,AddressSAR,AddressText", ",") Цикл
		Результат.Удалить(Вид);
	КонецЦикла;
	Результат.Вставить("Type", Модель.ВидАдреса);
	Результат.Вставить("GLN", СокрЛП(Модель.ГлобальныйНомерМеста));
	Результат.Вставить(Модель.ВидАдреса, ВыбранныйАдрес);
	Возврат Результат;

КонецФункции

// Получает краткий текст адреса выбранного вида для ссылки стороны документа.
//
// Параметры:
//  Адрес - Структура, Неопределено - адрес из контента документа.
//
// Возвращаемое значение:
//  Строка - представление адреса или пустая строка, если адрес не заполнен.
Функция ПредставлениеАдресаЛок(Адрес) Экспорт

	ТипТекстовогоАдреса = "AddressText";
	ИмяТипаСтруктуры = "Структура";

	Если ТипЗнч(Адрес) <> Тип(ИмяТипаСтруктуры) Тогда
		Возврат "";
	КонецЕсли;
	АдресТекстом = СвойствоСтруктуры(СвойствоСтруктуры(Адрес, ТипТекстовогоАдреса), ТипТекстовогоАдреса, "");
	ВидАдреса = СвойствоСтруктуры(Адрес, "Type", "");
	Если (ВидАдреса = "" ИЛИ ВидАдреса = ТипТекстовогоАдреса) И ЗначениеЗаполнено(АдресТекстом) Тогда
		Возврат АдресТекстом;
	КонецЕсли;

	Результат = "";
	АдресРФ = СвойствоСтруктуры(Адрес, "AddressRF");
	Если (ВидАдреса = "" ИЛИ ВидАдреса = "AddressRF") И ТипЗнч(АдресРФ) = Тип(ИмяТипаСтруктуры) Тогда
		Результат = СоединитьЧастиАдреса(АдресРФ, "ZipCode,Region,Territory,City,Locality,"
			+ "Street,Building,Block,Apartment,AdditionalInfo");
	КонецЕсли;
	АдресГАР = СвойствоСтруктуры(Адрес, "AddressSAR");
	ПоказатьАдресГАР = НЕ ЗначениеЗаполнено(Результат)
		И (ВидАдреса = "" ИЛИ ВидАдреса = "AddressSAR") И ТипЗнч(АдресГАР) = Тип(ИмяТипаСтруктуры);
	Если ПоказатьАдресГАР Тогда
		Результат = ПредставлениеАдресаГАР(АдресГАР);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

// Применяет только маркировку всех исходных товарных строк, сохраняя остальные реквизиты.
//
// Параметры:
//  Контент - Структура - изменяемый контент документа.
//  Модель - Структура - маркировка товарных строк.
//  ТипКонтента - Строка - поддерживаемый формат документа.
Процедура ПрименитьМаркировкуВсехСтрок(Контент, Модель, ТипКонтента)

	ТипКонтентаУПД = "utd970";

	Для Каждого СтрокаМодели Из Модель.Товары Цикл
		Если ТипКонтента = ТипКонтентаУПД Тогда
			СтрокаКонтента = Контент.Table.Items[СтрокаМодели.Индекс];
			ПрименитьМаркировку(СтрокаКонтента, Модель, СтрокаМодели.Индекс + 1,
				"ItemIdentificationNumbers", "");
		Иначе
			СтрокаКонтента = Контент.InvoiceCorrectionTable.Items[СтрокаМодели.Индекс];
			ПрименитьМаркировку(СтрокаКонтента, Модель, СтрокаМодели.Индекс + 1,
				"OriginalItemIdentificationNumbers", "До");
			ПрименитьМаркировку(СтрокаКонтента, Модель, СтрокаМодели.Индекс + 1,
				"CorrectedItemIdentificationNumbers", "После");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Применяет реквизиты шапки, стороны и связь УПД с документом отгрузки.
//
// Параметры:
//  Контент - Структура - изменяемый контент документа.
//  Модель - Структура - реквизиты шапки и сторон.
//  ТипКонтента - Строка - поддерживаемый формат документа.
Процедура ПрименитьШапкуДокумента(Контент, Модель, ТипКонтента)

	ТипКонтентаУПД = "utd970";
	ИмяРеквизитаГосударственногоКонтракта = "GovernmentContractInfo";

	Если ТипКонтента = ТипКонтентаУПД Тогда
		Контент.Вставить("DocumentNumber", СокрЛП(Модель.НомерДокумента));
		Контент.Вставить("DocumentDate", Модель.ДатаДокумента);
		Контент.Вставить("CircumFormatInvoice", СокрЛП(Модель.ОбстоятельствоФормирования));
		// У СЧФДОП документом отгрузки является сам УПД, в том числе в исправленном УПД.
		// У СЧФ и ДОП ссылки на документы не заменяем реквизитами редактируемой шапки.
		Если Контент.Function = "СЧФДОП" ИЛИ Контент.Function = "InvoiceAndBasic" Тогда
			ДокументОтгрузки = Контент.DocumentShipments[0];
			ДокументОтгрузки.Вставить("Name", СвойствоСтруктуры(Контент, "DocumentName", ""));
			ДокументОтгрузки.Вставить("Number", Контент.DocumentNumber);
			ДокументОтгрузки.Вставить("Date", Контент.DocumentDate);
		КонецЕсли;
	Иначе
		Контент.Вставить("Number", СокрЛП(Модель.НомерДокумента));
		Контент.Вставить("Date", Модель.ДатаДокумента);
		Если ТипКонтента = "ucd29" Тогда
			Контент.Вставить("CircumFormat", СокрЛП(Модель.ОбстоятельствоФормирования));
		КонецЕсли;
	КонецЕсли;
	Контент.Вставить(ИмяРеквизитаГосударственногоКонтракта,
		СокрЛП(Модель.ИдентификаторГосударственногоКонтракта));
	ПрименитьДополнительныеСведенияДокумента(Контент, Модель);
	Если ТипКонтента = ТипКонтентаУПД Тогда
		Грузоотправители = СвойствоСтруктуры(Контент, "Shippers", Новый Массив);
		Для ИндексСтороны = 0 По Грузоотправители.Количество() - 1 Цикл
			Грузоотправитель = Грузоотправители[ИндексСтороны];
			ПрименитьГрузоотправителяУПД(Грузоотправитель,
				Модель.Грузоотправители[ИндексСтороны], Контент.Sellers[0]);
		КонецЦикла;
		ПрименитьРеквизитыСторон(Контент.Sellers, Модель.Продавцы);
		ПрименитьРеквизитыСторон(Контент.Buyers, Модель.Покупатели);
		ПрименитьРеквизитыСторон(СвойствоСтруктуры(Контент, "Consignees", Новый Массив), Модель.Грузополучатели);
	Иначе
		ПрименитьРеквизитыСтороны(Контент.Seller, Модель.Продавцы[0]);
		ПрименитьРеквизитыСтороны(Контент.Buyer, Модель.Покупатели[0]);
	КонецЕсли;

КонецПроцедуры

// Отделяет измененного грузоотправителя от продавца, сохраняя остальные реквизиты стороны.
//
// Параметры:
//  Грузоотправитель - Структура - изменяемые сведения грузоотправителя.
//  СтрокаСтороны - СтрокаТаблицыЗначений - редактируемые реквизиты стороны.
//  ИсходнаяСторона - Структура - продавец до применения изменений.
Процедура ПрименитьГрузоотправителяУПД(Грузоотправитель, СтрокаСтороны, ИсходнаяСторона)

	Если СвойствоСтруктуры(Грузоотправитель, "SameAsSeller", Ложь) Тогда
		// Сравниваем результат общего заполнения, чтобы учитывать все реквизиты стороны.
		Сторона = Новый Структура;
		Для Каждого СвойствоСтороны Из ИсходнаяСторона Цикл
			Сторона.Вставить(СвойствоСтороны.Ключ, СвойствоСтороны.Значение);
		КонецЦикла;
		ПрименитьРеквизитыСтороны(Сторона, СтрокаСтороны);
		Если ЗначениеВСтрокуВнутр(Сторона) <> ЗначениеВСтрокуВнутр(ИсходнаяСторона) Тогда
			Грузоотправитель.Вставить("SameAsSeller", Ложь);
			Грузоотправитель.Вставить("OrganizationInfo", Сторона);
		КонецЕсли;
	Иначе
		ПрименитьРеквизитыСтороны(Грузоотправитель.OrganizationInfo, СтрокаСтороны);
	КонецЕсли;

КонецПроцедуры

// Приводит имена функций API к обозначениям ФНС без изменения неизвестных функций.
//
// Параметры:
//  ФункцияДокумента - Строка - исходное обозначение функции.
//  ЭтоУПД - Булево - вид документа для выбора обозначений ФНС.
//
// Возвращаемое значение:
//  Строка - нормализованное обозначение функции.
Функция НормализованнаяФункцияДокумента(Знач ФункцияДокумента, ЭтоУПД)

	ФункцияДокумента = ВРег(СокрЛП(ФункцияДокумента));
	// Протоконтент может содержать имена функций API вместо обозначений ФНС.
	Если ФункцияДокумента = "INVOICE" Тогда
		ФункцияДокумента = ?(ЭтоУПД, "СЧФ", "КСЧФ");
	ИначеЕсли ФункцияДокумента = "INVOICEANDBASIC" Тогда
		ФункцияДокумента = ?(ЭтоУПД, "СЧФДОП", "КСЧФДИС");
	ИначеЕсли ФункцияДокумента = "BASIC" Тогда
		ФункцияДокумента = ?(ЭтоУПД, "ДОП", "ДИС");
	Иначе
		Возврат ФункцияДокумента;
	КонецЕсли;
	Возврат ФункцияДокумента;

КонецФункции

// Собирает представление адреса ГАР, включая здания и помещения.
//
// Параметры:
//  АдресГАР - Структура - заполненный адрес AddressSAR.
//
// Возвращаемое значение:
//  Строка - части адреса через запятую.
Функция ПредставлениеАдресаГАР(АдресГАР)

	ЧастиАдреса = Новый Массив;
	НачалоАдреса = СоединитьЧастиАдреса(АдресГАР,
		"ZipCode,Region,MunicipalDistrict,Settlement,Locality,PlanningElement,StreetElement,LandPlot");
	ЧастиАдреса.Добавить(НачалоАдреса);
	Для Каждого Здание Из СвойствоСтруктуры(АдресГАР, "Buildings", Новый Массив) Цикл
		ТипЗдания = СвойствоСтруктуры(Здание, "Type", "");
		НомерЗдания = СвойствоСтруктуры(Здание, "Number", "");
		ПредставлениеЗдания = СокрЛП(ТипЗдания + " " + НомерЗдания);
		ЧастиАдреса.Добавить(ПредставлениеЗдания);
	КонецЦикла;
	Для Каждого Пара Из Новый Структура("House,Apartment", "HouseType", "ApartmentType") Цикл
		Если ЗначениеЗаполнено(СвойствоСтруктуры(АдресГАР, Пара.Ключ, "")) Тогда
			ТипПомещения = СвойствоСтруктуры(АдресГАР, Пара.Значение, "");
			ПредставлениеПомещения = СокрЛП(ТипПомещения + " " + АдресГАР[Пара.Ключ]);
			ЧастиАдреса.Добавить(ПредставлениеПомещения);
		КонецЕсли;
	КонецЦикла;
	Возврат СтдСтр().СтрСоединитьЛок(ЧастиАдреса, ", ");

КонецФункции

// Формирует ссылку добавления пустых сведений или представление заполненной коллекции.
//
// Параметры:
//  Количество - Число - количество сведений товарной строки.
//  ТекстДобавления - Строка - ссылка при отсутствии сведений.
//  ШаблонЗаполненных - Строка - представление с подстановкой количества.
//
// Возвращаемое значение:
//  Строка - текст ссылки на редактор сведений.
Функция ПредставлениеСведенийСтроки(Количество, ТекстДобавления, ШаблонЗаполненных)

	Если Количество = 0 Тогда
		Возврат ТекстДобавления;
	КонецЕсли;
	Возврат СтдСтр().СтрШаблонЛок(ШаблонЗаполненных, Количество);

КонецФункции

Процедура УвеличитьСчетчик(Счетчики, Ключ)

	ТекущееЗначение = Счетчики.Получить(Ключ);
	Счетчики.Вставить(Ключ, ?(ТекущееЗначение = Неопределено, 1, ТекущееЗначение + 1));

КонецПроцедуры

Функция ЗначениеСчетчика(Счетчики, Ключ)

	Результат = Счетчики.Получить(Ключ);
	Возврат ?(Результат = Неопределено, 0, Результат);

КонецФункции

Процедура ПроверитьПоддерживаемыйДокумент(Документ)

	Если Не ЭтоПоддерживаемыйДокумент(Документ) Тогда
		ВызватьИсключение "Редактор поддерживает УПД ФНС 970 и УКД ФНС 29 и 736.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьМодель(Документ, Модель)

	Если ТипЗнч(Модель) <> Тип("Структура")
		Или Не ЗначениеЗаполнено(СвойствоСтруктуры(Модель, "НомерДокумента"))
		Или Не ЗначениеЗаполнено(СвойствоСтруктуры(Модель, "ДатаДокумента")) Тогда
		ВызватьИсключение "Номер и дата документа должны быть заполнены.";
	КонецЕсли;

	ИсходнаяМодель = МодельРедактирования(Документ);
	Если СвойствоСтруктуры(Модель, "ФункцияДокумента") <> ИсходнаяМодель.ФункцияДокумента Тогда
		ВызватьИсключение "Изменение функции документа в редакторе не поддерживается. Откройте документ заново.";
	КонецЕсли;
	ПроверитьДокументОтгрузкиМодели(Документ, ИсходнаяМодель);
	ПроверитьСтороныМодели(Модель, ИсходнаяМодель);

	ТипКонтента = НРег(Документ.Тип.ТипКонтента);
	ТаблицаКонтента = ?(ТипКонтента = "utd970", Документ.СлужебнаяИнформация.Контент.Table,
		Документ.СлужебнаяИнформация.Контент.InvoiceCorrectionTable);
	Товары = СвойствоСтруктуры(Модель, "Товары");
	Если ТипЗнч(Товары) <> Тип("ТаблицаЗначений")
		ИЛИ Товары.Количество() <> ТаблицаКонтента.Items.Количество() Тогда
		ВызватьИсключение "Состав строк документа изменен. В прототипе добавление и удаление строк не поддерживается.";
	КонецЕсли;

	ПроверитьТоварныеСтрокиМодели(Товары);

	ПроверитьПрослеживаемость(Модель.Прослеживаемость, Товары.Количество(), ТипКонтента);
	ПроверитьДекларации(Модель.Декларации, Товары.Количество(), ТипКонтента);
	ПроверитьИнформационныеПоля(Модель.ДополнительныеСведенияДокумента, 0, ТипКонтента);
	ПроверитьИнформационныеПоля(Модель.ДополнительныеСведенияТоваров, Товары.Количество(), ТипКонтента);
	ПроверитьДополнительныеСведенияДокумента(Модель, ТипКонтента);
	ПроверитьМаркировку(Модель.ГруппыМаркировки, Модель.КодыМаркировки, Товары.Количество(), ТипКонтента);

КонецПроцедуры

// Проверяет связь СЧФДОП с единственным документом отгрузки.
//
// Параметры:
//  Документ - Структура - исходный документ.
//  ИсходнаяМодель - Структура - модель исходного документа.
Процедура ПроверитьДокументОтгрузкиМодели(Документ, ИсходнаяМодель)

	Если ИсходнаяМодель.ТипКонтента = "utd970"
		И (ИсходнаяМодель.ФункцияДокумента = "СЧФДОП"
		Или ИсходнаяМодель.ФункцияДокумента = "InvoiceAndBasic") Тогда
		ДокументыОтгрузки = СвойствоСтруктуры(Документ.СлужебнаяИнформация.Контент, "DocumentShipments");
		Если ТипЗнч(ДокументыОтгрузки) <> Тип("Массив") Тогда
			ВызватьИсключение "Для СЧФДОП должен быть заполнен один документ отгрузки с реквизитами самого УПД.";
		КонецЕсли;
		Если ДокументыОтгрузки.Количество() <> 1 Тогда
			ВызватьИсключение "Для СЧФДОП должен быть заполнен ровно один документ отгрузки. Проверьте исходный документ.";
		КонецЕсли;
		Если ТипЗнч(ДокументыОтгрузки[0]) <> Тип("Структура") Тогда
			ВызватьИсключение "Некорректный документ отгрузки СЧФДОП. Проверьте исходный документ.";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Проверяет неизменность состава сторон и измененные адреса.
//
// Параметры:
//  Модель - Структура - редактируемые стороны.
//  ИсходнаяМодель - Структура - исходные стороны.
Процедура ПроверитьСтороныМодели(Модель, ИсходнаяМодель)

	Для Каждого ИмяСторон Из СтдСтр().СтрРазделитьЛок("Продавцы,Покупатели,Грузоотправители,Грузополучатели", ",") Цикл
		Стороны = СвойствоСтруктуры(Модель, ИмяСторон);
		Если ТипЗнч(Стороны) <> Тип("ТаблицаЗначений")
			Или Стороны.Количество() <> ИсходнаяМодель[ИмяСторон].Количество() Тогда
			ВызватьИсключение "Состав сторон документа изменился. Откройте редактор заново.";
		КонецЕсли;
		Для ИндексСтороны = 0 По Стороны.Количество() - 1 Цикл
			Сторона = Стороны[ИндексСтороны];
			ИсходнаяСторона = ИсходнаяМодель[ИмяСторон][ИндексСтороны];
			Если Сторона.ОГРНИП <> ИсходнаяСторона.ОГРНИП
				ИЛИ Сторона.ДатаОГРНИП <> ИсходнаяСторона.ДатаОГРНИП Тогда
				ПроверитьДанныеСтроки("Сторона", Модель.ТипКонтента, Сторона);
			КонецЕсли;
			Если Стороны[ИндексСтороны].ДанныеАдреса <> ИсходнаяМодель[ИмяСторон][ИндексСтороны].ДанныеАдреса Тогда
				АдресДляПроверки = ЗначениеИзСтрокиВнутр(Стороны[ИндексСтороны].ДанныеАдреса);
				АдресИзМодели(МодельАдреса(АдресДляПроверки), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Проверяет индексы и реквизиты товарных строк перед применением.
//
// Параметры:
//  Товары - ТаблицаЗначений - товарные строки модели.
Процедура ПроверитьТоварныеСтрокиМодели(Товары)

	ДлинаНаименованияТовара = 2000;
	МинимальнаяДлинаКодаЕдиницы = 3;
	МаксимальнаяДлинаКодаЕдиницы = 4;
	ДлинаНаименованияЕдиницы = 255;

	ИндексыТоваров = Новый Соответствие;
	Для Каждого СтрокаМодели Из Товары Цикл
		ПроверитьИндексТоварнойСтроки(СтрокаМодели, Товары.Количество(), ИндексыТоваров);
		Если Не ЗначениеЗаполнено(СтрокаМодели.Наименование) Тогда
			ВызватьИсключение "Наименование товара или услуги должно быть заполнено.";
		КонецЕсли;
		Если СтрокаМодели.Количество < 0 Или СтрокаМодели.Цена < 0 Или СтрокаМодели.СуммаНДС < 0 Тогда
			ВызватьИсключение "Количество, цена и сумма НДС не могут быть отрицательными.";
		КонецЕсли;
		Если СтрДлина(СокрЛП(СтрокаМодели.Наименование)) > ДлинаНаименованияТовара Тогда
			ВызватьИсключение "Наименование товара или услуги не может быть длиннее 2000 символов.";
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаМодели.КодЕдиницы)
			И (СтрДлина(СокрЛП(СтрокаМодели.КодЕдиницы)) < МинимальнаяДлинаКодаЕдиницы
			ИЛИ СтрДлина(СокрЛП(СтрокаМодели.КодЕдиницы)) > МаксимальнаяДлинаКодаЕдиницы) Тогда
			ВызватьИсключение "Код единицы измерения должен содержать 3 или 4 символа.";
		КонецЕсли;
		Если СтрДлина(СокрЛП(СтрокаМодели.Единица)) > ДлинаНаименованияЕдиницы Тогда
			ВызватьИсключение "Наименование единицы измерения не может быть длиннее 255 символов.";
		КонецЕсли;
		ПроверитьСтавкуНДС(СтрокаМодели.СтавкаНДС);
	КонецЦикла;

КонецПроцедуры

// Проверяет границы и уникальность индекса, затем регистрирует его в проверенном наборе.
//
// Параметры:
//  СтрокаМодели - СтрокаТаблицыЗначений - товарная строка модели.
//  КоличествоТоваров - Число - число исходных товарных строк.
//  ИндексыТоваров - Соответствие - уже проверенные индексы.
Процедура ПроверитьИндексТоварнойСтроки(СтрокаМодели, КоличествоТоваров, ИндексыТоваров)

	Если СтрокаМодели.Индекс < 0 ИЛИ СтрокаМодели.Индекс >= КоличествоТоваров Тогда
		ВызватьИсключение "В модели указан неверный индекс товарной строки.";
	КонецЕсли;
	Если ИндексыТоваров.Получить(СтрокаМодели.Индекс) <> Неопределено Тогда
		ВызватьИсключение "Индексы товарных строк модели должны быть уникальными.";
	КонецЕсли;
	ИндексыТоваров.Вставить(СтрокаМодели.Индекс, Истина);

КонецПроцедуры

Процедура ПроверитьИнформационныеПоля(Таблица, КоличествоТоваров, ТипКонтента)

	МаксимальнаяДлинаЗначения = 2000;

	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "Не переданы информационные поля.";
	КонецЕсли;
	МаксимальнаяДлинаКлюча = ?(ТипКонтента = "utd970", 50, 100);
	Для Каждого Строка Из Таблица Цикл
		Если КоличествоТоваров > 0
			И (Строка.НомерСтроки < 1 Или Строка.НомерСтроки > КоличествоТоваров) Тогда
			ВызватьИсключение "В дополнительных сведениях указан неверный номер товарной строки.";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.Ключ) Или Не ЗначениеЗаполнено(Строка.Значение) Тогда
			ВызватьИсключение "В информационном поле должны быть заполнены ключ и значение.";
		КонецЕсли;
		Если СтрДлина(СокрЛП(Строка.Ключ)) > МаксимальнаяДлинаКлюча
			ИЛИ СтрДлина(СокрЛП(Строка.Значение)) > МаксимальнаяДлинаЗначения Тогда
			ВызватьИсключение "Длина ключа или значения информационного поля превышает ограничение формата.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьДополнительныеСведенияДокумента(Модель, ТипКонтента)

	МинимальнаяДлинаКонтракта = 20;
	МаксимальнаяДлинаКонтракта = 25;
	ДлинаКодаОбстоятельства = 5;

	Если ЗначениеЗаполнено(Модель.ИдентификаторГосударственногоКонтракта)
		И (СтрДлина(СокрЛП(Модель.ИдентификаторГосударственногоКонтракта)) < МинимальнаяДлинаКонтракта
		ИЛИ СтрДлина(СокрЛП(Модель.ИдентификаторГосударственногоКонтракта)) > МаксимальнаяДлинаКонтракта) Тогда
		ВызватьИсключение "Идентификатор государственного контракта должен содержать от 20 до 25 символов.";
	КонецЕсли;
	Обстоятельство = СокрЛП(Модель.ОбстоятельствоФормирования);
	Если Не ЗначениеЗаполнено(Обстоятельство) Тогда
		Возврат;
	КонецЕсли;
	НастройкаОбстоятельства = НастройкаОбстоятельстваФормирования(
		ТипКонтента, Модель.ФункцияДокумента);
	Если НастройкаОбстоятельства.ТолькоВыбор Тогда
		Если НастройкаОбстоятельства.ДопустимыеЗначения.Найти(Обстоятельство) = Неопределено Тогда
			ВызватьИсключение "Недопустимое специальное обстоятельство формирования.";
		КонецЕсли;
	Иначе
		Если СтрДлина(Обстоятельство) <> ДлинаКодаОбстоятельства Тогда
			ВызватьИсключение "Код специального обстоятельства должен содержать 5 символов.";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПрослеживаемость(Прослеживаемость, КоличествоТоваров, ТипКонтента)

	Если ТипЗнч(Прослеживаемость) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "Не передана таблица прослеживаемости.";
	КонецЕсли;

	Для Каждого Строка Из Прослеживаемость Цикл
		Если Строка.НомерСтроки < 1
			Или КоличествоТоваров > 0 И Строка.НомерСтроки > КоличествоТоваров Тогда
			ВызватьИсключение "В прослеживаемости указан неверный номер товарной строки.";
		КонецЕсли;
		ПроверитьРеквизитыПрослеживаемости(Строка);
		ПроверитьКоличествоИСтоимостьПрослеживаемости(Строка, ТипКонтента);
	КонецЦикла;

КонецПроцедуры

// Проверяет РНПТ, единицу измерения и дополнительные сведения.
//
// Параметры:
//  Строка - СтрокаТаблицыЗначений - сведения о прослеживаемом товаре.
Процедура ПроверитьРеквизитыПрослеживаемости(Строка)

	МинимальнаяДлинаРНПТ = 25;
	МаксимальнаяДлинаРНПТ = 29;
	МинимальнаяДлинаКодаЕдиницы = 3;
	МаксимальнаяДлинаКодаЕдиницы = 4;
	МаксимальнаяДлинаКраткогоТекста = 255;

	Если НЕ ЗначениеЗаполнено(Строка.РегистрационныйНомер) Тогда
		ВызватьИсключение "Регистрационный номер партии прослеживаемого товара должен быть заполнен.";
	КонецЕсли;
	Если СтрДлина(СокрЛП(Строка.РегистрационныйНомер)) < МинимальнаяДлинаРНПТ
		ИЛИ СтрДлина(СокрЛП(Строка.РегистрационныйНомер)) > МаксимальнаяДлинаРНПТ Тогда
		ВызватьИсключение "РНПТ должен содержать от 25 до 29 символов.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Строка.КодЕдиницы) ИЛИ НЕ ЗначениеЗаполнено(Строка.Единица) Тогда
		ВызватьИсключение "Для прослеживаемого товара должны быть заполнены код и наименование единицы измерения.";
	КонецЕсли;
	Если СтрДлина(СокрЛП(Строка.КодЕдиницы)) < МинимальнаяДлинаКодаЕдиницы
		ИЛИ СтрДлина(СокрЛП(Строка.КодЕдиницы)) > МаксимальнаяДлинаКодаЕдиницы Тогда
		ВызватьИсключение "Код единицы измерения прослеживаемого товара должен содержать 3 или 4 символа.";
	КонецЕсли;
	Если СтрДлина(СокрЛП(Строка.Единица)) > МаксимальнаяДлинаКраткогоТекста Тогда
		ВызватьИсключение "Наименование единицы измерения прослеживаемого товара не может быть длиннее 255 символов.";
	КонецЕсли;
	Если СтрДлина(СокрЛП(Строка.ДополнительныеСведения)) > МаксимальнаяДлинаКраткогоТекста Тогда
		ВызватьИсключение "Дополнительные сведения о прослеживаемости не могут быть длиннее 255 символов.";
	КонецЕсли;

КонецПроцедуры

// Проверяет допустимые количества и стоимость до и после изменения.
//
// Параметры:
//  Строка - СтрокаТаблицыЗначений - сведения о прослеживаемом товаре.
//  ТипКонтента - Строка - формат документа.
Процедура ПроверитьКоличествоИСтоимостьПрослеживаемости(Строка, ТипКонтента)

	Если ТипКонтента = "utd970" И Строка.Количество <= 0 Тогда
		ВызватьИсключение "Количество прослеживаемого товара в УПД должно быть больше нуля.";
	КонецЕсли;
	ЕстьОтрицательныеПоказатели = Строка.Количество < 0 ИЛИ Строка.СтоимостьБезНДС < 0
		ИЛИ Строка.КоличествоДо < 0 ИЛИ Строка.СтоимостьБезНДСДо < 0;
	Если ЕстьОтрицательныеПоказатели Тогда
		ВызватьИсключение "Количество и стоимость прослеживаемого товара не могут быть отрицательными.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьДекларации(Декларации, КоличествоТоваров, ТипКонтента, СтраныМира = Неопределено)

	Если ТипЗнч(Декларации) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "Не передана таблица деклараций на товары.";
	КонецЕсли;

	СтраныТоварныхСтрок = Новый Соответствие;
	Для Каждого Строка Из Декларации Цикл
		Если Строка.НомерСтроки < 1
			Или КоличествоТоваров > 0 И Строка.НомерСтроки > КоличествоТоваров Тогда
			ВызватьИсключение "В декларациях указан неверный номер товарной строки.";
		КонецЕсли;
		ПроверитьРеквизитыДекларации(Строка, СтраныМира);
		ПроверитьПравилаДекларацииПоФормату(Строка, ТипКонтента, СтраныТоварныхСтрок);

	КонецЦикла;

КонецПроцедуры

// Проверяет обязательность декларации и единую страну товарной строки по формату документа.
//
// Параметры:
//  Строка - СтрокаТаблицыЗначений - проверяемая декларация.
//  ТипКонтента - Строка - формат документа.
//  СтраныТоварныхСтрок - Соответствие - уже проверенные наименования стран товарных строк.
Процедура ПроверитьПравилаДекларацииПоФормату(Строка, ТипКонтента, СтраныТоварныхСтрок)

	Если ТипКонтента = "utd970" Тогда
		Если НЕ ЗначениеЗаполнено(Строка.КодСтраны) Тогда
			ВызватьИсключение "Для декларации УПД заполните код страны происхождения.";
		КонецЕсли;
		НаименованиеСтраны = СокрЛП(Строка.НаименованияСтран);
		Если ЗначениеЗаполнено(НаименованиеСтраны) Тогда
			НаименованиеСтраныСтроки = СтраныТоварныхСтрок.Получить(Строка.НомерСтроки);
			Если НаименованиеСтраныСтроки = Неопределено Тогда
				СтраныТоварныхСтрок.Вставить(Строка.НомерСтроки, НаименованиеСтраны);
			Иначе
				Если НРег(НаименованиеСтраныСтроки) <> НРег(НаименованиеСтраны) Тогда
					ВызватьИсключение
					"Для всех деклараций одной товарной строки УПД укажите одно наименование страны.";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ДекларацияНеЗаполнена = НЕ ЗначениеЗаполнено(Строка.КодСтраны)
		И НЕ ЗначениеЗаполнено(Строка.НомерДТДо)
		И НЕ ЗначениеЗаполнено(Строка.НомерДТПосле)
		И НЕ ЗначениеЗаполнено(Строка.НомераДТУвеличение)
		И НЕ ЗначениеЗаполнено(Строка.НомераДТУменьшение);
	Если ДекларацияНеЗаполнена Тогда
		ВызватьИсключение "Заполните сведения декларации УКД.";
	КонецЕсли;
КонецПроцедуры

// Проверяет код ОКСМ и длину номеров деклараций до и после изменения.
//
// Параметры:
//  Строка - СтрокаТаблицыЗначений - редактируемая декларация.
//  СтраныМира - ТаблицаЗначений, Неопределено - доступные страны ОКСМ.
Процедура ПроверитьРеквизитыДекларации(Строка, СтраныМира)

	ДлинаКодаСтраны = 3;

	Если ЗначениеЗаполнено(Строка.КодСтраны)
		И СтрДлина(СокрЛП(Строка.КодСтраны)) <> ДлинаКодаСтраны Тогда
		ВызватьИсключение "Код страны происхождения должен содержать три символа.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Строка.КодСтраны)
		И СтраныМира <> Неопределено
		И НЕ ЕстьСтранаСКодом(СтраныМира, Строка.КодСтраны) Тогда
		ВызватьИсключение СтдСтр().СтрШаблонЛок(
			"Код страны %1 отсутствует в ОКСМ.", СокрЛП(Строка.КодСтраны));
	КонецЕсли;
	ПроверитьДлинуНомеровДТ(Строка.НомерДТ);
	ПроверитьДлинуНомеровДТ(Строка.НомерДТДо);
	ПроверитьДлинуНомеровДТ(Строка.НомерДТПосле);
	ПроверитьДлинуНомеровДТ(Строка.НомераДТУвеличение);
	ПроверитьДлинуНомеровДТ(Строка.НомераДТУменьшение);

КонецПроцедуры

Процедура ПроверитьДлинуНомеровДТ(ТекстНомеров)

	МаксимальнаяДлинаНомераДТ = 29;

	Для Каждого НомерДТ Из СтдСтр().СтрРазделитьЛок(СтрЗаменить(ТекстНомеров, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Если СтрДлина(СокрЛП(НомерДТ)) > МаксимальнаяДлинаНомераДТ Тогда
			ВызватьИсключение "Номер декларации на товары не может быть длиннее 29 символов.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЕстьСтранаСКодом(СтраныМира, КодСтраны)

	Если ТипЗнч(СтраныМира) <> Тип("Массив")
		И ТипЗнч(СтраныМира) <> Тип("ТаблицаЗначений") Тогда
		Возврат Ложь;
	КонецЕсли;
	ИскомыйКод = СокрЛП(КодСтраны);
	Для Каждого Страна Из СтраныМира Цикл
		Если СокрЛП(Страна.Код) = ИскомыйКод Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ПроверитьМаркировку(Группы, Коды, КоличествоТоваров, ТипКонтента)

	Если ТипЗнч(Группы) <> Тип("ТаблицаЗначений") Или ТипЗнч(Коды) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "Не переданы таблицы маркировки.";
	КонецЕсли;

	НомераГрупп = Новый Соответствие;
	ПартииУКД736 = Новый Соответствие;
	Для Каждого Группа Из Группы Цикл
		Если Группа.НомерСтроки < 1
			Или КоличествоТоваров > 0 И Группа.НомерСтроки > КоличествоТоваров Тогда
			ВызватьИсключение "В маркировке указан неверный номер товарной строки.";
		КонецЕсли;
		Если Группа.НомерГруппы < 1 Или НомераГрупп.Получить(Группа.НомерГруппы) <> Неопределено Тогда
			ВызватьИсключение "Номера групп маркировки должны быть положительными и уникальными.";
		КонецЕсли;
		НомераГрупп.Вставить(Группа.НомерГруппы, Истина);
		ЕстьКИЗГруппы = Коды.НайтиСтроки(
			Новый Структура("НомерГруппы,ВидКода", Группа.НомерГруппы, "КИЗ")).Количество() > 0;
		ЕстьУпаковкиГруппы = Коды.НайтиСтроки(
			Новый Структура("НомерГруппы,ВидКода", Группа.НомерГруппы, "Упаковка")).Количество() > 0;
		ОписаниеСтроки = ОписаниеСтрокиМаркировки(
			Группа, ЕстьКИЗГруппы, ЕстьУпаковкиГруппы, ТипКонтента);
		ПроверитьОбязательныеПоляГруппыМаркировки(Группа, ЕстьКИЗГруппы, ЕстьУпаковкиГруппы, ОписаниеСтроки);
		ПроверитьКоличественныеПоляМаркировки(Группа, ОписаниеСтроки, ТипКонтента);
		ПроверитьИдентификаторыГруппыМаркировки(Группа, ЕстьКИЗГруппы, ОписаниеСтроки, ТипКонтента);
		ПроверитьПартиюУКД736(Группа, ТипКонтента, ПартииУКД736, ОписаниеСтроки);
	КонецЦикла;

	ПроверитьКодыМаркировки(Группы, Коды, НомераГрупп, ТипКонтента);
	ПроверитьПустыеГруппыМаркировки(Группы, Коды, ТипКонтента);

КонецПроцедуры

Процедура ПроверитьПартиюУКД736(Группа, ТипКонтента, ПартииУКД736, ОписаниеСтроки)

	Если ТипКонтента <> "ucd736" Или Не ЗначениеЗаполнено(Группа.КодПартии) Тогда
		Возврат;
	КонецЕсли;
	КлючПартии = Строка(Группа.НомерСтроки) + "|" + Группа.Состояние;
	НомерПартии = СокрЛП(Группа.КодПартии);
	Если ПартииУКД736.Получить(КлючПартии) <> Неопределено
		И ПартииУКД736.Получить(КлючПартии) <> НомерПартии Тогда
		ВызватьИсключение ОписаниеСтроки
			+ " для УКД 736 можно указать не более одной партии в каждом разделе товарной строки.";
	КонецЕсли;
	ПартииУКД736.Вставить(КлючПартии, НомерПартии);

КонецПроцедуры

// Проверяет обязательные реквизиты выбранного вида учета.
//
// Параметры:
//  Группа - СтрокаТаблицыЗначений - строка учета маркировки.
//  ЕстьКИЗГруппы - Булево - в группе есть КИЗ.
//  ЕстьУпаковкиГруппы - Булево - в группе есть исходные коды упаковок.
//  ОписаниеСтроки - Строка - понятное пользователю обозначение строки.
Процедура ПроверитьОбязательныеПоляГруппыМаркировки(Группа, ЕстьКИЗГруппы, ЕстьУпаковкиГруппы, ОписаниеСтроки)

	Если Группа.ВидУчета = "Партионный учет" И Не ЗначениеЗаполнено(Группа.КодПартии) Тогда
		ВызватьИсключение ОписаниеСтроки + " заполните поле ""Номер партии"" для партионного учета.";
	КонецЕсли;
	НеЗаполненОбязательныйГТИН = (Группа.ВидУчета = "Партионный учет" ИЛИ Группа.ВидУчета = "ОСУ"
		Или Не ЕстьКИЗГруппы И Не ЕстьУпаковкиГруппы
		И (ЗначениеЗаполнено(Группа.КоличествоМаркированныхТоваров)
		Или ЗначениеЗаполнено(Группа.ВесМаркированныхТоваров)))
		И НЕ ЗначениеЗаполнено(Группа.GTIN);
	Если НеЗаполненОбязательныйГТИН Тогда
		ВызватьИсключение ОписаниеСтроки + " заполните поле ""ГТИН"".";
	КонецЕсли;

КонецПроцедуры

// Проверяет границы количества упаковок и веса, не изменяя данные.
//
// Параметры:
//  Группа - СтрокаТаблицыЗначений - строка учета маркировки.
//  ОписаниеСтроки - Строка - понятное пользователю обозначение строки.
//  ТипКонтента - Строка - формат документа.
Процедура ПроверитьКоличественныеПоляМаркировки(Группа, ОписаниеСтроки, ТипКонтента)

	МаксимальноеКоличествоУпаковок = 99999999;
	МаксимальныйВесВКилограммах = ?(ТипКонтента = "ucd29", 9999999999999999.999, 999999.999);

	Если Группа.КоличествоМаркированныхТоваров > МаксимальноеКоличествоУпаковок Тогда
		ВызватьИсключение ОписаниеСтроки + " поле ""Количество упаковок"" не может быть больше 99999999.";
	КонецЕсли;
	Если Группа.ВесМаркированныхТоваров > МаксимальныйВесВКилограммах Тогда
		ВызватьИсключение ОписаниеСтроки + " поле ""Вес (кг)"" не может быть больше "
			+ ?(ТипКонтента = "ucd29", "9999999999999999,999", "999999,999") + ".";
	КонецЕсли;
	Если Группа.КоличествоМаркированныхТоваров < 0 Тогда
		ВызватьИсключение ОписаниеСтроки + " поле ""Количество упаковок"" не может быть отрицательным.";
	КонецЕсли;
	Если Группа.ВесМаркированныхТоваров < 0 Тогда
		ВызватьИсключение ОписаниеСтроки + " поле ""Вес"" не может быть отрицательным.";
	КонецЕсли;
	Если Группа.КоличествоМаркированныхТоваров <> Цел(Группа.КоличествоМаркированныхТоваров) Тогда
		ВызватьИсключение ОписаниеСтроки + " поле ""Количество упаковок"" должно быть целым числом.";
	КонецЕсли;

КонецПроцедуры

// Проверяет длины идентификаторов, связь партии с кодом и состояние УКД.
//
// Параметры:
//  Группа - СтрокаТаблицыЗначений - строка учета маркировки.
//  ЕстьКИЗГруппы - Булево - в группе есть КИЗ.
//  ОписаниеСтроки - Строка - понятное пользователю обозначение строки.
//  ТипКонтента - Строка - формат УПД или УКД.
Процедура ПроверитьИдентификаторыГруппыМаркировки(Группа, ЕстьКИЗГруппы, ОписаниеСтроки, ТипКонтента)

	ДлинаТранспортнойУпаковки = 255;
	МинимальнаяДлинаНомераПартии = 21;
	МаксимальнаяДлинаНомераПартии = 32;
	ДлинаГТИН = 14;

	Если СтрДлина(СокрЛП(Группа.ТранспортнаяУпаковка)) > ДлинаТранспортнойУпаковки Тогда
		ВызватьИсключение ОписаниеСтроки
			+ " идентификатор транспортной упаковки не может быть длиннее 255 символов.";
	КонецЕсли;
	ДлинаНомераПартии = СтрДлина(СокрЛП(Группа.КодПартии));
	Если ДлинаНомераПартии > 0
		И (ДлинаНомераПартии < МинимальнаяДлинаНомераПартии
		Или ДлинаНомераПартии > МаксимальнаяДлинаНомераПартии) Тогда
		ВызватьИсключение ОписаниеСтроки
			+ " поле ""Номер партии"" должно содержать от 21 до 32 символов.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Группа.КодПартии)
		И Не ЗначениеЗаполнено(Группа.GTIN)
		И Не ЕстьКИЗГруппы Тогда
		ВызватьИсключение ОписаниеСтроки
			+ " заполните поле ""ГТИН"" или выберите вид учета ""ПЭУ (КИЗ)"" и укажите код маркировки.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Группа.GTIN)
		И (СтрДлина(СокрЛП(Группа.GTIN)) <> ДлинаГТИН
		Или Не СтрокаСодержитТолькоЦифры(СокрЛП(Группа.GTIN))) Тогда
		ВызватьИсключение ОписаниеСтроки + " поле ""ГТИН"" должно содержать ровно 14 цифр.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Группа.GTIN)
		И Группа.КоличествоМаркированныхТоваров <= 0 Тогда
		ВызватьИсключение ОписаниеСтроки
			+ " заполните поле ""Количество упаковок"" значением больше нуля.";
	КонецЕсли;
	Если ТипКонтента <> "utd970"
		И Группа.Состояние <> "До" И Группа.Состояние <> "После" Тогда
		ВызватьИсключение ОписаниеСтроки + " выберите раздел ""До изменения"" или ""После изменения"".";
	КонецЕсли;

КонецПроцедуры

// Проверяет существование группы и заполнение каждого кода.
//
// Параметры:
//  Группы - ТаблицаЗначений - группы учета маркировки.
//  Коды - ТаблицаЗначений - коды КИЗ и упаковок.
//  НомераГрупп - Соответствие - номера проверенных групп.
//  ТипКонтента - Строка - формат УПД или УКД.
Процедура ПроверитьКодыМаркировки(Группы, Коды, НомераГрупп, ТипКонтента)

	МаксимальнаяДлинаКода = 255;

	Для Каждого Код Из Коды Цикл
		Если НомераГрупп.Получить(Код.НомерГруппы) = Неопределено Тогда
			ВызватьИсключение "Для кода маркировки указана несуществующая группа.";
		КонецЕсли;
		Если Код.ВидКода <> "КИЗ" И Код.ВидКода <> "Упаковка" Тогда
			ВызватьИсключение "Вид кода маркировки должен иметь значение КИЗ или Упаковка.";
		КонецЕсли;
		ГруппаКода = Группы.Найти(Код.НомерГруппы, "НомерГруппы");
		ОписаниеКода = ОписаниеСтрокиМаркировки(
			ГруппаКода, Код.ВидКода = "КИЗ", Код.ВидКода = "Упаковка", ТипКонтента);
		Если Не ЗначениеЗаполнено(Код.Код) Тогда
			ВызватьИсключение ОписаниеКода + " заполните поле ""ГТИН / код маркировки"".";
		КонецЕсли;
		Если СтрДлина(СокрЛП(Код.Код)) > МаксимальнаяДлинаКода Тогда
			ВызватьИсключение ОписаниеКода
				+ " поле ""ГТИН / код маркировки"" не может быть длиннее 255 символов.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Отклоняет пустые строки учета после проверки отдельных кодов.
//
// Параметры:
//  Группы - ТаблицаЗначений - группы учета маркировки.
//  Коды - ТаблицаЗначений - коды КИЗ и упаковок.
//  ТипКонтента - Строка - формат УПД или УКД.
Процедура ПроверитьПустыеГруппыМаркировки(Группы, Коды, ТипКонтента)

	Для Каждого Группа Из Группы Цикл
		ЕстьКоды = Коды.НайтиСтроки(Новый Структура("НомерГруппы", Группа.НомерГруппы)).Количество() > 0;
		ГруппаНеЗаполнена = НЕ ЕстьКоды И НЕ ЗначениеЗаполнено(Группа.ТранспортнаяУпаковка)
			И Не ЗначениеЗаполнено(Группа.КоличествоМаркированныхТоваров)
			И Не ЗначениеЗаполнено(Группа.GTIN)
			И Не ЗначениеЗаполнено(Группа.ВесМаркированныхТоваров)
			И НЕ ЗначениеЗаполнено(Группа.КодПартии);
		Если ГруппаНеЗаполнена Тогда
			ВызватьИсключение ОписаниеСтрокиМаркировки(Группа, Ложь, Ложь, ТипКонтента)
				+ " заполните поля, предусмотренные выбранным видом учета, или удалите пустую строку.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОписаниеСтрокиМаркировки(Группа, ЕстьКИЗ, ЕстьУпаковка, ТипКонтента)

	Если ЗначениеЗаполнено(Группа.ВидУчета) Тогда
		ВидУчета = Группа.ВидУчета;
	ИначеЕсли ЗначениеЗаполнено(Группа.GTIN) Тогда
		ВидУчета = ?(ЗначениеЗаполнено(Группа.КодПартии), "Партионный учет", "ОСУ");
	ИначеЕсли ЕстьКИЗ Тогда
		ВидУчета = "ПЭУ (КИЗ)";
	ИначеЕсли ЕстьУпаковка Тогда
		ВидУчета = "ОСУ";
	ИначеЕсли ЗначениеЗаполнено(Группа.КодПартии)
		Или ЗначениеЗаполнено(Группа.ВесМаркированныхТоваров) Тогда
		ВидУчета = "Партионный учет";
	Иначе
		ВидУчета = "не определен";
	КонецЕсли;
	Результат = "Строка товара " + Строка(Группа.НомерСтроки);
	Если НРег(ТипКонтента) <> "utd970" И ЗначениеЗаполнено(Группа.Состояние) Тогда
		Результат = Результат + ", раздел """ + Группа.Состояние + " изменения""";
	КонецЕсли;
	Возврат Результат + ", вид учета """ + ВидУчета + """:";

КонецФункции

Функция НоваяТаблицаТоваров()

	// BSLLS:MagicNumber-off
	// BSLLS:NestedFunctionInParameters-off

	ИмяТипаЧисла = "Число";
	ИмяТипаСтроки = "Строка";

	ТипПризнака = Новый ОписаниеТипов("Булево");
	ТипКодаЕдиницы = Новый ОписаниеТипов(ИмяТипаСтроки, Новый КвалификаторыСтроки(4));
	ТипНаименованияЕдиницы = Новый ОписаниеТипов(ИмяТипаСтроки, Новый КвалификаторыСтроки(255));
	ТипКоличестваИЦены = Новый ОписаниеТипов(ИмяТипаЧисла, Новый КвалификаторыЧисла(26,
		11));
	ТипСтавкиНДС = Новый ОписаниеТипов(ИмяТипаСтроки, Новый КвалификаторыСтроки(50));
	ТипСуммыДоИРазницы = Новый ОписаниеТипов(ИмяТипаЧисла, Новый КвалификаторыЧисла(19, 2));
	ТипСуммыПосле = Новый ОписаниеТипов(ИмяТипаЧисла, Новый КвалификаторыЧисла(20, 2));
	ТипПредставленияСсылки = Новый ОписаниеТипов(ИмяТипаСтроки, Новый КвалификаторыСтроки(100));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Индекс", Новый ОписаниеТипов(ИмяТипаЧисла,
		Новый КвалификаторыЧисла(10, 0)));
	Результат.Колонки.Добавить("ИсходныйНомер", Новый ОписаниеТипов(ИмяТипаЧисла,
		Новый КвалификаторыЧисла(6, 0)));
	Результат.Колонки.Добавить("ЭтоУслуга", ТипПризнака);
	Результат.Колонки.Добавить("Наименование", Новый ОписаниеТипов(ИмяТипаСтроки,
		Новый КвалификаторыСтроки(2000)));
	Результат.Колонки.Добавить("КодЕдиницыДо", ТипКодаЕдиницы);
	Результат.Колонки.Добавить("ЕдиницаДо", ТипНаименованияЕдиницы);
	Результат.Колонки.Добавить("КоличествоДо", ТипКоличестваИЦены);
	Результат.Колонки.Добавить("ЦенаДо", ТипКоличестваИЦены);
	Результат.Колонки.Добавить("СтавкаНДСДо", ТипСтавкиНДС);
	Результат.Колонки.Добавить("БезНДСДо", ТипПризнака);
	Результат.Колонки.Добавить("СуммаБезНДСДо", ТипСуммыДоИРазницы);
	Результат.Колонки.Добавить("СуммаНДСДо", ТипСуммыДоИРазницы);
	Результат.Колонки.Добавить("СуммаДо", ТипСуммыДоИРазницы);
	Результат.Колонки.Добавить("КодЕдиницы", ТипКодаЕдиницы);
	Результат.Колонки.Добавить("Единица", ТипНаименованияЕдиницы);
	Результат.Колонки.Добавить("Количество", ТипКоличестваИЦены);
	Результат.Колонки.Добавить("Цена", ТипКоличестваИЦены);
	Результат.Колонки.Добавить("СтавкаНДС", ТипСтавкиНДС);
	Результат.Колонки.Добавить("БезНДС", ТипПризнака);
	Результат.Колонки.Добавить("СуммаБезНДС", ТипСуммыПосле);
	Результат.Колонки.Добавить("СуммаНДС", ТипСуммыПосле);
	Результат.Колонки.Добавить("Сумма", ТипСуммыПосле);
	Результат.Колонки.Добавить("ИзменениеСуммыБезНДС", ТипСуммыДоИРазницы);
	Результат.Колонки.Добавить("ИзменениеНДС", ТипСуммыДоИРазницы);
	Результат.Колонки.Добавить("ИзменениеСуммы", ТипСуммыДоИРазницы);
	Результат.Колонки.Добавить("ПредставлениеДеклараций", ТипПредставленияСсылки);
	Результат.Колонки.Добавить("ПредставлениеДополнительныхСведений", ТипПредставленияСсылки);
	Результат.Колонки.Добавить("ПредставлениеПрослеживаемости", ТипПредставленияСсылки);
	Результат.Колонки.Добавить("ПредставлениеМаркировки", ТипПредставленияСсылки);

	Возврат Результат;

	// BSLLS:NestedFunctionInParameters-on
	// BSLLS:MagicNumber-on

КонецФункции

