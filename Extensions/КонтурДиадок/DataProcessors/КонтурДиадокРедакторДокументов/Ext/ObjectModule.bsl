Функция НоваяТаблицаСторон()

	// BSLLS:MagicNumber-off
	// BSLLS:NestedFunctionInParameters-off

	ИмяТипаСтроки = "Строка";

	ТипНалоговогоКода = Новый ОписаниеТипов(ИмяТипаСтроки, Новый КвалификаторыСтроки(20));
	ТипКраткогоТекста = Новый ОписаниеТипов(ИмяТипаСтроки, Новый КвалификаторыСтроки(100));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Наименование", Новый ОписаниеТипов(ИмяТипаСтроки,
		Новый КвалификаторыСтроки(500)));
	Результат.Колонки.Добавить("ИНН", ТипНалоговогоКода);
	Результат.Колонки.Добавить("КПП", ТипНалоговогоКода);
	Результат.Колонки.Добавить("ИдентификаторУчастника", ТипКраткогоТекста);
	Результат.Колонки.Добавить("Адрес", Новый ОписаниеТипов(ИмяТипаСтроки,
		Новый КвалификаторыСтроки(1000)));
	Результат.Колонки.Добавить("ДанныеАдреса", Новый ОписаниеТипов(ИмяТипаСтроки));
	Результат.Колонки.Добавить("Примечание", ТипКраткогоТекста);
	Результат.Колонки.Добавить("Тип", ТипКраткогоТекста);
	Результат.Колонки.Добавить("ОГРНИП", Новый ОписаниеТипов(ИмяТипаСтроки, , Новый КвалификаторыСтроки(15)));
	Результат.Колонки.Добавить("ДатаОГРНИП", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));

	Возврат Результат;

	// BSLLS:NestedFunctionInParameters-on
	// BSLLS:MagicNumber-on

КонецФункции

Процедура ПрименитьРеквизитыСторон(Стороны, ТаблицаСторон)

	Если Стороны.Количество() <> ТаблицаСторон.Количество() Тогда
		ВызватьИсключение "Состав сторон документа изменился. Откройте редактор заново.";
	КонецЕсли;
	Для ИндексСтороны = 0 По Стороны.Количество() - 1 Цикл
		ПрименитьРеквизитыСтороны(Стороны[ИндексСтороны], ТаблицаСторон[ИндексСтороны]);
	КонецЦикла;

КонецПроцедуры

Процедура ПрименитьРеквизитыСтороны(Сторона, СтрокаСтороны)

	// Поля ИП принадлежат любой стороне, независимо от ее роли в документе.
	Поля = Новый Структура("Name,Inn,Kpp", "Наименование", "ИНН", "КПП");
	Если СвойствоСтруктуры(Сторона, "Type", "") = "IndividualEntity" Тогда
		Поля.Вставить("IndividualEntityRegistrationNumber", "ОГРНИП");
		Поля.Вставить("IndividualEntityRegistrationDate", "ДатаОГРНИП");
	КонецЕсли;
	Для Каждого Поле Из Поля Цикл
		НовоеЗначение = СтрокаСтороны[Поле.Значение];
		ИсходноеЗначение = СвойствоСтруктуры(Сторона, Поле.Ключ);
		Если НовоеЗначение = ИсходноеЗначение
			ИЛИ НЕ (ЗначениеЗаполнено(НовоеЗначение) ИЛИ ЗначениеЗаполнено(ИсходноеЗначение)) Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(НовоеЗначение) = Тип("Строка") Тогда
			НовоеЗначение = СокрЛП(НовоеЗначение);
		КонецЕсли;
		Сторона.Вставить(Поле.Ключ, НовоеЗначение);
	КонецЦикла;
	Если СтрокаСтороны.ДанныеАдреса <> ЗначениеВСтрокуВнутр(СвойствоСтруктуры(Сторона, "Address")) Тогда
		Сторона.Вставить("Address", ЗначениеИзСтрокиВнутр(СтрокаСтороны.ДанныеАдреса));
	КонецЕсли;

КонецПроцедуры

// Переносит здания из черновика, сохраняя неизвестные поля исходных зданий.
//
// Параметры:
//  ТаблицаЗданий - ТаблицаЗначений - редактируемые здания ГАР.
//  ИсходныеЗдания - Массив - исходные структуры зданий.
//
// Возвращаемое значение:
//  Массив из Структура - здания с сохраненными неизвестными полями.
Функция ЗданияАдресаИзМодели(ТаблицаЗданий, ИсходныеЗдания)

	Здания = Новый Массив;
	Для Каждого СтрокаЗдания Из ТаблицаЗданий Цикл
		Здание = Новый Структура;
		Если СтрокаЗдания.ИсходныйИндекс >= 0 И СтрокаЗдания.ИсходныйИндекс < ИсходныеЗдания.Количество() Тогда
			Здание = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ИсходныеЗдания[СтрокаЗдания.ИсходныйИндекс]));
		КонецЕсли;
		Здание.Вставить("Type", СокрЛП(СтрокаЗдания.Тип));
		Здание.Вставить("Number", СокрЛП(СтрокаЗдания.Номер));
		Здания.Добавить(Здание);
	КонецЦикла;
	Возврат Здания;

КонецФункции

// Сравнивает активное представление и здания, не затрагивая черновики других видов.
//
// Параметры:
//  Модель - Структура - текущий черновик адреса.
//  ИсходнаяМодель - Структура - черновик исходного адреса.
//  Поля - Массив - описания полей адреса.
//
// Возвращаемое значение:
//  Булево - изменено активное представление адреса или здания ГАР.
Функция АдресИзменен(Модель, ИсходнаяМодель, Поля)

	Если Модель.ВидАдреса <> ИсходнаяМодель.ВидАдреса
		Или Модель.ГлобальныйНомерМеста <> ИсходнаяМодель.ГлобальныйНомерМеста Тогда
		Возврат Истина;
	КонецЕсли;
	Результат = Ложь;
	Для Каждого Поле Из Поля Цикл
		Если Поле.ТипАдреса = Модель.ВидАдреса
			И Модель[Поле.Реквизит] <> ИсходнаяМодель[Поле.Реквизит] Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Результат Или Модель.ВидАдреса <> "AddressSAR" Тогда
		Возврат Результат;
	КонецЕсли;
	Результат = Модель.Здания.Количество() <> ИсходнаяМодель.Здания.Количество();
	Для ИндексЗдания = 0 По Модель.Здания.Количество() - 1 Цикл
		Если Результат Тогда
			Прервать;
		КонецЕсли;
		Результат = Модель.Здания[ИндексЗдания].Тип <> ИсходнаяМодель.Здания[ИндексЗдания].Тип
			Или Модель.Здания[ИндексЗдания].Номер <> ИсходнаяМодель.Здания[ИндексЗдания].Номер;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проверяет ограничения активного вида адреса до изменения исходного контента.
//
// Параметры:
//  Модель - Структура - черновик адреса.
//  Поля - Массив - описания полей с ограничениями длины.
Процедура ПроверитьПоляАдреса(Модель, Поля)

	ДлинаГлобальногоНомераМеста = 13;
	ДлинаКодаСтраны = 3;
	ДлинаКодаРегиона = 2;
	ДлинаПочтовогоИндекса = 6;

	Для Каждого Поле Из Поля Цикл
		Если Поле.ТипАдреса = Модель.ВидАдреса И Поле.Длина > 0
			И СтрДлина(СокрЛП(Модель[Поле.Реквизит])) > Поле.Длина Тогда
			ВызватьИсключение СтдСтр().СтрШаблонЛок("Поле %1: допускается не более %2 символов.", Поле.Заголовок, Поле.Длина);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Модель.ГлобальныйНомерМеста) Тогда
		ПроверитьКодАдреса(Модель.ГлобальныйНомерМеста, ДлинаГлобальногоНомераМеста, "Глобальный номер места (GLN)");
	КонецЕсли;
	Если Модель.ВидАдреса = "AddressText" Тогда
		ПроверитьКодАдреса(Модель.ТекстКодСтраны, ДлинаКодаСтраны, "Код страны");
		Если Не ЗначениеЗаполнено(СокрЛП(Модель.ТекстСтрана))
			Или Не ЗначениеЗаполнено(СокрЛП(Модель.ТекстАдреса)) Тогда
			ВызватьИсключение "Заполните страну и текст адреса.";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Префикс = ?(Модель.ВидАдреса = "AddressRF", "РФ", "ГАР");
	ПроверитьКодАдреса(Модель[Префикс + "КодРегиона"], ДлинаКодаРегиона, "Код региона");
	Если Не ЗначениеЗаполнено(СокрЛП(Модель[Префикс + "Регион"])) Тогда
		ВызватьИсключение "Заполните наименование региона.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Модель[Префикс + "Индекс"]) Тогда
		ПроверитьКодАдреса(Модель[Префикс + "Индекс"], ДлинаПочтовогоИндекса, "Почтовый индекс");
	КонецЕсли;
	Если Модель.ВидАдреса = "AddressSAR" Тогда
		ПроверитьАдресГАР(Модель);
	КонецЕсли;

КонецПроцедуры

// Проверяет обязательные реквизиты, пары тип/значение и здания адреса ГАР.
//
// Параметры:
//  Модель - Структура - черновик адреса ГАР.
Процедура ПроверитьАдресГАР(Модель)

	ДлинаИдентификатораГАР = 36;
	ДлинаТипаЗдания = 50;
	ДлинаНомераЗдания = 255;

	Если СтрДлина(СокрЛП(Модель.ГАРИдентификатор)) <> ДлинаИдентификатораГАР Тогда
		ВызватьИсключение "Идентификатор ГАР должен содержать 36 символов.";
	КонецЕсли;
	ПарыПолей = Новый Структура;
	ПарыПолей.Вставить("ГАРВидРайона", "ГАРРайон");
	ПарыПолей.Вставить("ГАРВидПоселения", "ГАРПоселение");
	ПарыПолей.Вставить("ГАРВидНаселенногоПункта", "ГАРНаселенныйПункт");
	ПарыПолей.Вставить("ГАРТипПланировочногоЭлемента", "ГАРПланировочныйЭлемент");
	ПарыПолей.Вставить("ГАРТипУлицы", "ГАРУлица");
	ПарыПолей.Вставить("ГАРТипПомещенияЗдания", "ГАРПомещениеЗдания");
	ПарыПолей.Вставить("ГАРТипПомещенияКвартиры", "ГАРПомещениеКвартиры");
	Для Каждого Пара Из ПарыПолей Цикл
		Если ЗначениеЗаполнено(СокрЛП(Модель[Пара.Ключ])) <> ЗначениеЗаполнено(СокрЛП(Модель[Пара.Значение])) Тогда
			ВызватьИсключение "Для элемента адреса ГАР заполните и тип (вид), и наименование (номер).";
		КонецЕсли;
	КонецЦикла;
	Для Каждого Здание Из Модель.Здания Цикл
		РеквизитыЗданияНекорректны = НЕ ЗначениеЗаполнено(СокрЛП(Здание.Тип))
			ИЛИ НЕ ЗначениеЗаполнено(СокрЛП(Здание.Номер))
			ИЛИ СтрДлина(Здание.Тип) > ДлинаТипаЗдания ИЛИ СтрДлина(Здание.Номер) > ДлинаНомераЗдания;
		Если РеквизитыЗданияНекорректны Тогда
			ВызватьИсключение "Для здания заполните тип (до 50 символов) и номер (до 255 символов).";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьКодАдреса(Знач Код, Длина, Заголовок)

	Код = СокрЛП(Код);
	Если СтрДлина(Код) <> Длина Тогда
		ВызватьИсключение СтдСтр().СтрШаблонЛок("%1 должен содержать %2 цифр.", Заголовок, Длина);
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Код) Цикл
		Если СтдСтр().СтрНайтиЛок("0123456789", Сред(Код, Индекс, 1)) = 0 Тогда
			ВызватьИсключение Заголовок + " должен содержать только цифры.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция НоваяТаблицаПрослеживаемости()

	// BSLLS:MagicNumber-off
	// BSLLS:NestedFunctionInParameters-off

	ИмяТипаЧисла = "Число";
	ИмяТипаСтроки = "Строка";

	ТипИндекса = Новый ОписаниеТипов(ИмяТипаЧисла, Новый КвалификаторыЧисла(10, 0));
	ТипКоличества = Новый ОписаниеТипов(ИмяТипаЧисла, Новый КвалификаторыЧисла(26, 11));
	ТипСтоимостиДоИРазницы = Новый ОписаниеТипов(ИмяТипаЧисла, Новый КвалификаторыЧисла(19,
		2));
	ТипКраткогоТекста = Новый ОписаниеТипов(ИмяТипаСтроки, Новый КвалификаторыСтроки(255));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИсходныйИндекс", ТипИндекса);
	Результат.Колонки.Добавить("НомерСтроки", ТипИндекса);
	Результат.Колонки.Добавить("Товар", Новый ОписаниеТипов(ИмяТипаСтроки,
		Новый КвалификаторыСтроки(500)));
	Результат.Колонки.Добавить("РегистрационныйНомер", Новый ОписаниеТипов(ИмяТипаСтроки,
		Новый КвалификаторыСтроки(29)));
	Результат.Колонки.Добавить("КодЕдиницы", Новый ОписаниеТипов(ИмяТипаСтроки,
		Новый КвалификаторыСтроки(4)));
	Результат.Колонки.Добавить("Единица", ТипКраткогоТекста);
	Результат.Колонки.Добавить("КоличествоДо", ТипКоличества);
	Результат.Колонки.Добавить("Количество", ТипКоличества);
	Результат.Колонки.Добавить("СтоимостьБезНДСДо", ТипСтоимостиДоИРазницы);
	Результат.Колонки.Добавить("СтоимостьБезНДС", Новый ОписаниеТипов(ИмяТипаЧисла,
		Новый КвалификаторыЧисла(20, 2)));
	Результат.Колонки.Добавить("ИзменениеКоличества", ТипКоличества);
	Результат.Колонки.Добавить("ИзменениеСтоимости", ТипСтоимостиДоИРазницы);
	Результат.Колонки.Добавить("ДополнительныеСведения", ТипКраткогоТекста);

	Возврат Результат;

	// BSLLS:NestedFunctionInParameters-on
	// BSLLS:MagicNumber-on

КонецФункции

Функция НоваяТаблицаГруппМаркировки()

	// BSLLS:MagicNumber-off
	// BSLLS:NestedFunctionInParameters-off

	ИмяТипаЧисла = "Число";
	ИмяТипаСтроки = "Строка";

	ТипИндекса = Новый ОписаниеТипов(ИмяТипаЧисла, Новый КвалификаторыЧисла(10, 0));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИсходныйИндекс", ТипИндекса);
	Результат.Колонки.Добавить("НомерГруппы", ТипИндекса);
	Результат.Колонки.Добавить("НомерСтроки", ТипИндекса);
	Результат.Колонки.Добавить("Товар", Новый ОписаниеТипов(ИмяТипаСтроки,
		Новый КвалификаторыСтроки(500)));
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов(ИмяТипаСтроки,
		Новый КвалификаторыСтроки(10)));
	Результат.Колонки.Добавить("ТранспортнаяУпаковка", Новый ОписаниеТипов(ИмяТипаСтроки,
		Новый КвалификаторыСтроки(255)));
	Результат.Колонки.Добавить("GTIN", Новый ОписаниеТипов(ИмяТипаСтроки, Новый КвалификаторыСтроки(14)));
	Результат.Колонки.Добавить("КоличествоМаркированныхТоваров", Новый ОписаниеТипов(ИмяТипаЧисла,
		Новый КвалификаторыЧисла(8, 0)));
	Результат.Колонки.Добавить("ВесМаркированныхТоваров", Новый ОписаниеТипов(ИмяТипаЧисла,
		Новый КвалификаторыЧисла(19, 3)));
	Результат.Колонки.Добавить("КодПартии", Новый ОписаниеТипов(ИмяТипаСтроки,
		Новый КвалификаторыСтроки(32)));
	Результат.Колонки.Добавить("ВидУчета", Новый ОписаниеТипов(ИмяТипаСтроки, Новый КвалификаторыСтроки(30)));

	Возврат Результат;

	// BSLLS:NestedFunctionInParameters-on
	// BSLLS:MagicNumber-on

КонецФункции

Функция НоваяТаблицаКодовМаркировки()

	// BSLLS:MagicNumber-off
	// BSLLS:NestedFunctionInParameters-off

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерГруппы", Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(10, 0)));
	Результат.Колонки.Добавить("ВидКода", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	Результат.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(255)));

	Возврат Результат;

	// BSLLS:NestedFunctionInParameters-on
	// BSLLS:MagicNumber-on

КонецФункции

Процедура ЗаполнитьСтороны(ТаблицаСторон, Стороны)

	Если ТипЗнч(Стороны) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Сторона Из Стороны Цикл
		НоваяСтрока = ТаблицаСторон.Добавить();
		НоваяСтрока.Наименование = СвойствоСтруктуры(Сторона, "Name", "");
		НоваяСтрока.ИНН = СвойствоСтруктуры(Сторона, "Inn", "");
		НоваяСтрока.КПП = СвойствоСтруктуры(Сторона, "Kpp", "");
		НоваяСтрока.ИдентификаторУчастника = СвойствоСтруктуры(Сторона, "FnsParticipantId", "");
		НоваяСтрока.Адрес = ПредставлениеАдресаЛок(СвойствоСтруктуры(Сторона, "Address"));
		Если Не ЗначениеЗаполнено(НоваяСтрока.Адрес) Тогда
			НоваяСтрока.Адрес = "Указать адрес";
		КонецЕсли;
		НоваяСтрока.ДанныеАдреса = ЗначениеВСтрокуВнутр(СвойствоСтруктуры(Сторона, "Address"));
		НоваяСтрока.Тип = СвойствоСтруктуры(Сторона, "Type", "");
		НоваяСтрока.ОГРНИП = СвойствоСтруктуры(Сторона, "IndividualEntityRegistrationNumber", "");
		ДатаРегистрации = СвойствоСтруктуры(Сторона, "IndividualEntityRegistrationDate");
		Если ТипЗнч(ДатаРегистрации) = Тип("Дата") Тогда
			НоваяСтрока.ДатаОГРНИП = ДатаРегистрации;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьИнформационныеПоля(Таблица, ИнформационныеПоля, НомерСтроки, Товар)

	Если ТипЗнч(ИнформационныеПоля) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Индекс = 0;
	Для Каждого ИнформационноеПоле Из ИнформационныеПоля Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.ИсходныйИндекс = Индекс + 1;
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НоваяСтрока.Товар = Товар;
		НоваяСтрока.Ключ = СвойствоСтруктуры(ИнформационноеПоле, "Key", "");
		НоваяСтрока.Значение = СвойствоСтруктуры(ИнформационноеПоле, "Value", "");
		Индекс = Индекс + 1;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьГрузоотправителей(ТаблицаСторон, Грузоотправители, Продавцы)

	Если ТипЗнч(Грузоотправители) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Грузоотправитель Из Грузоотправители Цикл
		Если СвойствоСтруктуры(Грузоотправитель, "SameAsSeller", Ложь) Тогда
			НоваяСтрока = ТаблицаСторон.Добавить();
			Если Продавцы.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Продавцы[0]);
			КонецЕсли;
			НоваяСтрока.Примечание = "Он же (продавец)";
		Иначе
			ЗаполнитьСторону(ТаблицаСторон,
				СвойствоСтруктуры(Грузоотправитель, "OrganizationInfo"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСторону(ТаблицаСторон, Сторона)

	Если ТипЗнч(Сторона) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Стороны = Новый Массив;
	Стороны.Добавить(Сторона);
	ЗаполнитьСтороны(ТаблицаСторон, Стороны);

КонецПроцедуры

Процедура ЗаполнитьЗначенияСтроки(СтрокаМодели, Значения)

	СтрокаМодели.КодЕдиницы = СвойствоСтруктуры(Значения, "Unit", СвойствоСтруктуры(Значения, "UnitCode", ""));
	СтрокаМодели.Единица = СвойствоСтруктуры(Значения, "UnitName", "");
	СтрокаМодели.Количество = СвойствоСтруктуры(Значения, "Quantity", 0);
	СтрокаМодели.Цена = СвойствоСтруктуры(Значения, "Price", 0);
	СтрокаМодели.СтавкаНДС = СвойствоСтруктуры(Значения, "TaxRate", "");
	СтрокаМодели.БезНДС = СвойствоСтруктуры(Значения, "WithoutVat", Ложь);
	СтрокаМодели.СуммаБезНДС = СвойствоСтруктуры(Значения, "SubtotalWithVatExcluded",
		СвойствоСтруктуры(Значения, "TotalWithVatExcluded", 0));
	СтрокаМодели.СуммаНДС = СвойствоСтруктуры(Значения, "Vat", 0);
	СтрокаМодели.Сумма = СвойствоСтруктуры(Значения, "Subtotal", СвойствоСтруктуры(Значения, "Total", 0));

КонецПроцедуры

Процедура ЗаполнитьЗначенияСтрокиУКД(СтрокаМодели, Значения, ИсходныеЗначения)

	Если ИсходныеЗначения Тогда
		СтрокаМодели.КодЕдиницыДо = СвойствоСтруктуры(Значения, "UnitCode", "");
		СтрокаМодели.ЕдиницаДо = СвойствоСтруктуры(Значения, "UnitName", "");
		СтрокаМодели.КоличествоДо = СвойствоСтруктуры(Значения, "Quantity", 0);
		СтрокаМодели.ЦенаДо = СвойствоСтруктуры(Значения, "Price", 0);
		СтрокаМодели.СтавкаНДСДо = СвойствоСтруктуры(Значения, "TaxRate", "");
		СтрокаМодели.БезНДСДо = СвойствоСтруктуры(Значения, "WithoutVat", Ложь);
		СтрокаМодели.СуммаБезНДСДо = СвойствоСтруктуры(Значения, "TotalWithVatExcluded", 0);
		СтрокаМодели.СуммаНДСДо = СвойствоСтруктуры(Значения, "Vat", 0);
		СтрокаМодели.СуммаДо = СвойствоСтруктуры(Значения, "Total", 0);
	Иначе
		ЗаполнитьЗначенияСтроки(СтрокаМодели, Значения);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьРазницыСтрокиУКД(СтрокаМодели)

	СтрокаМодели.ИзменениеСуммыБезНДС = СтрокаМодели.СуммаБезНДС - СтрокаМодели.СуммаБезНДСДо;
	СтрокаМодели.ИзменениеНДС = СтрокаМодели.СуммаНДС - СтрокаМодели.СуммаНДСДо;
	СтрокаМодели.ИзменениеСуммы = СтрокаМодели.Сумма - СтрокаМодели.СуммаДо;

КонецПроцедуры

Процедура ЗаполнитьДекларации(ТаблицаДеклараций, СтрокаКонтента, ИндексТовара, НаименованиеТовара, ТипКонтента)

	Декларации = СвойствоСтруктуры(СтрокаКонтента, "CustomDeclarations", Новый Массив);
	Если ТипЗнч(Декларации) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	ИндексЗаписи = 0;
	Для Каждого Декларация Из Декларации Цикл
		НоваяСтрока = ТаблицаДеклараций.Добавить();
		НоваяСтрока.ИсходныйИндекс = ИндексЗаписи + 1;
		НоваяСтрока.НомерСтроки = ИндексТовара + 1;
		НоваяСтрока.Товар = НаименованиеТовара;
		НоваяСтрока.КодСтраны = СвойствоСтруктуры(Декларация, "CountryCode", "");
		Если ТипКонтента = "utd970" Тогда
			НоваяСтрока.НаименованияСтран = СвойствоСтруктуры(СтрокаКонтента, "Country", "");
			НоваяСтрока.НомерДТ = СвойствоСтруктуры(Декларация, "DeclarationNumber", "");
		Иначе
			НоваяСтрока.НаименованияСтран = СтрокаИзМассива(СвойствоСтруктуры(Декларация, "Country", Новый Массив));
			НоваяСтрока.НомерДТДо = СвойствоСтруктуры(Декларация, "DeclarationNumberBefore", "");
			НоваяСтрока.НомерДТПосле = СвойствоСтруктуры(Декларация, "DeclarationNumberAfter", "");
			НоваяСтрока.НомераДТУвеличение = СтрокаИзМассива(
				СвойствоСтруктуры(Декларация, "DeclarationNumbersInc", Новый Массив));
			НоваяСтрока.НомераДТУменьшение = СтрокаИзМассива(
				СвойствоСтруктуры(Декларация, "DeclarationNumbersDec", Новый Массив));
		КонецЕсли;
		ИндексЗаписи = ИндексЗаписи + 1;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПрослеживаемость(ТаблицаПрослеживаемости, СтрокаКонтента, ИндексТовара,
		НаименованиеТовара, ТипКонтента)

	Сведения = СвойствоСтруктуры(СтрокаКонтента, "ItemTracingInfos", Новый Массив);
	Если ТипЗнч(Сведения) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	ИндексЗаписи = 0;
	Для Каждого СведенияОПартии Из Сведения Цикл
		НоваяСтрока = ТаблицаПрослеживаемости.Добавить();
		НоваяСтрока.ИсходныйИндекс = ИндексЗаписи + 1;
		НоваяСтрока.НомерСтроки = ИндексТовара + 1;
		НоваяСтрока.Товар = НаименованиеТовара;
		НоваяСтрока.РегистрационныйНомер = СвойствоСтруктуры(СведенияОПартии, "RegNumberUnit", "");
		НоваяСтрока.КодЕдиницы = СвойствоСтруктуры(СведенияОПартии, "Unit", "");
		НоваяСтрока.Единица = СвойствоСтруктуры(СведенияОПартии, "UnitName", "");
		Если ТипКонтента = "utd970" Тогда
			НоваяСтрока.Количество = СвойствоСтруктуры(СведенияОПартии, "Quantity", 0);
			НоваяСтрока.СтоимостьБезНДС = СвойствоСтруктуры(СведенияОПартии, "SumWithoutVat", 0);
		Иначе
			Разницы = СвойствоСтруктуры(СведенияОПартии, "QuantityDiff", Новый Структура);
			НоваяСтрока.КоличествоДо = СвойствоСтруктуры(Разницы, "OriginalQuantity", 0);
			НоваяСтрока.Количество = СвойствоСтруктуры(Разницы, "CorrectedQuantity", 0);
			НоваяСтрока.СтоимостьБезНДСДо = СвойствоСтруктуры(Разницы, "OriginalSumWithoutVat", 0);
			НоваяСтрока.СтоимостьБезНДС = СвойствоСтруктуры(Разницы, "CorrectedSumWithoutVat", 0);
			НоваяСтрока.ИзменениеКоличества = НоваяСтрока.Количество - НоваяСтрока.КоличествоДо;
			НоваяСтрока.ИзменениеСтоимости = НоваяСтрока.СтоимостьБезНДС - НоваяСтрока.СтоимостьБезНДСДо;
		КонецЕсли;
		НоваяСтрока.ДополнительныеСведения = СвойствоСтруктуры(СведенияОПартии, "ItemAddInfo", "");
		ИндексЗаписи = ИндексЗаписи + 1;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьМаркировку(Модель, СтрокаКонтента, ИндексТовара, НаименованиеТовара, ИмяКоллекции, Состояние)

	Группы = СвойствоСтруктуры(СтрокаКонтента, ИмяКоллекции, Новый Массив);
	Если ТипЗнч(Группы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	ИндексГруппы = 0;
	ГТИНСтрокиУПД = ?(Модель.ТипКонтента = "utd970", СвойствоСтруктуры(СтрокаКонтента, "GTIN", ""), "");
	Для Каждого Группа Из Группы Цикл
		СтрокаГруппы = Модель.ГруппыМаркировки.Добавить();
		СтрокаГруппы.ИсходныйИндекс = ИндексГруппы + 1;
		СтрокаГруппы.НомерГруппы = Модель.ГруппыМаркировки.Количество();
		СтрокаГруппы.НомерСтроки = ИндексТовара + 1;
		СтрокаГруппы.Товар = НаименованиеТовара;
		СтрокаГруппы.Состояние = Состояние;
		СтрокаГруппы.ТранспортнаяУпаковка = СвойствоСтруктуры(Группа, "TransPackageId", "");
		СтрокаГруппы.GTIN = СвойствоСтруктуры(Группа, "GTIN", "");
		СтрокаГруппы.КоличествоМаркированныхТоваров = СвойствоСтруктуры(Группа, "MarkedItemsQuantity", 0);
		СтрокаГруппы.ВесМаркированныхТоваров = СвойствоСтруктуры(Группа, "QuantityWeightMark", 0);
		СтрокаГруппы.КодПартии = СвойствоСтруктуры(Группа, "BatchCode", "");
		НомерГруппы = СтрокаГруппы.НомерГруппы;
		ЗаполнитьКодыМаркировки(Модель.КодыМаркировки, НомерГруппы, СвойствоСтруктуры(Группа, "Units", Новый Массив), "КИЗ");
		КодыУпаковок = СвойствоСтруктуры(Группа, "PackageIds", Новый Массив);
		Если ТипЗнч(КодыУпаковок) <> Тип("Массив") Тогда
			КодыУпаковок = Новый Массив;
		КонецЕсли;
		Если Модель.ТипКонтента = "utd970" Или Модель.ТипКонтента = "ucd29" Или Модель.ТипКонтента = "ucd736" Тогда
			КодыУпаковок = РазобратьКодыОСУГруппы(Модель, СтрокаГруппы, КодыУпаковок, ГТИНСтрокиУПД);
		КонецЕсли;
		ЗаполнитьКодыМаркировки(Модель.КодыМаркировки, НомерГруппы, КодыУпаковок, "Упаковка");
		ИндексГруппы = ИндексГруппы + 1;
	КонецЦикла;

КонецПроцедуры

// Разбирает коды ОСУ в отдельные редактируемые группы, сохраняя нераспознанные упаковки.
//
// Параметры:
//  Модель - Структура - заполняемая модель документа.
//  СтрокаГруппы - СтрокаТаблицыЗначений - исходная группа маркировки.
//  КодыУпаковок - Массив - исходные коды упаковок.
//  ГТИНСтрокиУПД - Строка - общий ГТИН товарной строки.
//
// Возвращаемое значение:
//  Массив - упаковки, которые не преобразованы в группы ОСУ.
Функция РазобратьКодыОСУГруппы(Модель, Знач СтрокаГруппы, КодыУпаковок, ГТИНСтрокиУПД)

	ОбычныеКодыУпаковок = Новый Массив;
	ПерваяСтрокаГруппы = СтрокаГруппы;
	ЕстьРеквизитыИсходнойГруппы = ЗначениеЗаполнено(СтрокаГруппы.GTIN)
		ИЛИ ЗначениеЗаполнено(СтрокаГруппы.КоличествоМаркированныхТоваров);
	Для Каждого КодУпаковки Из КодыУпаковок Цикл
		СведенияОСУ = РазобратьНомерУпаковкиОСУ(КодУпаковки);
		Если СведенияОСУ = Неопределено ИЛИ ЕстьРеквизитыИсходнойГруппы Тогда
			ОбычныеКодыУпаковок.Добавить(КодУпаковки);
		Иначе
			Если ЗначениеЗаполнено(СтрокаГруппы.GTIN)
				ИЛИ ЗначениеЗаполнено(СтрокаГруппы.КоличествоМаркированныхТоваров) Тогда
				СтрокаГруппы = Модель.ГруппыМаркировки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаГруппы, ПерваяСтрокаГруппы);
				// Дополнительный код ОСУ становится самостоятельной редактируемой строкой.
				// Исходные КИЗ, упаковки и неизвестные реквизиты остаются у первой группы.
				СтрокаГруппы.ИсходныйИндекс = -1;
				СтрокаГруппы.НомерГруппы = Модель.ГруппыМаркировки.Количество();
				СтрокаГруппы.ТранспортнаяУпаковка = "";
			КонецЕсли;
			СтрокаГруппы.GTIN = СведенияОСУ.GTIN;
			СтрокаГруппы.КоличествоМаркированныхТоваров = СведенияОСУ.Количество;
			СтрокаГруппы.ВесМаркированныхТоваров = СведенияОСУ.Вес;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЗначениеЗаполнено(ПерваяСтрокаГруппы.GTIN) Тогда
		ПерваяСтрокаГруппы.GTIN = ГТИНСтрокиУПД;
	КонецЕсли;
	Возврат ОбычныеКодыУпаковок;

КонецФункции

Процедура ЗаполнитьПартииУКД736(Модель, СтрокаКонтента, НомерСтроки)

	ДополнительныеСведения = СвойствоСтруктуры(СтрокаКонтента, "StructedAdditionalInfos", Новый Массив);
	Для Каждого Состояние Из СтдСтр().СтрРазделитьЛок("До,После", ",") Цикл
		Ключ = ?(Состояние = "До", "ПрПартМаркДо", "ПрПартМаркПосле");
		НомерПартии = "";
		Для Каждого Сведение Из ДополнительныеСведения Цикл
			Если СвойствоСтруктуры(Сведение, "Key", "") = Ключ Тогда
				НомерПартии = СвойствоСтруктуры(Сведение, "Value", "");
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ЗначениеЗаполнено(НомерПартии) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Группа Из Модель.ГруппыМаркировки.НайтиСтроки(
			Новый Структура("НомерСтроки,Состояние", НомерСтроки, Состояние)) Цикл
			Группа.КодПартии = НомерПартии;
			Прервать;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьКодыМаркировки(ТаблицаКодов, НомерГруппы, Коды, ВидКода)

	Если ТипЗнч(Коды) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Код Из Коды Цикл
		НоваяСтрока = ТаблицаКодов.Добавить();
		НоваяСтрока.НомерГруппы = НомерГруппы;
		НоваяСтрока.ВидКода = ВидКода;
		НоваяСтрока.Код = Код;
	КонецЦикла;

КонецПроцедуры

Процедура ПрименитьДекларации(СтрокаКонтента, ТаблицаДеклараций, НомерСтроки, ТипКонтента)

	ИсходныеДекларации = СвойствоСтруктуры(СтрокаКонтента, "CustomDeclarations", Новый Массив);
	НовыеДекларации = Новый Массив;
	НаименованиеСтраныУПД = "";
	Для Каждого СтрокаМодели Из ТаблицаДеклараций.НайтиСтроки(
		Новый Структура("НомерСтроки", НомерСтроки)) Цикл
		Декларация = ИсходнаяСтруктура(ИсходныеДекларации, СтрокаМодели.ИсходныйИндекс);
		Если ТипКонтента = "utd970" Тогда
			Если Не ЗначениеЗаполнено(НаименованиеСтраныУПД) Тогда
				НаименованиеСтраныУПД = СокрЛП(СтрокаМодели.НаименованияСтран);
			КонецЕсли;
			УстановитьНеобязательноеСвойство(Декларация, "CountryCode", СокрЛП(СтрокаМодели.КодСтраны));
			УстановитьНеобязательноеСвойство(Декларация, "DeclarationNumber", СокрЛП(СтрокаМодели.НомерДТ));
		Иначе
			Декларация.Вставить("CountryCode", СокрЛП(СтрокаМодели.КодСтраны));
			Декларация.Вставить("DeclarationNumberBefore", СокрЛП(СтрокаМодели.НомерДТДо));
			Декларация.Вставить("DeclarationNumberAfter", СокрЛП(СтрокаМодели.НомерДТПосле));
			Декларация.Вставить("Country", МассивИзСтроки(СтрокаМодели.НаименованияСтран));
			Декларация.Вставить("DeclarationNumbersInc", МассивИзСтроки(СтрокаМодели.НомераДТУвеличение));
			Декларация.Вставить("DeclarationNumbersDec", МассивИзСтроки(СтрокаМодели.НомераДТУменьшение));
		КонецЕсли;
		НовыеДекларации.Добавить(Декларация);
	КонецЦикла;
	Если ТипКонтента = "utd970" Тогда
		УстановитьНеобязательноеСвойство(СтрокаКонтента, "Country", НаименованиеСтраныУПД);
	КонецЕсли;
	СтрокаКонтента.Вставить("CustomDeclarations", НовыеДекларации);

КонецПроцедуры

Процедура ПрименитьДополнительныеСведенияДокумента(Контент, Модель)

	ДополнительнаяИнформация = СвойствоСтруктуры(Контент, "AdditionalInfoId", Новый Структура);
	Если ТипЗнч(ДополнительнаяИнформация) <> Тип("Структура") Тогда
		ДополнительнаяИнформация = Новый Структура;
	КонецЕсли;
	ДополнительнаяИнформация.Вставить("InfoFileId",
		СокрЛП(Модель.ИдентификаторФайлаИнформационногоПоля));
	ПрименитьИнформационныеПоля(ДополнительнаяИнформация, "StructedAdditionalInfos",
		Модель.ДополнительныеСведенияДокумента, 0);
	Контент.Вставить("AdditionalInfoId", ДополнительнаяИнформация);

КонецПроцедуры

Процедура ПрименитьИнформационныеПоля(Владелец, ИмяСвойства, Таблица, НомерСтроки)

	ИсходныеЗначения = СвойствоСтруктуры(Владелец, ИмяСвойства, Новый Массив);
	НовыеЗначения = Новый Массив;
	Для Каждого СтрокаМодели Из Таблица.НайтиСтроки(Новый Структура("НомерСтроки", НомерСтроки)) Цикл
		Значение = ИсходнаяСтруктура(ИсходныеЗначения, СтрокаМодели.ИсходныйИндекс);
		Значение.Вставить("Key", СокрЛП(СтрокаМодели.Ключ));
		Значение.Вставить("Value", СокрЛП(СтрокаМодели.Значение));
		НовыеЗначения.Добавить(Значение);
	КонецЦикла;
	Владелец.Вставить(ИмяСвойства, НовыеЗначения);

КонецПроцедуры

Процедура ПрименитьПрослеживаемость(СтрокаКонтента, ТаблицаПрослеживаемости, НомерСтроки, ТипКонтента)

	ИсходныеСведения = СвойствоСтруктуры(СтрокаКонтента, "ItemTracingInfos", Новый Массив);
	НовыеСведения = Новый Массив;
	Отбор = Новый Структура("НомерСтроки", НомерСтроки);
	Для Каждого СтрокаМодели Из ТаблицаПрослеживаемости.НайтиСтроки(Отбор) Цикл
		СведенияОПартии = ИсходнаяСтруктура(ИсходныеСведения, СтрокаМодели.ИсходныйИндекс);
		СведенияОПартии.Вставить("RegNumberUnit", СокрЛП(СтрокаМодели.РегистрационныйНомер));
		СведенияОПартии.Вставить("Unit", СокрЛП(СтрокаМодели.КодЕдиницы));
		СведенияОПартии.Вставить("UnitName", СокрЛП(СтрокаМодели.Единица));
		Если ТипКонтента = "utd970" Тогда
			СведенияОПартии.Вставить("Quantity", СтрокаМодели.Количество);
			СведенияОПартии.Вставить("SumWithoutVat", СтрокаМодели.СтоимостьБезНДС);
		Иначе
			Разницы = СвойствоСтруктуры(СведенияОПартии, "QuantityDiff", Новый Структура);
			Разницы.Вставить("OriginalQuantity", СтрокаМодели.КоличествоДо);
			Разницы.Вставить("CorrectedQuantity", СтрокаМодели.Количество);
			УстановитьУвеличениеИУменьшение(Разницы, "QuantityInc", "QuantityDec",
				СтрокаМодели.Количество - СтрокаМодели.КоличествоДо);
			Разницы.Вставить("OriginalSumWithoutVat", СтрокаМодели.СтоимостьБезНДСДо);
			Разницы.Вставить("CorrectedSumWithoutVat", СтрокаМодели.СтоимостьБезНДС);
			УстановитьУвеличениеИУменьшение(Разницы, "SumWithoutVatInc", "SumWithoutVatDec",
				СтрокаМодели.СтоимостьБезНДС - СтрокаМодели.СтоимостьБезНДСДо);
			СведенияОПартии.Вставить("QuantityDiff", Разницы);
		КонецЕсли;
		СведенияОПартии.Вставить("ItemAddInfo", СокрЛП(СтрокаМодели.ДополнительныеСведения));
		НовыеСведения.Добавить(СведенияОПартии);
	КонецЦикла;
	СтрокаКонтента.Вставить("ItemTracingInfos", НовыеСведения);

КонецПроцедуры

Процедура ПрименитьМаркировку(СтрокаКонтента, Модель, НомерСтроки, ИмяКоллекции, Состояние)

	ИсходныеГруппы = СвойствоСтруктуры(СтрокаКонтента, ИмяКоллекции, Новый Массив);
	НовыеГруппы = Новый Массив;
	ГруппыКИЗПоРеквизитам = Новый Соответствие;
	ИспользоватьГТИНСтроки = Ложь;
	Если Модель.ТипКонтента = "utd970" Тогда
		СведенияГТИН = ГТИНТоварнойСтрокиУПД(Модель.ГруппыМаркировки, НомерСтроки);
		ИспользоватьГТИНСтроки = СведенияГТИН.ИспользоватьГТИНСтроки;
		УстановитьНеобязательноеСвойство(СтрокаКонтента, "GTIN",
			?(ИспользоватьГТИНСтроки, СведенияГТИН.GTIN, ""));
	КонецЕсли;
	Для Каждого СтрокаГруппы Из Модель.ГруппыМаркировки Цикл
		Если СтрокаГруппы.НомерСтроки <> НомерСтроки Или СтрокаГруппы.Состояние <> Состояние Тогда
			Продолжить;
		КонецЕсли;
		КодироватьГТИНВУпаковке = Модель.ТипКонтента = "utd970"
			И ЗначениеЗаполнено(СтрокаГруппы.GTIN) И НЕ ИспользоватьГТИНСтроки;
		Группа = ГруппаМаркировкиИзМодели(СтрокаГруппы, ИсходныеГруппы,
			Модель.ТипКонтента, Модель.КодыМаркировки, КодироватьГТИНВУпаковке);
		ДобавитьГруппуМаркировки(НовыеГруппы, ГруппыКИЗПоРеквизитам, Группа, СтрокаГруппы);
	КонецЦикла;
	СтрокаКонтента.Вставить(ИмяКоллекции, НовыеГруппы);
	Если Модель.ТипКонтента = "ucd736" Тогда
		УстановитьПартиюУКД736(СтрокаКонтента, Модель, НомерСтроки, Состояние);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьГруппуМаркировки(НовыеГруппы, ГруппыКИЗПоРеквизитам, Группа, СтрокаГруппы)

	ЭтоГруппаТолькоСКИЗ = ЗначениеЗаполнено(Группа.Units)
		И НЕ ЗначениеЗаполнено(СтрокаГруппы.GTIN)
		И НЕ ЗначениеЗаполнено(СтрокаГруппы.КоличествоМаркированныхТоваров)
		И НЕ ЗначениеЗаполнено(СтрокаГруппы.ВесМаркированныхТоваров)
		И НЕ ЗначениеЗаполнено(СтрокаГруппы.ТранспортнаяУпаковка)
		И НЕ ЗначениеЗаполнено(Группа.PackageIds);
	Если ЭтоГруппаТолькоСКИЗ Тогда
		// Не объединять группы, если различаются реквизиты помимо списка КИЗ.
		РеквизитыГруппы = Новый Структура;
		Для Каждого Реквизит Из Группа Цикл
			Если Реквизит.Ключ <> "Units" Тогда
				РеквизитыГруппы.Вставить(Реквизит.Ключ, Реквизит.Значение);
			КонецЕсли;
		КонецЦикла;
		КлючГруппы = ЗначениеВСтрокуВнутр(РеквизитыГруппы);
		ОбщаяГруппа = ГруппыКИЗПоРеквизитам.Получить(КлючГруппы);
		Если ОбщаяГруппа <> Неопределено Тогда
			Для Каждого КИЗ Из Группа.Units Цикл
				ОбщаяГруппа.Units.Добавить(КИЗ);
			КонецЦикла;
			Возврат;
		КонецЕсли;
		ГруппыКИЗПоРеквизитам.Вставить(КлючГруппы, Группа);
	КонецЕсли;
	НовыеГруппы.Добавить(Группа);

КонецПроцедуры

// Выбирает общий ГТИН товарной строки, если все группы имеют один ГТИН и не содержат вес.
//
// Параметры:
//  ГруппыМаркировки - ТаблицаЗначений - все группы маркировки документа.
//  НомерСтроки - Число - номер редактируемой товарной строки.
//
// Возвращаемое значение:
//  Структура - GTIN и признак ИспользоватьГТИНСтроки.
Функция ГТИНТоварнойСтрокиУПД(ГруппыМаркировки, НомерСтроки)

	ГТИНСтроки = "";
	ИспользоватьГТИНСтроки = Истина;
	Для Каждого ГруппаМодели Из ГруппыМаркировки Цикл
		Если ГруппаМодели.НомерСтроки <> НомерСтроки ИЛИ НЕ ЗначениеЗаполнено(ГруппаМодели.GTIN) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ГруппаМодели.ВесМаркированныхТоваров) Тогда
			ИспользоватьГТИНСтроки = Ложь;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ГТИНСтроки) Тогда
			ГТИНСтроки = СокрЛП(ГруппаМодели.GTIN);
		Иначе
			ИспользоватьГТИНСтроки = ИспользоватьГТИНСтроки И ГТИНСтроки = СокрЛП(ГруппаМодели.GTIN);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("GTIN,ИспользоватьГТИНСтроки", ГТИНСтроки, ИспользоватьГТИНСтроки);

КонецФункции

// Собирает группу маркировки по контракту формата, сохраняя неизвестные исходные реквизиты.
//
// Параметры:
//  СтрокаГруппы - СтрокаТаблицыЗначений - редактируемая группа.
//  ИсходныеГруппы - Массив - исходные структуры идентификации.
//  ТипКонтента - Строка - поддерживаемый формат документа.
//  КодыМаркировки - ТаблицаЗначений - КИЗ и исходные упаковки.
//  КодироватьГТИНВУпаковке - Булево - ГТИН и количество УПД передаются кодом ОСУ.
//
// Возвращаемое значение:
//  Структура - группа идентификации для прото-контента.
Функция ГруппаМаркировкиИзМодели(СтрокаГруппы, ИсходныеГруппы,
		ТипКонтента, КодыМаркировки, КодироватьГТИНВУпаковке)

	ИмяРеквизитаКоличестваМаркированныхТоваров = "MarkedItemsQuantity";

	ИсходнаяГруппа = ИсходнаяСтруктура(ИсходныеГруппы, СтрокаГруппы.ИсходныйИндекс);
	Группа = Новый Структура;
	Для Каждого Реквизит Из ИсходнаяГруппа Цикл
		Группа.Вставить(Реквизит.Ключ, Реквизит.Значение);
	КонецЦикла;
	ТранспортнаяУпаковка = СокрЛП(СтрокаГруппы.ТранспортнаяУпаковка);
	Если ТипКонтента = "ucd29" Тогда
		// Валидатор УКД 29 читает поле напрямую. Пустая строка означает отсутствие упаковки.
		Группа.Вставить("TransPackageId", ТранспортнаяУпаковка);
	Иначе
		УстановитьНеобязательноеСвойство(Группа, "TransPackageId", ТранспортнаяУпаковка);
	КонецЕсли;
	// Пустые коллекции также необходимы валидатору прото-контента.
	Группа.Вставить("Units", КодыМаркировкиГруппы(КодыМаркировки, СтрокаГруппы.НомерГруппы, "КИЗ"));
	КодыУпаковок = КодыМаркировкиГруппы(КодыМаркировки, СтрокаГруппы.НомерГруппы, "Упаковка");
	Если ТипКонтента = "ucd736" Тогда
		Для Каждого ИмяСвойства Из СтдСтр().СтрРазделитьЛок("GTIN,MarkedItemsQuantity,QuantityWeightMark,BatchCode", ",") Цикл
			Группа.Удалить(ИмяСвойства);
		КонецЦикла;
		Если ЗначениеЗаполнено(СтрокаГруппы.GTIN) Тогда
			КодыУпаковок.Добавить(СформироватьНомерУпаковкиОСУ(СтрокаГруппы));
		КонецЕсли;
		Группа.Вставить("PackageIds", КодыУпаковок);
		Возврат Группа;
	КонецЕсли;
	Если КодироватьГТИНВУпаковке Тогда
		Группа.Удалить("GTIN");
		Группа.Удалить("QuantityWeightMark");
		Группа.Удалить(ИмяРеквизитаКоличестваМаркированныхТоваров);
	ИначеЕсли ТипКонтента = "utd970" Тогда
		// Генератор и валидатор УПД читают эти необязательные поля напрямую.
		Группа.Вставить(ИмяРеквизитаКоличестваМаркированныхТоваров,
			СтрокаГруппы.КоличествоМаркированныхТоваров);
	Иначе
		// Валидатор УКД 29 обращается к полям напрямую, включая незаполненные.
		Группа.Вставить("GTIN", СокрЛП(СтрокаГруппы.GTIN));
		Группа.Вставить(ИмяРеквизитаКоличестваМаркированныхТоваров,
			СтрокаГруппы.КоличествоМаркированныхТоваров);
		Группа.Вставить("QuantityWeightMark", СтрокаГруппы.ВесМаркированныхТоваров);
	КонецЕсли;
	Если ТипКонтента = "utd970" И КодироватьГТИНВУпаковке Тогда
		Группа.Вставить(ИмяРеквизитаКоличестваМаркированныхТоваров, 0);
	КонецЕсли;
	Группа.Вставить("BatchCode", СокрЛП(СтрокаГруппы.КодПартии));
	Если КодироватьГТИНВУпаковке Тогда
		КодыУпаковок.Добавить(СформироватьНомерУпаковкиОСУ(СтрокаГруппы));
	КонецЕсли;
	Группа.Вставить("PackageIds", КодыУпаковок);
	Возврат Группа;

КонецФункции

Процедура УстановитьПартиюУКД736(СтрокаКонтента, Модель, НомерСтроки, Состояние)

	Ключ = ?(Состояние = "До", "ПрПартМаркДо", "ПрПартМаркПосле");
	НомерПартии = "";
	Для Каждого Группа Из Модель.ГруппыМаркировки.НайтиСтроки(
		Новый Структура("НомерСтроки,Состояние", НомерСтроки, Состояние)) Цикл
		Если ЗначениеЗаполнено(Группа.КодПартии) Тогда
			НомерПартии = СокрЛП(Группа.КодПартии);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ДополнительныеСведения = СвойствоСтруктуры(СтрокаКонтента, "StructedAdditionalInfos", Новый Массив);
	Если ТипЗнч(ДополнительныеСведения) <> Тип("Массив") Тогда
		ДополнительныеСведения = Новый Массив;
	КонецЕсли;
	Индекс = ДополнительныеСведения.ВГраница();
	Пока Индекс >= 0 Цикл
		Если СвойствоСтруктуры(ДополнительныеСведения[Индекс], "Key", "") = Ключ Тогда
			ДополнительныеСведения.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Если ЗначениеЗаполнено(НомерПартии) Тогда
		ДополнительныеСведения.Добавить(Новый Структура("Key,Value", Ключ, НомерПартии));
	КонецЕсли;
	СтрокаКонтента.Вставить("StructedAdditionalInfos", ДополнительныеСведения);

КонецПроцедуры

Функция РазобратьНомерУпаковкиОСУ(КодУпаковки)

	ДлинаИдентификатораГТИН = 2;
	ДлинаГТИН = 14;
	ДлинаИдентификатораВеса = 4;
	ДлинаВесаВГраммах = 9;
	ДлинаКоличества = 8;
	ГраммовВКилограмме = 1000;
	НачалоГТИН = ДлинаИдентификатораГТИН + 1;
	НачалоИдентификатораКоличества = НачалоГТИН + ДлинаГТИН;
	НачалоКоличества = НачалоИдентификатораКоличества + ДлинаИдентификатораГТИН;
	ДлинаОкончанияСВесом = ДлинаИдентификатораВеса + ДлинаВесаВГраммах;

	Код = СокрЛП(КодУпаковки);
	Если СтрДлина(Код) < НачалоКоличества
		ИЛИ Лев(Код, ДлинаИдентификатораГТИН) <> "02"
		ИЛИ Сред(Код, НачалоИдентификатораКоличества, ДлинаИдентификатораГТИН) <> "37" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Остаток = Сред(Код, НачалоКоличества);
	// Идентификатор веса может встречаться внутри количества, поэтому проверяем окончание кода.
	ПозицияВеса = 0;
	Если СтрДлина(Остаток) >= ДлинаОкончанияСВесом + 1
		И Сред(Остаток, СтрДлина(Остаток) - ДлинаОкончанияСВесом + 1, ДлинаИдентификатораВеса) = "3103" Тогда
		ПозицияВеса = СтрДлина(Остаток) - ДлинаОкончанияСВесом + 1;
	КонецЕсли;
	Количество = ?(ПозицияВеса = 0, Остаток, Лев(Остаток, ПозицияВеса - 1));
	Вес = ?(ПозицияВеса = 0, "", Сред(Остаток, ПозицияВеса + ДлинаИдентификатораВеса));
	НекорректныйГТИН = НЕ СтрокаСодержитТолькоЦифры(Сред(Код, НачалоГТИН, ДлинаГТИН));
	НекорректноеКоличество = СтрДлина(Количество) < 1 ИЛИ СтрДлина(Количество) > ДлинаКоличества
		ИЛИ НЕ СтрокаСодержитТолькоЦифры(Количество);
	НекорректныйВес = ПозицияВеса > 0
		И (СтрДлина(Вес) <> ДлинаВесаВГраммах ИЛИ НЕ СтрокаСодержитТолькоЦифры(Вес));
	Если НекорректныйГТИН ИЛИ НекорректноеКоличество ИЛИ НекорректныйВес Тогда
		Возврат Неопределено;
	КонецЕсли;
	ГТИН = Сред(Код, НачалоГТИН, ДлинаГТИН);
	КоличествоУпаковок = Число(Количество);
	ВесВКилограммах = ?(ПозицияВеса = 0, 0, Число(Вес) / ГраммовВКилограмме);
	Возврат Новый Структура("GTIN,Количество,Вес", ГТИН, КоличествоУпаковок, ВесВКилограммах);

КонецФункции

Функция СформироватьНомерУпаковкиОСУ(Группа)

	ГраммовВКилограмме = 1000;

	Результат = "02" + СокрЛП(Группа.GTIN) + "37"
		+ Формат(Группа.КоличествоМаркированныхТоваров, "ЧГ=0; ЧДЦ=0");
	Если ЗначениеЗаполнено(Группа.ВесМаркированныхТоваров) Тогда
		ВесВГраммах = Цел(Группа.ВесМаркированныхТоваров * ГраммовВКилограмме);
		Результат = Результат + "3103" + Формат(ВесВГраммах, "ЧЦ=9; ЧВН=; ЧГ=0");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция СтрокаСодержитТолькоЦифры(Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтдСтр().СтрНайтиЛок("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Процедура УстановитьНеобязательноеСвойство(Структура, ИмяСвойства, Значение)

	ЗначениеСвойстваЗаполнено = ЗначениеЗаполнено(Значение);
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		ЗначениеСвойстваЗаполнено = Значение.Количество() > 0;
	КонецЕсли;
	Если ЗначениеСвойстваЗаполнено Тогда
		Структура.Вставить(ИмяСвойства, Значение);
	Иначе
		Структура.Удалить(ИмяСвойства);
	КонецЕсли;

КонецПроцедуры

Процедура ПрименитьЗначенияСтроки(СтрокаКонтента, СтрокаМодели)

	УстановитьЕдиницуИзмерения(СтрокаКонтента, СтрокаМодели.КодЕдиницы);
	СтрокаКонтента.Вставить("UnitName", СокрЛП(СтрокаМодели.Единица));
	СтрокаКонтента.Вставить("Quantity", СтрокаМодели.Количество);
	СтрокаКонтента.Вставить("Price", СтрокаМодели.Цена);
	СтрокаКонтента.Вставить("TaxRate", СокрЛП(СтрокаМодели.СтавкаНДС));
	СтрокаКонтента.Вставить("WithoutVat", СтрокаМодели.БезНДС);
	СтрокаКонтента.Вставить("SubtotalWithVatExcluded", СтрокаМодели.СуммаБезНДС);
	СтрокаКонтента.Вставить("Vat", СтрокаМодели.СуммаНДС);
	СтрокаКонтента.Вставить("Subtotal", СтрокаМодели.Сумма);

КонецПроцедуры

Процедура ПрименитьЗначенияСтрокиУКД(СтрокаКонтента, СтрокаМодели)

	ИсправленныеЗначения = СвойствоСтруктуры(СтрокаКонтента, "CorrectedValues", Новый Структура);
	ИсправленныеЗначения.Вставить("UnitCode", СокрЛП(СтрокаМодели.КодЕдиницы));
	ИсправленныеЗначения.Вставить("UnitName", СокрЛП(СтрокаМодели.Единица));
	ИсправленныеЗначения.Вставить("Quantity", СтрокаМодели.Количество);
	ИсправленныеЗначения.Вставить("Price", СтрокаМодели.Цена);
	ИсправленныеЗначения.Вставить("TaxRate", СокрЛП(СтрокаМодели.СтавкаНДС));
	ИсправленныеЗначения.Вставить("WithoutVat", СтрокаМодели.БезНДС);
	ИсправленныеЗначения.Вставить("TotalWithVatExcluded", СтрокаМодели.СуммаБезНДС);
	ИсправленныеЗначения.Вставить("Vat", СтрокаМодели.СуммаНДС);
	ИсправленныеЗначения.Вставить("Total", СтрокаМодели.Сумма);
	СтрокаКонтента.Вставить("CorrectedValues", ИсправленныеЗначения);

	Увеличение = СвойствоСтруктуры(СтрокаКонтента, "AmountsInc", Новый Структура);
	Уменьшение = СвойствоСтруктуры(СтрокаКонтента, "AmountsDec", Новый Структура);
	ЗаполнитьСуммуИзменения(Увеличение, Уменьшение, "TotalWithVatExcluded", СтрокаМодели.ИзменениеСуммыБезНДС);
	ЗаполнитьСуммуИзменения(Увеличение, Уменьшение, "Vat", СтрокаМодели.ИзменениеНДС);
	ЗаполнитьСуммуИзменения(Увеличение, Уменьшение, "Total", СтрокаМодели.ИзменениеСуммы);
	СтрокаКонтента.Вставить("AmountsInc", Увеличение);
	СтрокаКонтента.Вставить("AmountsDec", Уменьшение);

КонецПроцедуры

Процедура ЗаполнитьСуммуИзменения(Увеличение, Уменьшение, ИмяПоля, Разница)

	Увеличение.Вставить(ИмяПоля, ?(Разница > 0, Разница, 0));
	Уменьшение.Вставить(ИмяПоля, ?(Разница < 0, -Разница, 0));

КонецПроцедуры

Процедура УстановитьУвеличениеИУменьшение(Структура, ПолеУвеличения, ПолеУменьшения, Разница)

	Структура.Вставить(ПолеУвеличения, ?(Разница > 0, Разница, 0));
	Структура.Вставить(ПолеУменьшения, ?(Разница < 0, -Разница, 0));

КонецПроцедуры

Процедура ПрименитьИтогиУКД(ТаблицаКонтента, Товары)

	ИтогиУвеличения = СвойствоСтруктуры(ТаблицаКонтента, "TotalsInc", Новый Структура);
	ИтогиУменьшения = СвойствоСтруктуры(ТаблицаКонтента, "TotalsDec", Новый Структура);
	Для Каждого ИмяПоля Из СтдСтр().СтрРазделитьЛок("TotalWithVatExcluded,Vat,Total", ",") Цикл
		СуммаУвеличения = 0;
		СуммаУменьшения = 0;
		Для Каждого СтрокаМодели Из Товары Цикл
			Если ИмяПоля = "TotalWithVatExcluded" Тогда
				Разница = СтрокаМодели.ИзменениеСуммыБезНДС;
			ИначеЕсли ИмяПоля = "Vat" Тогда
				Разница = СтрокаМодели.ИзменениеНДС;
			Иначе
				Разница = СтрокаМодели.ИзменениеСуммы;
			КонецЕсли;
			Если Разница > 0 Тогда
				СуммаУвеличения = СуммаУвеличения + Разница;
			Иначе
				СуммаУменьшения = СуммаУменьшения - Разница;
			КонецЕсли;
		КонецЦикла;
		ИтогиУвеличения.Вставить(ИмяПоля, СуммаУвеличения);
		ИтогиУменьшения.Вставить(ИмяПоля, СуммаУменьшения);
	КонецЦикла;
	ТаблицаКонтента.Вставить("TotalsInc", ИтогиУвеличения);
	ТаблицаКонтента.Вставить("TotalsDec", ИтогиУменьшения);

КонецПроцедуры

Функция КодыМаркировкиГруппы(ТаблицаКодов, НомерГруппы, ВидКода)

	Результат = Новый Массив;
	Отбор = Новый Структура("НомерГруппы,ВидКода", НомерГруппы, ВидКода);
	Для Каждого СтрокаКода Из ТаблицаКодов.НайтиСтроки(Отбор) Цикл
		Результат.Добавить(СокрЛП(СтрокаКода.Код));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИсходнаяСтруктура(Коллекция, ИсходныйИндекс)

	ЕстьИсходнаяСтруктура = ТипЗнч(Коллекция) = Тип("Массив")
		И ИсходныйИндекс > 0
		И ИсходныйИндекс <= Коллекция.Количество()
		И ТипЗнч(Коллекция[ИсходныйИндекс - 1]) = Тип("Структура");
	Если ЕстьИсходнаяСтруктура Тогда
		Возврат Коллекция[ИсходныйИндекс - 1];
	КонецЕсли;
	Возврат Новый Структура;

КонецФункции

Процедура ОбновитьПризнакиТоваровДокумента(Контент)

	ИмяТипаСтруктуры = "Структура";

	ЕстьПрослеживаемость = Ложь;
	ЕстьМаркировка = Ложь;
	Если ТипЗнч(СвойствоСтруктуры(Контент, "Table")) = Тип(ИмяТипаСтруктуры) Тогда
		ТоварыКонтента = Контент.Table.Items;
	Иначе
		ТоварыКонтента = Контент.InvoiceCorrectionTable.Items;
	КонецЕсли;
	Для Каждого СтрокаКонтента Из ТоварыКонтента Цикл
		ЕстьПрослеживаемость = ЕстьПрослеживаемость
			Или КоличествоЭлементов(СвойствоСтруктуры(СтрокаКонтента, "ItemTracingInfos")) > 0;
		ЕстьМаркировка = ЕстьМаркировка
			Или КоличествоЭлементов(СвойствоСтруктуры(СтрокаКонтента, "ItemIdentificationNumbers")) > 0
			Или КоличествоЭлементов(СвойствоСтруктуры(СтрокаКонтента, "OriginalItemIdentificationNumbers")) > 0
			Или КоличествоЭлементов(СвойствоСтруктуры(СтрокаКонтента, "CorrectedItemIdentificationNumbers")) > 0;
	КонецЦикла;

	СлужебнаяИнформация = СвойствоСтруктуры(Контент, "СлужебнаяИнформация");
	Если ТипЗнч(СлужебнаяИнформация) <> Тип(ИмяТипаСтруктуры) Тогда
		СлужебнаяИнформация = Новый Структура;
		Контент.Вставить("СлужебнаяИнформация", СлужебнаяИнформация);
	КонецЕсли;
	Признаки = СвойствоСтруктуры(СлужебнаяИнформация, "ContentsDocumentProductsType");
	Если ТипЗнч(Признаки) <> Тип(ИмяТипаСтруктуры) Тогда
		Признаки = Новый Структура;
		СлужебнаяИнформация.Вставить("ContentsDocumentProductsType", Признаки);
	КонецЕсли;
	Признаки.Вставить("ContainsTraceableProducts", ЕстьПрослеживаемость);
	Признаки.Вставить("ContainsMarkedProducts", ЕстьМаркировка);

КонецПроцедуры

Функция КоличествоЭлементов(Коллекция)

	Если ТипЗнч(Коллекция) = Тип("Массив") Тогда
		Возврат Коллекция.Количество();
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция СтрокаИзМассива(Значения)

	Если ТипЗнч(Значения) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтдСтр().СтрСоединитьЛок(Значения, Символы.ПС);

КонецФункции

Функция МассивИзСтроки(Текст)

	Результат = Новый Массив;
	Для Каждого СтрокаЗначения Из СтдСтр().СтрРазделитьЛок(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Значение = СокрЛП(СтрокаЗначения);
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СоединитьЧастиАдреса(Адрес, ИменаПолей)

	Части = Новый Массив;
	Для Каждого ИмяПоля Из СтдСтр().СтрРазделитьЛок(ИменаПолей, ",") Цикл
		ЗначениеПоля = СвойствоСтруктуры(Адрес, ИмяПоля, "");
		Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
			Части.Добавить(Строка(ЗначениеПоля));
		КонецЕсли;
	КонецЦикла;
	Возврат СтдСтр().СтрСоединитьЛок(Части, ", ");

КонецФункции

Функция СтавкаНДСЧислом(СтавкаНДС, БезНДС)

	Если БезНДС Или НРег(СокрЛП(СтавкаНДС)) = НРег("Без НДС") Тогда
		Возврат 0;
	КонецЕсли;

	СтрокаСтавки = СтрЗаменить(СокрЛП(СтавкаНДС), "%", "");
	Если СтдСтр().СтрНайтиЛок(СтрокаСтавки, "/") > 0 ИЛИ НРег(СтрокаСтавки) = НРег("ИсчНалАг")
		ИЛИ НЕ СтрокаСодержитТолькоЦифры(СтрокаСтавки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(СтрокаСтавки);

КонецФункции

Процедура ПроверитьСтавкуНДС(СтавкаНДС)

	НормализованнаяСтавка = НРег(СокрЛП(СтрЗаменить(СтавкаНДС, "%", "")));
	ДопустимыеСтавки = Новый Соответствие;
	Для Каждого ЗначениеСтавки Из ДопустимыеСтавкиНДС() Цикл
		ДопустимыеСтавки.Вставить(НРег(ЗначениеСтавки), Истина);
	КонецЦикла;
	Если ДопустимыеСтавки.Получить(НормализованнаяСтавка) = Неопределено Тогда
		ВызватьИсключение СтдСтр().СтрШаблонЛок("Недопустимая ставка НДС: %1.", СтавкаНДС);
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьЕдиницуИзмерения(СтрокаКонтента, КодЕдиницы)

	Если СтрокаКонтента.Свойство("Unit") Тогда
		СтрокаКонтента.Вставить("Unit", СокрЛП(КодЕдиницы));
	Иначе
		СтрокаКонтента.Вставить("UnitCode", СокрЛП(КодЕдиницы));
	КонецЕсли;

КонецПроцедуры

Функция СвойствоСтруктуры(Структура, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)

	Значение = Неопределено;
	Если ТипЗнч(Структура) = Тип("Структура")
		И Структура.Свойство(ИмяСвойства, Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// #КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Подключение библиотеки для встроенного и внешнего режимов основной обработки.

Функция СтдСтр() Экспорт

	Если СтдСтрКэш = Неопределено Тогда
		СвойстваОбработки = Новый Структура("ИспользуемоеИмяФайла");
		ЗаполнитьЗначенияСвойств(СвойстваОбработки, ЭтотОбъект);
		Если СвойстваОбработки.ИспользуемоеИмяФайла <> Неопределено Тогда
			СтдСтрКэш = Новый("ExternalDataProcessorObject.КонтурДиадокСтдСтр");
		Иначе
			СтдСтрКэш = Новый("DataProcessorObject.КонтурДиадокСтдСтр");
		КонецЕсли;
	КонецЕсли;

	Возврат СтдСтрКэш;

КонецФункции

Функция КонтурДиадокГенерацияXML() Экспорт

	Если КонтурДиадокГенерацияXMLКэш = Неопределено Тогда
		СвойстваОбработки = Новый Структура("ИспользуемоеИмяФайла");
		ЗаполнитьЗначенияСвойств(СвойстваОбработки, ЭтотОбъект);
		Если СвойстваОбработки.ИспользуемоеИмяФайла <> Неопределено Тогда
			КонтурДиадокГенерацияXMLКэш = Новый("ExternalDataProcessorObject.КонтурДиадокГенерацияXML");
		Иначе
			КонтурДиадокГенерацияXMLКэш = Новый("DataProcessorObject.КонтурДиадокГенерацияXML");
		КонецЕсли;
	КонецЕсли;

	Возврат КонтурДиадокГенерацияXMLКэш;

КонецФункции
