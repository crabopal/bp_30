// Клиентская форма-модуль редактора, подключенная в том же режиме.
// Переменная используется в другом методе корневого модуля.
// BSLLS:UnusedLocalVariable-off
// BSLLS:MissingVariablesDescription-off
&НаКлиенте
Перем КлиентскийМодульКэш;
// BSLLS:UnusedLocalVariable-on
// BSLLS:MissingVariablesDescription-on

// #Область СлужебныйПрограммныйИнтерфейс

&НаКлиенте
Процедура АдресЗакрыт(АдресРезультата, ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(АдресРезультата) Тогда
		ПрименитьАдресНаСервере(АдресРезультата);
		ПоказатьКарточкуСтороны(ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбработкаРедактора = РеквизитФормыВЗначение("Объект");
	МодульСтрокРедактора = ОбработкаРедактора.СтдСтр();
	РежимДополнительно = "Дополнительно";
	
	ЭтаФорма.ПолноеИмяОбработкиРедактора = ОбработкаРедактора.Метаданные().ПолноеИмя();
	АдресДанных = "";
	Если Не Параметры.Свойство("АдресДанных", АдресДанных) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	// Этот адрес используется повторно для результата. Удаляет его форма-владелец после получения.
	// BSLLS:MissingTempStorageDeletion-off
	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	// BSLLS:MissingTempStorageDeletion-on
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ЭтаФорма.АдресДанныхРедактора = АдресДанных;
	Режим = Данные.Режим;
	Если МодульСтрокРедактора.СтрРазделитьЛок("Продавцы,Покупатели,"
		+ "Грузоотправители,Грузополучатели,Дополнительно", ",").Найти(Режим) = Неопределено Тогда
		ВызватьИсключение "Неизвестный раздел реквизитов документа.";
	КонецЕсли;
	Для Каждого ИмяТаблицы Из МодульСтрокРедактора.СтрРазделитьЛок(
		"Продавцы,Покупатели,Грузоотправители,Грузополучатели,СтраныМира,ДополнительныеСведенияДокумента", ",") Цикл
		ЗначениеВРеквизитФормы(Данные.Модель[ИмяТаблицы], ИмяТаблицы);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Данные.Модель,
		"ТипКонтента,ФункцияДокумента,ИдентификаторФайлаИнформационногоПоля,"
		+ "ИдентификаторГосударственногоКонтракта,ОбстоятельствоФормирования");
	Элементы.РегистрацияИП.Видимость = Режим = "Покупатели" И ТипКонтента = "ucd29"
		И Покупатели[0].Тип = "IndividualEntity";
	Элементы.КарточкаСтороны.Видимость = Режим <> РежимДополнительно;
	Элементы.ДополнительныеРеквизиты.Видимость = Режим = РежимДополнительно;
	Если Режим = РежимДополнительно Тогда
		ЭтаФорма.Заголовок = "Дополнительные реквизиты документа";
	Иначе
		Названия = Новый Структура;
		Названия.Вставить("Продавцы", "Организация");
		Названия.Вставить("Покупатели", "Покупатель");
		Названия.Вставить("Грузоотправители", "Грузоотправитель");
		Названия.Вставить("Грузополучатели", "Грузополучатель");
		ЭтаФорма.Заголовок = Названия[Режим];
		Стороны = ЭтаФорма[Режим];
		Элементы.НомерУчастника.Видимость = Стороны.Количество() > 1;
		Для Индекс = 0 По Стороны.Количество() - 1 Цикл
			Элементы.НомерУчастника.СписокВыбора.Добавить(Индекс + 1,
				МодульСтрокРедактора.СтрШаблонЛок("%1. %2", Индекс + 1, Стороны[Индекс].Наименование));
		КонецЦикла;
		НомерУчастника = ?(Стороны.Количество() > 0, 1, 0);
		ЭтаФорма.ПредыдущийНомерУчастника = НомерУчастника;
		ПоказатьКарточкуСтороны(ЭтаФорма);
	КонецЕсли;
	Настройка = ОбработкаРедактора
		.НастройкаОбстоятельстваФормирования(ТипКонтента, ФункцияДокумента);
	Элементы.ОбстоятельствоФормирования.РежимВыбораИзСписка = Настройка.ТолькоВыбор;
	Элементы.ОбстоятельствоФормирования.РедактированиеТекста = Не Настройка.ТолькоВыбор;
	Для Каждого Значение Из Настройка.ДопустимыеЗначения Цикл
		Элементы.ОбстоятельствоФормирования.СписокВыбора.Добавить(Значение);
	КонецЦикла;

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НомерУчастникаПриИзменении(Элемент)

	ЗаписатьКарточкуСтороны();
	ЭтаФорма.ПредыдущийНомерУчастника = НомерУчастника;
	ПоказатьКарточкуСтороны(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура АдресНажатие(Элемент)

	ЗаписатьКарточкуСтороны();
	АдресДанных = ПодготовитьАдресНаСервере();
	ПараметрыФормы = Новый Структура("АдресДанных", АдресДанных);
	ПолноеИмяФормы = ПолноеИмяОбработкиРедактора + ".Форма.РедакторАдреса";
	Оповещение = КлиентскийМодуль().Стд().ОбщегоНазначения().ОписаниеОповещения("АдресЗакрыт", ЭтаФорма);
	КлиентскийМодуль().СинхронныеМодальныеВызовы().смв_ОткрытьФорму(
		ПолноеИмяФормы, ПараметрыФормы, ЭтаФорма, Истина, , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьДополнительноеСведениеДокумента(Команда)

	НоваяСтрока = ДополнительныеСведенияДокумента.Добавить();
	НоваяСтрока.ИсходныйИндекс = -1;
	Элементы.ДополнительныеСведенияДокумента.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	Элементы.ДополнительныеСведенияДокумента.ТекущийЭлемент = Элементы.ДополнительныеСведенияДокументаКлюч;
	ЭтаФорма.ТекущийЭлемент = Элементы.ДополнительныеСведенияДокумента;

КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)

	Если Элементы.РегистрацияИП.Видимость Тогда
		ВладелецФормы.Метрика_ДобавитьПоведениеРедактораДокументов(
			"РедакторПокупатель", "Применить", "РедакторПокупатель");
	КонецЕсли;
	ЗаписатьКарточкуСтороны();
	Попытка
		АдресРезультата = СохранитьРезультатНаСервере();
	Исключение
		КлиентскийМодуль().СообщитьОбОшибке(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	Закрыть(АдресРезультата);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть(Неопределено);

КонецПроцедуры

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьКарточкуСтороны(Форма)

	ЕстьСторона = Форма.НомерУчастника > 0;
	Форма.Элементы.СторонаНаименование.Доступность = ЕстьСторона;
	Форма.Элементы.СторонаИНН.Доступность = ЕстьСторона;
	Форма.Элементы.СторонаКПП.Доступность = ЕстьСторона;
	Форма.Элементы.СсылкаАдрес.Доступность = ЕстьСторона;
	Если Не ЕстьСторона Тогда
		Форма.Элементы.ПримечаниеСтороны.Заголовок = "Сторона отсутствует в исходном XML. "
			+ "Добавление новых участников не поддерживается.";
		Возврат;
	КонецЕсли;
	Сторона = Форма[Форма.Режим][Форма.НомерУчастника - 1];
	Форма.СторонаНаименование = Сторона.Наименование;
	Форма.СторонаИНН = Сторона.ИНН;
	Форма.СторонаКПП = Сторона.КПП;
	Форма.Элементы.СторонаКПП.Видимость = Сторона.Тип <> "IndividualEntity";
	Форма.Элементы.СторонаНаименование.ТолькоПросмотр = Форма.Элементы.РегистрацияИП.Видимость;
	Форма.Элементы.СторонаИНН.ТолькоПросмотр = Форма.Элементы.РегистрацияИП.Видимость;
	Форма.Элементы.СторонаКПП.ТолькоПросмотр = Форма.Элементы.РегистрацияИП.Видимость;
	Если Форма.Элементы.РегистрацияИП.Видимость Тогда
		Форма.СторонаОГРНИП = Сторона.ОГРНИП;
		Форма.СторонаДатаОГРНИП = Сторона.ДатаОГРНИП;
		Форма.Элементы.СсылкаАдрес.Доступность = Ложь;
	КонецЕсли;
	Форма.Элементы.СсылкаАдрес.Заголовок = "Адрес: " + Сторона.Адрес;
	Форма.Элементы.ПримечаниеСтороны.Заголовок =
		"Изменяются только реквизиты отправляемого XML. Идентификатор участника сохраняется.";
	Если Форма.Режим = "Грузоотправители" И ЗначениеЗаполнено(Сторона.Примечание) Тогда
		Форма.Элементы.ПримечаниеСтороны.Заголовок = Форма.Элементы.ПримечаниеСтороны.Заголовок
			+ Символы.ПС + Сторона.Примечание
			+ ". При изменении реквизитов будет указан отдельным грузоотправителем.";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьКарточкуСтороны()

	Если Режим = "Дополнительно" ИЛИ ПредыдущийНомерУчастника = 0 Тогда
		Возврат;
	КонецЕсли;
	Сторона = ЭтаФорма[Режим][ПредыдущийНомерУчастника - 1];
	Если Элементы.РегистрацияИП.Видимость Тогда
		Сторона.ОГРНИП = СторонаОГРНИП;
		Сторона.ДатаОГРНИП = СторонаДатаОГРНИП;
	КонецЕсли;
	Сторона.Наименование = СторонаНаименование;
	Сторона.ИНН = СторонаИНН;
	Сторона.КПП = СторонаКПП;

КонецПроцедуры

&НаСервере
Функция ПодготовитьАдресНаСервере()

	Сторона = ЭтаФорма[Режим][НомерУчастника - 1];
	Данные = Новый Структура("Адрес,Наименование,СтраныМира",
		ЗначениеИзСтрокиВнутр(Сторона.ДанныеАдреса), Сторона.Наименование,
		РеквизитФормыВЗначение("СтраныМира"));
	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ПрименитьАдресНаСервере(АдресРезультата)

	Адрес = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Адрес) <> Тип("Структура") Тогда
		ВызватьИсключение "Не получен результат редактирования адреса.";
	КонецЕсли;
	Сторона = ЭтаФорма[Режим][НомерУчастника - 1];
	Сторона.ДанныеАдреса = ЗначениеВСтрокуВнутр(Адрес);
	Сторона.Адрес = РеквизитФормыВЗначение("Объект").ПредставлениеАдресаЛок(Адрес);
	УдалитьИзВременногоХранилища(АдресРезультата);

КонецПроцедуры

&НаСервере
Функция СохранитьРезультатНаСервере()

	МодульСтрокРедактора = РеквизитФормыВЗначение("Объект").СтдСтр();
	Модель = Новый Структура;
	Для Каждого ИмяТаблицы Из МодульСтрокРедактора.СтрРазделитьЛок(
		"Продавцы,Покупатели,Грузоотправители,Грузополучатели,ДополнительныеСведенияДокумента", ",") Цикл
		Модель.Вставить(ИмяТаблицы, РеквизитФормыВЗначение(ИмяТаблицы));
	КонецЦикла;
	Для Каждого ИмяРеквизита Из МодульСтрокРедактора.СтрРазделитьЛок(
		"ИдентификаторФайлаИнформационногоПоля,ИдентификаторГосударственногоКонтракта,ОбстоятельствоФормирования", ",") Цикл
		Модель.Вставить(ИмяРеквизита, ЭтаФорма[ИмяРеквизита]);
	КонецЦикла;
	Если Режим = "Дополнительно" Тогда
		РеквизитФормыВЗначение("Объект").ПроверитьДанныеСтроки(
			"ДополнительныеСведения", ТипКонтента, Модель.ДополнительныеСведенияДокумента);
	КонецЕсли;
	Если Элементы.РегистрацияИП.Видимость Тогда
		РеквизитФормыВЗначение("Объект").ПроверитьДанныеСтроки("Сторона", ТипКонтента, Модель.Покупатели[0]);
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(Модель, АдресДанныхРедактора);

КонецФункции

// #КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Общая клиентская точка доступа к библиотекам редактора.

&НаКлиенте
Функция КлиентскийМодуль()

	Если КлиентскийМодульКэш = Неопределено Тогда
		// Совместимость с 8.2; получаем форму-модуль без открытия окна.
		// BSLLS:DeprecatedFind-off
		ПутьКОбработке = Лев(ИмяФормы, Найти(ИмяФормы, ".Форма.") - 1);
		// BSLLS:DeprecatedFind-on
		// BSLLS:GetFormMethod-off
		КлиентскийМодульКэш = ПолучитьФорму(ПутьКОбработке + ".Форма.Клиент", , ЭтаФорма);
		// BSLLS:GetFormMethod-on
	КонецЕсли;
	Возврат КлиентскийМодульКэш;

КонецФункции
