// Клиентская форма-модуль редактора, подключенная в том же режиме.
// Переменная используется в другом методе корневого модуля.
// BSLLS:UnusedLocalVariable-off
// BSLLS:MissingVariablesDescription-off
&НаКлиенте
Перем КлиентскийМодульКэш;
// BSLLS:UnusedLocalVariable-on
// BSLLS:MissingVariablesDescription-on

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресДанных = "";
	Если Не Параметры.Свойство("АдресДанных", АдресДанных) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Этот адрес используется повторно для результата. Удаляет его форма-владелец после получения.
	// BSLLS:MissingTempStorageDeletion-off
	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	// BSLLS:MissingTempStorageDeletion-on
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЭтаФорма.АдресДанныхРедактора = АдресДанных;
	ЭтаФорма.НомерСтроки = Данные.НомерСтроки;
	ЭтаФорма.Товар = Данные.Товар;
	ЭтаФорма.ТипКонтента = Данные.ТипКонтента;
	ЗначениеВРеквизитФормы(Данные.Декларации, "Декларации");
	ЗначениеВРеквизитФормы(Данные.СтраныМира, "СтраныМира");
	НастроитьФормуПоТипуКонтента();

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДекларацииНаименованиеСтраныУПДПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.Декларации.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущаяСтрока.НаименованияСтран = СокрЛП(ТекущаяСтрока.НаименованияСтран);
	ТекущаяСтрока.КодСтраны = "";
	Для Каждого Страна Из СтраныМира Цикл
		Если Страна.Наименование = ТекущаяСтрока.НаименованияСтран Тогда
			ТекущаяСтрока.КодСтраны = Страна.Код;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьДекларацию(Команда)

	НоваяСтрока = Декларации.Добавить();
	НоваяСтрока.ИсходныйИндекс = -1;
	НоваяСтрока.НомерСтроки = НомерСтроки;
	НоваяСтрока.Товар = Товар;

КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)

	Попытка
		АдресРезультата = СохранитьРезультатНаСервере();
	Исключение
		КлиентскийМодуль().СообщитьОбОшибке(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	Закрыть(АдресРезультата);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть();

КонецПроцедуры

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СохранитьРезультатНаСервере()

	Таблица = РеквизитФормыВЗначение("Декларации");
	Редактор = РеквизитФормыВЗначение("Объект");
	Редактор.ПроверитьДанныеСтроки(
		"Декларации", ТипКонтента, Таблица, РеквизитФормыВЗначение("СтраныМира"));

	Данные = Новый Структура("НомерСтроки,Декларации", НомерСтроки, Таблица);
	Возврат ПоместитьВоВременноеХранилище(Данные, АдресДанныхРедактора);

КонецФункции

&НаСервере
Процедура НастроитьФормуПоТипуКонтента()

	ЭтоУКД = НРег(ТипКонтента) = "ucd29";
	Элементы.ДекларацииКодСтраны.Видимость = ЭтоУКД;
	Элементы.ДекларацииНаименованиеСтраныУПД.Видимость = Не ЭтоУКД;
	Элементы.ДекларацииНомерДТ.Видимость = Не ЭтоУКД;
	Элементы.ДекларацииНаименованияСтранУКД.Видимость = ЭтоУКД;
	Элементы.ДекларацииНомерДТДо.Видимость = ЭтоУКД;
	Элементы.ДекларацииНомерДТПосле.Видимость = ЭтоУКД;
	Элементы.ДекларацииНомераДТУвеличение.Видимость = ЭтоУКД;
	Элементы.ДекларацииНомераДТУменьшение.Видимость = ЭтоУКД;
	Если ЭтоУКД Тогда
		Элементы.Пояснение.Заголовок =
			"Для нескольких стран или номеров изменения указывайте каждое значение с новой строки.";
	Иначе
		Элементы.Пояснение.Заголовок =
			"Код страны и номер ДТ относятся к декларации, а не к РНПТ. Наименование страны формируется по коду.";
	КонецЕсли;
	Элементы.ДекларацииКодСтраны.СписокВыбора.Очистить();
	Элементы.ДекларацииНаименованиеСтраныУПД.СписокВыбора.Очистить();
	Для Каждого Страна Из СтраныМира Цикл
		Элементы.ДекларацииКодСтраны.СписокВыбора.Добавить(Страна.Код,
			Страна.Код + ", " + Страна.Наименование);
		Элементы.ДекларацииНаименованиеСтраныУПД.СписокВыбора.Добавить(Страна.Наименование,
			Страна.Код + ", " + Страна.Наименование);
	КонецЦикла;

КонецПроцедуры

// #КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Общая клиентская точка доступа к библиотекам редактора.

&НаКлиенте
Функция КлиентскийМодуль()

	Если КлиентскийМодульКэш = Неопределено Тогда
		// Совместимость с 8.2; получаем форму-модуль без открытия окна.
		// BSLLS:DeprecatedFind-off
		ПутьКОбработке = Лев(ИмяФормы, Найти(ИмяФормы, ".Форма.") - 1);
		// BSLLS:DeprecatedFind-on
		// BSLLS:GetFormMethod-off
		КлиентскийМодульКэш = ПолучитьФорму(ПутьКОбработке + ".Форма.Клиент", , ЭтаФорма);
		// BSLLS:GetFormMethod-on
	КонецЕсли;
	Возврат КлиентскийМодульКэш;

КонецФункции
