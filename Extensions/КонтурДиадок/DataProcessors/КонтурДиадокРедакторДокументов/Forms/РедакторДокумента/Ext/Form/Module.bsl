// Клиентская форма-модуль редактора, подключенная в том же режиме.
// Переменная используется в другом методе корневого модуля.
// BSLLS:UnusedLocalVariable-off
// BSLLS:MissingVariablesDescription-off
&НаКлиенте
Перем КлиентскийМодульКэш;
// BSLLS:UnusedLocalVariable-on
// BSLLS:MissingVariablesDescription-on

// #Область СлужебныйПрограммныйИнтерфейс

&НаКлиенте
Процедура ШапкаЗакрыта(АдресРезультата, ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(АдресРезультата) Тогда
		ПрименитьШапкуНаСервере(АдресРезультата);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РедакторСтрокиЗакрыт(АдресРезультата, ПараметрыОповещения) Экспорт

	Если Не ЗначениеЗаполнено(АдресРезультата) Тогда
		Возврат;
	КонецЕсли;
	Если ПараметрыОповещения.ИмяТаблицы = "Маркировка" Тогда
		ПрименитьМаркировкуНаСервере(АдресРезультата);
	Иначе
		ПрименитьДанныеСтрокиНаСервере(АдресРезультата,
			ПараметрыОповещения.ИмяТаблицы, ПараметрыОповещения.ИмяСвойства);
	КонецЕсли;

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбработкаРедактора = РеквизитФормыВЗначение("Объект");
	МодульСтрокРедактора = ОбработкаРедактора.СтдСтр();
	ИмяТаблицыСтран = "СтраныМира";
	
	ЭтаФорма.ПолноеИмяОбработкиРедактора = ОбработкаРедактора.Метаданные().ПолноеИмя();
	ДокументФормы = Неопределено;
	Если Не Параметры.Свойство("Документ", ДокументФормы) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Документ = ДокументФормы;
	СтраныДляФормы = Неопределено;
	Если Параметры.Свойство(ИмяТаблицыСтран, СтраныДляФормы)
		И ТипЗнч(СтраныДляФормы) = Тип("Массив") Тогда
		ТаблицаСтран = РеквизитФормыВЗначение(ИмяТаблицыСтран);
		Для Каждого Страна Из СтраныДляФормы Цикл
			Если ТипЗнч(Страна) = Тип("Структура") Тогда
				НоваяСтрана = ТаблицаСтран.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрана, Страна, "Код,Наименование");
			КонецЕсли;
		КонецЦикла;
		ЗначениеВРеквизитФормы(ТаблицаСтран, ИмяТаблицыСтран);
	КонецЕсли;
	Модель = ОбработкаРедактора.МодельРедактирования(Документ);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Модель,
		"ТипКонтента,НомерДокумента,ДатаДокумента,ФункцияДокумента,"
			+ "ИдентификаторФайлаИнформационногоПоля,ИдентификаторГосударственногоКонтракта,ОбстоятельствоФормирования");
	ЗначениеВРеквизитФормы(Модель.Продавцы, "Продавцы");
	ЗначениеВРеквизитФормы(Модель.Покупатели, "Покупатели");
	ЗначениеВРеквизитФормы(Модель.Грузоотправители, "Грузоотправители");
	ЗначениеВРеквизитФормы(Модель.Грузополучатели, "Грузополучатели");
	// В форме есть служебные колонки до/после, отсутствующие в модели документа.
	Товары.Загрузить(Модель.Товары);
	Для Каждого СтрокаТовара Из Товары Цикл
		СтрокаТовара.МоментДо = "До";
		СтрокаТовара.МоментПосле = "После";
	КонецЦикла;
	ЗначениеВРеквизитФормы(Модель.Декларации, "Декларации");
	ЗначениеВРеквизитФормы(Модель.Прослеживаемость, "Прослеживаемость");
	ЗначениеВРеквизитФормы(Модель.ГруппыМаркировки, "ГруппыМаркировки");
	ЗначениеВРеквизитФормы(Модель.КодыМаркировки, "КодыМаркировки");
	ЗначениеВРеквизитФормы(Модель.ДополнительныеСведенияДокумента, "ДополнительныеСведенияДокумента");
	ЗначениеВРеквизитФормы(Модель.ДополнительныеСведенияТоваров, "ДополнительныеСведенияТоваров");
	ОбновитьИтогиНаСервере();
	НастроитьФормуПоТипуКонтента();
	ОбновитьСсылкиШапкиДляФормы(ЭтаФорма);

	// В первой версии интерфейса доступно только редактирование маркировки.
	// Остальные элементы и обработчики сохранены для последующего включения.
	Для Каждого ЭлементФормы Из Элементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы")
			И ЭлементФормы.Имя <> "ТоварыМаркировка" Тогда
			ЭлементФормы.Доступность = Ложь;
		КонецЕсли;
	КонецЦикла;
	// Видимость, в отличие от пользовательской видимости, нельзя вернуть настройкой формы.
	Элементы.ТоварыГруппаЕдиницаИКод.Заголовок = "Ед. изм.";
	Элементы.ТоварыГруппаЕдиница.Заголовок = "Ед. изм.";
	Для Каждого ИмяЭлемента Из МодульСтрокРедактора.СтрРазделитьЛок(
		"Итоги,ИтогоБезНДС,ИтогоНДС,Итого,СсылкиШапки,"
		+ "ТоварыГруппаКодЕдиницы,ТоварыКодЕдиницыДо,ТоварыКодЕдиницы,"
		+ "ТоварыГруппаСтавкаНДС,ТоварыСтавкаНДСДо,ТоварыСтавкаНДС,"
		+ "ТоварыГруппаСуммаБезНДС,ТоварыСуммаБезНДСДо,ТоварыСуммаБезНДС,"
		+ "ТоварыСуммаНДС,ТоварыСумма,ТоварыИзменениеСуммы,"
		+ "СсылкаПродавцы,СсылкаПокупатели,СсылкаГрузоотправители,СсылкаГрузополучатели,"
		+ "СсылкаДополнительныеСведенияДокумента,ТоварыГруппаПроисхождение,"
		+ "ТоварыДекларации,ТоварыПрослеживаемость,ТоварыДополнительныеСведения", ",") Цикл
		Элементы[ИмяЭлемента].Видимость = Ложь;
		Элементы[ИмяЭлемента].Доступность = Ложь;
	КонецЦикла;
	ПоказыватьПокупателя = ТипКонтента = "ucd29" И Модель.Покупатели[0].Тип = "IndividualEntity";
	Элементы.СсылкиШапки.Видимость = ПоказыватьПокупателя;
	Элементы.СсылкиШапки.Доступность = ПоказыватьПокупателя;
	Элементы.СсылкаПокупатели.Видимость = ПоказыватьПокупателя;
	Элементы.СсылкаПокупатели.Доступность = ПоказыватьПокупателя;

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СсылкаШапкиНажатие(Элемент)

	Если Элемент.Имя = "СсылкаПродавцы" Тогда
		Режим = "Продавцы";
	ИначеЕсли Элемент.Имя = "СсылкаПокупатели" Тогда
		Метрика_ДобавитьПоведениеРедактораДокументов("РедакторДокумента", "Покупатель", "РедакторДокумента");
		Режим = "Покупатели";
	ИначеЕсли Элемент.Имя = "СсылкаГрузоотправители" Тогда
		Режим = "Грузоотправители";
	ИначеЕсли Элемент.Имя = "СсылкаГрузополучатели" Тогда
		Режим = "Грузополучатели";
	Иначе
		Режим = "Дополнительно";
	КонецЕсли;
	АдресДанных = ПодготовитьШапкуНаСервере(Режим);
	ПараметрыФормы = Новый Структура("АдресДанных", АдресДанных);
	ПолноеИмяФормы = ПолноеИмяОбработкиРедактора + ".Форма.РедакторШапки";
	Оповещение = КлиентскийМодуль().Стд().ОбщегоНазначения().ОписаниеОповещения("ШапкаЗакрыта", ЭтаФорма);
	КлиентскийМодуль().СинхронныеМодальныеВызовы().смв_ОткрытьФорму(
		ПолноеИмяФормы, ПараметрыФормы, ЭтаФорма, Истина, , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	МодульСтрокРедактора = КлиентскийМодуль().Стд().Стр();
	ИмяТаблицыДеклараций = "Декларации";
	
	КолонкиРедакторов = МодульСтрокРедактора.СтрРазделитьЛок(
			"ТоварыДекларации,ТоварыПрослеживаемость,ТоварыМаркировка,ТоварыДополнительныеСведения", ",");
	ЭтоСсылкаРедактора = Поле <> Неопределено И КолонкиРедакторов.Найти(Поле.Имя) <> Неопределено;
	Если НЕ ЭтоСсылкаРедактора Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	Элемент.ТекущаяСтрока = ВыбраннаяСтрока;
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		КлиентскийМодуль().Стд().Диалоги().ПоказатьПредупреждениеЛок(, "Выберите строку товара.");
		Возврат;
	КонецЕсли;

	Если Поле.Имя = "ТоварыМаркировка" Тогда
		Если НЕ ТекущаяСтрока.ЭтоУслуга Тогда
			ДействиеМетрики = ?(ТекущаяСтрока.ПредставлениеМаркировки = "Добавить маркировку",
					"ДобавитьМаркировку", "РедактироватьМаркировку");
			Метрика_ДобавитьПоведениеРедактораДокументов(
				"РедакторДокумента", ДействиеМетрики, "РедакторДокумента");
			АдресДанных = ПодготовитьМаркировкуНаСервере(ТекущаяСтрока.Индекс + 1);
			ОткрытьРедакторСтроки("РедакторМаркировки", АдресДанных, "Маркировка", "");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Поле.Имя = "ТоварыДекларации" Тогда
		ИмяФормыРедактора = "РедакторДеклараций";
		ИмяТаблицы = ИмяТаблицыДеклараций;
		ИмяСвойства = ИмяТаблицыДеклараций;
	ИначеЕсли Поле.Имя = "ТоварыПрослеживаемость" Тогда
		ИмяФормыРедактора = "РедакторПрослеживаемости";
		ИмяТаблицы = "Прослеживаемость";
		ИмяСвойства = "Прослеживаемость";
	Иначе
		ИмяФормыРедактора = "РедакторДополнительныхСведений";
		ИмяТаблицы = "ДополнительныеСведенияТоваров";
		ИмяСвойства = "ДополнительныеСведения";
	КонецЕсли;
	АдресДанных = ПодготовитьДанныеСтрокиНаСервере(
			ТекущаяСтрока.Индекс + 1, ИмяТаблицы, ИмяСвойства, ИмяТаблицы = ИмяТаблицыДеклараций);
	ОткрытьРедакторСтроки(ИмяФормыРедактора, АдресДанных, ИмяТаблицы, ИмяСвойства);

КонецПроцедуры

// Передает событие редактора документа и вложенной формы маркировки форме пакета.
//
// Параметры:
//  Категория - Строка - категория события DD_Behavior.
//  Действие - Строка - действие события DD_Behavior.
//  Представление - Строка - форма, в которой выполнено действие.
&НаКлиенте
Процедура Метрика_ДобавитьПоведениеРедактораДокументов(Категория, Действие, Представление) Экспорт
	
	ВладелецФормы.Метрика_ДобавитьПоведениеРедактораДокументов(Категория, Действие, Представление);
	
КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)

	Попытка
		ИзмененныйДокумент = ПрименитьИзмененияНаСервере();
	Исключение
		КлиентскийМодуль().СообщитьОбОшибке(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Закрыть(ИзмененныйДокумент);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть();

КонецПроцедуры

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПодготовитьШапкуНаСервере(Режим)

	Модель = МодельИзФормы();
	Модель.Вставить("СтраныМира", РеквизитФормыВЗначение("СтраныМира"));
	Данные = Новый Структура("Режим,Модель", Режим, Модель);
	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ПрименитьШапкуНаСервере(АдресРезультата)

	МодульСтрокРедактора = РеквизитФормыВЗначение("Объект").СтдСтр();
	Модель = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Модель) <> Тип("Структура") Тогда
		ВызватьИсключение "Не получен результат редактирования реквизитов документа.";
	КонецЕсли;
	Для Каждого ИмяТаблицы Из МодульСтрокРедактора.СтрРазделитьЛок(
		"Продавцы,Покупатели,Грузоотправители,Грузополучатели,ДополнительныеСведенияДокумента", ",") Цикл
		ЗначениеВРеквизитФормы(Модель[ИмяТаблицы], ИмяТаблицы);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Модель,
		"ИдентификаторФайлаИнформационногоПоля,ИдентификаторГосударственногоКонтракта,ОбстоятельствоФормирования");
	УдалитьИзВременногоХранилища(АдресРезультата);
	ОбновитьСсылкиШапкиДляФормы(ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСсылкуСтороны(Форма, ИмяТаблицы, Заголовок)

	МодульСтрокРедактора = РеквизитФормыВЗначение("Объект").СтдСтр();
	МаксимальнаяДлинаПредставления = 50;
	ДлинаМноготочия = 3;
	
	Стороны = Форма[ИмяТаблицы];
	Представление = "не указан";
	Если Стороны.Количество() > 0 Тогда
		Представление = Стороны[0].Наименование;
		Если Не ЗначениеЗаполнено(Представление) Тогда
			Представление = "без наименования";
		КонецЕсли;
		Если СтрДлина(Представление) > МаксимальнаяДлинаПредставления Тогда
			Представление = Лев(Представление, МаксимальнаяДлинаПредставления - ДлинаМноготочия) + "...";
		КонецЕсли;
		Если Стороны.Количество() > 1 Тогда
			Представление = Представление + МодульСтрокРедактора.СтрШаблонЛок(" (еще %1)", Стороны.Количество() - 1);
		КонецЕсли;
	КонецЕсли;
	Форма.Элементы["Ссылка" + ИмяТаблицы].Заголовок = Заголовок + ": " + Представление;
	Подсказка = Новый Массив;
	Для Каждого Сторона Из Стороны Цикл
		Сведения = Сторона.Наименование;
		Если ЗначениеЗаполнено(Сторона.ИНН) Тогда
			Сведения = Сведения + Символы.ПС + "ИНН " + Сторона.ИНН;
		КонецЕсли;
		Если ЗначениеЗаполнено(Сторона.КПП) Тогда
			Сведения = Сведения + ", КПП " + Сторона.КПП;
		КонецЕсли;
		Если ЗначениеЗаполнено(Сторона.Адрес) Тогда
			Сведения = Сведения + Символы.ПС + Сторона.Адрес;
		КонецЕсли;
		Подсказка.Добавить(Сведения);
	КонецЦикла;
	Подсказка.Добавить("Нажмите, чтобы открыть реквизиты стороны в XML.");
	Форма.Элементы["Ссылка" + ИмяТаблицы].Подсказка =
		МодульСтрокРедактора.СтрСоединитьЛок(Подсказка, Символы.ПС + Символы.ПС);

КонецПроцедуры

&НаСервере
Процедура ОбновитьСсылкиШапкиДляФормы(Форма)

	МодульСтрокРедактора = РеквизитФормыВЗначение("Объект").СтдСтр();
	ЗаполнитьСсылкуСтороны(Форма, "Продавцы", "Организация");
	ЗаполнитьСсылкуСтороны(Форма, "Покупатели", "Покупатель");
	ЗаполнитьСсылкуСтороны(Форма, "Грузоотправители", "Грузоотправитель");
	ЗаполнитьСсылкуСтороны(Форма, "Грузополучатели", "Грузополучатель");
	Форма.Элементы.ГруппаДоставка.Видимость = Форма.ТипКонтента = "utd970";
	Форма.Элементы.СсылкаДополнительныеСведенияДокумента.Заголовок = ?(
		Форма.ДополнительныеСведенияДокумента.Количество() = 0,
		"Дополнительно",
		МодульСтрокРедактора.СтрШаблонЛок("Дополнительно: сведений %1", Форма.ДополнительныеСведенияДокумента.Количество()));

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедакторСтроки(ИмяФормыРедактора, АдресДанных, ИмяТаблицы, ИмяСвойства)

	ПолноеИмяФормы = ПолноеИмяОбработкиРедактора + ".Форма."
		+ ИмяФормыРедактора;
	ПараметрыФормы = Новый Структура("АдресДанных", АдресДанных);
	ПараметрыОповещения = Новый Структура("ИмяТаблицы,ИмяСвойства", ИмяТаблицы, ИмяСвойства);
	Оповещение = КлиентскийМодуль().Стд().ОбщегоНазначения().ОписаниеОповещения(
		"РедакторСтрокиЗакрыт", ЭтаФорма, ПараметрыОповещения);
	КлиентскийМодуль().СинхронныеМодальныеВызовы().смв_ОткрытьФорму(
		ПолноеИмяФормы, ПараметрыФормы, ЭтаФорма, Истина, , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Функция ПрименитьИзмененияНаСервере()

	Модель = МодельИзФормы();
	Возврат РеквизитФормыВЗначение("Объект").ПрименитьМодель(Документ, Модель, Истина);

КонецФункции

&НаСервере
Функция ПодготовитьДанныеСтрокиНаСервере(
	НомерСтроки, ИмяРеквизитаТаблицы, ИмяСвойстваРезультата, ДобавитьСтраны = Ложь)

	ТоварыЗначение = РеквизитФормыВЗначение("Товары");
	СтрокаТовара = ТоварыЗначение.Найти(НомерСтроки - 1, "Индекс");
	Если СтрокаТовара = Неопределено Тогда
		ВызватьИсключение "Товарная строка не найдена в модели редактора.";
	КонецЕсли;
	Если СтрокаТовара.ЭтоУслуга Тогда
		ВызватьИсключение "Для услуги редактор маркировки недоступен.";
	КонецЕсли;
	ВсеСтроки = РеквизитФормыВЗначение(ИмяРеквизитаТаблицы);
	Строки = ВсеСтроки.Скопировать(Новый Структура("НомерСтроки", НомерСтроки));
	Данные = Новый Структура("НомерСтроки,Товар,ТипКонтента",
		НомерСтроки, СтрокаТовара.Наименование, ТипКонтента);
	Данные.Вставить(ИмяСвойстваРезультата, Строки);
	Если ДобавитьСтраны Тогда
		Данные.Вставить("СтраныМира", РеквизитФормыВЗначение("СтраныМира"));
	КонецЕсли;

	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ПрименитьДанныеСтрокиНаСервере(
	АдресРезультата, ИмяРеквизитаТаблицы, ИмяСвойстваРезультата)

	Данные = ПолучитьИзВременногоХранилища(АдресРезультата);
	УдалитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	НовыеСтроки = Неопределено;
	Если Не Данные.Свойство(ИмяСвойстваРезультата, НовыеСтроки)
		Или ТипЗнч(НовыеСтроки) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;

	Таблица = РеквизитФормыВЗначение(ИмяРеквизитаТаблицы);
	Для Каждого УдаляемаяСтрока Из Таблица.НайтиСтроки(
		Новый Структура("НомерСтроки", Данные.НомерСтроки)) Цикл
		Таблица.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	Для Каждого Строка Из НовыеСтроки Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Строка);
	КонецЦикла;
	ЗначениеВРеквизитФормы(Таблица, ИмяРеквизитаТаблицы);
	ОбновитьСлужебныеПредставленияНаСервере();

КонецПроцедуры

&НаСервере
Функция ПодготовитьМаркировкуНаСервере(НомерСтроки)

	ТоварыЗначение = РеквизитФормыВЗначение("Товары");
	СтрокаТовара = ТоварыЗначение.Найти(НомерСтроки - 1, "Индекс");
	Если СтрокаТовара = Неопределено Тогда
		ВызватьИсключение "Товарная строка не найдена в модели редактора.";
	КонецЕсли;
	ВсеГруппы = РеквизитФормыВЗначение("ГруппыМаркировки");
	ВсеКоды = РеквизитФормыВЗначение("КодыМаркировки");
	ГруппыСтроки = ВсеГруппы.Скопировать(Новый Структура("НомерСтроки", НомерСтроки));
	КодыСтроки = ВсеКоды.СкопироватьКолонки();
	НомераГрупп = Новый Соответствие;
	СледующийНомерГруппы = 1;
	Для Каждого Группа Из ВсеГруппы Цикл
		СледующийНомерГруппы = Макс(СледующийНомерГруппы, Группа.НомерГруппы + 1);
	КонецЦикла;
	Для Каждого Группа Из ГруппыСтроки Цикл
		НомераГрупп.Вставить(Группа.НомерГруппы, Истина);
	КонецЦикла;
	Для Каждого Код Из ВсеКоды Цикл
		Если НомераГрупп.Получить(Код.НомерГруппы) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(КодыСтроки.Добавить(), Код);
		КонецЕсли;
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("НомерСтроки", НомерСтроки);
	Данные.Вставить("Товар", СтрокаТовара.Наименование);
	Данные.Вставить("ГруппыМаркировки", ГруппыСтроки);
	Данные.Вставить("КодыМаркировки", КодыСтроки);
	Данные.Вставить("СледующийНомерГруппы", СледующийНомерГруппы);
	Данные.Вставить("ТипКонтента", ТипКонтента);

	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ПрименитьМаркировкуНаСервере(АдресРезультата)

	Данные = ПолучитьИзВременногоХранилища(АдресРезультата);
	УдалитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Группы = РеквизитФормыВЗначение("ГруппыМаркировки");
	Коды = РеквизитФормыВЗначение("КодыМаркировки");
	Для Каждого Группа Из Группы.НайтиСтроки(
		Новый Структура("НомерСтроки", Данные.НомерСтроки)) Цикл
		Для Каждого Код Из Коды.НайтиСтроки(
			Новый Структура("НомерГруппы", Группа.НомерГруппы)) Цикл
			Коды.Удалить(Код);
		КонецЦикла;
		Группы.Удалить(Группа);
	КонецЦикла;
	Для Каждого Строка Из Данные.ГруппыМаркировки Цикл
		ЗаполнитьЗначенияСвойств(Группы.Добавить(), Строка);
	КонецЦикла;
	Для Каждого Строка Из Данные.КодыМаркировки Цикл
		ЗаполнитьЗначенияСвойств(Коды.Добавить(), Строка);
	КонецЦикла;
	ЗначениеВРеквизитФормы(Группы, "ГруппыМаркировки");
	ЗначениеВРеквизитФормы(Коды, "КодыМаркировки");
	ОбновитьСлужебныеПредставленияНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСлужебныеПредставленияНаСервере()

	Модель = МодельИзФормы();
	РеквизитФормыВЗначение("Объект").ОбновитьПредставленияСлужебныхДанных(Модель);
	Товары.Загрузить(Модель.Товары);

КонецПроцедуры

&НаСервере
Процедура ОбновитьИтогиНаСервере()

	ИтогоБезНДС = 0;
	ИтогоНДС = 0;
	Итого = 0;
	Для Каждого Строка Из РеквизитФормыВЗначение("Товары") Цикл
		ИтогоБезНДС = ИтогоБезНДС + Строка.СуммаБезНДС;
		ИтогоНДС = ИтогоНДС + Строка.СуммаНДС;
		Итого = Итого + Строка.Сумма;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция МодельИзФормы()

	Модель = Новый Структура;
	Модель.Вставить("ТипКонтента", ТипКонтента);
	Модель.Вставить("НомерДокумента", НомерДокумента);
	Модель.Вставить("ДатаДокумента", ДатаДокумента);
	Модель.Вставить("ФункцияДокумента", ФункцияДокумента);
	Модель.Вставить("ИдентификаторФайлаИнформационногоПоля", ИдентификаторФайлаИнформационногоПоля);
	Модель.Вставить("ИдентификаторГосударственногоКонтракта", ИдентификаторГосударственногоКонтракта);
	Модель.Вставить("ОбстоятельствоФормирования", ОбстоятельствоФормирования);
	Модель.Вставить("Товары", РеквизитФормыВЗначение("Товары"));
	Модель.Вставить("Продавцы", РеквизитФормыВЗначение("Продавцы"));
	Модель.Вставить("Покупатели", РеквизитФормыВЗначение("Покупатели"));
	Модель.Вставить("Грузоотправители", РеквизитФормыВЗначение("Грузоотправители"));
	Модель.Вставить("Грузополучатели", РеквизитФормыВЗначение("Грузополучатели"));
	Модель.Вставить("ДополнительныеСведенияДокумента", РеквизитФормыВЗначение("ДополнительныеСведенияДокумента"));
	Модель.Вставить("ДополнительныеСведенияТоваров", РеквизитФормыВЗначение("ДополнительныеСведенияТоваров"));
	Модель.Вставить("Декларации", РеквизитФормыВЗначение("Декларации"));
	Модель.Вставить("Прослеживаемость", РеквизитФормыВЗначение("Прослеживаемость"));
	Модель.Вставить("ГруппыМаркировки", РеквизитФормыВЗначение("ГруппыМаркировки"));
	Модель.Вставить("КодыМаркировки", РеквизитФормыВЗначение("КодыМаркировки"));

	Возврат Модель;

КонецФункции

&НаСервере
Процедура НастроитьФормуПоТипуКонтента()

	ОбработкаРедактора = РеквизитФормыВЗначение("Объект");
	МодульСтрокРедактора = ОбработкаРедактора.СтдСтр();
	ЭтоУКД = ТипКонтента = "ucd29" Или ТипКонтента = "ucd736";
	Элементы.ТоварыГруппаДоПосле.Видимость = ЭтоУКД;
	Элементы.ТоварыГруппаЕдиницаИКод.ОтображатьВШапке = Не ЭтоУКД;
	Элементы.ТоварыГруппаЕдиницаИКод.Группировка = ?(ЭтоУКД,
		ГруппировкаКолонок.Горизонтальная, ГруппировкаКолонок.Вертикальная);
	Элементы.ТоварыГруппаЕдиница.ОтображатьВШапке = ЭтоУКД;
	Элементы.ТоварыГруппаКодЕдиницы.ОтображатьВШапке = ЭтоУКД;
	Для Каждого ИмяЭлемента Из МодульСтрокРедактора.СтрРазделитьЛок(
		"ТоварыИсходныйНомер,ТоварыКоличествоДо,ТоварыЕдиницаДо,ТоварыКодЕдиницыДо,"
			+ "ТоварыЦенаДо,ТоварыСтавкаНДСДо,ТоварыСуммаБезНДСДо,ТоварыИзменениеСуммы", ",") Цикл
		Элементы[ИмяЭлемента].Видимость = ЭтоУКД;
	КонецЦикла;
	Элементы.ТоварыИсходныйНомер.Видимость = Истина;
	Элементы.ТоварыИсходныйНомер.Заголовок = ?(ЭтоУКД, "Номер исх. строки", "Номер строки");
	Для Каждого ИмяКолонки Из МодульСтрокРедактора.СтрРазделитьЛок(
		"ТоварыКоличество,ТоварыЕдиница,ТоварыКодЕдиницы,ТоварыЦена,ТоварыСтавкаНДС,ТоварыСуммаБезНДС", ",") Цикл
		Элементы[ИмяКолонки].ОтображатьВШапке = Ложь;
		Элементы[ИмяКолонки + "До"].ОтображатьВШапке = Ложь;
		Если ЭтоУКД Тогда
			Элементы[ИмяКолонки + "До"].Заголовок = "До";
			Элементы[ИмяКолонки].Заголовок = "После";
		КонецЕсли;
	КонецЦикла;
	Если ЭтоУКД Тогда
		Элементы.ТоварыСумма.Заголовок = "Всего после";
	КонецЕсли;
	НастройкаОбстоятельства = ОбработкаРедактора
		.НастройкаОбстоятельстваФормирования(ТипКонтента, ФункцияДокумента);
	Если Не ЗначениеЗаполнено(ОбстоятельствоФормирования) Тогда
		ОбстоятельствоФормирования = НастройкаОбстоятельства.ЗначениеПоУмолчанию;
	КонецЕсли;

	Элементы.ТоварыСтавкаНДС.СписокВыбора.Очистить();
	Для Каждого Ставка Из ОбработкаРедактора.ДопустимыеСтавкиНДС() Цикл
		Элементы.ТоварыСтавкаНДС.СписокВыбора.Добавить(Ставка);
	КонецЦикла;

КонецПроцедуры

// #КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Общая клиентская точка доступа к библиотекам редактора.

&НаКлиенте
Функция КлиентскийМодуль()

	Если КлиентскийМодульКэш = Неопределено Тогда
		// Совместимость с 8.2; получаем форму-модуль без открытия окна.
		// BSLLS:DeprecatedFind-off
		ПутьКОбработке = Лев(ИмяФормы, Найти(ИмяФормы, ".Форма.") - 1);
		// BSLLS:DeprecatedFind-on
		// BSLLS:GetFormMethod-off
		КлиентскийМодульКэш = ПолучитьФорму(ПутьКОбработке + ".Форма.Клиент", , ЭтаФорма);
		// BSLLS:GetFormMethod-on
	КонецЕсли;
	Возврат КлиентскийМодульКэш;

КонецФункции
