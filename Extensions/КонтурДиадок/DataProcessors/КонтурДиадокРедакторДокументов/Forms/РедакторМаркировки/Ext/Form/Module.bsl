// Клиентская форма-модуль редактора, подключенная в том же режиме.
// Переменная используется в другом методе корневого модуля.
// BSLLS:UnusedLocalVariable-off
// BSLLS:MissingVariablesDescription-off
&НаКлиенте
Перем КлиентскийМодульКэш;
// BSLLS:UnusedLocalVariable-on
// BSLLS:MissingVariablesDescription-on

// #Область СлужебныйПрограммныйИнтерфейс

// Клиентская точка сохранения для команды формы и проверки результата редактирования.
// Серверная реализация остается внутренней и не вызывается из других форм.
//
// Возвращаемое значение:
//  Строка - адрес проверенных данных маркировки во временном хранилище владельца.
&НаКлиенте
Функция ПодготовитьРезультатРедактирования() Экспорт

	Возврат СохранитьРезультатНаСервере();

КонецФункции

// #КонецОбласти

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресДанных = "";
	Если Не Параметры.Свойство("АдресДанных", АдресДанных) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Этот адрес используется повторно для результата. Удаляет его форма-владелец после получения.
	// BSLLS:MissingTempStorageDeletion-off
	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	// BSLLS:MissingTempStorageDeletion-on
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЭтаФорма.АдресДанныхРедактора = АдресДанных;
	ЭтаФорма.НомерСтроки = Данные.НомерСтроки;
	ЭтаФорма.Товар = Данные.Товар;
	ЭтаФорма.ТипКонтента = Данные.ТипКонтента;
	ЭтаФорма.СледующийНомерГруппы = Данные.СледующийНомерГруппы;
	Если ТипКонтента <> "ucd29" Тогда
		ДлинаВеса = 9;
		ТочностьВеса = 3;
		Элементы.ДеревоВес.ОграничениеТипа = Новый ОписаниеТипов("Число",
			Новый КвалификаторыЧисла(ДлинаВеса, ТочностьВеса));
	КонецЕсли;
	ЗначениеВРеквизитФормы(Данные.ГруппыМаркировки, "ГруппыМаркировки");
	ЗначениеВРеквизитФормы(Данные.КодыМаркировки, "КодыМаркировки");
	ПостроитьДеревоМаркировки();
	НастроитьФормуПоТипуКонтента();

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьОСУ(Команда)

	Метрика_ДобавитьПоведениеРедактораДокументов(
		"РедакторМаркировки", "ДобавитьОСУ", "РедакторМаркировки");
	ДобавитьГруппуУчета("ОСУ");

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПартионныйУчет(Команда)

	Метрика_ДобавитьПоведениеРедактораДокументов(
		"РедакторМаркировки", "ДобавитьПартионныйУчет", "РедакторМаркировки");
	ДобавитьГруппуУчета("Партионный учет");

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПЭУ(Команда)

	Метрика_ДобавитьПоведениеРедактораДокументов(
		"РедакторМаркировки", "ДобавитьПЭУ", "РедакторМаркировки");
	ДобавитьКод("КИЗ");

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьГруппуУчета(ВидУчета) Экспорт

	Раздел = РазделТекущейСтроки();
	Коллекция = ?(Раздел = Неопределено, ДеревоМаркировки.ПолучитьЭлементы(), Раздел.ПолучитьЭлементы());
	НоваяСтрока = Коллекция.Добавить();
	ЗаполнитьСведенияНовойГруппы(НоваяСтрока, СледующийНомерГруппы);
	Если Раздел <> Неопределено Тогда
		НоваяСтрока.Состояние = Раздел.Состояние;
	КонецЕсли;
	НоваяСтрока.ВидСтроки = "Группа";
	НоваяСтрока.Представление = ВидУчета;
	НоваяСтрока.ВидУчета = ВидУчета;
	ЭтаФорма.СледующийНомерГруппы = СледующийНомерГруппы + 1;
	Элементы.ДеревоМаркировки.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	ЭтаФорма.ТекущийЭлемент = Элементы.ДеревоКод;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьГруппу(Команда) Экспорт

	Метрика_ДобавитьПоведениеРедактораДокументов(
		"РедакторМаркировки", "УдалитьВыбранное", "РедакторМаркировки");
	Идентификаторы = Новый Массив;
	Для Каждого Идентификатор Из Элементы.ДеревоМаркировки.ВыделенныеСтроки Цикл
		Идентификаторы.Добавить(Идентификатор);
	КонецЦикла;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		СтрокаДерева = ДеревоМаркировки.НайтиПоИдентификатору(Идентификатор);
		// При удалении родителя его выбранные дочерние строки уже удалены.
		Если СтрокаДерева = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаДерева.ВидСтроки = "Раздел" Тогда
			Продолжить;
		КонецЕсли;
		Родитель = СтрокаДерева.ПолучитьРодителя();
		Коллекция = ?(Родитель = Неопределено, ДеревоМаркировки.ПолучитьЭлементы(), Родитель.ПолучитьЭлементы());
		Коллекция.Удалить(Коллекция.Индекс(СтрокаДерева));
	КонецЦикла;

КонецПроцедуры

// Передает событие редактора маркировки форме пакета через редактор документа.
//
// Параметры:
//  Категория - Строка - категория события DD_Behavior.
//  Действие - Строка - действие события DD_Behavior.
//  Представление - Строка - форма, в которой выполнено действие.
&НаКлиенте
Процедура Метрика_ДобавитьПоведениеРедактораДокументов(Категория, Действие, Представление)
	
	Если ВладелецФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВладелецФормы.Метрика_ДобавитьПоведениеРедактораДокументов(Категория, Действие, Представление);
	
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)

	Попытка
		АдресРезультата = ПодготовитьРезультатРедактирования();
	Исключение
		КлиентскийМодуль().СообщитьОбОшибке(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Закрыть(АдресРезультата);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть();

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоМаркировки

&НаКлиенте
Процедура ВидУчетаПриИзменении(Элемент) Экспорт

	СтрокаДерева = Элементы.ДеревоМаркировки.ТекущиеДанные;
	Если СтрокаДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтрокаДерева.Представление = СтрокаДерева.ВидУчета Тогда
		Возврат;
	КонецЕсли;
	Если Элемент.СписокВыбора.НайтиПоЗначению(СтрокаДерева.Представление) = Неопределено Тогда
		СтрокаДерева.Представление = СтрокаДерева.ВидУчета;
		Возврат;
	КонецЕсли;
	// КИЗ и ГТИН имеют разный смысл, хотя редактируются в одной видимой колонке.
	Если СтрокаДерева.ВидУчета = "ПЭУ (КИЗ)" Тогда
		СтрокаДерева.КодПЭУ = СтрокаДерева.Код;
	Иначе
		СтрокаДерева.GTIN = СтрокаДерева.Код;
	КонецЕсли;
	СтрокаДерева.ВидУчета = СтрокаДерева.Представление;
	// Отделяем измененную строку от других кодов той же исходной группы.
	СтрокаДерева.НомерГруппы = СледующийНомерГруппы;
	СледующийНомерГруппы = СледующийНомерГруппы + 1;
	ЭтоПЭУ = СтрокаДерева.ВидУчета = "ПЭУ (КИЗ)";
	СтрокаДерева.ВидСтроки = ?(ЭтоПЭУ, "Код", "Группа");
	СтрокаДерева.ВидКода = ?(ЭтоПЭУ, "КИЗ", "");
	СтрокаДерева.Код = ?(ЭтоПЭУ, СтрокаДерева.КодПЭУ, СтрокаДерева.GTIN);
	// Недоступные поля остаются в черновике до закрытия формы.
	// В результат переносятся только реквизиты выбранного вида учета.

КонецПроцедуры

&НаКлиенте
Процедура РеквизитыГруппыПриИзменении(Элемент) Экспорт

	ИдентификаторСтроки = Элементы.ДеревоМаркировки.ТекущаяСтрока;
	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаДерева = ДеревоМаркировки.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Элемент.Имя = "ДеревоКод" И СтрокаДерева.ВидСтроки = "Группа" Тогда
		СтрокаДерева.GTIN = СтрокаДерева.Код;
	КонецЕсли;
	Если Элемент.Имя = "ДеревоКодПартии" Тогда
		ОбновитьКодПартииГруппы(СтрокаДерева);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКодПартииГруппы(СтрокаДерева)

	Родитель = СтрокаДерева.ПолучитьРодителя();
	Строки = ?(Родитель = Неопределено, ДеревоМаркировки.ПолучитьЭлементы(), Родитель.ПолучитьЭлементы());
	ДругиеКИЗ = 0;
	ГруппаБезГТИН = Неопределено;
	Для Каждого ДругаяСтрока Из Строки Цикл
		Если ДругаяСтрока = СтрокаДерева
			Или ДругаяСтрока.НомерГруппы <> СтрокаДерева.НомерГруппы Тогда
			Продолжить;
		КонецЕсли;
		Если ДругаяСтрока.ВидКода = "КИЗ" Тогда
			ДругиеКИЗ = ДругиеКИЗ + 1;
		КонецЕсли;
		Если ДругаяСтрока.ВидСтроки = "Группа" И Не ЗначениеЗаполнено(ДругаяСтрока.GTIN) Тогда
			ГруппаБезГТИН = ДругаяСтрока;
		КонецЕсли;
	КонецЦикла;
	Если СтрокаДерева.ВидКода = "КИЗ" И ДругиеКИЗ = 0 И ГруппаБезГТИН <> Неопределено Тогда
		ГруппаБезГТИН.КодПартии = СтрокаДерева.КодПартии;
		Возврат;
	КонецЕсли;
	ОтделитьКодСДругойПартией(СтрокаДерева, Строки);

КонецПроцедуры

&НаКлиенте
Процедура ОтделитьКодСДругойПартией(СтрокаДерева, Строки)

	Для Каждого ДругаяСтрока Из Строки Цикл
		Если ДругаяСтрока <> СтрокаДерева
			И ДругаяСтрока.НомерГруппы = СтрокаДерева.НомерГруппы
			И ДругаяСтрока.КодПартии <> СтрокаДерева.КодПартии Тогда
			СтрокаДерева.НомерГруппы = СледующийНомерГруппы;
			СледующийНомерГруппы = СледующийНомерГруппы + 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаркировкиПередНачаломИзменения(Элемент, Отказ)

	СтрокаДерева = Элемент.ТекущиеДанные;
	Если СтрокаДерева <> Неопределено И СтрокаДерева.ВидСтроки = "Раздел" Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция РазделТекущейСтроки()

	Если НРег(ТипКонтента) = "utd970" Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтрокаДерева = Элементы.ДеревоМаркировки.ТекущиеДанные;
	Пока СтрокаДерева <> Неопределено Цикл
		Если СтрокаДерева.ВидСтроки = "Раздел" Тогда
			Возврат СтрокаДерева;
		КонецЕсли;
		СтрокаДерева = СтрокаДерева.ПолучитьРодителя();
	КонецЦикла;
	Для Каждого Раздел Из ДеревоМаркировки.ПолучитьЭлементы() Цикл
		Если Раздел.Состояние = "После" Тогда
			Возврат Раздел;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найден раздел маркировки после изменения.";

КонецФункции

&НаКлиенте
Процедура ДобавитьКод(ВидКода) Экспорт

	Раздел = РазделТекущейСтроки();
	Коллекция = ?(Раздел = Неопределено, ДеревоМаркировки.ПолучитьЭлементы(), Раздел.ПолучитьЭлементы());
	НоваяСтрока = Коллекция.Добавить();
	ЗаполнитьСведенияНовойГруппы(НоваяСтрока, СледующийНомерГруппы);
	Если Раздел <> Неопределено Тогда
		НоваяСтрока.Состояние = Раздел.Состояние;
	КонецЕсли;
	ЭтаФорма.СледующийНомерГруппы = СледующийНомерГруппы + 1;
	НоваяСтрока.ВидСтроки = "Код";
	НоваяСтрока.ВидКода = ВидКода;
	НоваяСтрока.Представление = ?(ВидКода = "КИЗ", "ПЭУ (КИЗ)", "ОСУ");
	НоваяСтрока.ВидУчета = НоваяСтрока.Представление;
	Элементы.ДеревоМаркировки.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	ЭтаФорма.ТекущийЭлемент = Элементы.ДеревоКод;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСведенияНовойГруппы(СтрокаДерева, НомерГруппы)

	СтрокаДерева.ИсходныйИндекс = -1;
	СтрокаДерева.НомерГруппы = НомерГруппы;
	Если НРег(ТипКонтента) <> "utd970" Тогда
		СтрокаДерева.Состояние = "После";
	КонецЕсли;

КонецПроцедуры
&НаСервере
Функция СохранитьРезультатНаСервере()

	ПеренестиДеревоВТаблицы();
	Группы = РеквизитФормыВЗначение("ГруппыМаркировки");
	Коды = РеквизитФормыВЗначение("КодыМаркировки");

	Данные = Новый Структура;
	Данные.Вставить("НомерСтроки", НомерСтроки);
	Данные.Вставить("ГруппыМаркировки", Группы);
	Данные.Вставить("КодыМаркировки", Коды);
	Возврат ПоместитьВоВременноеХранилище(Данные, АдресДанныхРедактора);

КонецФункции

&НаСервере
Процедура ПостроитьДеревоМаркировки()

	Редактор = РеквизитФормыВЗначение("Объект");
	Дерево = Редактор.ДеревоМаркировкиДляРедактора(ТипКонтента,
			РеквизитФормыВЗначение("ГруппыМаркировки"), РеквизитФормыВЗначение("КодыМаркировки"));
	ЗначениеВРеквизитФормы(Дерево, "ДеревоМаркировки");

КонецПроцедуры

&НаСервере
Процедура ПеренестиДеревоВТаблицы()

	ИмяТаблицыГрупп = "ГруппыМаркировки";
	ИмяТаблицыКодов = "КодыМаркировки";
	Данные = Новый Структура;
	Данные.Вставить("НомерСтроки", НомерСтроки);
	Данные.Вставить("Товар", Товар);
	Данные.Вставить("ТипКонтента", ТипКонтента);
	Данные.Вставить(ИмяТаблицыГрупп, РеквизитФормыВЗначение(ИмяТаблицыГрупп));
	Данные.Вставить(ИмяТаблицыКодов, РеквизитФормыВЗначение(ИмяТаблицыКодов));
	Результат = РеквизитФормыВЗначение("Объект").ДанныеМаркировкиИзДерева(
			РеквизитФормыВЗначение("ДеревоМаркировки"), Данные);
	ЗначениеВРеквизитФормы(Результат.ГруппыМаркировки, ИмяТаблицыГрупп);
	ЗначениеВРеквизитФормы(Результат.КодыМаркировки, ИмяТаблицыКодов);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеГруппы(Группа)

	Если ЗначениеЗаполнено(Группа.ВидУчета) Тогда
		Возврат Группа.ВидУчета;
	КонецЕсли;
	Если ЗначениеЗаполнено(Группа.КодПартии) Тогда
		Возврат "Партионный учет";
	КонецЕсли;
	Возврат "ОСУ";

КонецФункции

&НаСервере
Процедура НастроитьФормуПоТипуКонтента()

	МодульСтрокРедактора = РеквизитФормыВЗначение("Объект").СтдСтр();
	ИмяПредставления = "Представление";
	Для Каждого ВидУчета Из МодульСтрокРедактора.СтрРазделитьЛок("ПЭУ (КИЗ),ОСУ,Партионный учет", ",") Цикл
		Элементы.ДеревоПредставление.СписокВыбора.Добавить(ВидУчета);
	КонецЦикла;
	
	ЭтоУКД = НРег(ТипКонтента) <> "utd970";
	Элементы.ДеревоУпаковка.Видимость = Ложь;
	Элементы.ДеревоСостояние.Видимость = Ложь;
	Элементы.ДеревоGTIN.Видимость = Ложь;
	Элементы.ДеревоВес.Видимость = Истина;
	Если ЭтоУКД Тогда
		НачалоПояснения = "Выберите раздел ""до"" или ""после изменения"" и воспользуйтесь командой ""Добавить код"". ";
	Иначе
		НачалоПояснения = "Воспользуйтесь командой ""Добавить код"". ";
	КонецЕсли;
	Элементы.Пояснение.Заголовок = НачалоПояснения
		+ "В зависимости от вида учета, заполните необходимые поля:"
		+ Символы.ПС + "- Для ПЭУ (поэкземплярного учета, КИЗ) - код маркировки и при необходимости номер партии;"
		+ Символы.ПС + "- Для ОСУ - ГТИН, количество упаковок и вес;"
		+ Символы.ПС + "- Для партионного учета - ГТИН, количество упаковок, номер партии и вес.";
	ДобавитьОграничениеРедактирования("ВидСтроки", "Раздел",
		"ДеревоКод,ДеревоКоличество,ДеревоКодПартии,ДеревоВес");
	ДобавитьОграничениеРедактирования("ВидСтроки", "Раздел", "ДеревоПредставление", Ложь);
	ДобавитьОграничениеРедактирования(ИмяПредставления, "ПЭУ (КИЗ)", "ДеревоКоличество,ДеревоВес");
	ДобавитьОграничениеРедактирования(ИмяПредставления, "ОСУ", "ДеревоКодПартии");

КонецПроцедуры

&НаСервере
Процедура ДобавитьОграничениеРедактирования(ИмяКолонки, Значение, ИменаПолей, СкрыватьТекст = Истина)

	МодульСтрокРедактора = РеквизитФормыВЗначение("Объект").СтдСтр();
	ОформлениеСтроки = УсловноеОформление.Элементы.Добавить();
	Отбор = ОформлениеСтроки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоМаркировки." + ИмяКолонки);
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Значение;
	Если СкрыватьТекст Тогда
		ОформлениеСтроки.Оформление.УстановитьЗначениеПараметра("Текст", "");
	КонецЕсли;
	ОформлениеСтроки.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Для Каждого ИмяПоля Из МодульСтрокРедактора.СтрРазделитьЛок(ИменаПолей, ",") Цикл
		Поле = ОформлениеСтроки.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;

КонецПроцедуры

// #КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Общая клиентская точка доступа к библиотекам редактора.

&НаКлиенте
Функция КлиентскийМодуль()

	Если КлиентскийМодульКэш = Неопределено Тогда
		// Совместимость с 8.2; получаем форму-модуль без открытия окна.
		// BSLLS:DeprecatedFind-off
		ПутьКОбработке = Лев(ИмяФормы, Найти(ИмяФормы, ".Форма.") - 1);
		// BSLLS:DeprecatedFind-on
		// BSLLS:GetFormMethod-off
		КлиентскийМодульКэш = ПолучитьФорму(ПутьКОбработке + ".Форма.Клиент", , ЭтаФорма);
		// BSLLS:GetFormMethod-on
	КонецЕсли;
	Возврат КлиентскийМодульКэш;

КонецФункции
