// Клиентская форма-модуль редактора, подключенная в том же режиме.
// Переменная используется в другом методе корневого модуля.
// BSLLS:UnusedLocalVariable-off
// BSLLS:MissingVariablesDescription-off
&НаКлиенте
Перем КлиентскийМодульКэш;
// BSLLS:UnusedLocalVariable-on
// BSLLS:MissingVariablesDescription-on

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресДанных = "";
	Если Не Параметры.Свойство("АдресДанных", АдресДанных) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	// Этот адрес используется повторно для результата. Удаляет его форма-владелец после получения.
	// BSLLS:MissingTempStorageDeletion-off
	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	// BSLLS:MissingTempStorageDeletion-on
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ЭтаФорма.АдресДанныхРедактора = АдресДанных;
	ЭтаФорма.Сторона = Данные.Наименование;
	Редактор = РеквизитФормыВЗначение("Объект");
	Модель = Редактор.МодельАдреса(Данные.Адрес);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Модель,
		"ВидАдреса,ГлобальныйНомерМеста,ДанныеИсходногоАдреса");
	Для Каждого Поле Из Редактор.ПоляАдреса() Цикл
		ЭтаФорма[Поле.Реквизит] = Модель[Поле.Реквизит];
	КонецЦикла;
	ЗначениеВРеквизитФормы(Модель.Здания, "Здания");
	ЗначениеВРеквизитФормы(Данные.СтраныМира, "СтраныМира");
	Для Каждого Страна Из Данные.СтраныМира Цикл
		Элементы.ТекстСтрана.СписокВыбора.Добавить(Страна.Наименование);
	КонецЦикла;
	Элементы.ВидАдреса.СписокВыбора.Добавить("AddressRF", "Российский адрес");
	Элементы.ВидАдреса.СписокВыбора.Добавить("AddressSAR", "Адрес по ГАР");
	Элементы.ВидАдреса.СписокВыбора.Добавить("AddressText", "Адрес текстом");
	Элементы.ВидАдреса.РежимВыбораИзСписка = Истина;
	Элементы.ВидАдреса.РедактированиеТекста = Ложь;
	НастроитьВидимостьАдреса(ЭтаФорма);

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВидАдресаПриИзменении(Элемент)

	// Реквизиты других типов не очищаются: пользователь может вернуться к черновику.
	НастроитьВидимостьАдреса(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура СтранаПриИзменении(Элемент)

	Для Каждого Страна Из СтраныМира Цикл
		Если Элемент.Имя = "ТекстСтрана" И Страна.Наименование = ТекстСтрана Тогда
			ТекстКодСтраны = Страна.Код;
			Возврат;
		КонецЕсли;
		Если Элемент.Имя = "ТекстКодСтраны" И Страна.Код = ТекстКодСтраны Тогда
			ТекстСтрана = Страна.Наименование;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	// Для отсутствующей в справочнике страны допускается ручной ввод обоих реквизитов.

КонецПроцедуры

&НаКлиенте
Процедура ЗданияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ИсходныйИндекс = -1;
	КонецЕсли;

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Применить(Команда)

	Попытка
		АдресРезультата = СохранитьАдресНаСервере();
	Исключение
		КлиентскийМодуль().СообщитьОбОшибке(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	Закрыть(АдресРезультата);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть(Неопределено);

КонецПроцедуры

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьАдреса(Форма)

	Форма.Элементы.ГруппаРФ.Видимость = Форма.ВидАдреса = "AddressRF";
	Форма.Элементы.ГруппаГАР.Видимость = Форма.ВидАдреса = "AddressSAR";
	Форма.Элементы.ГруппаСтрокой.Видимость = Форма.ВидАдреса = "AddressText";

КонецПроцедуры

&НаСервере
Функция СохранитьАдресНаСервере()

	Редактор = РеквизитФормыВЗначение("Объект");
	Модель = Новый Структура("ВидАдреса,ГлобальныйНомерМеста,ДанныеИсходногоАдреса",
		ВидАдреса, ГлобальныйНомерМеста, ДанныеИсходногоАдреса);
	Для Каждого Поле Из Редактор.ПоляАдреса() Цикл
		Модель.Вставить(Поле.Реквизит, ЭтаФорма[Поле.Реквизит]);
	КонецЦикла;
	Модель.Вставить("Здания", РеквизитФормыВЗначение("Здания"));
	Адрес = Редактор.АдресИзМодели(Модель);
	Возврат ПоместитьВоВременноеХранилище(Адрес, АдресДанныхРедактора);

КонецФункции

// #КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Общая клиентская точка доступа к библиотекам редактора.

&НаКлиенте
Функция КлиентскийМодуль()

	Если КлиентскийМодульКэш = Неопределено Тогда
		// Совместимость с 8.2; получаем форму-модуль без открытия окна.
		// BSLLS:DeprecatedFind-off
		ПутьКОбработке = Лев(ИмяФормы, Найти(ИмяФормы, ".Форма.") - 1);
		// BSLLS:DeprecatedFind-on
		// BSLLS:GetFormMethod-off
		КлиентскийМодульКэш = ПолучитьФорму(ПутьКОбработке + ".Форма.Клиент", , ЭтаФорма);
		// BSLLS:GetFormMethod-on
	КонецЕсли;
	Возврат КлиентскийМодульКэш;

КонецФункции
