// Клиентские библиотеки текущего экземпляра редактора.
// Переменные используются в других методах корневого модуля.
// BSLLS:UnusedLocalVariable-off
// BSLLS:MissingVariablesDescription-off
&НаКлиенте
Перем СтдКэш, СМВКэш;
// BSLLS:UnusedLocalVariable-on
// BSLLS:MissingVariablesDescription-on

// #Область ПрограммныйИнтерфейс

// Открывает редактор с блокировкой владельца, результат возвращается через оповещение.
// Документ и страны передаются в транспортном формате, без таблиц значений.
//
// Параметры:
//  Документ - Структура - документ пакета Диадока.
//  СтраныМира - Массив - страны ОКСМ с кодом и наименованием.
//  ФормаВладелец - ФормаКлиентскогоПриложения - форма пакета.
//  ОповещениеОЗакрытии - ОписаниеОповещения - обработчик результата редактора.
&НаКлиенте
Процедура ОткрытьРедактор(Документ, СтраныМира, ФормаВладелец, ОповещениеОЗакрытии) Экспорт

	ПараметрыРедактора = Новый Структура("Документ,СтраныМира", Документ, СтраныМира);
	СинхронныеМодальныеВызовы().смв_ОткрытьФорму(ПолноеИмяОбработкиРедактора + ".Форма.РедакторДокумента",
		ПараметрыРедактора, ФормаВладелец, Истина, , , ОповещениеОЗакрытии,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтаФорма.ПолноеИмяОбработкиРедактора = РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя();

КонецПроцедуры

// #КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Клиентские библиотеки выбираются в том же режиме, что и редактор.

&НаКлиенте
Функция Стд() Экспорт

	Если СтдКэш = Неопределено Тогда
		// Совместимость с 8.2; получаем форму-модуль без открытия окна.
		// BSLLS:DeprecatedFind-off
		ТипОбработки = Лев(ИмяФормы, Найти(ИмяФормы, ".") - 1);
		// BSLLS:DeprecatedFind-on
		// BSLLS:GetFormMethod-off
		СтдКэш = ПолучитьФорму(ТипОбработки + ".КонтурДиадокСтд.Форма.Клиент", , ЭтаФорма);
		// BSLLS:GetFormMethod-on
	КонецЕсли;
	Возврат СтдКэш;

КонецФункции

&НаКлиенте
Функция СинхронныеМодальныеВызовы() Экспорт

	Если СМВКэш = Неопределено Тогда
		// На 8.2 СтрНайти недоступен, библиотека загружается как форма-модуль без открытия окна.
		// BSLLS:DeprecatedFind-off
		ТипОбработки = Лев(ИмяФормы, Найти(ИмяФормы, ".") - 1);
		// BSLLS:DeprecatedFind-on
		// BSLLS:GetFormMethod-off
		СМВКэш = ПолучитьФорму(ТипОбработки + ".КонтурЭДО.Форма.Модуль_СинхронныеМодальныеВызовы", , ЭтаФорма);
		// BSLLS:GetFormMethod-on
	КонецЕсли;
	Возврат СМВКэш;

КонецФункции

// Показывает причину ошибки без стека и зависимости от общих модулей конфигурации.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - ошибка, полученная в обработчике исключения.
&НаКлиенте
Процедура СообщитьОбОшибке(Ошибка) Экспорт

	Пока Ошибка.Причина <> Неопределено Цикл
		Ошибка = Ошибка.Причина;
	КонецЦикла;
	Стд().Диалоги().ПоказатьПредупреждениеЛок(, Ошибка.Описание);

КонецПроцедуры
