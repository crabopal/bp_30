// ДопСвойства

Функция ЗначениеНастройки_Диадок(ИмяСправочника, ИмяЭлемента)
	
	Результат = Неопределено;
	
	МодульХранения = КонтурДиадокХранениеДанных();
	
	ВладелецНастройки = МодульХранения.ДопСправочники_НайтиПоНаименованию_Диадок(
		ИмяСправочника,
		ИмяЭлемента
	);
	
	Если ВладелецНастройки <> Неопределено Тогда
		
		Результат = МодульХранения.ДопРеквизиты_Значение_Диадок(
			ВладелецНастройки,
			ИдентификаторЗначенияСправочника_Диадок()
		);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьЗначениеНастройки_Диадок(ИмяСправочника, ИмяЭлемента, ИмяРеквизита, Значение)
	
	МодульХранения = КонтурДиадокХранениеДанных();
	
	ВладелецНастройки = МодульХранения.ДопСправочники_СсылкаПоИдентификатору_Диадок(ИмяСправочника, Значение);
	Если НЕ ЗначениеЗаполнено(ВладелецНастройки) Тогда
		ВладелецНастройки = МодульХранения.ДопСправочники_СоздатьЭлемент_Диадок(ИмяСправочника, ИмяРеквизита);
	КонецЕсли;
	
	МодульХранения.ДопРеквизиты_УстановитьЗначение_Диадок(
		ВладелецНастройки.Ссылка,
		ИдентификаторЗначенияСправочника_Диадок(),
		Значение,
		ИмяРеквизита
	);
	
КонецПроцедуры

Процедура УдалитьЭлементСправочника_Диадок(ИмяСправочника, ЭлементСправочника)
	
	МодульХранения = КонтурДиадокХранениеДанных();
	
	ВладелецНастройкиСсылка = МодульХранения.ДопСправочники_СсылкаПоИдентификатору_Диадок(
		ИмяСправочника,
		ЭлементСправочника
	);
	
	Если ЗначениеЗаполнено(ВладелецНастройкиСсылка) Тогда
		
		ВладелецНастройкиОбъект = ВладелецНастройкиСсылка.ПолучитьОбъект();
		ВладелецНастройкиОбъект.Удалить();
		
	КонецЕсли;
	
КонецПроцедуры

Функция НовыеНастройкиСопоставления()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Объект");
	Результат.Колонки.Добавить("Свойство");
	Результат.Колонки.Добавить("Значение");
	
	Возврат Результат;
	
