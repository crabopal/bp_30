Функция ДопСвойствоПоНаименованию(Наименование)
	
	ИмяСвойства = СтдСтр().СтрШаблонЛок("%1%2", ПрефиксНастройки_1С(), Наименование);
	ТочноеСоответствие = Истина;
	
	Результат = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(
		ИмяСвойства,
		ТочноеСоответствие
	);
	
	Возврат Результат;
	
