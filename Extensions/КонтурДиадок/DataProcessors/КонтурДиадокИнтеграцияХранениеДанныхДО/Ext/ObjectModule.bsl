// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Устанавливает библиотеку интеграции с конфигурацией 1С:Документооборот
//
// Параметры:
//  МодульИнтеграцииДО - ОбработкаОбъект - Библиотека интеграции с коонфигурацией 1С:Документооборот
//
Процедура УстановитьМодульИнтеграции(Знач МодульИнтеграцииДО) Экспорт
	
	ИнтеграцияСлужебный = МодульИнтеграцииДО;
	
КонецПроцедуры

// Обработка исходящих

// Возвращает настройки сопоставления видов электронных документов с видами документов учета - основаниями ЭД
//
// Параметры:
//  ОписаниеВидовДокументов - Структура - Виды электронных документов на отправку:
//   * Ключ - Строка - Идентификатор вида электронного документа
//   * Значение - Строка - Представление электронного документа на отправку
// 
// Возвращаемое значение:
//  Соответствие - Настройки сопоставления:
//   * Ключ - СправочникСсылка -  Вид документа учета - основания электронного документа
//   * Значение - Строка - Идентификатор вида электронного документа
//
Функция РасширенныеНастройкиОтправки(ОписаниеВидовДокументов) Экспорт
	
	Результат = Новый Соответствие;
	
	Если ИспользуетсяПодсистемаДиадок Тогда
		ЗаписиНастроек = НастройкиОтправки_Диадок(ОписаниеВидовДокументов);
	Иначе
		ЗаписиНастроек = НастройкиОтправки_1С(ОписаниеВидовДокументов);
	КонецЕсли;
	
	Для Каждого Элемент Из ОписаниеВидовДокументов Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Значение", Элемент.Ключ);
		РезультатПоиска = ЗаписиНастроек.НайтиСтроки(Отбор);
		
		Для Каждого СохраненнаяНастройка Из РезультатПоиска Цикл
			Результат.Вставить(СохраненнаяНастройка.Объект, СохраненнаяНастройка.Значение);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Устанавливает настройки сопоставления видов электронных документов с видами документов учета - основаниями ЭД
//
// Параметры:
//  НастройкиОтправки - Соответствие - Настройки сопоставления:
//   * Ключ - СправочникСсылка -  Вид документа учета - основания электронного документа
//   * Значение - Строка - Идентификатор вида электронного документа
//  ОписаниеВидовДокументов - Структура - Виды электронных документов на отправку:
//   * Ключ - Строка - Идентификатор вида электронного документа
//   * Значение - Строка - Представление электронного документа на отправку
//
Процедура ЗаписатьНастройкиОтправки(НастройкиОтправки, ОписаниеВидовДокументов) Экспорт
	
	УстаревшиеНастройки = РасширенныеНастройкиОтправки(ОписаниеВидовДокументов);
	
	УдалитьНастройкиОтправки(УстаревшиеНастройки);
	
	Если ИспользуетсяПодсистемаДиадок Тогда
		ЗаписатьНастройкиОтправки_Диадок(НастройкиОтправки);
	Иначе
		ЗаписатьНастройкиОтправки_1С(НастройкиОтправки);
	КонецЕсли;
	
КонецПроцедуры

// Обработка входящих

// Устанавливает настройки сопоставления типов электронных документов с типами документов учета
//
// Параметры:
//  ОписаниеТиповЭлектронныхДокументов - Структура - Типы электронных документов для сопоставления с документами учета:
//   * Ключ - Строка - Идентификатор типа электронного документа
//   * Значение - Строка - Представление типа электронного документа
// 
// Возвращаемое значение:
//  Соответствие - Настройки сопоставления типов электронных документов и документов учета:
//   * Ключ - СправочникСсылка - Ссылка на тип документа учета
//   * Значение - Строка - Идентификатор типа электронного документа
//
Функция РасширенныеНастройкиВходящих(ОписаниеТиповЭлектронныхДокументов) Экспорт
	
	Результат = Новый Соответствие;
	
	ВладельцыНастроек = ИнтеграцияСлужебный.ВладельцыНастроекВходящегоДО();
	
	Если ИспользуетсяПодсистемаДиадок Тогда
		ЗаписиНастроек = НастройкиВходящего_Диадок(
			ВладельцыНастроек,
			ОписаниеТиповЭлектронныхДокументов
		);
	Иначе
		ЗаписиНастроек = НастройкиВходящего_1С(
			ВладельцыНастроек,
			ОписаниеТиповЭлектронныхДокументов
		);
	КонецЕсли;
	
	Для Каждого Элемент Из ОписаниеТиповЭлектронныхДокументов Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Значение", Элемент.Ключ);
		РезультатПоиска = ЗаписиНастроек.НайтиСтроки(Отбор);
		
		Для Каждого СохраненнаяНастройка Из РезультатПоиска Цикл
			Результат.Вставить(СохраненнаяНастройка.Объект, СохраненнаяНастройка.Значение);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Процедура - Записать настройки входящих
//
// Параметры:
//  НастройкиВходящих - Соответствие - Настройки сопоставления типов электронных документов и документов учета:
//   * Ключ - СправочникСсылка - Ссылка на тип документа учета
//   * Значение - Строка - Идентификатор типа электронного документа
//  ОписаниеТиповЭлектронныхДокументов - Структура - Типы электронных документов для сопоставления с документами учета:
//   * Ключ - Строка - Идентификатор типа электронного документа
//   * Значение - Строка - Представление типа электронного документа
//
Процедура ЗаписатьНастройкиВходящих(НастройкиВходящих, ОписаниеТиповЭлектронныхДокументов) Экспорт
	
	УстановленныеНастройки = РасширенныеНастройкиВходящих(ОписаниеТиповЭлектронныхДокументов);
	
	УдалитьНастройкиВходящих(УстановленныеНастройки);
	
	Если ИспользуетсяПодсистемаДиадок Тогда
		ЗаписатьНастройкиВходящего_Диадок(НастройкиВходящих);
	Иначе
		ЗаписатьНастройкиВходящего_1С(НастройкиВходящих);
	КонецЕсли;
	
КонецПроцедуры

// Обработка признака готовности к отправке

// Возвращает значение настройки для отметки готовности документа к отправке
// 
// Возвращаемое значение:
//  ПВХСсылка - Свойство для установки признака готовности к отправке
//
Функция НастройкаПризнакПоДокументу() Экспорт
	
	Если ИспользуетсяПодсистемаДиадок Тогда
		Результат = ПризнакПоДокументу_Диадок();
	Иначе
		Результат = ПризнакПоДокументу_1С();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Устанавливает значение настройки для отметки готовности документа к отправке
//
// Параметры:
//  ПризнакПоДокументу - ПВХСсылка - Свойство для установки признака готовности к отправке
//
Процедура ЗаписатьНастройкиПризнакПоДокументу(ПризнакПоДокументу) Экспорт
	
	Если ИспользуетсяПодсистемаДиадок Тогда
		ЗаписатьПризнакПоДокументу_Диадок(ПризнакПоДокументу);
	Иначе
		ЗаписатьПризнакПоДокументу_1С(ПризнакПоДокументу);
	КонецЕсли;
	
КонецПроцедуры

// Вызовы из библиотеки интеграции

// Возвращает ссылку на вид документа учета, сопоставленный с указанным в параметре видом документа на отправку
//
// Параметры:
//  ВидПакета - Строка - Идентификатор вида пакета на отправку
// 
// Возвращаемое значение:
//  СправочниуСсылка - Ссылкана вид документа учета
//
Функция ВидДокументаПоИдентификаторуПакета(ВидПакета) Экспорт
	
	Результат = Неопределено;
	
	ОписаниеВидовДокументов = Новый Соответствие;
	ОписаниеВидовДокументов.Вставить(ВидПакета);
	
	Если ИспользуетсяПодсистемаДиадок Тогда
		ЗаписиНастроек = НастройкиОтправки_Диадок(ОписаниеВидовДокументов);
	Иначе
		ЗаписиНастроек = НастройкиОтправки_1С(ОписаниеВидовДокументов);
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Значение", ВидПакета);
	РезультатПоиска = ЗаписиНастроек.НайтиСтроки(Отбор);
	
	Если РезультатПоиска.Количество() > 0 Тогда
		Результат = РезультатПоиска[0].Объект;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ МЕТОДЫ

Процедура УдалитьНастройкиОтправки(НастройкиОтправкиДО)
	
	Если ИспользуетсяПодсистемаДиадок Тогда
		УдалитьНастройкиОтправки_Диадок(НастройкиОтправкиДО);
	Иначе
		УдалитьНастройкиОтправки_1С(НастройкиОтправкиДО);
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьНастройкиВходящих(НастройкиВходящегоДО)
	
	Если ИспользуетсяПодсистемаДиадок Тогда
		УдалитьНастройкиВходящего_Диадок(НастройкиВходящегоДО);
	Иначе
		УдалитьНастройкиВходящего_1С(НастройкиВходящегоДО);
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ХРАНЕНИЕ ДАННЫХ

// Настройки отправки

Функция НастройкиОтправки_1С(ОписаниеВидовДокументов)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Объект");
	Результат.Колонки.Добавить("Свойство");
	Результат.Колонки.Добавить("Значение");
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Объект КАК Объект,
	|	ВЫРАЗИТЬ(Т.Свойство.Наименование КАК Строка(150)) КАК Свойство,
	|	Т.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Т
	|ГДЕ
	|	Т.Объект = &ВладелецНастроек
	|	И Т.Свойство В(&Свойства)";
	
	Свойства = Новый Массив;
	Для Каждого Элемент Из ОписаниеВидовДокументов Цикл
		ИмяСвойства = ДопСвойствоСопоставлениеВидаДокумента1С(Элемент.Ключ);
		Свойства.Добавить(ДопСвойствоПоНаименованию(ИмяСвойства));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВладелецНастроек", ОбъектОбщихНастроек_1С());
	Запрос.УстановитьПараметр("Свойства", Свойства);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Элемент Из РезультатЗапроса Цикл
		
		ПрефиксСвойства = СтдСтр().СтрШаблонЛок("%1%2_", ПрефиксНастройки_1С(), ПрефиксСопоставленныйВидДокумента());
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Объект = Элемент.Значение;
		НоваяСтрока.Свойство = Элемент.Свойство;
		НоваяСтрока.Значение = СтрЗаменить(Элемент.Свойство, ПрефиксСвойства, "");
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НастройкиОтправки_Диадок(ОписаниеВидовДокументов)
	
	Результат = НовыеНастройкиСопоставления();
	
	Для Каждого Элемент Из ОписаниеВидовДокументов Цикл
		
		ИмяСправочника = ИмяСправочникаРасширенныеНастройкиОтправки();
		ЗначениеНастройки = ЗначениеНастройки_Диадок(ИмяСправочника, Элемент.Ключ);
		
		Если ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Объект = ЗначениеНастройки;
			НоваяСтрока.Свойство = Элемент.Ключ;
			НоваяСтрока.Значение = Элемент.Ключ;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура УдалитьНастройкиОтправки_1С(НастройкиОтправкиДО)
	
	ДанныеДляУдаления = Новый Массив;
	Для Каждого Элемент Из НастройкиОтправкиДО Цикл
		ДанныеДляУдаления.Добавить(ДопСвойствоСопоставлениеВидаДокумента1С(Элемент.Значение));
	КонецЦикла;
	
	МодульХранения = КонтурДиадокХранениеДанных();
	
	Для Каждого Элемент Из ДанныеДляУдаления Цикл
		МодульХранения.ДопРеквизиты_УдалитьЗначение_1С(ОбъектОбщихНастроек_1С(), ДопСвойствоПоНаименованию(Элемент));
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНастройкиОтправки_Диадок(НастройкиОтправкиДО)
	
	Для Каждого Элемент Из НастройкиОтправкиДО Цикл
		
		ИмяСправочника = ИмяСправочникаРасширенныеНастройкиОтправки();
		УдалитьЭлементСправочника_Диадок(ИмяСправочника, Элемент.Ключ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьНастройкиОтправки_1С(НастройкиОтправкиДО)
	
	МодульХранения = КонтурДиадокХранениеДанных();
	
	Для Каждого Элемент Из НастройкиОтправкиДО Цикл
		
		МодульХранения.ДопРеквизиты_УстановитьЗначение_1С(
			Неопределено,
			ДопСвойствоСопоставлениеВидаДокумента1С(Элемент.Значение),
			Элемент.Ключ
		);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьНастройкиОтправки_Диадок(НастройкиОтправкиДО)
	
	ИмяСправочника = ИмяСправочникаРасширенныеНастройкиОтправки();
	
	Для Каждого Элемент Из НастройкиОтправкиДО Цикл
		
		ЗаписатьЗначениеНастройки_Диадок(
			ИмяСправочника,
			Элемент.Значение,
			Элемент.Значение,
			Элемент.Ключ
		);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИмяСправочникаРасширенныеНастройкиОтправки()
	Возврат "НастройкиОтправки";
КонецФункции

// Настройки входящего ДО

Функция НастройкиВходящего_1С(ВладельцыНастроек, ОписаниеВидовЭлектронныхДокументов)
	
	ДопСвойства = Новый Массив;
	Для Каждого Элемент Из ОписаниеВидовЭлектронныхДокументов Цикл
		ДопСвойства.Добавить(ДопСвойствоСопоставлениеВидаДокумента1С(Элемент.Ключ));
	КонецЦикла;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Объект КАК Объект,
	|	Т.Свойство КАК Свойство,
	|	Т.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Т
	|ГДЕ
	|	Т.Объект В(&ВладельцыНастроек)
	|	И Т.Свойство В(&Свойства)";
	
	Свойства = Новый Массив;
	Для Каждого Элемент Из ДопСвойства Цикл
		Свойства.Добавить(ДопСвойствоПоНаименованию(Элемент));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВладельцыНастроек", ВладельцыНастроек);
	Запрос.УстановитьПараметр("Свойства", Свойства);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция НастройкиВходящего_Диадок(ВладельцыНастроек, ОписаниеВидовЭлектронныхДокументов)
	
	Результат = НовыеНастройкиСопоставления();
	
	МодульХранения = КонтурДиадокХранениеДанных();
	
	ИмяСправочника = ИмяСправочникаРасширенныеНастройкиВходящегоДО();
	ЭлементыСправочника = МодульХранения.ДопСправочники_СсылкиНаЭлементыСправочникаПоИдентификаторам_Диадок(
		ИмяСправочника,
		ВладельцыНастроек
	);
	
	Для Каждого Элемент Из ЭлементыСправочника Цикл
		
		ДопРеквизит = Элемент.Значение.ДополнительныеРеквизиты.Найти(
			Элемент.Ключ,
			"Значение"
		);
		
		Если ЗначениеЗаполнено(ДопРеквизит) Тогда
			
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Объект = ДопРеквизит.Значение;
			НоваяСтрока.Свойство = ДопРеквизит.ЗначениеСтрока;
			НоваяСтрока.Значение = ДопРеквизит.ЗначениеСтрока;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура УдалитьНастройкиВходящего_1С(НастройкиВходящегоДО)
	
	ДанныеДляУдаления = Новый Соответствие;
	Для Каждого Элемент Из НастройкиВходящегоДО Цикл
		ДанныеДляУдаления.Вставить(Элемент.Ключ, ДопСвойствоСопоставлениеВидаДокумента1С(Элемент.Значение));
	КонецЦикла;
	
	МодульХранения = КонтурДиадокХранениеДанных();
	
	Для Каждого Элемент Из ДанныеДляУдаления Цикл
		МодульХранения.ДопРеквизиты_УдалитьЗначение_1С(Элемент.Ключ, ДопСвойствоПоНаименованию(Элемент.Значение));
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНастройкиВходящего_Диадок(НастройкиВходящегоДО)
	
	Для Каждого Элемент Из НастройкиВходящегоДО Цикл
		
		ИмяСправочника = ИмяСправочникаРасширенныеНастройкиВходящегоДО();
		УдалитьЭлементСправочника_Диадок(ИмяСправочника, Элемент.Ключ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьНастройкиВходящего_1С(НастройкиВходящих)
	
	МодульХранения = КонтурДиадокХранениеДанных();
	
	Для Каждого Элемент Из НастройкиВходящих Цикл
		
		МодульХранения.ДопРеквизиты_УстановитьЗначение_1С(
			Элемент.Ключ,
			ДопСвойствоСопоставлениеВидаДокумента1С(Элемент.Значение),
			Элемент.Значение
		);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьНастройкиВходящего_Диадок(НастройкиВходящих)
	
	ИмяСправочника = ИмяСправочникаРасширенныеНастройкиВходящегоДО();
	
	Для Каждого Элемент Из НастройкиВходящих Цикл
		
		ЗаписатьЗначениеНастройки_Диадок(
			ИмяСправочника,
			Элемент.Значение,
			Элемент.Значение,
			Элемент.Ключ
		);
		
	КонецЦикла;
	
КонецПроцедуры

