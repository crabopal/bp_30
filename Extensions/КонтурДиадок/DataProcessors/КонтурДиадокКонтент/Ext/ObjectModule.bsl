////////////////////////////////////////////////////////////////////////////////
// ОПИСАНИЕ ПЕРЕМЕННЫХ

// BSLLS:UnusedLocalVariable-off
Перем ФабрикаПровайдеровЛок; // фабрика провайдеров конфигурации
Перем КонтентУКДЛок; // сборщик контента УКД
// BSLLS:UnusedLocalVariable-on

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Собирает контракт УКД по ссылке на учетный документ.
// Параметры:
//  ДокСсылка - ДокументСсылка - учетный документ; пустая ссылка недопустима.
//  ДопПараметры - Неопределено - зарезервировано, не используется.
// Возвращаемое значение:
//  ФиксированнаяСтруктура - контракт УКД; не Неопределено.
Функция УКД(ДокСсылка, ДопПараметры) Экспорт

	Провайдер = ФабрикаПровайдеров().СоздатьПровайдер(ДокСсылка);
	Результат = КонтентУКД().Собрать(Провайдер);

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ

Функция ЭтоВнешняяОбработка()

	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
	ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);

	Возврат ПараметрыПроверки.ИспользуемоеИмяФайла <> Неопределено;

КонецФункции

Функция ФабрикаПровайдеров()

	Если ФабрикаПровайдеровЛок = Неопределено Тогда
		Если ЭтоВнешняяОбработка() Тогда
			ФабрикаПровайдеровЛок = Новый("ExternalDataProcessorObject.КонтурДиадокКонтентФабрикаПровайдеров");
		Иначе
			ФабрикаПровайдеровЛок = Новый("DataProcessorObject.КонтурДиадокКонтентФабрикаПровайдеров");
		КонецЕсли;
	КонецЕсли;

	Возврат ФабрикаПровайдеровЛок;

КонецФункции

Функция КонтентУКД()

	Если КонтентУКДЛок = Неопределено Тогда
		Если ЭтоВнешняяОбработка() Тогда
			КонтентУКДЛок = Новый("ExternalDataProcessorObject.КонтурДиадокКонтентУКД");
		Иначе
			КонтентУКДЛок = Новый("DataProcessorObject.КонтурДиадокКонтентУКД");
		КонецЕсли;
	КонецЕсли;

	Возврат КонтентУКДЛок;

КонецФункции
