Функция ТекстЗапросаТоварыУсловия(мтдТовары)
	
	ТекстЗапроса = "";
	ПолеЗапросаНоменклатура = ПолеЗапроса(мтдТовары, ПолеНоменклатура());
	
	Если ПолеЗапросаНоменклатура = "ДанныеИз1С.Номенклатура" Тогда
		мтдНоменклатура = Метаданные.Справочники.Найти("Номенклатура");
		Если мтдНоменклатура <> Неопределено Тогда
			Если ЕстьРеквизитМетаданных(мтдНоменклатура, "Услуга") Тогда
				ТекстЗапроса = ТекстЗапроса + "
				|	И НЕ " + ПолеЗапросаНоменклатура + ".Услуга = ИСТИНА
				|";
			ИначеЕсли ЕстьРеквизитМетаданных(мтдНоменклатура, "ТипНоменклатуры") И Метаданные.Перечисления.Найти("ТипыНоменклатуры") <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + "
				|	И НЕ " + ПолеЗапросаНоменклатура + ".ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
				|	И НЕ " + ПолеЗапросаНоменклатура + ".ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
				|";
				Если Метаданные.Перечисления.ТипыНоменклатуры.ЗначенияПеречисления.Найти("МногооборотнаяТара") <> Неопределено Тогда
					ТекстЗапроса = ТекстЗапроса + "
					|	И НЕ " + ПолеЗапросаНоменклатура + ".ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
					|";
				КонецЕсли;
			ИначеЕсли ЕстьРеквизитМетаданных(мтдНоменклатура, "ВидНоменклатуры") Тогда
				мтдВидНоменклатуры = Метаданные.Справочники.Найти("ВидыНоменклатуры");
				Если мтдВидНоменклатуры <> Неопределено И ЕстьРеквизитМетаданных(мтдВидНоменклатуры, "ТипНоменклатуры") Тогда
					ТекстЗапроса = ТекстЗапроса + "
					|	И НЕ " + ПолеЗапросаНоменклатура + ".ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
					|	И НЕ " + ПолеЗапросаНоменклатура + ".ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
					|";
					Если Метаданные.Перечисления.ТипыНоменклатуры.ЗначенияПеречисления.Найти("МногооборотнаяТара") <> Неопределено Тогда
						ТекстЗапроса = ТекстЗапроса + "
						|	И НЕ " + ПолеЗапросаНоменклатура + ".ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
						|";
					КонецЕсли;
				ИначеЕсли Метаданные.Перечисления.Найти("ВидыНоменклатуры") <> Неопределено Тогда
					ТекстЗапроса = ТекстЗапроса + "
					|	И НЕ " + ПолеЗапросаНоменклатура + ".ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
					|";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТипРеквизитаОбъекта(МетаданныеОбъекта, Реквизиты)
	
	ТипРеквизита = Неопределено;
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат ТипРеквизита;
	КонецЕсли;
	
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		СписокРеквизитов = Новый Массив; 
		СписокРеквизитов.Добавить(Реквизиты);
	Иначе
		СписокРеквизитов = Реквизиты;
	КонецЕсли;
	
	ПолноеИмяМетаданных = МетаданныеОбъекта.ПолноеИмя();
	
	Для Каждого ИмяРеквизита Из СписокРеквизитов Цикл
		
		мтдРеквизита = МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита);
		Если мтдРеквизита = Неопределено Тогда
			мтдОбщегоРеквизита = Метаданные.ОбщиеРеквизиты.Найти(ИмяРеквизита);
			Если мтдОбщегоРеквизита <> Неопределено Тогда
				ВСоставе = мтдОбщегоРеквизита.Состав.Найти(МетаданныеОбъекта);
				Если ВСоставе <> Неопределено Тогда
					Если ВСоставе.Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать Тогда
						мтдРеквизита = мтдОбщегоРеквизита;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если мтдРеквизита <> Неопределено Тогда
			ТипыРеквизита = мтдРеквизита.Тип.Типы();
			Если ТипыРеквизита.Количество() = 1 Тогда
				ТипРеквизита = ТипыРеквизита[0]; //необходимо однозначное определение типа, иначе могут быть ошибки
			ИначеЕсли ТипыРеквизита.Количество() = 2
				И ПолноеИмяМетаданных = "Документ.СчетНаОплатуПокупателю.ТабличнаяЧасть.Товары"
				И ИмяРеквизита = "Номенклатура" Тогда
				//пока такое только в БУ_3 у СчетНаОплатуПокупателю - ОС и Номенклатура
				Для Каждого СтрокаТипа Из ТипыРеквизита Цикл
					мтдРеквизита = Метаданные.НайтиПоТипу(СтрокаТипа);
					Если мтдРеквизита.Имя = "Номенклатура" Тогда
						ТипРеквизита = СтрокаТипа;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТипРеквизита;
	
КонецФункции

Функция ПолеЗапроса(МетаданныеОбъекта, Реквизиты, ТекстЗапросаВТ = "", ТекстСоединенияВТ = "")
	
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	ПолноеИмяМетаданных = МетаданныеОбъекта.ПолноеИмя();
	ЭтоДокумент = Лев(МетаданныеОбъекта.ПолноеИмя(), 8) = "Документ";
	ЭтоСправочник = Лев(МетаданныеОбъекта.ПолноеИмя(), 10) = "Справочник";

	
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		СписокРеквизитов = Новый Массив; 
		СписокРеквизитов.Добавить(Реквизиты);
	Иначе
		СписокРеквизитов = Реквизиты;
	КонецЕсли;
	
	Для Каждого ДанныеРеквизита Из СписокРеквизитов Цикл
			
		Если ТипЗнч(ДанныеРеквизита) = Тип("Структура") Тогда
			ИмяРеквизита = ДанныеРеквизита.ИмяРеквизита;
			ПолеЗапроса = ДанныеРеквизита.ПолеЗапроса;
			
			_ТекстЗапросаВТ = ?(СтрНайтиЛок(ТекстЗапросаВТ, ДанныеРеквизита.ТекстЗапросаВТ) > 0, "", ДанныеРеквизита.ТекстЗапросаВТ);
			_ТекстСоединенияВТ =  ДанныеРеквизита.ТекстСоединенияВТ;
		Иначе
			ИмяРеквизита = ДанныеРеквизита;
			ПолеЗапроса = "ДанныеИз1С." + ДанныеРеквизита;
			_ТекстЗапросаВТ = "";
			_ТекстСоединенияВТ = "";
		КонецЕсли;
		
		Если ЕстьРеквизитМетаданных(МетаданныеОбъекта, ИмяРеквизита) Тогда
			ТекстЗапросаВТ = ТекстЗапросаВТ + _ТекстЗапросаВТ;
			ТекстСоединенияВТ = ТекстСоединенияВТ + _ТекстСоединенияВТ;
			Возврат ПолеЗапроса;
		ИначеЕсли Метаданные.ОбщиеРеквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			ТекстЗапросаВТ = ТекстЗапросаВТ + _ТекстЗапросаВТ;
			ТекстСоединенияВТ = ТекстСоединенияВТ + _ТекстСоединенияВТ;
			Возврат ПолеЗапроса;
		ИначеЕсли ИмяРеквизита = "Ссылка" Тогда
			Возврат "ДанныеИз1С.Ссылка";
		ИначеЕсли ИмяРеквизита = "Код" 
			И ЭтоСправочник 
			И ЕстьСтандартныйРеквизит(МетаданныеОбъекта, "Код") Тогда
			Возврат "ДанныеИз1С.Код";
		ИначеЕсли ИмяРеквизита = "Наименование"
			И ЭтоСправочник 
			И ЕстьСтандартныйРеквизит(МетаданныеОбъекта, "Наименование") Тогда
			Возврат "ДанныеИз1С.Наименование";
		ИначеЕсли ИмяРеквизита = "Дата" И ЭтоДокумент Тогда
			Возврат "ДанныеИз1С.Дата";
		ИначеЕсли ИмяРеквизита = "Номер" И ЭтоДокумент Тогда
			Возврат "ДанныеИз1С.Номер";
		ИначеЕсли ИмяРеквизита = "Владелец" И ЭтоСправочник Тогда
			Возврат "ДанныеИз1С.Владелец";
		КонецЕсли;
		
	КонецЦикла;

	Возврат "НЕОПРЕДЕЛЕНО";
	
КонецФункции

Функция ЕстьСтандартныйРеквизит(ОбъектМетаданных, ИмяРеквизита)
	
	Если ОбъектМетаданных = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьРеквизит = Ложь;
	
	КоллекцияРеквизитов = ОбъектМетаданных.СтандартныеРеквизиты;
	
	Для Каждого СтандартныйРеквизит Из КоллекцияРеквизитов Цикл 
		
		Если ВРег(СтандартныйРеквизит.Имя) = ВРег(ИмяРеквизита) Тогда 
			ЕстьРеквизит = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьРеквизит;
	
КонецФункции

Функция ТипУчастника(СсылкаНаОбъект) Экспорт
	
	Результат = "ЮЛ";
	
	мтд = СсылкаНаОбъект.Метаданные();
	ИмяСправочника = мтд.Имя;
	ИмяРеквизитаЮрФизЛицо = Неопределено;
	Если мтд.Реквизиты.Найти("ФормаСобственности") <> Неопределено Тогда
		ИмяРеквизитаЮрФизЛицо = "ФормаСобственности";
	ИначеЕсли мтд.Реквизиты.Найти("ВидКонтрагента") <> Неопределено Тогда
		ИмяРеквизитаЮрФизЛицо = "ВидКонтрагента";
	ИначеЕсли мтд.Реквизиты.Найти("ЮрФизЛицо") <> Неопределено Тогда 
		ИмяРеквизитаЮрФизЛицо = "ЮрФизЛицо";
	ИначеЕсли мтд.Реквизиты.Найти("ЮридическоеФизическоеЛицо") <> Неопределено Тогда
		ИмяРеквизитаЮрФизЛицо = "ЮридическоеФизическоеЛицо";
	КонецЕсли;
	
	Если ИмяРеквизитаЮрФизЛицо <> Неопределено Тогда
		
		ИмяПеречисления = СсылкаНаОбъект[ИмяРеквизитаЮрФизЛицо].Метаданные().Имя;
		Если Не СсылкаНаОбъект[ИмяРеквизитаЮрФизЛицо].Пустая() Тогда
			
			ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(СсылкаНаОбъект[ИмяРеквизитаЮрФизЛицо]);
			ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;
			
			Если ИмяЗначенияПеречисления = "ЮридическоеЛицо" 
				Или ИмяЗначенияПеречисления = "ЮрЛицо"
				Или ИмяЗначенияПеречисления = "Компания" Тогда
				
				Результат = "ЮЛ";
				
			ИначеЕсли ИмяЗначенияПеречисления = "ИндивидуальныйПредприниматель"
				Или ИмяЗначенияПеречисления = "ЧастныйПредприниматель" Тогда
				
				Результат = "ИП";
				
			ИначеЕсли ИмяЗначенияПеречисления = "ФизическоеЛицо" 
				Или ИмяЗначенияПеречисления = "ЧастноеЛицо"
				Или ИмяЗначенияПеречисления = "ФизЛицо" Тогда
				
				Если ИмяСправочника = "Организации" Тогда
					Результат = "ИП";
				Иначе
					Результат = "ФЛ";
				КонецЕсли;
				
				Если мтд.Реквизиты.Найти("СтатусФизическогоЛица") <> Неопределено Тогда
					Если ЗначениеЗаполнено(СсылкаНаОбъект["СтатусФизическогоЛица"]) Тогда
						ИмяПеречисленияФЛ = СсылкаНаОбъект["СтатусФизическогоЛица"].Метаданные().Имя;
                    	ИндексЗначенияПеречисленияФЛ = Перечисления[ИмяПеречисленияФЛ].Индекс(СсылкаНаОбъект["СтатусФизическогоЛица"]);
						ИмяЗначенияПеречисленияФЛ = Метаданные.Перечисления[ИмяПеречисленияФЛ].ЗначенияПеречисления[ИндексЗначенияПеречисленияФЛ].Имя;
						Если ИмяЗначенияПеречисленияФЛ = "ИндивидуальныйПредприниматель" Тогда
							Результат = "ИП";
						Иначе
							Результат = "ФЛ";
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли мтд.Реквизиты.Найти("ИндивидуальныйПредприниматель") <> Неопределено Тогда
					Если ЗначениеЗаполнено(СсылкаНаОбъект.ИндивидуальныйПредприниматель) Тогда
						Результат = "ИП";
					Иначе
						Результат = "ФЛ";
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ПредопределенныеЭлементыСправочника(ИмяСправочника, Варианты)
	
	Результат = Новый Массив;
	
	Если Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИмяСправочника.Ссылка
		|ИЗ
		|	&СправочникИмяСправочника КАК ИмяСправочника
		|ГДЕ
		|	ИмяСправочника.Наименование В (&Варианты)
		|	И ИмяСправочника.Предопределенный";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СправочникИмяСправочника", "Справочник." + ИмяСправочника);
		Запрос.Параметры.Вставить("Варианты", Варианты);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

