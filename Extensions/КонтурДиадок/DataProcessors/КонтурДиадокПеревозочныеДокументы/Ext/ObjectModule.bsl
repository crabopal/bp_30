	ТекстXML = ПолучитьМакет("Retail_list_inn");
	Результат = ТекстXML.ПолучитьТекст();
			
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСодержимоеНастроекТорговыхСетей()
	
	Результат = Новый Структура;
	
	Ядро = Модуль_Ядро();
	
	НастройкиИзСервиса = Ядро.ПеревозочныеДокументы_ПолучитьНастройкиТорговыхСетей();
	Если ЗначениеЗаполнено(НастройкиИзСервиса) Тогда
		Результат = НастройкиИзСервиса;
	Иначе
		ТекстJSON = ПолучитьМакет("Retail_requirements_JSON");
		Результат = Ядро.ПарсерJSON_Прочитать(ТекстJSON.ПолучитьТекст());
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции

Функция СписокТорговыхСетей() Экспорт
	
	ПредставлениеТорговыхСетей = ПредставлениеТорговыхСетей();
	
	Результат = Новый СписокЗначений;
	JSON_Шаблон = ПолучитьСодержимоеНастроекТорговыхСетей();
	networks_settings =  JSON_Шаблон["networks_settings"];
	Для Каждого ТорговаяСеть Из networks_settings Цикл
		КодТорговойСети = ТорговаяСеть["net_code"];
		Представление = ПредставлениеТорговыхСетей[КодТорговойСети];
		Если Представление <> Неопределено Тогда
			Результат.Добавить(КодТорговойСети, Представление);
		Иначе
			Результат.Добавить(КодТорговойСети, КодТорговойСети);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеПоляТорговойСети(КодПоля) Экспорт
	
	ПоляТорговойСети = Новый Соответствие;
	ПоляТорговойСети.Вставить("ORDERS", "Номер заказа");
	ПоляТорговойСети.Вставить("ORDERS_DATE", "Дата заказа");
	ПоляТорговойСети.Вставить("DESADV", "Номер отгрузки");
	ПоляТорговойСети.Вставить("DESADV_DATE", "Дата отгрузки");
	ПоляТорговойСети.Вставить("INVOIC", "Номер УПД");
	ПоляТорговойСети.Вставить("INVOIC_DATE", "Дата УПД");
	
	Результат = ПоляТорговойСети[КодПоля];
	Возврат ?(Результат = Неопределено, КодПоля, Результат);
	
КонецФункции

Процедура ЗаполнитьПоляТорговойСети(рл_ИнфПол, КодТорговойСети) Экспорт
	
	рл_ИнфПол.Очистить();
	JSON_Шаблон = ПолучитьСодержимоеНастроекТорговыхСетей();
	networks_settings =  JSON_Шаблон["networks_settings"];
	Для Каждого networks_setting Из networks_settings Цикл
		net_code = networks_setting["net_code"];
		Если net_code = КодТорговойСети Тогда
			infoFields = networks_setting["requirements"]["infoFields"];
			ФорматЗаписи = infoFields["format_xml"];
			Для Каждого КлючЗначение Из infoFields Цикл
				Если КлючЗначение.Ключ = "format_xml" Тогда

				Иначе     
					infoField = КлючЗначение.Значение;
					required = infoField["required"];
					requiredCondition = infoField["requiredCondition"]; 
					ФорматЗаписиПоля = infoField["writeMode"];
					Разделитель = infoField["separator"];
					
					НовСтрока = рл_ИнфПол.Добавить();
					НовСтрока.ТекстИнф_Идентиф = infoField["identifier"];
					Если СтрНайтиЛок(НовСтрока.ТекстИнф_Идентиф, "_DATE") > 0 Тогда
						НовСтрока.ТекстИнф_Значение = '00010101000000';
					Иначе
						НовСтрока.ТекстИнф_Значение = "";
					КонецЕсли;
					НовСтрока.Представление = ПредставлениеПоляТорговойСети(infoField["identifier"]);
					Если required = "required" Тогда
						НовСтрока.Обязательное = Истина;
						НовСтрока.Представление = НовСтрока.Представление + " (обяз.)";
					КонецЕсли;                      
					НовСтрока.Предопределенное = Истина;
					
					Требования = "";
					Если ТипЗнч(requiredCondition) = Тип("Массив") Тогда
						Для Каждого Требование Из requiredCondition Цикл
							Требования = Требования + Требование["text_condition"];	
						КонецЦикла;
					КонецЕсли;
					НовСтрока.Требования = Требования;
					НовСтрока.ФорматЗаписиПоля = ФорматЗаписиПоля;
					НовСтрока.Разделитель = Разделитель;
					НовСтрока.ФорматЗаписи = ФорматЗаписи;
					НовСтрока.КодТорговойСети = КодТорговойСети;
										
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьТорговуюСеть(ИНН, КПП) Экспорт
	
	ИННКППТорговыхСетей = ИННКППТорговыхСетей();
	
	Результат = "";
	СтрокаПоиска = "inn=" + """" + СокрЛП(ИНН) + """" + " kpp=" + """" + СокрЛП(КПП) + """";
	поз = СтрНайтиЛок(ИННКППТорговыхСетей, СтрокаПоиска);
	Если поз > 0 Тогда
		поз = поз - 3;
		символ = Сред(ИННКППТорговыхСетей, поз, 1);
		Пока символ <> """" Цикл
			Результат = символ + Результат;
			поз = поз - 1;
			символ = Сред(ИННКППТорговыхСетей, поз, 1);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИННКППУчастника(Участник) Экспорт
	
	Результат = Новый Структура("ИНН, КПП");
	// Если это ИП
	Если ЗаполненКлючСтруктуры(Участник, "ИдСв.СвИП.ИННФЛ") Тогда
        Результат.ИНН = ЗначениеСтруктурыПоКлючу(Участник, "ИдСв.СвИП.ИННФЛ");
	// Юридицеское лицо	
	ИначеЕсли ЗаполненКлючСтруктуры(Участник, "ИдСв.СвЮЛУч.ИННЮЛ") Тогда
        Результат.ИНН = ЗначениеСтруктурыПоКлючу(Участник, "ИдСв.СвЮЛУч.ИННЮЛ");
        Результат.КПП = ЗначениеСтруктурыПоКлючу(Участник, "ИдСв.СвЮЛУч.КПП");		
	// Физлицо
	ИначеЕсли ЗаполненКлючСтруктуры(Участник, "ИдСв.СвФЛУчаст.ИННФЛ") Тогда
        Результат.ИНН = ЗначениеСтруктурыПоКлючу(Участник, "ИдСв.СвФЛУчаст.ИННФЛ");
	Иначе
		
	КонецЕсли; 
	
	Возврат Результат;

КонецФункции


