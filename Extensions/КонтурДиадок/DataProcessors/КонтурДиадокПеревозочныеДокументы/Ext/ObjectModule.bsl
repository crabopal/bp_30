//{ СЛУЖЕБНЫЕ XDTO_XML

Функция ОбъектXDTO_В_СтрокуXML(ОбъектXDTO, ТипКодировки = "windows-1251")
		
	ИмяПакетаXDTO = ОбъектXDTO.Тип().URIПространстваИмен;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(ТипКодировки);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	Фабрика = ФабрикаXDTOНакладной;
	Фабрика.ЗаписатьXML(ЗаписьXML, ОбъектXDTO, "Файл",,, НазначениеТипаXML.Неявное);
	
	Результат = ЗаписьXML.Закрыть();
	
	XML_УдалитьОбъявлениеПрефиксовПространстваИмен(ИмяПакетаXDTO, Результат);
	
	Возврат Результат;

КонецФункции

// Преобразует XML в двоичных данных в DOM-документ.
//
// Параметры:
//  ДвоичныеДанныеXML - ДвоичныеДанные - содержимое XML-файла.
//
// Возвращаемое значение:
//  ДокументDOM, Неопределено - DOM-документ XML или Неопределено, если входные данные не заполнены.
//
Функция ДвоичныеДанные_В_XMLДокумент(ДвоичныеДанныеXML) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДвоичныеДанныеXML) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	Результат = Неопределено;
	
	Попытка
		ДвоичныеДанныеXML.Записать(ИмяВременногоФайла);
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);		
		Результат = XML_В_Структуру(ЧтениеXML);		
		ЧтениеXML.Закрыть();       
	Исключение

	КонецПопытки;
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Преобразует поток ЧтениеXML в структуру 1С.
//
// Параметры:
//  ЧтениеXML - ЧтениеXML - поток чтения XML.
//
// Возвращаемое значение:
//  Структура - корневой узел XML и его содержимое.
//
Функция XML_В_Структуру(ЧтениеXML)
	
	Результат = Новый Структура;
	
	Если ЧтениеXML = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Цикл
			Если НЕ ЧтениеXML.Прочитать() Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
		
		Результат = XML_ПрочитатьУзелВЗначение(ЧтениеXML);
	Исключение

	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция XML_ПрочитатьУзелВЗначение(ЧтениеXML)
	
	Результат = Новый Структура;
	ТекстУзла = "";
	ЕстьДочерниеЭлементы = Ложь;
	
	XML_ПрочитатьАтрибутыУзла(Результат, ЧтениеXML);

	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ЕстьДочерниеЭлементы = Истина;
			ИмяУзла = XML_НормализоватьИмяУзла(ЧтениеXML.Имя);
			ЗначениеУзла = XML_ПрочитатьУзелВЗначение(ЧтениеXML);
			XML_ДобавитьЗначениеУзла(Результат, ИмяУзла, ЗначениеУзла);
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			
			ТекстУзла = ТекстУзла + ЧтениеXML.Значение;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЕстьДочерниеЭлементы И Результат.Количество() = 0 Тогда
		Возврат XML_СтрокаУзлаВЗначение(ТекстУзла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура XML_ПрочитатьАтрибутыУзла(Результат, ЧтениеXML)
		
	Если ЧтениеXML = Неопределено Тогда

	КонецЕсли;
		
	Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
		Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
			ИмяАтрибута = XML_НормализоватьИмяУзла(ЧтениеXML.Имя);
			Результат.Вставить(ИмяАтрибута, XML_СтрокаУзлаВЗначение(ЧтениеXML.Значение));
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

Процедура XML_ДобавитьЗначениеУзла(Узел, ИмяУзла, ЗначениеУзла)
	
	Если НЕ Узел.Свойство(ИмяУзла) Тогда
		Узел.Вставить(ИмяУзла, ЗначениеУзла);
		Возврат;
	КонецЕсли;
	
	ТекущееЗначение = Узел[ИмяУзла];
	
	Если ТипЗнч(ТекущееЗначение) = Тип("Массив") Тогда
		ТекущееЗначение.Добавить(ЗначениеУзла);
	Иначе
		МассивЗначений = Новый Массив;
		МассивЗначений.Добавить(ТекущееЗначение);
		МассивЗначений.Добавить(ЗначениеУзла);
		Узел.Вставить(ИмяУзла, МассивЗначений);
	КонецЕсли;
	
КонецПроцедуры

Функция XML_НормализоватьИмяУзла(ИмяУзла)
	
	Результат = СтрЗаменить(ИмяУзла, ".", "_");
	Результат = СтрЗаменить(Результат, ":", "_");
	
	Возврат Результат;
	
КонецФункции

Функция XML_СтрокаУзлаВЗначение(СтрокаЗначения)
	
	СтрокаСокр = СокрЛП(СтрокаЗначения);
	Если ПустаяСтрока(СтрокаСокр) Тогда
		Возврат "";
	КонецЕсли;
	
	ДатаИзСтроки = XML_ПопробоватьРазобратьДатуИзСтроки(СтрокаСокр);
	Если ДатаИзСтроки <> Неопределено Тогда
		Возврат ДатаИзСтроки;
	КонецЕсли;
	
	Возврат СтрокаСокр;
	
КонецФункции

Функция XML_ПопробоватьРазобратьДатуИзСтроки(СтрокаСокр)
	
	Длина = СтрДлина(СтрокаСокр);
	Если Длина < 8 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// ISO 8601: yyyy-MM-dd или yyyy-MM-ddTHH:mm:ss…
	Если Длина >= 10 И Сред(СтрокаСокр, 5, 1) = "-" И Сред(СтрокаСокр, 8, 1) = "-" Тогда
		ЧастьДаты = Лев(СтрокаСокр, 10);
		Попытка
			Год = Число(Лев(ЧастьДаты, 4));
			Месяц = Число(Сред(ЧастьДаты, 6, 2));
			День = Число(Прав(ЧастьДаты, 2));
			Если Год > 0 И Месяц >= 1 И Месяц <= 12 И День >= 1 И День <= 31 Тогда
				Возврат Дата(Год, Месяц, День);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	// Российский формат: dd.MM.yyyy
	Если Длина = 10 И Сред(СтрокаСокр, 3, 1) = "." И Сред(СтрокаСокр, 6, 1) = "." Тогда
		Попытка
			День = Число(Лев(СтрокаСокр, 2));
			Месяц = Число(Сред(СтрокаСокр, 4, 2));
			Год = Число(Прав(СтрокаСокр, 4));
			Если Год > 0 И Месяц >= 1 И Месяц <= 12 И День >= 1 И День <= 31 Тогда
				Возврат Дата(Год, Месяц, День);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура XML_УдалитьОбъявлениеПрефиксовПространстваИмен(ИмяПакетаXDTO, СтрокаXML)
	
	СтрокаXML = СтрЗаменить(СтрокаXML, "xmlns=""" + ИмяПакетаXDTO + """ xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" ", "");
	СтрокаXML = СтрЗаменить(СтрокаXML, "xmlns=""" + ИмяПакетаXDTO + """ xmlns:xsd=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" ", "");
	
КонецПроцедуры

Функция XDTO_НовыйОбъект(мФабрика, Тип_Основной, СоздатьВложенныеОбъекты = Ложь)
	
	Результат = мФабрика.Создать(Тип_Основной);
	
	Если СоздатьВложенныеОбъекты Тогда
		
		Для Каждого Эл Из Тип_Основной.Свойства Цикл
			
	        флСвойствоНеСписковое =	(Эл.ВерхняяГраница = 1);
			
			Если Эл.Тип.URIПространстваИмен = Тип_Основной.URIПространстваИмен 
				И флСвойствоНеСписковое	Тогда
				
				Если ТипЗнч(Эл.Тип) = Тип("ТипОбъектаXDTO") Тогда //вложенные свойства создаем только для объектов
					Результат[Эл.Имя] = XDTO_НовыйОбъект(мФабрика, Эл.Тип, СоздатьВложенныеОбъекты);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ФабрикаXDTO_Инициализировать(ФорматДок) Экспорт
	
	Отладка = Ложь;
	
	МассивСхемXML = Новый Массив;
	
	Если ФорматДок = "__etrnTitle1" Тогда
		
		МассивПакетов = Новый Массив;
		МассивПакетов.Добавить("__etrnTitle1");
		МассивПакетов.Добавить("__etrnTitle2_Transporter");
		
	ИначеЕсли ФорматДок = "__etrnTitle3_Receiver" Тогда
		
		МассивПакетов = Новый Массив;
		МассивПакетов.Добавить("__etrnTitle3_Receiver");
		
	ИначеЕсли ФорматДок = "__zzTitle1" Тогда
		
		МассивПакетов = Новый Массив;
		МассивПакетов.Добавить("__zzTitle1");
		МассивПакетов.Добавить("__zzTitle2");
		
	ИначеЕсли ФорматДок = "__kl_porek_wt3_05_02_01" Тогда
		
		МассивПакетов = Новый Массив;
		МассивПакетов.Добавить("__kl_porek_wt3_05_02_01");
		
	КонецЕсли;
	
	НаборСхемXML = Новый НаборСхемXML;
	
	Для Каждого ИмяМакета Из МассивПакетов Цикл 
		
		ТекстМакета	 = ПолучитьМакет(ИмяМакета).ПолучитьТекст();
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ТекстМакета);
		
		
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		
		ПостроительСхемXML = Новый ПостроительСхемXML;
		СхемаXML = ПостроительСхемXML.СоздатьСхемуXML(ДокументDOM);
		
		НаборСхемXML.Добавить(СхемаXML);
		
	КонецЦикла;
	
	ФабрикаXDTOНакладной = Новый ФабрикаXDTO(НаборСхемXML);
	
КонецПроцедуры

Функция XDTO_НовыйЭлементСписка(СписокXDTO) Экспорт
	
	ТипXDTO = СписокXDTO.ВладеющееСвойство.Тип;
	Элемент = XDTO_НовыйОбъект(ФабрикаXDTOНакладной, ТипXDTO, Истина);
	
	Возврат СписокXDTO.Добавить(Элемент);
	
КонецФункции

Процедура XDTO_ДобавитьСтрокуВСписок(СписокXDTO, Значение)

	ЗначениеАтрибута = ФабрикаXDTOНакладной.Создать(ФабрикаXDTOНакладной.Тип("http://www.w3.org/2001/XMLSchema", "string"), Значение);
	СписокXDTO.Добавить(ЗначениеАтрибута);

КонецПроцедуры

Функция XDTO_УдалитьПустыеСвойства(ОбъектXDTO)
	
	ЕстьЗаполненныеСвойства = Ложь;
	
	Если ТипЗнч(ОбъектXDTO) = Тип("ОбъектXDTO") Тогда
		
		Для Каждого Свойство Из ОбъектXDTO.Свойства() Цикл
			
			ТекущееСвойствоЗаполнено = XDTO_УдалитьПустыеСвойства(ОбъектXDTO[Свойство.Имя]);
			
			Если НЕ ТекущееСвойствоЗаполнено Тогда
				ОбъектXDTO.Сбросить(Свойство.Имя);
			КонецЕсли;
			
			ЕстьЗаполненныеСвойства = ЕстьЗаполненныеСвойства или ТекущееСвойствоЗаполнено;
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ОбъектXDTO) = Тип("СписокXDTO") Тогда
		
		Для Каждого ЭлементКоллекции Из ОбъектXDTO Цикл
			XDTO_УдалитьПустыеСвойства(ЭлементКоллекции);
		КонецЦикла;	
		
		ЕстьЗаполненныеСвойства = (ОбъектXDTO.Количество() > 0);  // если нет строк, то удалим этот тег
		
	Иначе  // уткнулись в конец ветки, в примитивный / ссылочный тип
		
		ЕстьЗаполненныеСвойства = (ЗначениеЗаполнено(ОбъектXDTO) и ОбъектXDTO <> 0);  // значение "0" не будем считать пустым
		
	КонецЕсли;
	
	Возврат ЕстьЗаполненныеСвойства;
	
КонецФункции

Функция XDTO_Вычислить(ОбъектXDTO, Путь) Экспорт 
	
	ТекущийЭлемент = ОбъектXDTO;
	
	ТипСписок = Тип("СписокXDTO");
	
	МассивСлов = РазложитьСтрокуВМассивСлов(Путь,".");
	
	Для Каждого ТекущийПуть Из МассивСлов Цикл
		
		Если ТекущийЭлемент = Неопределено Или ТипЗнч(ТекущийЭлемент) = ТипСписок Тогда
			ТекущийЭлемент = Неопределено;
			Прервать;
		КонецЕсли;
		
		ТекущийЭлемент = XDTO_ПолучитьЗначениеСвойства(ТекущийЭлемент, ТекущийПуть);
		
	КонецЦикла;
	
	Возврат ТекущийЭлемент;

КонецФункции

Функция XDTO_ПолучитьЗначениеСвойства(ОбъектXDTO, ИмяСвойства) Экспорт
	
	ТекЗначение = Неопределено;
	
	Если ОбъектXDTO <> Неопределено 
		И НЕ ОбъектXDTO.Свойства().Получить(ИмяСвойства) = Неопределено Тогда
		
		ТекЗначение = ОбъектXDTO[ИмяСвойства];
		
	КонецЕсли;
	
	Возврат ТекЗначение;
	
КонецФункции

Функция XDTO_СписокИзЭлемента(ОбъектXDTO, ИмяСвойства)
	
	Если XDTO_ЕстьСвойство(ОбъектXDTO, ИмяСвойства) Тогда
		
		Элемент = ОбъектXDTO[ИмяСвойства];
		
		Если ТипЗнч(Элемент) = Тип("СписокXDTO") Тогда
			Результат = Элемент;
		Иначе
			Результат = Новый Массив;
			Результат.Добавить(Элемент);
		КонецЕсли;
		
	Иначе
		Результат = Новый Массив;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция XDTO_ЕстьСвойство(ОбъектXDTO, ИмяСвойства)

	Результат = Ложь;
	
	Если ОбъектXDTO <> Неопределено 
		И НЕ ОбъектXDTO.Свойства().Получить(ИмяСвойства) = Неопределено Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция XDTO_СтрокаПоСсылке(Значение)
	
	Результат = Неопределено;
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Если Значение.Свойство("Ссылка") И ЗначениеЗаполнено(Значение.Ссылка) Тогда
			Результат = Строка(Значение.Ссылка);
		КонецЕсли;
	Иначе
		Результат = Строка(Значение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция XDTO_ОграничениеСтроки(Значение, МинДлина, МаксДлина, СимволЗаполнения)
	
	Результат = Строка(Значение);
	
	СтрокаЗаполнения = "";
	Для Индекс = 1 по МинДлина Цикл
		СтрокаЗаполнения = СтрокаЗаполнения + СимволЗаполнения;
	КонецЦикла;
	
	//добавим к строке символы недостающие
	Если ЗначениеЗаполнено(Результат) Тогда
		Если СтрДлина(Результат) < МинДлина И МинДлина > 0 Тогда
			Результат = Лев(Строка(Результат) + СтрокаЗаполнения, МинДлина); 
		КонецЕсли;
		Если СтрДлина(Результат) > МаксДлина И МаксДлина > 0 Тогда
			Результат = Лев(Строка(Результат), МаксДлина); 
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

