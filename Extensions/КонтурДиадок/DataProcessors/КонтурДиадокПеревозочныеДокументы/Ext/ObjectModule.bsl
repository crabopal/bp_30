Процедура ЗаполнитьXDTO_Подписант_ТрН(XDTO, ТрНСтруктура)
	
	// пока ориентируемся на отправителя, вопрос кто подписант при шаблонах?
	Сценарий = ЗначениеСтруктурыПоКлючу(ТрНСтруктура, "Сценарий");
	Если СценарийШаблон(Сценарий) Тогда
		
	Иначе
		
		ОтправительТрН = ОтправительТрН(ТрНСтруктура, Истина);
		ИдентификаторыГО = ИдентификаторыЭДО(ОтправительТрН, Истина);
		BoxId = ИдентификаторыГО.BoxId;
		
		ТипКонтента = "kl";
		ВидТитула = _Ядро.Документы_ВидТитула(ТипКонтента);
		
		ОписаниеПолномочийПодписанта = _Ядро.ПолномочияПодписанта_Получить(BoxId, ВидТитула, "Продавец");
		Результат		= ОписаниеПолномочийПодписанта.Данные;
		
		Если Не Результат = Неопределено Тогда
			XDTO.Должн		= Результат.JobTitle;
			ФИО				= XDTO.ФИО;
			ФИО.Фамилия		= Результат.Surname;
			ФИО.Имя			= Результат.FirstName;
			Отчество = СвойствоСтруктуры(Результат, "Patronymic");
			Если Не Отчество = Неопределено Тогда
				ФИО.Отчество	= Отчество;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_Подписант_ЗЗ(XDTO, ЗЗСтруктура)
	
	ИдентификаторыГО = ИдентификаторыЭДО(ЗЗСтруктура.СвГО.Ссылка, Истина);
	BoxId = ИдентификаторыГО.BoxId;
	
