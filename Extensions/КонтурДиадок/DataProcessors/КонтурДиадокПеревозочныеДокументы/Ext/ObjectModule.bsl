//****************************************************************************
//{ СОХРАНЕНИЕ И ВОССТАНОВЛЕНИЕ ДАННЫХ

Функция СоздатьТрНДляКаждогоДокумента(СписокДокументов, ТекущийСценарий = Неопределено) Экспорт
	
	Результат = Новый Соответствие;

	Для Каждого Документ Из СписокДокументов Цикл
		
		ДокументыОснования = Новый Массив;
		ДокументыОснования.Добавить(Документ);
		
		ИдентификаторТрН = ИдентификаторТрН(Документ);
		ДанныеТрН = ДанныеТрН(ИдентификаторТрН, ДокументыОснования, Документ);
		ОбработатьДанныеТрНПоСценарию(ДанныеТрН, ТекущийСценарий);
		НезаполненныеРеквизиты = ОшибкиПроверкиТрН(ИдентификаторТрН, ДокументыОснования, Документ);
		ЕстьОшибки = ЕстьОшибкиПроверки(НезаполненныеРеквизиты);
		БлокирующиеОшибкиСоздания = БлокирующиеОшибкиСоздания(НезаполненныеРеквизиты);
		
		Если БлокирующиеОшибкиСоздания.Количество() > 0 Тогда
			Результат.Вставить(Документ, БлокирующиеОшибкиСоздания);	
		Иначе
			ЗначенияРеквизитовТрН = ЗначенияДополнительныхСвойствПоДанным(ДанныеТрН);
			ПараметрыТрН = ПараметрыТрН(Документ, ДокументыОснования, ЗначенияРеквизитовТрН);
			СохранитьЗначенияЭПД(КлючИдентификатораТрН(), ИдентификаторТрН, КлючРеквизитовТрН(), ЗначенияРеквизитовТрН, ПараметрыТрН);
			Статус = ОпределитьСтатусТрН(ЕстьОшибки);      
			
			//{ ааа5
			СохранитьСтатусЭПД(ИдентификаторТрН, Документ, ПрефиксЭТРН(), Статус);
			//} ааа5
		КонецЕсли;
		
		ДопПеременные = Новый Соответствие;
		ДействиеМетрики = Метрика_НазваниеДействий().СозданиеЭТРН;
		ДопПеременные.Вставить(Метрика_КлючОшибки(), Метрики_ПредставлениеОшибокВМассиве(НезаполненныеРеквизиты));
		Метрика_ЗаполнитьВыбранныеДокументыПоТипам(ДопПеременные, ДокументыОснования);
		ДопПеременные.Вставить(Метрика_КлючИдентификатораПеревозочногоДокумента(), Строка(ИдентификаторТрН));
		НаименованиеФормы = Метрика_НаименованиеФормыЭТРН();
		Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, ДопПеременные, , НаименованиеФормы);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьЗЗДляКаждогоДокумента(СписокДокументов) Экспорт
	
	Результат = Новый Соответствие;

	Для Каждого Документ Из СписокДокументов Цикл
		
		ДокументыОснования = Новый Массив;
		ДокументыОснования.Добавить(Документ);
		
		ИдентификаторЗЗ = ИдентификаторЗЗ(Документ);
		ДанныеЗЗ = ДанныеЗЗ(ИдентификаторЗЗ, ДокументыОснования, Документ);
		НезаполненныеРеквизиты = ОшибкиПроверкиЗЗ(ИдентификаторЗЗ, ДокументыОснования, Документ);
		ЕстьОшибки = ЕстьОшибкиПроверки(НезаполненныеРеквизиты);
		БлокирующиеОшибкиСоздания = БлокирующиеОшибкиСоздания(НезаполненныеРеквизиты);
		
		Если БлокирующиеОшибкиСоздания.Количество() > 0 Тогда
			Результат.Вставить(Документ, БлокирующиеОшибкиСоздания);	
		Иначе
			ЗначенияРеквизитовЗЗ = ЗначенияДополнительныхСвойствПоДанным(ДанныеЗЗ);
			ПараметрыЗЗ = ПараметрыЗЗ(Документ, ДокументыОснования, ЗначенияРеквизитовЗЗ);
			СохранитьЗначенияЭПД(КлючИдентификатораЗЗ(), ИдентификаторЗЗ, КлючРеквизитовЗЗ(), ЗначенияРеквизитовЗЗ, ПараметрыЗЗ);
			Статус = ОпределитьСтатусЗЗ(ЕстьОшибки);
			
			//{ ааа5
			СохранитьСтатусЭПД(ИдентификаторЗЗ, Документ, ПрефиксЭЗЗ(), Статус);
			//} ааа5
		КонецЕсли;
		
		ДопПеременные = Новый Соответствие;
		ДействиеМетрики = Метрика_НазваниеДействий().СозданиеЗЗ;
		ДопПеременные.Вставить(Метрика_КлючОшибки(), Метрики_ПредставлениеОшибокВМассиве(НезаполненныеРеквизиты));
		Метрика_ЗаполнитьВыбранныеДокументыПоТипам(ДопПеременные, ДокументыОснования);
		ДопПеременные.Вставить(Метрика_КлючИдентификатораПеревозочногоДокумента(), Строка(ИдентификаторЗЗ));
		НаименованиеФормы = Метрика_НаименованиеФормыЭТРН();
		Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, ДопПеременные, , НаименованиеФормы);
		
	КонецЦикла;

	Возврат Результат;
		
КонецФункции

Функция СоздатьПЭДляКаждогоДокумента(СписокДокументов) Экспорт
	
	Результат = Новый Соответствие;

	Для Каждого Документ Из СписокДокументов Цикл
		
		ДокументыОснования = Новый Массив;
		ДокументыОснования.Добавить(Документ);
		
		ИдентификаторПЭ = ИдентификаторПЭ(Документ);
		ДанныеПЭ = ДанныеПЭ(ИдентификаторПЭ, ДокументыОснования, Документ);
		НезаполненныеРеквизиты = ОшибкиПроверкиПЭ(ИдентификаторПЭ, ДокументыОснования, Документ);
		ЕстьОшибки = ЕстьОшибкиПроверки(НезаполненныеРеквизиты);
		БлокирующиеОшибкиСоздания = БлокирующиеОшибкиСоздания(НезаполненныеРеквизиты);
		
		Если БлокирующиеОшибкиСоздания.Количество() > 0 Тогда
			Результат.Вставить(Документ, БлокирующиеОшибкиСоздания);	
		Иначе
			ЗначенияРеквизитовПЭ = ЗначенияДополнительныхСвойствПоДанным(ДанныеПЭ);
			ПараметрыПЭ = ПараметрыПЭ(Документ, ДокументыОснования, ЗначенияРеквизитовПЭ);
			СохранитьЗначенияЭПД(КлючИдентификатораПЭ(), ИдентификаторПЭ, КлючРеквизитовПЭ(), ЗначенияРеквизитовПЭ, ПараметрыПЭ);
			Статус = ОпределитьСтатусПЭ(ЕстьОшибки);
			//{ ааа5
			СохранитьСтатусЭПД(ИдентификаторПЭ, Документ, ПрефиксЭПЭ(), Статус);
			//} ааа5
		КонецЕсли;
		
		ДопПеременные = Новый Соответствие;
		ДействиеМетрики = Метрика_НазваниеДействий().СозданиеЭПЭ;
		ДопПеременные.Вставить(Метрика_КлючОшибки(), Метрики_ПредставлениеОшибокВМассиве(НезаполненныеРеквизиты));
		Метрика_ЗаполнитьВыбранныеДокументыПоТипам(ДопПеременные, ДокументыОснования);
		ДопПеременные.Вставить(Метрика_КлючИдентификатораПеревозочногоДокумента(), Строка(ИдентификаторПЭ));
		НаименованиеФормы = Метрика_НаименованиеФормыЭТРН();
		Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, ДопПеременные, , НаименованиеФормы);
		
	КонецЦикла;

	Возврат Результат;
		
КонецФункции

Функция БлокирующиеОшибкиСоздания(НезаполненныеРеквизиты)

	// пока интересуют ошибки, при которых исчезают документы из списка - это ошибки подписки.
	Результат = Новый Массив;
	Для Каждого ДанныеПроверки Из НезаполненныеРеквизиты Цикл
		Если ДанныеПроверки.Действие = "ПоказатьОшибкуПодписки" Тогда
			Результат.Добавить(ДанныеПроверки);
		ИначеЕсли ДанныеПроверки.Действие = "ПредложитьСопоставить"
			И ДанныеПроверки.ЭтоОтправитель Тогда
			Результат.Добавить(ДанныеПроверки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

