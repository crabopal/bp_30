Процедура ОбработатьДанныеТрНПоСценарию(ДанныеТрН, ТекущийСценарий) Экспорт
	
	УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "Сценарий", ТекущийСценарий);
	
	Если ТекущийСценарий = СценарийПростаяОтгрузка() Тогда 
		
		Если ЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГО.РекИдентГО") = ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Контрагент") Тогда
			УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГО.РекИдентГО", ДанныеТрН.Организация);
		КонецЕсли;
		
		// ЛОП
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.СовпГОП", 1);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.ОснПогрГр", Неопределено);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.РекЛицПогрГр", Неопределено);
		
		// Собственник п/п
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.ВладИнфр.СовпГОВ", 1);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.ВладИнфр.РекВладИнф", Неопределено);
		
		// Экспедитор
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГО.ГОЭксп", 0);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвЗак.РекИдентЗак", Неопределено);
		
	ИначеЕсли ТекущийСценарий = СценарийСамовывозПокупателем() Тогда
		
		// ЛОП
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.СовпГОП", 2);
		
		// Собственник п/п
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.ВладИнфр.СовпГОВ", 2);

		// Экспедитор
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГО.ГОЭксп", 0);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвЗак.РекИдентЗак", Неопределено);
		
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГО.РекИдентГО", ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Контрагент"));
		Если ЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.ВладИнфр.РекВладИнф") = Неопределено Тогда
			УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.ВладИнфр.РекВладИнф", ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Организация"));
		КонецЕсли;
		Если ЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.РекЛицПогрГр") = Неопределено Тогда
			УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.РекЛицПогрГр", ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Организация"));
		КонецЕсли;

	ИначеЕсли ТекущийСценарий = СценарийОтгрузкаСоСкладаХранения() Тогда

		// ЛОП
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.СовпГОП", 2);
		
		// Собственник п/п
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.ВладИнфр.СовпГОВ", 2);
		
		// Экспедитор
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГО.ГОЭксп", 0);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвЗак.РекИдентЗак", Неопределено);
		
	ИначеЕсли ТекущийСценарий = СценарийСамовывозОтПоставщика() Тогда

		// ЛОП
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.СовпГОП", 2);
		
		// Собственник п/п
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.ВладИнфр.СовпГОВ", 2);

		// Экспедитор
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГО.ГОЭксп", 0);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвЗак.РекИдентЗак", Неопределено);
		
		Грузоотправитель = ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Грузоотправитель");
		Грузополучатель = ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Грузополучатель");
		Контрагент = ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Контрагент");
		Организация = ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Организация");
		Грузоотправитель = ?(ЗначениеЗаполнено(Грузоотправитель), Грузоотправитель, Контрагент);
		Грузополучатель = ?(ЗначениеЗаполнено(Грузополучатель), Грузополучатель, Организация);
		
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГО.РекИдентГО", Грузополучатель);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГП.РекИдентГП", Грузополучатель);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.РекЛицПогрГр", Грузоотправитель);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.ВладИнфр.РекВладИнф", Грузоотправитель);
		// необходимо учесть связи договоров и адресов при такой установке полей!
		
	ИначеЕсли ТекущийСценарий = СценарийОтгрузкаЭкспедитором() Тогда

		// ЛОП
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.СовпГОП", 1);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.ОснПогрГр", Неопределено);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.СвЛицПогрГр.РекЛицПогрГр", Неопределено);
		
		// Собственник п/п
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.ВладИнфр.СовпГОВ", 1);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвПогруз.ВладИнфр.РекВладИнф", Неопределено);

		// Экспедитор
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГО.ГОЭксп", 1);
		
		Грузоотправитель = ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Грузоотправитель");
		Грузополучатель = ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Грузополучатель");
		Контрагент = ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Контрагент");
		Организация = ЗначениеСтруктурыПоКлючу(ДанныеТрН, "Организация");
		Грузополучатель = ?(ЗначениеЗаполнено(Грузополучатель), Грузополучатель, Контрагент);
		
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГО.РекИдентГО", Грузоотправитель);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвГП.РекИдентГП", Грузополучатель);
		УстановитьЗначениеСтруктурыПоКлючу(ДанныеТрН, "СвЗак.РекИдентЗак", Организация);

	КонецЕсли;
	
КонецПроцедуры

