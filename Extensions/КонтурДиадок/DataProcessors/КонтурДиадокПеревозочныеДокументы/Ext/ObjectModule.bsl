Функция ТекстЗапросаВодителя(СсылкаНаОбъект)

	Мтд = СсылкаНаОбъект.Метаданные();
	
	ИмяКонфигурации = ИмяКонфигурации();
	
	Если ИмяКонфигурации = "УТ_11" Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИННФЛ,
		|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ФИО_Наименование
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";

	ИначеЕсли Метаданные.РегистрыСведений.Найти("ФИОФизЛиц") <> Неопределено Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИННФЛ,
		|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ФИО_Наименование,
		|	ФИОФизЛицСрезПоследних.Фамилия КАК ФИО_Фамилия,
		|	ФИОФизЛицСрезПоследних.Имя КАК ФИО_Имя,
		|	ФИОФизЛицСрезПоследних.Отчество КАК ФИО_Отчество
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних КАК ФИОФизЛицСрезПоследних
		|	ПО ФИОФизЛицСрезПоследних.ФизЛицо = " + ПолеЗапроса(Мтд, "Ссылка") + "
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";

	ИначеЕсли Метаданные.Справочники.Найти("ПодтверждающиеДокументы") <> Неопределено
		И ИмяКонфигурации = "ААА"
		//{ ааа5
		И Метаданные.Перечисления.Найти("ВидыДокументов") <> Неопределено
		И Метаданные.Перечисления["ВидыДокументов"].ЗначенияПеречисления.Найти("ВодительскоеУдостоверение") <> Неопределено Тогда
		//} ааа5
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИННФЛ,
		|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ФИО_Наименование,
		|	ПодтверждающиеДокументы.Серия КАК СерВУ,
		|	ПодтверждающиеДокументы.Номер КАК НомВУ,
		|	ПодтверждающиеДокументы.ДатаВыдачи КАК ДатаВыдВУ
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
		|	ПО ПодтверждающиеДокументы.Владелец = " + ПолеЗапроса(Мтд, "Ссылка") + "
		|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.ВодительскоеУдостоверение)
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
		
	Иначе
	
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИННФЛ,
		|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ФИО_Наименование,
		|" + ПолеЗапроса(Мтд, "Фамилия") + " КАК ФИО_Фамилия,
		|" + ПолеЗапроса(Мтд, "Имя") + " КАК ФИО_Имя,
		|" + ПолеЗапроса(Мтд, "Отчество") + " КАК ФИО_Отчество
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции

