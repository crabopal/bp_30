//****************************************************************************
//{ СЦЕНАРИИ

Функция ИдентификаторСценария(Сценарий) Экспорт
	
	//для обратной совместимости
	Результат = СценарийПростаяОтгрузка();
	
	Если Сценарий.КтоЗаказываетПеревозку = "Мы" Тогда
		Результат = СценарийПростаяОтгрузка();
		
	ИначеЕсли Сценарий.КтоЗаказываетПеревозку = "Покупатель" Тогда
		Результат = СценарийСамовывозПокупателем();
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция СценарийПростаяОтгрузка() Экспорт
	
	Возврат "ПростаяОтгрузка";
	
КонецФункции

Функция СценарийСамовывозПокупателем() Экспорт
	
	Возврат "СамовывозПокупателем";
	
КонецФункции

Функция СценарийОтгрузкаСоСкладаХранения() Экспорт

	Возврат "ОтгрузкаСоСкладаХранения";
	
КонецФункции

Функция СценарийСамовывозОтПоставщика() Экспорт

	Возврат "СамовывозОтПоставщика";
	
КонецФункции

Функция СценарийОтгрузкаЭкспедитором() Экспорт

	Возврат "ОтгрузкаЭкспедитором";
	
КонецФункции

Функция СценарийУниверсальный() Экспорт
	
	Возврат "Универсальный";
	
КонецФункции

Функция ПредставлениеСценария(Сценарий) Экспорт
	
	Результат = Новый Структура;
	Если Сценарий = СценарийПростаяОтгрузка() Тогда
		Результат.Вставить("ПредставлениеСценария", "Простая отгрузка");
		Результат.Вставить("ПодсказкаСценария", "отгрузка со своего склада, мы подписываем документы");
		Результат.Вставить("НомерКартинки", 0);
		
	ИначеЕсли Сценарий = СценарийОтгрузкаСоСкладаХранения() Тогда
		Результат.Вставить("ПредставлениеСценария", "Отгрузка со склада-хранения");
		Результат.Вставить("ПодсказкаСценария", "мы заказываем перевозку (отгрузка осуществляется со склада партнера), готовим шаблон ЭТрН и передаем ЛОП на подпись");
		Результат.Вставить("НомерКартинки", 1);
		
	ИначеЕсли Сценарий = СценарийСамовывозПокупателем() Тогда
		Результат.Вставить("ПредставлениеСценария", "Самовывоз покупателем");
		Результат.Вставить("ПодсказкаСценария", "мы отгружаем товар со своего склада, перевозку заказывает покупатель");
		Результат.Вставить("НомерКартинки", 2);

	ИначеЕсли Сценарий = СценарийСамовывозОтПоставщика() Тогда
		Результат.Вставить("ПредставлениеСценария", "Самовывоз от поставщика");
		Результат.Вставить("ПодсказкаСценария", "мы забираем товар у поставщика наемным транспортом, готовим шаблон ЭТрН и передаем ЛОП на подпись");
		Результат.Вставить("НомерКартинки", 3);

	ИначеЕсли Сценарий = СценарийОтгрузкаЭкспедитором() Тогда
		Результат.Вставить("ПредставлениеСценария", "Отгрузка с помощью экспедитора");
		Результат.Вставить("ПодсказкаСценария", "мы заказываем экспедицию, готовим шаблон ЭТрН и передаем экспедитору на подпись");
		Результат.Вставить("НомерКартинки", 4);
	
	Иначе
		Результат.Вставить("ПредставлениеСценария", "Произвольная форма ЭТрН");
		Результат.Вставить("ПодсказкаСценария", "формирование ЭТрН определяется самостоятельно выбором данных на форме");
 		Результат.Вставить("НомерКартинки", 4);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция СценарийШаблон(Сценарий) Экспорт

	Если Сценарий = СценарийОтгрузкаСоСкладаХранения()
		Или Сценарий = СценарийСамовывозОтПоставщика()
		Или Сценарий = СценарийОтгрузкаЭкспедитором() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

//} СЦЕНАРИИ



//****************************************************************************
//{ ФОРМИРОВАНИЕ ЭТрН-3

Функция ЭТрН_Титул_3_ГрузыИзТитулаОснования(ДокументЭТрН_Титул1) Экспорт
	
	Результат = Новый Массив;
	
	ДвоичныеДанныеТитула = ДокументЭТрН_Титул1.Документооборот.ХранилищеКонтента.Данные;
	
	КонтентXDTO = _Ядро.ГенерацияXML_XML_В_ОбъектXDTO(ДвоичныеДанныеТитула);
	
	СвГрузXDTO = XDTO_Вычислить(КонтентXDTO, "Документ.СодИнфГО.СвГруз");
	
	СписокГрузовXDTO = XDTO_СписокИзЭлемента(СвГрузXDTO, "ОпГруз");
	
	Для Каждого ТекГрузXDTO Из СписокГрузовXDTO Цикл
		
		ДанныеГруза = ЭТрН_Титул_3_ПоляГрузаДляЗаполнения();
		
		Для Каждого ТекДанныеГруза Из ДанныеГруза Цикл
			
			ДанныеГруза[ТекДанныеГруза.Ключ] = XDTO_Вычислить(ТекГрузXDTO, ТекДанныеГруза.Значение);
			
		КонецЦикла;
		
		Результат.Добавить(ДанныеГруза);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭТрН_Титул_3_ПоляГрузаДляЗаполнения()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Наименование", "НаимГруз");
	Результат.Вставить("Состояние", "СостГруз");
