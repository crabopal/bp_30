Процедура ЗаполнитьСтрокуТоваровПоДополнительнымРеквизитамПЭ(СтрокаГруз) Экспорт

	Если РасчетВесаОбъемаУТ11() Тогда
		Возврат;
	КонецЕсли;

	ДанныеНоменклатуры = ДанныеНоменклатуры(СтрокаГруз.Номенклатура);
	
	Если ТипЗнч(СтрокаГруз) = Тип("Структура") Тогда
		
		СтрокаГруз.ИнфУпГруз.ГабарУпак.ВысЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ВысЗнач", СтрокаГруз.ИнфУпГруз.ГабарУпак.ВысЗнач);
		СтрокаГруз.ИнфУпГруз.ГабарУпак.ШирЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ШирЗнач", СтрокаГруз.ИнфУпГруз.ГабарУпак.ШирЗнач);
		СтрокаГруз.ИнфУпГруз.ГабарУпак.ДлЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ДлЗнач", СтрокаГруз.ИнфУпГруз.ГабарУпак.ДлЗнач);
		
		ВесУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВесУпак", 0);
		Если ЗначениеЗаполнено(ВесУпак) Тогда
			СтрокаГруз.ВесГруз.ВесБрутто = ВесУпак * СтрокаГруз.КолМестГр;
			СтрокаГруз.ВесГруз.ВесНетто = ВесУпак * СтрокаГруз.КолМестГр;
		КонецЕсли;  

		ОбъемУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ОбъемУпак", 0);
  		Если ЗначениеЗаполнено(ОбъемУпак) Тогда
			СтрокаГруз.Объем = ОбъемУпак * СтрокаГруз.КолМестГр;
		КонецЕсли;

		СтрокаГруз.ИнфУпГруз.ВидУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВидУпак", СтрокаГруз.ИнфУпГруз.ВидУпак);
 		СтрокаГруз.ИнфУпГруз.ВесУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВесУпак", СтрокаГруз.ИнфУпГруз.ВесУпак);

	Иначе     

		СтрокаГруз.ИнфУпГруз_ГабарУпак_ВысЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ВысЗнач", СтрокаГруз.ИнфУпГруз_ГабарУпак_ВысЗнач);
		СтрокаГруз.ИнфУпГруз_ГабарУпак_ШирЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ШирЗнач", СтрокаГруз.ИнфУпГруз_ГабарУпак_ШирЗнач);
		СтрокаГруз.ИнфУпГруз_ГабарУпак_ДлЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ДлЗнач", СтрокаГруз.ИнфУпГруз_ГабарУпак_ДлЗнач);
		
		ВесУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВесУпак", 0);
		Если ЗначениеЗаполнено(ВесУпак) Тогда
			СтрокаГруз.ВесГруз_ВесБрутто = ВесУпак * СтрокаГруз.КолМестГр;
			СтрокаГруз.ВесГруз_ВесНетто = ВесУпак * СтрокаГруз.КолМестГр;
		КонецЕсли;  

		ОбъемУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ОбъемУпак", 0);
  		Если ЗначениеЗаполнено(ОбъемУпак) Тогда
			СтрокаГруз.Объем = ОбъемУпак * СтрокаГруз.КолМестГр;
		КонецЕсли;

		СтрокаГруз.ИнфУпГруз_ВидУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВидУпак", СтрокаГруз.ИнфУпГруз_ВидУпак);
 		СтрокаГруз.ИнфУпГруз_ВесУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВесУпак", СтрокаГруз.ИнфУпГруз_ВесУпак);

	КонецЕсли;
		
КонецПроцедуры

Функция ДанныеТоварыДокументов(ДокументыОснования, ОпГрузТип, ИмяФормы)
	
	ТекстЗапроса = "";
	Запрос = Новый Запрос;
	
	Индекс = 0;
	Для Каждого ДокументОснование Из ДокументыОснования Цикл
		
		Мтд = ДокументОснование.Метаданные();
		
		Если Мтд.ТабличныеЧасти.Найти("Автомобили") <> Неопределено Тогда
			Индекс = Индекс + 1;
			ТекстЗапросаТовары(ДокументОснование, "Автомобили", ТекстЗапроса, Индекс, ИмяФормы);
			Запрос.УстановитьПараметр("СсылкаНаОбъект" + Формат(Индекс, "ЧГ="), ДокументОснование);
		КонецЕсли;
		
		Если Мтд.Имя = "ЗаказНаАвтомобиль" Тогда //ААА 
			
			Индекс = Индекс + 1;
			ТекстЗапросаТовары(ДокументОснование, "Ссылка", ТекстЗапроса, Индекс, ИмяФормы);
			Запрос.УстановитьПараметр("СсылкаНаОбъект" + Формат(Индекс, "ЧГ="), ДокументОснование);
			
		КонецЕсли;
		
		Если Мтд.ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
			Индекс = Индекс + 1;
			ТекстЗапросаТовары(ДокументОснование, "Товары", ТекстЗапроса, Индекс, ИмяФормы);
			Запрос.УстановитьПараметр("СсылкаНаОбъект" + Формат(Индекс, "ЧГ="), ДокументОснование); 
		ИначеЕсли Мтд.ТабличныеЧасти.Найти("Запасы") <> Неопределено Тогда
			Индекс = Индекс + 1;
			ТекстЗапросаТовары(ДокументОснование, "Запасы", ТекстЗапроса, Индекс, ИмяФормы);
			Запрос.УстановитьПараметр("СсылкаНаОбъект" + Формат(Индекс, "ЧГ="), ДокументОснование); 
		ИначеЕсли Мтд.ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено Тогда //ТранспортнаяНакладная
