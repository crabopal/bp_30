		СтрокаНастройки = Новый Структура;
		СтрокаНастройки.Вставить("ИдентификаторНастройки", Строка(Новый УникальныйИдентификатор));
		СтрокаНастройки.Вставить("МетаданныеДокумента", Метаданные.Документы["ЗаказПокупателя"].ПолноеИмя());
		СтрокаНастройки.Вставить("МетаданныеДокументаПредставление", Метаданные.Документы["ЗаказПокупателя"].Представление());
		СтрокаНастройки.Вставить("НастройкаСКД", Неопределено);
		СтрокаНастройки.Вставить("ПредставлениеНастройки", Метаданные.Документы["ЗаказПокупателя"].Представление());
		
