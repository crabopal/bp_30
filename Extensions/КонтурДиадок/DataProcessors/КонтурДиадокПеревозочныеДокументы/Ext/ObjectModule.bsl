Процедура ЗаполнитьСообщениеТрнПоДокументу1С(СообщениеТрН, ИдентификаторТрН, ДокументыОснования, ОсновнойДокумент, Параметры)
	
	// количество поддерживаемых конфигураций расширяется
	
	ЗаполнитьСообщениеТрНПоДокументу1С_ВсеКонфигурации(СообщениеТрН, ИдентификаторТрН, ДокументыОснования, ОсновнойДокумент);
	
КонецПроцедуры

Процедура ЗаполнитьСообщениеЗЗПоДокументу1С(СообщениеЗЗ, ИдентификаторЗЗ, ДокументыОснования, ОсновнойДокумент, Параметры)
	
	// количество поддерживаемых конфигураций расширяется
	
	ЗаполнитьСообщениеЗЗПоДокументу1С_ВсеКонфигурации(СообщениеЗЗ, ИдентификаторЗЗ, ДокументыОснования, ОсновнойДокумент);
	
КонецПроцедуры

Процедура ЗаполнитьСообщениеПЭПоДокументу1С(СообщениеПЭ, ИдентификаторПЭ, ДокументыОснования, ОсновнойДокумент, Параметры)
	
	// количество поддерживаемых конфигураций расширяется
	
	ЗаполнитьСообщениеПЭПоДокументу1С_ВсеКонфигурации(СообщениеПЭ, ИдентификаторПЭ, ДокументыОснования, ОсновнойДокумент);
	
КонецПроцедуры                    

Процедура ЗаполнитьСообщениеТрнПоДокументу1С_ВсеКонфигурации(СообщениеТрН, ИдентификаторТрН, ДокументыОснования, ОсновнойДокумент)
		
	ДанныеНакладной = ДанныеТрН(ИдентификаторТрН, ДокументыОснования, ОсновнойДокумент);
	ЗаменитьСсылкиНаСтруктуры(СообщениеТрН, ДанныеНакладной);
	
КонецПроцедуры

Процедура ЗаполнитьСообщениеЗЗПоДокументу1С_ВсеКонфигурации(СообщениеЗЗ, ИдентификаторЗЗ, ДокументыОснования, ОсновнойДокумент)
		
	ДанныеНакладной = ДанныеЗЗ(ИдентификаторЗЗ, ДокументыОснования, ОсновнойДокумент);
	ЗаменитьСсылкиНаСтруктуры(СообщениеЗЗ, ДанныеНакладной);
	
КонецПроцедуры

Процедура ЗаполнитьСообщениеПЭПоДокументу1С_ВсеКонфигурации(СообщениеПЭ, ИдентификаторПЭ, ДокументыОснования, ОсновнойДокумент)
		
	ДанныеНакладной = ДанныеПЭ(ИдентификаторПЭ, ДокументыОснования, ОсновнойДокумент);
	ЗаменитьСсылкиНаСтруктуры(СообщениеПЭ, ДанныеНакладной);
	
КонецПроцедуры
     
//} ЗАПОЛНЕНИЕ СООБЩЕНИЯ


