Функция ИдентификаторФайлаТитулаТрн(ТрНСтруктура, Номер)
	
	// Формат ИдФайл титулов: R_Т_A_E_О_W_GGGGMMDD_N
	Шаблон = НСтр("ru = '%1_%2_%3_%4_%5_%6_%7'");
	
	Если _Ядро <> Неопределено Тогда

		Если ЗаполненКлючСтруктуры(ТрНСтруктура, "СвГО.РекИдентГО.Ссылка") Тогда
			ОтправительТрН = ОтправительТрН(ТрНСтруктура, Истина);
			ИдентификаторыГО = ИдентификаторыЭДО(ОтправительТрН, Истина);
			//Если ЕстьЛОП(ТрНСтруктура) Тогда
			//	//ИдентификаторыГО = ИдентификаторыЭДО(ТрНСтруктура.СвГО.РекИдентГО.Ссылка, Ложь);
			//	ИдентификаторыГО = ИдентификаторыЭДО(ТрНСтруктура.СвПогруз.СвЛицПогрГр.РекЛицПогрГр.Ссылка, Истина);
			//Иначе
			//	ИдентификаторыГО = ИдентификаторыЭДО(ТрНСтруктура.СвГО.РекИдентГО.Ссылка, Истина);
			//КонецЕсли;
			ИдГО = ИдентификаторыГО.ID;
		Иначе
			ИдГО = "";
		КонецЕсли;
		
 		Если ЗаполненКлючСтруктуры(ТрНСтруктура, "СвПер.Ссылка") Тогда
			ИдентификаторыПВ = ИдентификаторыЭДО(ТрНСтруктура.СвПер.Ссылка, Ложь);
			ИдПер = ИдентификаторыПВ.ID;
		Иначе
			ИдПер = "";
		КонецЕсли;
		
		Если ЗаполненКлючСтруктуры(ТрНСтруктура, "СвГП.РекИдентГП.Ссылка") Тогда
			ИдентификаторыГП = ИдентификаторыЭДО(ТрНСтруктура.СвГП.РекИдентГП.Ссылка, Ложь);
			ИдГП = ИдентификаторыГП.ID;
		Иначе
			ИдГП = "";
		КонецЕсли;
		
		ИдИн = "";
		ИдПолИной = ЗначениеСтруктурыПоКлючу(ТрНСтруктура, "ИдПолИной");
		Если ТипЗнч(ИдПолИной) = Тип("Массив") Тогда
			Для Каждого ЗначениеИдПолИной Из ИдПолИной Цикл
				ИдентификаторыИдПолИной = ИдентификаторыЭДО(ЗначениеИдПолИной.Ссылка, Ложь);
				ИдИн = ИдентификаторыИдПолИной.ID; 
			КонецЦикла;
		КонецЕсли;

	Иначе
		
		ИдГО 	= "";
		ИдПер 	= "";
		ИдГП	= "";
		ИдИн = "";
		
	КонецЕсли;

	Если Номер = 1 Тогда
		
		R_Т = "ON_TRNACLGROT";
		A	= ИдПер;
		E	= ИдГП;
		O 	= ИдГО;
		
	ИначеЕсли Номер = 2 Или Номер = 4 Тогда
		
		R_Т = "ON_TRNACLPPRIN";
		A	= ИдГП;
		E	= ИдГО;
		O 	= ИдПер;
			
	ИначеЕсли Номер = 3 Тогда
		
		R_Т = "ON_TRNACLGRPO";
		A	= ИдПер;
		E	= ИдГО;
		O 	= ИдГП;
		
	Иначе
		
		ВызватьИсключение "Непредполагаемый номер титула транспортной накладной";
		
	КонецЕсли;
	
	Если ИдИн = "" Тогда
		W = 0;
	Иначе
		W = 1;
	КонецЕсли;

	GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	N = Строка(Новый УникальныйИдентификатор);
	
	ИдФайла = ПодставитьПараметрыВСтрокуЛок(Шаблон, R_Т, A, E, O, W, GGGGMMDD, N);
	
	Возврат ИдФайла;
	
КонецФункции	

