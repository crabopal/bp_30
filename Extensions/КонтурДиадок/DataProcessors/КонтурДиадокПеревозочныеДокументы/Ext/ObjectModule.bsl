		|" + ПолеЗапроса(Мтд, ПолеДатаФактПо(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвГруз_ДатДостГрПо,    
		|" + ПолеЗапросаВес + " КАК СвГруз_ВесГрузПарт_ВесБрутто,    
		|" + ПолеЗапросаВес + " КАК СвГруз_ВесГрузПарт_ВесНетто,    
						
		|" + ПолеЗапроса(Мтд, ПолеАдресПогрузки(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвГруз_АдрГруз_АдрПриемГруз_Адрес_АдрИнф_АдрТекст,
		|" + ПолеЗапроса(Мтд, ПолеАдресПогрузкиЗначение(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвГруз_АдрГруз_АдрПриемГруз_Адрес_АдрРФ,
		|""643"" КАК СвПогруз_ФАдресПогр_КодСтраны,
		
		//|" + ПолеЗапроса(Мтд, ПолеАдресДоставки(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвГруз_АдрПунктНазн_АдрВыдГруз_Адрес_АдрИнф_АдрТекст,
		|" + ТекстЗапросаПолеАдресДоставки(Мтд) + " КАК СвГруз_АдрПунктНазн_АдрВыдГруз_Адрес_АдрИнф_АдрТекст,
		//|" + ПолеЗапроса(Мтд, ПолеАдресДоставкиЗначение(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвГруз_АдрПунктНазн_АдрВыдГруз_Адрес_АдрРФ,
		|" + ТекстЗапросаПолеАдресДоставкиЗначение(Мтд) + " КАК СвГруз_АдрПунктНазн_АдрВыдГруз_Адрес_АдрРФ,
		|""643"" КАК СвГП_АдресДостГр_КодСтраны
		
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|" + ТекстСоединенияВТ + "
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект" + Формат(Индекс, "ЧГ=") + " 
		|";
		
		Результат.Вставить(ДокументОснование, ТекстЗапросаВТ + ТекстЗапроса);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

