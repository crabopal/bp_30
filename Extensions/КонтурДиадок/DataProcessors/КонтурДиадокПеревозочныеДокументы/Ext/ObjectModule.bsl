Функция ПослеПодготовкиПакета(Параметры)
	
	Пакет = Параметры.Пакет;
	Данные1С = Пакет.Данные1С;
	
	ИдентификаторыПакетов = ИдентификаторыПакетовПеревозочных();
	
	Если Не ИдентификаторыПакетов.Найти(Данные1С.ВидПакетаID) = Неопределено Тогда
	
		Организация = Данные1С.Организация;
		Контрагент = Данные1С.Контрагент;
		ИдентификаторыЭДОКонтрагента = ИдентификаторыЭДО(Контрагент, Ложь, Организация);
		
		ДанныеДД = Пакет.ДанныеДД;
		ДанныеДД.CounterAgentId = ИдентификаторыЭДОКонтрагента.BoxId;
		
		Если ДанныеДД.CounterAgentId = ДанныеДД.OrganizationId Тогда
			ДанныеДД.IsInternal = Истина;
			ДанныеДД.FromDepartmentId = ИдентификаторГоловногоПодразделения();
			ДанныеДД.ToDepartmentId = ИдентификаторГоловногоПодразделения();
		КонецЕсли;
		
		Возврат Истина;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	
КонецФункции

