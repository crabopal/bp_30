Процедура ПараметрыВалидацииТрН(Результат, Префикс = "")
	
	ИмяФормы = "ФормаТрН";
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "НомерТрН", Истина, "Номер ТрН");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ДатаТрН", Истина, "Дата ТрН");
	// при незаполненности подставляются автоматически по дате, номеру ТрН
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвТС.Прицеп", Ложь, "Прицеп");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвТС.ТС", Истина, "Автомобиль");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГО.РекИдентГО", Истина, "Грузоотправитель");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвПогруз", Истина, "СвПогруз");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "УказГО", Истина, "УказГО");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГП.РекИдентГП", Истина, "Грузополучатель");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СопрДок", Ложь, "Сопроводительные документы");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвПер", Истина, "Перевозчик");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвЗак.РекИдентЗак", Ложь,	"Заказчик");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвВодит1", Истина, "Водитель"); //минимум 1 водитель должен быть
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ОпГруз", Истина, "Сведения о грузе");
	//ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПутевойЛист.НомерДок", Истина, "Номер путевого листа");
	//ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПутевойЛист.ДатаДок", Истина, "Дата путевого листа");
	
КонецПроцедуры

Процедура ПараметрыВалидацииЗЗ(Результат, Префикс)

	ИмяФормы = "ФормаЗЗ";

	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "НомЗак", Истина, "Номер заказ-заявки");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ДатаЗак", Истина, "Дата заказ-заявки");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "УкНормПрвз", Истина, "Указание норм перевозки");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПрвзПищПрод", Истина, "Требования к ТС при перевозке пищевых продуктов");
	
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвГО", Истина, "Сведения о грузоотправителе");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СвПрв", Истина, "Сведения о перевозчике");
	
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПарТСПрвз.Тип", Истина, "Тип транспортного средства");
 	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПарТСПрвз.Грузопод", Истина, "Грузоподъемность транспортного средства");
 	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПарТСПрвз.Вместим", Истина, "Вместимость транспортного средства");

	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "АдрПункт", Истина, "Адреса пунктов погрузки и выгрузки");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ОпГруз", Истина, "Сведения о грузе"); 
	
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "техМетОпрМасс", Истина, "Метод определения массы гр. мест"); 
	
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПунктПод.ДатВрПод", Истина, "Дата время подачи"); 
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПунктПод.АдрПунктПод.Адрес.АдрИнф.АдрТекст", Истина, "Адрес пункта подачи"); 
	
