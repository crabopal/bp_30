Функция ТекстЗапросаУчастника(СсылкаНаОбъект, ТипУчастника)

	//СсылкаНаОбъект - может быть любая, проверяем по метаданным.
	Мтд = СсылкаНаОбъект.Метаданные();

	ИмяКонфигурации = ИмяКонфигурации();
	
	Если ТипУчастника = "ЮЛ" Тогда
		
		ПолеСокращенноеНаименование = ?(ПолеЗапроса(Мтд, ПолеСокращенноеНаименование()) = "НЕОПРЕДЕЛЕНО", """" + """", ПолеЗапроса(Мтд, ПолеСокращенноеНаименование()));
		ПолеПолноеНаименование = ?(ПолеЗапроса(Мтд, ПолеПолноеНаименование()) = "НЕОПРЕДЕЛЕНО", """" + """", ПолеЗапроса(Мтд, ПолеПолноеНаименование()));
		
		//работать можем с подразделением, данные по ИНН хранятся у организации
		Если Мтд.Имя = "ПодразделенияКомпании"
			И ЕстьРеквизитМетаданных(Мтд, "Организация") Тогда 
			ПолеИНН = ПолеЗапроса(Мтд, "Организация.ИНН");
		Иначе
			ПолеИНН = ПолеЗапроса(Мтд, "ИНН");
		КонецЕсли;

		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеИНН + " КАК ИдСв_СвЮЛУч_ИННЮЛ,
		|" + ПолеЗапроса(Мтд, "КПП") + " КАК ИдСв_СвЮЛУч_КПП,
		|ВЫБОР 
		|КОГДА ВЫРАЗИТЬ(" + ПолеСокращенноеНаименование + " КАК СТРОКА(250)) <> """"  
		|ТОГДА " + ПолеСокращенноеНаименование + "
		|КОГДА ВЫРАЗИТЬ(" + ПолеПолноеНаименование + " КАК СТРОКА(250)) <> """"  
		|ТОГДА " + ПолеПолноеНаименование + "
		|ИНАЧЕ " + ПолеЗапроса(Мтд, "Наименование") + " КОНЕЦ КАК ИдСв_СвЮЛУч_НаимОрг
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
		
	ИначеЕсли ТипУчастника = "ИП" Тогда
		
		ТекстЗапроса = "";
		Если Мтд.Реквизиты.Найти("ИндивидуальныйПредприниматель") <> Неопределено Тогда
			ЗначениеИП = СсылкаНаОбъект.ИндивидуальныйПредприниматель;
			Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗначениеИП))
				И ЗначениеЗаполнено(ЗначениеИП) Тогда
				
				ТекстЗапросаФЛ = ТекстЗапросаУчастника(ЗначениеИП, "ФЛ");
				ТекстЗапросаФЛ = СтрЗаменить(ТекстЗапросаФЛ, Символы.ПС + "ИЗ" + Символы.ПС, Символы.ПС + "ПОМЕСТИТЬ ВТДанныеИз1С" + Символы.ПС +"ИЗ" + Символы.ПС); 
				ТекстЗапросаФЛ = СтрЗаменить(ТекстЗапросаФЛ, "ДанныеИз1С.Ссылка = &СсылкаНаОбъект", "Истина");
				ТекстЗапросаФЛ = ТекстЗапросаФЛ + "
				|;
				|";
				
				ТекстЗапроса = ТекстЗапросаФЛ + "
				|ВЫБРАТЬ
				|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
				|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИдСв_СвИП_ИННФЛ,
				|" + ПолеЗапроса(Мтд, ПолеОГРН()) + " КАК ИдСв_СвИП_ОГРНИП,		
				|ВТДанныеИз1С.ИдСв_СвФЛУчаст_ФИО_Наименование КАК ИдСв_СвИП_ФИО_Наименование,		
				|ВТДанныеИз1С.ИдСв_СвФЛУчаст_ФИО_Фамилия КАК ИдСв_СвИП_ФИО_Фамилия,		
				|ВТДанныеИз1С.ИдСв_СвФЛУчаст_ФИО_Имя  КАК ИдСв_СвИП_ФИО_Имя,		
				|ВТДанныеИз1С.ИдСв_СвФЛУчаст_ФИО_Отчество  КАК ИдСв_СвИП_ФИО_Отчество		
				|ИЗ
				|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
				|ЛЕВОЕ СОЕДИНЕНИЕ ВТДанныеИз1С КАК ВТДанныеИз1С
				|ПО ДанныеИз1С.ИндивидуальныйПредприниматель = ВТДанныеИз1С.Ссылка
				|ГДЕ
				|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
				
			КонецЕсли;
		КонецЕсли;
		
		Если ТекстЗапроса = "" Тогда
			                  
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
			|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ИдСв_СвИП_ФИО_ПолноеНаименование,		
			|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИдСв_СвИП_ИННФЛ,
			|" + ПолеЗапроса(Мтд, ПолеОГРН()) + " КАК ИдСв_СвИП_ОГРНИП,		
			|" + ПолеЗапроса(Мтд, ПолеПолноеНаименование()) + " КАК ИдСв_СвИП_ФИО_Наименование,		
			|" + ПолеЗапроса(Мтд, ПолеФамилия()) + " КАК ИдСв_СвИП_ФИО_Фамилия,		
			|" + ПолеЗапроса(Мтд, ПолеИмя()) + " КАК ИдСв_СвИП_ФИО_Имя,		
			|" + ПолеЗапроса(Мтд, ПолеОтчество()) + " КАК ИдСв_СвИП_ФИО_Отчество		
			|ИЗ
			|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
			|ГДЕ
			|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
			
		КонецЕсли;

	ИначеЕсли ТипУчастника = "ФЛ" Тогда
		
		Если Метаданные.РегистрыСведений.Найти("ФИОФизЛиц") <> Неопределено Тогда
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
			|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ИдСв_СвФЛУчаст_ФИО_ПолноеНаименование,		
			|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИдСв_СвФЛУчаст_ИННФЛ,
			|" + ПолеЗапроса(Мтд, ПолеПолноеНаименование()) + " КАК ИдСв_СвФЛУчаст_ФИО_Наименование,		
			|	ФИОФизЛицСрезПоследних.Фамилия КАК ИдСв_СвФЛУчаст_ФИО_Фамилия,
			|	ФИОФизЛицСрезПоследних.Имя КАК ИдСв_СвФЛУчаст_ФИО_Имя,
			|	ФИОФизЛицСрезПоследних.Отчество КАК ИдСв_СвФЛУчаст_ФИО_Отчество
			|ИЗ
			|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних КАК ФИОФизЛицСрезПоследних
			|	ПО ФИОФизЛицСрезПоследних.ФизЛицо = " + ПолеЗапроса(Мтд, "Ссылка") + "
			|ГДЕ
			|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
			
		Иначе
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
			|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ИдСв_СвФЛУчаст_ФИО_ПолноеНаименование,		
			|" + ПолеЗапроса(Мтд, ПолеПолноеНаименование()) + " КАК ИдСв_СвФЛУчаст_ФИО_Наименование,		
			|" + ПолеЗапроса(Мтд, "ИНН") + " КАК ИдСв_СвФЛУчаст_ИННФЛ,
			|" + ПолеЗапроса(Мтд, ПолеФамилия()) + " КАК ИдСв_СвФЛУчаст_ФИО_Фамилия,
			|" + ПолеЗапроса(Мтд, ПолеИмя()) + " КАК ИдСв_СвФЛУчаст_ФИО_Имя,
			|" + ПолеЗапроса(Мтд, ПолеОтчество()) + " КАК ИдСв_СвФЛУчаст_ФИО_Отчество
			|ИЗ
			|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
			|ГДЕ
			|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаДоговора(СсылкаНаОбъект)	

	Мтд = СсылкаНаОбъект.Метаданные();	
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|" + ПолеЗапроса(Мтд, ПолеВладелецДоговора()) + ".Ссылка КАК ИдРекСост_Ссылка,
	|" + ПолеЗапроса(Мтд, ПолеВладелецДоговора()) + ".Ссылка КАК РеквИдРекСост_Ссылка,
	|" + ПолеЗапроса(Мтд, ПолеВладелецДоговора()) + ".ИНН КАК ИдРекСост_ИНН,
	|" + ПолеЗапроса(Мтд, ПолеВладелецДоговора()) + ".ИНН КАК РеквИдРекСост_ИНН,
	|" + ПолеЗапроса(Мтд, "Наименование") + " КАК НаимДок,
	|" + ПолеЗапроса(Мтд, "Наименование") + " КАК РеквНаимДок,
	|" + ПолеЗапроса(Мтд, ПолеНомерДоговора()) + " КАК НомерДок,
	|" + ПолеЗапроса(Мтд, ПолеНомерДоговора()) + " КАК РеквНомерДок,
	|" + ПолеЗапроса(Мтд, ПолеДатаДоговора()) + " КАК ДатаДок,
	|" + ПолеЗапроса(Мтд, ПолеДатаДоговора()) + " КАК РеквДатаДок,
	|" + ПолеЗапроса(Мтд, "Комментарий") + " КАК ДопСведДок,
	|" + ПолеЗапроса(Мтд, "Комментарий") + " КАК РеквДопСведДок
	|ИЗ
	|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
	|ГДЕ
	|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаНоменклатура(СсылкаНаОбъект)	
	
	Если СсылкаНаОбъект = Неопределено 
		Или ТипЗнч(СсылкаНаОбъект) = Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	ИмяФормы = "ФормаНоменклатуры";
	мтдОбъекта = СсылкаНаОбъект.Метаданные();	
		
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|ДанныеИз1С.Ссылка КАК Ссылка";

	Если ЕстьРеквизитМетаданных(мтдОбъекта, "Объем") Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|ДанныеИз1С.Объем КАК ОбъемУпак";
	Иначе
		ТекстЗапроса = ТекстЗапроса + ",
		|0 КАК ОбъемУпак";
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(мтдОбъекта, "Вес") Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|ДанныеИз1С.Вес КАК ВесУпак";
	ИначеЕсли ЕстьРеквизитМетаданных(мтдОбъекта, "ВесПоСертификатуТовара") Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|ДанныеИз1С.ВесПоСертификатуТовара КАК ВесУпак";
	Иначе
		ТекстЗапроса = ТекстЗапроса + ",
		|0 КАК ВесУпак";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|ИЗ
	|" + мтдОбъекта.ПолноеИмя() + " КАК ДанныеИз1С
	|ГДЕ
	|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
	
	Возврат ТекстЗапроса;

КонецФункции


Функция ТекстЗапросаКонтактнаяИнформация(СсылкаНаОбъект, УсловияПоВидам = Ложь)
	
	ТекстЗапросаКИ = Неопределено;
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();	
	
	Если МетаданныеОбъекта.ТабличныеЧасти.Найти("КонтактнаяИнформация") <> Неопределено Тогда
		ТекстЗапросаКИ = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СправочникКонтактнаяИнформация.Ссылка КАК Ссылка,
		|	СправочникКонтактнаяИнформация.Представление КАК Значение,
		|	СправочникКонтактнаяИнформация.ЗначенияПолей КАК ЗначенияПолей,
		|	СправочникКонтактнаяИнформация.ЗначенияПолей КАК АдресЭП,
		|	СправочникКонтактнаяИнформация.ЗначенияПолей КАК НомерТелефона,
		|	СправочникКонтактнаяИнформация.Вид КАК Вид,
		|	""643"" КАК КодСтраны
		|ИЗ
		|	Справочник." + МетаданныеОбъекта.Имя + ".КонтактнаяИнформация КАК СправочникКонтактнаяИнформация
		|ГДЕ
		|	СправочникКонтактнаяИнформация.Ссылка = &СсылкаНаОбъект
		|	И СправочникКонтактнаяИнформация.Тип = &ТипКИ";
		Если УсловияПоВидам Тогда
			ТекстЗапросаКИ = ТекстЗапросаКИ + "
			|	И СправочникКонтактнаяИнформация.Вид В (&ВидыКИ)";	
		КонецЕсли;
	ИначеЕсли Метаданные.РегистрыСведений.Найти("КонтактнаяИнформация") <> Неопределено Тогда
		ТекстЗапросаКИ = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрКонтактнаяИнформация.Объект КАК Ссылка,
		|	РегистрКонтактнаяИнформация.Представление КАК Значение,
		|	"""" КАК ЗначенияПолей,
		|	РегистрКонтактнаяИнформация.Представление КАК АдресЭП,
		|	РегистрКонтактнаяИнформация.Представление КАК НомерТелефона,
		|	РегистрКонтактнаяИнформация.Вид КАК Вид,
		|	""643"" КАК КодСтраны
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК РегистрКонтактнаяИнформация
		|ГДЕ
		|	РегистрКонтактнаяИнформация.Объект = &СсылкаНаОбъект
		|	И РегистрКонтактнаяИнформация.Тип = &ТипКИ";
		Если УсловияПоВидам Тогда
			ТекстЗапросаКИ = ТекстЗапросаКИ + "
			|	И РегистрКонтактнаяИнформация.Вид В (&ВидыКИ)";	
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекстЗапросаКИ;
	
КонецФункции

Функция ТекстЗапросаПогрузкаСотрудник(СсылкаНаОбъект)

	Мтд = СсылкаНаОбъект.Метаданные();
	
	ИмяКонфигурации = ИмяКонфигурации();
	
	Если ИмяКонфигурации = "УТ_11" Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ФИО_Наименование,
		|" + ПолеЗапроса(Мтд, "Должность") + " КАК Должность
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
		
	ИначеЕсли Метаданные.РегистрыСведений.Найти("ФИОФизЛиц") <> Неопределено Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ФИО_Наименование,
		|	ФИОФизЛицСрезПоследних.Фамилия КАК ФИО_Фамилия,
		|	ФИОФизЛицСрезПоследних.Имя КАК ФИО_Имя,
		|	ФИОФизЛицСрезПоследних.Отчество КАК ФИО_Отчество
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних КАК ФИОФизЛицСрезПоследних
		|	ПО ФИОФизЛицСрезПоследних.ФизЛицо = " + ПолеЗапроса(Мтд, "Ссылка") + "
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
		
	Иначе
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + ПолеЗапроса(Мтд, "Ссылка") + " КАК Ссылка,
		|" + ПолеЗапроса(Мтд, ПолеФИО()) + " КАК ФИО_Наименование,
		|" + ПолеЗапроса(Мтд, "Фамилия") + " КАК ФИО_Фамилия,
		|" + ПолеЗапроса(Мтд, "Имя") + " КАК ФИО_Имя,
		|" + ПолеЗапроса(Мтд, "Отчество") + " КАК ФИО_Отчество,
		|" + ПолеЗапроса(Мтд, "Должность") + " КАК Должность
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект";
	
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции

Процедура ТекстЗапросаТовары(ДокументОснование, ИмяТЧ, ТекстЗапроса, Индекс, ИмяФормы)
	
	Мтд = ДокументОснование.Метаданные();
	МтдТовары = Неопределено;
	
	Если ИмяТЧ = "Ссылка" Тогда
		МтдТовары = Мтд; 
	ИначеЕсли ИмяТЧ <> Неопределено И Мтд.ТабличныеЧасти.Найти(ИмяТЧ) <> Неопределено Тогда
		МтдТовары = Мтд.ТабличныеЧасти[ИмяТЧ]; 
	ИначеЕсли Мтд.ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
		МтдТовары = Мтд.ТабличныеЧасти.Товары; 
	ИначеЕсли Мтд.ТабличныеЧасти.Найти("Запасы") <> Неопределено Тогда
		МтдТовары = Мтд.ТабличныеЧасти.Запасы; 
	КонецЕсли;
	
	Если МтдТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПсевдонимСтоимость = "Стоимость";
	ПсевдонимКоличество = "Количество";

	Если ИмяФормы = "ФормаТрН" Тогда
		ПсевдонимСтоимость = "ЦеннГруз_СтЦеннГр"; 
		ПсевдонимКоличество = "КолМестГр";
	ИначеЕсли ИмяФормы = "ФормаЗЗ" Тогда
		ПсевдонимСтоимость = "ЦеннГруз_СтЦеннГр";
		ПсевдонимКоличество = "КолГрМест";
	ИначеЕсли ИмяФормы = "ФормаПЭ" Тогда
		ПсевдонимСтоимость = "ОбъявлСтГруз_СтГр";
		ПсевдонимКоличество = "КолМестГр";
	КонецЕсли;
	
	//определить сумму с ндс
	ПолеЗапросаСумма = ПолеЗапроса(МтдТовары, ПолеСумма());
	Если Мтд.Реквизиты.Найти("СуммаВключаетНДС") <> Неопределено
		И ПолеЗапроса(МтдТовары, "СуммаНДС") <> "НЕОПРЕДЕЛЕНО" Тогда
		ПолеЗапросаСумма = ПолеЗапросаСумма + ?(ДокументОснование.СуммаВключаетНДС, "",  " + " + ПолеЗапроса(МтдТовары, ПолеСуммаНДС()));
	ИначеЕсли Мтд.Реквизиты.Найти("ЦенаВключаетНДС") <> Неопределено
		И ПолеЗапроса(МтдТовары, "СуммаНДС") <> "НЕОПРЕДЕЛЕНО" Тогда
		ПолеЗапросаСумма = ПолеЗапросаСумма + ?(ДокументОснование.ЦенаВключаетНДС, "", " + " + ПолеЗапроса(МтдТовары, ПолеСуммаНДС()));
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ?(ТекстЗапроса = "", "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ") + " 
	|&СсылкаНаОбъект" + Формат(Индекс, "ЧГ=") + " КАК техДокОсн,
	|" + ПолеЗапроса(МтдТовары, ПолеНоменклатура()) + " КАК Номенклатура,
	|" + ПолеЗапроса(МтдТовары, ПолеКоличествоУпаковок()) + " КАК " + ПсевдонимКоличество +",
	|" + ПолеЗапросаСумма + " КАК " + ПсевдонимСтоимость;
	
	ПолеЗапросаНоменклатура = ПолеЗапроса(МтдТовары, ПолеНоменклатура());
	ПолеЗапросаЕдиницаИзмерения = ПолеЗапроса(МтдТовары, ПолеЕдиницаИзмерения());
	
	ТекстЗапроса = ТекстЗапроса + ТекстЗапросаТоварыВес(мтдТовары, ИмяФормы);
	ТекстЗапроса = ТекстЗапроса + ТекстЗапросаТоварыОбъем(мтдТовары, ИмяФормы);
	ТекстЗапроса = ТекстЗапроса + ТекстЗапросаТоварыГабариты(мтдТовары, ИмяФормы);

	ЕстьКодТНВЭД = Ложь;
	ЕстьСтрана = Ложь;
	Если ПолеЗапросаНоменклатура = "ДанныеИз1С.Номенклатура" Тогда
		мтдНоменклатура = Метаданные.Справочники.Найти("Номенклатура");
		Если мтдНоменклатура <> Неопределено Тогда
			Если ЕстьРеквизитМетаданных(мтдНоменклатура, "КодТНВЭД") Тогда
				ТекстЗапроса = ТекстЗапроса + ",
				|" + ПолеЗапросаНоменклатура + ".КодТНВЭД КАК КодТовНом"; 
				ЕстьКодТНВЭД = Истина;
			КонецЕсли;
			Если РеквизитМетаданных(мтдНоменклатура, ПолеСтрана()) <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + ",
				|" + ПолеЗапросаНоменклатура + "." + РеквизитМетаданных(мтдНоменклатура, ПолеСтрана()) + " КАК СвСтрПроисх";
				ЕстьСтрана = Истина;
			КонецЕсли;			
		КонецЕсли;
	КонецЕсли;
	Если Не ЕстьКодТНВЭД Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|НЕОПРЕДЕЛЕНО КАК КодТовНом";
	КонецЕсли;
	Если Не ЕстьСтрана Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|НЕОПРЕДЕЛЕНО КАК СвСтрПроисх";
	КонецЕсли;
	
	Если МтдТовары <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ИЗ
		|" + Мтд.ПолноеИмя() + ?(ИмяТЧ = "Ссылка", "", "." + МтдТовары.Имя) + " КАК ДанныеИз1С
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект" + Формат(Индекс, "ЧГ=") + " 
		|";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ТекстЗапросаТоварыУсловия(мтдТовары);
	
КонецПроцедуры

Функция РасчетВесаОбъемаУТ11() Экспорт
	
	мтдНоменклатура = Метаданные.Справочники.Найти("Номенклатура");
	мтдУпаковкиЕдиницыИзмерения = Метаданные.Справочники.Найти("УпаковкиЕдиницыИзмерения");
	мтдКонстантаОбъема = Метаданные.Константы.Найти("ЕдиницаИзмеренияОбъема");
	мтдКонстантаВеса = Метаданные.Константы.Найти("ЕдиницаИзмеренияВеса");

	Результат = мтдУпаковкиЕдиницыИзмерения <> Неопределено
	И мтдУпаковкиЕдиницыИзмерения <> Неопределено
	И мтдУпаковкиЕдиницыИзмерения <> Неопределено
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "ВесЕдиницаИзмерения")
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "Знаменатель")
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "Числитель")
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "Вес")
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "ТипИзмеряемойВеличины")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ВесИспользовать")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ОбъемЕдиницаИзмерения")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ОбъемЧислитель")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ОбъемЗнаменатель")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ВесЗнаменатель")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ВесЧислитель")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ВесЕдиницаИзмерения")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ПлощадьЕдиницаИзмерения")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ПлощадьЧислитель")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ПлощадьЗнаменатель")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ДлинаЕдиницаИзмерения")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ДлинаЧислитель")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "ДлинаЗнаменатель");
	
	Возврат Результат;
	
КонецФункции

Функция РасчетГабаритовУТ11()
	
	мтдУпаковкиЕдиницыИзмерения = Метаданные.Справочники.Найти("УпаковкиЕдиницыИзмерения");
	мтдКонстантаДлины = Метаданные.Константы.Найти("ЕдиницаИзмеренияДлины");
	
	Результат = мтдУпаковкиЕдиницыИзмерения <> Неопределено
	И мтдКонстантаДлины <> Неопределено
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "Высота")
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "ВысотаЕдиницаИзмерения")
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "Ширина")
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "ШиринаЕдиницаИзмерения")
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "Глубина")
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "ГлубинаЕдиницаИзмерения")
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "Знаменатель")
	И ЕстьРеквизитМетаданных(мтдУпаковкиЕдиницыИзмерения, "Числитель");
	
	Возврат Результат;
	
КонецФункции

Функция РасчетГабаритовУНФ(мтдНоменклатура = Неопределено) Экспорт 
	
	Если мтдНоменклатура =Неопределено Тогда
		мтдНоменклатура = Метаданные.Справочники.Найти("Номенклатура");
	КонецЕсли;
	
	Результат = мтдНоменклатура <> Неопределено
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "Высота")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "Ширина")
	И ЕстьРеквизитМетаданных(мтдНоменклатура, "Длина");
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаТоварыВес(мтдТовары, ИмяФормы)
	
	ТекстЗапроса = "";
	ЕстьВес = Ложь;
	ПолеЗапросаНоменклатура = "";
	Если ИмяФормы = "ФормаТрН" Тогда
		ПсевдонимМассаБрутто = "ПлМасГруз_МасБрутЗнач";
		ПсевдонимМассаНетто = "ПлМасГруз_МасНетЗнач";
	ИначеЕсли ИмяФормы = "ФормаЗЗ" Тогда
		ПсевдонимМассаБрутто = "МасГруз_МасБрутЗнач";
		ПсевдонимМассаНетто = "МасГруз_МасНетЗнач";
	ИначеЕсли ИмяФормы = "ФормаПЭ" Тогда
		ПсевдонимМассаБрутто = "ВесГруз_ВесБрутто";
		ПсевдонимМассаНетто = "ВесГруз_ВесНетто";
	КонецЕсли;	
	
	мтдНоменклатура = Неопределено;
	ПолеЗапросаНоменклатура = ПолеЗапроса(мтдТовары, ПолеНоменклатура());
	ТипРеквизитаНоменклатура = ТипРеквизитаОбъекта(мтдТовары, ПолеНоменклатура());
	Если ТипРеквизитаНоменклатура <> Неопределено Тогда
		мтдНоменклатура = Метаданные.НайтиПоТипу(ТипРеквизитаНоменклатура);
	КонецЕсли;
	
	мтдЕдиницаИзмерения = Неопределено;
	ПолеЗапросаЕдиницаИзмерения = ПолеЗапроса(мтдТовары, ПолеЕдиницаИзмерения());
	ТипРеквизитаЕдиницаИзмерения = ТипРеквизитаОбъекта(мтдТовары, ПолеЕдиницаИзмерения());
	Если ТипРеквизитаЕдиницаИзмерения <> Неопределено Тогда
		мтдЕдиницаИзмерения = Метаданные.НайтиПоТипу(ТипРеквизитаЕдиницаИзмерения);
	КонецЕсли;

	ПолеЗапросаНоменклатура = ПолеЗапроса(мтдТовары, ПолеНоменклатура());
	ПолеЗапросаЕдиницаИзмерения = ПолеЗапроса(мтдТовары, ПолеЕдиницаИзмерения());
	Если ЕстьРеквизитМетаданных(мтдНоменклатура, "ЕдиницаИзмерения") Тогда
		ПолеЗапросаЕдиницаИзмеренияНоменклатуры = ПолеЗапросаНоменклатура + ".ЕдиницаИзмерения";
	Иначе
		ПолеЗапросаЕдиницаИзмеренияНоменклатуры = ПолеЗапросаЕдиницаИзмерения;
	КонецЕсли;
	ПолеЗапросаКоличествоУпаковок = ПолеЗапроса(мтдТовары, ПолеКоличествоУпаковок());
	ПолеЗапросаКоличество = ПолеЗапроса(мтдТовары, ПолеКоличество());
		
	Если ПолеЗапросаЕдиницаИзмерения <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаЕдиницаИзмеренияНоменклатуры <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаНоменклатура <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаКоличество <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаКоличествоУпаковок <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаНоменклатура <> "НЕОПРЕДЕЛЕНО"
		И РасчетВесаОбъемаУТ11() Тогда // УТ11
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ТекстЗапросаВесУпаковки(ПолеЗапросаЕдиницаИзмерения, ПолеЗапросаНоменклатура)  + "*" + ПолеЗапросаКоличествоУпаковок + " КАК " + ПсевдонимМассаБрутто + ",
		|" + ТекстЗапросаВесУпаковки(ПолеЗапросаЕдиницаИзмеренияНоменклатуры, ПолеЗапросаНоменклатура)  + "*" + ПолеЗапросаКоличество + " КАК " + ПсевдонимМассаНетто;
		ЕстьВес = Истина;
	ИначеЕсли ПолеЗапросаЕдиницаИзмерения <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаКоличество <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаКоличествоУпаковок <> "НЕОПРЕДЕЛЕНО"
		И ЕстьРеквизитМетаданных(мтдЕдиницаИзмерения, "Вес") Тогда // УПП
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ПолеЗапросаЕдиницаИзмерения + ".Вес" + "*" + ПолеЗапросаКоличествоУпаковок + " КАК " + ПсевдонимМассаБрутто + ",
		|" + ПолеЗапросаЕдиницаИзмерения + ".Вес" + "*" + ПолеЗапросаКоличество + " КАК " + ПсевдонимМассаНетто;
		ЕстьВес = Истина;
	ИначеЕсли ПолеЗапросаНоменклатура <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаКоличество <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаКоличествоУпаковок <> "НЕОПРЕДЕЛЕНО"
		И ЕстьРеквизитМетаданных(мтдНоменклатура, "Вес") Тогда // УНФ
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ПолеЗапросаНоменклатура + ".Вес" + "*" + ПолеЗапросаКоличествоУпаковок + " КАК " + ПсевдонимМассаБрутто + ",
		|" + ПолеЗапросаНоменклатура + ".Вес" + "*" + ПолеЗапросаКоличество + " КАК " + ПсевдонимМассаНетто;
		ЕстьВес = Истина;
	ИначеЕсли ПолеЗапросаКоличествоУпаковок <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаНоменклатура <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаКоличество <> "НЕОПРЕДЕЛЕНО"
		И ЕстьРеквизитМетаданных(мтдНоменклатура, "ВесПоСертификатуТовара") Тогда // Бух 3.0
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ПолеЗапросаНоменклатура + ".ВесПоСертификатуТовара" + "*" + ПолеЗапросаКоличествоУпаковок + " КАК " + ПсевдонимМассаБрутто + ",
		|" + ПолеЗапросаНоменклатура + ".ВесПоСертификатуТовара" + "*" + ПолеЗапросаКоличество + " КАК " + ПсевдонимМассаНетто;
		ЕстьВес = Истина;			
	КонецЕсли;

	Если Не ЕстьВес Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|0 КАК " + ПсевдонимМассаБрутто + ",
		|0 КАК " + ПсевдонимМассаНетто;
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТоварыОбъем(мтдТовары, ИмяФормы)
	
	ТекстЗапроса = "";
	ЕстьОбъем = Ложь;
	ПолеЗапросаНоменклатура = "";
	Если ИмяФормы = "ФормаТрН" Тогда
		ПсевдонимОбъем = "Объем";
	ИначеЕсли ИмяФормы = "ФормаЗЗ" Тогда
		ПсевдонимОбъем = "Объем";
	ИначеЕсли ИмяФормы = "ФормаПЭ" Тогда
		ПсевдонимОбъем = "Объем";
	КонецЕсли;	
	
	мтдНоменклатура = Неопределено;
	ПолеЗапросаНоменклатура = ПолеЗапроса(мтдТовары, ПолеНоменклатура());
	ТипРеквизитаНоменклатура = ТипРеквизитаОбъекта(мтдТовары, ПолеНоменклатура());
	Если ТипРеквизитаНоменклатура <> Неопределено Тогда
		мтдНоменклатура = Метаданные.НайтиПоТипу(ТипРеквизитаНоменклатура);
	КонецЕсли;
	
	мтдЕдиницаИзмерения = Неопределено;
	ПолеЗапросаЕдиницаИзмерения = ПолеЗапроса(мтдТовары, ПолеЕдиницаИзмерения());
	ТипРеквизитаЕдиницаИзмерения = ТипРеквизитаОбъекта(мтдТовары, ПолеЕдиницаИзмерения());
	Если ТипРеквизитаЕдиницаИзмерения <> Неопределено Тогда
		мтдЕдиницаИзмерения = Метаданные.НайтиПоТипу(ТипРеквизитаЕдиницаИзмерения);
	КонецЕсли;
	
	ПолеЗапросаКоличествоУпаковок = ПолеЗапроса(мтдТовары, ПолеКоличествоУпаковок());
	ПолеЗапросаКоличество = ПолеЗапроса(мтдТовары, ПолеКоличество());
			
	Если ПолеЗапросаКоличествоУпаковок <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаЕдиницаИзмерения <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаНоменклатура <> "НЕОПРЕДЕЛЕНО"
		И РасчетВесаОбъемаУТ11() Тогда // УТ11
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ТекстЗапросаОбъемУпаковки(ПолеЗапросаЕдиницаИзмерения, ПолеЗапросаНоменклатура) + "*" + ПолеЗапросаКоличествоУпаковок + " КАК " + ПсевдонимОбъем;
		ЕстьОбъем = Истина;
	ИначеЕсли ПолеЗапросаКоличествоУпаковок <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаЕдиницаИзмерения <> "НЕОПРЕДЕЛЕНО"
		И ЕстьРеквизитМетаданных(мтдЕдиницаИзмерения, "Объем") Тогда // УПП
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ПолеЗапросаЕдиницаИзмерения + ".Объем" + "*" + ПолеЗапросаКоличествоУпаковок + " КАК " + ПсевдонимОбъем;
		ЕстьОбъем = Истина;
	ИначеЕсли ПолеЗапросаНоменклатура <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаКоличествоУпаковок <> "НЕОПРЕДЕЛЕНО"
		И ЕстьРеквизитМетаданных(мтдНоменклатура, "Объем") Тогда // УНФ
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ПолеЗапросаНоменклатура + ".Объем" + "*" + ПолеЗапросаКоличествоУпаковок + " КАК " + ПсевдонимОбъем;
		ЕстьОбъем = Истина;
	КонецЕсли;

	Если Не ЕстьОбъем Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|0 КАК Объем";
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТоварыГабариты(мтдТовары, ИмяФормы)
	
	ТекстЗапроса = "";
	ПолеЗапросаНоменклатура = "";
	Если ИмяФормы = "ФормаТрН" Тогда
		ПсевдонимДлина = "Габар_ДлЗнач";
		ПсевдонимШирина = "Габар_ШирЗнач";
		ПсевдонимВысота = "Габар_ВысЗнач";
	ИначеЕсли ИмяФормы = "ФормаЗЗ" Тогда
		ПсевдонимДлина = "РазмерГрМест_ДлЗнач";
		ПсевдонимШирина = "РазмерГрМест_ШирЗнач";
		ПсевдонимВысота = "РазмерГрМест_ВысЗнач";
	ИначеЕсли ИмяФормы = "ФормаПЭ" Тогда
		ПсевдонимДлина = "ИнфУпГруз_ГабарУпак_ДлЗнач";
		ПсевдонимШирина = "ИнфУпГруз_ГабарУпак_ШирЗнач";
		ПсевдонимВысота = "ИнфУпГруз_ГабарУпак_ВысЗнач";
	КонецЕсли;	
	
	мтдНоменклатура = Неопределено;
	ПолеЗапросаНоменклатура = ПолеЗапроса(мтдТовары, ПолеНоменклатура());
	ТипРеквизитаНоменклатура = ТипРеквизитаОбъекта(мтдТовары, ПолеНоменклатура());
	Если ТипРеквизитаНоменклатура <> Неопределено Тогда
		мтдНоменклатура = Метаданные.НайтиПоТипу(ТипРеквизитаНоменклатура);
	КонецЕсли;
	
	мтдЕдиницаИзмерения = Неопределено;
	ПолеЗапросаЕдиницаИзмерения = ПолеЗапроса(мтдТовары, ПолеЕдиницаИзмерения());
	ТипРеквизитаЕдиницаИзмерения = ТипРеквизитаОбъекта(мтдТовары, ПолеЕдиницаИзмерения());
	Если ТипРеквизитаЕдиницаИзмерения <> Неопределено Тогда
		мтдЕдиницаИзмерения = Метаданные.НайтиПоТипу(ТипРеквизитаЕдиницаИзмерения);
	КонецЕсли;
	
	ЕстьГабариты = Ложь;
	Если  ПолеЗапросаЕдиницаИзмерения <> "НЕОПРЕДЕЛЕНО"
		И ПолеЗапросаНоменклатура <> "НЕОПРЕДЕЛЕНО"
		И РасчетГабаритовУТ11() Тогда // УТ11
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ТекстЗапросаДлинаУпаковки(ПолеЗапросаЕдиницаИзмерения, ПолеЗапросаНоменклатура) + " КАК " + ПсевдонимДлина;
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ТекстЗапросаШиринаУпаковки(ПолеЗапросаЕдиницаИзмерения, ПолеЗапросаНоменклатура) + " КАК " + ПсевдонимШирина;
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ТекстЗапросаВысотаУпаковки(ПолеЗапросаЕдиницаИзмерения, ПолеЗапросаНоменклатура) + " КАК " + ПсевдонимВысота;
		ЕстьГабариты = Истина;
	ИначеЕсли ПолеЗапросаНоменклатура <> "НЕОПРЕДЕЛЕНО"
		И РасчетГабаритовУНФ(мтдНоменклатура) Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ПолеЗапросаНоменклатура + ".Длина / 100 КАК " + ПсевдонимДлина;
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ПолеЗапросаНоменклатура + ".Ширина / 100 КАК " + ПсевдонимШирина;
		ТекстЗапроса = ТекстЗапроса + ",
		|" + ПолеЗапросаНоменклатура + ".Высота / 100 КАК " + ПсевдонимВысота;
		ЕстьГабариты = Истина;
	КонецЕсли;

	Если Не ЕстьГабариты Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|0 КАК " + ПсевдонимДлина + ",
		|0 КАК " + ПсевдонимШирина + ",
		|0 КАК " + ПсевдонимВысота;
	КонецЕсли;

	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВесУпаковки(ИсточникУпаковки, ИсточникНоменклатуры, ВесУпаковкиВЕдиницеКонстанты = Истина) 
	
	Если ИсточникНоменклатуры = Неопределено Тогда 
		
		ТекстЗапроса = 
		"ВЫРАЗИТЬ(ЕСТЬNULL(ТаблицаТовары.Упаковка.Вес, 0) 
		|	* ВЫРАЗИТЬ(ЕСТЬNULL(ТаблицаТовары.Упаковка.ВесЕдиницаИзмерения.Числитель, 0) / ЕСТЬNULL(ТаблицаТовары.Упаковка.ВесЕдиницаИзмерения.Знаменатель, 1) КАК ЧИСЛО(27, 11)) 
		|	/ ВЫРАЗИТЬ(&КоличествоКгВЕдиницеИзмеренияВеса КАК ЧИСЛО(27, 11)) КАК ЧИСЛО(27, 11))";
		
	Иначе		
		
		ТекстЗапроса = 
		"ВЫРАЗИТЬ(ВЫБОР
		|			КОГДА ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Вес)
		|					И ТаблицаТовары.Номенклатура.ВесИспользовать
		|					И ЕСТЬNULL(ТаблицаТовары.Упаковка.Знаменатель, 0) <> 0
		|				ТОГДА ВЫРАЗИТЬ(ТаблицаТовары.Упаковка.Числитель / ТаблицаТовары.Упаковка.Знаменатель КАК ЧИСЛО(27, 11))
		|			КОГДА ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Объем)
		|					И ТаблицаТовары.Номенклатура.ВесИспользовать
		|					И ЕСТЬNULL(ТаблицаТовары.Упаковка.Знаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ОбъемЕдиницаИзмерения.Числитель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ОбъемЧислитель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ОбъемЗнаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЗнаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Знаменатель, 0) <> 0
		|				ТОГДА ВЫРАЗИТЬ((ВЫРАЗИТЬ((ВЫРАЗИТЬ(ТаблицаТовары.Упаковка.Числитель / ТаблицаТовары.Упаковка.Знаменатель КАК ЧИСЛО(27, 11))) 
		|						/ (ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.ОбъемЕдиницаИзмерения.Числитель / ТаблицаТовары.Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель КАК ЧИСЛО(27, 11))) КАК ЧИСЛО(27, 11))) 
		|						/ (ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.ОбъемЧислитель / ТаблицаТовары.Номенклатура.ОбъемЗнаменатель КАК ЧИСЛО(27, 11))) 
