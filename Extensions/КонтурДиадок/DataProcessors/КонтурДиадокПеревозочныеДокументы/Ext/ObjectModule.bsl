	КонецЕсли;
		
	ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдресаИТочкиДоставки(Результат.СвГруз.СвГП);
	Если ДанныеКонтактнаяИнформацияАдреса.Количество() > 0 Тогда
		ДанныеАдреса = ДанныеКонтактнаяИнформацияАдреса[0];               
		УстановитьЗначениеСвойстваПоУмолчанию(Результат, НеОбработанные, "СвГруз.АдрПунктНазн.Адрес.АдрИнф.АдрТекст", ДанныеАдреса.Адрес); 
