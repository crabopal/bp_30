КонецФункции

Функция ПолучитьЗначениеСведения(ОбъектДанных, ИмяСведения, ВернутьСтроку) Экспорт
	
	Сведение = ПолучитьСведениеПоИмени(ИмяСведения);
	ТекОтбор = Новый Структура("Объект, Свойство", ОбъектДанных, Сведение);	
	ИмяРегистраДополнительныеСвойства = ИмяРегистраДополнительныеСвойства();	
	Значение = РегистрыСведений[ИмяРегистраДополнительныеСвойства].Получить(ТекОтбор).Значение;
	
	//{ ааа5
	ИмяСправочникаДополнительныеСвойства = ИмяСправочникаДополнительныеСвойства();
	Если ТипЗнч(Значение) = Тип("СправочникСсылка." + ИмяСправочникаДополнительныеСвойства) И ВернутьСтроку Тогда
	//} ааа5
		ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов = ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов();
		Если ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов Тогда
			Результат = Значение.ПолноеНаименование;                 
		Иначе
			Результат = ВосстановитьЗначениеСвойствоОбъекта(Значение);
		КонецЕсли;
	Иначе
		Результат = Значение;
	КонецЕсли;
	
	Возврат ?(ЗначениеЗаполнено(Результат), Результат, Неопределено);
	
КонецФункции

Процедура УстановитьЗначениеСведения(ОбъектДанных, ИмяСведения, Значение, СоздатьСправочник)
		
	Если ЗначениеЗаполнено(ОбъектДанных) Тогда
		
		Сведение = ПолучитьСведениеПоИмени(ИмяСведения);
		
		ИмяРегистраДополнительныеСвойства = ИмяРегистраДополнительныеСвойства();	
		
		Если СоздатьСправочник Тогда
			
			ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов = ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов();
			
			УИД = Строка(ОбъектДанных.УникальныйИдентификатор());
			
			УстановитьПривилегированныйРежим(Истина);
			
			//{ ааа5                       
			ИмяСправочникаДополнительныеСвойства = ИмяСправочникаДополнительныеСвойства();
			НашлиСпр = Справочники[ИмяСправочникаДополнительныеСвойства].НайтиПоНаименованию(УИД, Истина, , Сведение);
			Если НашлиСпр.Пустая() Тогда
				ОбъектСпр = Справочники[ИмяСправочникаДополнительныеСвойства].СоздатьЭлемент();
			//} ааа5
			Иначе
				ОбъектСпр = НашлиСпр.ПолучитьОбъект();
			КонецЕсли;
			ОбъектСпр.Наименование = УИД;
			Если ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов Тогда
				ОбъектСпр.ПолноеНаименование = Значение;
			КонецЕсли;
			ОбъектСпр.Владелец = Сведение;
			ОбъектСпр.Записать();
			
			Если Не ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов Тогда
				ЗаписатьЗначениеСвойствоОбъекта(ОбъектСпр.Ссылка, Значение);
			КонецЕсли;
			
			Если ПривилегированныйРежим() Тогда
				УстановитьПривилегированныйРежим(Ложь);
			КонецЕсли;
			
			Значение = ОбъектСпр.Ссылка;
			
		КонецЕсли;
		
		Попытка       
			
			НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
						
			УстановитьПривилегированныйРежим(Истина);
			
			МенеджерЗаписи = РегистрыСведений[ИмяРегистраДополнительныеСвойства].СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Объект = ОбъектДанных;
			МенеджерЗаписи.Свойство = Сведение;
			МенеджерЗаписи.Значение = Значение;    
			Если Значение = Неопределено Тогда
				МенеджерЗаписи.Удалить();
			Иначе
				МенеджерЗаписи.Записать();
			КонецЕсли;
			
			Если ПривилегированныйРежим() Тогда
				УстановитьПривилегированныйРежим(Ложь);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();  
			
		Исключение               
			
			ОтменитьТранзакцию(); 
			
		КонецПопытки; 
		
	КонецЕсли;          
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитПоИмениСПроверкой(Объект1С, ИмяРеквизита, Значение, РеквизитИзменен = ложь)
	
	Если Объект1С.Метаданные().Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		
		Если Объект1С[ИмяРеквизита] <> Значение Тогда
			Объект1С[ИмяРеквизита] = Значение;
			РеквизитИзменен = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Удалить(КлючИдентификатораЭПД, ИдентификаторЭПД) Экспорт

	Документы1С = ДокументыОснования(КлючИдентификатораЭПД, ИдентификаторЭПД);
	Для Каждого Документ1С Из Документы1С Цикл
		УстановитьЗначениеСведения(Документ1С, КлючИдентификатораЭПД, Неопределено, Ложь);	
	КонецЦикла; 
	
	// todo: очистить сведения по ИдентификаторЭПД
	
	ОбъектИдентификаторЭПД = ИдентификаторЭПД.ПолучитьОбъект();
	ОбъектИдентификаторЭПД.УстановитьПометкуУдаления(Истина);
	
КонецПроцедуры

Процедура СохранитьДокументыОснования(КлючИдентификатораЭПД, ИдентификаторЭПД, ДокументыОснования) Экспорт 
		
	Документы1С = ДокументыОснования(КлючИдентификатораЭПД, ИдентификаторЭПД);
	Для Каждого Документ1С Из Документы1С Цикл
		УстановитьЗначениеСведения(Документ1С, КлючИдентификатораЭПД, Неопределено, Ложь);
	КонецЦикла;
	Для Каждого ДокументОснование Из ДокументыОснования Цикл
		УстановитьЗначениеСведения(ДокументОснование, КлючИдентификатораЭПД, ИдентификаторЭПД, Ложь);	
	КонецЦикла;
	
КонецПроцедуры

