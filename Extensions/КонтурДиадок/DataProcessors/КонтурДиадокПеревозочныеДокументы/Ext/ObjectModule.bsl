
Перем ФабрикаXDTOНакладной Экспорт;
Перем ФорматXDTOНакладной Экспорт;

Перем _Ядро Экспорт;

//****************************************************************************
//{		ИНИЦИАЛИЗАЦИЯ

Процедура ИнициализироватьМодуль(Модуль_Ядро = Неопределено) Экспорт
	
	Если _Ядро = Неопределено Тогда
		Если Модуль_Ядро = Неопределено Тогда
			_Ядро = Модуль_Ядро();               
		Иначе
			_Ядро = Модуль_Ядро;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗавершениеРаботыМодуля() Экспорт
	
	_Ядро = Неопределено;
	
КонецПроцедуры

//}		ИНИЦИАЛИЗАЦИЯ


//{		ЯДРО

Функция Модуль_Ядро() Экспорт
			
	Если _Ядро = Неопределено Тогда
		АдресОбработкиЯдра = СвойствоСтруктуры(ОбщийКонтекстКлиентСервер, "АдресОбработкиЯдра");
		Если ЗначениеЗаполнено(АдресОбработкиЯдра) Тогда
			_Ядро = ХранилищеОбработки_Прочитать(АдресОбработкиЯдра);
		КонецЕсли;
	КонецЕсли;
	
	Если _Ядро = Неопределено Тогда
		_Ядро = ОбработкаМодуляЯдра();
		Если _Ядро <> Неопределено Тогда
			ХранилищеОбработки_Поместить(_Ядро, АдресОбработкиЯдра);
			_Ядро.УстановитьОбщийКонтекст(ОбщийКонтекстКлиентСервер);
		КонецЕсли;
	КонецЕсли;
	
	Если _Ядро = Неопределено Тогда
		// метрика	 	
	КонецЕсли;
	
	Возврат _Ядро;
	
КонецФункции

Функция ХранилищеОбработки_Прочитать(АдресОбработки)
	
	СтруктураОбработки = ПолучитьИзВременногоХранилища(АдресОбработки);
	
	Результат = СвойствоСтруктуры(СтруктураОбработки, "ОбработкаОбъект");
	
	Возврат Результат;
	
КонецФункции

Процедура ХранилищеОбработки_Поместить(Обработка, АдресОбработки)
	
	СтруктураОбработки = Новый Структура("ОбработкаОбъект", Обработка);
	
	ПоместитьВоВременноеХранилище(СтруктураОбработки, АдресОбработки);
	
КонецПроцедуры

Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено)
	
	Перем Значение;
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ЭтоСтруктура(Структура) И ЗначениеЗаполнено(Ключ) Тогда
		
		Если Структура.Свойство(Ключ, Значение) Тогда
			Результат = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция ЭтоСтруктура(Значение)
	
	Результат = Ложь;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбработкаМодуляЯдра()
	
	ИмяОбработки = "DataProcessorObject.КонтурДиадокЯдро";
	Если ЭтоВнешняяОбработка() Тогда
		ИмяОбработки = "ExternalDataProcessorObject.КонтурДиадокЯдро";
	КонецЕсли;
	
	Если ТипОпределен(ИмяОбработки) Тогда
		Результат = Новый(ИмяОбработки);
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоВнешняяобработка()
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
	ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
	
	Возврат ПараметрыПроверки.ИспользуемоеИмяФайла <> Неопределено;
	
КонецФункции

Функция ТипОпределен(ИмяТипа)
	
	Попытка
		Тип = Тип(ИмяТипа);
	Исключение
		Тип = Тип("Неопределено");
	КонецПопытки;
	
	Результат = (Тип <> Тип("Неопределено"));
	
	Возврат Результат;
	
КонецФункции

//}		ЯДРО


// Получает данные о перевозочных тилулах
//
// Параметры:
//  Параметры	 - 	Структура - Содержит параметры для выборки титулов
// 
// Возвращаемое значение:
//   - Массив 
//
Функция ДанныеДляОтправкиТитуловЭТрН(Параметры) Экспорт
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	
	// TODO получать КОРРЕКТНЫЕ данные без НЕЯВНОГО соединения с таблицами:
	// текущий Статус титула (Черновик, Подготовлен, Отправлен)
	// ВидПакетаID (отдельные методы для ID_Перевозочные_ЭТрН и ID_Перевозочные_ЗаказЗаявка)
	// ГО, ПВ, ГП 
	
	//{ ааа5 	
	СвязьРегистровСведений = СвязьРегистровСведений();
	ПрефиксСвойств = ?(СвязьРегистровСведений = "Объект", ПрефиксЭТРН(), "");
	//} ааа5
	
	// выбирается основной документ, либо первый
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СведенияОсновнойДокумент.Значение, ДополнительныеСведения.Объект) КАК Документ,
	|	ДополнительныеСведения." + СвязьРегистровСведений + " КАК ИдентификаторДокумента,
	|	СведенияНомер.Значение КАК НомерДокумента,
	|	ЕстьNull(СведенияДата.Значение, &ТекущаяДата) КАК ДатаДокумента,
	|	СведенияОрганизация.Значение КАК Организация,
	|	СведенияКонтрагент.Значение КАК Контрагент,
	|	СведенияГрузоотправитель.Значение КАК Грузоотправитель,
	|	СведенияПеревозчик.Значение КАК Перевозчик,
	|	СведенияГрузополучатель.Значение КАК Грузополучатель,
	|	СведенияЛОП.Значение КАК ЛОП,
	|	СведенияЗаказчик.Значение КАК Заказчик,
	|	ЕСТЬNULL(СведенияСумма.Значение, 0) КАК СуммаДокумента,
	|	ЕСТЬNULL(СведенияСтатус.Значение, ""Черновик"") КАК Статус,
	|	ЕСТЬNULL(СведенияПризнак.Значение, 0) КАК Признак,
	|	ЕСТЬNULL(СведенияСценарий.Значение, 0) КАК Сценарий,
	|	&ВидПакетаID КАК ВидПакетаID
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	
	// Только те, у которых есть документ основание!
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияОсновнойДокумент
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияОсновнойДокумент.Объект
	|			И (СведенияОсновнойДокумент.Свойство = &Свойство_ОсновнойДокумент)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияНомер
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияНомер.Объект
	|			И (СведенияНомер.Свойство = &Свойство_Номер)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияДата
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияДата.Объект
	|			И (СведенияДата.Свойство = &Свойство_Дата)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияОрганизация
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияОрганизация.Объект
	|			И (СведенияОрганизация.Свойство = &Свойство_Организация)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияГрузоотправитель
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияГрузоотправитель.Объект
	|			И (СведенияГрузоотправитель.Свойство = &Свойство_Грузоотправитель)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияКонтрагент
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияКонтрагент.Объект
	|			И (СведенияКонтрагент.Свойство = &Свойство_Контрагент)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияГрузополучатель
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияГрузополучатель.Объект
	|			И (СведенияГрузополучатель.Свойство = &Свойство_Грузополучатель)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияПеревозчик
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияПеревозчик.Объект
	|			И (СведенияПеревозчик.Свойство = &Свойство_Перевозчик)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияЛОП
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияЛОП.Объект
	|			И (СведенияЛОП.Свойство = &Свойство_ЛОП)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияЗаказчик
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияЗаказчик.Объект
	|			И (СведенияЗаказчик.Свойство = &Свойство_Заказчик)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияСумма
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияСумма.Объект
	|			И (СведенияСумма.Свойство = &Свойство_Сумма)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияСтатус
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияСтатус.Объект
	|			И (СведенияСтатус.Свойство = &Свойство_Статус)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияПризнак
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияПризнак.Объект
	|			И (СведенияПризнак.Свойство = &Свойство_Признак)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияСценарий
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияСценарий.Объект
	|			И (СведенияСценарий.Свойство = &Свойство_Сценарий)
	
	|ГДЕ
	|	ДополнительныеСведения.Свойство = &Свойство_ИдентификаторТрН";
	
	Если Параметры.Свойство(КлючИдентификатораТрН()) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ДополнительныеСведения.Значение = &ИдентификаторТрН";
	Иначе
		Запрос.Текст = Запрос.Текст + "
		|	И ЕстьNull(СведенияДата.Значение, &ТекущаяДата) МЕЖДУ &НачалоПериода И &КонецПериода";
	КонецЕсли;
		
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидПакетаID", """" + ИдентификаторПакетаЭТрН() + """");
	ИмяРегистраДополнительныеСвойства = ИмяРегистраДополнительныеСвойства();	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрСведений.ДополнительныеСведения", "РегистрСведений." + ИмяРегистраДополнительныеСвойства);
	
	// TODO Сделать отдельные обертки для каждого свойства
	Свойство_ИдентификаторТрН = ПолучитьСведениеПоИмени(КлючИдентификатораТрН());
 	Свойство_ОсновнойДокумент = ПолучитьСведениеПоИмени("ОсновнойДокумент" + ПрефиксСвойств);
	Свойство_Номер = ПолучитьСведениеПоИмени("Номер" + ПрефиксСвойств);
	Свойство_Дата = ПолучитьСведениеПоИмени("Дата" + ПрефиксСвойств);
	Свойство_Организация = ПолучитьСведениеПоИмени("Организация" + ПрефиксСвойств);
	Свойство_Грузоотправитель = ПолучитьСведениеПоИмени("Грузоотправитель" + ПрефиксСвойств);
	Свойство_Контрагент = ПолучитьСведениеПоИмени("Контрагент" + ПрефиксСвойств);
	Свойство_Грузополучатель = ПолучитьСведениеПоИмени("Грузополучатель" + ПрефиксСвойств);
	Свойство_Перевозчик = ПолучитьСведениеПоИмени("Перевозчик" + ПрефиксСвойств);
	Свойство_ЛОП = ПолучитьСведениеПоИмени("ЛОП" + ПрефиксСвойств);
	Свойство_Заказчик = ПолучитьСведениеПоИмени("Заказчик" + ПрефиксСвойств);
	Свойство_Сумма = ПолучитьСведениеПоИмени("Сумма" + ПрефиксСвойств);
	Свойство_Статус = ПолучитьСведениеПоИмени("Статус" + ПрефиксСвойств);
	Свойство_Признак = ПолучитьСведениеПоИмени("Признак" + ПрефиксСвойств);
	Свойство_Сценарий = ПолучитьСведениеПоИмени("Сценарий" + ПрефиксСвойств);
	
	Запрос.Параметры.Вставить("Свойство_ИдентификаторТрН", Свойство_ИдентификаторТрН);
	Запрос.Параметры.Вставить("Свойство_ОсновнойДокумент", Свойство_ОсновнойДокумент);
 	Запрос.Параметры.Вставить("Свойство_Номер", Свойство_Номер);
	Запрос.Параметры.Вставить("Свойство_Дата", Свойство_Дата);
 	Запрос.Параметры.Вставить("Свойство_Организация", Свойство_Организация);
	Запрос.Параметры.Вставить("Свойство_Контрагент", Свойство_Контрагент);
	Запрос.Параметры.Вставить("Свойство_Грузоотправитель", Свойство_Грузоотправитель);
	Запрос.Параметры.Вставить("Свойство_Грузополучатель", Свойство_Грузополучатель);
	Запрос.Параметры.Вставить("Свойство_Перевозчик", Свойство_Перевозчик);
	Запрос.Параметры.Вставить("Свойство_ЛОП", Свойство_ЛОП);
	Запрос.Параметры.Вставить("Свойство_Заказчик", Свойство_Заказчик);
	Запрос.Параметры.Вставить("Свойство_Сумма", Свойство_Сумма);
	Запрос.Параметры.Вставить("Свойство_Статус", Свойство_Статус);
	Запрос.Параметры.Вставить("Свойство_Признак", Свойство_Признак);
	Запрос.Параметры.Вставить("Свойство_Сценарий", Свойство_Сценарий);
	Запрос.Параметры.Вставить("ТекущаяДата", НачалоДня(ТекущаяДата()));
	
	//Параметры.РежимОтбораПоПериоду = "ПоДатеОтправкиИлиПолучения"
	Запрос.Параметры.Вставить("НачалоПериода", Параметры.НачалоПериода);
	Запрос.Параметры.Вставить("КонецПериода", Параметры.КонецПериода);
	
	Если Параметры.Свойство(КлючИдентификатораТрН()) Тогда
		Запрос.Параметры.Вставить(КлючИдентификатораТрН(), Параметры.ИдентификаторТрН);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеПеревозочногоДокумента = Контракт_ДанныеПеревозочныхДокументов();
		ЗаполнитьЗначенияСвойств(ДанныеПеревозочногоДокумента, Выборка);

		Если СценарийШаблон(Выборка.Сценарий) Тогда
			ДанныеПеревозочногоДокумента.ВидПакетаID = ИдентификаторПакетаЭТрН_Шаблон();	
		КонецЕсли;
		
		ДокументXML = ПолучитьЗначениеСведения(Выборка.ИдентификаторДокумента, "ОсновнойДокумент" + ПрефиксСвойств, Истина);
		Если ТипЗнч(ДокументXML) = Тип("Строка") Тогда
			ДанныеПеревозочногоДокумента.Документ = ДесериализоватьXML(ДокументXML);
		КонецЕсли;
		
		Если ТипЗнч(ДанныеПеревозочногоДокумента.Документ) = Тип("Строка")
			Или ТипЗнч(ДанныеПеревозочногоДокумента.Документ) = Тип("Структура") Тогда
			ДанныеПеревозочногоДокумента.Документ = Выборка.ИдентификаторДокумента;
		КонецЕсли;
		
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Организация");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Грузоотправитель");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Грузополучатель");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Перевозчик");
		
		Если Выборка.Признак = Истина Тогда 

		Иначе
			ДанныеТрН = Новый Структура;
			НеОбработанные = СтруктураТрН();
			ЗаполнитьПоДополнительнымСведениям(ДанныеТрН, НеОбработанные, Выборка.ИдентификаторДокумента, КлючРеквизитовТрН());
			ПараметрыТрН = ПараметрыТрН(Неопределено, Неопределено, ДанныеТрН);
			ЗаполнитьЗначенияСвойств(ДанныеПеревозочногоДокумента, ПараметрыТрН, "Организация, Контрагент, Грузоотправитель, Перевозчик, Грузополучатель, ЛОП, Заказчик");
		КонецЕсли;
		
		Результат.Вставить(ДанныеПеревозочногоДокумента.Документ, ДанныеПеревозочногоДокумента);
		
	КонецЦикла;

	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеДляОтправкиТитуловЗаказЗаявка(Параметры) Экспорт
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	
	// TODO получать КОРРЕКТНЫЕ данные без НЕЯВНОГО соединения с таблицами:
	// текущий Статус титула (Черновик, Подготовлен, Отправлен)
	// ВидПакетаID (отдельные методы для ID_Перевозочные_ЭТрН и ID_Перевозочные_ЗаказЗаявка)
	// ГО, ПВ, ГП

	//{ ааа5 	
	СвязьРегистровСведений = СвязьРегистровСведений();
	ПрефиксСвойств = ?(СвязьРегистровСведений = "Объект", ПрефиксЭЗЗ(), "");
	//} ааа5
	
	// выбирается основной документ, либо первый
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СведенияОсновнойДокумент.Значение, ДополнительныеСведения.Объект) КАК Документ,
	|	ДополнительныеСведения." + СвязьРегистровСведений + " КАК ИдентификаторДокумента,
	|	СведенияНомер.Значение КАК НомерДокумента,
	|	ЕстьNull(СведенияДата.Значение, &ТекущаяДата) КАК ДатаДокумента,
	|	СведенияОрганизация.Значение КАК Организация,
	|	СведенияКонтрагент.Значение КАК Контрагент,
	|	СведенияГрузоотправитель.Значение КАК Грузоотправитель,
	|	СведенияПеревозчик.Значение КАК Перевозчик,
	|	СведенияГрузополучатель.Значение КАК Грузополучатель,
	|	СведенияЛОП.Значение КАК ЛОП,
	|	СведенияЗаказчик.Значение КАК Заказчик,
	|	ЕСТЬNULL(СведенияСумма.Значение, 0) КАК СуммаДокумента,
	|	ЕСТЬNULL(СведенияСтатус.Значение, ""Черновик"") КАК Статус,
	|	ЕСТЬNULL(СведенияПризнак.Значение, 0) КАК Признак,
	|	&ВидПакетаID КАК ВидПакетаID
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения

	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияОсновнойДокумент
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияОсновнойДокумент.Объект
	|			И (СведенияОсновнойДокумент.Свойство = &Свойство_ОсновнойДокумент)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияНомер
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияНомер.Объект
	|			И (СведенияНомер.Свойство = &Свойство_Номер)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияДата
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияДата.Объект
	|			И (СведенияДата.Свойство = &Свойство_Дата)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияОрганизация
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияОрганизация.Объект
	|			И (СведенияОрганизация.Свойство = &Свойство_Организация)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияГрузоотправитель
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияГрузоотправитель.Объект
	|			И (СведенияГрузоотправитель.Свойство = &Свойство_Грузоотправитель)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияКонтрагент
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияКонтрагент.Объект
	|			И (СведенияКонтрагент.Свойство = &Свойство_Контрагент)
	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияГрузополучатель
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияГрузополучатель.Объект
	|			И (СведенияГрузополучатель.Свойство = &Свойство_Грузополучатель)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияПеревозчик
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияПеревозчик.Объект
	|			И (СведенияПеревозчик.Свойство = &Свойство_Перевозчик)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияЛОП
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияЛОП.Объект
	|			И (СведенияЛОП.Свойство = &Свойство_ЛОП)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияЗаказчик
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияЗаказчик.Объект
	|			И (СведенияЗаказчик.Свойство = &Свойство_Заказчик)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияСумма
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияСумма.Объект
	|			И (СведенияСумма.Свойство = &Свойство_Сумма)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияСтатус
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияСтатус.Объект
	|			И (СведенияСтатус.Свойство = &Свойство_Статус)

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СведенияПризнак
	|		ПО ДополнительныеСведения." + СвязьРегистровСведений + " = СведенияПризнак.Объект
	|			И (СведенияПризнак.Свойство = &Свойство_Признак)

	|ГДЕ
	|	ДополнительныеСведения.Свойство = &Свойство_ИдентификаторЗЗ";
	
	Если Параметры.Свойство(КлючИдентификатораЗЗ()) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ДополнительныеСведения.Значение = &ИдентификаторЗЗ";
	Иначе
		Запрос.Текст = Запрос.Текст + "
		|	И ЕстьNull(СведенияДата.Значение, &ТекущаяДата) МЕЖДУ &НачалоПериода И &КонецПериода";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидПакетаID", """" + ИдентификаторПакетаЗаказЗаявка() + """");
	ИмяРегистраДополнительныеСвойства = ИмяРегистраДополнительныеСвойства();	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрСведений.ДополнительныеСведения", "РегистрСведений." + ИмяРегистраДополнительныеСвойства);
	
	// TODO Сделать отдельные обертки для каждого свойства
	Свойство_ИдентификаторЗЗ = ПолучитьСведениеПоИмени(КлючИдентификатораЗЗ());
	Свойство_ОсновнойДокумент = ПолучитьСведениеПоИмени("ОсновнойДокумент" + ПрефиксСвойств);
	Свойство_Номер = ПолучитьСведениеПоИмени("Номер" + ПрефиксСвойств);
	Свойство_Дата = ПолучитьСведениеПоИмени("Дата" + ПрефиксСвойств);
	Свойство_Организация = ПолучитьСведениеПоИмени("Организация" + ПрефиксСвойств);
	Свойство_Грузоотправитель = ПолучитьСведениеПоИмени("Грузоотправитель" + ПрефиксСвойств);
	Свойство_Контрагент = ПолучитьСведениеПоИмени("Контрагент" + ПрефиксСвойств);
	Свойство_Грузополучатель = ПолучитьСведениеПоИмени("Грузополучатель" + ПрефиксСвойств);
	Свойство_Перевозчик = ПолучитьСведениеПоИмени("Перевозчик" + ПрефиксСвойств);
	Свойство_ЛОП = ПолучитьСведениеПоИмени("ЛОП" + ПрефиксСвойств);
	Свойство_Заказчик = ПолучитьСведениеПоИмени("Заказчик" + ПрефиксСвойств);
	Свойство_Сумма = ПолучитьСведениеПоИмени("Сумма" + ПрефиксСвойств);
	Свойство_Статус = ПолучитьСведениеПоИмени("Статус" + ПрефиксСвойств);
	Свойство_Признак = ПолучитьСведениеПоИмени("Признак" + ПрефиксСвойств);
	
	Запрос.Параметры.Вставить("Свойство_ИдентификаторЗЗ", Свойство_ИдентификаторЗЗ);
	Запрос.Параметры.Вставить("Свойство_ОсновнойДокумент", Свойство_ОсновнойДокумент);
	Запрос.Параметры.Вставить("Свойство_Номер", Свойство_Номер);
	Запрос.Параметры.Вставить("Свойство_Дата", Свойство_Дата);
	Запрос.Параметры.Вставить("Свойство_Организация", Свойство_Организация);
	Запрос.Параметры.Вставить("Свойство_Контрагент", Свойство_Контрагент);
	Запрос.Параметры.Вставить("Свойство_Грузоотправитель", Свойство_Грузоотправитель);
	Запрос.Параметры.Вставить("Свойство_Грузополучатель", Свойство_Грузополучатель);
	Запрос.Параметры.Вставить("Свойство_Перевозчик", Свойство_Перевозчик);
	Запрос.Параметры.Вставить("Свойство_ЛОП", Свойство_ЛОП);
	Запрос.Параметры.Вставить("Свойство_Заказчик", Свойство_Заказчик);	
	Запрос.Параметры.Вставить("Свойство_Сумма", Свойство_Сумма);
	Запрос.Параметры.Вставить("Свойство_Статус", Свойство_Статус);
	Запрос.Параметры.Вставить("Свойство_Признак", Свойство_Признак);
	Запрос.Параметры.Вставить("ТекущаяДата", НачалоДня(ТекущаяДата()));
	
	//Параметры.РежимОтбораПоПериоду = "ПоДатеОтправкиИлиПолучения"
	Запрос.Параметры.Вставить("НачалоПериода", Параметры.НачалоПериода);
	Запрос.Параметры.Вставить("КонецПериода", Параметры.КонецПериода);
	
	Если Параметры.Свойство(КлючИдентификатораЗЗ()) Тогда
		Запрос.Параметры.Вставить(КлючИдентификатораЗЗ(), Параметры.ИдентификаторЗЗ);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеПеревозочногоДокумента = Контракт_ДанныеПеревозочныхДокументов();
		ЗаполнитьЗначенияСвойств(ДанныеПеревозочногоДокумента, Выборка);
		ДанныеПеревозочногоДокумента.Грузополучатель = Неопределено;
		
		ДокументXML = ПолучитьЗначениеСведения(Выборка.ИдентификаторДокумента, "ОсновнойДокумент" + ПрефиксСвойств, Истина);

		Если ТипЗнч(ДокументXML) = Тип("Строка") Тогда
			ДанныеПеревозочногоДокумента.Документ = ДесериализоватьXML(ДокументXML);
		КонецЕсли;
		
		Если ТипЗнч(ДанныеПеревозочногоДокумента.Документ) = Тип("Строка")
			Или ТипЗнч(ДанныеПеревозочногоДокумента.Документ) = Тип("Структура") Тогда
			ДанныеПеревозочногоДокумента.Документ = Выборка.ИдентификаторДокумента;
		КонецЕсли;

		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Организация");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Грузоотправитель");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Грузополучатель");
		ПреобразоватьВариантСтрокой(ДанныеПеревозочногоДокумента, Выборка, "Перевозчик");
		
		Если Выборка.Признак = Истина Тогда 

		Иначе
			ДанныеЗЗ = Новый Структура;
			НеОбработанные = СтруктураЗЗ();
			ЗаполнитьПоДополнительнымСведениям(ДанныеЗЗ, НеОбработанные, Выборка.ИдентификаторДокумента, КлючРеквизитовЗЗ());
			ПараметрыЗЗ = ПараметрыЗЗ(Неопределено, Неопределено, ДанныеЗЗ);
			ЗаполнитьЗначенияСвойств(ДанныеПеревозочногоДокумента, ПараметрыЗЗ, "Организация, Контрагент, Грузоотправитель, Перевозчик, Грузополучатель, ЛОП, Заказчик");
		КонецЕсли;

		Результат.Вставить(ДанныеПеревозочногоДокумента.Документ, ДанныеПеревозочногоДокумента);
		
	КонецЦикла;

	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеДляОтправкиТитуловЭПЭ(Параметры) Экспорт
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	
