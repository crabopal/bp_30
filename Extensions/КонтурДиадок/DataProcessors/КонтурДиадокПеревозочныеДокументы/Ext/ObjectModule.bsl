Функция СписокВыбораВидТС()
	
	СписокВыбора = Новый Соответствие;

	Макет = ПолучитьМакет("ЗначенияВидТС");
		
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		НаименованиеЗначения  = СокрЛП(Макет.Область(НомерСтроки, 1).Текст);
		КодЗначения  = СокрЛП(Макет.Область(НомерСтроки, 2).Текст);
		
		Если Не ЗначениеЗаполнено(НаименованиеЗначения) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбора.Вставить(НаименованиеЗначения, КодЗначения);
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

