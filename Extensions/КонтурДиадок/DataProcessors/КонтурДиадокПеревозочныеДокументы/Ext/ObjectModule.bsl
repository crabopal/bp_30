Процедура ЗаполнитьXDTO_Наблюдатели_ЭПД(СписокXDTO, ТрНСтруктура)
	
	ИдПолИной = ЗначениеСтруктурыПоКлючу(ТрНСтруктура, "ИдПолИной");
	Если ТипЗнч(ИдПолИной) = Тип("Массив") Тогда
		Для Каждого ЗначениеИдПолИной Из ИдПолИной Цикл
			ИдентификаторыИдПолИной = ИдентификаторыЭДО(ЗначениеИдПолИной.Ссылка, Ложь);
			ID = ИдентификаторыИдПолИной.ID; 
			Если ЗначениеЗаполнено(ID) Тогда
				XDTO_ДобавитьСтрокуВСписок(СписокXDTO, ID);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПреобразоватьИдПолИной(Результат)

	ИдПолИной = ЗначениеСтруктурыПоКлючу(Результат, "ИдПолИной", Новый Массив);
	Если ЗначениеЗаполнено(ИдПолИной)
		И ТипЗнч(ИдПолИной) <> Тип("Массив")Тогда
		СписокИдПолИной = Новый Массив;
		СписокИдПолИной.Добавить(ИдПолИной);
		УстановитьЗначениеСтруктурыПоКлючу(Результат, "ИдПолИной", СписокИдПолИной);
	КонецЕсли;
	
КонецПроцедуры

