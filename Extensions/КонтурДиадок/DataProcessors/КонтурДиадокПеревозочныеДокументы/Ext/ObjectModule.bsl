Функция Контракт_ИдентификаторыЭДО()
	
	Результат = Новый Структура;
	
	Результат.Вставить("BoxId", "");
	Результат.Вставить("ID", "");
	Результат.Вставить("ОператорЭДО", "");
	Результат.Вставить("ЭтоСопоставлениеЭПД", Ложь);
	Результат.Вставить("ТекстОшибки", "");

	Возврат Результат;
	
КонецФункции

Функция ИдентификаторыЭДО_Организация(Участник)
	
	Результат = Неопределено;
	
	BoxId = _Ядро.Организации_ИдентификаторПоСсылке(Участник);
	
	Если ЗначениеЗаполнено(BoxId) Тогда
		
		Результат = Контракт_ИдентификаторыЭДО();
		
		Идентификаторы = _Ядро.Новый_ИдентификаторыСправочника(Неопределено, BoxId);
		Реквизиты = _Ядро.Организации_ЗаполненныеРеквизиты(Идентификаторы);
		ID = Реквизиты.ИдентификаторУчастникаЭДО;
		Результат.Вставить("ID", ID);
		Результат.Вставить("BoxId", BoxId);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторыЭДО_Контрагент(Участник)
	
	Результат = Неопределено;
	
	BoxId = _Ядро.Контрагенты_ИдентификаторПоСсылке(Участник);
	
	Если ЗначениеЗаполнено(BoxId) Тогда
		
		Результат = Контракт_ИдентификаторыЭДО();
		
		Идентификаторы = _Ядро.Новый_ИдентификаторыСправочника(Неопределено, BoxId);
		Реквизиты = _Ядро.Контрагенты_ЗаполненныеРеквизиты(Идентификаторы);
		ID = Реквизиты.ИдентификаторУчастникаЭДО;
		Результат.Вставить("ID", ID);
		Результат.Вставить("BoxId", BoxId);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторыЭДО(Участник, ОтправительДокумента, Организация = Неопределено) Экспорт
	
	Результат = Контракт_ИдентификаторыЭДО();
	
	Если Не ЗначениеЗаполнено(Участник) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстИсключения = "";
	Если ОтправительДокумента Тогда
		
		Попытка
			ИдентификаторыЭДО = ИдентификаторыЭДО_Организация(Участник);
		Исключение
			ТекстИсключения = ТекстИсключения + СтрШаблонЛок("Участник: %1;
			|Тип: %2;
			|Метод: %3;
			|Ошибка: %4",
			Участник,
			ТипЗнч(Участник),
			"ЭДО_Организация",
			ОписаниеОшибки());	
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ИдентификаторыЭДО) Тогда
			Результат = ИдентификаторыЭДО;
		Иначе
			
			Попытка
				ИдентификаторыЭДО = ИдентификаторыЭДО_Контрагент(Участник);
			Исключение
				ТекстИсключения = СтрШаблонЛок("Участник: %1;
				|Тип: %2;
				|Метод: %3;
				|Ошибка: %4",
				Участник,
				ТипЗнч(Участник),
				"ЭДО_Контрагент",
				ОписаниеОшибки());
			КонецПопытки;
			Если ЗначениеЗаполнено(ИдентификаторыЭДО) Тогда
				Результат = ИдентификаторыЭДО;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Попытка
			ИдентификаторыЭДО = ИдентификаторыЭДО_Контрагент(Участник);
		Исключение
			ТекстИсключения = СтрШаблонЛок("Участник: %1;
			|Тип: %2;
			|Метод: %3;
			|Ошибка: %4",
			Участник,
			ТипЗнч(Участник),
			"ЭДО_Контрагент",
			ОписаниеОшибки());
		КонецПопытки;
		Если ЗначениеЗаполнено(ИдентификаторыЭДО) Тогда
			Результат = ИдентификаторыЭДО;
		Иначе
			
			Попытка
				ИдентификаторыЭДО = ИдентификаторыЭДО_Организация(Участник);
			Исключение
				ТекстИсключения = СтрШаблонЛок("Участник: %1;
				|Тип: %2;
				|Метод: %3;
				|Ошибка: %4",
				Участник,
				ТипЗнч(Участник),
				"ЭДО_Организация",
				ОписаниеОшибки());	
			КонецПопытки;
			Если ЗначениеЗаполнено(ИдентификаторыЭДО) Тогда
				Результат = ИдентификаторыЭДО;
				
				BoxId_Организации = ИдентификаторыЭДО.BoxID;
				СоздатьСопоставлениеУчастникаВКонтрагентахДиадок(Участник, BoxId_Организации);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		
		Если ЗначениеЗаполнено(Результат.ID)
			И ЗначениеЗаполнено(Организация) Тогда
			
			BoxIdОрг = _Ядро.Организации_ИдентификаторПоСсылке(Организация);
			ИдентификаторФНСОператора = _Ядро.ИдентификаторФНСИзИдентификаторУчастникаЭДО(Результат.ID);
			ОператорЭДО = _Ядро.ПредставлениеОператораЭДО(ИдентификаторФНСОператора, BoxIdОрг);
			Результат.Вставить("ОператорЭДО", ОператорЭДО);
			
		КонецЕсли;
		
	Исключение
		
		//Результат.Вставить("ТекстОшибки", СтрШаблонЛок("Участник: %1; Тип: %2; Метод: %3; Ошибка: %4", Участник, ТипЗнч(Участник), "ОператорЭДО", ОписаниеОшибки()));	
		
	КонецПопытки;
	
	//данные по ЭПД
	Попытка
		
		BoxId_ЭПД = ПолучитьСопоставлениеЭПД(Участник);
		
		Если ЗначениеЗаполнено(BoxId_ЭПД) Тогда
			
			Реквизиты = _Ядро.Контрагенты_РеквизитыКонтрагента_АПИ(BoxId_ЭПД);
			ID_ЭПД = Реквизиты.ИдентификаторУчастникаЭДО;
			Результат.Вставить("ID", ID_ЭПД);
			Результат.Вставить("BoxId", BoxId_ЭПД);
			
			Если ЗначениеЗаполнено(Результат.ID)
				И ЗначениеЗаполнено(Организация) Тогда
				
				BoxIdОрг = _Ядро.Организации_ИдентификаторПоСсылке(Организация);
				ИдентификаторФНСОператора = _Ядро.ИдентификаторФНСИзИдентификаторУчастникаЭДО(Результат.ID);
				ОператорЭДО = _Ядро.ПредставлениеОператораЭДО(ИдентификаторФНСОператора, BoxIdОрг);
				Результат.Вставить("ОператорЭДО", ОператорЭДО);
				
			КонецЕсли;
			
			Результат.Вставить("ЭтоСопоставлениеЭПД", Истина);
			
		КонецЕсли;
		
	Исключение
		
		//Результат.Вставить("ТекстОшибки", СтрШаблонЛок("Участник: %1; Тип: %2; Метод: %3; Ошибка: %4", Участник, ТипЗнч(Участник), "ОператорЭДО", ОписаниеОшибки()));	
		
	КонецПопытки;
	
	Если ТекстИсключения <> "" 
		И Не ЗначениеЗаполнено(Результат.ID) Тогда
		//ВызватьИсключение ТекстИсключения;
		Результат.Вставить("ТекстОшибки", ТекстИсключения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СоздатьСопоставлениеУчастникаВКонтрагентахДиадок(УчастникУчетнойСистемы, BoxId_Организации)
	
	ИдентификаторыОрганизации = _Ядро.Новый_ИдентификаторыСправочника(, BoxId_Организации);
	КонтрагентЭДО = _Ядро.Контрагенты_ЗаполненныеРеквизиты(ИдентификаторыОрганизации);
	ИдентификаторыКонтрагента = _Ядро.Новый_ИдентификаторыСправочника(КонтрагентЭДО.Ссылка, КонтрагентЭДО.ID);
	
	_Ядро.Контрагенты_СопоставитьКонтрагентов(УчастникУчетнойСистемы, ИдентификаторыКонтрагента);
	_Ядро.Контрагенты_ОчиститьКЭШПослеСопоставленияКонтрагента();
	
КонецПроцедуры

Процедура СброситьСопоставлениеЭПД(Участник) Экспорт
	УстановитьЗначениеСведения(Участник, "BoxId_ЭПД", Неопределено, Ложь);
КонецПроцедуры 

Процедура СохранитьСопоставлениеЭПД(Участник, BoxId) Экспорт
	УстановитьЗначениеСведения(Участник, "BoxId_ЭПД", BoxId, Ложь);
КонецПроцедуры

Функция ПолучитьСопоставлениеЭПД(Участник) Экспорт
	Возврат ПолучитьЗначениеСведения(Участник, "BoxId_ЭПД", Ложь);
КонецФункции

