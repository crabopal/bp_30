Функция КопироватьСтруктуру(ИсходнаяСтруктура)
	
	Результат = Новый Структура;
	Для Каждого КлючЗначение Из ИсходнаяСтруктура Цикл
		Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция ЗначениеКорректно(ЛокальныеДанные, ТипВалидации, Значение, ТекстСообщения = "")
	
	Результат = Истина;
	
	Если Не ЗначениеЗаполнено(ТипВалидации) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипВалидации = "ИННФЛ_ИННЮЛ" Тогда
		Если ЗаполненКлючСтруктуры(ЛокальныеДанные, "Ссылка") Тогда
			Если ТипУчастника(ЛокальныеДанные.Ссылка) = "ЮЛ" Тогда
				Результат = ИННСоответствуетТребованиямЛок(Значение, Истина, ТекстСообщения);
			Иначе
				Результат = ИННСоответствуетТребованиямЛок(Значение, Ложь, ТекстСообщения);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипВалидации = "ИННФЛ" Тогда
		Результат = ИННСоответствуетТребованиямЛок(Значение, Ложь, ТекстСообщения);
	ИначеЕсли ТипВалидации = "ИННЮЛ" Тогда
		Результат = ИННСоответствуетТребованиямЛок(Значение, Истина, ТекстСообщения);
	ИначеЕсли ТипВалидации = "КПП" Тогда
		Результат = КППСоответствуетТребованиямЛок(Значение, ТекстСообщения);
	ИначеЕсли ТипВалидации = "НомерВУ" Тогда
		Результат = НомерВУСоответствуетТребованиямЛок(Значение, ТекстСообщения);
	ИначеЕсли ТипВалидации = "СерияВУ" Тогда
		Результат = СерияВУСоответствуетТребованиямЛок(Значение, ТекстСообщения);
	ИначеЕсли ТипВалидации = "НомерСТС" Тогда
		Результат = НомерСТССоответствуетТребованиямЛок(Значение, ТекстСообщения);
	ИначеЕсли ТипВалидации = "VIN" Тогда
		Результат = VINСоответствуетТребованиямЛок(Значение, ТекстСообщения);
	ИначеЕсли ТипВалидации = "КолМестПрием" Тогда
		Результат = КоличествоМестСоответствуетТребованиямЛок(Значение, ТекстСообщения);
	ИначеЕсли ТипВалидации = "КодТовНом" Тогда
		Результат = КодТовНомСоответствуетТребованиямЛок(Значение, 4, 4, ТекстСообщения);
	ИначеЕсли ТипВалидации = "КодТовНомПЭ" Тогда
		Результат = КодТовНомСоответствуетТребованиямЛок(Значение, 4, 10, ТекстСообщения);
	ИначеЕсли ТипВалидации = "Тлф" Тогда
		Результат = ТелСоответствуетТребованиямЛок(Значение, ТекстСообщения);
	ИначеЕсли ТипВалидации = "Контейнер" Тогда
		Результат = ЗначениеКонтейнерЗаполнено(Значение, ЛокальныеДанные, ТекстСообщения);
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ИННСоответствуетТребованиямЛок(Знач ИНН, ЭтоЮридическоеЛицо, ТекстСообщения)

	СоответствуетТребованиям = Истина;

	ИНН      = СокрЛП(ИНН);
	ДлинаИНН = СтрДлина(ИНН);

	Если ЭтоЮридическоеЛицо = Неопределено Тогда
		ТекстСообщения = ТекстСообщения + НСтр("ru = 'Не определен тип владельца ИНН.'");
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ТолькоЦифрыВСтрокеЛок(ИНН) Тогда
		СоответствуетТребованиям = Ложь;
		ТекстСообщения = ТекстСообщения + НСтр("ru = 'ИНН должен состоять только из цифр.'");
	КонецЕсли;

	Если ЭтоЮридическоеЛицо И ДлинаИНН <> 10 Тогда
		СоответствуетТребованиям = Ложь;
		ТекстСообщения = ТекстСообщения + ?(ЗначениеЗаполнено(ТекстСообщения), Символы.ПС, "")
			+ НСтр("ru = 'ИНН юридического лица должен состоять из 10 цифр.'");
	ИначеЕсли НЕ ЭтоЮридическоеЛицо И ДлинаИНН <> 12 Тогда
		СоответствуетТребованиям = Ложь;
		ТекстСообщения = ТекстСообщения + ?(ЗначениеЗаполнено(ТекстСообщения), Символы.ПС, "")
			+ НСтр("ru = 'ИНН физического лица должен состоять из 12 цифр.'");
	КонецЕсли;
		
	Если Лев(ИНН, 2) = "00" Тогда
		СоответствуетТребованиям = Ложь;
		ТекстСообщения = ТекстСообщения + ?(ЗначениеЗаполнено(ТекстСообщения), Символы.ПС, "")
			+ НСтр("ru = 'Первый и второй знаки ИНН не могут одновременно принимать значение ""0"".'");
	КонецЕсли;
		
	Если СоответствуетТребованиям Тогда
		
		Если ЭтоЮридическоеЛицо Тогда

			КонтрольнаяСумма = 0;

			Для Индекс = 1 По 9 Цикл

				Если Индекс = 1 Тогда
					Множитель = 2;
				ИначеЕсли Индекс = 2 Тогда
					Множитель = 4;
				ИначеЕсли Индекс = 3 Тогда
					Множитель = 10;
				ИначеЕсли Индекс = 4 Тогда
					Множитель = 3;
				ИначеЕсли Индекс = 5 Тогда
					Множитель = 5;
				ИначеЕсли Индекс = 6 Тогда
					Множитель = 9;
				ИначеЕсли Индекс = 7 Тогда
					Множитель = 4;
				ИначеЕсли Индекс = 8 Тогда
					Множитель = 6;
				ИначеЕсли Индекс = 9 Тогда
					Множитель = 8;
				КонецЕсли;

				Цифра = Число(Сред(ИНН, Индекс, 1));
				КонтрольнаяСумма = КонтрольнаяСумма + Цифра * Множитель;

			КонецЦикла;
			
			КонтрольныйРазряд = (КонтрольнаяСумма %11) %10;

			Если КонтрольныйРазряд <> Число(Сред(ИНН, 10, 1)) Тогда
				СоответствуетТребованиям = Ложь;
				ТекстСообщения = ТекстСообщения + ?(ЗначениеЗаполнено(ТекстСообщения), Символы.ПС, "")
					+ НСтр("ru = 'Контрольное число для ИНН не совпадает с рассчитанным.'");
			КонецЕсли;

		Иначе

			КонтрольнаяСумма11 = 0;
			КонтрольнаяСумма12 = 0;

			Для Индекс = 1 По 11 Цикл

				// Расчет множителя для 11-го и 12-го разрядов.
				Если Индекс = 1 Тогда
					Множитель11 = 7;
					Множитель12 = 3;
				ИначеЕсли Индекс = 2 Тогда
					Множитель11 = 2;
					Множитель12 = 7;
				ИначеЕсли Индекс = 3 Тогда
					Множитель11 = 4;
					Множитель12 = 2;
				ИначеЕсли Индекс = 4 Тогда
					Множитель11 = 10;
					Множитель12 = 4;
				ИначеЕсли Индекс = 5 Тогда
					Множитель11 = 3;
					Множитель12 = 10;
				ИначеЕсли Индекс = 6 Тогда
					Множитель11 = 5;
					Множитель12 = 3;
				ИначеЕсли Индекс = 7 Тогда
					Множитель11 = 9;
					Множитель12 = 5;
				ИначеЕсли Индекс = 8 Тогда
					Множитель11 = 4;
					Множитель12 = 9;
				ИначеЕсли Индекс = 9 Тогда
					Множитель11 = 6;
					Множитель12 = 4;
				ИначеЕсли Индекс = 10 Тогда
					Множитель11 = 8;
					Множитель12 = 6;
				ИначеЕсли Индекс = 11 Тогда
					Множитель11 = 0;
					Множитель12 = 8;
				КонецЕсли;

				Цифра = Число(Сред(ИНН, Индекс, 1));
				КонтрольнаяСумма11 = КонтрольнаяСумма11 + Цифра * Множитель11;
				КонтрольнаяСумма12 = КонтрольнаяСумма12 + Цифра * Множитель12;
				
			КонецЦикла;
			
			КонтрольныйРазряд11 = (КонтрольнаяСумма11 %11) %10;
			КонтрольныйРазряд12 = (КонтрольнаяСумма12 %11) %10;
			
			Если КонтрольныйРазряд11 <> Число(Сред(ИНН,11,1)) ИЛИ КонтрольныйРазряд12 <> Число(Сред(ИНН,12,1)) Тогда
				СоответствуетТребованиям = Ложь;
				ТекстСообщения = ТекстСообщения + ?(ЗначениеЗаполнено(ТекстСообщения), Символы.ПС, "")
					+ НСтр("ru = 'Контрольное число для ИНН не совпадает с рассчитанным.'");
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;

	Возврат СоответствуетТребованиям;

КонецФункции

Функция КППСоответствуетТребованиямЛок(Знач КПП, ТекстСообщения)
	
	СоответствуетТребованиям = Истина;
	
	Ошибки = Новый Массив;
	КПП = СокрЛП(КПП);
	
	Если СтрДлина(КПП) <> 9 Тогда
		Ошибки.Добавить(НСтр("ru = 'КПП должен состоять из 9 символов.'"));
	Иначе
		Если Не ТолькоЦифрыВСтрокеЛок(Лев(КПП, 4)) Тогда
			Ошибки.Добавить(НСтр("ru = 'Первые 4 символа КПП (код налогового органа) должны быть цифрами.'"));
		КонецЕсли;
		
		ДопустимыеСимволы = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
		Для НомерСимвола = 5 По 6 Цикл
			Символ = Сред(КПП, НомерСимвола, 1);
			Если Найти(ДопустимыеСимволы, Символ) = 0 Тогда
				Ошибки.Добавить(НСтр("ru = 'Символы 5-6 КПП (причина постановки на учет) должны быть цифрами и/или заглавными буквами латинского алфавита от A до Z.'"));
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ТолькоЦифрыВСтрокеЛок(Прав(КПП, 3)) Тогда
			Ошибки.Добавить(НСтр("ru = 'Последние 3 символа КПП (порядковый номер постановки на учет) должны быть цифрами.'"));
		КонецЕсли;
	КонецЕсли;
	
	Если Ошибки.Количество() > 0 Тогда
		СоответствуетТребованиям = Ложь;
	КонецЕсли;
	
	ТекстСообщения = СтрСоединитьЛок(Ошибки, Символы.ПС);
	
	Возврат СоответствуетТребованиям;

КонецФункции

Функция СерияВУСоответствуетТребованиямЛок(Знач СерияВУ, ТекстСообщения)
	
	СоответствуетТребованиям = Истина;
	
	СерияВУ = СокрЛП(СерияВУ);
	ДлинаСерииВУ = СтрДлина(СерияВУ);
	
	Если Не ТолькоЦифрыВСтрокеЛок(СерияВУ) Или ДлинаСерииВУ <> 4 Тогда
		СоответствуетТребованиям = Ложь;
		ТекстСообщения = НСтр("ru = 'Серия вод. удост. должна состоять из 4 цифр'");
		Возврат СоответствуетТребованиям;
	КонецЕсли;
	
	Если Число(СерияВУ) = 0 Тогда
		СоответствуетТребованиям = Ложь;
		ТекстСообщения = НСтр("ru = 'Серия вод. удост. указана некорректно'");
		Возврат СоответствуетТребованиям;
	КонецЕсли;
	
	Возврат СоответствуетТребованиям;
	
КонецФункции

Функция НомерВУСоответствуетТребованиямЛок(Знач НомерВУ, ТекстСообщения)
	
	СоответствуетТребованиям = Истина;
	
	НомерВУ = СокрЛП(НомерВУ);
	ДлинаНомераВУ = СтрДлина(НомерВУ);
	
	Если Не ТолькоЦифрыВСтрокеЛок(НомерВУ) Или ДлинаНомераВУ <> 6 Тогда
		СоответствуетТребованиям = Ложь;
		ТекстСообщения = НСтр("ru = 'Номер вод. удост. должен состоять из 6 цифр'");
		Возврат СоответствуетТребованиям;
	КонецЕсли;
	
	Если Число(НомерВУ) = 0 Тогда
		СоответствуетТребованиям = Ложь;
		ТекстСообщения = НСтр("ru = 'Номер вод. удост. указан некорректно'");
		Возврат СоответствуетТребованиям;
	КонецЕсли;
	
	Возврат СоответствуетТребованиям;
	
КонецФункции

Функция НомерСТССоответствуетТребованиямЛок(Знач НомерСТС, ТекстСообщения)
	
	СоответствуетТребованиям = Истина;
	
	НомерСТС = ВРег(СокрЛП(Строка(НомерСТС)));
	НомерСТС = СтрЗаменить(НомерСТС, " ", "");
	НомерСТС = СтрЗаменить(НомерСТС, "-", "");
	
	Если СтрДлина(НомерСТС) <> 10 Тогда
		ТекстСообщения = "Номер СТС должен содержать 10 символов";
		СоответствуетТребованиям = Ложь;
		Возврат СоответствуетТребованиям;
	КонецЕсли;
	
	ДопустимыеБуквы = "АВЕКМНОРСТУХ";
	
	// Вариант 1: 99АА123456
	Если ТолькоЦифрыВСтрокеЛок(Лев(НомерСТС, 2)) Тогда
		
		ПродолжениеСерииСТС = Сред(НомерСТС, 3, 2);
		БуквыКорректны = Истина;
		
		Для НомерСимвола = 1 По 2 Цикл
			Символ = Сред(ПродолжениеСерииСТС, НомерСимвола, 1);
			Если Найти(ДопустимыеБуквы, Символ) = 0 Тогда
				БуквыКорректны = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если БуквыКорректны И ТолькоЦифрыВСтрокеЛок(Прав(НомерСТС, 6)) Тогда
			Возврат СоответствуетТребованиям;
		КонецЕсли;
		
	КонецЕсли;
	
	// Вариант 2: 9999123456
	Если ТолькоЦифрыВСтрокеЛок(НомерСТС) Тогда
		Возврат СоответствуетТребованиям;
	КонецЕсли;
	
	ТекстСообщения = "Номер СТС указан некорректно";
	СоответствуетТребованиям = Ложь;
	Возврат СоответствуетТребованиям;
	
КонецФункции

Функция VINСоответствуетТребованиямЛок(Знач VIN, ТекстСообщения)
	
	СоответствуетТребованиям = Истина;
	
	VIN = ВРег(СокрЛП(Строка(VIN)));
	VIN = СтрЗаменить(VIN, " ", "");
	VIN = СтрЗаменить(VIN, "-", "");
	
	Если СтрДлина(VIN) <> 17 Тогда
		ТекстСообщения = "VIN должен содержать 17 символов";
		СоответствуетТребованиям = Ложь;
		Возврат СоответствуетТребованиям;
	КонецЕсли;
	
	Если Не (ТолькоЦифрыВСтрокеЛок(Сред(VIN, 9, 1)) Или Сред(VIN, 9, 1) = "X") Тогда
		ТекстСообщения = "Контрольный символ VIN должен быть цифрой или X";
		СоответствуетТребованиям = Ложь;
		Возврат СоответствуетТребованиям;
	КонецЕсли;
	
	
	ДопустимыеСимволы = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	ЗапрещенныеБуквы = "IOQ";
	
	// проверка состава символов
	Для НомерСимвола = 1 По 17 Цикл
		
		Символ = Сред(VIN, НомерСимвола, 1);
		
		Если Найти(ДопустимыеСимволы, Символ) = 0 Тогда
			ТекстСообщения = "VIN может содержать только цифры и латинские буквы";
			СоответствуетТребованиям = Ложь;
			Возврат СоответствуетТребованиям;
		КонецЕсли;
		
		Если Найти(ЗапрещенныеБуквы, Символ) > 0 Тогда
			ТекстСообщения = "VIN не должен содержать буквы I, O, Q";
			СоответствуетТребованиям = Ложь;
			Возврат СоответствуетТребованиям;
		КонецЕсли;
		
	КонецЦикла;
	
	// контрольная сумма VIN (9-й символ)
	Если Не КонтрольнаяСуммаVINКорректнаЛок(VIN) Тогда
		ТекстСообщения = "Контрольная сумма VIN указана неверно";
		СоответствуетТребованиям = Ложь;
		Возврат СоответствуетТребованиям;
	КонецЕсли;
	
	Возврат СоответствуетТребованиям;
	
КонецФункции

Функция КоличествоМестСоответствуетТребованиямЛок(Знач Значение, ТекстСообщения)
	
	Если Мин(Значение, 9999) < Значение Тогда
		ТекстСообщения = "Кол-во мест не может быть больше 4х разрядов в числе";
		Возврат Ложь;
	КонецЕсли;       
	Возврат Истина;
	
КонецФункции

Функция КодТовНомСоответствуетТребованиямЛок(Знач Значение, МинДлина, МаксДлина, ТекстСообщения)
	
	Если СтрДлина(Значение) < МинДлина И МинДлина > 0 Тогда
		ТекстСообщения = СтрШаблонЛок("Код ТНВЭД должен содержать не менее %1х символов", МинДлина);
		Возврат Ложь;
	ИначеЕсли СтрДлина(Значение) > МаксДлина И МаксДлина > 0 Тогда
		ТекстСообщения = СтрШаблонЛок("Код ТНВЭД должен содержать не более %1х символов", МаксДлина);
		Возврат Ложь;
	КонецЕсли;       
	Возврат Истина;
	
КонецФункции

Функция ТелСоответствуетТребованиямЛок(Знач Значение, ТекстСообщения)
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Тлф Из Значение Цикл
			Если СтрДлина(Тлф) > 20 Тогда
				ТекстСообщения = "Номер телефона не должен превышать 20 символов";
				Возврат Ложь;
			КонецЕсли;   
		КонецЦикла;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

Функция ЗначениеКонтейнерЗаполнено(Знач Значение, ЛокальныеДанные, ТекстСообщения)
	
	Если ТипЗнч(Значение) = Тип("Структура") 
		И Значение.Свойство("Ссылка") Тогда
		ЧтоПроверяем = Строка(Значение.Ссылка);
	Иначе
		ЧтоПроверяем = Строка(Значение);
	КонецЕсли;
	
	Если НРег(ЧтоПроверяем) = "контейнер" Тогда
		СвКонтейн = ЗначениеСтруктурыПоКлючу(ЛокальныеДанные, "СвКонтейн");
		Если Не ЗначениеЗаполнено(СвКонтейн) Тогда
			ТекстСообщения = "В наименовании груза указан контейнер. Заполните сведения о нем";
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция КонтрольнаяСуммаVINКорректнаЛок(VIN)
	
	// веса позиций
	Веса = Новый Массив;
	Веса.Добавить(8);  // 1
	Веса.Добавить(7);  // 2
	Веса.Добавить(6);  // 3
	Веса.Добавить(5);  // 4
	Веса.Добавить(4);  // 5
	Веса.Добавить(3);  // 6
	Веса.Добавить(2);  // 7
	Веса.Добавить(10); // 8
	Веса.Добавить(0);  // 9 (контрольный)
	Веса.Добавить(9);  // 10
	Веса.Добавить(8);  // 11
	Веса.Добавить(7);  // 12
	Веса.Добавить(6);  // 13
	Веса.Добавить(5);  // 14
	Веса.Добавить(4);  // 15
	Веса.Добавить(3);  // 16
	Веса.Добавить(2);  // 17
	
	Сумма = 0;
	
	Для i = 1 По 17 Цикл
		Символ = Сред(VIN, i, 1);
		Значение = ЗначениеСимволаVINЛок(Символ);
		Сумма = Сумма + Значение * Веса[i - 1];
	КонецЦикла;
	
	Остаток = Сумма % 11;
	КонтрольныйСимвол = ?(Остаток = 10, "X", Строка(Остаток));
	
	Возврат Сред(VIN, 9, 1) = КонтрольныйСимвол;
	
КонецФункции

Функция ЗначениеСимволаVINЛок(Символ)
	
	Если ТолькоЦифрыВСтрокеЛок(Символ) Тогда
		Возврат Число(Символ);
	КонецЕсли;
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("A",1);
	Соответствие.Вставить("B",2);
	Соответствие.Вставить("C",3);
