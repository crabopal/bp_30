Процедура СохранитьЗначенияЭПД(КлючИдентификатораЭПД, ИдентификаторЭПД, КлючДополнительныхСвойств, ЗначенияДополнительныхСвойств, ПараметрыЭПД) Экспорт
		                                                       
	Документы1С = ДокументыОснования(КлючИдентификатораЭПД, ИдентификаторЭПД);
	Для Каждого Документ1С Из Документы1С Цикл
		УстановитьЗначениеСведения(Документ1С, КлючИдентификатораЭПД, Неопределено, Ложь);
	КонецЦикла;
	Для Каждого ДокументОснование Из ПараметрыЭПД.ДокументыОснования Цикл
		УстановитьЗначениеСведения(ДокументОснование, КлючИдентификатораЭПД, ИдентификаторЭПД, Ложь);	
	КонецЦикла;
	
	//{ ааа5                
	СсылкаНаЭПД = СсылкаНаЭПД(ИдентификаторЭПД, ПараметрыЭПД.ОсновнойДокумент);
	//} ааа5

	СохранитьЗначения(СсылкаНаЭПД, ЗначенияДополнительныхСвойств, КлючДополнительныхСвойств);

	//{ ааа5 	
	ПрефиксСвойств = ПараметрыЭПД.ПрефиксСвойств;
	//} ааа5
	
	УстановитьЗначениеСведения(СсылкаНаЭПД, "ОсновнойДокумент" + ПрефиксСвойств, СериализоватьXML(ПараметрыЭПД.ОсновнойДокумент), Истина);	
	УстановитьЗначениеСведения(СсылкаНаЭПД, "Номер" + ПрефиксСвойств, ПараметрыЭПД.Номер, Ложь);	
	УстановитьЗначениеСведения(СсылкаНаЭПД, "Дата" + ПрефиксСвойств, ПараметрыЭПД.Дата, Ложь);	
	УстановитьЗначениеСведения(СсылкаНаЭПД, "Сумма" + ПрефиксСвойств, ПараметрыЭПД.Сумма, Ложь);
	Если ПараметрыЭПД.Свойство("Сценарий") Тогда
 		УстановитьЗначениеСведения(СсылкаНаЭПД, "Сценарий" + ПрефиксСвойств, ПараметрыЭПД.Сценарий, Ложь);
	КонецЕсли;
	УстановитьЗначениеСведения(СсылкаНаЭПД, "Признак" + ПрефиксСвойств, 1, Ложь);

	//необходимо проверить, можно ли в значение записать данные ссылки	
	ИмяХарактеристикДополнительныеСвойства = ИмяХарактеристикДополнительныеСвойства();
	ТипЗначенийПВХ = Метаданные.ПланыВидовХарактеристик[ИмяХарактеристикДополнительныеСвойства].Тип;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.Организация)) Тогда
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Организация" + ПрефиксСвойств, ПараметрыЭПД.Организация, Ложь);	 
	Иначе
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Организация" + ПрефиксСвойств, СериализоватьXML(ПараметрыЭПД.Организация), Истина);	 
	КонецЕсли;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.Контрагент)) Тогда
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Контрагент" + ПрефиксСвойств, ПараметрыЭПД.Контрагент, Ложь);	
	Иначе
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Контрагент" + ПрефиксСвойств, СериализоватьXML(ПараметрыЭПД.Контрагент), Истина);	 
	КонецЕсли;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.Перевозчик)) Тогда
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Перевозчик" + ПрефиксСвойств, ПараметрыЭПД.Перевозчик, Ложь);	
	Иначе
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Перевозчик" + ПрефиксСвойств, СериализоватьXML(ПараметрыЭПД.Перевозчик), Истина);	 
	КонецЕсли;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.Грузоотправитель)) Тогда
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Грузоотправитель" + ПрефиксСвойств, ПараметрыЭПД.Грузоотправитель, Ложь);	
	Иначе
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Грузоотправитель" + ПрефиксСвойств, СериализоватьXML(ПараметрыЭПД.Грузоотправитель), Истина);	 
	КонецЕсли;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.Грузополучатель)) Тогда
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Грузополучатель" + ПрефиксСвойств, ПараметрыЭПД.Грузополучатель, Ложь);	
	Иначе
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Грузополучатель" + ПрефиксСвойств, СериализоватьXML(ПараметрыЭПД.Грузополучатель), Истина);	 
	КонецЕсли;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.ЛОП)) Тогда
		УстановитьЗначениеСведения(СсылкаНаЭПД, "ЛОП" + ПрефиксСвойств, ПараметрыЭПД.ЛОП, Ложь);	
	Иначе
		УстановитьЗначениеСведения(СсылкаНаЭПД, "ЛОП" + ПрефиксСвойств, СериализоватьXML(ПараметрыЭПД.ЛОП), Истина);	 
	КонецЕсли;
	Если ТипЗначенийПВХ.СодержитТип(ТипЗнч(ПараметрыЭПД.Заказчик)) Тогда
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Заказчик" + ПрефиксСвойств, ПараметрыЭПД.Заказчик, Ложь);	
	Иначе
		УстановитьЗначениеСведения(СсылкаНаЭПД, "Заказчик" + ПрефиксСвойств, СериализоватьXML(ПараметрыЭПД.Заказчик), Истина);	 
	КонецЕсли;
	                            
КонецПроцедуры

