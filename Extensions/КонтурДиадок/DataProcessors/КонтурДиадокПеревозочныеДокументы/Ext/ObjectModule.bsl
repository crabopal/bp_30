Функция ТекстЗапросаТрН(ДокументыОснования)
	
	Результат = Новый Соответствие;
	
	Для Каждого ДокументОснование Из ДокументыОснования Цикл
		
		Индекс = 0;
		ТекстЗапроса = "";
		ТекстЗапросаВТ = "";
		
		Мтд = ДокументОснование.Метаданные();
		
		ТекстСоединенияВТ = "";
		ПолеЗапросаВес = ПолеЗапроса(Мтд, "Вес", ТекстЗапросаВТ, ТекстСоединенияВТ);
		ПолеЗапросаВес = ?(ПолеЗапросаВес = "НЕОПРЕДЕЛЕНО", ПолеЗапросаВес, "1000*" + ПолеЗапросаВес);
		 		ТекстЗапроса = ТекстЗапроса + ?(ТекстЗапроса = "", "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ОБЪЕДИНИТЬ ВЫБРАТЬ") + " 

		|" + ПолеЗапроса(Мтд, ПолеНомер(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК НомерТрН,
		|" + ПолеЗапроса(Мтд, ПолеДата(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК ДатаТрН,
		|" + ПолеЗапроса(Мтд, ПолеНомер(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК ПутевойЛист_НомерДок,
		|" + ПолеЗапроса(Мтд, ПолеДата(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК ПутевойЛист_ДатаДок,
		|" + ПолеЗапроса(Мтд, ПолеОрганизация(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК Организация,
		|" + ПолеЗапроса(Мтд, ПолеКонтрагент(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК Контрагент, 
		|" + ПолеЗапроса(Мтд, ПолеГрузоотправитель(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК Грузоотправитель,
		|" + ПолеЗапроса(Мтд, ПолеГрузополучатель(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК Грузополучатель,
		|" + ПолеЗапроса(Мтд, ПолеСклад(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК Склад, 
		|" + ПолеЗапроса(Мтд, ПолеГрузоотправитель(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвГО_РекИдентГО,
		|" + ПолеЗапроса(Мтд, ПолеПеревозчик(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвПер,
		|" + ПолеЗапроса(Мтд, ПолеГрузополучатель(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвГП_РекИдентГП,
		|" + ПолеЗапроса(Мтд, ПолеОтпустил(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвПогруз_СвЛицПогрГр_РабЛицПогрГр,
		
		|" + ПолеЗапроса(Мтд, ПолеТС(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвТС_ТС,    
		|" + ПолеЗапроса(Мтд, ПолеПрицеп(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвТС_Прицеп,    
		|" + ПолеЗапроса(Мтд, ПолеГосНомерТС(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК ГосНомерТС,    
		|" + ПолеЗапроса(Мтд, ПолеГосНомерТС(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвТС_ТС_РегНомер,
		|" + ПолеЗапроса(Мтд, ПолеТипТС(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвТС_ТС_ПарТС_Тип,
		|""1"" КАК СвТС_ТС_ТипВлад,
		
		|" + ПолеЗапроса(Мтд, ПолеДатаПланС(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвПогруз_ЗаявПогр,    
		|" + ПолеЗапроса(Мтд, ПолеДатаФактС(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвПогруз_ФДатВрПриб,    
		|" + ПолеЗапроса(Мтд, ПолеДатаФактПо(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвПогруз_ФДатВрУбыт,    
		|" + ПолеЗапросаВес + " КАК СвПогруз_МасБрутОтгр,    

		|" + ПолеЗапроса(Мтд, ПолеМаркаТранспортногоСредства(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвТС_ТС_ПарТС_Марка,
		|" + ПолеЗапроса(Мтд, ПолеГрузоподъемностьТранспортногоСредства(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвТС_ТС_ПарТС_Грузопод,
		|" + ПолеЗапроса(Мтд, ПолеВместимостьТранспортногоСредства(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвТС_ТС_ПарТС_Вместим,
		
		|" + ПолеЗапроса(Мтд, ПолеВодитель(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвВодит1,
		|" + ПолеЗапроса(Мтд, ПолеВУНомерВодителя(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвВодит1_НомВУ,
		|" + ПолеЗапроса(Мтд, ПолеВУСерияВодителя(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвВодит1_СерВУ,
		|" + ПолеЗапроса(Мтд, ПолеФИОВодителя(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвВодит1_ФИО_Наименование,
		|" + ПолеЗапроса(Мтд, ПолеПредставлениеВУВодителя(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвВодит1_ПредставлениеВУ,

		|" + ПолеЗапроса(Мтд, ПолеАдресПогрузки(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвПогруз_ФАдресПогр_Адрес,
		|" + ПолеЗапроса(Мтд, ПолеАдресПогрузкиЗначение(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвПогруз_ФАдресПогр_АдресРФ,
		|""643"" КАК СвПогруз_ФАдресПогр_КодСтраны,
		
		//|" + ПолеЗапроса(Мтд, ПолеАдресДоставки(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвГП_АдресДостГр_Адрес,
		|" + ТекстЗапросаПолеАдресДоставки(Мтд) + " КАК СвГП_АдресДостГр_Адрес,
		//|" + ПолеЗапроса(Мтд, ПолеАдресДоставкиЗначение(), ТекстЗапросаВТ, ТекстСоединенияВТ) + " КАК СвГП_АдресДостГр_АдресРФ,
		|" + ТекстЗапросаПолеАдресДоставкиЗначение(Мтд) + " КАК СвГП_АдресДостГр_АдресРФ,
		|""643"" КАК СвГП_АдресДостГр_КодСтраны
		
		|ИЗ
		|" + Мтд.ПолноеИмя() + " КАК ДанныеИз1С
		|" + ТекстСоединенияВТ + "
		|ГДЕ
		|	ДанныеИз1С.Ссылка = &СсылкаНаОбъект" + Формат(Индекс, "ЧГ=") + " 
		|";
			
		Результат.Вставить(ДокументОснование, ТекстЗапросаВТ + ТекстЗапроса);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

