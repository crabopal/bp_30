		Если ЗначениеЗаполнено(Результат.Склад) Тогда
			ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдресаИТочкиДоставки(Результат.Склад);
	    КонецЕсли;
	КонецЕсли; 
	                                                  
	Если ДанныеКонтактнаяИнформацияАдреса.Количество() > 0 Тогда
		ДанныеАдреса = ДанныеКонтактнаяИнформацияАдреса[0];               
