	Соответствие.Вставить("F",6);
	Соответствие.Вставить("G",7);
	Соответствие.Вставить("H",8);
	Соответствие.Вставить("J",1);
	Соответствие.Вставить("K",2);
	Соответствие.Вставить("L",3);
	Соответствие.Вставить("M",4);
	Соответствие.Вставить("N",5);
	Соответствие.Вставить("P",7);
	Соответствие.Вставить("R",9);
	Соответствие.Вставить("S",2);
