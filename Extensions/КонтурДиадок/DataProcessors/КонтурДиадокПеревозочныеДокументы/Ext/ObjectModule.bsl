	СписокВыбора = Новый Соответствие;

	Макет = ПолучитьМакет("ЗначенияВидТары");
		
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		КодЗначения  = СокрЛП(Макет.Область(НомерСтроки, 1).Текст);
		НаименованиеЗначения = СокрЛП(Макет.Область(НомерСтроки, 2).Текст);
		
		Если Не ЗначениеЗаполнено(НаименованиеЗначения) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбора.Вставить(НаименованиеЗначения, КодЗначения);
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

