Процедура ЗаполнитьТоварыПоДополнительнымРеквизитамТрН(Результат)
	
	ОпГруз = Результат.ОпГруз;

	Для Каждого СтрокаГруз Из ОпГруз Цикл
		Если ТипЗнч(СтрокаГруз.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			ЗаполнитьСтрокуТоваровПоДополнительнымРеквизитамТрН(СтрокаГруз);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуТоваровПоДополнительнымРеквизитамТрН(СтрокаГруз) Экспорт
	
	Если РасчетВесаОбъемаУТ11() Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеНоменклатуры = ДанныеНоменклатуры(СтрокаГруз.Номенклатура);

	Если ТипЗнч(СтрокаГруз) = Тип("Структура") Тогда
		
		СтрокаГруз.Габар.ВысЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ВысЗнач", СтрокаГруз.Габар.ВысЗнач);
		СтрокаГруз.Габар.ШирЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ШирЗнач", СтрокаГруз.Габар.ШирЗнач);
		СтрокаГруз.Габар.ДлЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ДлЗнач", СтрокаГруз.Габар.ДлЗнач);
		
		ВесУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВесУпак", 0);
		Если ЗначениеЗаполнено(ВесУпак) Тогда
			СтрокаГруз.ПлМасГруз.МасБрутЗнач = ВесУпак * СтрокаГруз.КолМестГр;
			СтрокаГруз.ПлМасГруз.МасНетЗнач = ВесУпак * СтрокаГруз.КолМестГр;
		КонецЕсли;
		
 		ОбъемУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ОбъемУпак", 0);
  		Если ЗначениеЗаполнено(ОбъемУпак) Тогда
			СтрокаГруз.Объем = ОбъемУпак * СтрокаГруз.КолМестГр;
		КонецЕсли;

		СтрокаГруз.СпУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "СпУпак", СтрокаГруз.СпУпак);

		ВидТарПредставление = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВидУпак", СтрокаГруз.ВидТарПредставление);
		СписокВыбораВидУпаковки = СписокВыбораВидУпаковки();
		КодВидТары = СписокВыбораВидУпаковки[ВидТарПредставление];
		СтрокаГруз.ВидТар = КодВидТары;
		СтрокаГруз.ВидТарПредставление = ВидТарПредставление;

	Иначе     

		СтрокаГруз.Габар_ВысЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ВысЗнач", СтрокаГруз.Габар_ВысЗнач);
		СтрокаГруз.Габар_ШирЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ШирЗнач", СтрокаГруз.Габар_ШирЗнач);
		СтрокаГруз.Габар_ДлЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ДлЗнач", СтрокаГруз.Габар_ДлЗнач);
		
		ВесУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВесУпак", 0);
		Если ЗначениеЗаполнено(ВесУпак) Тогда
			СтрокаГруз.ПлМасГруз_МасБрутЗнач = ВесУпак * СтрокаГруз.КолМестГр;
			СтрокаГруз.ПлМасГруз_МасНетЗнач = ВесУпак * СтрокаГруз.КолМестГр;
		КонецЕсли;
		
 		ОбъемУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ОбъемУпак", 0);
  		Если ЗначениеЗаполнено(ОбъемУпак) Тогда
			СтрокаГруз.Объем = ОбъемУпак * СтрокаГруз.КолМестГр;
		КонецЕсли;

		СтрокаГруз.СпУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "СпУпак", СтрокаГруз.СпУпак);

		ВидТарПредставление = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВидУпак", СтрокаГруз.ВидТарПредставление);
		СписокВыбораВидУпаковки = СписокВыбораВидУпаковки();
		КодВидТары = СписокВыбораВидУпаковки[ВидТарПредставление];
		СтрокаГруз.ВидТар = КодВидТары;
		СтрокаГруз.ВидТарПредставление = ВидТарПредставление;

	КонецЕсли;
	
КонецПроцедуры

