Функция ПредставлениеТорговыхСетей() Экспорт
	
	Результат = Новый Соответствие;

	ТекстXML = ПолучитьМакет("Retail_list_XML");
	XDTO = XDTOИзXML(ТекстXML.ПолучитьТекст());
	
	Для Каждого org Из XDTO.org Цикл
		Результат.Вставить(org.code, org.name);
	КонецЦикла;
	
	Возврат Результат;
	
