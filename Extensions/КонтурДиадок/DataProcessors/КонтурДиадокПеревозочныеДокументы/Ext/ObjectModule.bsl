Процедура ЗаполнитьXDTO_СодИнфГО_ТрН(XDTO, ТрНСтруктура)
	
	Если ЗаполненКлючСтруктуры(ТрНСтруктура, "УИД") Тогда 
		XDTO.УИД = ТрНСтруктура.УИД;
	КонецЕсли;
	
	XDTO.СодОпер 	= "Лицом, осуществляющим погрузку груза, при указанных обстоятельствах передан водителю груз с указанными характеристиками";
	XDTO.НомерТрН 	= ТрНСтруктура.НомерТрН;
	XDTO.ДатаТрН 	= Формат_ДатаДляXml(ТрНСтруктура.ДатаТрН);
	
	XDTO.НомЗак 	= ТрНСтруктура.НомЗак;  
	Если ЗначениеЗаполнено(ТрНСтруктура.ДатаЗак) Тогда 
		XDTO.ДатаЗак = Формат_ДатаДляXml(ТрНСтруктура.ДатаЗак);
	Иначе
		XDTO.ДатаЗак = Формат_ДатаДляXml(ТрНСтруктура.ДатаТрН);
	КонецЕсли;
	
	//Если ЗначениеЗаполнено(ТрНСтруктура.Исправление.Номер) Тогда 
	//	XDTO.ИспрТрН.НомерТрН 	= ТрНСтруктура.НомерТрН;
	//	XDTO.ИспрТрН.ДатаТрН 	= Формат_ДатаДляXml(ТрНСтруктура.ДатаТрН);
	//КонецЕсли;
	
	ЗаполнитьXDTO_СвГО(XDTO.СвГО, ТрНСтруктура);
	ЗаполнитьXDTO_СвЗак(XDTO.СвЗак, ТрНСтруктура);
	ЗаполнитьXDTO_СвГП(XDTO.СвГП, ТрНСтруктура);	
	ЗаполнитьXDTO_УчастникТип(XDTO.СвПер, ТрНСтруктура.СвПер);
	
	ЗаполнитьXDTO_СвГруз_ТрН(XDTO.СвГруз, ТрНСтруктура);
	ЗаполнитьСписокXDTO_СвВодит(XDTO.СвВодит, ТрНСтруктура);
	ЗаполнитьXDTO_СвТС(XDTO.СвТС, ТрНСтруктура);
	ЗаполнитьXDTO_СвПогруз(XDTO.СвПогруз, ТрНСтруктура);

	ЗаполнитьXDTO_УказГО(XDTO.УказГО, ТрНСтруктура);
	
	// TODO необязательные
	ЗаполнитьСписокXDTO_СопрДок_ТрН(XDTO.СопрДок, ТрНСтруктура);
	ЗаполнитьXDTO_ОтметГО(XDTO.ОтметГО, ТрНСтруктура);
	ЗаполнитьXDTO_КлимРеж_ТрН(XDTO.УказГО.КлимРеж, ТрНСтруктура);
	ЗаполнитьXDTO_ИнфПол(XDTO.ИнфПол, ТрНСтруктура);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СодИнфГО_ЗЗ(XDTO, ЗЗСтруктура)
	
	Если ЗаполненКлючСтруктуры(ЗЗСтруктура, "УИД") Тогда 
		XDTO.УИД = ЗЗСтруктура.УИД;
	КонецЕсли;
	
	XDTO.СодОпер 		= "Предоставление заказа и заявки на перевозку груза автомобильным транспортом";
	XDTO.НомЗак 		= ЗЗСтруктура.НомЗак;
	XDTO.ДатаЗак 		= Формат_ДатаДляXml(ЗЗСтруктура.ДатаЗак);
	XDTO.УкНормПрвз		= ?(Не ЗначениеЗаполнено(ЗЗСтруктура.УкНормПрвз), "Отсутствуют", ЗЗСтруктура.УкНормПрвз);   
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ИныеУслв", ЗЗСтруктура, "ИныеУслв");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ПрвзПищПрод", ЗЗСтруктура, "ПрвзПищПрод", "Отсутствуют");
	
	//XDTO.ПрвзПищПрод	= ?(Не ЗначениеЗаполнено(ЗЗСтруктура.ПрвзПищПрод), "Отсутствуют", ЗЗСтруктура.ПрвзПищПрод);
	XDTO.ПредСрПрвз		= ?(Не ЗначениеЗаполнено(ЗЗСтруктура.ПредСрПрвз), "Отсутствуют", ЗЗСтруктура.ПредСрПрвз);  
	
	ЗаполнитьXDTO_УчастникТип(XDTO.СвГО, ЗЗСтруктура.СвГО);
	ЗаполнитьXDTO_УчастникТип(XDTO.СвПрв, ЗЗСтруктура.СвПрв); 
	
	ЗаполнитьXDTO_ПарТСПрвзТип(XDTO.ПарТСПрвз, ЗЗСтруктура.ПарТСПрвз); 
	ЗаполнитьXDTO_ТемпРежТип_ЗЗ(XDTO.ТемпРеж, ЗЗСтруктура.ТемпРеж); 
	ЗаполнитьXDTO_ВлажнРежТип_ЗЗ(XDTO.ВлажнРеж, ЗЗСтруктура.ВлажнРеж);
	
	ЗаполнитьСписокXDTO_ОпГруз(XDTO.ОпГруз, ЗЗСтруктура.ОпГруз, ЗЗСтруктура); 
	
	ЗаполнитьXDTO_ПунктПод(XDTO.ПунктПод, ЗЗСтруктура.ПунктПод);
	ЗаполнитьСписокXDTO_АдрПункт(XDTO.АдрПункт, ЗЗСтруктура.АдрПункт);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СодИнфКлнт_ПЭ(XDTO, ПЭСтруктура)
	
	Если ЗаполненКлючСтруктуры(ПЭСтруктура, "УИД_ПорЭксп") Тогда 
		XDTO.УИД_ПорЭксп = ПЭСтруктура.УИД_ПорЭксп;
	КонецЕсли;
	
	XDTO.СодОпер 	= "представление электронного поручения экспедитору";
	XDTO.НомДок 	= ПЭСтруктура.НомДок;
	XDTO.ДатаДок 	= Формат_ДатаДляXml(ПЭСтруктура.ДатаДок);
	
	XDTO.ДокГруз = 0;
	Если ЗаполненКлючСтруктуры(ПЭСтруктура, "СопрДок") Тогда
		Если ПЭСтруктура.СопрДок.Количество() > 0 Тогда
			XDTO.ДокГруз = 1;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьXDTO_СвГруз_ПЭ(XDTO.СвГруз, ПЭСтруктура.СвГруз);
		
	ЗаполнитьXDTO_УчастникТип(XDTO.СвКлнт, ПЭСтруктура.СвКлнт);
 	ЗаполнитьXDTO_УчастникТип(XDTO.СвЭксп, ПЭСтруктура.СвЭксп);
	
	СтороныДоговора = Новый Массив;
	СтороныДоговора.Добавить(ПЭСтруктура.СвКлнт);
	СтороныДоговора.Добавить(ПЭСтруктура.СвЭксп);
	ЗаполнитьXDTO_РеквДокТип_ПЭ(XDTO.ДогТрЭксп, СтороныДоговора, ПЭСтруктура.ДогТрЭксп);

	ЗаполнитьСписокXDTO_СопрДок_ПЭ(XDTO.СопрДок, ПЭСтруктура);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвГО(XDTO, ТрНСтруктура)
	
	СвГО = ТрНСтруктура.СвГО;
	
	ЗаполнитьXDTO_УчастникТип(XDTO.РекИдентГО, СвГО.РекИдентГО);
	
	// флаг экспедиция
	Если СвГО.ГОЭксп = 1 Тогда 
		XDTO.ГОЭксп = "1";
	Иначе
		XDTO.ГОЭксп = "0";
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвЗак(XDTO, ТрНСтруктура)
	
	СвГО = ТрНСтруктура.СвГО;
	СвЗак = ТрНСтруктура.СвЗак;
	
	Если СвГО.ГОЭксп = 1 Тогда 

		ЗаполнитьXDTO_УчастникТип(XDTO.РекИдентЗак, СвЗак.РекИдентЗак);
		СтороныДоговора = Новый Массив;
		СтороныДоговора.Добавить(СвГО.РекИдентГО);
		СтороныДоговора.Добавить(СвЗак.РекИдентЗак);
		ЗаполнитьXDTO_РеквДокТип(XDTO.ДогУслПер, СтороныДоговора, СвЗак.ДогУслПер);

	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвГП(XDTO, ТрНСтруктура)
	
	СвГП = ТрНСтруктура.СвГП;
	АдресДостГр = СвГП.АдресДостГр;
	
	ЗаполнитьXDTO_УчастникТип(XDTO.РекИдентГП, СвГП.РекИдентГП);

	// адрес доставки
	КодСтраны 	= АдресДостГр.КодСтраны;
	Адрес 		= АдресДостГр.Адрес;
	АдресРФ		= АдресДостГр.АдресРФ;
	
	ЗаполнитьXDTO_АдресДоставки(XDTO.АдресДостГр, Адрес, АдресРФ, КодСтраны);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_УчастникТип(XDTO_Участник, Участник)
	
	// Если это ИП
	Если ЗаполненКлючСтруктуры(Участник, "ИдСв.СвИП.ИННФЛ") Тогда

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвИП, "ИННФЛ",	Участник.ИдСв.СвИП, "ИННФЛ"); 
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвИП, "ОГРНИП",	Участник.ИдСв.СвИП, "ОГРНИП");
		
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвИП.ФИО, "Фамилия",		Участник.ИдСв.СвИП.ФИО, "Фамилия"); 
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвИП.ФИО, "Имя",			Участник.ИдСв.СвИП.ФИО, "Имя"); 
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвИП.ФИО, "Отчество",	Участник.ИдСв.СвИП.ФИО, "Отчество"); 
				
	// Юридицеское лицо	
	ИначеЕсли ЗаполненКлючСтруктуры(Участник, "ИдСв.СвЮЛУч.ИННЮЛ") Тогда
				
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвЮЛУч, "ИННЮЛ",		Участник.ИдСв.СвЮЛУч, "ИННЮЛ"); 
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвЮЛУч, "НаимОрг",	Участник.ИдСв.СвЮЛУч, "НаимОрг"); 
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвЮЛУч, "КПП",		Участник.ИдСв.СвЮЛУч, "КПП"); 
		
	// Физлицо
	ИначеЕсли ЗаполненКлючСтруктуры(Участник, "ИдСв.СвФЛУчаст.ИННФЛ") И XDTO_ЕстьСвойство(XDTO_Участник.ИдСв, "СвФЛУчаст") Тогда

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУчаст, "ИННФЛ",	Участник.ИдСв.СвФЛУчаст, "ИННФЛ"); 

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУчаст.ФИО, "Фамилия",	Участник.ИдСв.СвФЛУчаст.ФИО, "Фамилия"); 
 		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУчаст.ФИО, "Имя",		Участник.ИдСв.СвФЛУчаст.ФИО, "Имя"); 
 		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУчаст.ФИО, "Отчество",	Участник.ИдСв.СвФЛУчаст.ФИО, "Отчество"); 

	ИначеЕсли ЗаполненКлючСтруктуры(Участник, "ИдСв.СвФЛУчаст.ИННФЛ") И XDTO_ЕстьСвойство(XDTO_Участник.ИдСв, "СвФЛУч") Тогда

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУч, "ИННФЛ",	Участник.ИдСв.СвФЛУчаст, "ИННФЛ"); 

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУч.ФИО, "Фамилия",	Участник.ИдСв.СвФЛУчаст.ФИО, "Фамилия"); 
 		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУч.ФИО, "Имя",		Участник.ИдСв.СвФЛУчаст.ФИО, "Имя"); 
 		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Участник.ИдСв.СвФЛУч.ФИО, "Отчество",	Участник.ИдСв.СвФЛУчаст.ФИО, "Отчество"); 

	Иначе
		
		//ВызватьИсключение "Не могу определить Кто ГП в СведенияГП";
		
	КонецЕсли;
	
	КодСтраны 	= ЗначениеСтруктурыПоКлючу(Участник, "Адрес.АдрИнф.КодСтр");
	Адрес 		= ЗначениеСтруктурыПоКлючу(Участник, "Адрес.АдрИнф.АдрТекст");
	АдресРФ		= ЗначениеСтруктурыПоКлючу(Участник, "Адрес.АдрРФ");
	
	ЗаполнитьXDTO_Адрес(XDTO_Участник.Адрес, Адрес, АдресРФ, КодСтраны);

	Телефоны 	= ЗначениеСтруктурыПоКлючу(Участник, "Контакт.Тлф");
	АдресаЭП	= ЗначениеСтруктурыПоКлючу(Участник, "Контакт.ЭлПочта");
	
	//либо конт, либо контакт
	
	Если XDTO_ЕстьСвойство(XDTO_Участник, "Контакт") Тогда
		ЗаполнитьXDTO_Контакт(XDTO_Участник.Контакт, Телефоны, АдресаЭП, Неопределено);
	Иначе
		ЗаполнитьXDTO_Контакт(XDTO_Участник.Конт, Телефоны, АдресаЭП, Неопределено);
	КонецЕсли;
		
КонецПроцедуры	

Процедура ЗаполнитьXDTO_ПарТСПрвзТип(XDTO_ПарТСПрвз, ПарТСПрвз)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТСПрвз, "Тип", ПарТСПрвз, "Тип"); 
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТСПрвз, "Грузопод", ПарТСПрвз, "Грузопод"); 
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТСПрвз, "Вместим", ПарТСПрвз, "Вместим"); 
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТСПрвз, "ТипПогр", ПарТСПрвз, "ТипПогр"); 
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТСПрвз, "ТипКуз", ПарТСПрвз, "ТипКуз"); 
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТСПрвз, "ДрПарам", ПарТСПрвз, "ДрПарам"); 
		
КонецПроцедуры

Процедура ЗаполнитьXDTO_КлимРеж_ТрН(XDTO_КлимРеж, ТрНСтруктура)
	                                
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_КлимРеж, "ТемпНеНиже", ТрНСтруктура, "УказГО.КлимРеж.ТемпНеНиже");
 	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_КлимРеж, "ТемпНеВыше", ТрНСтруктура, "УказГО.КлимРеж.ТемпНеВыше");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_КлимРеж, "ВлажнНеНиже", ТрНСтруктура, "УказГО.КлимРеж.ВлажнНеНиже");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_КлимРеж, "ВлажнНеВыше", ТрНСтруктура, "УказГО.КлимРеж.ВлажнНеВыше");
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_КлимРеж_ПЭ(XDTO_КлимРеж, СвГруз)
		
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_КлимРеж, "ТемпНеНиже", СвГруз, "УказКлнт.КлимРеж.ТемпНеНиже");
 	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_КлимРеж, "ТемпНеВыше", СвГруз, "УказКлнт.КлимРеж.ТемпНеВыше");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_КлимРеж, "ВлажнНеНиже", СвГруз, "УказКлнт.КлимРеж.ВлажнНеНиже");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_КлимРеж, "ВлажнНеВыше", СвГруз, "УказКлнт.КлимРеж.ВлажнНеВыше");
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ВлажнРежТип_ЗЗ(XDTO_ВлажнРеж, ВлажнРеж)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ВлажнРеж, "ВлажнНеНиже", ВлажнРеж, "ВлажнНеНиже");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ВлажнРеж, "ВлажнНеВыше", ВлажнРеж, "ВлажнНеВыше");
		
КонецПроцедуры

Процедура ЗаполнитьXDTO_ТемпРежТип_ЗЗ(XDTO_ТемпРеж, ТемпРеж)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ТемпРеж, "ТемпНеНиже", ТемпРеж, "ТемпНеНиже");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ТемпРеж, "ТемпНеВыше", ТемпРеж, "ТемпНеВыше");
					
КонецПроцедуры

Процедура ЗаполнитьXDTO_РеквДокТип(XDTO_Договор, СтороныДоговора, ДоговорСтруктура)

	Если СтороныДоговора <> Неопределено Тогда
		ЗаполнитьСписокXDTO_ИдентРек(XDTO_Договор.ИдРекСост, СтороныДоговора);
	КонецЕсли;

	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "ИдДок", ДоговорСтруктура, "ИдДок");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "НаимДок", ДоговорСтруктура, "НаимДок");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "НомерДок", ДоговорСтруктура, "НомерДок");
	Если ЗаполненКлючСтруктуры(ДоговорСтруктура, "ДатаДок") Тогда
		ЗаполнитьXDTO_СПроверкой(XDTO_Договор, "ДатаДок", Формат_ДатаДляXml(ДоговорСтруктура.ДатаДок));
	КонецЕсли;
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "ДопСведДок", ДоговорСтруктура, "ДопСведДок");

КонецПроцедуры

Процедура ЗаполнитьXDTO_РеквДокТип_ПЭ(XDTO_Договор, СтороныДоговора, ДоговорСтруктура)
	
	Если СтороныДоговора <> Неопределено Тогда
		ЗаполнитьСписокXDTO_ИдентРек(XDTO_Договор.РеквИдРекСост, СтороныДоговора);
	КонецЕсли;
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "РеквИдДок", ДоговорСтруктура, "РеквИдДок");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "РеквНаимДок", ДоговорСтруктура, "РеквНаимДок");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "РеквНомерДок", ДоговорСтруктура, "РеквНомерДок");
	Если ЗаполненКлючСтруктуры(ДоговорСтруктура, "РеквДатаДок") Тогда
		ЗаполнитьXDTO_СПроверкой(XDTO_Договор, "РеквДатаДок", Формат_ДатаДляXml(ДоговорСтруктура.РеквДатаДок));
	КонецЕсли;
 	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_Договор, "РеквДопСведДок", ДоговорСтруктура, "РеквДопСведДок");

КонецПроцедуры

Процедура ЗаполнитьXDTO_СвГруз_ТрН(XDTO, ТрНСтруктура)
	
	ЗаполнитьСписокXDTO_ОпГруз(XDTO.ОпГруз, ТрНСтруктура.ОпГруз, ТрНСтруктура);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвГруз_ПЭ(XDTO_СвГруз, СвГруз)

	ЭлементXDTO_СвГруз = XDTO_НовыйЭлементСписка(XDTO_СвГруз);
	
	ЭлементXDTO_СвГруз.ПрУведСторон = ?(СвГруз.ПрУведСторон = Истина, "1", "0");
	ЭлементXDTO_СвГруз.ОтмПрием = ?(СвГруз.ОтмПрием = Истина, "1", "0");
	
	Если ЗначениеЗаполнено(СвГруз.ДатОтгрС) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ДатОтгрС", Формат_ДатаДляXml(СвГруз.ДатОтгрС));
	КонецЕсли;
	Если ЗначениеЗаполнено(СвГруз.ДатОтгрПо) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ДатОтгрПо", Формат_ДатаДляXml(СвГруз.ДатОтгрПо));
	КонецЕсли;
	Если ЗначениеЗаполнено(СвГруз.ДатОтгрС) И ЗначениеЗаполнено(СвГруз.ДатОтгрПо) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ВрОтгр", Формат(СвГруз.ДатОтгрС, "ДФ=HH:mm") + "-" + Формат(СвГруз.ДатОтгрПо, "ДФ=HH:mm") + СмещениеUTCДляXml(СвГруз.ДатОтгрПо));
	КонецЕсли;
	Если ЗначениеЗаполнено(СвГруз.ДатДостГрС) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ДатДостГрС", Формат_ДатаДляXml(СвГруз.ДатДостГрС));
	КонецЕсли;
	Если ЗначениеЗаполнено(СвГруз.ДатДостГрПо) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ДатДостГрПо", Формат_ДатаДляXml(СвГруз.ДатДостГрПо));
	КонецЕсли;
	Если ЗначениеЗаполнено(СвГруз.ДатДостГрС) И ЗначениеЗаполнено(СвГруз.ДатДостГрПо) Тогда
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвГруз, "ВрДостГр", Формат(СвГруз.ДатДостГрС, "ДФ=HH:mm") + "-" + Формат(СвГруз.ДатДостГрПо, "ДФ=HH:mm") + СмещениеUTCДляXml(СвГруз.ДатДостГрПо));
	КонецЕсли;
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_СвГруз, "ИдентПартГруз", СвГруз, "ИдентПартГруз");
	
	ЭлементXDTO_СвГруз.ПрзПрвз = "0"; 
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_СвГруз, "КолМестПарт", СвГруз, "КолМестПарт");
	
 	ЗаполнитьXDTO_УчастникТип(ЭлементXDTO_СвГруз.СвГО, СвГруз.СвГО);
 	ЗаполнитьXDTO_УчастникТип(ЭлементXDTO_СвГруз.СвГП, СвГруз.СвГП);
	
	ЗаполнитьXDTO_СвТС_ПЭ(ЭлементXDTO_СвГруз, СвГруз);
 	ЗаполнитьXDTO_УказКлнт(ЭлементXDTO_СвГруз.УказКлнт, СвГруз);
	
	ЗаполнитьXDTO_Вес_ПЭ(ЭлементXDTO_СвГруз.ВесГрузПарт, СвГруз.ВесГрузПарт);
		
	//АдрГруз 
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_СвГруз.АдрГруз, "МестоПрием", СвГруз, "АдрГруз.МестоПрием");
	КодСтраны 	= ЗначениеСтруктурыПоКлючу(СвГруз, "АдрГруз.АдрПриемГруз.Адрес.АдрИнф.КодСтр");
	Адрес 		= ЗначениеСтруктурыПоКлючу(СвГруз, "АдрГруз.АдрПриемГруз.Адрес.АдрИнф.АдрТекст");
	АдресРФ		= ЗначениеСтруктурыПоКлючу(СвГруз, "АдрГруз.АдрПриемГруз.Адрес.АдрРФ");
	ЗаполнитьXDTO_Адрес(ЭлементXDTO_СвГруз.АдрГруз.АдрПриемГруз.Адрес, Адрес, АдресРФ, КодСтраны);
	
	//АдрГруз 
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_СвГруз.АдрПунктНазн, "МестоВыд", СвГруз, "АдрПунктНазн.МестоВыд");
	КодСтраны 	= ЗначениеСтруктурыПоКлючу(СвГруз, "АдрПунктНазн.АдрВыдГруз.Адрес.АдрИнф.КодСтр");
	Адрес 		= ЗначениеСтруктурыПоКлючу(СвГруз, "АдрПунктНазн.АдрВыдГруз.Адрес.АдрИнф.АдрТекст");
	АдресРФ		= ЗначениеСтруктурыПоКлючу(СвГруз, "АдрПунктНазн.АдрВыдГруз.Адрес.АдрРФ");
	ЗаполнитьXDTO_Адрес(ЭлементXDTO_СвГруз.АдрПунктНазн.АдрВыдГруз.Адрес, Адрес, АдресРФ, КодСтраны);

	ЗаполнитьСписокXDTO_ОпГруз_ПЭ(ЭлементXDTO_СвГруз.ОпГруз, СвГруз.ОпГруз, ЭлементXDTO_СвГруз);
	
	ЗаполнитьXDTO_ИнфПол(ЭлементXDTO_СвГруз.ИнфПол, СвГруз);
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_ОпГруз_ПЭ(СписокXDTO, ОпГруз, ЭлементXDTO_СвГруз)
	
	НомКонтейн = 0;
	Для Каждого ДанныеГруза Из ОпГруз Цикл 
		
		ЭлементXDTO = XDTO_НовыйЭлементСписка(СписокXDTO);
		
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "НаимГруз", XDTO_СтрокаПоСсылке(ДанныеГруза.Номенклатура)); 
		Если ЗаполненКлючСтруктуры(ДанныеГруза, "КолМестГр") Тогда
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "КолМестГр", Мин(ДанныеГруза.КолМестГр, 9999));
		КонецЕсли;
		
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "ПрзОпаснГруз", "0");
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "СвОпаснГруз") И ЗаполненКлючСтруктуры(ДанныеГруза, "СвОпГруз") Тогда
			Если ДанныеГруза.СвОпГруз.Количество() > 0 Тогда
				ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "ПрзОпаснГруз", "1");
				ЗаполнитьСписокXDTO_СвОпГруз(ЭлементXDTO.СвОпаснГруз, ДанныеГруза);
			КонецЕсли;
		КонецЕсли;
		
		Если XDTO_ЕстьСвойство(ЭлементXDTO_СвГруз, "СвКонтейн") И ЗаполненКлючСтруктуры(ДанныеГруза, "СвКонтейн") Тогда
			ЭлементXDTO_СвГруз.ПрзПрвз = "1"; 
			ЗаполнитьСписокXDTO_СвКонтейн_ПЭ(ЭлементXDTO_СвГруз.СвКонтейн, ДанныеГруза, НомКонтейн);
        КонецЕсли;
		
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "ПрзИзъятВещ", "0");
		
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "УказОбъем", "0");
		Если ЗаполненКлючСтруктуры(ДанныеГруза, "Объем") Тогда
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "УказОбъем", "1");
			ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "Объем", ДанныеГруза, "Объем");
		КонецЕсли;
		
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "УчГосСист", "0");
		
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "НалКодТовНом", "0");
		Если ЗаполненКлючСтруктуры(ДанныеГруза, "КодТовНом") Тогда 
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "НалКодТовНом", "1");
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "КодТовНом", XDTO_ОграничениеСтроки(XDTO_СтрокаПоСсылке(ДанныеГруза.КодТовНом), 4, 10, "0"));
		КонецЕсли;
		
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "НалУпак", "0");
		
		Если ЗаполненКлючСтруктуры(ДанныеГруза, "ИнфУпГруз.ВидУпак") Тогда 
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "НалУпак", "1");
			
			ВидУпак = ДанныеГруза.ИнфУпГруз.ВидУпак;
			СписокВыбораВидУпаковки = СписокВыбораВидУпаковки();
			КодВидУпак = СписокВыбораВидУпаковки[ВидУпак];
			Если КодВидУпак <> Неопределено Тогда 
				
				ЭлементXDTO_ИнфУпГруз = XDTO_НовыйЭлементСписка(ЭлементXDTO.ИнфУпГруз);
				ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_ИнфУпГруз, "ВидУпак", КодВидУпак);
				ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_ИнфУпГруз, "ВесУпак", ДанныеГруза, "ИнфУпГруз.ВесУпак");
				ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_ИнфУпГруз, "КолУп", ДанныеГруза, "ИнфУпГруз.КолУп");
				ЗаполнитьXDTO_Габар(ЭлементXDTO_ИнфУпГруз.ГабарУпак, ДанныеГруза.ИнфУпГруз.ГабарУпак);

			КонецЕсли;
		КонецЕсли;
		
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "Марк") Тогда
			ЗаполнитьСписокXDTO_Марк(ЭлементXDTO.Марк, ДанныеГруза);
		КонецЕсли;
		
		ЗаполнитьXDTO_Страна_ПЭ(ЭлементXDTO.СвСтрПроисх, ДанныеГруза);
		ЗаполнитьXDTO_Вес_ПЭ(ЭлементXDTO.ВесГруз, ДанныеГруза.ВесГруз);
		ЗаполнитьXDTO_СтГруз_ПЭ(ЭлементXDTO.ОбъявлСтГруз, ДанныеГруза.ОбъявлСтГруз);
				
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_ОпГруз(СписокXDTO, ОпГруз, ЭПД)
	
	Для Каждого ДанныеГруза Из ОпГруз Цикл 
		
		ЭлементXDTO = XDTO_НовыйЭлементСписка(СписокXDTO);
		
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "НаимГруз", XDTO_СтрокаПоСсылке(ДанныеГруза.Номенклатура)); 
		Если ДанныеГруза.Свойство("КодТовНом") Тогда
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "КодТовНом", XDTO_ОграничениеСтроки(XDTO_СтрокаПоСсылке(ДанныеГруза.КодТовНом), 4, 4, "0"));
		КонецЕсли;
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "СостГруз", ДанныеГруза, "СостГруз");
        // по формату не более 4х разрядов в числе                   
		Если ЗаполненКлючСтруктуры(ДанныеГруза, "КолМестГр") Тогда
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "КолМестГр", Мин(ДанныеГруза.КолМестГр, 9999));
		КонецЕсли;
		Если ЗаполненКлючСтруктуры(ДанныеГруза, "КолГрМест") Тогда
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "КолГрМест", Мин(ДанныеГруза.КолГрМест, 9999));
		КонецЕсли;
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "СпУпак", ДанныеГруза, "СпУпак");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ВидТар", ДанныеГруза, "ВидТар", "00");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "Объем", ДанныеГруза, "Объем");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "Плотн", ДанныеГруза, "Плотн");
		
		Если ДанныеГруза.Свойство("ДелГр") Тогда			
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "ДелГр", ?(ДанныеГруза.ДелГр = Истина, "1", "0"));
		КонецЕсли;
		Если ДанныеГруза.Свойство("РаспрГр") Тогда			
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "РаспрГр", ?(ДанныеГруза.РаспрГр = Истина, "1", "0"));
		КонецЕсли;
		
		Если ЭПД.Свойство("техМетОпрМасс") Тогда 
			//будем данные брать из владельца
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "МетОпрМасс", ЭПД.техМетОпрМасс);
		КонецЕсли; 

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ДрОГруз", ДанныеГруза, "ДрОГруз");
		
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "Габар") Тогда
			ЗаполнитьXDTO_Габар(ЭлементXDTO.Габар, ДанныеГруза.Габар);
		ИначеЕсли XDTO_ЕстьСвойство(ЭлементXDTO, "РазмерГрМест") Тогда
			ЗаполнитьXDTO_Габар(ЭлементXDTO.РазмерГрМест, ДанныеГруза.РазмерГрМест);
		КонецЕсли;
		
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "ПлМасГруз") Тогда
			ЗаполнитьXDTO_МасГруз(ЭлементXDTO.ПлМасГруз, ДанныеГруза.ПлМасГруз);
		ИначеЕсли XDTO_ЕстьСвойство(ЭлементXDTO, "МасГруз") Тогда
			ЗаполнитьXDTO_МасГруз(ЭлементXDTO.МасГруз, ДанныеГруза.МасГруз);
		КонецЕсли;
		
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "ЦеннГруз") Тогда
			ЗаполнитьXDTO_ЦеннГруз(ЭлементXDTO.ЦеннГруз, ДанныеГруза.ЦеннГруз);
		КонецЕсли;
		
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "Марк") Тогда
			ЗаполнитьСписокXDTO_Марк(ЭлементXDTO.Марк, ДанныеГруза);
		КонецЕсли;
		
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "СвОпГруз") Тогда
			ЗаполнитьСписокXDTO_СвОпГруз(ЭлементXDTO.СвОпГруз, ДанныеГруза);
		КонецЕсли;
		
		Если XDTO_ЕстьСвойство(ЭлементXDTO, "СвКонтейн") Тогда
			ЗаполнитьСписокXDTO_СвКонтейн(ЭлементXDTO.СвКонтейн, ДанныеГруза);
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_Габар(XDTO, Габар)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ВысЗнач", Габар, "ВысЗнач");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ДлЗнач", Габар, "ДлЗнач");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ШирЗнач", Габар, "ШирЗнач");
	
КонецПроцедуры	

Процедура ЗаполнитьXDTO_МасГруз(XDTO, МасГруз)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "МасБрутЗнач", МасГруз, "МасБрутЗнач");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "МасНетЗнач", МасГруз, "МасНетЗнач");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "КолПалл", МасГруз, "КолПалл");
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_Вес_ПЭ(XDTO, Вес)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ВесНетто", Вес, "ВесНетто");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ВесБрутто", Вес, "ВесБрутто");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "КолПалл", Вес, "КолПалл");
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_Страна_ПЭ(ЭлементXDTO, ДанныеГруза)
	
	ДанныеПоСтранам = Новый Массив;
	
	СтранаДанные = Новый Структура("Наименование, Код");
	Если ЗаполненКлючСтруктуры(ДанныеГруза, "СвСтрПроисх") Тогда
		СтранаСсылка = Новый Структура("Ссылка");
		Если ТипЗнч(ДанныеГруза.СвСтрПроисх) = Тип("СписокЗначений") Тогда
			Для Каждого ЭлементСписка Из ДанныеГруза.СвСтрПроисх Цикл
				Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
					ЗаполнитьДанныеПоСтране(ДанныеПоСтранам, ЭлементСписка.Значение);
				КонецЕсли;
			КонецЦикла;
		Иначе 
			ЗаполнитьДанныеПоСтране(ДанныеПоСтранам, ДанныеГруза.СвСтрПроисх);
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеПоСтранам.Количество() = 0 Тогда
		СтранаДанные = Новый Структура("Наименование, Код");
		СтранаДанные.Наименование = "РОССИЯ";
		СтранаДанные.Код = "643";
		ДанныеПоСтранам.Добавить(СтранаДанные);
	КонецЕсли; 
	
	Для Каждого ДанныеПоСтране Из ДанныеПоСтранам Цикл
		ЭлементXDTO_Страна = XDTO_НовыйЭлементСписка(ЭлементXDTO);
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_Страна, "НаимСтран", ДанныеПоСтране, "Наименование");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_Страна, "КодСтр", ДанныеПоСтране, "Код");
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПоСтране(ДанныеПоСтранам, Значение)
	
	СтранаДанные = Новый Структура("Наименование, Код");
	СтранаСсылка = Новый Структура("Ссылка");
	ЗаполнитьЗначенияСвойств(СтранаСсылка, Значение);
	Если ЗначениеЗаполнено(СтранаСсылка.Ссылка) Тогда
		ЗаполнитьЗначенияСвойств(СтранаДанные, СтранаСсылка.Ссылка);
		Если ЗначениеЗаполнено(СтранаДанные.Наименование) И ЗначениеЗаполнено(СтранаДанные.Код) Тогда
			ДанныеПоСтранам.Добавить(СтранаДанные);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


Процедура ЗаполнитьXDTO_СтГруз_ПЭ(ЭлементXDTO, СтГруз)
	
	Если ЗаполненКлючСтруктуры(СтГруз, "СтГр") Тогда
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "СтГр", СтГруз, "СтГр");
		
		ВалютаДанные = Новый Структура("Наименование, Код");
		Если ЗаполненКлючСтруктуры(СтГруз, "Валюта") Тогда
			ВалютаСсылка = Новый Структура("Ссылка");
			ЗаполнитьЗначенияСвойств(ВалютаСсылка, СтГруз.Валюта);
			Если ЗначениеЗаполнено(ВалютаСсылка.Ссылка) Тогда
				ЗаполнитьЗначенияСвойств(ВалютаДанные, ВалютаСсылка.Ссылка);
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ВалютаДанные.Наименование) Тогда
			ВалютаДанные.Наименование = "руб.";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ВалютаДанные.Код) Тогда
			ВалютаДанные.Код = "643";
		КонецЕсли;
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "НаимОКВ", ВалютаДанные, "Наименование");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КодОКВ", ВалютаДанные, "Код");
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьXDTO_ЦеннГруз(XDTO, ЦеннГруз)
	
	Если ЗаполненКлючСтруктуры(ЦеннГруз, "СтЦеннГр") Тогда
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "СтЦеннГр", ЦеннГруз, "СтЦеннГр");
		
		ВалютаДанные = Новый Структура("Наименование, Код");
		Если ЗаполненКлючСтруктуры(ЦеннГруз, "Валюта") Тогда
			ВалютаСсылка = Новый Структура("Ссылка");
			ЗаполнитьЗначенияСвойств(ВалютаСсылка, ЦеннГруз.Валюта);
			Если ЗначениеЗаполнено(ВалютаСсылка.Ссылка) Тогда
				ЗаполнитьЗначенияСвойств(ВалютаДанные, ВалютаСсылка.Ссылка);
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ВалютаДанные.Наименование) Тогда
			ВалютаДанные.Наименование = "руб.";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ВалютаДанные.Код) Тогда
			ВалютаДанные.Код = "643";
		КонецЕсли;
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "НаимОКВ", ВалютаДанные, "Наименование");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "КодОКВ", ВалютаДанные, "Код");
		
	КонецЕсли;
		
КонецПроцедуры	

Процедура ЗаполнитьСписокXDTO_Марк(СписокXDTO, ДанныеГруза)

	СписокXDTO.Добавить("Отсутствует");
	
КонецПроцедуры	

Процедура ЗаполнитьСписокXDTO_СвОпГруз(СписокXDTO, ДанныеГруза)

	СведенияОбОпасныхГрузах = ДанныеГруза.СвОпГруз;
	
	Для Каждого СведениеОбОпасномГрузе Из СведенияОбОпасныхГрузах Цикл
		
		//обязательные поля
		ЭлементXDTO = XDTO_НовыйЭлементСписка(СписокXDTO); 

		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "НПА", СведениеОбОпасномГрузе, "НПА"); //ПЭ
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "НомООН", СведениеОбОпасномГрузе, "НомООН");
 		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ИдОпаснООН", СведениеОбОпасномГрузе, "НомООН"); //ПЭ
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "НадОтгНаим", СведениеОбОпасномГрузе, "НадОтгНаим");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "Клас", СведениеОбОпасномГрузе, "Клас");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КлассОпасн", СведениеОбОпасномГрузе, "Клас"); //ПЭ
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КласКод", СведениеОбОпасномГрузе, "КласКод");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ГрУп", СведениеОбОпасномГрузе, "ГрУп");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ЗнОп", СведениеОбОпасномГрузе, "ЗнОп");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КодОгрЧерТун", СведениеОбОпасномГрузе, "КодОгрЧерТун");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ТехНаим", СведениеОбОпасномГрузе, "ТехНаим");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "Описание", СведениеОбОпасномГрузе, "Описание");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "НазРадионук", СведениеОбОпасномГрузе, "НазРадионук");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ОписФизХимФорм", СведениеОбОпасномГрузе, "ОписФизХимФорм");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "МаксАкт", СведениеОбОпасномГрузе, "МаксАкт");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КатУпак", СведениеОбОпасномГрузе, "КатУпак");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ТрансИндекс", СведениеОбОпасномГрузе, "ТрансИндекс");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ИндексБез", СведениеОбОпасномГрузе, "ИндексБез");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ОпозЗнак", СведениеОбОпасномГрузе, "ОпозЗнак");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ПолнАктГр", СведениеОбОпасномГрузе, "ПолнАктГр");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ОбМасНетВзрСод", СведениеОбОпасномГрузе, "ОбМасНетВзрСод"); //ЭТрН
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ОбМасНетВзрСодВсех", СведениеОбОпасномГрузе, "ОбМасНетВзрСодВсех"); //ЭТрН
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ПроцСмеси", СведениеОбОпасномГрузе, "ПроцСмеси"); //ЭТрН
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КонтТемпер", СведениеОбОпасномГрузе, "КонтТемпер");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "АварТемпер", СведениеОбОпасномГрузе, "АварТемпер");

		Если ЗаполненКлючСтруктуры(СведениеОбОпасномГрузе, "ДатИстВрУдер") Тогда
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "ДатИстВрУдер", Формат_ДатаДляXml(СведениеОбОпасномГрузе.ДатИстВрУдер));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_СвКонтейн(СписокXDTO, ДанныеГруза)
	
	СведенияКонтейнеры = ДанныеГруза.СвКонтейн;
	
	Для Каждого СведениеКонтейнер Из СведенияКонтейнеры Цикл
		
		ЭлементXDTO = XDTO_НовыйЭлементСписка(СписокXDTO);
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "КолКонтейн", СведениеКонтейнер, "КолКонтейн");
		
		Если ТипЗнч(СведениеКонтейнер.ИдКонтейн) = Тип("Массив") Тогда
			Для Каждого ИдентификаторКонтейнера Из СведениеКонтейнер.ИдКонтейн Цикл
				XDTO_ДобавитьСтрокуВСписок(ЭлементXDTO.ИдКонтейн, Строка(ИдентификаторКонтейнера));
			КонецЦикла;
		ИначеЕсли ЗначениеЗаполнено(СведениеКонтейнер.ИдКонтейн) Тогда
			XDTO_ДобавитьСтрокуВСписок(ЭлементXDTO.ИдКонтейн, Строка(СведениеКонтейнер.ИдКонтейн));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_СвКонтейн_ПЭ(СписокXDTO, ДанныеГруза, НомКонтейн)
	
	СведенияКонтейнеры = ДанныеГруза.СвКонтейн;
	
	Для Каждого СведениеКонтейнер Из СведенияКонтейнеры Цикл
		НомКонтейн = НомКонтейн + 1;
		
		ЭлементXDTO = XDTO_НовыйЭлементСписка(СписокXDTO);

		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "НомКонтейн", Строка(НомКонтейн));
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO, "ИдКонтейнНест", СведениеКонтейнер, "ИдКонтейн");
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "ИспКонтейн", "2");
		ЗаполнитьXDTO_СПроверкой(ЭлементXDTO, "ПредКонтейн", "2");
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_СопрДок_ТрН(СписокXDTO, ТрНСтруктура)
	
	Для Каждого СопроводительныйДокумент Из ТрНСтруктура.СопрДок Цикл
		
		СписокТипСопрДок = СписокТипСопрДок();
		КодТипСопрДок = СписокТипСопрДок[СопроводительныйДокумент.ТипСопрДок];
		Если КодТипСопрДок = Неопределено Тогда
			КодТипСопрДок = СопроводительныйДокумент.ТипСопрДок;
		КонецЕсли;
		
		ЭлементXDTO = XDTO_НовыйЭлементСписка(СписокXDTO[КодТипСопрДок]);
		ДоговорСтруктура = РеквДокТип(); //"Составитель документа"
		ЗаполнитьЗначенияСвойств(ДоговорСтруктура, СопроводительныйДокумент);
		
		СтороныДоговора = Новый Массив;
		СтороныДоговора.Добавить(СопроводительныйДокумент.ИдРекСост);
		ЗаполнитьXDTO_РеквДокТип(ЭлементXDTO, СтороныДоговора, ДоговорСтруктура);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_СопрДок_ПЭ(СписокXDTO, ПЭСтруктура)
	
	Для Каждого СопроводительныйДокумент Из ПЭСтруктура.СопрДок Цикл
		
		ЭлементXDTO = XDTO_НовыйЭлементСписка(СписокXDTO);
		ДоговорСтруктура = РеквДокТипПЭ(); //"Составитель документа"
		ЗаполнитьЗначенияСвойств(ДоговорСтруктура, СопроводительныйДокумент);
		ЗаполнитьXDTO_РеквДокТип_ПЭ(ЭлементXDTO, Неопределено, ДоговорСтруктура);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_АдрПункт(СписокXDTO, АдрПункт)
	
	ПорНомПункт = 0;
	//свернем одинаковые адреса
	Пункты = Новый ТаблицаЗначений;
	Пункты.Колонки.Добавить("Адрес");
	Пункты.Колонки.Добавить("Опер");
	Пункты.Колонки.Добавить("ДатВрОпер");
	
	Для Каждого Пункт Из АдрПункт Цикл
		
		Поиск = Новый Структура("Опер, Адрес, ДатВрОпер", Пункт.Опер, Пункт.АдресПункт.Адрес.АдрИнф.АдрТекст, Пункт.ДатВрОпер);
		Если Пункты.НайтиСтроки(Поиск).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;		                                                                      
		
		ПорНомПункт = ПорНомПункт + 1;
		
		ЭлементXDTO = XDTO_НовыйЭлементСписка(СписокXDTO);
		ЭлементXDTO.Опер = Пункт.Опер;
		ЭлементXDTO.ПорНомПункт = Формат(ПорНомПункт, "ЧГ=");
		Если ЗначениеЗаполнено(Пункт.ДатВрОпер) Тогда
			ЭлементXDTO.ДатВрОпер = Формат_ДатаВремяСоСмещениемUTCДляXml(Пункт.ДатВрОпер);
			ЭлементXDTO.НалКоорТочВрОпер = "1";
		КонецЕсли;
		
		Если Пункт.Опер = "Погрузка" Тогда
			Если ЗаполненКлючСтруктуры(Пункт, "ОргВладИнфр.ИдСв.СвЮЛУч.ИННЮЛ") Тогда
				ЭлементXDTO.ОргВладИнфр.ИННВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвЮЛУч.ИННЮЛ; 
				ЭлементXDTO.ОргВладИнфр.НаимВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвЮЛУч.НаимОрг;
			ИначеЕсли ЗаполненКлючСтруктуры(Пункт, "ОргВладИнфр.ИдСв.СвФЛУчаст.ИННФЛ") Тогда
				ЭлементXDTO.ОргВладИнфр.ИННВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвФЛУчаст.ИННФЛ; 
				ЭлементXDTO.ОргВладИнфр.НаимВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвФЛУчаст.ФИО.Фамилия;
			ИначеЕсли ЗаполненКлючСтруктуры(Пункт, "ОргВладИнфр.ИдСв.СвИП.ИННФЛ") Тогда
				ЭлементXDTO.ОргВладИнфр.ИННВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвИП.ИННФЛ; 
				ЭлементXDTO.ОргВладИнфр.НаимВладИнфр = Пункт.ОргВладИнфр.ИдСв.СвИП.ФИО.Фамилия;
			КонецЕсли;                         
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Пункт.ПредВрОпер) Тогда
			ЭлементXDTO.ПредВрОпер = Формат_ВремяСоСмещениемUTCДляXml(Пункт.ПредВрОпер);          
			ЭлементXDTO.НалКоорТочПредВрОпер = "1";
		КонецЕсли;
		
		КодСтраны 	= ЗначениеСтруктурыПоКлючу(Пункт, "АдресПункт.Адрес.АдрИнф.КодСтр");
		Адрес 		= ЗначениеСтруктурыПоКлючу(Пункт, "АдресПункт.Адрес.АдрИнф.АдрТекст");
		АдресРФ		= ЗначениеСтруктурыПоКлючу(Пункт, "АдресПункт.Адрес.АдрРФ");
		ЗаполнитьXDTO_Адрес(ЭлементXDTO.АдресПункт.Адрес, Адрес, АдресРФ, КодСтраны);
		
		СтрокаПункта = Пункты.Добавить();
		СтрокаПункта.Адрес = ЗначениеСтруктурыПоКлючу(Пункт, "АдресПункт.Адрес.АдрИнф.АдрТекст");
		СтрокаПункта.Опер = ЗначениеСтруктурыПоКлючу(Пункт, "Опер");
		СтрокаПункта.ДатВрОпер = ЗначениеСтруктурыПоКлючу(Пункт, "ДатВрОпер");

	КонецЦикла;                                                        			
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_УказГО(XDTO, ТрНСтруктура)
	
	УказГО = ТрНСтруктура.УказГО;
		
	Если ЗначениеЗаполнено(УказГО.ОгрСкор) Тогда
		XDTO.ОгрСкор = УказГО.ОгрСкор;              
	КонецЕсли;               
	
	УкНормПрвз = СокрЛП(УказГО.УкНормПрвз);
	Если УкНормПрвз = "" Тогда
		УкНормПрвз = "Отсутствуют";
	КонецЕсли;
	XDTO.УкНормПрвз = УкНормПрвз; 
		
	XDTO.ЗапрПерегруз = "1"; 

	// переадресация
	ЗаполнитьXDTO_СвПА(XDTO.СвПА, ТрНСтруктура);

	// маршрут перевозки
	ЗаполнитьXDTO_МршПрвз(XDTO, ТрНСтруктура);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_УказКлнт(ЭлементXDTO, СвГруз)
	
	УказКлнт = СвГруз.УказКлнт;

	ОгрСкор = СокрЛП(УказКлнт.ОгрСкор);
	Если ОгрСкор = "" Тогда
		ОгрСкор = "Нет";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УказКлнт.ОгрСкор) Тогда
		ЭлементXDTO.ОгрСкор = УказКлнт.ОгрСкор;              
	КонецЕсли;               
	
	УкНормПрвз = СокрЛП(УказКлнт.УкНормПрвз);
	Если УкНормПрвз = "" Тогда
		УкНормПрвз = "Отсутствуют";
	КонецЕсли;
	ЭлементXDTO.Отмет = "Отсутствуют";
	ЭлементXDTO.УкНормПрвз = УкНормПрвз; 
    ЗаполнитьXDTO_КлимРеж_ПЭ(ЭлементXDTO.КлимРеж, СвГруз);

КонецПроцедуры

Процедура ЗаполнитьXDTO_СвПА(XDTO, ТрНСтруктура)

	XDTO.ЛицоПА = "Грузоотправитель";
	XDTO.СпосПерУкПА = "Электронное уведомление перевозчика о переадресовке";

	Телефоны 	= ТрНСтруктура.СвГО.РекИдентГО.Контакт.Тлф;
	АдресаЭП	= ТрНСтруктура.СвГО.РекИдентГО.Контакт.ЭлПочта;
	
	ЗаполнитьXDTO_Контакт(XDTO.КонтПА, Телефоны, АдресаЭП, Неопределено);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_МршПрвз(XDTO, ТрНСтруктура)
	
	Если ТрНСтруктура.Свойство("МаршрутТекст")
		И ЗначениеЗаполнено(ТрНСтруктура.МаршрутТекст) Тогда 
		
		XDTO.МршПрвз.МршТекст = ТрНСтруктура.МаршрутТекст;
		XDTO.МршПрвз.МршМашЧит = ТрНСтруктура.МаршрутМашиночитаемый;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_СвВодит(СписокXDTO, ТрНСтруктура)
	
	СведенияОВодителях = Новый Массив;
	Если ЗначениеЗаполнено(ТрНСтруктура.СвВодит1) Тогда
		СведенияОВодителях.Добавить(ТрНСтруктура.СвВодит1);	
	КонецЕсли;
	Если ЗначениеЗаполнено(ТрНСтруктура.СвВодит2)
		И (ЗначениеЗаполнено(ТрНСтруктура.СвВодит2.ИННФЛ)
		Или ЗначениеЗаполнено(ТрНСтруктура.СвВодит2.НомВУ)) Тогда
		СведенияОВодителях.Добавить(ТрНСтруктура.СвВодит2);	
	КонецЕсли;
	Если ЗначениеЗаполнено(ТрНСтруктура.СвВодит3)
		И (ЗначениеЗаполнено(ТрНСтруктура.СвВодит3.ИННФЛ)
		Или ЗначениеЗаполнено(ТрНСтруктура.СвВодит3.НомВУ)) Тогда
		СведенияОВодителях.Добавить(ТрНСтруктура.СвВодит3);	
	КонецЕсли;
	
	Для Каждого СвВодит Из СведенияОВодителях Цикл 
		ЕстьДанные = Ложь;
		ЭлементXDTO = XDTO_НовыйЭлементСписка(СписокXDTO);
		
		Если ЗначениеЗаполнено(СвВодит.ИННФЛ) Тогда 
			ЭлементXDTO.ИННФЛ = СвВодит.ИННФЛ;
			ЕстьДанные = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвВодит.ДатаВыдВУ)
			И ЗначениеЗаполнено(СвВодит.НомВУ)
			И ЗначениеЗаполнено(СвВодит.СерВУ) Тогда 
				ЭлементXDTO.ДатаВыдВУ = Формат_ДатаДляXml(СвВодит.ДатаВыдВУ);
				ЭлементXDTO.НомВУ = СвВодит.НомВУ;
				ЭлементXDTO.СерВУ = СвВодит.СерВУ;
			ЕстьДанные = Истина;
		КонецЕсли;
		
		Если СвВодит.Тлф <> Неопределено Тогда 
			ЗаполнитьСписокXDTOПоМассивуСтрок(ЭлементXDTO.Тлф, СвВодит.Тлф);
		КонецЕсли;
		
		ЗаполнитьXDTO_ФИО(ЭлементXDTO.ФИО, СвВодит.ФИО);
		
		Если ЕстьДанные Тогда
			ЗаполнитьСписокXDTO_ПутевойЛист(ЭлементXDTO.ПутевойЛист, ТрНСтруктура);
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTOПоМассивуСтрок(СписокXDTO, МассивСтрок)
		
	Для Каждого Строка Из МассивСтрок Цикл 
		
		XDTO_ДобавитьСтрокуВСписок(СписокXDTO, Строка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_ПутевойЛист(СписокXDTO, ТрНСтруктура)
	
	ПутевойЛист = ТрНСтруктура.ПутевойЛист;
	
	Если ЗначениеЗаполнено(ПутевойЛист.НаимДок)
		И ЗначениеЗаполнено(ПутевойЛист.НомерДок)
		И ЗначениеЗаполнено(ПутевойЛист.ДатаДок) Тогда
		ЭлементXDTO = XDTO_НовыйЭлементСписка(СписокXDTO);
		ЭлементXDTO.НаимДок = ПутевойЛист.НаимДок;
		ЭлементXDTO.НомерДок = ПутевойЛист.НомерДок;
		ЭлементXDTO.ДатаДок = Формат_ДатаДляXml(ПутевойЛист.ДатаДок);
		
		Если ЗначениеЗаполнено(ТрНСтруктура.СвГО.РекИдентГО) Тогда			
			СписокИдРекСост = Новый Массив;
			СписокИдРекСост.Добавить(ТрНСтруктура.СвГО.РекИдентГО);
			ЗаполнитьСписокXDTO_ИдентРек(ЭлементXDTO.ИдРекСост, СписокИдРекСост);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_ИдентРек(ИдентРек, СписокИдРекСост) 
	
	Для Каждого ИдРекСост Из СписокИдРекСост Цикл
		XDTO = XDTO_НовыйЭлементСписка(ИдентРек);
		ЗаполнитьXDTO_ИдентРек(XDTO, ИдРекСост);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ИдентРек(XDTO, Участник) 
	
	Если Участник <> Неопределено Тогда
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ИННЮЛ", Участник, "ИдСв.СвЮЛУч.ИННЮЛ");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ИННФЛ", Участник, "ИдСв.СвФЛУчаст.ИННФЛ");
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ИННФЛ", Участник, "ИдСв.СвИП.ИННФЛ");
		
		Если Участник.Свойство("ИНН") Тогда
			ИННУчастника = СокрЛП(Участник.ИНН);
			Если СтрДлина(ИННУчастника) = 12 Тогда
				ЗаполнитьXDTO_СПроверкой(XDTO, "ИННФЛ", ИННУчастника);
			Иначе //минимум 10
				ЗаполнитьXDTO_СПроверкой(XDTO, "ИННЮЛ", XDTO_ОграничениеСтроки(ИННУчастника, 10, 10, "0"));
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;                         
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвТС(XDTO, ТрНСтруктура)
	
	ЗаполнитьXDTO_ТС(XDTO.ТС, ТрНСтруктура.СвТС.ТС);
	Если ЗаполненКлючСтруктуры(ТрНСтруктура,"СвТС.Прицеп.Ссылка")
		Или ЗаполненКлючСтруктуры(ТрНСтруктура,"СвТС.Прицеп.РегНомер") Тогда
		ЗаполнитьСписокXDTO_Прицеп(XDTO.Прицеп, ТрНСтруктура.СвТС.Прицеп);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ТС(XDTO, ТС)

	Если ЗаполненКлючСтруктуры(ТС, "НомСТС") Тогда 
		ЗаполнитьXDTO_СПроверкой(XDTO, "НомСТС", СтрЗаменить(ТС.НомСТС, " ", ""));           
	КонецЕсли;
	Если ЗаполненКлючСтруктуры(ТС, "НомерВИН") Тогда 
		ЗаполнитьXDTO_СПроверкой(XDTO, "НомерВИН", СтрЗаменить(ТС.НомерВИН, " ", ""));           
	КонецЕсли;
	Если ЗаполненКлючСтруктуры(ТС, "РегНомер") Тогда 
		ЗаполнитьXDTO_СПроверкой(XDTO, "РегНомер", СтрЗаменить(ТС.РегНомер, " ", ""));           
	КонецЕсли;
	
	Если ЗаполненКлючСтруктуры(ТС, "ТипВлад") Тогда 
		ЗаполнитьXDTO_СПроверкой(XDTO, "ТипВлад", ТС.ТипВлад);           
		Если ТС.ТипВлад = "3"
			Или ТС.ТипВлад = "4"
			Или ТС.ТипВлад = "5" Тогда
			//обязательно
			Если ЗаполненКлючСтруктуры(ТС, "ОснАрЛиз") Тогда
				ЭлементXDTO = XDTO_НовыйЭлементСписка(XDTO.ОснАрЛиз);
				СтороныДоговора = Новый Массив;
				СтороныДоговора.Добавить(ТС.ОснАрЛиз.ИдРекСост);
				ЗаполнитьXDTO_РеквДокТип(ЭлементXDTO, СтороныДоговора, ТС.ОснАрЛиз);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаполненКлючСтруктуры(ТС, "ПарТС") Тогда 
		ЗаполнитьXDTO_ПарТСТип(XDTO.ПарТС, ТС.ПарТС);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ПарТСТип(XDTO_ПарТС, ПарТС)
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТС, "Вместим", ПарТС, "Вместим");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТС, "Тип", ПарТС, "Тип");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТС, "Грузопод", ПарТС, "Грузопод");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO_ПарТС, "Марка", ПарТС, "Марка");
	  	
КонецПроцедуры

Процедура ЗаполнитьСписокXDTO_Прицеп(СписокXDTO, Прицеп)
	
	ЭлементXDTO = XDTO_НовыйЭлементСписка(СписокXDTO);
	ЗаполнитьXDTO_ТС(ЭлементXDTO, Прицеп);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвТС_ПЭ(ЭлементXDTO_СвГруз, СвГруз)
	
	Если ЗаполненКлючСтруктуры(СвГруз, "СвТС.ВидТС") Тогда
		ВидТС = СвГруз.СвТС.ВидТС;
		СписокВыбораВидТС = СписокВыбораВидТС();
		КодВидТС = СписокВыбораВидТС[ВидТС];
		Если КодВидТС <> Неопределено Тогда 
			ЭлементXDTO_СвТС = XDTO_НовыйЭлементСписка(ЭлементXDTO_СвГруз.СвТС);
			ЗаполнитьXDTO_СПроверкой(ЭлементXDTO_СвТС, "ВидТС", КодВидТС);
			Если КодВидТС = "1" Или КодВидТС = "4" Тогда
				ЗаполнитьXDTOПоСтруктуре_СПроверкой(ЭлементXDTO_СвТС, "ТипКузов", СвГруз, "СвТС.ТипКузов");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_СвПогруз(XDTO, ТрНСтруктура)
	
	СвПогруз = ТрНСтруктура.СвПогруз;
	
	// по формату не более 4 разрядов в числе
	Если ЗначениеЗаполнено(СвПогруз.КолМестПрием)
		Или СвПогруз.КолМестПрием = 0 Тогда
		XDTO.КолМестПрием = Мин(СвПогруз.КолМестПрием, 9999);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвПогруз.МасБрутОтгр) Или СвПогруз.МасБрутОтгр = 0 Тогда
		XDTO.МасБрутОтгр 	= СвПогруз.МасБрутОтгр;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СокрЛП(СвПогруз.МетОпрМасс)) Тогда
		XDTO.МетОпрМасс 	= СокрЛП(СвПогруз.МетОпрМасс);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвПогруз.ФДатВрПриб) Тогда
		XDTO.ФДатВрПриб 	= Формат_ДатаВремяСоСмещениемUTCДляXml(СвПогруз.ФДатВрПриб);
	КонецЕсли;
	XDTO.НалКоорТочВрФПогр 	= "1";

	Если ЗначениеЗаполнено(СвПогруз.ЗаявПогр) Тогда
		XDTO.ЗаявПогр 	= Формат_ДатаВремяСоСмещениемUTCДляXml(СвПогруз.ЗаявПогр);
	КонецЕсли;
	XDTO.НалКоорТочВрЗаяв 	= "1";
	
	Если ЗначениеЗаполнено(СвПогруз.ФДатВрУбыт) Тогда
		XDTO.ФДатВрУбыт 	= Формат_ДатаВремяСоСмещениемUTCДляXml(СвПогруз.ФДатВрУбыт);
	КонецЕсли;
	XDTO.НалКоорТочВрФУбыт 	= "1";
	
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ФСостТар", СвПогруз, "ФСостТар");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ФСостУп", СвПогруз, "ФСостУп");
	ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "ФСостКуз", СвПогруз, "ФСостКуз");
	
	ЗаполнитьXDTO_ВладИнфр(XDTO.ВладИнфр, ТрНСтруктура);
	ЗаполнитьXDTO_СвЛицПогрГр(XDTO.СвЛицПогрГр, ТрНСтруктура);
	
	КодСтраны 	= СвПогруз.ФАдресПогр.КодСтраны;
	Адрес 		= СвПогруз.ФАдресПогр.Адрес;
	АдресРФ		= СвПогруз.ФАдресПогр.АдресРФ;
	ЗаполнитьXDTO_АдресПогрузки(XDTO.ФАдресПогр, Адрес, АдресРФ, КодСтраны);
	
	ЗаполнитьXDTO_РеквизитыДокумента(XDTO.ОснДостОбИнфрДок, СвПогруз.ОснДостОбИнфрДок);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ПунктПод(XDTO, ПунктПод)
	
	Если ЗначениеЗаполнено(ПунктПод.ДатВрПод) Тогда
		XDTO.ДатВрПод = Формат_ДатаВремяСоСмещениемUTCДляXml(ПунктПод.ДатВрПод);  
		XDTO.НалКоорТочВрПод = "1"; 
		XDTO.НалКоорТочПредВрПод = "1"; 
	КонецЕсли;
	
	КодСтраны 	= ПунктПод.АдрПунктПод.Адрес.АдрИнф.КодСтр;
	Адрес 		= ПунктПод.АдрПунктПод.Адрес.АдрИнф.АдрТекст;
	АдресРФ		= ПунктПод.АдрПунктПод.Адрес.АдрРФ;
	ЗаполнитьXDTO_Адрес(XDTO.АдрПунктПод.Адрес, Адрес, АдресРФ, КодСтраны);
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ВладИнфр(XDTO, ТрНСтруктура)
	
	ВладИнфр = ТрНСтруктура.СвПогруз.ВладИнфр; 
	
	Если ВладИнфр.СовпГОВ = 1 Тогда 
		XDTO.СовпГОВ = "1";
	Иначе
		XDTO.СовпГОВ = "2";
	КонецЕсли;
	//XDTO.СовпГОВ = "3";// когда лицо неизвестно не обрабатываем
	
	Если XDTO.СовпГОВ = "1" Тогда
		ЗаполнитьXDTO_ИдентРек(XDTO.ИдентРекГО, ТрНСтруктура.СвГО.РекИдентГО);
	Иначе
		ЗаполнитьXDTO_УчастникТип(XDTO.РекВладИнф, ВладИнфр.РекВладИнф);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьXDTO_СвЛицПогрГр(XDTO, ТрНСтруктура)
	
	СвЛицПогрГр = ТрНСтруктура.СвПогруз.СвЛицПогрГр;
	
	Если СвЛицПогрГр.СовпГОП = 1 Тогда 
		XDTO.СовпГОП = "1";
	Иначе
		XDTO.СовпГОП = "2";
	КонецЕсли;

	Если XDTO.СовпГОП = "1" Тогда
		ЗаполнитьXDTO_ИдентРек(XDTO.ИдентРекГО, ТрНСтруктура.СвГО.РекИдентГО);
		Если ЗаполненКлючСтруктуры(СвЛицПогрГр, "РабЛицПогрГр") Тогда
			ЗаполнитьXDTO_РабЛицПогрГр(XDTO.РабЛицПогрГр, СвЛицПогрГр.РабЛицПогрГр);		
		КонецЕсли;
	Иначе
		ЗаполнитьXDTO_УчастникТип(XDTO.РекЛицПогрГр, СвЛицПогрГр.РекЛицПогрГр);
		СтороныДоговора = Новый Массив;
		СтороныДоговора.Добавить(СвЛицПогрГр.РекЛицПогрГр);
		ЗаполнитьXDTO_РеквДокТип(XDTO.ОснПогрГр, СтороныДоговора, СвЛицПогрГр.ОснПогрГр);
		ЗаполнитьXDTO_РабЛицПогрГр(XDTO.РабЛицПогрГр, СвЛицПогрГр.РабЛицПогрГр);		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_РабЛицПогрГр(XDTO, РабЛицПогрГр)
	
	// фамилия обязательна, заполняем только при условии наличия фамилии, иначе ошибка
	Если ЗаполненКлючСтруктуры(РабЛицПогрГр, "ФИО.Фамилия") Тогда
		ЗаполнитьXDTOПоСтруктуре_СПроверкой(XDTO, "Должность", РабЛицПогрГр, "Должность");
		ЗаполнитьXDTO_СПроверкой(XDTO, "ОДолжОб", "Должностные обязанности");
		ЗаполнитьXDTO_ФИО(XDTO.ФИО, РабЛицПогрГр.ФИО)                          
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ОтметГО(XDTO, ТрНСтруктура)
	
	// TODO необязательный блок
	
КонецПроцедуры

Процедура ЗаполнитьXDTO_ИнфПол(XDTO, ТрНСтруктура)
	
	ФорматЗаписи = "together";
	Для Каждого ИнфПол Из ТрНСтруктура.ИнфПол Цикл
		ФорматЗаписи = ЗначениеСтруктурыПоКлючу(ИнфПол, "ФорматЗаписи", "together");
		ФорматЗаписи = ?(ФорматЗаписи = "", "together", ФорматЗаписи);
		Прервать;
	КонецЦикла;
	
	Если ФорматЗаписи = "separate" Тогда
		
		Для Каждого ИнфПол Из ТрНСтруктура.ИнфПол Цикл

			Разделитель = ЗначениеСтруктурыПоКлючу(ИнфПол, "Разделитель", ",");
			Разделитель = ?(Разделитель = "", ",", Разделитель);
			ФорматЗаписиПоля = ЗначениеСтруктурыПоКлючу(ИнфПол, "ФорматЗаписиПоля", "separate");
			ФорматЗаписиПоля = ?(ФорматЗаписиПоля = "", "separate", ФорматЗаписиПоля);

			Если ФорматЗаписиПоля = "together" Тогда
				//объединить по ключам
				ЕстьУжеЗначение = Ложь;
				Для Каждого ЭлементИнфПол Из XDTO Цикл
					Для Каждого ТекстИнф Из ЭлементИнфПол.ТекстИнф Цикл
						Если ТекстИнф.Идентиф = ИнфПол.ТекстИнф.Идентиф Тогда
							ДобавитьXDTO_ТекстИнфЗначение(ТекстИнф, ИнфПол.ТекстИнф.Значение, Разделитель);
							ЕстьУжеЗначение = Истина;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
				Если Не ЕстьУжеЗначение Тогда
					ЭлементИнфПол = XDTO_НовыйЭлементСписка(XDTO);
					ДобавитьXDTO_ТекстИнф(ЭлементИнфПол.ТекстИнф, ИнфПол.ТекстИнф.Идентиф, ИнфПол.ТекстИнф.Значение);
				КонецЕсли;
			Иначе
				ЭлементИнфПол = XDTO_НовыйЭлементСписка(XDTO);
				ДобавитьXDTO_ТекстИнф(ЭлементИнфПол.ТекстИнф, ИнфПол.ТекстИнф.Идентиф, ИнфПол.ТекстИнф.Значение);
			КонецЕсли;
			
		КонецЦикла;
	Иначе 
		
		ЭлементИнфПол = XDTO_НовыйЭлементСписка(XDTO);
		
		Для Каждого ИнфПол Из ТрНСтруктура.ИнфПол Цикл

			Разделитель = ЗначениеСтруктурыПоКлючу(ИнфПол, "Разделитель", ",");
			Разделитель = ?(Разделитель = "", ",", Разделитель);
			ФорматЗаписиПоля = ЗначениеСтруктурыПоКлючу(ИнфПол, "ФорматЗаписиПоля", "separate");
			ФорматЗаписиПоля = ?(ФорматЗаписиПоля = "", "separate", ФорматЗаписиПоля);
			
			Если ФорматЗаписиПоля = "together" Тогда
				//объединить по ключам
				ЕстьУжеЗначение = Ложь;
				Для Каждого ТекстИнф Из ЭлементИнфПол.ТекстИнф Цикл
					Если ТекстИнф.Идентиф = ИнфПол.ТекстИнф.Идентиф Тогда
						ДобавитьXDTO_ТекстИнфЗначение(ТекстИнф, ИнфПол.ТекстИнф.Значение, Разделитель);
						ЕстьУжеЗначение = Истина;
					КонецЕсли;
				КонецЦикла;
				Если Не ЕстьУжеЗначение Тогда
					ДобавитьXDTO_ТекстИнф(ЭлементИнфПол.ТекстИнф, ИнфПол.ТекстИнф.Идентиф, ИнфПол.ТекстИнф.Значение);
				КонецЕсли;
			Иначе
				ДобавитьXDTO_ТекстИнф(ЭлементИнфПол.ТекстИнф, ИнфПол.ТекстИнф.Идентиф, ИнфПол.ТекстИнф.Значение);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
		
КонецПроцедуры

Процедура ДобавитьXDTO_ТекстИнфЗначение(ТекстИнф, Значение, Разделитель)
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		ТекстИнф.Значение = ТекстИнф.Значение + Разделитель + Формат(Значение, "ДЛФ=Д");
	Иначе
		ТекстИнф.Значение = ТекстИнф.Значение + Разделитель + Строка(Значение);
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьXDTO_ТекстИнф(СписокТекстИнф, Идентификатор, Значение)
	
	Если ЗначениеЗаполнено(Значение) Тогда
		ТекстИнф = XDTO_НовыйЭлементСписка(СписокТекстИнф);
		ТекстИнф.Идентиф = Идентификатор; 
		Если ТипЗнч(Значение) = Тип("Дата") Тогда
			ТекстИнф.Значение = Формат(Значение, "ДЛФ=Д");
		Иначе
			ТекстИнф.Значение = Строка(Значение);
		КонецЕсли;
	КонецЕсли;
	
