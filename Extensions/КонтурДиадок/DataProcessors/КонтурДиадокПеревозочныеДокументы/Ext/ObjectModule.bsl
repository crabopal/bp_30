Функция ПодготовитьСообщениеТрН(ФорматДок, ИдентификаторТрН, ДокументыОснования, ОсновнойДокумент, Параметры) Экспорт
	
	СообщениеТрН = МанифестСообщенияТрН(ФорматДок);
		
	ЗаполнитьСообщениеТрнПоДокументу1С(СообщениеТрН, ИдентификаторТрН, ДокументыОснования, ОсновнойДокумент, Параметры);
	
	Возврат СообщениеТрН;
	
КонецФункции

Функция МанифестСообщенияТрН(ФорматДок)
	
	Сообщение = СтруктураТрН();
	Сообщение.Вставить("Формат", ФорматДок);
	
	Сообщение.Вставить("Подписант", 	МанифестПодписант());
	Сообщение.Вставить("УИД", 			Неопределено);
	
	Возврат  Сообщение;
	
КонецФункции

Функция МанифестПодписант()
	
	Подписант = Новый Структура;
	Подписант.Вставить("ПоДоверенности", Ложь);
	Подписант.Вставить("Должность", "");
	Подписант.Вставить("Фамилия", "");
	Подписант.Вставить("Имя", "");
	Подписант.Вставить("Отчество", "");
	Возврат  Подписант;
	
КонецФункции

Функция ПодготовитьСообщениеЗЗ(ФорматДок, ИдентификаторЗЗ, ДокументыОснования, ОсновнойДокумент, Параметры) Экспорт
	
