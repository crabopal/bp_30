	ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдресаИТочкиДоставки(Результат.СвГруз.СвГО);
	Если ДанныеКонтактнаяИнформацияАдреса.Количество() = 0 
