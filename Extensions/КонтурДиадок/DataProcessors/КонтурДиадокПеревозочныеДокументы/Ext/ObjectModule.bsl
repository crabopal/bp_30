Функция ПолеПеревозчик()
	
	Результат = Новый Массив;

	Если Метаданные.Справочники.Найти("Партнеры") <> Неопределено Тогда //УТ11
		
		ТекстЗапросаВТ = 
		"
		|ВЫБРАТЬ
		|	МАКСИМУМ(Контрагенты.Ссылка) КАК Контрагент,
		|	Контрагенты.Партнер КАК Партнер
		|ПОМЕСТИТЬ ВТ_Партнеры
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|
		|СГРУППИРОВАТЬ ПО
		|	Контрагенты.Партнер
		|;
		|";
		
		ТекстСоединенияВТ = "
		|ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Партнеры КАК ВТ_Партнеры 
		|ПО ВТ_Партнеры.Партнер = ДанныеИз1С.ПеревозчикПартнер
		|";
		
		Результат.Добавить(Новый Структура("ИмяРеквизита, ПолеЗапроса, ТекстЗапросаВТ, ТекстСоединенияВТ", 
		"ПеревозчикПартнер",
		"ВТ_Партнеры.Контрагент",
		ТекстЗапросаВТ,
		ТекстСоединенияВТ));
		
		ТекстСоединенияВТ = "
		|ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Партнеры КАК ВТ_Партнеры 
		|ПО ВТ_Партнеры.Партнер = ДанныеИз1С.Перевозчик
		|";
		
		Результат.Добавить(Новый Структура("ИмяРеквизита, ПолеЗапроса, ТекстЗапросаВТ, ТекстСоединенияВТ", 
		"Перевозчик",
		"ВТ_Партнеры.Контрагент",
		ТекстЗапросаВТ,
		ТекстСоединенияВТ));
		
	Иначе
		
		Результат.Добавить("Перевозчик"); //БП30
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

