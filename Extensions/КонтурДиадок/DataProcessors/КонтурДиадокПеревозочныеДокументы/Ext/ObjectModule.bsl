	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ИдРекСост.ИНН", Истина, "ИНН владельца " + ДопИнфо, РеквизитНаФорме, , "ИННФЛ_ИННЮЛ");
				
