Процедура ПараметрыВалидацииВодителя(Результат, Префикс = Неопределено) Экспорт
	
	ИмяФормы = "ФормаВодителя";
	Если Префикс = Неопределено Тогда
		ДопИнфо = "";
		РеквизитНаФорме = "";
	Иначе
		ДопИнфо = Прав(Префикс, 1);
		РеквизитНаФорме = "рл_" + Префикс;
	КонецЕсли;
	
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ФИО.Фамилия", Истина, "Фамилия водителя " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ФИО.Имя", Истина, "Имя водителя " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ФИО.Отчество", Ложь, "Отчество водителя " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "Тлф", Истина, "Телефон водителя " + ДопИнфо, РеквизитНаФорме, , "Тлф");
	
    ОбязателенЕсли = "ЛокальныйИсточник: (&СерВУ<>&ПустаяСтрока ИЛИ &ДатаВыдВУ<>&ПустаяДата)";
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "НомВУ", ОбязателенЕсли, "Номер вод. удост. водителя " + ДопИнфо, РеквизитНаФорме, , "НомВУ");
    ОбязателенЕсли = "ЛокальныйИсточник: (&НомВУ<>&ПустаяСтрока ИЛИ &ДатаВыдВУ<>&ПустаяДата)";
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "СерВУ", ОбязателенЕсли, "Серия вод. удост. водителя " + ДопИнфо, РеквизитНаФорме, , "СерВУ");
    ОбязателенЕсли = "ЛокальныйИсточник: (&СерВУ<>&ПустаяСтрока ИЛИ &НомВУ<>&ПустаяСтрока)";
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ДатаВыдВУ", ОбязателенЕсли, "Дата выдачи вод. удост. водителя " + ДопИнфо, РеквизитНаФорме);

    ОбязателенЕсли = "ЛокальныйИсточник: &СерВУ=&ПустаяСтрока И &НомВУ=&ПустаяСтрока И &ДатаВыдВУ=&ПустаяДата";
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ИННФЛ", ОбязателенЕсли, "ИНН водителя " + ДопИнфо, РеквизитНаФорме, , "ИННФЛ");
	
КонецПроцедуры

Функция ПолеОбязательноеПоФормуле(Формула, Источник)
	
	Если Не ЗначениеЗаполнено(Формула) 
		Или Не ЗначениеЗаполнено(Источник) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Условие = Формула;
	Условие = СтрЗаменить(Условие, "ЛокальныйИсточник: ", "");
	Условие = СтрЗаменить(Условие, "ОбщийИсточник: ", "");
	
	ТекстЗапроса = "ВЫБРАТЬ ИСТИНА
	|ГДЕ " + Условие;
	Запрос = Новый Запрос(ТекстЗапроса);

	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	Запрос.УстановитьПараметр("ПустаяДата", '00010101000000'); 
	
	// для наглядности пока перечисляем все возможные параметры, далее можно их вычислить из формулы.
	Запрос.УстановитьПараметр("ИННФЛ", ЗначениеСтруктурыПоКлючу(Источник, "ИННФЛ"));
	Запрос.УстановитьПараметр("СерВУ", ЗначениеСтруктурыПоКлючу(Источник, "СерВУ"));
	Запрос.УстановитьПараметр("НомВУ", ЗначениеСтруктурыПоКлючу(Источник, "НомВУ"));
	Запрос.УстановитьПараметр("ДатаВыдВУ", ЗначениеСтруктурыПоКлючу(Источник, "ДатаВыдВУ"));
	
	Запрос.УстановитьПараметр("СвГО_ГОЭксп", ЗначениеСтруктурыПоКлючу(Источник, "СвГО.ГОЭксп"));
	Запрос.УстановитьПараметр("СвПогруз_СвЛицПогрГр_СовпГОП", ЗначениеСтруктурыПоКлючу(Источник, "СвПогруз.СвЛицПогрГр.СовпГОП")); 
	
	Запрос.УстановитьПараметр("СвГруз_СвТС_ВидТС", ЗначениеСтруктурыПоКлючу(Источник, "СвГруз.СвТС.ВидТС"));
	Запрос.УстановитьПараметр("ВидТС_АВТ", "автомобильный транспорт");
	Запрос.УстановитьПараметр("ВидТС_ЖД", "железнодорожный транспорт");
	
	Запрос.УстановитьПараметр("СвПогруз_ВладИнфр_СовпГОВ", ЗначениеСтруктурыПоКлючу(Источник, "СвПогруз.ВладИнфр.СовпГОВ"));
	
	Запрос.УстановитьПараметр("ИнфУпГруз_ВидУпак", ЗначениеСтруктурыПоКлючу(Источник, "ИнфУпГруз.ВидУпак"));
	Запрос.УстановитьПараметр("ТипВлад", ЗначениеСтруктурыПоКлючу(Источник, "ТипВлад"));
		
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции


Процедура ПараметрыВалидацииТС(Результат, Префикс = Неопределено) Экспорт
	
	ИмяФормы = "ФормаТранспортногоСредства";
	
	Если Префикс = "СвТС.Прицеп" Тогда
		ДопИнфо = "прицепа";
		РеквизитНаФорме = "рл_СвТС_Прицеп";
	ИначеЕсли Префикс = "СвТС.ТС" Тогда
		ДопИнфо = "транспортного средства";
		РеквизитНаФорме = "рл_СвТС_ТС";
	Иначе
		ДопИнфо = "";
		РеквизитНаФорме = "";
	КонецЕсли;	
	
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "НомСТС", Ложь, "Номер СТС " + ДопИнфо, РеквизитНаФорме, , "НомерСТС");
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "РегНомер", Истина, "Регистрационный номер " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ТипВлад", Истина, "Тип владения " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПарТС.Тип", Истина, "Тип " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПарТС.Марка", Истина, "Марка " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПарТС.Грузопод", Истина, "Грузоподъемность " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ПарТС.Вместим", Истина, "Вместимость " + ДопИнфо, РеквизитНаФорме);
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "НомерВИН", Ложь, "VIN " + ДопИнфо, РеквизитНаФорме, , "VIN");
		
	ОбязателенЕсли = "ЛокальныйИсточник: &ТипВлад=""3"" ИЛИ &ТипВлад=""4"" ИЛИ &ТипВлад=""5"" ";
	ЗадатьПараметрыВалидации(Результат, ИмяФормы, Префикс, "ОснАрЛиз", ОбязателенЕсли, "Договор аренды " + ДопИнфо, РеквизитНаФорме); //обяз, когда ТипВлад = 3/4/5 
		
КонецПроцедуры

Процедура ПараметрыВалидацииОснАрЛиз(Результат, Префикс = Неопределено) Экспорт
	
	ИмяФормы = "ФормаДоговора";
	
