Процедура ПроверитьОбязательныеПоля(ОбщиеДанные, ЛокальныеДанные, ПараметрыВалидации, ОшибкиВалидации, Путь = "", Знач НомерСтрокиОшибки = 0) Экспорт
		
	Для Каждого КлючЗначение Из ЛокальныеДанные Цикл
		
		ИмяПоля = КлючЗначение.Ключ;
		ЗначениеПоля = КлючЗначение.Значение;

		// формируем полный путь поля
		Если Путь = "" Тогда
			ПолныйПуть = ИмяПоля;
		Иначе
			ПолныйПуть = Путь + ИмяПоля;
		КонецЕсли;
		
		// проверка выполнения условия
		Обязательное = Ложь;
		Если ПараметрыВалидации.Свойство(ИмяПоля) Тогда
			ЗначениеВалидации = ПараметрыВалидации[ИмяПоля];
			ПараметрыПоля = КлючиВалидации();
			ЗаполнитьЗначенияСвойств(ПараметрыПоля, ПараметрыВалидации[ИмяПоля]);
			Обязательное = ОбязательноеПоле(ОбщиеДанные, ЛокальныеДанные, ПараметрыПоля);
		Иначе
			ЗначениеВалидации = Новый Структура;
			ПараметрыПоля = Неопределено;
		КонецЕсли;
		// проверка выполнения условия
		
		// не проверяем поля без параметров
		Если ПараметрыПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		//проверка заполненности значения
		ЭтоСтруктура = ТипЗнч(ЗначениеПоля) = Тип("Структура");
		ЭтоМассив    = ТипЗнч(ЗначениеПоля) = Тип("Массив");
		ЗначениеПоляЗаполнено = Ложь;
		Если ЭтоСтруктура Тогда
			Если ЗначениеПоля.Свойство("Ссылка") И Не ЭтоРеквизитXML("рл_" + ПолныйПуть) Тогда
				ЗначениеПоляЗаполнено = ЗначениеЗаполнено(ЗначениеПоля.Ссылка);
			ИначеЕсли ЭтоРеквизитXML("рл_" + ПолныйПуть) Тогда
				ЗначениеПоляЗаполнено = ЗначениеЗаполнено(ЗначениеПредставление(ЗначениеПоля));
			Иначе
				ЗначениеПоляЗаполнено = ЗначениеЗаполнено(ЗначениеПоля);
			КонецЕсли;
		Иначе
			ЗначениеПоляЗаполнено = ЗначениеЗаполнено(ЗначениеПоля);
		КонецЕсли;
						
		// Проверка заполненности обязательных полей
		НезаполненоОбязательноеПоле = Обязательное И Не ЗначениеПоляЗаполнено;
			
		Если НезаполненоОбязательноеПоле Тогда
			
			Если ПараметрыПоля.Свойство("ИмяРеквизитаРодителя") И ЗначениеЗаполнено(ПараметрыПоля.ИмяРеквизитаРодителя) Тогда
				НазваниеРеквизита = СтрЗаменить("рл_" + ПолныйПуть, ПараметрыПоля.ИмяРеквизитаРодителя, "рл");
			Иначе
				НазваниеРеквизита = "рл_" + ПолныйПуть;
			КонецЕсли;
			Если ЭтоРеквизитXML(НазваниеРеквизита) Тогда
				ПараметрыПоля.Вставить("НазваниеРеквизита", "пр_" + Сред(НазваниеРеквизита, 4));
			Иначе
				ПараметрыПоля.Вставить("НазваниеРеквизита", НазваниеРеквизита);
			КонецЕсли;
						
			Если НомерСтрокиОшибки > 0 Тогда
				ПараметрыПоля.Вставить("НомерСтрокиОшибки", НомерСтрокиОшибки);
			КонецЕсли;
			
			ОшибкиВалидации.Добавить(ПараметрыПоля);
			Продолжить;
			
		КонецЕсли;

		// Если поле не заполнено — дальше не проверяем
		Если Не ЗначениеПоляЗаполнено Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверка корректности
		Если ПараметрыПоля.Свойство("ТипВалидации") Тогда
			ТекстОшибки = "";
			Корректно = ЗначениеКорректно(ЛокальныеДанные, ПараметрыПоля.ТипВалидации, ЗначениеПоля, ТекстОшибки);
			Если Не Корректно Тогда
				Если ПараметрыПоля.Свойство("ИмяРеквизитаРодителя") И ЗначениеЗаполнено(ПараметрыПоля.ИмяРеквизитаРодителя) Тогда
					НазваниеРеквизита = СтрЗаменить("рл_" + ПолныйПуть, ПараметрыПоля.ИмяРеквизитаРодителя, "рл");
				Иначе
					НазваниеРеквизита = "рл_" + ПолныйПуть;
				КонецЕсли;
				Если ПараметрыПоля.ТипВалидации = "Контейнер" Тогда
					НазваниеРеквизита = "рл_ОпГрузКонтейнерыГиперссылка";	
				КонецЕсли;
				Если ЭтоРеквизитXML(НазваниеРеквизита) Тогда
					ПараметрыПоля.Вставить("НазваниеРеквизита", "пр_" + Сред(НазваниеРеквизита, 4));
				Иначе
					ПараметрыПоля.Вставить("НазваниеРеквизита", НазваниеРеквизита);
				КонецЕсли;
				
				Если НомерСтрокиОшибки > 0  Тогда
					ПараметрыПоля.Вставить("НомерСтрокиОшибки", НомерСтрокиОшибки);
				КонецЕсли;

				ПараметрыПоля.Вставить("ТекстОшибки", ПараметрыПоля.Представление + ": " + ТекстОшибки);
				
				Если ПараметрыПоля.ТипВалидации = "VIN" Тогда
					ПараметрыПоля.ИндексКартинки = 2;
					ПараметрыПоля.Действие = "Предупреждение";
					ПараметрыПоля.ТекстОшибки = ПараметрыПоля.ТекстОшибки
					+ ". Рекомендуем проверить правильность введённого VIN-кода";
				КонецЕсли;
				
				ОшибкиВалидации.Добавить(ПараметрыПоля);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
				
		// Если заполнено и есть дочерние — проверяем их
		Если ЭтоСтруктура Тогда
			ПроверитьОбязательныеПоля(ОбщиеДанные, ЗначениеПоля, ЗначениеВалидации, ОшибкиВалидации, ПолныйПуть + "_", НомерСтрокиОшибки);
		КонецЕсли;
		
		Если ЭтоМассив Тогда 

			//массивы в массиве пока не обрабатываем
			ЭтоМассивВМассиве = Ложь;
			Если НомерСтрокиОшибки > 0 Тогда
				ЭтоМассивВМассиве = Истина;	
			КонецЕсли;
			
			Для Каждого Стр Из ЗначениеПоля Цикл
				Если ТипЗнч(Стр) = Тип("Структура") Тогда
					Если Не ЭтоМассивВМассиве Тогда
						НомерСтрокиОшибки = НомерСтрокиОшибки + 1;
					КонецЕсли;
					ПроверитьОбязательныеПоля(Стр, Стр, ЗначениеВалидации, ОшибкиВалидации, ПолныйПуть, НомерСтрокиОшибки);
				КонецЕсли;
			КонецЦикла;
			
			Если Не ЭтоМассивВМассиве Тогда
				НомерСтрокиОшибки = 0;      
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьИдентификаторыЭДО(ОбщиеДанные, ОшибкиВалидации, ИмяФормы, ИдентификаторПеревозочногоДокумента) Экспорт
	
	ПараметрыПоляГО = Неопределено;
	ПараметрыПоляПрв = Неопределено;
	ПараметрыПоляГП = Неопределено;
	ПараметрыПоляЛОП = Неопределено;
	
	ОтправительЭДО = Неопределено;
	ПолучательЭДО = Неопределено;
		
	ШаблонОшибки = "ЭДО - не выполнено сопоставление участника перевозки ""%1""";
	ЭтоШаблонЭДО = Ложь;
	
	КлючиПроверки = Новый Массив;
	Если ИмяФормы = "ФормаТрН" Тогда
		
		Сценарий = ЗначениеСтруктурыПоКлючу(ОбщиеДанные, "Сценарий");
		ЭтоШаблонЭДО = СценарийШаблон(Сценарий);
		КлючОтправителя = КлючОтправителяТрН(ОбщиеДанные, Истина);
		КлючПолучателя = КлючПолучателяТрН(ОбщиеДанные, Истина);
		РеквизитОтправителя = РеквизитОтправителяТрН(ОбщиеДанные);
		РеквизитПолучателя = РеквизитПолучателяТрН(ОбщиеДанные); 
		
		ДанныеКлюча = Новый Структура("Ключ, Реквизит", "СвГО.РекИдентГО.Ссылка", "рл_СвГО_РекИдентГО");
		КлючиПроверки.Добавить(ДанныеКлюча);
		ДанныеКлюча = Новый Структура("Ключ, Реквизит", "СвПер.Ссылка", "рл_СвПер");
		КлючиПроверки.Добавить(ДанныеКлюча);
		ДанныеКлюча = Новый Структура("Ключ, Реквизит", "СвГП.РекИдентГП.Ссылка", "рл_СвГП_РекИдентГП");
		КлючиПроверки.Добавить(ДанныеКлюча);
		ДанныеКлюча = Новый Структура("Ключ, Реквизит", "СвПогруз.СвЛицПогрГр.РекЛицПогрГр.Ссылка", "рл_СвПогруз_СвЛицПогрГр_РекЛицПогрГр");
		КлючиПроверки.Добавить(ДанныеКлюча);
		
	ИначеЕсли ИмяФормы = "ФормаЗЗ" Тогда 
		
		КлючОтправителя = "СвГО.Ссылка";
		КлючПолучателя = "СвПрв.Ссылка";
		РеквизитОтправителя = "рл_СвГО";
		РеквизитПолучателя = "рл_СвПрв";
		
		ДанныеКлюча = Новый Структура("Ключ, Реквизит", "СвГО.Ссылка", "рл_СвГО");
		КлючиПроверки.Добавить(ДанныеКлюча);
		ДанныеКлюча = Новый Структура("Ключ, Реквизит", "СвПрв.Ссылка", "рл_СвПрв");
		КлючиПроверки.Добавить(ДанныеКлюча);
		
	ИначеЕсли ИмяФормы = "ФормаПЭ" Тогда
		
		КлючОтправителя = "СвКлнт.Ссылка";
		КлючПолучателя = "СвЭксп.Ссылка";
		РеквизитОтправителя = "рл_СвКлнт";
		РеквизитПолучателя = "рл_СвЭксп";
		
		ДанныеКлюча = Новый Структура("Ключ, Реквизит", "СвКлнт.Ссылка", "рл_СвКлнт");
		КлючиПроверки.Добавить(ДанныеКлюча);
		ДанныеКлюча = Новый Структура("Ключ, Реквизит", "СвЭксп.Ссылка", "рл_СвЭксп");
		КлючиПроверки.Добавить(ДанныеКлюча);
		
	КонецЕсли;
	
	Для Каждого ДанныеКлюча Из КлючиПроверки Цикл
		Участник = ЗначениеСтруктурыПоКлючу(ОбщиеДанные, ДанныеКлюча.Ключ);
		РеквизитУчастника = ДанныеКлюча.Реквизит;
		Если ЗначениеЗаполнено(Участник) Тогда
			Если ДанныеКлюча.Ключ = КлючОтправителя Тогда
				ИдентификаторыЭДО = ИдентификаторыЭДО(Участник, Истина);
			Иначе
				ИдентификаторыЭДО = ИдентификаторыЭДО(Участник, Ложь);
			КонецЕсли;
			Если ЗначениеЗаполнено(ИдентификаторыЭДО.ТекстОшибки) Тогда
				
				ПараметрыПоля = КлючиВалидации();
				ПараметрыПоля.Вставить("ИмяФормы", ИмяФормы);
				ПараметрыПоля.Вставить("НазваниеРеквизита", РеквизитУчастника);
				ПараметрыПоля.Вставить("ТекстОшибки", ИдентификаторыЭДО.ТекстОшибки);
				ПараметрыПоля.Вставить("Действие", "ПоказатьОшибкуПодписки");
				ПараметрыПоля.Вставить("ЭтоОтправитель", Истина);
				ОшибкиВалидации.Добавить(ПараметрыПоля); 
				
			ИначеЕсли Не ЗначениеЗаполнено(ИдентификаторыЭДО.ID) Тогда
				
				ПараметрыПоля = КлючиВалидации();
				ПараметрыПоля.Вставить("ИмяФормы", ИмяФормы);
				ПараметрыПоля.Вставить("НазваниеРеквизита", РеквизитУчастника);
				ПараметрыПоля.Вставить("ТекстОшибки", СтрШаблонЛок(ШаблонОшибки, Участник));
				ПараметрыПоля.Вставить("Действие", "ПредложитьСопоставить");
				ПараметрыПоля.Вставить("ЭтоОтправитель", Истина);
				ОшибкиВалидации.Добавить(ПараметрыПоля);
				
			Иначе
				
				Если ДанныеКлюча.Ключ = КлючОтправителя Тогда
					ОтправительЭДО = Новый Структура;
					ОтправительЭДО.Вставить("ИмяФормы", ИмяФормы);
					ОтправительЭДО.Вставить("НазваниеРеквизита", РеквизитУчастника);
					ОтправительЭДО.Вставить("Участник", Участник);
					ОтправительЭДО.Вставить("ИдентификаторыЭДО_ID", ИдентификаторыЭДО.ID); 
					ОтправительЭДО.Вставить("ИдентификаторыЭДО_BoxId", ИдентификаторыЭДО.BoxId);
				ИначеЕсли ДанныеКлюча.Ключ = КлючПолучателя Тогда
					ПолучательЭДО = Новый Структура;
					ПолучательЭДО.Вставить("ИмяФормы", ИмяФормы);
					ПолучательЭДО.Вставить("НазваниеРеквизита", РеквизитУчастника);
					ПолучательЭДО.Вставить("Участник", Участник);
					ПолучательЭДО.Вставить("ИдентификаторыЭДО_ID", ИдентификаторыЭДО.ID); 
					ПолучательЭДО.Вставить("ИдентификаторыЭДО_BoxId", ИдентификаторыЭДО.BoxId);
				КонецЕсли;
				
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	ИдПолИной = ЗначениеСтруктурыПоКлючу(ОбщиеДанные, "ИдПолИной");
	Если ТипЗнч(ИдПолИной) = Тип("Массив") Тогда 
        НомерСтрокиОшибки = 1;
		Для Каждого ЗначениеИдПолИной Из ИдПолИной Цикл
			ИдентификаторыЭДО = ИдентификаторыЭДО(ЗначениеИдПолИной.Ссылка, Ложь);
			Если Не ЗначениеЗаполнено(ИдентификаторыЭДО.ID) Тогда 
				ПараметрыПоля = КлючиВалидации();
				ПараметрыПоля.Вставить("ИмяФормы", ИмяФормы);
				ПараметрыПоля.Вставить("НазваниеРеквизита", "рл_ИдПолИной");
				ПараметрыПоля.Вставить("ЗначениеРеквизита", ЗначениеИдПолИной.Ссылка);
				ПараметрыПоля.Вставить("НомерСтрокиОшибки", НомерСтрокиОшибки); 
				ПараметрыПоля.Вставить("ИмяРеквизитаТЧ", "рл_ИдПолИной"); 
				ПараметрыПоля.Вставить("ТекстОшибки", СтрШаблонЛок(ШаблонОшибки, ЗначениеИдПолИной.Ссылка));
				ПараметрыПоля.Действие = "ПредложитьСопоставить";
				ОшибкиВалидации.Добавить(ПараметрыПоля);
			КонецЕсли;
			НомерСтрокиОшибки = НомерСтрокиОшибки + 1;
		КонецЦикла;
	КонецЕсли;
	
	// по ТРН - рассматриваем только шаблоны!
	Если (ИмяФормы = "ФормаТрН" И ЭтоШаблонЭДО)
		Или ИмяФормы = "ФормаПЭ" Тогда
		Если ОтправительЭДО <> Неопределено
			И ПолучательЭДО <> Неопределено
			И ОтправительЭДО.ИдентификаторыЭДО_ID = ПолучательЭДО.ИдентификаторыЭДО_ID Тогда
			ПараметрыПоля = КлючиВалидации();
			ПараметрыПоля.Вставить("ИмяФормы", ПолучательЭДО.ИмяФормы);
			ПараметрыПоля.Вставить("НазваниеРеквизита", ПолучательЭДО.НазваниеРеквизита);
			
			ШаблонТекОшибки = "ЭДО - совпадают идентификаторы отправителя ""%1"" и получателя ""%2"" документа";
			ТекстОшибки = СтрШаблонЛок(ШаблонТекОшибки, ОтправительЭДО.Участник, ПолучательЭДО.Участник);
			
			ПараметрыПоля.Вставить("ТекстОшибки", ТекстОшибки);
			ПараметрыПоля.Действие = "ПоказатьОшибку";
			ОшибкиВалидации.Добавить(ПараметрыПоля);
		КонецЕсли;
	КонецЕсли;
		
	ЕстьКонтекстСеанса = Ложь;
	
	Если ОтправительЭДО <> Неопределено Тогда
		СтрокаКонтекстаСеанса = _Ядро.КонтекстСеанса_СтрокаКонтекста(ОтправительЭДО.ИдентификаторыЭДО_BoxId, Ложь);
		ЕстьКонтекстСеанса = (СтрокаКонтекстаСеанса <> Неопределено);
	КонецЕсли;
	
	Если НЕ ЕстьКонтекстСеанса
		И ОтправительЭДО <> Неопределено Тогда
		
		ШаблонТекОшибки =
		"Нет данных организации ""%1"" из Диадока.
		|Необходимо авторизироваться под данной организацией в модуле.
		|Сохранение и отправка перевозочного документа невозможны.";
		
		ТекстОшибки = СтрШаблонЛок(ШаблонТекОшибки, ОтправительЭДО.Участник);
		
		ПараметрыПоля = КлючиВалидации();
		ПараметрыПоля.Вставить("ИмяФормы", ИмяФормы);
		ПараметрыПоля.Вставить("НазваниеРеквизита", ОтправительЭДО.НазваниеРеквизита);
		ПараметрыПоля.Вставить("ТекстОшибки", ТекстОшибки);
		ПараметрыПоля.Действие = "ПоказатьОшибкуПодписки";
		
		ОшибкиВалидации.Вставить(0, ПараметрыПоля);
		
	КонецЕсли;
	
	Если ЕстьКонтекстСеанса
		И ОтправительЭДО <> Неопределено Тогда
		
		ЯщикДоступен = _Ядро.ПеревозочныеДокументы_ЯщикДоступен(ОтправительЭДО.ИдентификаторыЭДО_BoxId);
		
		Если НЕ ЯщикДоступен Тогда
			
			ШаблонТекОшибки =
			"Для организации ""%1"" отсутствует действующая подписка ""Логистика.Базовый"".
			|Сохранение и отправка перевозочного документа невозможны.";
			
			ТекстОшибки = СтрШаблонЛок(ШаблонТекОшибки, ОтправительЭДО.Участник);
			
			ПараметрыПоля = КлючиВалидации();
			ПараметрыПоля.Вставить("ИмяФормы", ИмяФормы);
			ПараметрыПоля.Вставить("НазваниеРеквизита", ОтправительЭДО.НазваниеРеквизита);
			ПараметрыПоля.Вставить("ТекстОшибки", ТекстОшибки);
			ПараметрыПоля.Действие = "ПоказатьОшибкуПодписки";
			
			ОшибкиВалидации.Вставить(0, ПараметрыПоля);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьКонтекстСеанса
		И ПолучательЭДО <> Неопределено
		И ОтправительЭДО <> Неопределено Тогда
		
		ПараметрыДляПроверкиВозможностиОтправки = _Ядро.ПеревозочныеДокументы_ВозможностьОтправкиПараметрыДляПроверки();
		
		Если ИмяФормы = "ФормаТрН" Тогда
			ПараметрыДляПроверкиВозможностиОтправки.ТипДокумента = ТипДокументаЭТРН();
		ИначеЕсли ИмяФормы = "ФормаЗЗ" Тогда
			ПараметрыДляПроверкиВозможностиОтправки.ТипДокумента = ТипДокументаЭЗЗ();
		ИначеЕсли ИмяФормы = "ФормаПЭ" Тогда
			ПараметрыДляПроверкиВозможностиОтправки.ТипДокумента = ТипДокументаЭПЭ();
		КонецЕсли;
		ПараметрыДляПроверкиВозможностиОтправки.CustomDocumentId = Строка(ИдентификаторПеревозочногоДокумента);
		
		ПараметрыДляПроверкиВозможностиОтправки.BoxId = ОтправительЭДО.ИдентификаторыЭДО_BoxId;
		ПараметрыДляПроверкиВозможностиОтправки.FromBoxId = ОтправительЭДО.ИдентификаторыЭДО_BoxId;
		ПараметрыДляПроверкиВозможностиОтправки.ToBoxId = ПолучательЭДО.ИдентификаторыЭДО_BoxId;
		
		Если ПараметрыДляПроверкиВозможностиОтправки.FromBoxId = ПараметрыДляПроверкиВозможностиОтправки.ToBoxId Тогда
			ПараметрыДляПроверкиВозможностиОтправки.IsInternal = Истина;
			ПараметрыДляПроверкиВозможностиОтправки.FromDepartmentId = ИдентификаторГоловногоПодразделения();
			ПараметрыДляПроверкиВозможностиОтправки.ToDepartmentId = ИдентификаторГоловногоПодразделения();
		КонецЕсли;
		
		МассивВозможностmьОтправки = _Ядро.ПеревозочныеДокументы_ВозможностьОтправкиЭПД(ПараметрыДляПроверкиВозможностиОтправки);
		
		Для Каждого ВозможностmьОтправки Из МассивВозможностmьОтправки Цикл
			Если ВозможностmьОтправки.КритичностьОшибки > 0 Тогда
				ТекстОшибки = СтрШаблонЛок("""%1"": %2", ПолучательЭДО.Участник, ВозможностmьОтправки.ТекстОшибки);
				ПараметрыПоля = КлючиВалидации();
				ПараметрыПоля.Вставить("ИмяФормы", ПолучательЭДО.ИмяФормы);
				ПараметрыПоля.Вставить("НазваниеРеквизита", ПолучательЭДО.НазваниеРеквизита);
				ПараметрыПоля.Вставить("ТекстОшибки", ТекстОшибки);
				ПараметрыПоля.ИндексКартинки = ВозможностmьОтправки.КритичностьОшибки;
				Если ВозможностmьОтправки.КритичностьОшибки = 1 Тогда
					ПараметрыПоля.Действие = "ПоказатьОшибку";
				Иначе
					ПараметрыПоля.Действие = "ПоказатьПредупреждение";
				КонецЕсли;
				ОшибкиВалидации.Добавить(ПараметрыПоля);
			КонецЕсли;
		КонецЦикла;
		
		Если ЭтоШаблонЭДО Тогда
			
			BoxId = ОтправительЭДО.ИдентификаторыЭДО_BoxId;
			
			ДоступнаОтправкаШаблона = _Ядро.Контрагенты_ОператорЭДОПринимаетЧерновики(BoxId, ПолучательЭДО.ИдентификаторыЭДО_ID);
			
			Если НЕ ДоступнаОтправкаШаблона Тогда
				
				ТекстОшибки = "Оператор ЭДО получателя шаблона не поддерживает работу с шаблонами.";
				
				ПараметрыПоля = КлючиВалидации();
				ПараметрыПоля.Вставить("ИмяФормы", ИмяФормы);
				ПараметрыПоля.Вставить("НазваниеРеквизита", ПолучательЭДО.НазваниеРеквизита);
				ПараметрыПоля.Вставить("ТекстОшибки", ТекстОшибки);
				ПараметрыПоля.Действие = "ПоказатьОшибку";
				
				ОшибкиВалидации.Вставить(0, ПараметрыПоля);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ПроверитьИСкорректироватьДействия(ОшибкиВалидации, ЭтоШаблон = Ложь) Экспорт
	
	СкорректироватьДействиеДляРеквизитовУчастниковЭПД(ОшибкиВалидации);
	Если ЭтоШаблон Тогда
		СкорректироватьДействиеШаблонов(ОшибкиВалидации);
	КонецЕсли;
	
КонецПроцедуры

Процедура СкорректироватьДействиеДляРеквизитовУчастниковЭПД(ОшибкиВалидации)
	
	РеквизитыУчастниковЭПД = Новый Массив;
	
	// ЭТрН
	РеквизитыУчастниковЭПД.Добавить("рл_СвГО_РекИдентГО");
