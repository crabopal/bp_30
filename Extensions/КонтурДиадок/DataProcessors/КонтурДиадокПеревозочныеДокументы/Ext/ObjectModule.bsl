КонецПроцедуры

Функция ПодготовитьПакет(Параметры)
	
	Пакет = Параметры.Пакет;
	ДокументУчета = Параметры.СтрокаСписка.Документ;
	
	Если Параметры.ВидПакетаРазвернутый.ID = ИдентификаторПакетаЭТрН() Тогда
		
		ПодготовитьВнутреннийПакетПриСовпаденииУчастниковДО(Пакет);
		
		_Ядро.Пакеты_ДобавитьДокументВПакет(Пакет, ДокументУчета, ИдентификаторДокументаЭТрН());
		
		Возврат Истина;
		
	ИначеЕсли Параметры.ВидПакетаРазвернутый.ID = ИдентификаторПакетаЭТрН_Шаблон() Тогда
		
		_Ядро.Пакеты_ДобавитьДокументВПакет(Пакет, ДокументУчета, ИдентификаторДокументаЭТрН_Шаблон());
		
		СлужебнаяИнформация = Пакет.Документы[0].СлужебнаяИнформация;
		
		Пакет.ПараметрыШаблона.MessageFromBoxId = Пакет.Получатель.BoxId;
		Пакет.ПараметрыШаблона.MessageToBoxId = СлужебнаяИнформация.ИдентификаторПеревозчика;
		
		Возврат Истина;
		
	ИначеЕсли Параметры.ВидПакетаРазвернутый.ID = ИдентификаторПакетаЗаказЗаявка() Тогда
		
		ПодготовитьВнутреннийПакетПриСовпаденииУчастниковДО(Пакет);
		
		_Ядро.Пакеты_ДобавитьДокументВПакет(Пакет, ДокументУчета, ИдентификаторДокументаЗаказЗаявка());
		
		Возврат Истина;

	ИначеЕсли Параметры.ВидПакетаРазвернутый.ID = ИдентификаторПакетаЭПЭ() Тогда
		
		_Ядро.Пакеты_ДобавитьДокументВПакет(Пакет, ДокументУчета, ИдентификаторДокументаЭПЭ());
		
		Возврат Истина;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;

КонецФункции

Процедура ПодготовитьВнутреннийПакетПриСовпаденииУчастниковДО(Пакет)
	
	ЭтоВнутреннийДокумент = (Пакет.Отправитель.BoxId = Пакет.Получатель.BoxId);
	
	Если ЭтоВнутреннийДокумент Тогда
		
		Пакет.Направление = _Ядро.Перечисление_Направления().Внутреннее;
		Пакет.Отправитель.DepartmentId = ИдентификаторГоловногоПодразделения();
		Пакет.Получатель.DepartmentId = ИдентификаторГоловногоПодразделения();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПодготовитьЭлектронныйДокумент(Параметры)
	
	ВидДокументаID = Параметры.ВидДокументаРазвернутый.ID;
	
	Если ВидДокументаID = ИдентификаторДокументаЭТрН()
		ИЛИ ВидДокументаID = ИдентификаторДокументаЭТрН_Шаблон() Тогда
		
		ФорматДок = ИмяТитулаТрнПоНомеру(1);
		Документ1С = Параметры.Результат.Документ1С;
		Результат = Параметры.Результат;
		
		ИдентификаторТрН = ИдентификаторТрН(Документ1С);
		ДокументыОснования = ДокументыОснования(КлючИдентификатораТрН(), ИдентификаторТрН);
		СообщениеТрН = ПодготовитьСообщениеТрН(ФорматДок, ИдентификаторТрН, ДокументыОснования, Документ1С, Параметры);
		
		ТекстXML = СобратьXmlПоДокументу(СообщениеТрН, ФорматДок, Параметры);
		
		КодировкаДвоичныхДанных = "windows-1251";
		Результат.ДвоичныеДанные = ДвоичныеДанныеЭлектронногоДокумента(ТекстXML, КодировкаДвоичныхДанных);
		Результат.Content = Новый Структура(ТипДокументаЭТРН(), СообщениеТрН);
		
		ЗаполнитьРеквизитыЭлектронногоДокумента(Результат, СообщениеТрН.ДатаТрН, СообщениеТрН.НомерТрН);
		ЗаполнитьПараметрыЭлектронногоДокумента(Параметры, СообщениеТрН, ИдентификаторТрН);
		
		Если ВидДокументаID = ИдентификаторДокументаЭТрН_Шаблон() Тогда
			
			НастройкаШаблона_РедактируютсяВсеПоляКонтента = "9D2B3E4A-7F1C-4E55-A6D0-1E8C5F2B9A37";
			
			Параметры.Результат.ПараметрыШаблона.EditingSettingId = НастройкаШаблона_РедактируютсяВсеПоляКонтента;
			Параметры.Результат.ПараметрыШаблона.RefusalDisabled = Истина;
			
		КонецЕсли;
		
		Возврат Истина;
		
	ИначеЕсли ВидДокументаID = ИдентификаторДокументаЗаказЗаявка() Тогда
		
		ФорматДок = ИмяТитулаЗЗПоНомеру(1);
		Документ1С = Параметры.Результат.Документ1С;
		Результат = Параметры.Результат;
		
		ИдентификаторЗЗ = ИдентификаторЗЗ(Документ1С);
		ДокументыОснования = ДокументыОснования(КлючИдентификатораЗЗ(), ИдентификаторЗЗ);
		СообщениеЗЗ = ПодготовитьСообщениеЗЗ(ФорматДок, ИдентификаторЗЗ, ДокументыОснования, Документ1С, Параметры);
		
		ТекстXML = СобратьXmlПоДокументу(СообщениеЗЗ, ФорматДок, Параметры);
		
		КодировкаДвоичныхДанных = "windows-1251";
		Результат.ДвоичныеДанные = ДвоичныеДанныеЭлектронногоДокумента(ТекстXML, КодировкаДвоичныхДанных);
		Результат.Content = Новый Структура(ТипДокументаЭЗЗ(), СообщениеЗЗ);
		
		ЗаполнитьРеквизитыЭлектронногоДокумента(Результат, СообщениеЗЗ.ДатаЗак, СообщениеЗЗ.НомЗак);
		ЗаполнитьПараметрыЭлектронногоДокумента(Параметры, СообщениеЗЗ, ИдентификаторЗЗ);
		
		Возврат Истина;
		
	ИначеЕсли ВидДокументаID = ИдентификаторДокументаЭПЭ() Тогда
		
		ФорматДок = ИмяТитулаПЭПоНомеру(1);
		Документ1С = Параметры.Результат.Документ1С;
		Результат = Параметры.Результат;
		
		ИдентификаторПЭ = ИдентификаторПЭ(Документ1С);
		ДокументыОснования = ДокументыОснования(КлючИдентификатораПЭ(), ИдентификаторПЭ);
		СообщениеПЭ = ПодготовитьСообщениеПЭ(ФорматДок, ИдентификаторПЭ, ДокументыОснования, Документ1С, Параметры);
		
		КодировкаXML = "utf-8"; 
		ТекстXML = СобратьXmlПоДокументу(СообщениеПЭ, ФорматДок, Параметры, КодировкаXML);
		
		КодировкаДвоичныхДанных = "CESU-8";
		Результат.ДвоичныеДанные = ДвоичныеДанныеЭлектронногоДокумента(ТекстXML, КодировкаДвоичныхДанных);
		Результат.Content = Новый Структура(ТипДокументаЭПЭ(), СообщениеПЭ);
		
		ЗаполнитьРеквизитыЭлектронногоДокумента(Результат, СообщениеПЭ.ДатаДок, СообщениеПЭ.НомДок);
		ЗаполнитьПараметрыЭлектронногоДокумента(Параметры, СообщениеПЭ, ИдентификаторПЭ);
		
		Возврат Истина;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ДвоичныеДанныеЭлектронногоДокумента(ТекстXML, Кодировка)
	
	ИмяВремФайла = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXml = Новый ЗаписьXML;
	ЗаписьXml.ОткрытьФайл(ИмяВремФайла, Кодировка);
	ЗаписьXml.ЗаписатьБезОбработки(ТекстXML);
	ЗаписьXml.Закрыть();
	
	Результат = Новый ДвоичныеДанные(ИмяВремФайла);
	
	УдалитьФайлы(ИмяВремФайла);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьРеквизитыЭлектронногоДокумента(Результат, ДатаДокумента, НомерДокумента)
	
	Результат.ДатаСоздания = ТекущаяДатаСеанса();
	
	Результат.ДатаДокумента = ДатаДокумента;
	Результат.НомерДокумента = НомерДокумента;
	Результат.РеквизитыДокумента.Дата = ДатаДокумента;
	Результат.РеквизитыДокумента.Номер = НомерДокумента;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыЭлектронногоДокумента(Параметры, СообщениеЭПД, ИдентификаторЭПД)
	
	Если Параметры.ДополнительныеПараметры = Неопределено  Тогда
		Параметры.ДополнительныеПараметры = Новый Структура();
	КонецЕсли;
	
	ДопПараметры = Параметры.ДополнительныеПараметры;
	
	ВидДокументаID = Параметры.ВидДокументаРазвернутый.ID;
	
	Если ВидДокументаID = ИдентификаторДокументаЭТрН()
		ИЛИ ВидДокументаID = ИдентификаторДокументаЭТрН_Шаблон() Тогда
		
		ДополнитьДопПараметрыЭТрНИдентификаторамиУчастников(ДопПараметры, СообщениеЭПД);
		
	ИначеЕсли ВидДокументаID = ИдентификаторДокументаЗаказЗаявка() Тогда
		
		ДополнитьДопПараметрыЗЗИдентификаторамиУчастников(ДопПараметры, СообщениеЭПД);
		
	ИначеЕсли ВидДокументаID = ИдентификаторДокументаЭПЭ() Тогда
		
		ДополнитьДопПараметрыЭПЭИдентификаторамиУчастников(ДопПараметры, СообщениеЭПД);
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Вставить(КлючИдентификаторПеревозочногоДокумента(), Строка(ИдентификаторЭПД));
	
	Параметры.Результат.ЗапрашиватьОтветнуюПодпись = Истина;
	
КонецПроцедуры

Процедура ДополнитьДопПараметрыЭТрНИдентификаторамиУчастников(ДопПараметры, СообщениеТрН)
	
	СтруктураУчастников = Новый Структура();
	
	УчастникГОСсылка = СообщениеТрН.СвГО.РекИдентГО.Ссылка;
	УчастникГО = Контракт_СтруктураУчастника(УчастникГОСсылка, Истина);
	СтруктураУчастников.Вставить("УчастникГО", УчастникГО);
	
	УчастникПерСсылка = СообщениеТрН.СвПер.Ссылка;
	УчастникПер = Контракт_СтруктураУчастника(УчастникПерСсылка, Ложь);
	СтруктураУчастников.Вставить("УчастникПер", УчастникПер);
	
	УчастникГПСсылка = СообщениеТрН.СвГп.РекИдентГП.Ссылка;
	УчастникГП = Контракт_СтруктураУчастника(УчастникГПСсылка, Ложь);
	СтруктураУчастников.Вставить("УчастникГП", УчастникГП);
	
	ЗаполнитьИдентификаторыЭДОУчастников(СтруктураУчастников);
	
	УчастникГО = СтруктураУчастников.УчастникГО;
	ДопПараметры.Вставить(КлючИдентификаторГО(), УчастникГО.Идентификатор);
	УчастникПер = СтруктураУчастников.УчастникПер;
	ДопПараметры.Вставить(КлючИдентификаторПер(), УчастникПер.Идентификатор);
	УчастникГП = СтруктураУчастников.УчастникГП;
	ДопПараметры.Вставить(КлючИдентификаторГП(), УчастникГП.Идентификатор);
	
КонецПроцедуры

Процедура ДополнитьДопПараметрыЗЗИдентификаторамиУчастников(ДопПараметры, СообщениеЗЗ)
	
	СтруктураУчастников = Новый Структура();
	
	УчастникГОСсылка = СообщениеЗЗ.СвГО.Ссылка;
	УчастникГО = Контракт_СтруктураУчастника(УчастникГОСсылка, Истина);
	СтруктураУчастников.Вставить("УчастникГО", УчастникГО);
	
	УчастникПерСсылка = СообщениеЗЗ.СвПрв.Ссылка;
	УчастникПер = Контракт_СтруктураУчастника(УчастникПерСсылка, Ложь);
	СтруктураУчастников.Вставить("УчастникПер", УчастникПер);
	
	ЗаполнитьИдентификаторыЭДОУчастников(СтруктураУчастников);
	
	УчастникГО = СтруктураУчастников.УчастникГО;
	ДопПараметры.Вставить(КлючИдентификаторГО(), УчастникГО.Идентификатор);
	УчастникПер = СтруктураУчастников.УчастникПер;
	ДопПараметры.Вставить(КлючИдентификаторПер(), УчастникПер.Идентификатор);
	
КонецПроцедуры

Процедура ДополнитьДопПараметрыЭПЭИдентификаторамиУчастников(ДопПараметры, СообщениеПЭ)
	
	СтруктураУчастников = Новый Структура();
	
	УчастникКлнтСсылка = СообщениеПЭ.СвКлнт.Ссылка;
	УчастникКлнт = Контракт_СтруктураУчастника(УчастникКлнтСсылка, Истина);
	СтруктураУчастников.Вставить("УчастникГО", УчастникКлнт);
	
	УчастникЭкспСсылка = СообщениеПЭ.СвЭксп.Ссылка;
	УчастникЭксп = Контракт_СтруктураУчастника(УчастникЭкспСсылка, Ложь);
	СтруктураУчастников.Вставить("УчастникПер", УчастникЭксп);
		
	ЗаполнитьИдентификаторыЭДОУчастников(СтруктураУчастников);
	
	УчастникГО = СтруктураУчастников.УчастникГО;
	ДопПараметры.Вставить(КлючИдентификаторГО(), УчастникГО.Идентификатор);
	УчастникПер = СтруктураУчастников.УчастникПер;
	ДопПараметры.Вставить(КлючИдентификаторПер(), УчастникПер.Идентификатор);
	
КонецПроцедуры

