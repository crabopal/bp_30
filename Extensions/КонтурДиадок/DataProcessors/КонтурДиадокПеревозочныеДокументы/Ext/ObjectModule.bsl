КонецПроцедуры

Процедура ОбработатьАдрПункт(ДокументыОснования, АдрПункт, СвГО, Контрагент, ДанныеАдреса = Неопределено) Экспорт
	
	//связь по документу основанию.
	Если ДокументыОснования.Количество() > 0 Тогда 
		
		ОсновнойДокумент = ДокументыОснования[0];
		НеИзменятьАдреса = Новый Массив;
		//по основному документу адрес берем из СвГО и из адреса формы
		
		//удалить из текущих пунктов, те которых нет в документах оснований
		ВсегоПунктов = АдрПункт.Количество();
		Пока ВсегоПунктов > 0 Цикл
			ВсегоПунктов = ВсегоПунктов - 1;
			текПункт = АдрПункт[ВсегоПунктов];
			Если ЗначениеЗаполнено(текПункт.техДокОсн)
				И ДокументыОснования.Найти(текПункт.техДокОсн) = Неопределено Тогда
				АдрПункт.Удалить(ВсегоПунктов);	
			ИначеЕсли ЗначениеЗаполнено(текПункт.техДокОсн) Тогда
				НеИзменятьАдреса.Добавить(текПункт.техДокОсн);
			КонецЕсли;
		КонецЦикла;
		
		ИндексОснПогрузка = Неопределено;
		Индекс = -1;
		Для Каждого текПункт Из АдрПункт Цикл
			Индекс = Индекс + 1;
			Если текПункт.техДокОсн = ОсновнойДокумент И текПункт.Опер = "Погрузка" Тогда
				ИндексОснПогрузка = Индекс;
            	Прервать;
			КонецЕсли;
		КонецЦикла;
		
		//адрес по основному документу синхронизируем по переданным данным.
		Если ДанныеАдреса = Неопределено Тогда
			ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдресаИТочкиДоставки(СвГО);
			Если ДанныеКонтактнаяИнформацияАдреса.Количество() > 0 Тогда
				ДанныеАдреса = ДанныеКонтактнаяИнформацияАдреса[0];
			КонецЕсли;
		КонецЕсли;
		Если ДанныеАдреса <> Неопределено Тогда
			ДобавитьАдрПункт(АдрПункт, ИндексОснПогрузка, ОсновнойДокумент,
			"Погрузка",
			СвГО,
			ДанныеАдреса.Адрес,
			"643",
			ДанныеАдреса.АдресРФ);
		КонецЕсли;
		
		//добавить только новые, текущие изменять не будем, поскольку могло быть ручное изменение.
		Для Каждого ДокументОснование Из ДокументыОснования Цикл 
			
			мтд = ДокументОснование.Метаданные();
			Если мтд.Имя = "ЗаданиеНаПеревозку" Тогда
				Продолжить;	
			КонецЕсли;
			
			Если НеИзменятьАдреса.Найти(ДокументОснование) <> Неопределено Тогда
				Продолжить;	
			КонецЕсли;
			
			ДанныеАдреса = Неопределено;
			ВладелецПункта = Неопределено;
			
			ДанныеКонтрагента = Новый Структура("Организация, Контрагент, АдресДоставки, АдресДоставкиЗначение, СкладПолучатель");
			ЗаполнитьЗначенияСвойств(ДанныеКонтрагента, ДокументОснование);
			Если ЗначениеЗаполнено(ДанныеКонтрагента.Контрагент) Тогда
				ВладелецПункта = ДанныеКонтрагента.Контрагент;
			ИначеЕсли ЗначениеЗаполнено(Контрагент) Тогда
				ВладелецПункта = Контрагент;
			Иначе			
				ВладелецПункта = ДанныеКонтрагента.Организация;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеКонтрагента.АдресДоставки)  Тогда
				ДанныеАдреса = АдресТип_Вер3();
				ДанныеАдреса.Адрес = ДанныеКонтрагента.АдресДоставки;
				ДанныеАдреса.АдресРФ = ДанныеКонтрагента.АдресДоставкиЗначение;
				ДанныеАдреса.АдресКодСтраны = "643";
			ИначеЕсли ЗначениеЗаполнено(ДанныеКонтрагента.СкладПолучатель) Тогда
				ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдресаИТочкиДоставки(ДанныеКонтрагента.СкладПолучатель);				
				Если ДанныеКонтактнаяИнформацияАдреса.Количество() > 0 Тогда
					ДанныеАдреса = ДанныеКонтактнаяИнформацияАдреса[0];			
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(ДанныеКонтрагента.Контрагент) Тогда
				ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдресаИТочкиДоставки(ДанныеКонтрагента.Контрагент);				
				Если ДанныеКонтактнаяИнформацияАдреса.Количество() > 0 Тогда
					ДанныеАдреса = ДанныеКонтактнаяИнформацияАдреса[0];			
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(Контрагент) Тогда
				ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдресаИТочкиДоставки(Контрагент);				
				Если ДанныеКонтактнаяИнформацияАдреса.Количество() > 0 Тогда
					ДанныеАдреса = ДанныеКонтактнаяИнформацияАдреса[0];			
				КонецЕсли;
			КонецЕсли;
			
			Если ДанныеАдреса <> Неопределено Тогда
				ДобавитьАдрПункт(АдрПункт, Неопределено, ДокументОснование,
				"Выгрузка",
				ВладелецПункта,
				ДанныеАдреса.Адрес,
				"643",
				ДанныеАдреса.АдресРФ);
			Иначе
				ДобавитьАдрПункт(АдрПункт, Неопределено, ДокументОснование,
				"Выгрузка",
				ВладелецПункта,
				Неопределено,
				Неопределено,
				Неопределено);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ДобавитьАдрПункт(АдрПункт, ТекущийИндекс, техДокОсн, Опер, ОргВладИнфр, АдрТекст, КодСтр, АдрРФ)
	
	Поиск = Новый Структура;
	Поиск.Вставить("ОргВладИнфр", ОргВладИнфр);

	НовыйПункт = АдрПунктТип();
	НовыйПункт.Опер = Опер;
	НовыйПункт.ДатВрОпер = ТекущаяДата();
	//НовыйПункт.ПредВрОпер = НовыйПункт.ДатВрОпер + 10;
	НовыйПункт.АдресПункт.Адрес.АдрИнф.АдрТекст = АдрТекст;
	НовыйПункт.АдресПункт.Адрес.АдрИнф.КодСтр = КодСтр;
	НовыйПункт.АдресПункт.Адрес.АдрРФ = АдрРФ;
	НовыйПункт.ОргВладИнфр = ОргВладИнфр;
	НовыйПункт.техДокОсн = техДокОсн;
	
	Если ТекущийИндекс = Неопределено Тогда
		Если Опер = "Погрузка" Тогда
			АдрПункт.Вставить(0, НовыйПункт);         
		Иначе
			АдрПункт.Добавить(НовыйПункт);         
		КонецЕсли;
	Иначе 
		АдрПункт[ТекущийИндекс] = НовыйПункт;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьАдресаПоУчастнику(Адреса, АдресаПоПредставлению, Участник) Экспорт

	Если ЗначениеЗаполнено(Участник) Тогда
		Поиск = Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
		КонтактнаяИнформация = ДанныеКонтактнаяИнформацияАдреса(Участник);
		Для Каждого СтрокаАдреса Из КонтактнаяИнформация Цикл
			Адрес = СтрокаАдреса.Адрес;
			АдресРФ = СтрокаАдреса.АдресРФ;
			ДобавитьАдресВСписок(Адреса, АдресаПоПредставлению, Адрес, АдресРФ);
		КонецЦикла;
		
		//точки доставки
		АдресаТочекДоставки = АдресаТочекДоставки(Участник);
		Для Каждого СтрокаАдреса Из АдресаТочекДоставки Цикл
			Адрес = СтрокаАдреса.Адрес;
			АдресРФ = СтрокаАдреса.АдресРФ;
			ПредставлениеАдреса = СтрокаАдреса.Представление;
			ДобавитьАдресВСписок(Адреса, АдресаПоПредставлению, Адрес, АдресРФ, ПредставлениеАдреса);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьАдресВСписок(Адреса, АдресаПоПредставлению, Адрес, АдресРФ, ПредставлениеАдреса = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Адрес) 
		И АдресаПоПредставлению.Найти(Адрес) = Неопределено Тогда
		ЗначениеАдреса = АдресРФ;
		Если ПредставлениеАдреса = Неопределено Тогда
			ПредставлениеАдреса = Адрес;
		КонецЕсли;
		Адреса.Добавить(Новый Структура("Адрес, ЗначениеАдреса, ПредставлениеАдреса", Адрес, ЗначениеАдреса, ПредставлениеАдреса));		
		АдресаПоПредставлению.Добавить(Адрес)
	КонецЕсли;
	
КонецПроцедуры

Функция СкладПогрузки(ОсновнойДокумент)
	
	Результат = Неопределено;

	МетаданныеДокумента = ОсновнойДокумент.Метаданные().ПолноеИмя();
	Если ЕстьРеквизитМетаданных(МетаданныеДокумента, "Склад") Тогда
		Результат = ОсновнойДокумент.Склад;                                     
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеДокумента, "СкладОтправитель") Тогда
		Результат = ОсновнойДокумент.СкладОтправитель;
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеДокумента, "СтруктурнаяЕдиница") Тогда //УНФ
		Результат = ОсновнойДокумент.СтруктурнаяЕдиница;
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеДокумента, "СкладКомпании") Тогда //аааа
		Результат = ОсновнойДокумент.СкладКомпании;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СкладДоставки(ОсновнойДокумент)
	
	Результат = Неопределено;
	
	МетаданныеДокумента = ОсновнойДокумент.Метаданные();
	Если ЕстьРеквизитМетаданных(МетаданныеДокумента, "СкладПолучатель") Тогда
		Результат = ОсновнойДокумент.СкладПолучатель;
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеДокумента, "СтруктурнаяЕдиницаПолучатель") Тогда //УНФ
		Результат = ОсновнойДокумент.СтруктурнаяЕдиницаПолучатель;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьАдресаДоставки(Адреса, АдресаПоПредставлению, ОсновнойДокумент) Экспорт
	
	Если ЗначениеЗаполнено(ОсновнойДокумент) Тогда
		
		МетаданныеДокумента = ОсновнойДокумент.Метаданные();
		СкладДоставки = СкладДоставки(ОсновнойДокумент);
		
		Если ЗначениеЗаполнено(СкладДоставки) Тогда
			ДобавитьАдресаПоУчастнику(Адреса, АдресаПоПредставлению, СкладДоставки);
		КонецЕсли;  
		
		Если ЕстьРеквизитМетаданных(МетаданныеДокумента, "АдресДоставкиЗначение") 
			И ЕстьРеквизитМетаданных(МетаданныеДокумента, "АдресДоставки") Тогда
			Адрес = ОсновнойДокумент.АдресДоставки;
			АдресРФ = ОсновнойДокумент.АдресДоставкиЗначение;
			ДобавитьАдресВСписок(Адреса, АдресаПоПредставлению, Адрес, АдресРФ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьАдресаПогрузки(Адреса, АдресаПоПредставлению, ОсновнойДокумент) Экспорт
	
	Если ЗначениеЗаполнено(ОсновнойДокумент) Тогда
		
		СкладПогрузки = СкладПогрузки(ОсновнойДокумент);
		
		Если ЗначениеЗаполнено(СкладПогрузки) Тогда
			ДобавитьАдресаПоУчастнику(Адреса, АдресаПоПредставлению, СкладПогрузки);
		КонецЕсли;
		
	КонецЕсли;  
	
КонецПроцедуры


