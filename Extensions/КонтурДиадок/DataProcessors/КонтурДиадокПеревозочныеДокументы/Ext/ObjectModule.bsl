	ПрефиксСвойств = ?(СвязьРегистровСведений = "Объект", ПрефиксЭПЭ(), "");
	//} ааа5
	
	// выбирается основной документ, либо первый
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СведенияОсновнойДокумент.Значение, ДополнительныеСведения.Объект) КАК Документ,
	|	ДополнительныеСведения." + СвязьРегистровСведений + " КАК ИдентификаторДокумента,
