Функция ДанныеКонтактнаяИнформацияАдреса(СсылкаНаОбъект, Рекурсия = Ложь) Экспорт
	
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Результат;
	КонецЕсли;
	
	_СсылкаНаОбъект = СсылкаНаОбъект;
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	Если Не Рекурсия И МетаданныеОбъекта.Реквизиты.Найти("ИндивидуальныйПредприниматель") <> Неопределено Тогда
		ЗначениеИП = СсылкаНаОбъект.ИндивидуальныйПредприниматель;
		Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗначениеИП))
			И ЗначениеЗаполнено(ЗначениеИП) Тогда
			//соберем информацию с 2х источников.
			Результат = ДанныеКонтактнаяИнформацияАдреса(ЗначениеИП, Истина);
		КонецЕсли;
	КонецЕсли;
	
	ТипКИ = ТипКонтактнойИнформации_Адрес(); 
	
	Варианты = Новый Массив; 
	Варианты.Добавить("АдресСклада");
	Варианты.Добавить("Адрес");
	Варианты.Добавить("АдресДоставкиКонтрагента");
	Варианты.Добавить("Адрес доставки");
	Варианты.Добавить("ФактАдресКонтрагента");
	Варианты.Добавить("ФактическийАдресКонтрагента"); 
	Варианты.Добавить("Фактический адрес контрагента");	
	Варианты.Добавить("ФактАдресОрганизации");
	Варианты.Добавить("ФактическийАдресОрганизации");
	Варианты.Добавить("Фактический адрес организации");		
	Варианты.Добавить("ФактАдресФизЛица");
	Варианты.Добавить("Адрес проживания физ. лица");
	Варианты.Добавить("Фактический адрес");	
		
	ВидыКИ = ПредопределенныеЭлементыСправочника("ВидыКонтактнойИнформации", Варианты);
	
	ТекстЗапроса = ТекстЗапросаКонтактнаяИнформация(_СсылкаНаОбъект, Ложь);
	
	Если ТекстЗапроса <> Неопределено Тогда
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("СсылкаНаОбъект", _СсылкаНаОбъект);
		Запрос.УстановитьПараметр("ТипКИ", ТипКИ); 

		РезультатЗапроса = Запрос.Выполнить(); 
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтруктураАдреса = АдресТип_Вер3();
			СтруктураАдреса.Адрес = Выборка.Значение;
			СтруктураАдреса.АдресКодСтраны = Выборка.КодСтраны;
			СтруктураАдреса.АдресРФ = Выборка.ЗначенияПолей;
			ЕстьПорядок = ВидыКИ.Найти(Выборка.Вид);
			Если ЕстьПорядок <> Неопределено Тогда
				Результат.Вставить(0, СтруктураАдреса);
			Иначе
				Результат.Добавить(СтруктураАдреса);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция АдресаТочекДоставки(Участник)
	
	Результат = Новый Массив;

	мтдУчастник = Участник.Метаданные();
	мтдПартнер = Метаданные.Справочники.Найти("Партнеры");
	мтдТочкиДоставки = Метаданные.Справочники.Найти("ТочкиДоставки");

	// проверка что все метаданные существуют
	Если мтдТочкиДоставки <> Неопределено
		И ЕстьРеквизитМетаданных(мтдТочкиДоставки, "ОсновнаяТочка") 
		И ЕстьРеквизитМетаданных(мтдТочкиДоставки, "Адрес") 
		И ЕстьРеквизитМетаданных(мтдТочкиДоставки, "АдресЗначение") 
		И ЕстьРеквизитМетаданных(мтдТочкиДоставки, "АдресЗначенияПолей") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТочкиДоставки.Адрес КАК Адрес,
		|	ТочкиДоставки.АдресЗначение КАК Значение,
		|	ТочкиДоставки.АдресЗначенияПолей КАК ЗначенияПолей,
		|	""643"" КАК КодСтраны,
		|	ТочкиДоставки.Наименование КАК Представление,
		|	ТочкиДоставки.ОсновнаяТочка КАК ОсновнаяТочка
		|ИЗ
		|	Справочник.ТочкиДоставки КАК ТочкиДоставки
		|ГДЕ
		|	ТочкиДоставки.Владелец = &Владелец";
		Запрос = Новый Запрос(ТекстЗапроса);
		Если мтдПартнер <> Неопределено
			И ЕстьРеквизитМетаданных(мтдУчастник, "Партнер") Тогда
			Запрос.УстановитьПараметр("Владелец", Участник.Партнер);
		ИначеЕсли мтдУчастник.Имя = "Склады" Тогда
			Запрос.УстановитьПараметр("Владелец", Участник);
		Иначе
			Запрос.УстановитьПараметр("Владелец", Неопределено);
		КонецЕсли;

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтруктураАдреса = АдресТип_Вер3();
			СтруктураАдреса.Адрес = Выборка.Адрес;
			СтруктураАдреса.АдресКодСтраны = Выборка.КодСтраны;
			СтруктураАдреса.АдресРФ = ?(ЗначениеЗаполнено(Выборка.Значение), Выборка.Значение, Выборка.ЗначенияПолей);
			СтруктураАдреса.Представление = Выборка.Представление + " (точка доставки)";
			Если Выборка.ОсновнаяТочка Тогда
				Результат.Вставить(0, СтруктураАдреса);
			Иначе
				Результат.Добавить(СтруктураАдреса);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ДанныеКонтактнаяИнформацияАдресаИТочкиДоставки(Участник) Экспорт
		
	Результат = Новый Массив;
	АдресаПоПредставлению = Новый Массив;

	Если ЗначениеЗаполнено(Участник) Тогда
		ДанныеКонтактнаяИнформацияАдреса = ДанныеКонтактнаяИнформацияАдреса(Участник);
		Для Каждого ДанныеАдреса Из ДанныеКонтактнаяИнформацияАдреса Цикл
			Если ЗначениеЗаполнено(ДанныеАдреса.Адрес) 
				И АдресаПоПредставлению.Найти(ДанныеАдреса.Адрес) = Неопределено Тогда
				Результат.Добавить(ДанныеАдреса);
				АдресаПоПредставлению.Добавить(ДанныеАдреса.Адрес)
        	КонецЕсли;
		КонецЦикла;
		
		АдресаТочекДоставки = АдресаТочекДоставки(Участник);
		Для Каждого ДанныеАдреса Из АдресаТочекДоставки Цикл
			Если ЗначениеЗаполнено(ДанныеАдреса.Адрес) 
				И АдресаПоПредставлению.Найти(ДанныеАдреса.Адрес) = Неопределено Тогда
				Результат.Добавить(ДанныеАдреса);
				АдресаПоПредставлению.Добавить(ДанныеАдреса.Адрес)
        	КонецЕсли;
		КонецЦикла;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеКонтактнаяИнформацияАдресаЭП(СсылкаНаОбъект, Рекурсия = Ложь)
	
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Результат;
	КонецЕсли;
	
	_СсылкаНаОбъект = СсылкаНаОбъект;
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	Если Не Рекурсия И МетаданныеОбъекта.Реквизиты.Найти("ИндивидуальныйПредприниматель") <> Неопределено Тогда
		ЗначениеИП = СсылкаНаОбъект.ИндивидуальныйПредприниматель;
		Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗначениеИП))
			И ЗначениеЗаполнено(ЗначениеИП) Тогда
			//соберем информацию с 2х источников.
			Результат = ДанныеКонтактнаяИнформацияАдресаЭП(ЗначениеИП, Истина);
