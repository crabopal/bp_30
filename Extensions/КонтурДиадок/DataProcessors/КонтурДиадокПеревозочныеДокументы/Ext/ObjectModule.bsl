Функция ИмяРегистраДополнительныеСвойства()

	Результат = Неопределено;

	// по владельцу значений доп. сведений
	ИмяХарактеристикДополнительныеСвойства = ИмяВладельцаЗначенийДополнительныхСвойств();
	
	Если ИмяХарактеристикДополнительныеСвойства <> Неопределено Тогда

		ИмяРегистраДополнительныеСвойства = "ДополнительныеСведения";
		ИмяХарактеристикПоРегиструДополнительныхСвойств = ИмяХарактеристикПоРегиструДополнительныхСвойств(ИмяРегистраДополнительныеСвойства);
		Если ИмяХарактеристикДополнительныеСвойства = ИмяХарактеристикПоРегиструДополнительныхСвойств Тогда
			Результат = ИмяРегистраДополнительныеСвойства;
		КонецЕсли;

		ИмяРегистраДополнительныеСвойства = "ЗначенияСвойствОбъектов";
		ИмяХарактеристикПоРегиструДополнительныхСвойств = ИмяХарактеристикПоРегиструДополнительныхСвойств(ИмяРегистраДополнительныеСвойства);
		Если ИмяХарактеристикДополнительныеСвойства = ИмяХарактеристикПоРегиструДополнительныхСвойств Тогда
			Результат = ИмяРегистраДополнительныеСвойства;
		КонецЕсли;

	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = "ДополнительныеСведения";
		Если Метаданные.РегистрыСведений.Найти("ДополнительныеСведения") = Неопределено Тогда
			Результат = "ЗначенияСвойствОбъектов";
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция ИмяСправочникаДополнительныеСвойства() Экспорт
	
	Результат = "ЗначенияСвойствОбъектов";
	Если Метаданные.Справочники.Найти("ЗначенияСвойствОбъектов") = Неопределено Тогда
		Результат = "ЗначенияСвойств";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяХарактеристикДополнительныеСвойства()
	
	Результат = Неопределено;
	
	// по владельцу значений доп. сведений
	Результат = ИмяВладельцаЗначенийДополнительныхСвойств();

	// по свойству регистра сведений доп. сведений
	Если Результат = Неопределено Тогда 
		ИмяРегистраДополнительныеСвойства = ИмяРегистраДополнительныеСвойства();
		Результат = ИмяХарактеристикПоРегиструДополнительныхСвойств(ИмяРегистраДополнительныеСвойства);
	КонецЕсли;
	
	// по имени, не должно использоваться
	Если Результат = Неопределено 
		И Метаданные.ПланыВидовХарактеристик.Найти("ДополнительныеРеквизитыИСведения") <> Неопределено Тогда
		Результат = "ДополнительныеРеквизитыИСведения";
	КонецЕсли;
	
	// по имени, не должно использоваться
	Если Результат = Неопределено 
		И Метаданные.ПланыВидовХарактеристик.Найти("СвойстваОбъектов") <> Неопределено Тогда
		Результат = "СвойстваОбъектов";
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

Функция ИмяХарактеристикПоРегиструДополнительныхСвойств(ИмяРегистраДополнительныеСвойства)
	
	Результат = Неопределено;
	
	МетаданныеРегистра = Метаданные.РегистрыСведений.Найти(ИмяРегистраДополнительныеСвойства);
	Если МетаданныеРегистра <> Неопределено Тогда
		ИзмерениеСвойство = МетаданныеРегистра.Измерения.Найти("Свойство");
		Если ИзмерениеСвойство <> Неопределено Тогда
			МетаданныеСвойства = Метаданные.НайтиПоТипу(ИзмерениеСвойство.Тип.Типы()[0]);
			Если МетаданныеСвойства <> Неопределено Тогда
				Результат = МетаданныеСвойства.Имя;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции


Функция ИмяВладельцаЗначенийДополнительныхСвойств()
	
	Результат = Неопределено;
	
	ИмяСправочникаДополнительныеСвойства = ИмяСправочникаДополнительныеСвойства();
	МетаданныеСправочника = Метаданные.Справочники.Найти(ИмяСправочникаДополнительныеСвойства);
	Если МетаданныеСправочника <> Неопределено Тогда
		Для Каждого ВладелецСправочника Из МетаданныеСправочника.Владельцы Цикл
			Результат = ВладелецСправочника.Имя;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьПолноеНаименованиеУЗначенияСвойствОбъектов()
	ИмяСправочникаДополнительныеСвойства = ИмяСправочникаДополнительныеСвойства();
	Возврат Метаданные.Справочники[ИмяСправочникаДополнительныеСвойства].Реквизиты.Найти("ПолноеНаименование") <> Неопределено;
КонецФункции

Функция СвязьРегистровСведений()
	
	ИмяРегистраДополнительныеСвойства = ИмяРегистраДополнительныеСвойства();
	ТипИдентификатораТрН = Тип("СправочникСсылка." + ИмяСправочникаДополнительныеСвойства());
	ТипОбъектаСвойств = Метаданные.РегистрыСведений[ИмяРегистраДополнительныеСвойства].Измерения.Объект.Тип;
	Если ТипОбъектаСвойств.СодержитТип(ТипИдентификатораТрН) Тогда
		СвязьРегистровСведений = "Значение";
	Иначе
		СвязьРегистровСведений = "Объект";
	КонецЕсли; 
	Возврат СвязьРегистровСведений;
	
КонецФункции

Функция СсылкаНаЭПД(ИдентификаторЭПД, ОсновнойДокумент) Экспорт
	
	ИмяРегистраДополнительныеСвойства = ИмяРегистраДополнительныеСвойства();
	ТипИдентификатораЭПД = ТипЗнч(ИдентификаторЭПД);
	ТипОбъектаСвойств = Метаданные.РегистрыСведений[ИмяРегистраДополнительныеСвойства].Измерения.Объект.Тип;
	Если  ТипОбъектаСвойств.СодержитТип(ТипИдентификатораЭПД) Тогда
		СсылкаНаЭПД = ИдентификаторЭПД;
	Иначе
		СсылкаНаЭПД = ОсновнойДокумент;
	КонецЕсли;
	
	Возврат СсылкаНаЭПД;
	
КонецФункции

