Процедура ЗаполнитьСтрокуТоваровПоДополнительнымРеквизитамЗЗ(СтрокаГруз) Экспорт

	Если РасчетВесаОбъемаУТ11() Тогда
		Возврат;
	КонецЕсли;

	ДанныеНоменклатуры = ДанныеНоменклатуры(СтрокаГруз.Номенклатура);
	
	Если ТипЗнч(СтрокаГруз) = Тип("Структура") Тогда
		
		СтрокаГруз.РазмерГрМест.ВысЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ВысЗнач", СтрокаГруз.РазмерГрМест.ВысЗнач);
		СтрокаГруз.РазмерГрМест.ШирЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ШирЗнач", СтрокаГруз.РазмерГрМест.ШирЗнач);
		СтрокаГруз.РазмерГрМест.ДлЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ДлЗнач", СтрокаГруз.РазмерГрМест.ДлЗнач);
		
		ВесУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВесУпак", 0);
		Если ЗначениеЗаполнено(ВесУпак) Тогда
			СтрокаГруз.МасГруз.МасБрутЗнач = ВесУпак * СтрокаГруз.КолГрМест;
			СтрокаГруз.МасГруз.МасНетЗнач = ВесУпак * СтрокаГруз.КолГрМест;
		КонецЕсли;

 		ОбъемУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ОбъемУпак", 0);
  		Если ЗначениеЗаполнено(ОбъемУпак) Тогда
			СтрокаГруз.Объем = ОбъемУпак * СтрокаГруз.КолГрМест;
		КонецЕсли;

		ВидТарПредставление = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВидУпак", СтрокаГруз.ВидТарПредставление);
		СписокВыбораВидУпаковки = СписокВыбораВидУпаковки();
		КодВидТары = СписокВыбораВидУпаковки[ВидТарПредставление];
		СтрокаГруз.ВидТар = КодВидТары;
		СтрокаГруз.ВидТарПредставление = ВидТарПредставление;

	Иначе     

		СтрокаГруз.РазмерГрМест_ВысЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ВысЗнач", СтрокаГруз.РазмерГрМест_ВысЗнач);
		СтрокаГруз.РазмерГрМест_ШирЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ШирЗнач", СтрокаГруз.РазмерГрМест_ШирЗнач);
		СтрокаГруз.РазмерГрМест_ДлЗнач = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "Габар.ДлЗнач", СтрокаГруз.РазмерГрМест_ДлЗнач);
		
		ВесУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВесУпак", 0);
		Если ЗначениеЗаполнено(ВесУпак) Тогда
			СтрокаГруз.МасГруз_МасБрутЗнач = ВесУпак * СтрокаГруз.КолГрМест;
			СтрокаГруз.МасГруз_МасНетЗнач = ВесУпак * СтрокаГруз.КолГрМест;
		КонецЕсли;
		
 		ОбъемУпак = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ОбъемУпак", 0);
  		Если ЗначениеЗаполнено(ОбъемУпак) Тогда
			СтрокаГруз.Объем = ОбъемУпак * СтрокаГруз.КолГрМест;
		КонецЕсли;

		ВидТарПредставление = ЗначениеСтруктурыПоКлючу(ДанныеНоменклатуры, "ВидУпак", СтрокаГруз.ВидТарПредставление);
		СписокВыбораВидУпаковки = СписокВыбораВидУпаковки();
		КодВидТары = СписокВыбораВидУпаковки[ВидТарПредставление];
		СтрокаГруз.ВидТар = КодВидТары;
		СтрокаГруз.ВидТарПредставление = ВидТарПредставление;

	КонецЕсли;
		
КонецПроцедуры

