	ИначеЕсли Метаданные.Документы.Найти("СчетНаОплатуПокупателю") <> Неопределено Тогда
		
		СтрокаНастройки = Новый Структура;
		СтрокаНастройки.Вставить("ИдентификаторНастройки", Строка(Новый УникальныйИдентификатор));
		СтрокаНастройки.Вставить("МетаданныеДокумента", Метаданные.Документы["СчетНаОплатуПокупателю"].ПолноеИмя());
		СтрокаНастройки.Вставить("МетаданныеДокументаПредставление", Метаданные.Документы["СчетНаОплатуПокупателю"].Представление());
		СтрокаНастройки.Вставить("НастройкаСКД", Неопределено);
		СтрокаНастройки.Вставить("ПредставлениеНастройки", Метаданные.Документы["СчетНаОплатуПокупателю"].Представление());
		
		Результат.Добавить(СтрокаНастройки);
		
	КонецЕсли;
	
	Если Метаданные.Документы.Найти("ЗаказНаАвтомобиль") <> Неопределено Тогда
		
		СтрокаНастройки = Новый Структура;
		СтрокаНастройки.Вставить("ИдентификаторНастройки", Строка(Новый УникальныйИдентификатор));
		СтрокаНастройки.Вставить("МетаданныеДокумента", Метаданные.Документы["ЗаказНаАвтомобиль"].ПолноеИмя());
		СтрокаНастройки.Вставить("МетаданныеДокументаПредставление", Метаданные.Документы["ЗаказНаАвтомобиль"].Представление());
		СтрокаНастройки.Вставить("НастройкаСКД", Неопределено);
		СтрокаНастройки.Вставить("ПредставлениеНастройки", Метаданные.Документы["ЗаказНаАвтомобиль"].Представление());
		
		Результат.Добавить(СтрокаНастройки);
		
 	КонецЕсли;

	//Транспортная накладная
	Если Метаданные.Документы.Найти("ТранспортнаяНакладная") <> Неопределено Тогда
		
		СтрокаНастройки = Новый Структура;
		СтрокаНастройки.Вставить("ИдентификаторНастройки", Строка(Новый УникальныйИдентификатор));
		СтрокаНастройки.Вставить("МетаданныеДокумента", Метаданные.Документы["ТранспортнаяНакладная"].ПолноеИмя());
		СтрокаНастройки.Вставить("МетаданныеДокументаПредставление", Метаданные.Документы["ТранспортнаяНакладная"].Представление());
		СтрокаНастройки.Вставить("НастройкаСКД", Неопределено);
		СтрокаНастройки.Вставить("ПредставлениеНастройки", Метаданные.Документы["ТранспортнаяНакладная"].Представление());
		
		Результат.Добавить(СтрокаНастройки);
		
