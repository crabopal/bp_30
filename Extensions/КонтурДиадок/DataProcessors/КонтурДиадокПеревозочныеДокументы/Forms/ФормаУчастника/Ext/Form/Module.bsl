&НаСервере
Перем _ОбработкаОбъект;

&НаКлиенте
Перем _КлиентскиеВызовы;

&НаКлиенте
Перем _Платформа;

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		_ОбработкаОбъект.ИнициализироватьМодуль();
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

// Возвращает объект обработки из временного хранилища
//
// Параметры:
//  АдресОбработки - Строка - адрес обработки во временном хранилище
// 
// Возвращаемое значение:
//  ОбработкаОбъект - если обект обработки все еще загружен в память
//  Неопределено    - если объект обработки уже уничтожен
//
&НаСервере
Функция ХранилищеОбработки_Прочитать(АдресОбработки)
	
	СтруктураОбработки = ПолучитьИзВременногоХранилища(АдресОбработки);
	
	Результат = СвойствоСтруктуры(СтруктураОбработки, "ОбработкаОбъект");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Перем Значение;
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ЭтоСтруктура(Структура) И ЗначениеЗаполнено(Ключ) Тогда
		
		Если Структура.Свойство(Ключ, Значение) Тогда
			Результат = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет, является ли переданное значение структурой или фиксированной структурой.
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить.
// 
// Возвращаемое значение:
//   Булево - Истина, если переданое значение является структрой или фиксированной структурой.
//
&НаСервере
Функция ЭтоСтруктура(Значение)
	
	Результат = Ложь;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	
КонецПроцедуры


#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	_Платформа = ВладелецФормы.Модуль_Платформа();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Параметры.Свойство("ОбщийКонтекстКлиентСервер", Объект.ОбщийКонтекстКлиентСервер);
	Параметры.Свойство("Организация", Организация);
	Параметры.Свойство("ЭтоОтправительДокумента", ЭтоОтправительДокумента);
	Параметры.Свойство("РольУчастника", РольУчастника);

	Если Параметры.Свойство("Участник") Тогда
		Участник = Параметры.Участник;
		ОпределитьТипУчастника();
		ЗаполнитьДанныеФормы();
	КонецЕсли;
	
	Если Параметры.Свойство("ИдентификаторыЭДО") Тогда
		ПоказатьИдентификаторыЭДО(Параметры.ИдентификаторыЭДО);
	КонецЕсли;
	
	Элементы.ГруппаКомандыСопоставления.Видимость = Ложь;
	Если ЗначениеЗаполнено(Участник) Тогда
		МетаданныеУчастника = Участник.Метаданные();
		Если МетаданныеУчастника.Имя = "Контрагенты" Тогда
			Элементы.ГруппаКомандыСопоставления.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоОтправительДокумента Тогда
		Элементы.ГруппаКомандыСопоставления.Видимость = Ложь;
	КонецЕсли;
	
	ОбновитьОтметкуОбязательныхПолей();
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура рл_Адрес_АдрИнф_АдрТекстПриИзменении(Элемент)
	
	Адреса = ПолучитьИзВременногоХранилища(ХранениеАдреса);
	Адрес = рл_Адрес_АдрИнф_АдрТекст;
	Для Каждого СтруктураАдреса Из Адреса Цикл
		Если СтруктураАдреса.Адрес = Адрес Тогда
			рл_Адрес_АдрРФ = СтруктураАдреса.ЗначениеАдреса;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)

	СохранитьНаСервере();
	Закрыть(Участник);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоСсылке(Команда)
	ОбновитьПоСсылкеНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПоказатьИдентификаторыЭДО(ИдентификаторыЭДО)
	
	СброситьВидимостьКомандСопоставления();

	Если ИдентификаторыЭДО.ЭтоСопоставлениеЭПД Тогда
		ИдентификаторУчастникаЭДО = ИдентификаторыЭДО.ID;
		ОператорУчастникаЭДО = ИдентификаторыЭДО.ОператорЭДО;
		Элементы.ИдентификаторУчастникаЭДО.Подсказка = "Используется отдельная настройка для ЭПД";
		ВидимостьКомандСопоставления_ЭПД();
	ИначеЕсли ЗначениеЗаполнено(ИдентификаторыЭДО.ID) Тогда
		ИдентификаторУчастникаЭДО = ИдентификаторыЭДО.ID;
		ОператорУчастникаЭДО = ИдентификаторыЭДО.ОператорЭДО;
		Элементы.ИдентификаторУчастникаЭДО.Подсказка = "Используется основное сопоставление контрагента";
		ВидимостьКомандСопоставления_ЭДО();
	Иначе
		Элементы.ИдентификаторУчастникаЭДО.Подсказка = "Сопоставление контрагента отсутствует";
		ВидимостьКомандСопоставления_НеЗаполнено();
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура СброситьВидимостьКомандСопоставления()
	Элементы.СопоставитьКонтрагента.Видимость = Ложь;
	Элементы.ИзменитьСопоставление.Видимость = Ложь;
	Элементы.СброситьСопоставление.Видимость = Ложь;
	Элементы.УказатьИдентификаторЭПД.Видимость = Ложь;
КонецПроцедуры

&НаСервере
Процедура ВидимостьКомандСопоставления_ЭПД()
	Элементы.ИзменитьСопоставление.Видимость = Истина;
	Элементы.СброситьСопоставление.Видимость = Истина;
КонецПроцедуры

&НаСервере
Процедура ВидимостьКомандСопоставления_ЭДО()
	Элементы.УказатьИдентификаторЭПД.Видимость = Истина;
КонецПроцедуры

&НаСервере
Процедура ВидимостьКомандСопоставления_НеЗаполнено()
	Элементы.СопоставитьКонтрагента.Видимость = Истина;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФормы()
	
	ИнициализацияФормы();

	МодульОбъекта = ОбработкаОбъект();

	Если ЗначениеЗаполнено(Участник) Тогда
		Элементы.ОбновитьПоСсылке.Видимость = Истина; 
	Иначе
		Элементы.ОбновитьПоСсылке.Видимость = Ложь; 
	КонецЕсли;
	
	ДанныеУчастник = МодульОбъекта.ДанныеУчастника(Участник);
	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеУчастник, ЭтаФорма);
	
	УстановитьСписокВыбораАдрес(ДанныеУчастник);
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьТипУчастника()
	
	МодульОбъекта = ОбработкаОбъект();

	ТипУчастника = МодульОбъекта.ТипУчастника(Участник);
	
	Элементы.ГруппаРеквизитыИП.Видимость = Ложь;	
	Элементы.ГруппаРеквизитыФЛ.Видимость = Ложь;	
	Элементы.ГруппаРеквизитыЮЛ.Видимость = Ложь;	
	Если ТипУчастника = "ЮЛ" Тогда
		Элементы.ГруппаРеквизитыЮЛ.Видимость = Истина;	
	ИначеЕсли ТипУчастника = "ФЛ" Тогда
		Элементы.ГруппаРеквизитыФЛ.Видимость = Истина;	
	ИначеЕсли ТипУчастника = "ИП" Тогда
		Элементы.ГруппаРеквизитыИП.Видимость = Истина;	
	ИначеЕсли ТипУчастника = "ИН" Тогда

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()

	МодульОбъекта = ОбработкаОбъект();

	УдалитьПустыеЗначенияТелефоныАдресаЭП();
	
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	ЗначенияДополнительныхСвойств = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, РеквизитыФормы);

	ИмяМтд = Участник.Метаданные().Имя;
	Если ИмяМтд = "Организации" Тогда
		МодульОбъекта.СохранитьЗначения(Участник, ЗначенияДополнительныхСвойств, "СвУчОрг");
	Иначе
		МодульОбъекта.СохранитьЗначения(Участник, ЗначенияДополнительныхСвойств, "СвУч");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализацияФормы()

	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить(Тип("Строка"));
	ЭтаФорма.рл_Контакт_Тлф.ТипЗначения = Новый ОписаниеТипов(ДопустимыеТипы);		

	ДопустимыеТипы = Новый Массив;
	ДопустимыеТипы.Добавить(Тип("Строка"));
	ЭтаФорма.рл_Контакт_ЭлПочта.ТипЗначения = Новый ОписаниеТипов(ДопустимыеТипы);		

КонецПроцедуры 

&НаСервере
Процедура УстановитьСписокВыбораАдрес(ДанныеУчастник)

	МодульОбъекта = ОбработкаОбъект();
	
	Адреса = Новый Массив;
	АдресаПоПредставлению = Новый Массив; // для проверки дублей
  	МодульОбъекта.ДобавитьАдресаПоУчастнику(Адреса, АдресаПоПредставлению, Участник);
	
	Если МодульОбъекта.ЗаполненКлючСтруктуры(ДанныеУчастник, "Адрес") Тогда
		Адрес = ДанныеУчастник.Адрес.АдрИнф.АдрТекст;
		АдресРФ = ДанныеУчастник.Адрес.АдрРФ;
		МодульОбъекта.ДобавитьАдресВСписок(Адреса, АдресаПоПредставлению, Адрес, АдресРФ);
	КонецЕсли;

	СписокВыбораАдрес = Элементы.рл_Адрес_АдрИнф_АдрТекст.СписокВыбора;
	СписокВыбораАдрес.Очистить();
	Для Каждого СтруктураАдреса Из Адреса Цикл
		Элементы.рл_Адрес_АдрИнф_АдрТекст.СписокВыбора.Добавить(СтруктураАдреса.Адрес, СтруктураАдреса.ПредставлениеАдреса);
	КонецЦикла;

	ХранениеАдреса = ПоместитьВоВременноеХранилище(Адреса, УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура УдалитьПустыеЗначенияТелефоныАдресаЭП()
	
	МассивПустыхТелефонов = Новый Массив;
	Для Каждого Телефон Из рл_Контакт_Тлф Цикл
		Если Не ЗначениеЗаполнено(Телефон.Значение) Тогда
			МассивПустыхТелефонов.Добавить(Телефон);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПустойТелефон Из МассивПустыхТелефонов Цикл
		рл_Контакт_Тлф.Удалить(ПустойТелефон);
	КонецЦикла;
	
	МассивПустыхАдресовЭП = Новый Массив;
	Для Каждого АдресЭП Из рл_Контакт_ЭлПочта Цикл
		Если Не ЗначениеЗаполнено(АдресЭП.Значение) Тогда
			МассивПустыхАдресовЭП.Добавить(АдресЭП);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПустойАдресЭП Из МассивПустыхАдресовЭП Цикл
		рл_Контакт_ЭлПочта.Удалить(ПустойАдресЭП);
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоСсылкеНаСервере()

	МодульОбъекта = ОбработкаОбъект();

	ОпределитьТипУчастника();		
	ДанныеУчастник = МодульОбъекта.ДанныеУчастника(Участник, "УчСист");
	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеУчастник, ЭтаФорма);
	УстановитьСписокВыбораАдрес(ДанныеУчастник);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтметкуОбязательныхПолей()

	МодульОбъекта = ОбработкаОбъект();
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();

	МодульОбъекта.ОтметитьОбязательныеПоля(ЭтаФорма, РеквизитыФормы, Элементы, Ложь);
	
	ПараметрыВалидации = Новый Структура;
	МодульОбъекта.ПараметрыВалидацииУчастника(ПараметрыВалидации);

	ОбязательныеРеквизиты = МодульОбъекта.ОбязательныеРеквизитыФормы(ЭтаФорма, РеквизитыФормы, "ФормаУчастника", ПараметрыВалидации);
	
	МодульОбъекта.ОтметитьОбязательныеПоля(ЭтаФорма, ОбязательныеРеквизиты, Элементы, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСопоставление(Команда)
	
	НачатьСопоставленияУчастникаЭПД();
	
КонецПроцедуры

&НаКлиенте
Процедура УказатьИдентификаторЭПД(Команда)
	
	НачатьСопоставленияУчастникаЭПД();

КонецПроцедуры

&НаКлиенте
Процедура НачатьСопоставленияУчастникаЭПД()
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить("ParticipantType", РольУчастника);
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ОткрытьНастройку;
	Метрика_ДобавитьСтатистику(ДействиеМетрики, ДопПеременные);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Участник", Участник);
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("ИдентификаторыЭДО", ИдентификаторыЭДОНаСервере(Участник, Организация));
	
	ДополнительныеПараметры = Новый Структура;
	
	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеЗакрытияФормыСопоставленияУчастникаЭПД", ЭтаФорма, ДополнительныеПараметры);
	
	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаСопоставленияУчастникаЭПД", ПараметрыФормы, ЭтаФорма, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеЗакрытияФормыСопоставленияУчастникаЭПД(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия <> Неопределено Тогда
		ИдентификаторыЭДО = ИдентификаторыЭДОНаСервере(Участник, Организация);				
		ПоказатьИдентификаторыЭДО(ИдентификаторыЭДО);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьСопоставление(Команда)
	
	ТекстВопроса = "После сброса отдельного идентификатора ЭПД
	|будет использоваться основное сопоставление контрагента.
	|Сбросить отдельный идентификатор ЭДО для ЭПД?";
	Оповещение = Новый ОписаниеОповещения("Оповещение_РезультатВопросаСбороситьСопоставление", ЭтаФорма);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , "Предупреждение");
	
КонецПроцедуры

&НаКлиенте
Процедура Оповещение_РезультатВопросаСбороситьСопоставление(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда 
		СброситьСопоставлениеЭПД();
		ИдентификаторыЭДО = ИдентификаторыЭДОНаСервере(Участник, Организация);				
		ПоказатьИдентификаторыЭДО(ИдентификаторыЭДО);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СброситьСопоставлениеЭПД() Экспорт

	МодульОбъекта = ОбработкаОбъект();
	МодульОбъекта.СброситьСопоставлениеЭПД(Участник);

КонецПроцедуры

&НаКлиенте
Процедура СопоставитьКонтрагента(Команда)
	
	НачатьСопоставление(Организация, Участник);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьСопоставление(ОтборПоОрганизации, ОтборПоКонтрагенту)
	
	ОписаниеЗакрытияФормы = _Платформа.НовыйОписаниеОповещения("ОбработатьРезультатСопоставленияКонтрагента", ЭтаФорма);
	
	Если ЗначениеЗаполнено(ОтборПоКонтрагенту) И ЗначениеЗаполнено(ОтборПоОрганизации) Тогда
		_КлиентскиеВызовы.ОткрытьСопоставление(ОтборПоОрганизации, ОтборПоКонтрагенту, ОписаниеЗакрытияФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатСопоставленияКонтрагента(РезультатСопоставления, ДополнительныеПараметры) Экспорт
	
	Если РезультатСопоставления = КодВозвратаДиалога.Да Тогда
		ИдентификаторыЭДО = ИдентификаторыЭДОНаСервере(Участник, Организация);				
		ПоказатьИдентификаторыЭДО(ИдентификаторыЭДО);
	Иначе
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ИдентификаторыЭДОНаСервере(Участник, ОтправительДокумента)
	
	МодульОбъекта = ОбработкаОбъект();
	ИдентификаторыЭДО = МодульОбъекта.ИдентификаторыЭДО(Участник, Ложь, ОтправительДокумента);
	
	Возврат ИдентификаторыЭДО;

КонецФункции

#Область Метрики

&НаКлиенте
Процедура Метрика_ДобавитьСтатистику(ДействиеМетрики,
	ДопПеременные = Неопределено)
	
	КатегорияМетрики = _КлиентскиеВызовы.Метрика_НазваниеКатегории().НастройкаИдентификатораЭПД;
	ПредставлениеМетрики = Метрика_View();
	ТрассировкаМетрики = Метрика_TraceID();
	
	_КлиентскиеВызовы.Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики,
		ДопПеременные,
		ПредставлениеМетрики,
		ТрассировкаМетрики,
		,
		КатегорияМетрики);
	
КонецПроцедуры

&НаКлиенте
Функция Метрика_TraceID()
	Возврат "ФормаУчастникаПеревозки_" + Новый УникальныйИдентификатор;
КонецФункции

&НаКлиенте
Функция Метрика_View()
	Возврат "ФормаУчастника";
КонецФункции

#КонецОбласти

