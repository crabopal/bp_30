#Область ОписаниеПеременных

&НаСервере
Перем _ОбработкаОбъект;

&НаКлиенте
Перем _КлиентскиеВызовы;

&НаКлиенте
Перем СписокВыбораВидУпак;

&НаКлиенте
Перем СписокВыбораТекстИнфИдентиф;

&НаКлиенте
Перем СписокВыбораТипКузова;

&НаКлиенте
Перем СписокВыбораВидТС;

&НаКлиенте
Перем _Платформа;

&НаСервере
Перем _МодульЯдроНаСервере;

#КонецОбласти


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьЗаголовок();
    ЭтотОбъект.КлючСохраненияПоложенияОкна = Строка(Новый УникальныйИдентификатор);
	
	Параметры.Свойство("ОбщийКонтекстКлиентСервер", Объект.ОбщийКонтекстКлиентСервер);

	_ДокументыОснования = ОпределитьДокументыОснованияИОсновной(Параметры);

	Если Параметры.Свойство("СтрокаСписка")
		И Параметры.СтрокаСписка <> Неопределено Тогда
		СтрокаСписка = Параметры.СтрокаСписка;
	КонецЕсли;
		
	МодульОбъекта = ОбработкаОбъект();
		
	УстановитьОграниченияТипов();
	
	Если _ДокументыОснования.Количество() > 0 Тогда
		ЗаполнитьДокументыОснования(_ДокументыОснования);
		ЗаполнитьДанныеФормы();
	КонецЕсли;
		
	//заполняется в "ЗаполнитьДанныеФормы"
	//УстановитьСписокВыбораАдрПунктНазн();
	//УстановитьСписокВыбораАдрГруз();
 	УстановитьПараметрыВыбораДоговора(рл_СвЭксп, "рл_ДогТрЭксп");
	
	УстановитьЗаголовокГруппыДатыИВремя();
	УстановитьУсловноеОформлениеНаСервере();
		
	РежимПереотправки = Ложь;

	ОпределитьЗапретРедактирования();
	ДоступностьФормы();
	ВидимостьКолонкиОпГрузСвойства();
		
	ПроверитьЭПЭ();
	ОбновитьОтметкуОбязательныхПолей();
	
	ДопПеременные = Новый Соответствие;
	
	Если ЭтоНовыйДокументПЭ() Тогда
		
		Модифицированность = Истина;
		ДействиеМетрики = МодульОбъекта.Метрика_НазваниеДействий().СозданиеЭПЭ;
		
	Иначе
		
		ДействиеМетрики = МодульОбъекта.Метрика_НазваниеДействий().ОткрытиеФормыЭПЭ;
		ДопПеременные.Вставить(МодульОбъекта.Метрика_КлючОшибки(), Метрики_ПредставлениеОшибокВМассиве());
		
	КонецЕсли;
	
	МодульОбъекта.Метрика_ЗаполнитьВыбранныеДокументыПоТипам(ДопПеременные, _ДокументыОснования);
	ДопПеременные.Вставить(МодульОбъекта.Метрика_КлючИдентификатораПеревозочногоДокумента(), Строка(ИдентификаторПЭ));
	
	НаименованиеФормы = Метрика_НаименованиеФормы();
	
	МодульОбъекта.Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, ДопПеременные, , НаименованиеФормы);
	
	Ядро = Модуль_Ядро();
	Ядро.СписокОшибок_Очистить();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОграниченияТипов()

	МодульОбъекта = ОбработкаОбъект();

	УстановитьОграничениеТипаКлиент();	
	УстановитьОграничениеТипаСвГО();
	
	МассивТиповКонтрагентИОрганизация = Новый Массив;
	МассивТиповКонтрагентИОрганизация.Добавить(МодульОбъекта.СправочникТипОрганизации());
	МассивТиповКонтрагентИОрганизация.Добавить(МодульОбъекта.СправочникТипКонтрагенты());
	Элементы.рл_СвГруз_СвГП.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагентИОрганизация);
 	Элементы.рл_ИдПолИнойЗначение.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагентИОрганизация);

	МассивТиповКонтрагент = Новый Массив;
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипКонтрагенты());
	Элементы.рл_СвЭксп.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
	
	МассивТиповДоговоры = Новый Массив;
	МассивТиповДоговоры.Добавить(МодульОбъекта.СправочникТипДоговорыКонтрагентов());
	Элементы.рл_ДогТрЭксп.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповДоговоры);

	МассивТиповСотрудники = Новый Массив;
	МассивТиповСотрудники.Добавить(МодульОбъекта.СправочникТипФизическиеЛица());
	
	МассивТиповВалюта = Новый Массив;
	МассивТиповВалюта.Добавить(МодульОбъекта.СправочникТипВалюты());
	Элементы.рл_СвГруз_ОпГрузОбъявлСтГруз_Валюта.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповВалюта);

	МассивТиповНоменклатура = Новый Массив;
	МассивТиповНоменклатура.Добавить(МодульОбъекта.СправочникТипНоменклатура());
	МассивТиповНоменклатура.Добавить(Тип("Строка"));
	Элементы.рл_СвГруз_ОпГрузНоменклатура.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповНоменклатура);
	
	МассивТиповСтраны = Новый Массив;
	МассивТиповСтраны.Добавить(МодульОбъекта.СправочникТипСтраны());
	Элементы.рл_СвГруз_ОпГрузСвСтрПроисх.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповСтраны);

КонецПроцедуры

&НаСервере
Процедура УстановитьОграничениеТипаКлиент()
	
	МодульОбъекта = ОбработкаОбъект();
	
	МассивТиповКонтрагент = Новый Массив;
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипОрганизации());
	ТипПодразделенияКомпании = МодульОбъекта.СправочникТипПодразделенияКомпании(); 
	Если ТипПодразделенияКомпании <> Неопределено Тогда
		МассивТиповКонтрагент.Добавить(ТипПодразделенияКомпании);
	КонецЕсли;
	Элементы.рл_СвКлнт.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОграничениеТипаСвГО()
	
	МодульОбъекта = ОбработкаОбъект();
	
	МассивТиповКонтрагент = Новый Массив;
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипОрганизации());
	МассивТиповКонтрагент.Добавить(МодульОбъекта.СправочникТипКонтрагенты());
	ТипПодразделенияКомпании = МодульОбъекта.СправочникТипПодразделенияКомпании(); 
	Если ТипПодразделенияКомпании <> Неопределено Тогда
		МассивТиповКонтрагент.Добавить(ТипПодразделенияКомпании);
	КонецЕсли;
	Элементы.рл_СвГруз_СвГО.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповКонтрагент);
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИдентификаторОсновнойФормы = ВладелецФормы.УникальныйИдентификатор;
	НастроитьВидимостьКомандФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если ЗавершениеРаботы = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыборе(СтрокаСписка);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность
		И НЕ РежимПереотправки Тогда
		
		Отказ = Истина;
		Если ЗавершениеРаботы = Истина Тогда
			ТекстПредупреждения = "Настройки были изменены. Все изменения будут потеряны.";
			Возврат;
		КонецЕсли;
		
		Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеВопросаОЗакрытии", ЭтаФорма);
		ПоказатьВопрос(Оповещение,"Настройки были изменены, ВЫЙТИ без сохранения?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеВопросаОЗакрытии(РезультатВопроса,ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Модифицированность = Ложь;
		СтрокаСписка = Неопределено;
		ЭтаФорма.Закрыть();	
	Иначе
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

//#Область ОбработчикиСобытийЭлементовФормы

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура рл_СвГруз_АдрПунктНазнПриИзменении(Элемент)
	
	Адреса = ПолучитьИзВременногоХранилища(ХранениеАдресаДоставки);
	Адрес = рл_СвГруз_АдрПунктНазн_АдрВыдГруз_Адрес_АдрИнф_АдрТекст;
	Для Каждого СтруктураАдреса Из Адреса Цикл
		Если СтруктураАдреса.Адрес = Адрес Тогда
			рл_СвГруз_АдрПунктНазн_АдрВыдГруз_Адрес_АдрРФ = СтруктураАдреса.ЗначениеАдреса;                     
		КонецЕсли;
	КонецЦикла;
	Модифицированность = Истина;
	
КонецПроцедуры 

&НаКлиенте
Процедура рл_СвГруз_СвГОПриИзменении(Элемент)
	
	Если рл_СвГруз_АдрГруз_МестоПрием = 1 Тогда
		СброситьАдрГруз();
	КонецЕсли;
	
	УстановитьСписокВыбораАдрГруз();	
  	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура рл_СвГруз_СвГООткрытие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если НельзяОткрыть(рл_СвГруз_СвГО, "рл_СвГруз_СвГО") Тогда
		Возврат;	
	КонецЕсли;
	
	ОтправительДокумента = ОтправительДокумента();
	ЭтоОтправительДокумента = ЭтоОтправительДокумента("рл_СвГруз_СвГО");
	РольУчастника = "Грузоотправитель";
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Участник", рл_СвГруз_СвГО);
	ПараметрыФормы.Вставить("Организация", рл_Организация);
	ПараметрыФормы.Вставить("ИдентификаторыЭДО", ИдентификаторыЭДОНаСервере(рл_СвГруз_СвГО, ЭтоОтправительДокумента, ОтправительДокумента));
	ПараметрыФормы.Вставить("ЭтоОтправительДокумента", ЭтоОтправительДокумента);
	ПараметрыФормы.Вставить("РольУчастника", РольУчастника);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяРеквизита", "рл_СвГруз_СвГО");

	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеЗакрытияФормыРедактирования", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаУчастника", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура рл_СвКлнтПриИзменении(Элемент)

	Если ЗначениеЗаполнено(рл_СвКлнт) 
		И Не ЕстьИдентификаторыЭДО(рл_СвКлнт, Истина) Тогда
		ПредложитьСопоставитьКонтрагента("рл_СвКлнт");
	КонецЕсли;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура рл_СвКлнтОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если НельзяОткрыть(рл_СвКлнт, "рл_СвКлнт") Тогда
		Возврат;	
	КонецЕсли;
	
	ОтправительДокумента = ОтправительДокумента();
	ЭтоОтправительДокумента = ЭтоОтправительДокумента("рл_СвКлнт");
	РольУчастника = "Клиент";
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Участник", рл_СвКлнт);
	ПараметрыФормы.Вставить("Организация", рл_СвКлнт);
	ПараметрыФормы.Вставить("ИдентификаторыЭДО", ИдентификаторыЭДОНаСервере(рл_СвКлнт, ЭтоОтправительДокумента, ОтправительДокумента));
	ПараметрыФормы.Вставить("ЭтоОтправительДокумента", ЭтоОтправительДокумента);
	ПараметрыФормы.Вставить("РольУчастника", РольУчастника);
	
	ДополнительныеПараметры = Новый Структура;

	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеЗакрытияФормыРедактирования", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаУчастника", ПараметрыФормы, ЭтаФорма, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура рл_СвЭкспПриИзменении(Элемент)

	Если рл_СвГруз_АдрГруз_МестоПрием = 2 Тогда
		СброситьАдрГруз();
	КонецЕсли;
	УстановитьСписокВыбораАдрГруз();
	Если рл_СвГруз_АдрПунктНазн_МестоВыд = 2 Тогда
		СброситьАдрПунктНазн();
	КонецЕсли;
	УстановитьСписокВыбораАдрПунктНазн();
	
	Если ЗначениеЗаполнено(рл_СвЭксп) 
		И Не ЕстьИдентификаторыЭДО(рл_СвЭксп, Ложь) Тогда
		ПредложитьСопоставитьКонтрагента("рл_СвЭксп");
	КонецЕсли;

	рл_ДогТрЭксп = Неопределено;
 	УстановитьПараметрыВыбораДоговора(рл_СвЭксп, "рл_ДогТрЭксп"); 
	
	Модифицированность = Истина;
	
КонецПроцедуры

