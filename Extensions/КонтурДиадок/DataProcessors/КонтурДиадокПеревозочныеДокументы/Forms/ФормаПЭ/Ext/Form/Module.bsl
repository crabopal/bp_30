Процедура рл_СвЭкспОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если НельзяОткрыть(рл_СвЭксп, "рл_СвЭксп") Тогда
		Возврат;	
	КонецЕсли;

	ОтправительДокумента = ОтправительДокумента();
	ЭтоОтправительДокумента = ЭтоОтправительДокумента("рл_СвЭксп");
	РольУчастника = "Экспедитор";
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Участник", рл_СвЭксп);
	ПараметрыФормы.Вставить("Организация", рл_СвКлнт);
	ПараметрыФормы.Вставить("ИдентификаторыЭДО", ИдентификаторыЭДОНаСервере(рл_СвЭксп, ЭтоОтправительДокумента, ОтправительДокумента));
	ПараметрыФормы.Вставить("ЭтоОтправительДокумента", ЭтоОтправительДокумента);
	ПараметрыФормы.Вставить("РольУчастника", РольУчастника);
	
	ДополнительныеПараметры = Новый Структура;

	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеЗакрытияФормыРедактирования", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаУчастника", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура рл_ИдПолИнойПриИзменении(Элемент)

	ЭтоОтправительДокумента = Ложь;
	ТекущиеДанные = Элементы.рл_ИдПолИной.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Значение) 
		И Не ЕстьИдентификаторыЭДО(ТекущиеДанные.Значение, ЭтоОтправительДокумента) Тогда
		ПредложитьСопоставитьКонтрагента("рл_ИдПолИной", ТекущиеДанные.Значение);
	КонецЕсли;
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура рл_ДогТрЭкспПриИзменении(Элемент)

	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура рл_СвГруз_СвГППриИзменении(Элемент)
	
	Если рл_СвГруз_АдрПунктНазн_МестоВыд = 1 Тогда
		СброситьАдрПунктНазн();                       
	КонецЕсли;
	УстановитьСписокВыбораАдрПунктНазн();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура рл_СвГруз_СвГПОткрытие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если НельзяОткрыть(рл_СвГруз_СвГП, "рл_СвГруз_СвГП") Тогда
		Возврат;	
	КонецЕсли;

	ОтправительДокумента = ОтправительДокумента();
	ЭтоОтправительДокумента = ЭтоОтправительДокумента("рл_СвГруз_СвГП");
	РольУчастника = "Грузополучатель";
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Участник", рл_СвГруз_СвГП);
	ПараметрыФормы.Вставить("Организация", рл_Организация);
	ПараметрыФормы.Вставить("ИдентификаторыЭДО", ИдентификаторыЭДОНаСервере(рл_СвГруз_СвГП, ЭтоОтправительДокумента, ОтправительДокумента));
	ПараметрыФормы.Вставить("ЭтоОтправительДокумента", ЭтоОтправительДокумента);
	ПараметрыФормы.Вставить("РольУчастника", РольУчастника);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяРеквизита", "рл_СвГруз_СвГП");
	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеЗакрытияФормыРедактирования", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаУчастника", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеЗакрытияФормыРедактирования(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия <> Неопределено Тогда
		Если ДополнительныеПараметры.Свойство("ИмяРеквизита") Тогда
			Если ЭтоРеквизитXML(ДополнительныеПараметры.ИмяРеквизита) И ТипЗнч(РезультатЗакрытия) = Тип("Строка") Тогда
				ЭтаФорма[ДополнительныеПараметры.ИмяРеквизита] = РезультатЗакрытия;
				ЭтаФорма[КлючПредставление(ДополнительныеПараметры.ИмяРеквизита)] = ЗначениеПредставлениеПоСтрокеXML(РезультатЗакрытия);
			ИначеЕсли ДополнительныеПараметры.ИмяРеквизита = "рл_СвГруз_СвГО" Тогда	
				УстановитьСписокВыбораАдрГруз();
			ИначеЕсли ДополнительныеПараметры.ИмяРеквизита = "рл_СвГруз_СвГП" Тогда	
				УстановитьСписокВыбораАдрПунктНазн();
			КонецЕсли;
		КонецЕсли;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

