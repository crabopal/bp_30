	ЗаполнитьВесГрузПарт_ВесНетто();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура рл_СвГруз_ОпГрузВесГруз_КолПаллПриИзменении(Элемент)
	ЗаполнитьВесГрузПарт_КолПалл();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура рл_СвГруз_ОпГрузИнфУпГруз_ВидУпакНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если СписокВыбораВидУпак = Неопределено Тогда
		СписокВыбораВидУпак = СписокВыбораВидУпак(); 
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДанныеДляВыбора", СписокВыбораВидУпак);
	ПараметрыФормы.Вставить("ОтображатьПредставление", Ложь);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИндентификаторСтроки", Элементы.рл_СвГруз_ОпГруз.ТекущаяСтрока);

	Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеВыбораВидаТары", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаВыбораЗначений", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеВыбораВидаТары(ЗначениеВыбора, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеВыбора <> Неопределено Тогда
		
		ТекущиеДанные = рл_СвГруз_ОпГруз.НайтиПоИдентификатору(ДополнительныеПараметры.ИндентификаторСтроки);
		ТекущиеДанные.ИнфУпГруз_ВидУпак = ЗначениеВыбора.Значение;
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура рл_СвГруз_ОпГрузИнфУпГруз_ВидУпакОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если СписокВыбораВидУпак = Неопределено Тогда
		СписокВыбораВидУпак = СписокВыбораВидУпак(); 
	КонецЕсли;
	
	ТекущиеДанные = Элементы.рл_СвГруз_ОпГруз.ТекущиеДанные;
	ЭлементСписка = СписокВыбораВидУпак.НайтиПоЗначению(ВыбранноеЗначение);
	Если ЭлементСписка = Неопределено Тогда
		ТекущиеДанные.ИнфУпГруз_ВидУпак = "";
	Иначе
		ТекущиеДанные.ИнфУпГруз_ВидУпак = ЭлементСписка.Значение;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура рл_СвГруз_ОпГрузИнфУпГруз_ВидУпакОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	Если СписокВыбораВидУпак = Неопределено Тогда
		СписокВыбораВидУпак = СписокВыбораВидУпак(); 
	КонецЕсли;

	ТекущиеДанные = Элементы.рл_СвГруз_ОпГруз.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(Текст) Тогда
		ТекущиеДанные.ИнфУпГруз_ВидУпак = "";
	Иначе
		СтрокаПоиска = СтрокаПоискаФильтра(Текст, Элемент.ТекстРедактирования);
		Если СтрокаПоиска = Неопределено Тогда
			ТекущиеДанные.ИнфУпГруз_ВидУпак = "";
		Иначе
			ДанныеВыбора = СписокЗначенийНайти(СтрокаПоиска, СписокВыбораВидУпак);
			Если ДанныеВыбора.Количество() > 0 Тогда
				ТекущиеДанные.ИнфУпГруз_ВидУпак = ДанныеВыбора[0].Значение;
			Иначе
				ТекущиеДанные.ИнфУпГруз_ВидУпак = "";
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;  

КонецПроцедуры

&НаКлиенте
Процедура рл_СвГруз_ОпГрузИнфУпГруз_ВидУпакПриИзменении(Элемент)
	
	Модифицированность = Истина;
	
	ТекущиеДанные = Элементы.рл_СвГруз_ОпГруз.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ИнфУпГруз_ВидУпак) Тогда
		ТекущиеДанные.ИнфУпГруз_ВесУпак = 0;
		ТекущиеДанные.ИнфУпГруз_ГабарУпак_ВысЗнач = 0;
		ТекущиеДанные.ИнфУпГруз_ГабарУпак_ДлЗнач = 0;
		ТекущиеДанные.ИнфУпГруз_ГабарУпак_ШирЗнач = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуНоменклатуры()
	            
	ТекущиеДанные = Элементы.рл_СвГруз_ОпГруз.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) 
		Или ТипЗнч(ТекущиеДанные.Номенклатура) = Тип("Строка") Тогда
		Возврат;	
	КонецЕсли;  

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СсылкаНаОбъект", ТекущиеДанные.Номенклатура);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущаяСтрока", Элементы.рл_СвГруз_ОпГруз.ТекущаяСтрока);

	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеЗакрытияФормыНоменклатуры", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаНоменклатуры", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеЗакрытияФормыНоменклатуры(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия <> Неопределено Тогда
		Если ДополнительныеПараметры.Свойство("ТекущаяСтрока") Тогда
			Оповещение_ПослеЗакрытияФормыНоменклатурыНаСервере(ДополнительныеПараметры.ТекущаяСтрока);	
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура Оповещение_ПослеЗакрытияФормыНоменклатурыНаСервере(ТекущаяСтрока)
	СтрокаГруз = рл_СвГруз_ОпГруз.НайтиПоИдентификатору(ТекущаяСтрока);
	Если СтрокаГруз <> Неопределено Тогда
		МодульОбъекта = ОбработкаОбъект();
		МодульОбъекта.ЗаполнитьСтрокуТоваровПоДополнительнымРеквизитамПЭ(СтрокаГруз);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура рл_СвГруз_ОпГрузНоменклатураПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.рл_СвГруз_ОпГруз.ТекущаяСтрока;
	Оповещение_ПослеЗакрытияФормыНоменклатурыНаСервере(ТекущаяСтрока);
КонецПроцедуры

