&НаСервере
Процедура УдалитьНаСервере(ДополнительныеПараметры)
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры.ИдентификаторТрН) Тогда
		
		МодульОбъекта = ОбработкаОбъект();
		МодульОбъекта.Удалить(МодульОбъекта.КлючИдентификатораТрН(), ДополнительныеПараметры.ИдентификаторТрН);
		
	ИначеЕсли ЗначениеЗаполнено(ДополнительныеПараметры.ИдентификаторЗЗ) Тогда
		
		МодульОбъекта = ОбработкаОбъект();
		МодульОбъекта.Удалить(МодульОбъекта.КлючИдентификатораЗЗ(), ДополнительныеПараметры.ИдентификаторЗЗ);

	ИначеЕсли ЗначениеЗаполнено(ДополнительныеПараметры.ИдентификаторПЭ) Тогда
		
		МодульОбъекта = ОбработкаОбъект();
