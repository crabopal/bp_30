&НаКлиенте
Процедура УдалитьЭТрН(Команда)
	
	ТекущиеДанные = Элементы.СписокДокументов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Если Не ТекущиеДанные.ЕстьЭТрН Тогда
			ПоказатьПредупреждение(Неопределено, "На документ не введен ЭТрН");
		ИначеЕсли ДокументОтправленЭТрН(ТекущиеДанные.Ссылка) Тогда
			ПоказатьПредупреждение(Неопределено, "Нельзя удалять отправленный документ");
		Иначе                               
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ИдентификаторЗЗ", Неопределено); 
			ДополнительныеПараметры.Вставить("ИдентификаторПЭ", Неопределено); 
			ДополнительныеПараметры.Вставить("ИдентификаторТрН", ТекущиеДанные.ИдентификаторТрН); 
			Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ОтветНаВопросУдаления", ЭтаФорма, ДополнительныеПараметры);
			ПоказатьВопрос(Оповещение, "Вы действительно хотите удалить данные по ЭТрН?", РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

