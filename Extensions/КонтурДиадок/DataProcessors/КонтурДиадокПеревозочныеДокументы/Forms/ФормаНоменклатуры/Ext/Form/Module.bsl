&НаСервере
Перем _ОбработкаОбъект;

&НаКлиенте
Перем _КлиентскиеВызовы;

&НаКлиенте
Перем СписокВыбораВидУпак;

&НаКлиенте
Перем СписокВыбораСпособУпаковки;

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	
КонецПроцедуры

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СсылкаНаОбъект") Тогда
		СсылкаНаОбъект = Параметры.СсылкаНаОбъект;
		ЗаполнитьДанныеФормы();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
	Закрыть(СсылкаНаОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоСсылке(Команда)

	ОбновитьПоСсылкеНаСервере();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоСсылкеНаСервере()

	МодульОбъекта = ОбработкаОбъект();
	ДанныеНоменклатуры = МодульОбъекта.ДанныеНоменклатуры(СсылкаНаОбъект, "УчСист");
	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеНоменклатуры, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура рл_ВидУпакНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если СписокВыбораВидУпак = Неопределено Тогда
		СписокВыбораВидУпак = СписокВыбораВидУпак(); 
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДанныеДляВыбора", СписокВыбораВидУпак);
	ПараметрыФормы.Вставить("ОтображатьПредставление", Ложь);
	
	ДополнительныеПараметры = Новый Структура;

	Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеВыбораВидаТары", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаВыбораЗначений", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеВыбораВидаТары(ЗначениеВыбора, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеВыбора <> Неопределено Тогда
		
		рл_ВидУпак = ЗначениеВыбора.Значение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура рл_СпУпакНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если СписокВыбораСпособУпаковки = Неопределено Тогда
		СписокВыбораСпособУпаковки = СписокВыбораСпособУпаковки();
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДанныеДляВыбора", СписокВыбораСпособУпаковки);
	ПараметрыФормы.Вставить("ОтображатьПредставление", Ложь);

	ДополнительныеПараметры = Новый Структура;

	Оповещение = Новый ОписаниеОповещения("Оповещение_ПослеВыбораСпособаУпаковки", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаВыбораЗначений", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеВыбораСпособаУпаковки(ЗначениеВыбора, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеВыбора <> Неопределено Тогда
		
		рл_СпУпак = ЗначениеВыбора.Значение;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СохранитьНаСервере()

	МодульОбъекта = ОбработкаОбъект();		

	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	ЗначенияДополнительныхСвойств = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, РеквизитыФормы);
	МодульОбъекта.СохранитьЗначения(СсылкаНаОбъект, ЗначенияДополнительныхСвойств, "РеквНом");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФормы()
	
	ИнициализацияФормы();

	МодульОбъекта = ОбработкаОбъект();
	ДанныеНоменклатуры = МодульОбъекта.ДанныеНоменклатуры(СсылкаНаОбъект);

	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеНоменклатуры, ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ИнициализацияФормы()

КонецПроцедуры

&НаСервере
Функция СписокВыбораВидУпак()
	
	СписокВыбора = Новый СписокЗначений;

	МодульОбъекта = ОбработкаОбъект();
	Макет = МодульОбъекта.ПолучитьМакет("ЗначенияВидТары");
		
	Для НомерСтроки = 3 По Макет.ВысотаТаблицы Цикл  //пропустить "не указан"
		
		НаименованиеЗначения  = СокрЛП(Макет.Область(НомерСтроки, 1).Текст);
		ПолноеНаименованиеЗначения = СокрЛП(Макет.Область(НомерСтроки, 2).Текст);
		
		Если Не ЗначениеЗаполнено(НаименованиеЗначения) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбора.Добавить(ПолноеНаименованиеЗначения, ПолноеНаименованиеЗначения);
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаСервере
Функция СписокВыбораСпособУпаковки()
	
	СписокВыбора = Новый СписокЗначений;

	МодульОбъекта = ОбработкаОбъект();
	Макет = МодульОбъекта.ПолучитьМакет("ЗначенияСпособУпаковки");
		
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		НаименованиеЗначения  = СокрЛП(Макет.Область(НомерСтроки, 1).Текст);
		
		Если Не ЗначениеЗаполнено(НаименованиеЗначения) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбора.Добавить(НаименованиеЗначения, НаименованиеЗначения);
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

#КонецОбласти

