КонецПроцедуры

&НаСервере
Процедура УстановитьСписокВыбораСведенияОДоставкеФактАдресДоставки(ДанныеТрН = Неопределено)
	
	МодульОбъекта = ОбработкаОбъект();
	
	Адреса = Новый Массив;
	АдресаПоПредставлению = Новый Массив; // для проверки дублей

	Грузополучатель = ЭтаФорма.рл_СвГП_РекИдентГП;

	МодульОбъекта.ДобавитьАдресаПоУчастнику(Адреса, АдресаПоПредставлению, Грузополучатель);
	МодульОбъекта.ЗаполнитьАдресаДоставки(Адреса, АдресаПоПредставлению, ЭтаФорма.ОсновнойДокумент);
	
	Если МодульОбъекта.ЗаполненКлючСтруктуры(ДанныеТрН, "СвГП.АдресДостГр") Тогда
		Адрес = ДанныеТрН.СвГП.АдресДостГр.Адрес;
		АдресРФ = ДанныеТрН.СвГП.АдресДостГр.АдресРФ;
		МодульОбъекта.ДобавитьАдресВСписок(Адреса, АдресаПоПредставлению, Адрес, АдресРФ);
	КонецЕсли; 
	
	СписокВыбораФактАдресДоставки = Элементы.рл_СвГП_АдресДостГр_Адрес.СписокВыбора;
	СписокВыбораФактАдресДоставки.Очистить();
	Для Каждого СтруктураАдреса Из Адреса Цикл
		СписокВыбораФактАдресДоставки.Добавить(СтруктураАдреса.Адрес, СтруктураАдреса.ПредставлениеАдреса);
	КонецЦикла;
	
	ХранениеАдресаДоставки = ПоместитьВоВременноеХранилище(Адреса, УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура УстановитьСписокВыбораСведенияОПогрузкеФактАдресПогрузки(ДанныеТрН = Неопределено)
	
	МодульОбъекта = ОбработкаОбъект();

	Адреса = Новый Массив;
	АдресаПоПредставлению = Новый Массив; // для проверки дублей
	
	ЗаданИсточникАдреса = Ложь;
	Если ЗначениеЗаполнено(рл_Сценарий) Тогда
		Если ЗначениеЗаполнено(рл_СвПогруз_ВладИнфр_РекВладИнф) Тогда
			ИсточникАдреса = рл_СвПогруз_ВладИнфр_РекВладИнф;
			МодульОбъекта.ДобавитьАдресаПоУчастнику(Адреса, АдресаПоПредставлению, ИсточникАдреса);
			ЗаданИсточникАдреса = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(рл_СвПогруз_СвЛицПогрГр_РекЛицПогрГр) Тогда
			ИсточникАдреса = рл_СвПогруз_СвЛицПогрГр_РекЛицПогрГр;
			МодульОбъекта.ДобавитьАдресаПоУчастнику(Адреса, АдресаПоПредставлению, ИсточникАдреса);
			ЗаданИсточникАдреса = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗаданИсточникАдреса Тогда
		ИсточникАдреса = ЭтаФорма.рл_СвГО_РекИдентГО;
		МодульОбъекта.ДобавитьАдресаПоУчастнику(Адреса, АдресаПоПредставлению, ИсточникАдреса);
	КонецЕсли;
	
	МодульОбъекта.ЗаполнитьАдресаПогрузки(Адреса, АдресаПоПредставлению, ЭтаФорма.ОсновнойДокумент);
	
	Если МодульОбъекта.ЗаполненКлючСтруктуры(ДанныеТрН, "СвПогруз.ФАдресПогр") Тогда
		Адрес = ДанныеТрН.СвПогруз.ФАдресПогр.Адрес;
		АдресРФ = ДанныеТрН.СвПогруз.ФАдресПогр.АдресРФ;
		МодульОбъекта.ДобавитьАдресВСписок(Адреса, АдресаПоПредставлению, Адрес, АдресРФ);
	КонецЕсли;

	СписокВыбораФактАдресПогрузки = Элементы.рл_СвПогруз_ФАдресПогр_Адрес.СписокВыбора;
	СписокВыбораФактАдресПогрузки.Очистить();
	Для Каждого СтруктураАдреса Из Адреса Цикл
		СписокВыбораФактАдресПогрузки.Добавить(СтруктураАдреса.Адрес, СтруктураАдреса.ПредставлениеАдреса);
	КонецЦикла;
	
	ХранениеАдресаПогрузки = ПоместитьВоВременноеХранилище(Адреса, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьЧерновик()
		
	СохранитьНаСервере();
	ПодготовитьЭлектроннуюТранспортнуюНакладную();
	СохранитьСтатусНаСервере();
	ПодготовитьСтрокуСпискаПоДаннымЧерновика();
	НастроитьВидимостьКомандФормы();
	
КонецПроцедуры

&НаКлиенте
Функция ОтказСохраненияЧерновика()
	
	Результат = Ложь;
	
	ПроверитьЭлектроннуюТранспортнуюНакладную();
	
	Для Каждого Ошибка Из Ошибки Цикл
		
		Если Ошибка.Действие = "ПоказатьОшибкуПодписки"
			Или Ошибка.Действие = "ПоказатьОшибку" Тогда
			Результат = Истина;
			Прервать;
		ИначеЕсли Ошибка.Действие = "ПредложитьСопоставить" 
			И ЭтоОтправительДокумента(Ошибка.НазваниеРеквизита) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат Тогда
		ПоказатьПредупреждение(, Ошибка.Представление, , "Сохранение и отправка ЭПД недоступны");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

