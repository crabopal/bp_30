Процедура Оповещение_ПослеВыбораТекстИнфИдентиф(ЗначениеВыбора, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеВыбора <> Неопределено Тогда
		
		ТекущиеДанные = рл_ИнфПол.НайтиПоИдентификатору(ДополнительныеПараметры.ИндентификаторСтроки);
		ТекущиеДанные.ТекстИнф_Идентиф = ЗначениеВыбора.Значение;
		ТекущиеДанные.Представление = ЗначениеВыбора.Представление;
		Если СтрНайтиЛок(ТекущиеДанные.ТекстИнф_Идентиф, "_DATE") > 0 Тогда
			ТекущиеДанные.ТекстИнф_Значение = '00010101000000';
		Иначе
			ТекущиеДанные.ТекстИнф_Значение = "";
		КонецЕсли;
		Модифицированность = Истина;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуНоменклатуры()
	            
	ТекущиеДанные = Элементы.рл_ОпГруз.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) 
		Или ТипЗнч(ТекущиеДанные.Номенклатура) = Тип("Строка") Тогда
		Возврат;	
	КонецЕсли;  

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СсылкаНаОбъект", ТекущиеДанные.Номенклатура);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущаяСтрока", Элементы.рл_ОпГруз.ТекущаяСтрока);

	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеЗакрытияФормыНоменклатуры", ЭтаФорма, ДополнительныеПараметры);

	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаНоменклатуры", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеЗакрытияФормыНоменклатуры(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия <> Неопределено Тогда
		Если ДополнительныеПараметры.Свойство("ТекущаяСтрока") Тогда
			Оповещение_ПослеЗакрытияФормыНоменклатурыНаСервере(ДополнительныеПараметры.ТекущаяСтрока);	
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура Оповещение_ПослеЗакрытияФормыНоменклатурыНаСервере(ТекущаяСтрока)
	СтрокаГруз = рл_ОпГруз.НайтиПоИдентификатору(ТекущаяСтрока);
	Если СтрокаГруз <> Неопределено Тогда
		МодульОбъекта = ОбработкаОбъект();
		МодульОбъекта.ЗаполнитьСтрокуТоваровПоДополнительнымРеквизитамТрН(СтрокаГруз);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура рл_ОпГрузНоменклатураПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.рл_ОпГруз.ТекущаяСтрока;
	Оповещение_ПослеЗакрытияФормыНоменклатурыНаСервере(ТекущаяСтрока);
КонецПроцедуры

#КонецОбласти


