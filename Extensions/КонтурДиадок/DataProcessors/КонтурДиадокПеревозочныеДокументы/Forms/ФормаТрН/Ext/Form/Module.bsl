	Возврат _Платформа;
КонецФункции

&НаКлиенте
Функция Модуль_ЯдроНаКлиенте() Экспорт
	
	Возврат _КлиентскиеВызовы.Модуль_ЯдроНаКлиенте();
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы, Модуль_Платформа) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	_Платформа = Модуль_Платформа;
	
КонецПроцедуры

&НаСервере
Функция ОпределитьДокументыОснованияИОсновной(Параметры)
	
	МодульОбъекта = ОбработкаОбъект();
	
	//{ ааа5                       
	ИмяДокументаРеализация = МодульОбъекта.ИмяДокументаРеализация();
	Если ИмяДокументаРеализация <> Неопределено Тогда
		ОсновнойДокумент = Документы[ИмяДокументаРеализация].ПустаяСсылка();;
	КонецЕсли;
	//} ааа5
	
	_ДокументыОснования = Новый Массив;
	
	Если Параметры.Свойство("ДокументОснование") Тогда
		
		ОсновнойДокумент = Параметры.ДокументОснование;
		_ДокументыОснования.Добавить(ОсновнойДокумент);
		
	ИначеЕсли Параметры.Свойство("ДокументыОснования")
		И Параметры.ДокументыОснования.Количество() > 0 Тогда
		
		//{ ааа5                       
		ИмяСправочникаДополнительныеСвойства = МодульОбъекта.ИмяСправочникаДополнительныеСвойства();
		Если ТипЗнч(Параметры.ДокументыОснования[0]) = Тип("СправочникСсылка." + ИмяСправочникаДополнительныеСвойства) Тогда
		//} ааа5
			
			ИдентификаторТрН = Параметры.ДокументыОснования[0];
			_ДокументыОснования = МодульОбъекта.ДокументыОснования(МодульОбъекта.КлючИдентификатораТрН(), ИдентификаторТрН);
			ОсновнойДокумент = _ДокументыОснования[0];       
			
		Иначе
			_ДокументыОснования = Параметры.ДокументыОснования;
			ОсновнойДокумент = _ДокументыОснования[0];       
		КонецЕсли;
		
	Иначе
		
		_ДокументыОснования.Добавить(ОсновнойДокумент);

	КонецЕсли;  
	
	Возврат _ДокументыОснования;
	
КонецФункции

&НаСервере
Процедура УстановитьЗаголовок()
	ЭтаФорма.Заголовок = "Диадок: Транспортная накладная";
КонецПроцедуры

