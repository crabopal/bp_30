&НаКлиенте
Процедура НастроитьПараметрыПодписания(Команда)
	
	BoxId = "";
	ОтправительДокумента = ОтправительДокумента();
	ИдентификаторыГО = ИдентификаторыЭДОНаСервере(ОтправительДокумента, Истина, ОтправительДокумента);
	BoxId = ИдентификаторыГО.BoxId;
	
	Если ЗначениеЗаполнено(BoxId) Тогда
		
		Модуль_Платформа = Модуль_Платформа();
		ПараметрыОткрытия = Модуль_Платформа.ПараметрыФормыРедактированияПолномочий();
		
		ПараметрыОткрытия.АдресЯщика = BoxId;
		ПараметрыОткрытия.ТипКонтента = ТипКонтента_ЭТрН();
		ПараметрыОткрытия.ПокупательПродавец = "Продавец";
		ПараметрыОткрытия.ВидТитула = ВидТитула_ЭТрН();
		
		Модуль_Платформа.ОткрытьФормуДиадокМодальноЛок(
			"РедактированиеПолномочийУправляемая",
			ЭтаФорма,
			ПараметрыОткрытия);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Перезаполнить(Команда)
	
	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеОтветаПерезаполнения", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Документ ЭТрН будет перезаполнен. Продолжить?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеОтветаПерезаполнения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПараметрыЗаполненияФормы = ПараметрыЗаполненияФормы();
		ПараметрыЗаполненияФормы.ПерезаполнитьШапку = Истина;
		ПараметрыЗаполненияФормы.ПерезаполнитьОпГруз = Истина;
		ПараметрыЗаполненияФормы.ПерезаполнитьСценарий = Истина;
		ПараметрыЗаполненияФормы.ВыбранныйСценарий = рл_Сценарий;
		ЗаполнитьДанныеФормы(ПараметрыЗаполненияФормы);
		НастройкаФормыПоСценарию(Ложь);

		ПроверитьЭлектроннуюТранспортнуюНакладную();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СгруппироватьСведенияОГрузе(Команда)

	ИдентификаторыСтрок = ИдентификаторыВыделенныхСтрокСведенияОГрузе();
	Если ИдентификаторыСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(Неопределено, "Отметьте строки в таблице ""Грузы"", которые нужно сгруппировать");
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторыСтрок.Количество() < 2 Тогда
		ПоказатьПредупреждение(Неопределено, "Для группировки необходимо отметить минимум две строки");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ИдентификаторыСтрок", ИдентификаторыСтрок);
	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеПодтвержденияГруппировкиСведенияОГрузе", ЭтаФорма, ДополнительныеПараметры);
	ПараметрыФормы = Новый Структура;
	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаОбъединениеПозиций", ПараметрыФормы, ЭтаФорма, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеПодтвержденияГруппировкиСведенияОГрузе(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторНовойСтроки = СгруппироватьСведенияОГрузеНаСервере(ДополнительныеПараметры.ИдентификаторыСтрок, РезультатЗакрытия);
	Если ЗначениеЗаполнено(ИдентификаторНовойСтроки) Тогда
		Элементы.рл_ОпГруз.ТекущаяСтрока = ИдентификаторНовойСтроки;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	
	Для Каждого СтрокаГруза Из рл_ОпГруз Цикл
		СтрокаГруза.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)

	Для Каждого СтрокаГруза Из рл_ОпГруз Цикл
		СтрокаГруза.Пометка = Ложь;
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

