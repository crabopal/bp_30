Функция ЗаголовокПоляСПояснением(ЗаголовокПоля, ПояснениеПоля)
	
	фПояснениеПоля = Новый ФорматированнаяСтрока(ПояснениеПоля, Новый Шрифт(,,,Ложь), Новый Цвет(51,51,153));
	фЗаголовокПоля = Новый ФорматированнаяСтрока(ЗаголовокПоля, Новый Шрифт(,,Истина));
	Результат = Новый ФорматированнаяСтрока(фЗаголовокПоля, " - ",  фПояснениеПоля);
	Возврат Результат;
	
КонецФункции


&НаСервере
Функция ТекущийСценарий(ВыбранныйСценарий, СохраненныйСценарий)
	
	МодульОбъекта = ОбработкаОбъект();
	
	Результат = МодульОбъекта.СценарийУниверсальный();
	Если ЗначениеЗаполнено(ВыбранныйСценарий) Тогда
		Результат = ВыбранныйСценарий;
	ИначеЕсли ЗначениеЗаполнено(СохраненныйСценарий) Тогда
		Результат = СохраненныйСценарий;
	ИначеЕсли ЗначениеЗаполнено(ИдентификаторТрН) Тогда
		Значение = МодульОбъекта.ПолучитьЗначениеСведения(ИдентификаторТрН, "Сценарий", Истина);
		Если Значение <> Неопределено Тогда
			Если Лев(Значение, 1) = "<" Тогда
				Значение = ДесериализоватьXML(Значение);
				Если ТипЗнч(Значение) = Тип("Структура") Тогда
					Результат = МодульОбъекта.ИдентификаторСценария(Значение);
				КонецЕсли;
			Иначе
				Результат = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции  	

