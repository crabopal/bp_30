&НаКлиенте
Функция ИдентификаторыВыделенныхСтрокСведенияОГрузе()
	
	Результат = Новый Массив;
	Для Каждого СтрокаГруза Из рл_ОпГруз Цикл
		Если СтрокаГруза.Пометка Тогда
			ИдентификаторСтроки = СтрокаГруза.ПолучитьИдентификатор();
			Если Результат.Найти(ИдентификаторСтроки) = Неопределено Тогда
				Результат.Добавить(ИдентификаторСтроки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СгруппироватьСведенияОГрузеНаСервере(ИдентификаторыСтрок, НазваниеПозиции)
	
	Если ИдентификаторыСтрок = Неопределено Или ИдентификаторыСтрок.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МодульОбъекта = ОбработкаОбъект();
	ТЗ = рл_ОпГруз.Выгрузить();
	ТЗ.Очистить();
	
	ПоследняяСтрока = Новый Структура;
	СтрокиДляГруппировки = Новый Массив;
	ОбъединенныеОпасныеГрузы = Новый Массив;
	ОбъединенныеКонтейнеры = Новый Массив;
	
	Для Каждого ИдентификаторСтроки Из ИдентификаторыСтрок Цикл
		СтрокаСведенияОГрузе = рл_ОпГруз.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаСведенияОГрузе <> Неопределено Тогда
			СтрокиДляГруппировки.Добавить(СтрокаСведенияОГрузе);
			ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), СтрокаСведенияОГрузе);
			ДобавитьДанныеИзXMLВМассивСведенияОГрузе(ОбъединенныеОпасныеГрузы, СтрокаСведенияОГрузе.ОпасныеГрузыXML);
			ДобавитьДанныеИзXMLВМассивСведенияОГрузе(ОбъединенныеКонтейнеры, СтрокаСведенияОГрузе.КонтейнерыXML);
			ПоследняяСтрока = СтрокаСведенияОГрузе;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ТаблицаЗначений.КолМестГр, 0) КАК КолМестГр,
	|	ЕСТЬNULL(ТаблицаЗначений.Объем, 0) КАК Объем,
	|	ЕСТЬNULL(ТаблицаЗначений.ПлМасГруз_МасБрутЗнач, 0) КАК ПлМасГруз_МасБрутЗнач,
	|	ЕСТЬNULL(ТаблицаЗначений.ПлМасГруз_МасНетЗнач, 0) КАК ПлМасГруз_МасНетЗнач,
	|	ЕСТЬNULL(ТаблицаЗначений.ПлМасГруз_КолПалл, 0) КАК ПлМасГруз_КолПалл,
	|	ЕСТЬNULL(ТаблицаЗначений.ЦеннГруз_СтЦеннГр, 0) КАК ЦеннГруз_СтЦеннГр
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТаблицаЗначений КАК ТаблицаЗначений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&НазваниеПозиции КАК Номенклатура,
	|	СУММА(ВремТаб.КолМестГр) КАК КолМестГр,
	|	СУММА(ВремТаб.Объем) КАК Объем,
	|	СУММА(ВремТаб.ПлМасГруз_МасБрутЗнач) КАК ПлМасГруз_МасБрутЗнач,
	|	СУММА(ВремТаб.ПлМасГруз_МасНетЗнач) КАК ПлМасГруз_МасНетЗнач,
	|	СУММА(ВремТаб.ПлМасГруз_КолПалл) КАК ПлМасГруз_КолПалл,
	|	СУММА(ВремТаб.ЦеннГруз_СтЦеннГр) КАК ЦеннГруз_СтЦеннГр
	|ИЗ
	|	ВТ КАК ВремТаб";
	
	Запрос.УстановитьПараметр("ТаблицаЗначений", ТЗ);
	Запрос.УстановитьПараметр("НазваниеПозиции", НазваниеПозиции);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ИдентификаторНовойСтроки = Неопределено;
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = рл_ОпГруз.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПоследняяСтрока);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		ИдентификаторНовойСтроки = НоваяСтрока.ПолучитьИдентификатор();
		Прервать;
	КонецЦикла;
	
	Если ИдентификаторНовойСтроки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	НоваяСтрока.ОпасныеГрузыXML = ?(ОбъединенныеОпасныеГрузы.Количество() > 0, МодульОбъекта.СериализоватьXML(ОбъединенныеОпасныеГрузы), "");
	НоваяСтрока.КонтейнерыXML = ?(ОбъединенныеКонтейнеры.Количество() > 0, МодульОбъекта.СериализоватьXML(ОбъединенныеКонтейнеры), "");
	НоваяСтрока.ОпасныеГрузыГиперссылка = ?(НоваяСтрока.ОпасныеГрузыXML = "", "<добавить>", "<редактировать>");
	НоваяСтрока.КонтейнерыГиперссылка = ?(НоваяСтрока.КонтейнерыXML = "", "<добавить>", "<редактировать>");
	
	Для Каждого СтрокаСведенияОГрузе Из СтрокиДляГруппировки Цикл
		рл_ОпГруз.Удалить(СтрокаСведенияОГрузе);
	КонецЦикла;
	
	ЗаполнитьКолМестПрием();
	ЗаполнитьСвПогруз_МасБрутОтгр();
	
	Возврат ИдентификаторНовойСтроки;
	
КонецФункции

&НаСервере
Процедура ДобавитьДанныеИзXMLВМассивСведенияОГрузе(РезультирующийМассив, СтрокаXML)

	МодульОбъекта = ОбработкаОбъект();
	
	Если Не ЗначениеЗаполнено(СтрокаXML) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXML = МодульОбъекта.ДесериализоватьXML(СтрокаXML);
	Если ТипЗнч(ДанныеXML) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементДанных Из ДанныеXML Цикл
		Если ТипЗнч(ЭлементДанных) = Тип("Структура") Тогда
			РезультирующийМассив.Добавить(ЭлементДанных);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ПроверкаИСтатусы

&НаСервере
Функция ПодготовитьЭлектроннуюТранспортнуюНакладную(УчитыватьОшибки = Истина)
	
	МодульОбъекта = ОбработкаОбъект();
	Формат = "__etrnTitle1";
	ПараметрыТрН = Новый Структура;
	ПараметрыТрН.Вставить("ДанныеСотрудника", Новый Структура);

	мДокументыОснования = МодульОбъекта.ДокументыОснования(МодульОбъекта.КлючИдентификатораТрН(), ИдентификаторТрН);
	Если мДокументыОснования.Найти(ОсновнойДокумент) = Неопределено
		И ЗначениеЗаполнено(ОсновнойДокумент) Тогда
		мДокументыОснования.Добавить(ОсновнойДокумент);
	КонецЕсли;
	//{ ааа5                       
	СообщениеТрН = МодульОбъекта.ПодготовитьСообщениеТрН(Формат, ИдентификаторТрН, мДокументыОснования, ОсновнойДокумент, ПараметрыТрН);
	//} ааа5                       

	ЕстьОшибки = ОбработатьОшибки(СообщениеТрН);
	Если ЕстьОшибки И УчитыватьОшибки Тогда
		Результат = Неопределено;
	Иначе
		Результат = МодульОбъекта.СобратьXmlПоДокументу(СообщениеТрН, Формат, ПараметрыТрН);
	КонецЕсли;

	ОпределитьСтатусДокумента(ЕстьОшибки);	

	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОпределитьСтатусДокумента(ЕстьОшибки)

	МодульОбъекта = ОбработкаОбъект();
	
	ДополнительныйСтатусЛок = "";

	СтатусЛок = МодульОбъекта.ОпределитьСтатусТрН(ЕстьОшибки);
	СтатусДокумента = МодульОбъекта.СтрШаблонЛок("%1", СтатусЛок);
	
	СтатусыДоОтправки = МодульОбъекта.СтатусыДоОтправки();
	Если ТипЗнч(СтрокаСписка) = Тип("Структура") Тогда
		
		СтатусЛок = СтрокаСписка.Статус;
		
		Если ЗначениеЗаполнено(СтатусЛок)
			И СтатусыДоОтправки.Найти(СтатусЛок) = Неопределено Тогда
			
			ДополнительныйСтатусЛок = СтрокаСписка.ДополнительныйСтатус;
			
			СтатусДокумента = МодульОбъекта.СтрШаблонЛок("%1   %2", СтатусЛок, ДополнительныйСтатусЛок);
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ИндикаторСтатуса.ЦветТекста = МодульОбъекта.ЦветМаркераСтатуса(СтатусЛок, ДополнительныйСтатусЛок);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЭлектроннуюТранспортнуюНакладную()
	
	МодульОбъекта = ОбработкаОбъект();
	
	УдалитьПустыеЗначенияНаблюдателей();
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	ЗначенияДополнительныхСвойств = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, РеквизитыФормы, "ФормаТрН");
	СообщениеТрН = Новый Структура;
	МодульОбъекта.ЗаменитьСсылкиНаСтруктуры(СообщениеТрН, ЗначенияДополнительныхСвойств);

	ЕстьОшибки = ОбработатьОшибки(СообщениеТрН);
	
	ОпределитьСтатусДокумента(ЕстьОшибки);
	
КонецПроцедуры

&НаСервере
Функция ОбработатьОшибки(СообщениеТрН)
	     
	МодульОбъекта = ОбработкаОбъект();
	Сценарий = МодульОбъекта.ЗначениеСтруктурыПоКлючу(СообщениеТрН, "Сценарий");
	ЭтоШаблон = МодульОбъекта.СценарийШаблон(Сценарий);
	
	НезаполненныеРеквизиты = Новый Массив;
	ПараметрыВалидации = МодульОбъекта.ВсеПараметрыВалидацииТрН();
	МодульОбъекта.ПроверитьОбязательныеПоля(СообщениеТрН, СообщениеТрН, ПараметрыВалидации, НезаполненныеРеквизиты);
	МодульОбъекта.ПроверитьИСкорректироватьДействия(НезаполненныеРеквизиты, ЭтоШаблон);
	МодульОбъекта.ПроверитьИдентификаторыЭДО(СообщениеТрН, НезаполненныеРеквизиты, "ФормаТрН", ИдентификаторТрН);
	
	Ошибки.Очистить();
	Для Каждого ПараметрыПоля Из НезаполненныеРеквизиты Цикл
		
		СтрокаСОшибкой = "";
		ИдентификаторСтроки = "";
		Если ПараметрыПоля.Свойство("НомерСтрокиОшибки") И ПараметрыПоля.НомерСтрокиОшибки > 0 Тогда
			СтрокаСОшибкой = " строка " + ПараметрыПоля.НомерСтрокиОшибки;
			ИдентификаторСтроки = ЭтаФорма[ПараметрыПоля.ИмяРеквизитаТЧ][ПараметрыПоля.НомерСтрокиОшибки-1].ПолучитьИдентификатор();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыПоля.ИмяФормы) Тогда
			НоваяСтрока = Ошибки.Добавить();
			НоваяСтрока.НазваниеРеквизита = ПараметрыПоля.НазваниеРеквизита;
			Если ПараметрыПоля.Свойство("ТекстОшибки") Тогда
				НоваяСтрока.Представление = ПараметрыПоля.ТекстОшибки;
				НоваяСтрока.НекорректноЗаполнено = Истина;
			Иначе
				НоваяСтрока.Представление = "Указать: " + ПараметрыПоля.Представление + СтрокаСОшибкой;
			КонецЕсли;
			НоваяСтрока.Действие = ПараметрыПоля.Действие;
			НоваяСтрока.ИмяФормы = ПараметрыПоля.ИмяФормы;
			НоваяСтрока.ИмяРеквизитаРодителя = ПараметрыПоля.ИмяРеквизитаРодителя;
			НоваяСтрока.ИмяРеквизитаТЧ = ПараметрыПоля.ИмяРеквизитаТЧ;
			НоваяСтрока.ИндексКартинки = ПараметрыПоля.ИндексКартинки;
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			НоваяСтрока.ЗначениеРеквизита = ПараметрыПоля.ЗначениеРеквизита;
			Если МодульОбъекта.СтрНайтиЛок(ЭтаФорма.ИмяФормы, ПараметрыПоля.ИмяФормы) > 0 Тогда
				Попытка
					Элементы[ПараметрыПоля.НазваниеРеквизита].АвтоОтметкаНезаполненного = Истина;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.ГруппаОшибки.Видимость = ЕстьОшибки();
	ЕстьКритическиеОшибки = ЕстьКритическиеОшибки();
	Если ЕстьКритическиеОшибки Тогда
		Элементы.ГруппаОшибки.Заголовок = "Необходимо исправить ошибки:";	
	Иначе
		Элементы.ГруппаОшибки.Заголовок = "Обратите внимание на предупреждения:";	
	КонецЕсли;
	
	Возврат ЕстьКритическиеОшибки;
	
КонецФункции

&НаСервере
Функция ЕстьКритическиеОшибки()
	
	Результат = Ложь;
	
	Для Каждого Ошибка Из Ошибки Цикл
		Если Не Ошибка.Действие = "ПоказатьПредупреждение"
			И Не Ошибка.Действие = "Предупреждение" Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЕстьОшибки()
	
	Результат = Ошибки.Количество() > 0;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЕстьКритическиеОшибкиНаКлиенте()
	
	Результат = Ложь;
	
	Для Каждого Ошибка Из Ошибки Цикл
		Если Не Ошибка.Действие = "ПоказатьПредупреждение"
			И Не Ошибка.Действие = "Предупреждение" Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УдалитьПустыеЗначенияНаблюдателей()
	
	МассивПустыхЗначений = Новый Массив;
	Для Каждого ЭлементИдПолИной Из рл_ИдПолИной Цикл
		Если Не ЗначениеЗаполнено(ЭлементИдПолИной.Значение) Тогда
			МассивПустыхЗначений.Добавить(ЭлементИдПолИной);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПустоеЗначение Из МассивПустыхЗначений Цикл
		рл_ИдПолИной.Удалить(ПустоеЗначение);
	КонецЦикла;
			
КонецПроцедуры

