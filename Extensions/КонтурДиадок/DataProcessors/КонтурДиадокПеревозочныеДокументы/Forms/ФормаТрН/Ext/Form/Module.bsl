&НаКлиенте
Процедура кф_ЗаполнитьПоТорговойСети(Команда)
	
	СписокТорговыхСетей = СписокТорговыхСетей();
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДанныеДляВыбора", СписокТорговыхСетей);
	ПараметрыФормы.Вставить("ОтображатьПредставление", Истина);
	Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_ПослеВыбораТорговойСети", ЭтаФорма);
	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаВыбораЗначений", ПараметрыФормы, ЭтаФорма, Оповещение);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТорговуюСетьПоИННКПП()
	
	Если ЗначениеЗаполнено(рл_СвГП_РекИдентГП) Тогда
		МодульОбъекта = ОбработкаОбъект();
		Участник = МодульОбъекта.ДанныеОбъекта(рл_СвГП_РекИдентГП, "РекИдентГП");
		ИННКППУчастника = МодульОбъекта.ИННКППУчастника(Участник);
		
		Если ЗначениеЗаполнено(ИННКППУчастника.ИНН) Тогда
			МодульОбъекта = ОбработкаОбъект();
			КодТорговойСети = МодульОбъекта.ОпределитьТорговуюСеть(ИННКППУчастника.ИНН, ИННКППУчастника.КПП);
			ТекущийКодТорговойСети = Неопределено;
			Если рл_ИнфПол.Количество() > 0 Тогда
				ТекущийКодТорговойСети = рл_ИнфПол[0].КодТорговойСети;
			КонецЕсли;
			Если ТекущийКодТорговойСети <> КодТорговойСети Тогда
				ЗаполнитьПоляТорговойСети(КодТорговойСети);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Оповещение_ПослеВыбораТорговойСети(ЗначениеВыбора, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеВыбора <> Неопределено Тогда
		
		ЗаполнитьПоляТорговойСети(ЗначениеВыбора.Значение);		

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоляТорговойСети(КодТорговойСети)
	
	МодульОбъекта = ОбработкаОбъект();
	МодульОбъекта.ЗаполнитьПоляТорговойСети(рл_ИнфПол, КодТорговойСети);
	
КонецПроцедуры

&НаСервере
Функция СписокТорговыхСетей() 
	МодульОбъекта = ОбработкаОбъект();
	Возврат МодульОбъекта.СписокТорговыхСетей();
КонецФункции

&НаКлиенте
Процедура рл_ИнфПолВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.рл_ИнфПол.ТекущиеДанные;
	Если Поле.Имя = "рл_ИнфПолТекстИнф_Идентиф" 
		Или Поле.Имя = "рл_ИнфПолПредставление"
		Или Поле.Имя = "рл_ИнфПолТребования" Тогда
		Если ТекущиеДанные <> Неопределено 
			И ТекущиеДанные.Предопределенное Тогда
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура рл_ИнфПолТекстИнф_ЗначениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.рл_ИнфПол.ТекущиеДанные;
	Если ТекущиеДанные.ТекстИнф_Значение = Неопределено Тогда
		Элементы.рл_ИнфПолТекстИнф_Значение.ВыбиратьТип = Истина;
	Иначе
		Элементы.рл_ИнфПолТекстИнф_Значение.ВыбиратьТип = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура рл_ИнфПолТекстИнф_ЗначениеОчистка(Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.рл_ИнфПол.ТекущиеДанные;
	ТекущиеДанные.ТекстИнф_Значение = Неопределено;
	
КонецПроцедуры

