&НаКлиенте
Процедура ОповеститьОбИзмененииПакета() Экспорт
	
	ПакетОтправлен = ДокументОтправлен();
	Если ПакетОтправлен Тогда
		ЯдроНаКлиенте = Модуль_ЯдроНаКлиенте();
		ОтборПоПакету	= ЯдроНаКлиенте.Контракт_ОтборПоПакету();
		ЗаполнитьЗначенияСвойств(ОтборПоПакету, СтрокаСписка);
		
		ОтборПоПакету.ИдентификаторПакета = СтрокаСписка.LetterId;
		
		ИмяСобытия = "Диадок_ОбновитьГлавныйСписок";
		ПараметрыОповещения = ОтборПоПакету;
		ИсточникОповещения = ИдентификаторОсновнойФормы;
		
		Оповестить(ИмяСобытия, ПараметрыОповещения, ИсточникОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередатьВПодразделение(Команда)
	
	Пакет = ПодготовитьПакетНаСервере();
	
	ДанныеДляОбработки = Новый Массив;
	Документ = Пакет.Документы[0];
	ДанныеДляОбработки.Добавить(Документ);
	
	КатегорияМетрики	= Метрика_НазваниеКатегорииПоНаправлению();
	КоличествоДанных	= ДанныеДляОбработки.Количество();
	
	ДействиеМетрики		= "Передать в подразделение";
	Метрика_НажатиеКнопкиПакетнойОбработки(КатегорияМетрики, ДействиеМетрики, КоличествоДанных);
	
	ЯдроНаКлиенте = Модуль_ЯдроНаКлиенте();
	Действие = ЯдроНаКлиенте.Перечисление_ДействияЭДО().ПередатьВПодразделение;
	
	Модуль_Платформа = Модуль_Платформа();
	
	ПараметрыОбработки = Новый_ПараметрыГрупповойОбработки(
		ДанныеДляОбработки,
		Действие,
		КатегорияМетрики,
		ДействиеМетрики
	);
	ПараметрыОбработки.ИсточникОткрытия = Неопределено;
	Модуль_Платформа.ОбработатьПередатьВПодразделение(, ПараметрыОбработки);
	
КонецПроцедуры

