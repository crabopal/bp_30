Функция ПустаяСсылкаПоРеквизиту(ИмяРеквизита)
	
	МодульОбъекта = ОбработкаОбъект();
	Результат = Неопределено;
	Если ИмяРеквизита = "рл_СвТС_ТС" Или ИмяРеквизита = "рл_СвТС_Прицеп" Тогда
		Если МодульОбъекта.ИмяСправочникаТранспортныеСредства() <> Неопределено Тогда
			Результат = Справочники[МодульОбъекта.ИмяСправочникаТранспортныеСредства()].ПустаяСсылка();
		КонецЕсли;
	ИначеЕсли ИмяРеквизита = "рл_СвВодит1" Или ИмяРеквизита = "рл_СвВодит2" Или ИмяРеквизита = "рл_СвВодит3" Тогда
		Если МодульОбъекта.ИмяСправочникаФизическиеЛица() <> Неопределено Тогда
			Результат = Справочники[МодульОбъекта.ИмяСправочникаФизическиеЛица()].ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
			
	Возврат Результат;
			
КонецФункции

&НаСервере
Функция ЗаголовокИзРеквизитов(ПутьКДанным)
	
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	Для Каждого СтрокаРеквизит Из РеквизитыФормы Цикл
		Если СтрокаРеквизит.Имя = ПутьКДанным Тогда
			Возврат СтрокаРеквизит.Заголовок;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура Оповещение_УстановитьЗначениеПоУмолчанию(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	ПредставлениеРеквизита = ДополнительныеПараметры.ПредставлениеРеквизита;
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить("Field", ПредставлениеРеквизита);
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ПрименитьНастройки;
	Метрика_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные);
	
	ПроверитьНастройкиЗначенийПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеНастройкиЗначенийПоУмолчанию(ОтображениеНастроекПоУмолчанию)
	
	Для Каждого Элемент Из ЭтаФорма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("КнопкаФормы") 
			И Лев(Элемент.Имя, 3) = "кф_" Тогда
			Элемент.Видимость = Не Элемент.Видимость;
			ОтображениеНастроекПоУмолчанию = Элемент.Видимость;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНастройкиЗначенийПоУмолчанию()

	ОбработкаОбъект = ОбработкаОбъект();
	Для Каждого Элемент Из ЭтаФорма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("КнопкаФормы") 
			И Лев(Элемент.Имя, 3) = "кф_" Тогда
			ИмяРеквизита = Сред(Элемент.Имя, 4);
			Результат = Новый Структура;
			Результат.Вставить("ЗначениеРеквизита", Неопределено);
			Результат.Вставить("ИмяРеквизита", ИмяРеквизита);
			
			МетаданныеДокумента = ОсновнойДокумент.Метаданные().ПолноеИмя();
			ИдентификаторНастройки = МетаданныеДокумента + "_" + ОбработкаОбъект.КлючРеквизитовТрН() + "_" + ИмяРеквизита;
			
			Настройки = ОбработкаОбъект.ВосстановитьНастройки(ИдентификаторНастройки).Настройки;
			Если ЗначениеЗаполнено(Настройки)
				И Настройки.Количество() > 0 Тогда
				Элемент.ЦветФона = WebЦвета.Золотой;
			Иначе
				Элемент.ЦветФона = Новый Цвет();
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеПоУмолчанию(Команда)
	
	ИмяРеквизитаБезПрефикса = Сред(Команда.Имя, 4);
	ИмяРеквизита = "рл_" + ИмяРеквизитаБезПрефикса;

	Элемент = Элементы.Найти(ИмяРеквизита);
	Если Элемент <> Неопределено Тогда 
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ИмяРеквизита", ИмяРеквизитаБезПрефикса); 
		ПараметрыФормы.Вставить("КлючРеквизитов", КлючРеквизитовТрН());
		Если Элемент.Заголовок = "" Тогда
			//получим заголовок из реквизитов
			ПредставлениеРеквизита = ЗаголовокИзРеквизитов(ИмяРеквизита);
		Иначе
			ПредставлениеРеквизита = Элемент.Заголовок;
		КонецЕсли;
		ПараметрыФормы.Вставить("ПредставлениеРеквизита", ПредставлениеРеквизита);
		Если Элемент.Имя = "рл_СвПогруз_ФАдресПогр_Адрес" Тогда
			ПараметрыФормы.Вставить("ТипРеквизита", "Адрес");
			ЗначениеРеквизита = Новый Структура;
			ЗначениеРеквизита.Вставить(ИмяРеквизитаБезПрефикса, ЭтаФорма[ИмяРеквизита]);
			ЗначениеРеквизита.Вставить(ИмяРеквизитаБезПрефикса + "РФ", ЭтаФорма[ИмяРеквизита + "РФ"]);
			ПараметрыФормы.Вставить("ЗначениеРеквизита", ЗначениеРеквизита);
			ПараметрыФормы.Вставить("ХранениеВозможныхЗначений", ХранениеАдресаПогрузки);
		ИначеЕсли Элемент.Имя = "рл_СвГП_АдресДостГр_Адрес" Тогда
			ПараметрыФормы.Вставить("ТипРеквизита", "Адрес");
			ЗначениеРеквизита = Новый Структура;
			ЗначениеРеквизита.Вставить(ИмяРеквизитаБезПрефикса, ЭтаФорма[ИмяРеквизита]);
			ЗначениеРеквизита.Вставить(ИмяРеквизитаБезПрефикса + "РФ", ЭтаФорма[ИмяРеквизита + "РФ"]);
			ПараметрыФормы.Вставить("ЗначениеРеквизита", ЗначениеРеквизита);
			ПараметрыФормы.Вставить("ХранениеВозможныхЗначений", ХранениеАдресаДоставки);
		ИначеЕсли ЭтоРеквизитXML(ИмяРеквизита) Тогда
			ДанныеРеквизита = ДесериализоватьXML(ЭтаФорма[ИмяРеквизита]);
			Если ДанныеРеквизита.Свойство("Ссылка")
				И ЗначениеЗаполнено(ДанныеРеквизита.Ссылка) Тогда
				ПараметрыФормы.Вставить("ТипРеквизита", "Ссылка");
				ПараметрыФормы.Вставить("ЗначениеРеквизита", ДанныеРеквизита.Ссылка);
			ИначеЕсли ЗначениеЗаполнено(ЭтаФорма[ИмяРеквизита]) Тогда
				ПараметрыФормы.Вставить("ТипРеквизита", "XML");
				ЗначениеРеквизита = Новый Структура;
				ЗначениеРеквизита.Вставить(ИмяРеквизитаБезПрефикса, ЭтаФорма[ИмяРеквизита]);
				ПараметрыФормы.Вставить("ЗначениеРеквизита", ЗначениеРеквизита);
				ПараметрыФормы.Вставить("ХранениеВозможныхЗначений", Неопределено);
			Иначе
				ПараметрыФормы.Вставить("ТипРеквизита", "Ссылка");
				ПараметрыФормы.Вставить("ЗначениеРеквизита", ПустаяСсылкаПоРеквизиту(ИмяРеквизита));
			КонецЕсли;
		Иначе
			ПараметрыФормы.Вставить("ТипРеквизита", "Ссылка");
			ПараметрыФормы.Вставить("ЗначениеРеквизита", ЭтаФорма[ИмяРеквизита]);
		КонецЕсли;
		ПараметрыФормы.Вставить("ОсновнойДокумент", ОсновнойДокумент);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПредставлениеРеквизита", ПредставлениеРеквизита);
		
		Оповещение = _Платформа.НовыйОписаниеОповещения("Оповещение_УстановитьЗначениеПоУмолчанию", ЭтаФорма, ДополнительныеПараметры);
		
		_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаЗначенийПоУмолчанию", ПараметрыФормы, ЭтаФорма, Оповещение);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиЗначенийПоУмолчанию(Команда)
	
	ОтображениеНастроекПоУмолчанию = Ложь;
	УправлениеНастройкиЗначенийПоУмолчанию(ОтображениеНастроекПоУмолчанию);
	ПроверитьНастройкиЗначенийПоУмолчанию();
	
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().НастройкиЗначенийПоУмолчанию;
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить("State", ОтображениеНастроекПоУмолчанию);
	Метрика_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные);
	
КонецПроцедуры

#КонецОбласти


#Область УниверсальныеВспомогательныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьНачалоВыбораИзСписка(СписокВыбора, Оповещение, ОтображатьПредставление = Истина)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДанныеДляВыбора", СписокВыбора);
	ПараметрыФормы.Вставить("ОтображатьПредставление", ОтображатьПредставление);
	_КлиентскиеВызовы.ОткрытьФормуПоИмени("ФормаВыбораЗначений", ПараметрыФормы, ЭтаФорма, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвтоПодбор(СписокВыбора, Текст, ТекстРедактирования, ДанныеВыбора, СтандартнаяОбработка)
	
	СтрокаПоиска = СтрокаПоискаФильтра(Текст, ТекстРедактирования);
	Если СтрокаПоиска = Неопределено Тогда
		ДанныеВыбора = СписокВыбора;//Новый СписокЗначений;
		СтандартнаяОбработка = Ложь;
	Иначе
		ДанныеВыбора = СписокЗначенийНайти(СтрокаПоиска, СписокВыбора); 
		Если ДанныеВыбора.Количество() = 0 Тогда
			СтандартнаяОбработка = Истина;
		Иначе
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СписокЗначенийНайти(СтрокаПоиска, СписокЗначений, РеквизитПоиска = "Представление") Экспорт

	Результат = Новый СписокЗначений;
	Для Каждого Элемент Из СписокЗначений Цикл
		Если Найти(ВРег(Элемент[РеквизитПоиска]), ВРег(СтрокаПоиска)) > 0 Тогда
			Результат.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция СтрокаПоискаФильтра(Текст, ТекстРедактирования) Экспорт

	МинимальноеКоличествоСимволов = 2;
	Если СтрДлина(СокрЛП(Текст)) >= МинимальноеКоличествоСимволов Тогда
		СтрокаПоиска = СокрЛП(Текст);
	ИначеЕсли СтрДлина(СокрЛП(ТекстРедактирования)) >= МинимальноеКоличествоСимволов Тогда
		СтрокаПоиска = СокрЛП(ТекстРедактирования);
	Иначе
		СтрокаПоиска = Неопределено;
	КонецЕсли;

	Возврат СтрокаПоиска;

КонецФункции

&НаКлиенте
Функция СтрНайтиЛок(Строка, ПодстрокаПоиска)
	
	// BSLLS:DeprecatedFind-off
	Результат = Найти(Строка, ПодстрокаПоиска);
	// BSLLS:DeprecatedFind-on
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция КлючРеквизитовТрН()
	МодульОбъекта = ОбработкаОбъект();
	Возврат МодульОбъекта.КлючРеквизитовТрН();
КонецФункции

