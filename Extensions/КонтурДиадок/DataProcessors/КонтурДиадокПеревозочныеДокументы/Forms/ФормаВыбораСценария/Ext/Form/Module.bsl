&НаСервере
Перем _ОбработкаОбъект;

&НаКлиенте
Перем _КлиентскиеВызовы;

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	МодульОбъекта = ОбработкаОбъект();
	
	СценарийПоУмолчанию = МодульОбъекта.ВосстановитьНастройки("Сценарий").Настройки;
	ТекущийСценарий = МодульОбъекта.СценарийПростаяОтгрузка();
	Если Параметры.Свойство("ТекущийСценарий") 
		И Параметры.ТекущийСценарий <> Неопределено
		И Параметры.ТекущийСценарий <> "" Тогда
		ТекущийСценарий = Параметры.ТекущийСценарий;
	КонецЕсли;
		
	ЗаполнитьСценарии();

КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	АктивироватьТекущийСценарий();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСценарии()
	
	МодульОбъекта = ОбработкаОбъект();
	Сценарии.Очистить();
	
	ДобавитьСтрокуСценария(МодульОбъекта.СценарийПростаяОтгрузка(), "Продавец", "НашСклад", "Продавец", "Продавец");
	ДобавитьСтрокуСценария(МодульОбъекта.СценарийСамовывозПокупателем(), "ПокупательСамовывоз", "НашСклад", "Продавец", "Продавец");
	ДобавитьСтрокуСценария(МодульОбъекта.СценарийОтгрузкаСоСкладаХранения(), "Продавец", "СкладПартнера", "Продавец", "ЛОП");
	ДобавитьСтрокуСценария(МодульОбъекта.СценарийСамовывозОтПоставщика(), "Покупатель", "СкладПартнера", "Покупатель", "ЛОП");
	ДобавитьСтрокуСценария(МодульОбъекта.СценарийОтгрузкаЭкспедитором(), "Продавец", "СкладПартнера", "Заказчик", "Экспедитор");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуСценария(Сценарий, КтоЗаказываетПеревозку, МестоФактическойПогрузки, КтоГотовитЭТРН, КтоПодписываетЭТРН)
	
	МодульОбъекта = ОбработкаОбъект();
	
	НоваяСтрока = Сценарии.Добавить();
	
	НоваяСтрока.Сценарий = Сценарий;
	НоваяСтрока.КтоЗаказываетПеревозку = КтоЗаказываетПеревозку;
	НоваяСтрока.МестоФактическойПогрузки = МестоФактическойПогрузки;
	НоваяСтрока.КтоГотовитЭТРН = КтоГотовитЭТРН;
	НоваяСтрока.КтоПодписываетЭТРН = КтоПодписываетЭТРН;
	
	ПредставлениеСценария = МодульОбъекта.ПредставлениеСценария(Сценарий);
	НоваяСтрока.ПредставлениеСценария = ПредставлениеСценария.ПредставлениеСценария;
	НоваяСтрока.ПодсказкаСценария = ПредставлениеСценария.ПодсказкаСценария;
	НоваяСтрока.НомерКартинки = ПредставлениеСценария.НомерКартинки;
	
	Если СценарийПоУмолчанию = Сценарий Тогда
		НоваяСтрока.Основной = 0;
	Иначе
		НоваяСтрока.Основной = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АктивироватьТекущийСценарий()
		
	Поиск = Новый Структура("Сценарий", ТекущийСценарий);
		
	НашлиСтроки = Сценарии.НайтиСтроки(Поиск);  
	Если НашлиСтроки.Количество() > 0 Тогда
		Элементы.Сценарии.ТекущаяСтрока = НашлиСтроки[0].ПолучитьИдентификатор();	
	КонецЕсли;
	
	ОписаниеПоСценарию();
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеПоСценарию()
		
	УстановитьФлажкиПоОписанию();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиПоОписанию()
	
	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы["ПометкаКтоЗаказываетПеревозкуПродавец"].Видимость = Ложь;
	Элементы["ПометкаКтоЗаказываетПеревозкуПокупатель"].Видимость = Ложь;
	Элементы["ПометкаКтоЗаказываетПеревозкуПокупательСамовывоз"].Видимость = Ложь;
	Элементы["ПометкаКтоЗаказываетПеревозкуПродавецПусто"].Видимость = Истина;
	Элементы["ПометкаКтоЗаказываетПеревозкуПокупательПусто"].Видимость = Истина;
	Элементы["ПометкаКтоЗаказываетПеревозкуПокупательСамовывозПусто"].Видимость = Истина;
	Если ЗначениеЗаполнено(ТекущиеДанные.КтоЗаказываетПеревозку) Тогда
		Элементы["ПометкаКтоЗаказываетПеревозку" + ТекущиеДанные.КтоЗаказываетПеревозку].Видимость = Истина;
		Элементы["ПометкаКтоЗаказываетПеревозку" + ТекущиеДанные.КтоЗаказываетПеревозку + "Пусто"].Видимость = Ложь;
	КонецЕсли;
	
	Элементы["ПометкаМестоФактическойПогрузкиНашСклад"].Видимость = Ложь;
	Элементы["ПометкаМестоФактическойПогрузкиСкладПартнера"].Видимость = Ложь;
	Элементы["ПометкаМестоФактическойПогрузкиНашСкладПусто"].Видимость = Истина;
	Элементы["ПометкаМестоФактическойПогрузкиСкладПартнераПусто"].Видимость = Истина;
	Если ЗначениеЗаполнено(ТекущиеДанные.МестоФактическойПогрузки) Тогда
		Элементы["ПометкаМестоФактическойПогрузки" + ТекущиеДанные.МестоФактическойПогрузки].Видимость = Истина;	
		Элементы["ПометкаМестоФактическойПогрузки" + ТекущиеДанные.МестоФактическойПогрузки + "Пусто"].Видимость = Ложь;	
	КонецЕсли;

	Элементы["ПометкаКтоГотовитЭТРНПродавец"].Видимость = Ложь;
	Элементы["ПометкаКтоГотовитЭТРНПокупатель"].Видимость = Ложь;
	Элементы["ПометкаКтоГотовитЭТРНЗаказчик"].Видимость = Ложь;
	Элементы["ПометкаКтоГотовитЭТРНПродавецПусто"].Видимость = Истина;
	Элементы["ПометкаКтоГотовитЭТРНПокупательПусто"].Видимость = Истина;
	Элементы["ПометкаКтоГотовитЭТРНЗаказчикПусто"].Видимость = Истина;
	Если ЗначениеЗаполнено(ТекущиеДанные.КтоГотовитЭТРН) Тогда
		Элементы["ПометкаКтоГотовитЭТРН" + ТекущиеДанные.КтоГотовитЭТРН].Видимость = Истина;
		Элементы["ПометкаКтоГотовитЭТРН" + ТекущиеДанные.КтоГотовитЭТРН + "Пусто"].Видимость = Ложь;
	КонецЕсли;
	
	Элементы["ПометкаКтоПодписываетЭТРНПродавец"].Видимость = Ложь;
	Элементы["ПометкаКтоПодписываетЭТРНЛОП"].Видимость = Ложь;
	Элементы["ПометкаКтоПодписываетЭТРНЭкспедитор"].Видимость = Ложь;
	Элементы["ПометкаКтоПодписываетЭТРНПродавецПусто"].Видимость = Истина;
	Элементы["ПометкаКтоПодписываетЭТРНЛОППусто"].Видимость = Истина;
	Элементы["ПометкаКтоПодписываетЭТРНЭкспедиторПусто"].Видимость = Истина;
	Если ЗначениеЗаполнено(ТекущиеДанные.КтоПодписываетЭТРН) Тогда
		Элементы["ПометкаКтоПодписываетЭТРН" + ТекущиеДанные.КтоПодписываетЭТРН].Видимость = Истина;
		Элементы["ПометкаКтоПодписываетЭТРН" + ТекущиеДанные.КтоПодписываетЭТРН + "Пусто"].Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
		
	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные; 
	Если ТекущиеДанные <> Неопределено Тогда 
		ОповеститьОВыбореСценария(ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОповеститьОВыбореСценария(ТекущиеДанные)
	
	ДопПеременные = Новый Соответствие;
	ДопПеременные.Вставить("Scenario", ТекущиеДанные.Сценарий);
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().ВыбратьСценарий;
	Метрика_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные);
	
	ОповеститьОВыборе(ТекущиеДанные.Сценарий);
	
КонецПроцедуры

&НаКлиенте
Процедура СценарииПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные; 
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущийСценарий = ТекущиеДанные.Сценарий;
		ПодключитьОбработчикОжидания("ОписаниеПоСценарию", 0.01, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СценарииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	ОповеститьОВыбореСценария(ТекущиеДанные);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПоУмолчаниюНаСервере()
	
	МодульОбъекта = ОбработкаОбъект();
	СценарийПоУмолчанию = МодульОбъекта.ВосстановитьНастройки("Сценарий").Настройки;
	Если ТипЗнч(СценарийПоУмолчанию) = Тип("Структура") Тогда
		СценарийПоУмолчанию = МодульОбъекта.ИдентификаторСценария(СценарийПоУмолчанию);
	КонецЕсли;

	Если СценарийПоУмолчанию <> Неопределено И СценарийПоУмолчанию = ТекущийСценарий Тогда
		УстановитьПризнакОсновнойВСценариях(СценарийПоУмолчанию, 1);
		МодульОбъекта.ЗаписатьНастройки(Неопределено, "Сценарий");
		СценарийПоУмолчанию = Неопределено;
	Иначе
		Если СценарийПоУмолчанию <> Неопределено Тогда
			УстановитьПризнакОсновнойВСценариях(СценарийПоУмолчанию, 1);
		КонецЕсли;
		МодульОбъекта.ЗаписатьНастройки(ТекущийСценарий, "Сценарий");
		СценарийПоУмолчанию = ТекущийСценарий;
		УстановитьПризнакОсновнойВСценариях(СценарийПоУмолчанию, 0);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПризнакОсновнойВСценариях(Сценарий, Основной)
	
	Поиск = Новый Структура("Сценарий", Сценарий);

	НашлиСтроки = Сценарии.НайтиСтроки(Поиск);
	Для Каждого НашлиСтроку Из НашлиСтроки Цикл
		НашлиСтроку.Основной = Основной;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоУмолчанию(Команда)
	
	УстановитьПоУмолчаниюНаСервере();

	СценарийПоУмолчаниюУстановлен = (Не СценарийПоУмолчанию = Неопределено);
	ДопПеременные = Новый Соответствие;
	Если СценарийПоУмолчаниюУстановлен Тогда
		ДопПеременные.Вставить("Scenario", ТекущийСценарий);
	КонецЕсли;
	ДействиеМетрики = _КлиентскиеВызовы.Метрика_НазваниеДействий().УстановитьОсновнойСценарий;
	Метрика_ПриВыполненииДействия(ДействиеМетрики, ДопПеременные, СценарийПоУмолчаниюУстановлен);
	
КонецПроцедуры

&НаКлиенте
Процедура Метрика_ПриВыполненииДействия(ДействиеМетрики, Доппеременные = Неопределено, Метка = Неопределено)
	
	НаименованиеФормы = Метрика_НаименованиеФормы();
	ПредставлениеМетрики = Метрика_ПредставленияМетрик().ПакетНаОтправку;
	
	_КлиентскиеВызовы.Метрика_ДобавитьПоведение_НажатиеКнопки(НаименованиеФормы, ДействиеМетрики, ПредставлениеМетрики);
	_КлиентскиеВызовы.Метрика_ДобавитьСтатистику_ПоКонтексту(ДействиеМетрики, ДопПеременные, , , Метка);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция Метрика_НаименованиеФормы()
	
	Возврат "Транспортная накладная";
	
КонецФункции

&НаКлиенте
Функция Метрика_ПредставленияМетрик()
	
	Результат = Новый Структура;
	Результат.Вставить("ПакетНаОтправку", "Пакет на отправку ЭТрН");
	
	Возврат Результат;
	
КонецФункции

