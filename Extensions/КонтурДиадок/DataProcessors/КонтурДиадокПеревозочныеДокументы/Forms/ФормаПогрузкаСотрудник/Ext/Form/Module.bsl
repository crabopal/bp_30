&НаСервере
Перем _ОбработкаОбъект;

&НаКлиенте
Перем _КлиентскиеВызовы;

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьФорму(ФормаКлиентскиеВызовы) Экспорт
	
	_КлиентскиеВызовы = ФормаКлиентскиеВызовы;
	
КонецПроцедуры

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СсылкаНаОбъект") Тогда
		СсылкаНаОбъект = Параметры.СсылкаНаОбъект;
		ЗаполнитьДанныеФормы();
	КонецЕсли;
	
	Если Параметры.Свойство("ИмяТекущегоЭлемента") Тогда
		
		Попытка
			ЭтаФорма.ТекущийЭлемент = Элементы[Параметры.ИмяТекущегоЭлемента];
		Исключение
		КонецПопытки;
		
	КонецЕсли;
		
	ОбновитьОтметкуОбязательныхПолей();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
	Закрыть(СсылкаНаОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоСсылке(Команда)
	ОбновитьПоСсылкеНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СохранитьНаСервере()

	МодульОбъекта = ОбработкаОбъект();		

	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	ЗначенияДополнительныхСвойств = МодульОбъекта.ЗначенияДополнительныхСвойствПоФорме(ЭтаФорма, РеквизитыФормы);
	МодульОбъекта.СохранитьЗначения(СсылкаНаОбъект, ЗначенияДополнительныхСвойств, "РабЛиц");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФормы()
	
	ИнициализацияФормы();

	МодульОбъекта = ОбработкаОбъект();
	ДанныеПогрузкаСотрудник = МодульОбъекта.ДанныеПогрузкаСотрудник(СсылкаНаОбъект);

	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеПогрузкаСотрудник, ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ИнициализацияФормы()

КонецПроцедуры

&НаСервере
Процедура ОбновитьПоСсылкеНаСервере()

	МодульОбъекта = ОбработкаОбъект();
	ДанныеПогрузкаСотрудник = МодульОбъекта.ДанныеПогрузкаСотрудник(СсылкаНаОбъект, "УчСист");
	МодульОбъекта.ЗаполнитьДанныеФормы(ДанныеПогрузкаСотрудник, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтметкуОбязательныхПолей()

	МодульОбъекта = ОбработкаОбъект();
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();

	МодульОбъекта.ОтметитьОбязательныеПоля(ЭтаФорма, РеквизитыФормы, Элементы, Ложь);
	
	ПараметрыВалидации = Новый Структура;
	МодульОбъекта.ПараметрыВалидацииПогрузкаСотрудник(ПараметрыВалидации);

	ОбязательныеРеквизиты = МодульОбъекта.ОбязательныеРеквизитыФормы(ЭтаФорма, РеквизитыФормы, "ФормаПогрузкаСотрудник", ПараметрыВалидации);
	
	МодульОбъекта.ОтметитьОбязательныеПоля(ЭтаФорма, ОбязательныеРеквизиты, Элементы, Истина);
	
КонецПроцедуры

#КонецОбласти

