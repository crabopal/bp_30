Функция НомерНаПечатьЛокализация(НомерДокумента)
	
	УдалитьПрефиксИнформационнойБазы = Истина;
	УдалитьПользовательскийПрефикс = Ложь;
	
	МодульПрефиксацияОбъектов = ОбщийМодульЛок("ПрефиксацияОбъектовКлиентСервер");
	Результат = МодульПрефиксацияОбъектов.НомерНаПечать(
		НомерДокумента,
		УдалитьПрефиксИнформационнойБазы,
		УдалитьПользовательскийПрефикс);
		
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеНомераСчетаФактуры(СчетФактура)
	
	Результат = "";
	
	МетаданныеСчета = СчетФактура.Метаданные();
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	ЕстьНомерНаПечать = МодульОбщегоНазначения.ЕстьРеквизитОбъекта("НомерНаПечать", МетаданныеСчета);
	
	РеквизитыСФ = ЗначенияРеквизитовОбъектаЛок(СчетФактура, "Номер, Исправление, ИсправляемыйСчетФактура");
	Если РеквизитыСФ.Исправление
		И ЕстьНомерНаПечать
		И ЗначениеЗаполнено(РеквизитыСФ.ИсправляемыйСчетФактура) Тогда
		Результат = ЗначениеРеквизитаОбъектаЛок(РеквизитыСФ.ИсправляемыйСчетФактура, "НомерНаПечать");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Если ЕстьНомерНаПечать Тогда
			СчетФактураОбъект = СчетФактура.ПолучитьОбъект();
			Результат = Документы.СчетФактура.ПредставлениеНомераСчетаФактуры(СчетФактураОбъект);
		Иначе
			Результат = ПредставлениеНомераСчетаФактурыУНФ16(РеквизитыСФ.Номер);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеНомераСчетаФактурыУНФ16(НомерДокумента)
	
	БезПрефиксаИнформационнойБазы = Константы.ПредставлениеНомераДокументаБезПрефиксаИнформационнойБазы.Получить();
	БезПрефиксаПользователя = Константы.ПредставлениеНомераДокументаБезПрефиксаПользователя.Получить();
	
	МодульПрефиксацияОбъектов = ОбщийМодульЛок("ПрефиксацияОбъектовКлиентСервер");
	Результат = МодульПрефиксацияОбъектов.НомерНаПечать(
		НомерДокумента,
		БезПрефиксаИнформационнойБазы,
		БезПрефиксаПользователя);
	
	Возврат Результат;
	
КонецФункции

