// НАИМЕНОВАНИЯ

Функция ЧастиФИОФизическогоЛица(ФизЛицо)
	
	Результат = Новый Структура("Фамилия, Имя, Отчество", "", "", "");
	
	Если Не ЗначениеЗаполнено(ФизЛицо) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МетаданныеФизЛица = ФизЛицо.Метаданные();
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	ЕстьРеквизитыФИО = МодульОбщегоНазначения.ЕстьРеквизитОбъекта("Фамилия", МетаданныеФизЛица)
		И МодульОбщегоНазначения.ЕстьРеквизитОбъекта("Имя", МетаданныеФизЛица)
		И МодульОбщегоНазначения.ЕстьРеквизитОбъекта("Отчество", МетаданныеФизЛица);
	
	Если ЕстьРеквизитыФИО Тогда
		Результат = ЗначенияРеквизитовОбъектаЛок(ФизЛицо, "Фамилия, Имя, Отчество");
		Если ЗначениеЗаполнено(Результат.Фамилия) Или ЗначениеЗаполнено(Результат.Имя) Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = ФИОИзСтроки(ЗначениеРеквизитаОбъектаЛок(ФизЛицо, "Наименование"));
	
	Возврат Результат;
	
КонецФункции

Функция ФИОИзСтроки(Знач СтрокаФИО)
	
	Результат = Новый Структура("Фамилия, Имя, Отчество", "", "", "");
	
	СтрокаФИО = УбратьМаркерИПИзНаименования(СтрокаФИО);
	Части = СтдСтр().СтрРазделитьЛок(СокрЛП(СтрокаФИО), " ", Ложь);
	
	Если Части.Количество() > 0 Тогда
		Результат.Фамилия = Части[0];
	КонецЕсли;
	Если Части.Количество() > 1 Тогда
		Результат.Имя = Части[1];
	КонецЕсли;
	// BSLLS:MagicNumber-off
	Если Части.Количество() > 2 Тогда
		Результат.Отчество = Части[2];
	КонецЕсли;
	// BSLLS:MagicNumber-on
	
	Возврат Результат;
	
КонецФункции

Функция УбратьМаркерИПИзНаименования(Наименование)
	
	Результат = "";
	СтрокаФИО = СокрЛП(Наименование);
	Части = СтдСтр().СтрРазделитьЛок(СтрокаФИО, " ", Ложь);
	
	Если Части.Количество() > 0 Тогда
		// BSLLS:IfElseIfEndsWithElse-off
		Если ВРег(Части[0]) = "ИП" Тогда
			Части.Удалить(0);
		ИначеЕсли ВРег(Части[Части.Количество() - 1]) = "ИП" Тогда
			Части.Удалить(Части.Количество() - 1);
		ИначеЕсли НРег(Части[0]) = "индивидуальный" И НРег(Части[1]) = "предприниматель" Тогда
			Части.Удалить(0);
			Части.Удалить(0);
		КонецЕсли;
		// BSLLS:IfElseIfEndsWithElse-on
		Результат = СтдСтр().СтрСоединитьЛок(Части, " ");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

