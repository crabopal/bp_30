// ШАПКА

Процедура ЗаполнитьРеквизитыШапкиПоКорректировкеРеализации(Контракт)
	
	ДанныеШапки = ДанныеШапкиУКДПоКорректировкеРеализации();
	
	Контракт.Ссылка = ДанныеШапки.Ссылка;
	Контракт.Номер = ДанныеШапки.НомерОтгрузочногоДокумента;
	Контракт.ПредставлениеНомера = НомерНаПечатьЛокализация(ДанныеШапки.НомерОтгрузочногоДокумента);
	Контракт.Дата = ДанныеШапки.ДатаОтгрузочногоДокумента;
	ЗаполнитьИсправлениеШапкиУКД(Контракт, ДанныеШапки);
	
	ЗаполнитьПродавцаИСоставителяШапкиУКД(Контракт, ДанныеШапки);
	
	Контракт.Покупатель = ДанныеШапки.Покупатель;
	ЗаполнитьБанковскийСчетПокупателяШапкиУКД(Контракт, ДанныеШапки.БанковскийСчетКонтрагента);
	Контракт.КПППокупателя = ДанныеШапки.КПППокупателя;
	
	Контракт.Договор = ДанныеШапки.Договор;
	Контракт.Основание = ДанныеШапки.ИсправляемыйДокументРеализации ;
	Контракт.ОснованиеНомер = ДанныеШапки.НомерОтгрузочногоДокумента;
	Контракт.ОснованиеДата = ДанныеШапки.ДатаОтгрузочногоДокумента;
	
	Контракт.КодВидаОперации = "";
	Контракт.ВидОперации = "";
	Контракт.Налогообложение = "";
	
	ЗаполнитьВалютуШапкиУКД(Контракт, ДанныеШапки);
	Контракт.ИдентификаторГосКонтракта = ДанныеШапки.ИдентификаторГосКонтракта;
	Контракт.ЭтоВозвратТоваровОтКлиента = Ложь;
	
	Контракт.ПервичныеДокументы = РеквизитыПервичныхДокументовПоКорректировкеРеализации();
	Контракт.ДокументыОснования = РеквизитыДокументовОснованияПоКорректировкеРеализации();
	
КонецПроцедуры

Функция ДанныеШапкиУКДПоКорректировкеРеализации()
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаШапкиУКДПоКорректировкеРеализации();
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ИнициализироватьВременнуюТаблицуДанныхДокументовУКД(МенеджерВременныхТаблиц, УчетныйДокумент1С);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	РеквизитыДокумента = Запрос.Выполнить().Выгрузить();
	
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	Результат = МодульОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РеквизитыДокумента[0]);
	
	Возврат Результат;
	
КонецФункции

Процедура ИнициализироватьВременнуюТаблицуДанныхДокументовУКД(МенеджерВременныхТаблиц, ДокументОснование)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапросаВременныхТаблицДокументаКорректировкиРеализацииУКД();
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ТекстЗапросаВременныхТаблицДокументаКорректировкиРеализацииУКД()
	
	Результат =
	"ВЫБРАТЬ
	|	КонстантаВалютаРегламентированногоУчета.Значение КАК ВалютаРеглУчета
	|ПОМЕСТИТЬ КонстантаВалютаРегламентированногоУчета
	|ИЗ
	|	Константа.НациональнаяВалюта КАК КонстантаВалютаРегламентированногоУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СуммыДокументовРегламентированныйУчет.Регистратор КАК ИсправляемыйДокумент,
	|	СУММА(СуммыДокументовРегламентированныйУчет.Всего) КАК СуммаРегл
	|ПОМЕСТИТЬ ВременнаяТаблицаКорректируемыйДокумент
	|ИЗ
	|	РегистрСведений.СуммыДокументовРегламентированныйУчет КАК СуммыДокументовРегламентированныйУчет
	|ГДЕ
	|	СуммыДокументовРегламентированныйУчет.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	СуммыДокументовРегламентированныйУчет.Регистратор;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Ссылка,
	|	Реквизиты.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА Реквизиты.Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА Реквизиты.Организация.ГоловнаяОрганизация
	|		ИНАЧЕ Реквизиты.Организация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА Реквизиты.Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				И НЕ Реквизиты.Организация = Реквизиты.Организация.ГоловнаяОрганизация
	|			ТОГДА Реквизиты.Организация
	|		КОГДА Реквизиты.Подразделение.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				И Реквизиты.Подразделение.ГоловнаяОрганизация = Реквизиты.Организация
	|			ТОГДА Реквизиты.Подразделение
	|		ИНАЧЕ Реквизиты.Организация
	|	КОНЕЦ КАК ОбособленноеПодразделениеПоставщика,
	|	ВЫБОР
	|		КОГДА Реквизиты.Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				И Реквизиты.Организация.ГоловнаяОрганизация <> Реквизиты.Организация
	|			ТОГДА Реквизиты.Организация.ЦифровойИндексОбособленногоПодразделения
	|		КОГДА Реквизиты.Подразделение.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				И Реквизиты.Подразделение.ГоловнаяОрганизация = Реквизиты.Организация
	|			ТОГДА Реквизиты.Подразделение.ЦифровойИндексОбособленногоПодразделения
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ЦифровойИндексОбособленногоПодразделения,
	|	Реквизиты.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА Реквизиты.Контрагент.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И Реквизиты.Контрагент.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА Реквизиты.Контрагент.ГоловнойКонтрагент
	|		ИНАЧЕ Реквизиты.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Реквизиты.Грузополучатель.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И Реквизиты.Грузополучатель.ГоловнойКонтрагент = Реквизиты.Контрагент
	|				И Реквизиты.Грузополучатель.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА Реквизиты.Грузополучатель
	|		ИНАЧЕ Реквизиты.Контрагент
	|	КОНЕЦ КАК ОбособленноеПодразделениеПокупателя,
	|	Реквизиты.БанковскийСчет КАК БанковскийСчет,
	|	Реквизиты.БанковскийСчетКонтрагента КАК БанковскийСчетКонтрагента,
	|	Реквизиты.ИсправляемыйДокументРеализации КАК ИсправляемыйДокументРеализации,
	|	ВЫБОР
	|		КОГДА КонстантаВалютаРегламентированногоУчета.ВалютаРеглУчета <> Реквизиты.ВалютаДокумента
	|				И Реквизиты.Договор.РасчетыВУсловныхЕдиницах
	|			ТОГДА КонстантаВалютаРегламентированногоУчета.ВалютаРеглУчета
	|		ИНАЧЕ Реквизиты.ВалютаДокумента
	|	КОНЕЦ КАК ВалютаДокумента,
	|	Реквизиты.Договор КАК Договор,
	|	Реквизиты.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ВЫБОР
	|		КОГДА КонстантаВалютаРегламентированногоУчета.ВалютаРеглУчета <> Реквизиты.ВалютаДокумента
	|				И Реквизиты.Договор.РасчетыВУсловныхЕдиницах
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИспользоватьПересчет,
	|	ВЫБОР
	|		КОГДА Реквизиты.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Исправление,
	|	ВЫБОР
	|		КОГДА НЕ ВременнаяТаблицаКорректируемыйДокумент.СуммаРегл ЕСТЬ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА Реквизиты.ИсправляемыйДокументРеализации.СуммаДокумента = 0
	|						ТОГДА 1
	|					ИНАЧЕ ВременнаяТаблицаКорректируемыйДокумент.СуммаРегл / Реквизиты.ИсправляемыйДокументРеализации.СуммаДокумента
	|				КОНЕЦ
	|		КОГДА Реквизиты.Курс = 0
	|			ТОГДА 1
	|		ИНАЧЕ Реквизиты.Курс
	|	КОНЕЦ КАК Курс,
	|	ВЫБОР
	|		КОГДА НЕ ВременнаяТаблицаКорректируемыйДокумент.СуммаРегл ЕСТЬ NULL
	|			ТОГДА 1
	|		КОГДА Реквизиты.Кратность = 0
	|			ТОГДА 1
	|		ИНАЧЕ Реквизиты.Кратность
	|	КОНЕЦ КАК Кратность,
	|	НЕОПРЕДЕЛЕНО КАК ИдентификаторГосКонтракта,
	|	ВложенныйЗапрос.МаксНомерСтроки КАК МаксНомерСтроки,
	|	Реквизиты.ОставлятьПустымКоличествоВУПД КАК ОставлятьПустымКоличествоВУПД,
	|	Реквизиты.ДобавленоИзменениеГТД КАК ДобавленоИзменениеГТД
	|ПОМЕСТИТЬ ВременнаяТаблицаРеквизиты
	|ИЗ
	|	Документ.КорректировкаРеализации КАК Реквизиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ КонстантаВалютаРегламентированногоУчета КАК КонстантаВалютаРегламентированногоУчета
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВременнаяТаблицаКорректируемыйДокумент КАК ВременнаяТаблицаКорректируемыйДокумент
	|		ПО Реквизиты.ИсправляемыйДокументРеализации = ВременнаяТаблицаКорректируемыйДокумент.ИсправляемыйДокумент,
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(КорректировкаРеализацииЗапасы.НомерСтроки) КАК МаксНомерСтроки
	|	ИЗ
	|		Документ.КорректировкаРеализации.Запасы КАК КорректировкаРеализацииЗапасы
	|	ГДЕ
	|		КорректировкаРеализацииЗапасы.Ссылка = &ДокументОснование) КАК ВложенныйЗапрос
	|ГДЕ
	|	Реквизиты.Ссылка = &ДокументОснование;";
	
	Результат = ТекстЗапросаРеквизитовУКДБезПолейУНФ30(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаРеквизитовУКДБезПолейУНФ30(ТекстЗапроса)
	
	Результат = ТекстЗапроса;
	МетаданныеКорректировки = Метаданные.Документы.КорректировкаРеализации;
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	
	Если Не МодульОбщегоНазначения.ЕстьРеквизитОбъекта("ОставлятьПустымКоличествоВУПД", МетаданныеКорректировки) Тогда
		Результат = СтрЗаменить(Результат, "Реквизиты.ОставлятьПустымКоличествоВУПД", "ЛОЖЬ");
	КонецЕсли;
	
	Если Не МодульОбщегоНазначения.ЕстьРеквизитОбъекта("ДобавленоИзменениеГТД", МетаданныеКорректировки) Тогда
		Результат = СтрЗаменить(Результат, "Реквизиты.ДобавленоИзменениеГТД", "ЛОЖЬ");
	КонецЕсли;
	
	Результат = ТекстЗапросаБезДеленияНаНоль(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаШапкиУКДПоКорректировкеРеализации()
	
	Результат =
	"ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Ссылка,
	|	Реквизиты.Дата КАК ДатаОснования,
	|	Реквизиты.Организация КАК Организация,
	|	Реквизиты.Подразделение КАК Подразделение,
	|	Реквизиты.ЦифровойИндексОбособленногоПодразделения КАК ЦифровойИндексОбособленногоПодразделения,
	|	Реквизиты.Организация КАК Поставщик,
	|	Реквизиты.Организация.ИНН КАК ИННПоставщика,
	|	Реквизиты.Организация.КПП КАК КПППоставщика,
	|	Реквизиты.ОбособленноеПодразделениеПоставщика КАК ОбособленноеПодразделениеПоставщика,
	|	Реквизиты.Контрагент КАК Покупатель,
	|	Реквизиты.Контрагент.ИНН КАК ИННПокупателя,
	|	Реквизиты.Контрагент.КПП КАК КПППокупателя,
	|	Реквизиты.ОбособленноеПодразделениеПокупателя КАК ОбособленноеПодразделениеПокупателя,
	|	Реквизиты.БанковскийСчет КАК БанковскийСчет,
	|	Реквизиты.БанковскийСчетКонтрагента КАК БанковскийСчетКонтрагента,
	|	Реквизиты.ВалютаДокумента КАК Валюта,
	|	Реквизиты.Договор КАК Договор,
	|	Реквизиты.Договор.ВалютаРасчетов КАК ВалютаВзаиморасчетов,
	|	Реквизиты.Договор.РасчетыВУсловныхЕдиницах КАК РасчетыВУсловныхЕдиницах,
	|	Реквизиты.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	|	Реквизиты.Ссылка.НомерИсходногоДокумента КАК НомерОтгрузочногоДокумента,
	|	Реквизиты.Ссылка.ДатаИсходногоДокумента КАК ДатаОтгрузочногоДокумента,
	|	Реквизиты.ИсправляемыйДокументРеализации КАК ИсправляемыйДокументРеализации 
	|ИЗ
	|	ВременнаяТаблицаРеквизиты КАК Реквизиты";
	
	Возврат Результат;
	
КонецФункции

Функция ТоварныеДокументыДоКорректировкиПоКорректировкеРеализации()
	
	Результат = Новый Массив;
	ТоварныйДокументДоКорректировки = НайтиПервичныйДокументУКДПоДокументамОснования(УчетныйДокумент1С);
	ДополнитьМассивЗначением(Результат, ТоварныйДокументДоКорректировки);
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыПервичныхДокументовПоКорректировкеРеализации()
	
	Результат = Новый Массив;
	ПервичныйДокумент = НайтиПервичныйДокументУКДПоДокументамОснования(УчетныйДокумент1С);
	ДобавитьРеквизитыПервичногоДокументаУКДВКоллекцию(Результат, ПервичныйДокумент);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьРеквизитыПервичногоДокументаУКДВКоллекцию(Коллекция, СсылкаДокумента)
	
	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Ссылка", СсылкаДокумента);
	Найденные = СтдКоллекции().НайтиСтрокиМассиваСтруктур(Коллекция, Отбор);
	Если Найденные.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыПервичногоДокумента = РеквизитыПервичногоДокументаУКД(СсылкаДокумента);
	Коллекция.Добавить(РеквизитыПервичногоДокумента);
	
КонецПроцедуры

Функция РеквизитыПервичногоДокументаУКД(СсылкаДокумента)
	
	Результат = КонтрактыПровайдеров().НовыйРеквизитыСвязанногоДокумента();
	РеквизитыДокумента = ЗначенияРеквизитовОбъектаЛок(СсылкаДокумента, "Номер, Дата");
	
	Если ТипЗнч(СсылкаДокумента) = Тип("ДокументСсылка.СчетФактура") Тогда
		Результат.Номер = ПредставлениеНомераСчетаФактуры(СсылкаДокумента);
		Если Не ЗначениеЗаполнено(Результат.Номер) Тогда
			Результат.Номер = РеквизитыДокумента.Номер;
		КонецЕсли;
	Иначе
		Результат.Номер = НомерНаПечатьЛокализация(РеквизитыДокумента.Номер);
	КонецЕсли;
	
	Результат.Дата = РеквизитыДокумента.Дата;
	Результат.Ссылка = СсылкаДокумента;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДокументовОснованияПоКорректировкеРеализации()
	
	Результат = Новый Массив;
	Основание = ЗначениеРеквизитаОбъектаЛок(УчетныйДокумент1С, "ДокументОснование");
	ДобавитьРеквизитыДокументаОснованияУКДВКоллекцию(Результат, Основание);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьРеквизитыДокументаОснованияУКДВКоллекцию(Коллекция, СсылкаДокумента)
	
	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Реквизиты = РеквизитыДокументаОснованияУКД(СсылкаДокумента);
	Найденные = СтдКоллекции().НайтиСтрокиМассиваСтруктур(Коллекция, Реквизиты);
	Если Найденные.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Коллекция.Добавить(Реквизиты);
	
КонецПроцедуры

Функция НайтиПервичныйДокументУКДПоДокументамОснования(ДокументСсылка)
	
	Результат = ДокументСсылка;
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Основание = ЗначениеРеквизитаОбъектаЛок(ДокументСсылка, "ДокументОснование");
		Результат = НайтиПервичныйДокументУКДПоДокументамОснования(Основание);
		
	Иначе
		
		Результат = ДокументСсылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДокументаОснованияУКД(СсылкаДокумента)
	
	Результат = КонтрактыПровайдеров().НовыйДокументОснованияУКД();
	
	Если ТипЗнч(СсылкаДокумента) = Тип("ДокументСсылка.СчетФактура") Тогда
		ЗаполнитьРеквизитыДокументаОснованияПоСчетуФактуре(Результат, СсылкаДокумента);
	Иначе
		ЗаполнитьРеквизитыДокументаОснованияПоПервичномуДокументу(Результат, СсылкаДокумента);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьРеквизитыДокументаОснованияПоПервичномуДокументу(Результат, СсылкаДокумента)
	
	РеквизитыДокумента = ЗначенияРеквизитовОбъектаЛок(СсылкаДокумента, "Номер, Дата");
	Результат.Номер = НомерНаПечатьЛокализация(РеквизитыДокумента.Номер);
	Результат.Дата = РеквизитыДокумента.Дата;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыДокументаОснованияПоСчетуФактуре(Результат, СчетФактура)
	
	РеквизитыДокумента = ЗначенияРеквизитовОбъектаЛок(
		СчетФактура,
		"Номер, Дата, Исправление, НомерИсправления, ИсправляемыйСчетФактура");
	
	Результат.Номер = ПредставлениеНомераСчетаФактуры(СчетФактура);
	Если Не ЗначениеЗаполнено(Результат.Номер) Тогда
		Результат.Номер = РеквизитыДокумента.Номер;
	КонецЕсли;
	
	ДатаДокумента = РеквизитыДокумента.Дата;
	
	Если РеквизитыДокумента.Исправление Тогда
		Если ЗначениеЗаполнено(РеквизитыДокумента.ИсправляемыйСчетФактура) Тогда
			ДатаОснования = ЗначениеРеквизитаОбъектаЛок(РеквизитыДокумента.ИсправляемыйСчетФактура, "Дата");
			Результат.Дата = ДатаОснования;
		Иначе
			Результат.Дата = ДатаДокумента;
		КонецЕсли;
		Результат.НомерИсправления = СокрЛП(РеквизитыДокумента.НомерИсправления);
		Результат.ДатаИсправления = ДатаДокумента;
	Иначе
		Результат.Дата = ДатаДокумента;
	КонецЕсли;
	
КонецПроцедуры

