// ТАБЛИЦА

Функция ТаблицаТоваровУКДПоКорректировкеРеализации()
	
	ДокументОснование = УчетныйДокумент1С;
	Если ТипЗнч(УчетныйДокумент1С) = Тип("ДокументСсылка.СчетФактура") Тогда
		ДокументыОснования = ДокументыОснованияСчетаФактуры(УчетныйДокумент1С);
		ДокументОснование = ДокументыОснования[0];
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = ТекстЗапросаТабличнойЧастиУКДПоКорректировкеРеализации(НомераТаблиц);
	
	ПоддерживаютсяАкцизы = (
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации")
	);
	ЭтоОтчетКомиссионера = (
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетКомиссионера")
	);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	ИсправляемыйДокументРеализации = ЗначениеРеквизитаОбъектаЛок(ДокументОснование, "ИсправляемыйДокументРеализации");
	
	Запрос.УстановитьПараметр("ИсправляемыйДокументРеализации", ИсправляемыйДокументРеализации);
	
	Если ЭтоОтчетКомиссионера Тогда
		
		ЗапросТаблицаПокупатели = Новый Запрос;
		ЗапросТаблицаПокупатели.УстановитьПараметр("СсылкаНаДокумент", ДокументОснование);
		ЗапросТаблицаПокупатели.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтчетКомиссионераПокупатели.КлючСвязи КАК КлючСвязи,
		|	ОтчетКомиссионераПокупатели.ОтчетКомиссионера КАК ОтчетКомиссионера,
		|	ОтчетКомиссионераПокупатели.СчетФактура КАК СчетФактура
		|ИЗ
		|	Документ.ОтчетКомиссионера.Покупатели КАК ОтчетКомиссионераПокупатели
		|ГДЕ
		|	ОтчетКомиссионераПокупатели.Ссылка = &СсылкаНаДокумент";
		
		ТаблицаПокупатели = ЗапросТаблицаПокупатели.Выполнить().Выгрузить();
		
		ПараметрыПоиска = Новый Структура("СчетФактура", УчетныйДокумент1С);
		НайденныеСтроки = ТаблицаПокупатели.НайтиСтроки(ПараметрыПоиска);
		
		Если НайденныеСтроки.Количество() Тогда
			Запрос.УстановитьПараметр("КлючСвязи", НайденныеСтроки[0].КлючСвязи);
			Запрос.УстановитьПараметр("ИсправляемыйДокументРеализации", НайденныеСтроки[0].ОтчетКомиссионера);
		Иначе
			Запрос.УстановитьПараметр("КлючСвязи", 0);
			Запрос.УстановитьПараметр("ИсправляемыйДокументРеализации", Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПоддерживаютсяАкцизы Тогда
		ДополнениеЗапроса = ТекстЗапросаДанныеДляПечатиКорректировочныхСчетовФактурСАкцизами(НомераТаблиц);
	ИначеЕсли ЭтоОтчетКомиссионера Тогда
		ДополнениеЗапроса = ТекстЗапросаДанныеДляПечатиКорректировочныхСчетовФактурОтчетКомиссионераВозвраты(НомераТаблиц);
	Иначе
		ДополнениеЗапроса = ТекстЗапросаДанныеДляПечатиКорректировочныхСчетовФактур(НомераТаблиц);
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ДополнениеЗапроса;
	
	Если ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаДокумента.НоменклатураНабора КАК НоменклатураНабора,", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаДокумента.ХарактеристикаНабора КАК ХарактеристикаНабора,", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаДокумента.НомерГТДДоИзменения КАК НомерГТДДоИзменения,", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"ТаблицаДокумента.СтранаПроисхожденияДоИзменения КАК СтранаПроисхожденияДоИзменения,", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СтраныМира1.Код КАК СтранаПроисхожденияКодДоИзменения,", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира1", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"ПО ТаблицаДокумента.СтранаПроисхожденияДоИзменения = СтраныМира1.Ссылка", "");
		
	КонецЕсли;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ИнициализироватьВременнуюТаблицуДанныхДокументовУКД(МенеджерВременныхТаблиц, ДокументОснование);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ТекстЗапроса = ТекстЗапросаТабличнойЧастиУКДБезПолейУНФ16(ТекстЗапроса);
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаДокумента = Результат[НомераТаблиц.ТаблицаДокумента].Выгрузить();
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// BSLLS:MethodSize-off

Функция ТекстЗапросаТабличнойЧастиУКДПоКорректировкеРеализации(НомераТаблиц)
	
	НомераТаблиц.Вставить("ВременнаяТаблицаНоменклатуры", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВременнаяТаблицаДокумента", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВременнаяТаблицаСведенияПрослеживаемости", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВременнаяТаблицаСведенияПрослеживаемостиДоИзменения", НомераТаблиц.Количество());
	
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	
	Результат =
	"ВЫБРАТЬ
	|	ТаблицаНоменклатуры.Ссылка КАК Ссылка,
	|	1 КАК НомерТабЧасти,
	|	ТаблицаНоменклатуры.НомерСтроки КАК НомерСтроки,
	|	ТаблицаНоменклатуры.Номенклатура КАК Товар,
	|	ТаблицаНоменклатуры.Номенклатура.ТоварнаяНоменклатураВЭД.Код КАК ТоварКодТНВЭД,
	|	ТаблицаНоменклатуры.Номенклатура.Код КАК ТоварКод,
	|	ТаблицаНоменклатуры.Номенклатура.Штрихкод КАК ТоварШтрихкод,
	|	ТаблицаНоменклатуры.Номенклатура.Артикул КАК ТоварАртикул,
	|	ТаблицаНоменклатуры.Номенклатура.НаименованиеПолное КАК ТоварНаименование,
	|	ТаблицаНоменклатуры.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ТаблицаНоменклатуры.Содержание КАК СТРОКА(1000)), """") = """"
	|			ТОГДА ЕСТЬNULL(ТаблицаНоменклатуры.Характеристика.НаименованиеДляПечати, """")
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ХарактеристикаНаименование,
	|	СерииНоменклатурыПослеИзменения.Серия КАК Серия,
	|	ТаблицаНоменклатуры.Содержание КАК Содержание,
	|	ТаблицаНоменклатуры.СтранаПроисхождения КАК СтранаПроисхождения,
	|	НЕОПРЕДЕЛЕНО КАК ПредставлениеСтраны,
	|	ТаблицаНоменклатуры.НомерГТД КАК НомерГТД,
	|	НЕОПРЕДЕЛЕНО КАК ПредставлениеГТД,
	|	ВЫБОР
	|		КОГДА ТаблицаНоменклатуры.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И ПечатьПользовательскихЕдиницИзмерения.Значение = ЗНАЧЕНИЕ(Перечисление.ПечатьПользовательскихЕдиницИзмерения.ФормироватьПечатныйДокументВПользовательскойЕдинице)
	|				И ТаблицаНоменклатуры.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТаблицаНоменклатуры.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору
	|		ИНАЧЕ ТаблицаНоменклатуры.Номенклатура.ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ТаблицаНоменклатуры.СтавкаНДС КАК СтавкаНДС,
	|	ЛОЖЬ КАК ЭтоУслуга,
	|	ВЫБОР
	|		КОГДА ТаблицаНоменклатуры.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И ПечатьПользовательскихЕдиницИзмерения.Значение <> ЗНАЧЕНИЕ(Перечисление.ПечатьПользовательскихЕдиницИзмерения.ФормироватьПечатныйДокументВПользовательскойЕдинице)
	|			ТОГДА ВЫБОР
	|					КОГДА Реквизиты.Исправление
	|						ТОГДА ТаблицаНоменклатуры.КоличествоДоКорректировки * ТаблицаНоменклатуры.ЕдиницаИзмерения.Коэффициент
	|					ИНАЧЕ ТаблицаНоменклатуры.КоличествоДоИзменения * ТаблицаНоменклатуры.ЕдиницаИзмерения.Коэффициент
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Реквизиты.Исправление
	|					ТОГДА ТаблицаНоменклатуры.КоличествоДоКорректировки
	|				ИНАЧЕ ТаблицаНоменклатуры.КоличествоДоИзменения
	|			КОНЕЦ
	|	КОНЕЦ КАК КоличествоДоИзменения,
	|	ВЫБОР
	|		КОГДА ТаблицаНоменклатуры.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И ПечатьПользовательскихЕдиницИзмерения.Значение <> ЗНАЧЕНИЕ(Перечисление.ПечатьПользовательскихЕдиницИзмерения.ФормироватьПечатныйДокументВПользовательскойЕдинице)
	|			ТОГДА ТаблицаНоменклатуры.Количество * ТаблицаНоменклатуры.ЕдиницаИзмерения.Коэффициент
	|		ИНАЧЕ ТаблицаНоменклатуры.Количество
	|	КОНЕЦ КАК КоличествоПослеИзменения,
	|	ВЫБОР
	|		КОГДА НЕ СуммыДокументовРегламентированныйУчет.Всего ЕСТЬ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА ВЫБОР
	|							КОГДА Реквизиты.Исправление
	|								ТОГДА ТаблицаНоменклатуры.КоличествоДоКорректировки
	|							ИНАЧЕ ТаблицаНоменклатуры.КоличествоДоИзменения
	|						КОНЕЦ = 0
	|						ТОГДА СуммыДокументовРегламентированныйУчет.Всего - СуммыДокументовРегламентированныйУчет.НДС
	|					ИНАЧЕ ВЫРАЗИТЬ((СуммыДокументовРегламентированныйУчет.Всего - СуммыДокументовРегламентированныйУчет.НДС) / ВЫБОР
	|								КОГДА Реквизиты.Исправление
	|									ТОГДА ВЫБОР
	|											КОГДА ТаблицаНоменклатуры.КоличествоДоКорректировки = 0
	|												ТОГДА 1
	|											ИНАЧЕ ТаблицаНоменклатуры.КоличествоДоКорректировки
	|										КОНЕЦ
	|								ИНАЧЕ ВЫБОР
	|										КОГДА ТаблицаНоменклатуры.КоличествоДоИзменения = 0
	|											ТОГДА 1
	|										ИНАЧЕ ТаблицаНоменклатуры.КоличествоДоИзменения
	|									КОНЕЦ
	|							КОНЕЦ КАК ЧИСЛО(15, 2))
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Реквизиты.Исправление
	|					ТОГДА ТаблицаНоменклатуры.ЦенаДоКорректировки
	|				ИНАЧЕ ТаблицаНоменклатуры.ЦенаДоИзменения
	|			КОНЕЦ * ВЫБОР
	|				КОГДА Реквизиты.ИспользоватьПересчет
	|					ТОГДА Реквизиты.Курс / Реквизиты.Кратность
	|				ИНАЧЕ 1
	|			КОНЕЦ
	|	КОНЕЦ КАК ЦенаДоИзменения,
	|	ВЫБОР
	|		КОГДА Реквизиты.Исправление
	|			ТОГДА ТаблицаНоменклатуры.ЦенаДоКорректировки
	|		ИНАЧЕ ТаблицаНоменклатуры.ЦенаДоИзменения
	|	КОНЕЦ КАК ЦенаДоИзмененияВалДокумента,
	|	ТаблицаНоменклатуры.Цена * ВЫБОР
	|		КОГДА Реквизиты.ИспользоватьПересчет
	|			ТОГДА Реквизиты.Курс / Реквизиты.Кратность
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ЦенаПослеИзменения,
	|	ТаблицаНоменклатуры.Цена КАК ЦенаПослеИзмененияВалДокумента,
	|	ВЫРАЗИТЬ(ВЫБОР
	|		КОГДА НЕ СуммыДокументовРегламентированныйУчет.Всего ЕСТЬ NULL
	|			ТОГДА СуммыДокументовРегламентированныйУчет.НДС
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Реквизиты.Исправление
	|					ТОГДА ТаблицаНоменклатуры.СуммаНДСДоКорректировки
	|				ИНАЧЕ ТаблицаНоменклатуры.СуммаНДСДоИзменения
	|			КОНЕЦ * ВЫБОР
	|				КОГДА Реквизиты.ИспользоватьПересчет
	|					ТОГДА Реквизиты.Курс / Реквизиты.Кратность
	|				ИНАЧЕ 1
	|			КОНЕЦ
	|	КОНЕЦ КАК ЧИСЛО(15, 2)) КАК СуммаНДСДоИзменения,
	|	ВЫБОР
	|		КОГДА Реквизиты.Исправление
	|			ТОГДА ТаблицаНоменклатуры.СуммаНДСДоКорректировки
	|		ИНАЧЕ ТаблицаНоменклатуры.СуммаНДСДоИзменения
	|	КОНЕЦ КАК СуммаНДСДоИзмененияВалДокумента,
	|	ВЫРАЗИТЬ(ВЫБОР
	|		КОГДА ТаблицаНоменклатуры.СтавкаНДС.Ставка > 0
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаНоменклатуры.Сумма / (100 + ВЫБОР
	|						КОГДА Реквизиты.СуммаВключаетНДС
	|							ТОГДА ТаблицаНоменклатуры.СтавкаНДС.Ставка
	|						ИНАЧЕ 0
	|					КОНЕЦ) * ТаблицаНоменклатуры.СтавкаНДС.Ставка КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ 0
	|	КОНЕЦ * ВЫБОР
	|		КОГДА Реквизиты.ИспользоватьПересчет
	|			ТОГДА Реквизиты.Курс / Реквизиты.Кратность
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ЧИСЛО(15, 2)) КАК СуммаНДСПослеИзменения,
	|	ТаблицаНоменклатуры.СуммаНДС КАК СуммаНДСПослеИзмененияВалДокумента,
