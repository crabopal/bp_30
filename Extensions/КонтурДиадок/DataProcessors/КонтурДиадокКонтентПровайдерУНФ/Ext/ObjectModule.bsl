// РЕКВИЗИТЫ ШАПКИ

// Устанавливает учетный документ, по которому провайдер собирает контент.
//
// Параметры:
//  ДокСсылка - ДокументСсылка - ссылка на документ конфигурации.
//
Процедура УстановитьДокумент(ДокСсылка) Экспорт
	
	УчетныйДокумент1С = ДокСсылка;
	
КонецПроцедуры

// Возвращает реквизиты шапки УКД по установленному учетному документу.
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - контракт реквизитов шапки УКД.
//
Функция РеквизитыШапкиУКД() Экспорт
	
	ПроверитьУчетныйДокументУстановлен();
	
	Результат = КонтрактыПровайдеров().НовыйРеквизитыШапкиУКД();
	ТипДокумента = ТипЗнч(УчетныйДокумент1С);
	
	Если ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		ЗаполнитьРеквизитыШапкиПоКорректировкеРеализации(Результат);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактура") Тогда
		
		ЗаполнитьРеквизитыШапкиУКДПоСчетФактура(Результат);
		
	Иначе
		
		ТекстОшибки = СтдСтр().СтрШаблонЛок(
			НСтр("ru='Неподдерживаемый тип документа: %1'"),
			ТипДокумента);
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат ФиксированныеДанныеЛок(Результат);
	
КонецФункции

// Возвращает ссылки на товарные документы до корректировки текущего УКД.
// 
// Возвращаемое значение:
//  ФиксированныйМассив - ссылки на документы; не Неопределено;
//  пустой массив допустим; без пустых элементов и без счетов-фактур.
//
Функция ТоварныеДокументыДоКорректировкиУКД() Экспорт
	
	ПроверитьУчетныйДокументУстановлен();
	
	Результат = Новый Массив;
	ТипДокумента = ТипЗнч(УчетныйДокумент1С);
	
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактура") Тогда
		Результат = ТоварныеДокументыДоКорректировкиПоСчетуФактуре();
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Результат = ТоварныеДокументыДоКорректировкиПоКорректировкеРеализации();
	Иначе
		ТекстОшибки = СтдСтр().СтрШаблонЛок(
			НСтр("ru='Неподдерживаемый тип документа: %1'"),
			ТипДокумента);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат ФиксированныеДанныеЛок(Результат);
	
КонецФункции

// Возвращает реквизиты договора контрагента по ссылке на договор.
//
// Параметры:
//  ДоговорСсылка - СправочникСсылка.ДоговорыКонтрагентов - договор.
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - контракт реквизитов договора.
//
Функция РеквизитыДоговора(ДоговорСсылка) Экспорт
	
	Реквизиты = КонтрактыПровайдеров().НовыйРеквизитыСвязанногоДокумента();
	Реквизиты.Ссылка = ДоговорСсылка;
	
	ИсходныеДанные = ЗначенияРеквизитовОбъектаЛок(
		ДоговорСсылка, "Наименование, НомерДоговора, ДатаДоговора");
	
	Реквизиты.Наименование = ИсходныеДанные.Наименование;
	Реквизиты.Номер = ИсходныеДанные.НомерДоговора;
	Реквизиты.Дата = ИсходныеДанные.ДатаДоговора;
	
	Возврат ФиксированныеДанныеЛок(Реквизиты);
	
КонецФункции

// Возвращает реквизиты соглашения с клиентом по ссылке.
//
// Параметры:
//  СоглашениеСсылка - СправочникСсылка.СоглашенияСКлиентами - соглашение.
// 
// Возвращаемое значение:
