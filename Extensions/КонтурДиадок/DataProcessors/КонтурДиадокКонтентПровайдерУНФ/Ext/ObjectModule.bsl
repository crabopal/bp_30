Функция ДокументыОснованияСчетаФактуры(СчетФактура)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.ДокументОснование КАК Ссылка
	|ИЗ
	|	Документ.СчетФактура.ДокументыОснования КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Таблица.НомерСтроки";
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДополнитьМассивЗначением(Результат, Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьРеквизитыШапкиУКДПоСчетФактура(Контракт)
	
	ДанныеШапки = ДанныеШапкиУКДПоСчетФактура();
	
	Контракт.Ссылка = ДанныеШапки.Ссылка;
	Контракт.Номер = ДанныеШапки.Номер;
	Контракт.Дата = ДанныеШапки.Дата;
	ЗаполнитьПредставлениеНомераШапкиУКД(Контракт, ДанныеШапки);
	ЗаполнитьИсправлениеШапкиУКД(Контракт, ДанныеШапки);
	
	ЗаполнитьПродавцаИСоставителяШапкиУКД(Контракт, ДанныеШапки);
	
	Контракт.Покупатель = ДанныеШапки.Контрагент;
	ЗаполнитьБанковскийСчетПокупателяШапкиУКД(Контракт, ДанныеШапки.БанковскийСчетКонтрагента);
	Контракт.КПППокупателя = ДанныеШапки.КПППокупателя;
	
	Контракт.Договор = ДанныеШапки.Договор;
	Контракт.Основание = ДанныеШапки.Основание;
	Контракт.ОснованиеНомер = ДанныеШапки.ОснованиеНомер;
	Контракт.ОснованиеДата = ДанныеШапки.ОснованиеДата;
	
	Контракт.КодВидаОперации = СокрЛП(СтдКоллекции().СвойствоСтруктурыЛок(ДанныеШапки, "КодВидаОперации", ""));
	Контракт.ВидОперации = "";
	Контракт.Налогообложение = "";
	
	ЗаполнитьВалютуШапкиУКД(Контракт, ДанныеШапки);
	Контракт.ИдентификаторГосКонтракта = ДанныеШапки.ИдентификаторГосКонтракта;
	Контракт.ЭтоВозвратТоваровОтКлиента = Ложь;
	
	Контракт.ПервичныеДокументы = РеквизитыПервичныхДокументовПоСчетуФактуре();
	Контракт.ДокументыОснования = РеквизитыДокументовОснованияПоСчетуФактуре();
	
КонецПроцедуры

Функция ДанныеШапкиУКДПоСчетФактура()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактура.Ссылка КАК Ссылка,
	|	СчетФактура.Номер КАК Номер,
	|	СчетФактура.НомерНаПечать КАК ПредставлениеНомера,
	|	СчетФактура.КодВидаОперации КАК КодВидаОперации,
	|	ВЫБОР
	|		КОГДА СчетФактура.Исправление
	|			ТОГДА ЕСТЬNULL(ИсходныйСчетФактура.Дата, ДАТАВРЕМЯ(1, 1, 1))
	|		ИНАЧЕ СчетФактура.Дата
	|	КОНЕЦ КАК Дата,
	|	СчетФактура.Исправление КАК Исправление,
	|	СчетФактура.НомерИсправления КАК НомерИсправления,
	|	СчетФактура.ВалютаДокумента КАК Валюта,
	|	ВЫБОР
	|		КОГДА СчетФактура.Исправление
	|			ТОГДА СчетФактура.Дата
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ КАК ДатаИсправления,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА Организации.ГоловнаяОрганизация
	|		ИНАЧЕ СчетФактура.Организация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА Организации.ГоловнаяОрганизация
	|		ИНАЧЕ СчетФактура.Организация
	|	КОНЕЦ КАК Поставщик,
	|	ВЫБОР
	|		КОГДА Контрагенты.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА ВЫБОР
	|					КОГДА Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|						ТОГДА Контрагенты.ГоловнойКонтрагент
	|					ИНАЧЕ СчетФактура.Контрагент
	|				КОНЕЦ
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Контрагенты.КПП, """")
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КПППокупателя,
	|	"""" КАК КПППоставщика,
	|	СчетФактура.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	|	СчетФактура.ЭтоВозврат КАК ЭтоВозврат
	|ИЗ
	|	Документ.СчетФактура КАК СчетФактура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактура КАК ИсходныйСчетФактура
	|		ПО СчетФактура.ИсправляемыйСчетФактура = ИсходныйСчетФактура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО СчетФактура.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО СчетФактура.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	СчетФактура.Ссылка = &СчетФактура";
	Запрос.Текст = ТекстЗапросаШапкиСчетаФактурыБезПолейУНФ30(Запрос.Текст);
	Запрос.УстановитьПараметр("СчетФактура", УчетныйДокумент1С);
	
	РеквизитыДокумента = Запрос.Выполнить().Выгрузить();
	Если РеквизитыДокумента.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru='Не найдены данные счета-фактуры выданного для заполнения шапки УКД.'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	Результат = МодульОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РеквизитыДокумента[0]);
	
	ДополнитьДанныеШапкиУКДРеквизитамиДокументаОснования(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаШапкиСчетаФактурыБезПолейУНФ30(ТекстЗапроса)
	
	Результат = ТекстЗапроса;
	МетаданныеСчета = Метаданные.Документы.СчетФактура;
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	
	Если Не МодульОбщегоНазначения.ЕстьРеквизитОбъекта("НомерНаПечать", МетаданныеСчета) Тогда
		Результат = СтрЗаменить(Результат, "СчетФактура.НомерНаПечать", """""");
	КонецЕсли;
	
	Если Не МодульОбщегоНазначения.ЕстьРеквизитОбъекта("КодВидаОперации", МетаданныеСчета) Тогда
		Результат = СтрЗаменить(Результат, "СчетФактура.КодВидаОперации", """""");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьПредставлениеНомераШапкиУКД(Контракт, ДанныеШапки)
	
	Если ЗначениеЗаполнено(ДанныеШапки.ПредставлениеНомера) Тогда
		ПредставлениеНомера = ДанныеШапки.ПредставлениеНомера;
	Иначе
		ПредставлениеНомера = ПредставлениеНомераСчетаФактуры(ДанныеШапки.Ссылка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.Ссылка.Организация.ГоловнаяОрганизация)
		И ДанныеШапки.Ссылка.Организация <> ДанныеШапки.Ссылка.Организация.ГоловнаяОрганизация Тогда
		
		ЦифровойИндексОП = ДанныеШапки.Ссылка.Организация.ЦифровойИндексОбособленногоПодразделения;
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеШапки.Подразделение)
		И ДанныеШапки.Подразделение.ГоловнаяОрганизация = ДанныеШапки.Ссылка.Организация Тогда
		
		ЦифровойИндексОП = ДанныеШапки.Подразделение.ЦифровойИндексОбособленногоПодразделения;
		
	Иначе
		
		ЦифровойИндексОП = "";
		
	КонецЕсли;
	
	Контракт.ПредставлениеНомера = ПредставлениеНомера;
	Если ЗначениеЗаполнено(ЦифровойИндексОП) Тогда
		Контракт.ПредставлениеНомера = СтдСтр().СтрШаблонЛок("%1/%2", ПредставлениеНомера, ЦифровойИндексОП);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьИсправлениеШапкиУКД(Контракт, ДанныеШапки)
	
	НомерИсправления = СтдКоллекции().СвойствоСтруктурыЛок(ДанныеШапки, "НомерИсправления", "");
	ДатаИсправления = СтдКоллекции().СвойствоСтруктурыЛок(ДанныеШапки, "ДатаИсправления", Дата(1, 1, 1));
	
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		Контракт.НомерИсправления = СокрЛП(НомерИсправления);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаИсправления) Тогда
		Контракт.ДатаИсправления = ДатаИсправления;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПродавцаИСоставителяШапкиУКД(Контракт, ДанныеШапки)
	
	Если ЗначениеЗаполнено(ДанныеШапки.Поставщик)
		И ДанныеШапки.Поставщик <> ДанныеШапки.Организация Тогда
		
		Контракт.Составитель = ДанныеШапки.Организация;
		Контракт.Продавец = ДанныеШапки.Поставщик;
		
	Иначе
		
		Контракт.Продавец = ДанныеШапки.Организация;
		Контракт.БанковскийСчетПродавца = ДанныеШапки.БанковскийСчет;
		Контракт.КПППродавца = ДанныеШапки.КПППоставщика;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Контракт.БанковскийСчетПродавца) Тогда
		Контракт.БанковскийСчетПродавца = БанковскийСчетПоУмолчаниюЮрФизЛица(Контракт.Продавец);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьБанковскийСчетПокупателяШапкиУКД(Контракт, БанковскийСчетКонтрагента)
	
	Контракт.БанковскийСчетПокупателя = БанковскийСчетКонтрагента;
	Если Не ЗначениеЗаполнено(Контракт.БанковскийСчетПокупателя) Тогда
		Контракт.БанковскийСчетПокупателя = БанковскийСчетПоУмолчаниюЮрФизЛица(Контракт.Покупатель);
	КонецЕсли;
	
КонецПроцедуры

Функция БанковскийСчетПоУмолчаниюЮрФизЛица(ЮрФизЛицо)
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(ЮрФизЛицо) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	Если Не МодульОбщегоНазначения.ЕстьРеквизитОбъекта("БанковскийСчетПоУмолчанию", ЮрФизЛицо.Метаданные()) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ЗначениеРеквизитаОбъектаЛок(ЮрФизЛицо, "БанковскийСчетПоУмолчанию");
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьВалютуШапкиУКД(Контракт, ДанныеШапки)
	
	Если ПересчитыватьСуммыУКДВВалютуРеглУчета(ДанныеШапки) Тогда
		Контракт.ВалютаДокумента = ВалютаРегламентированногоУчета(ДанныеШапки.Организация);
	Иначе
		Контракт.ВалютаДокумента = ДанныеШапки.Валюта;
	КонецЕсли;
	Контракт.РасчетыВУсловныхЕдиницах = Ложь;
	
КонецПроцедуры

Функция ПересчитыватьСуммыУКДВВалютуРеглУчета(ДанныеШапки)
	
	ВалютаРегл = ВалютаРегламентированногоУчета(ДанныеШапки.Организация);
	ОплатаВВалюте = ОплатаВВалютеПоДоговору(ДанныеШапки.Договор, ВалютаРегл);
	Результат = ЗначениеЗаполнено(ВалютаРегл)
		И ДанныеШапки.Валюта <> ВалютаРегл
		И Не ОплатаВВалюте;
	
	Возврат Результат;
	
КонецФункции

Функция ОплатаВВалютеПоДоговору(Договор, ВалютаРегл)
	
	Результат = Истина;
	
	Если ЗначениеЗаполнено(Договор) Тогда
		МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
		ЕстьРеквизитВалютаРасчетов = МодульОбщегоНазначения.ЕстьРеквизитОбъекта(
			"ВалютаРасчетов",
			Договор.Метаданные());
		Если ЕстьРеквизитВалютаРасчетов Тогда
			ВалютаРасчетов = ЗначениеРеквизитаОбъектаЛок(Договор, "ВалютаРасчетов");
			Результат = (ВалютаРасчетов <> ВалютаРегл);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВалютаРегламентированногоУчета(Организация)
	
	Возврат Константы.НациональнаяВалюта.Получить();
	
КонецФункции

Процедура ДополнитьДанныеШапкиУКДРеквизитамиДокументаОснования(ДанныеШапки)
	
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Основание");
	ИменаРеквизитов.Добавить("ОснованиеНомер");
	ИменаРеквизитов.Добавить("ОснованиеДата");
	ИменаРеквизитов.Добавить("Договор");
	ИменаРеквизитов.Добавить("НалогообложениеНДС");
	ИменаРеквизитов.Добавить("БанковскийСчет");
	ИменаРеквизитов.Добавить("БанковскийСчетКонтрагента");
	ИменаРеквизитов.Добавить("ХозяйственнаяОперация");
	ИменаРеквизитов.Добавить("Подразделение");
	
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		ДанныеШапки.Вставить(ИмяРеквизита);
	КонецЦикла;
	
	ДокументыОснования = ДокументыОснованияСчетаФактуры(ДанныеШапки.Ссылка);
	Если ДокументыОснования.Количество() = 0
		Или Не ЗначениеЗаполнено(ДокументыОснования[0]) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОснование = ДокументыОснования[0];
	
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	МетаданныеДокумента = ДокументОснование.Метаданные();
	
	РеквизитыКЧтению = Новый Структура;
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Если МодульОбщегоНазначения.ЕстьРеквизитОбъекта(ИмяРеквизита, МетаданныеДокумента) Тогда
			РеквизитыКЧтению.Вставить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	Если РеквизитыКЧтению.Количество() > 0 Тогда
		РеквизитыОснования = ЗначенияРеквизитовОбъектаЛок(ДокументОснование, РеквизитыКЧтению);
		СтдКоллекции().ДополнитьСтруктуруЛок(ДанныеШапки, РеквизитыОснования, Истина);
	КонецЕсли;
	
КонецПроцедуры

Функция ТоварныеДокументыДоКорректировкиПоСчетуФактуре()
	
	Результат = Новый Массив;
	ИсходныйСчетФактура = ИсходныйСчетФактураПоКорректировочномуСФ(УчетныйДокумент1С);
	Если ЗначениеЗаполнено(ИсходныйСчетФактура) Тогда
		ДокументыОснования = ДокументыОснованияСчетаФактурыВыданного(ИсходныйСчетФактура);
		СтдКоллекции().ДополнитьМассивЛок(Результат, ДокументыОснования, Истина);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИсходныйСчетФактураПоКорректировочномуСФ(СчетФактура)
	
	Результат = Документы.СчетФактура.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Т.ИсправляемыйСчетФактура КАК Ссылка
	|ИЗ
	|	Документ.СчетФактура КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|	И Т.ИсправляемыйСчетФактура <> ЗНАЧЕНИЕ(Документ.СчетФактура.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Ссылка", СчетФактура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыОснованияСчетаФактурыВыданного(СчетФактура)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.ДокументОснование КАК Ссылка
	|ИЗ
	|	Документ.СчетФактура.ДокументыОснования КАК Т
	|ГДЕ
	|	Т.Ссылка = &СчетФактура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки";
	
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДополнитьМассивЗначением(Результат, Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыПервичныхДокументовПоСчетуФактуре()
	
	Результат = Новый Массив;
	Основания = ДокументыОснованияКорректировочногоСчетаФактуры(УчетныйДокумент1С);
	
	Для Каждого Основание Из Основания Цикл
		
		ПервичныйДокумент = НайтиПервичныйДокументУКДПоДокументамОснования(Основание.Ссылка);
		СчетФактура = СчетФактураПоДокументуОснованию(ПервичныйДокумент);
		ДобавитьРеквизитыПервичногоДокументаУКДВКоллекцию(Результат, СчетФактура);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДокументовОснованияПоСчетуФактуре()
	
	Результат = Новый Массив;
	
	ДобавитьРеквизитыДокументаОснованияУКДВКоллекцию(Результат, УчетныйДокумент1С.ИсправляемыйСчетФактура);
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыОснованияКорректировочногоСчетаФактуры(СчетФактура)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.ДокументОснование КАК Ссылка,
	|	Таблица.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.СчетФактура.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактура КАК СчетФактураШапка
	|		ПО Таблица.Ссылка = СчетФактураШапка.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|		ПО Таблица.ДокументОснование = КорректировкаРеализации.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|	И СчетФактураШапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСчетФактура.Корректировка)
	|	И НЕ КорректировкаРеализации.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СчетФактураПоДокументуОснованию(ДокументОснование)
	
	Результат = Документы.СчетФактура.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СчетФактура.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактура.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактура КАК СчетФактура
	|		ПО Таблица.Ссылка = СчетФактура.Ссылка
	|ГДЕ
	|	Таблица.ДокументОснование = &ДокументОснование
	|	И НЕ СчетФактура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

