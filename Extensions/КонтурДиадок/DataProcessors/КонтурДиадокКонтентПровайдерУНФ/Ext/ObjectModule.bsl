	Возврат Результат;
	
КонецФункции

Функция ЕстьРеквизитЗапасовКорректировкиРеализации(ИмяРеквизита)
	
	Возврат ЕстьРеквизитТабличнойЧастиКорректировкиРеализации("Запасы", ИмяРеквизита);
	
КонецФункции

Функция ЕстьРеквизитТабличнойЧастиКорректировкиРеализации(ИмяТабличнойЧасти, ИмяРеквизита)
	
	Возврат ЕстьРеквизитТабличнойЧастиДокумента("КорректировкаРеализации", ИмяТабличнойЧасти, ИмяРеквизита);
	
КонецФункции

Функция ЕстьРеквизитТабличнойЧастиДокумента(ИмяДокумента, ИмяТабличнойЧасти, ИмяРеквизита)
	
	Результат = Ложь;
	ПолноеИмяТабличнойЧасти = "Документ." + ИмяДокумента + ".ТабличныеЧасти." + ИмяТабличнойЧасти;
	Если Не МетаданныеЕстьТабличнаяЧасть(ПолноеИмяТабличнойЧасти) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МетаданныеТЧ = Метаданные.Документы[ИмяДокумента].ТабличныеЧасти[ИмяТабличнойЧасти];
	Результат = (МетаданныеТЧ.Реквизиты.Найти(ИмяРеквизита) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ВыборкаБанковскихРеквизитов(БанковскийСчет)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеСчета.НомерСчета КАК НомерСчета,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификаторБанков.ПустаяСсылка)
	|			ТОГДА БанкДляРасчетов.Наименование
	|		ИНАЧЕ КлассификаторБанков.Наименование
	|	КОНЕЦ, """") КАК Банк,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификаторБанков.ПустаяСсылка)
	|			ТОГДА БанкДляРасчетов.Код
	|		ИНАЧЕ КлассификаторБанков.Код
	|	КОНЕЦ, """") КАК БИК,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификаторБанков.ПустаяСсылка)
	|			ТОГДА БанкДляРасчетов.Адрес
	|		ИНАЧЕ КлассификаторБанков.Адрес
	|	КОНЕЦ, """") КАК АдресБанка,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификаторБанков.ПустаяСсылка)
	|			ТОГДА БанкДляРасчетов.КоррСчет
	|		ИНАЧЕ КлассификаторБанков.КоррСчет
	|	КОНЕЦ, """") КАК КоррСчет,
	|	БанковскиеСчета.ЦифровойСчет КАК ЦифровойСчет
	|ИЗ
	|	Справочник.%1 КАК БанковскиеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторБанков КАК КлассификаторБанков
	|		ПО БанковскиеСчета.Банк = КлассификаторБанков.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторБанков КАК БанкДляРасчетов
	|		ПО БанковскиеСчета.БанкРасчетов = БанкДляРасчетов.Ссылка
	|ГДЕ
	|	БанковскиеСчета.Ссылка = &БанковскийСчет";
	
	Если ТипЗнч(БанковскийСчет) = Тип("СправочникСсылка.БанковскиеСчета") Тогда
		ИмяСправочника = "БанковскиеСчета";
	Иначе
		ИмяСправочника = "БанковскиеСчетаКонтрагентов";
	КонецЕсли;
	ТекстЗапроса = СтдСтр().СтрШаблонЛок(ТекстЗапроса, ИмяСправочника);
	
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	Если Не МодульОбщегоНазначения.ЕстьРеквизитОбъекта("ЦифровойСчет", Метаданные.Справочники[ИмяСправочника]) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "БанковскиеСчета.ЦифровойСчет", "ЛОЖЬ");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьМассивЗначением(МассивПриемник, Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	Значения = СтдКоллекции().ЗначениеВМассивеЛок(Значение);
	СтдКоллекции().ДополнитьМассивЛок(МассивПриемник, Значения, Истина);
	
КонецПроцедуры

