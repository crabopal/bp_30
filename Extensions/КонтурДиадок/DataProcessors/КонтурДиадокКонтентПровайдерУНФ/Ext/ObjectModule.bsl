//
Функция ЗначениеАдресаИзПредставления(СтрокаАдреса) Экспорт
	
	Возврат Неопределено;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОЧИЕ СВЕДЕНИЯ

// Возвращает реквизиты банковского счета по ссылке.
//
// Параметры:
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - банковский счет.
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - контракт банковского счета.
//
Функция БанковскиеРеквизиты(БанковскийСчет) Экспорт
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = ВыборкаБанковскихРеквизитов(БанковскийСчет);
	Если Выборка.Следующий() Тогда
		
		Реквизиты = КонтрактыПровайдеров().НовыйБанковскийСчет();
		Реквизиты.НомерСчета = Выборка.НомерСчета;
		Реквизиты.КоррСчет = Выборка.КоррСчет;
		Реквизиты.БИК = Выборка.БИК;
		Реквизиты.АдресБанка = Выборка.АдресБанка;
		
		Если Выборка.ЦифровойСчет Тогда
			Реквизиты.Банк = "";
		Иначе
			Реквизиты.Банк = Выборка.Банк;
		КонецЕсли;
		
		Результат = ФиксированныеДанныеЛок(Реквизиты);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает строковое представление ставки НДС для печатной формы / контракта.
//
// Параметры:
//  ЗначениеСтавкиНДС - СправочникСсылка.СтавкиНДС, ПеречислениеСсылка.СтавкиНДС - ставка;
//  если не заполнена - пустая строка.
// 
// Возвращаемое значение:
//  Строка - представление ставки ("без НДС", "20", "20/120" и т.п.); не Неопределено.
//
Функция ПредставлениеСтавкиНДС(ЗначениеСтавкиНДС) Экспорт
	
	Результат = "";
	
	Если Не ЗначениеЗаполнено(ЗначениеСтавкиНДС) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ИспользуетсяБЭД19() Тогда
		Результат = ПредставлениеСтавкиНДССправочника(ЗначениеСтавкиНДС);
	Иначе
		Результат = ПредставлениеСтавкиНДСПеречисления(ЗначениеСтавкиНДС);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

