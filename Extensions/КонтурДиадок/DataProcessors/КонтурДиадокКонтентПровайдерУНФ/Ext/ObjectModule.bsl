КонецФункции

// Возвращает признак использования договоров контрагентов в соглашении с клиентом.
//
// Параметры:
//  СоглашениеСсылка - СправочникСсылка.СоглашенияСКлиентами - соглашение.
// 
// Возвращаемое значение:
//  Булево - Истина, если основанием служит договор контрагента или соглашение не заполнено.
//
Функция ИспользуютсяДоговорыКонтрагентов(СоглашениеСсылка) Экспорт
	
	Возврат Истина;
	
КонецФункции

// Возвращает код и полное наименование валюты по ссылке на элемент справочника Валюты.
//
// Параметры:
//  ВалютаСсылка - СправочникСсылка.Валюты - валюта документа.
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - контракт реквизитов валюты; Наименование - полное наименование.
//
Функция РеквизитыВалюты(ВалютаСсылка) Экспорт
	
	Реквизиты = КонтрактыПровайдеров().НовыйРеквизитыВалюты();
	ИсходныеДанные = ЗначенияРеквизитовОбъектаЛок(ВалютаСсылка, "Код, Наименование, НаименованиеПолное");
	
	Реквизиты.Код = ИсходныеДанные.Код;
	Реквизиты.Наименование = ИсходныеДанные.НаименованиеПолное;
	Если Не ЗначениеЗаполнено(Реквизиты.Наименование) Тогда
		Реквизиты.Наименование = ИсходныеДанные.Наименование;
	КонецЕсли;
	
	Возврат ФиксированныеДанныеЛок(Реквизиты);
	
КонецФункции

