Функция СтрокаКодИНаименованиеСтраныДляКонтракта(СтранаСсылка)
	
	Результат = Новый Структура("КодСтраны, НаименованиеСтраны", "", "");
	
	РеквизитыСтраны = ЗначенияРеквизитовОбъектаЛок(СтранаСсылка, "Код, Наименование");
	
	Результат.КодСтраны = СокрЛП(РеквизитыСтраны.Код);
	Результат.НаименованиеСтраны = СокрЛП(РеквизитыСтраны.Наименование);
	
	Возврат Результат;
	
КонецФункции

Функция СведенияДТСтрокиКонтрактаУКД(СтрокаТЧ)
	
	Результат = Новый Массив;
	
	ЕстьСведенияДТ = ЗначениеЗаполнено(СтрокаТЧ.НомерГТД)
		Или ЗначениеЗаполнено(СтрокаТЧ.СтранаПроисхождения);
	
	Если Не ЕстьСведенияДТ Тогда
		Возврат Результат;
	КонецЕсли;
	
	Сведение = КонтрактыПровайдеров().НовыйСведениеДТ();
	Сведение.НомерГТДСсылка = СтрокаТЧ.НомерГТД;
	Сведение.НомерГТДДо = СтрокаТЧ.НомерГТДПредставление;
	Сведение.НомерГТД = СтрокаТЧ.НомерГТДПредставление;
	Сведение.Страна = СтрокаТЧ.СтранаПроисхождения;
	Сведение.СтранаКод = СтрокаТЧ.СтранаПроисхожденияКод;
	Сведение.СтранаНаименование = СтрокаТЧ.СтранаПроисхожденияНаименование;
	
	Результат.Добавить(Сведение);
	
	Возврат Результат;
	
КонецФункции

Функция СтрокиКонтрактаУКДИзТабличныхДанных(ТаблицаТоваров)
	
	Результат = Новый Массив;
	
	ТоварныйДокумент = ТоварныйДокументУКД();
	НомерСтроки = 0;
	ЕстьНомерСтрокиИсходногоСФ =
		ТаблицаТоваров.Колонки.Найти("НомерСтрокиИсходногоСФ") <> Неопределено;
	
	Для Каждого СтрокаТЧ Из ТаблицаТоваров Цикл
		
		Если СтрокаТоваровУКДБезИзменений(СтрокаТЧ) Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
		ТипНоменклатуры = ТипНоменклатурыУКД(СтрокаТЧ.Товар);
		
		СтрокаКонтракта = КонтрактыПровайдеров().НовыйСтрокаТабличнойЧастиУКД();
		
		СтрокаКонтракта.ТоварныйДокумент = ТоварныйДокумент;
		СтрокаКонтракта.НомерСтрокиДокумента = НомерСтроки;
		СтрокаКонтракта.НомерИсходнойСтроки = НомерИсходнойСтрокиУКД(
			СтрокаТЧ,
			ЕстьНомерСтрокиИсходногоСФ);
		
		СтрокаКонтракта.Номенклатура = СтрокаТЧ.Товар;
		СтрокаКонтракта.НоменклатураКод = КодНоменклатурыПоНастройкеВПечатныхФормах(СтрокаТЧ);
		СтрокаКонтракта.НоменклатураПредставление = СтрокаТЧ.НаименованиеНоменклатуры;
		СтрокаКонтракта.ТипНоменклатуры = ТипНоменклатуры;
		СтрокаКонтракта.КодТНВЭД = СтрокаТЧ.ТоварКодТНВЭД;
		СтрокаКонтракта.ЕдиницаИзмерения = СтрокаТЧ.ЕдиницаИзмерения;
		СтрокаКонтракта.ЕдиницаИзмеренияКод = СтрокаТЧ.ЕдиницаИзмеренияКод;
		СтрокаКонтракта.ЕдиницаИзмеренияНаименование = СтрокаТЧ.ЕдиницаИзмеренияНаименование;
		СтрокаКонтракта.Характеристика = СтрокаТЧ.Характеристика;
		СтрокаКонтракта.ХарактеристикаНаименование = СтрокаТЧ.ХарактеристикаНаименование;
		СтрокаКонтракта.Серия = СтрокаТЧ.Серия;
		СтрокаКонтракта.СерияПредставление = СтрокаТЧ.СерияПредставление;
		
		СтрокаКонтракта.КоличествоДо = СтрокаТЧ.КоличествоДоИзменения;
		СтрокаКонтракта.Количество = СтрокаТЧ.КоличествоПослеИзменения;
		
		СтрокаКонтракта.СтавкаНДС = СтрокаТЧ.СтавкаНДС;
		
		СтрокаКонтракта.ЦенаДо = СтрокаТЧ.ЦенаДоИзменения;
		СтрокаКонтракта.Цена = СтрокаТЧ.ЦенаПослеИзменения;
		СтрокаКонтракта.СуммаБезНДСДо = СтрокаТЧ.СтоимостьБезНДСДоИзменения;
		СтрокаКонтракта.СуммаБезНДС = СтрокаТЧ.СтоимостьБезНДСПослеИзменения;
		СтрокаКонтракта.СуммаНДСДо = СтрокаТЧ.СуммаНДСДоИзменения;
		СтрокаКонтракта.СуммаНДС = СтрокаТЧ.СуммаНДСПослеИзменения;
		СтрокаКонтракта.СуммаСНДСДо = СтрокаТЧ.СтоимостьСНДСДоИзменения;
		СтрокаКонтракта.СуммаСНДС = СтрокаТЧ.СтоимостьСНДСПослеИзменения;
		СтрокаКонтракта.АкцизДо = СтрокаТЧ.АкцизДоИзменения;
		СтрокаКонтракта.Акциз = СтрокаТЧ.АкцизПослеИзменения;
		
		СтрокаКонтракта.РазницаБезНДСУвеличение = СтрокаТЧ.РазницаБезНДСУвеличение;
		СтрокаКонтракта.РазницаБезНДСУменьшение = СтрокаТЧ.РазницаБезНДСУменьшение;
		СтрокаКонтракта.РазницаНДСУвеличение = СтрокаТЧ.РазницаНДСУвеличение;
		СтрокаКонтракта.РазницаНДСУменьшение = СтрокаТЧ.РазницаНДСУменьшение;
		СтрокаКонтракта.РазницаСНДСУвеличение = СтрокаТЧ.РазницаСНДСУвеличение;
		СтрокаКонтракта.РазницаСНДСУменьшение = СтрокаТЧ.РазницаСНДСУменьшение;
		СтрокаКонтракта.РазницаАкцизУвеличение = СтрокаТЧ.РазницаАкцизУвеличение;
		СтрокаКонтракта.РазницаАкцизУменьшение = СтрокаТЧ.РазницаАкцизУменьшение;
		
		СтрокаКонтракта.НомерГТД = СтрокаТЧ.НомерГТД;
		СтрокаКонтракта.СтранаПроисхождения = СтрокаТЧ.СтранаПроисхождения;
		
		СтрокаКонтракта.ПрослеживаемыйТовар = СтрокаТЧ.ПрослеживаемыйТовар;
		
		Если НЕ СтрокаТЧ.ПрослеживаемыйТовар Тогда
			СтрокаКонтракта.СведенияДТ = СведенияДТСтрокиКонтрактаУКД(СтрокаТЧ);
		КонецЕсли;
		
		Результат.Добавить(СтрокаКонтракта);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТоварныйДокументУКД()
	
	Результат = Неопределено;
	ТипДокумента = ТипЗнч(УчетныйДокумент1С);
	
	Если ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Результат = УчетныйДокумент1С;
	КонецЕсли;
	
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактура") Тогда
		Основания = ДокументыОснованияСчетаФактуры(УчетныйДокумент1С);
		Если Основания.Количество() > 0 Тогда
			Результат = Основания[0];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаТоваровУКДБезИзменений(СтрокаТЧ)
	
	Результат = СтрокаТЧ.РазницаБезНДСУвеличение = СтрокаТЧ.РазницаБезНДСУменьшение
		И СтрокаТЧ.РазницаНДСУвеличение = СтрокаТЧ.РазницаНДСУменьшение
		И СтрокаТЧ.РазницаСНДСУвеличение = СтрокаТЧ.РазницаСНДСУменьшение;
	
	Возврат Результат;
	
КонецФункции

Функция НомерИсходнойСтрокиУКД(СтрокаТЧ, ЕстьНомерСтрокиИсходногоСФ)
	
	Результат = Неопределено;
	Если ЕстьНомерСтрокиИсходногоСФ
		И ЗначениеЗаполнено(СтрокаТЧ.НомерСтрокиИсходногоСФ) Тогда
		Результат = СтрокаТЧ.НомерСтрокиИсходногоСФ;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипНоменклатурыУКД(Номенклатура)
	
	ТипыНоменклатуры = КонтрактыПровайдеров().ПеречислениеТипыНоменклатуры();
	ТипНоменклатуры = ЗначениеРеквизитаОбъектаЛок(Номенклатура, "ТипНоменклатуры");
	
	Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас Тогда
		Результат = ТипыНоменклатуры.Товар;
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
		Результат = ТипыНоменклатуры.Услуга;
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
		Результат = ТипыНоменклатуры.Работа;
	Иначе
		Результат = ТипыНоменклатуры.Иное;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КодНоменклатурыПоНастройкеВПечатныхФормах(СтрокаТЧ)
	
	ЗначениеКонстанты = ПредставлениеКодовВПечатныхФормах();
	
	Если ЗначениеКонстанты = Перечисления.КодыНоменклатурыВДокументах.Артикул Тогда
		Результат = СтрокаТЧ.Артикул;
	ИначеЕсли ЗначениеКонстанты = Перечисления.КодыНоменклатурыВДокументах.Штрихкод Тогда
		Результат = СтрокаТЧ.Штрихкод;
	ИначеЕсли ЗначениеКонстанты = Перечисления.КодыНоменклатурыВДокументах.Код Тогда
		Результат = СтрокаТЧ.Код;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеКодовВПечатныхФормах()
	
	Возврат Константы.ПредставлениеКодовВПечатныхФормах.Получить();
	
КонецФункции

Функция ПредставлениеСтавкиНДССправочника(ЗначениеСтавкиНДС)
	
	Результат = XMLСтрока(ЗначениеРеквизитаОбъектаЛок(ЗначениеСтавкиНДС, "Ставка"));
	Если ЗначениеСтавкиНДС.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.БезНДС Тогда
		Результат = "без НДС";
	Иначе
		Если ЗначениеРеквизитаОбъектаЛок(ЗначениеСтавкиНДС, "Расчетная") Тогда
			СтавкаЧисло = ЗначениеРеквизитаОбъектаЛок(ЗначениеСтавкиНДС, "Ставка");
			// BSLLS:MagicNumber-off
			Результат = XMLСтрока(СтавкаЧисло) + "/" + XMLСтрока(СтавкаЧисло + 100);
			// BSLLS:MagicNumber-on
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеСтавкиНДСПеречисления(ЗначениеСтавкиНДС)
	
	Результат = Строка(ЗначениеСтавкиНДС);
	ИмяЗначения = XMLСтрока(ЗначениеСтавкиНДС);
	Если ИмяЗначения = "БезНДС" Тогда
		Результат = "без НДС";
	Иначе
		Если СтдСтр().СтрНачинаетсяСЛок(ИмяЗначения, "НДС") Тогда
			ИндексПослеПрефиксаНДС = 4;
			Хвост = Сред(ИмяЗначения, ИндексПослеПрефиксаНДС);
			ПозицияРазделителя = СтдСтр().СтрНайтиЛок(Хвост, "_");
			Если ПозицияРазделителя = 0 Тогда
				Результат = Хвост;
			Иначе
				Результат = Лев(Хвост, ПозицияРазделителя - 1) + "/" + Сред(Хвост, ПозицияРазделителя + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МетаданныеЕстьТабличнаяЧасть(ПолноеИмяТабличнойЧасти)
	
	Результат = Ложь;
	Части = СтдСтр().СтрРазделитьЛок(ПолноеИмяТабличнойЧасти, ".");
	
	КоличествоЧастейИмени = 4;
	Если Части.Количество() = КоличествоЧастейИмени
		И Части[2] = "ТабличныеЧасти" Тогда
		
		ИмяТабличнойЧасти = Части[3];
		
		Если Части[0] = "Справочник" Тогда
			МетаданныеОбъекта = Метаданные.Справочники[Части[1]];
		ИначеЕсли Части[0] = "Документ" Тогда
			МетаданныеОбъекта = Метаданные.Документы[Части[1]];
		Иначе
			Возврат Результат;
		КонецЕсли;
		
		Результат = (МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТабличнойЧасти) <> Неопределено);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаТабличнойЧастиУКДБезПолейУНФ16(ТекстЗапроса)
	
	Результат = ТекстЗапросаБезНомераСтрокиДокументаОснования(ТекстЗапроса);
	Результат = ТекстЗапросаБезСуммыАкцизаЗапасов(Результат);
	Результат = ТекстЗапросаБезСтраныПроисхожденияДоИзменения(Результат);
	Результат = ТекстЗапросаБезСуммыПрослеживаемости(Результат);
	Результат = ТекстЗапросаБезДеленияНаНоль(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаБезСуммыАкцизаЗапасов(ТекстЗапроса)
	
	Результат = ТекстЗапроса;
	
	Если Не ЕстьРеквизитЗапасовКорректировкиРеализации("СуммаАкцизаДоКорректировки") Тогда
		Результат = СтрЗаменить(Результат, "ТаблицаНоменклатуры.СуммаАкцизаДоКорректировки", "0");
	КонецЕсли;
	
	Если Не ЕстьРеквизитЗапасовКорректировкиРеализации("СуммаАкцизаДоИзменения") Тогда
		Результат = СтрЗаменить(Результат, "ТаблицаНоменклатуры.СуммаАкцизаДоИзменения", "0");
	КонецЕсли;
	
	Если Не ЕстьРеквизитЗапасовКорректировкиРеализации("СуммаАкциза") Тогда
		Результат = СтрЗаменить(Результат, "ТаблицаНоменклатуры.СуммаАкциза", "0");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаБезСтраныПроисхожденияДоИзменения(ТекстЗапроса)
	
	Результат = ТекстЗапроса;
	Если Не ЕстьРеквизитЗапасовКорректировкиРеализации("СтранаПроисхожденияДоИзменения") Тогда
		Результат = СтрЗаменить(
			Результат,
			"ТаблицаНоменклатуры.СтранаПроисхожденияДоИзменения",
			"ТаблицаНоменклатуры.СтранаПроисхождения");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаБезСуммыПрослеживаемости(ТекстЗапроса)
	
	Результат = ТекстЗапроса;
	ИмяРеквизитаСумма = "Сумма";
	ИмяТабличнойЧастиСведенияПрослеживаемости = "СведенияПрослеживаемости";
	
	Если Не ЕстьРеквизитТабличнойЧастиКорректировкиРеализации(
		ИмяТабличнойЧастиСведенияПрослеживаемости,
		ИмяРеквизитаСумма) Тогда
		Результат = СтрЗаменить(Результат, "КорректировкаРеализацииСведенияПрослеживаемости.Сумма", "0");
	КонецЕсли;
	
	Если Не ЕстьРеквизитТабличнойЧастиДокумента(
		"РасходнаяНакладная",
		ИмяТабличнойЧастиСведенияПрослеживаемости,
		ИмяРеквизитаСумма) Тогда
		Результат = СтрЗаменить(Результат, "РасходнаяНакладнаяСведенияПрослеживаемости.Сумма", "0");
	КонецЕсли;
	
	Если Не ЕстьРеквизитТабличнойЧастиДокумента(
		"ЗаказПокупателя",
		ИмяТабличнойЧастиСведенияПрослеживаемости,
		ИмяРеквизитаСумма) Тогда
		Результат = СтрЗаменить(Результат, "ЗаказПокупателяСведенияПрослеживаемости.Сумма", "0");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаБезНомераСтрокиДокументаОснования(ТекстЗапроса)
	
	Результат = ТекстЗапроса;
	Если Не ЕстьРеквизитЗапасовКорректировкиРеализации("НомерСтрокиДокументаОснования") Тогда
		
		Результат = СтрЗаменить(
			Результат,
			"ТаблицаНоменклатуры.НомерСтрокиДокументаОснования",
			"ТаблицаНоменклатуры.КлючСвязи");
		Результат = СтрЗаменить(
			Результат,
			"КОГДА НЕ ТаблицаНоменклатуры.КлючСвязи = 0",
			"КОГДА ИСТИНА");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаБезДеленияНаНоль(ТекстЗапроса)
	
