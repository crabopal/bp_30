Процедура ЗаполнитьРеквизитыШапкиУКДПоСчетФактураВыданный(Контракт)
	
	ДанныеШапки = ДанныеШапкиУКДПоСчетФактураВыданный();
	
	Контракт.Ссылка = ДанныеШапки.Ссылка;
	Контракт.Номер = ДанныеШапки.Номер;
	Если ЗначениеЗаполнено(ДанныеШапки.ПредставлениеНомера) Тогда
		Контракт.ПредставлениеНомера = ДанныеШапки.ПредставлениеНомера;
	Иначе
		Контракт.ПредставлениеНомера = ПредставлениеНомераСчетаФактурыВыданного(ДанныеШапки.Ссылка);
	КонецЕсли;
	Контракт.Дата = ДанныеШапки.Дата;
	ЗаполнитьИсправлениеШапкиУКД(Контракт, ДанныеШапки);
	
	ЗаполнитьПоставщикаПоДаннымПродавца = ЗначениеЗаполнено(ДанныеШапки.Продавец) И НЕ ДанныеШапки.СводныйКомиссионный;
	
	Если ЗаполнитьПоставщикаПоДаннымПродавца Тогда
		
		Контракт.Продавец = ДанныеШапки.Продавец;
		Контракт.БанковскийСчетПродавца = Неопределено;
		
	Иначе
		
		Контракт.Продавец = ДанныеШапки.Организация;
		Контракт.БанковскийСчетПродавца = ДанныеШапки.БанковскийСчетОрганизации;
		
	КонецЕсли;
	
	Контракт.КПППродавца = ДанныеШапки.КПППоставщика;
	
	Контракт.Покупатель = ДанныеШапки.Контрагент;
	Контракт.БанковскийСчетПокупателя = ДанныеШапки.БанковскийСчетКонтрагента;
	Контракт.КПППокупателя = ДанныеШапки.КПППокупателя;
	
	Контракт.Договор = ДанныеШапки.Договор;
	Контракт.Основание = ДанныеШапки.Основание;
	Контракт.ОснованиеНомер = ДанныеШапки.ОснованиеНомер;
	Контракт.ОснованиеДата = ДанныеШапки.ОснованиеДата;
	
	Контракт.КодВидаОперации = СокрЛП(СвойствоСтруктурыЛок(ДанныеШапки, "КодВидаОперации", ""));
	
	ВидДоговора = СвойствоСтруктурыЛок(ДанныеШапки, "ВидДоговора");
	
	Контракт.ВидОперации = ВидОперацииУКДПоВидуДоговора(ВидДоговора);
	Контракт.Налогообложение = НалогообложениеУКД(
		ДанныеШапки.УчетАгентскогоНДС,
		ДанныеШапки.УчетАгентскогоНДСПокупателем
	);
	
	ЗаполнитьВалютуШапкиУКД(Контракт, ДанныеШапки);
	Контракт.ИдентификаторГосКонтракта = ДанныеШапки.ИдентификаторГосКонтракта;
	Контракт.ЭтоВозвратТоваровОтКлиента = ДанныеШапки.ЭтоВозвратТоваровОтКлиента;
	Контракт.СопроводительныеДокументы = ДанныеШапки.СопроводительныеДокументы;
	
	Контракт.ПервичныеДокументы = РеквизитыПервичныхДокументовПоСчетуФактуреВыданному();
	Контракт.ДокументыОснования = РеквизитыДокументовОснования(ДанныеШапки.ЦифровойИндексОбособленногоПодразделения);
	
КонецПроцедуры

Функция ДанныеШапкиУКДПоСчетФактураВыданный()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетФактура.Ссылка КАК Ссылка,
	|	СчетФактура.Номер КАК Номер,
	|	СчетФактура.ПредставлениеНомера КАК ПредставлениеНомера,
	|	СчетФактура.КодВидаОперации КАК КодВидаОперации,
	|	ВЫБОР
	|		КОГДА СчетФактура.Исправление
	|			ТОГДА ЕСТЬNULL(ИсходныйСчетФактура.Дата, ДАТАВРЕМЯ(1, 1, 1))
	|		ИНАЧЕ СчетФактура.Дата
	|	КОНЕЦ КАК Дата,
	|	СчетФактура.Исправление КАК Исправление,
	|	СчетФактура.НомерИсправления КАК НомерИсправления,
	|	СчетФактура.ВалютаДокумента КАК Валюта,
	|	ВЫБОР
	|		КОГДА СчетФактура.Исправление
	|			ТОГДА СчетФактура.Дата
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ КАК ДатаИсправления,
	|	ВЫБОР
	|		КОГДА Организации.ОбособленноеПодразделение
	|			ТОГДА Организации.ЦифровойИндексОбособленногоПодразделения
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЦифровойИндексОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА Организации.ОбособленноеПодразделение
	|				И Организации.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА Организации.ГоловнаяОрганизация
	|		ИНАЧЕ СчетФактура.Организация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА СчетФактура.Продавец <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И СчетФактура.Продавец <> СчетФактура.Контрагент
	|			ТОГДА ВЫБОР
	|					КОГДА СчетФактура.Продавец.ОбособленноеПодразделение
	|							И СчетФактура.Продавец.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|						ТОГДА СчетФактура.Продавец.ГоловнойКонтрагент
	|					ИНАЧЕ СчетФактура.Продавец
	|				КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ КАК Продавец,
	|	СчетФактура.СводныйКомиссионный КАК СводныйКомиссионный,
	|	ВЫБОР
	|		КОГДА Контрагенты.ОбособленноеПодразделение
	|				И Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Контрагенты.ГоловнойКонтрагент
	|		ИНАЧЕ СчетФактура.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Контрагенты.ОбособленноеПодразделение
	|				И Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|		ТОГДА ВЫБОР
	|				КОГДА СчетФактура.КППКонтрагента <> """"
	|					ТОГДА СчетФактура.КППКонтрагента
	|				ИНАЧЕ ЕСТЬNULL(Контрагенты.КПП, """")
	|			КОНЕЦ
	|		ИНАЧЕ СчетФактура.КППКонтрагента
	|	КОНЕЦ КАК КПППокупателя,
	|	"""" КАК КПППоставщика,
	|	ВЫБОР
	|		КОГДА Контрагенты.ОбособленноеПодразделение
	|				И Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Контрагенты.ГоловнойКонтрагент.ОсновнойБанковскийСчет
	|		ИНАЧЕ Контрагенты.ОсновнойБанковскийСчет
	|	КОНЕЦ КАК БанковскийСчетКонтрагента,
	|	СчетФактура.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	|	"""" КАК СопроводительныеДокументы
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК ИсходныйСчетФактура
	|		ПО СчетФактура.ИсправляемыйСчетФактура = ИсходныйСчетФактура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО СчетФактура.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО СчетФактура.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	СчетФактура.Ссылка = &СчетФактура";
	Запрос.УстановитьПараметр("СчетФактура", УчетныйДокумент1С);
	
	РеквизитыДокумента = Запрос.Выполнить().Выгрузить();
	Если РеквизитыДокумента.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru='Не найдены данные счета-фактуры выданного для заполнения шапки УКД.'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	Результат = МодульОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РеквизитыДокумента[0]);
	
	ДополнитьДанныеШапкиУКДРеквизитамиДокументаОснования(Результат);
	
	Если ЭтоОбособленноеПодразделение(Результат.ПодразделениеОрганизации) Тогда
		Результат.ЦифровойИндексОбособленногоПодразделения = ЗначениеРеквизитаОбъектаЛок(
			Результат.ПодразделениеОрганизации,
			"ЦифровойИндексОбособленногоПодразделения"
		);
	КонецЕсли;
	
	ДополнитьНомерЦифровымИндексомОбособленногоПодразделения(
		Результат.ПредставлениеНомера,
		Результат.ЦифровойИндексОбособленногоПодразделения
	);
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьДанныеШапкиУКДРеквизитамиДокументаОснования(ДанныеШапки)
	// BSLLS:DuplicateStringLiteral-off
	
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("ДоговорКонтрагента");
	ИменаРеквизитов.Добавить("БанковскийСчетОрганизации");
	ИменаРеквизитов.Добавить("ПодразделениеОрганизации");
	ИменаРеквизитов.Добавить("СопроводительныеДокументы");
	
	ДанныеШапки.Вставить("ЭтоВозвратТоваровОтКлиента", Ложь);
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		ДанныеШапки.Вставить(ИмяРеквизита);
	КонецЦикла;
	
	ДокументыОснования = ДокументыОснованияСчетаФактурыВыданного(ДанныеШапки.Ссылка);
	Если ДокументыОснования.Количество() = 0
		Или Не ЗначениеЗаполнено(ДокументыОснования[0]) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОснование = ДокументыОснования[0];
	
	ДанныеШапки.ЭтоВозвратТоваровОтКлиента =
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя");
	
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	МетаданныеДокумента = ДокументОснование.Метаданные().Реквизиты;
	
	РеквизитыКЧтению = Новый Структура;
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(МетаданныеДокумента, ИмяРеквизита) Тогда
			РеквизитыКЧтению.Вставить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	Если РеквизитыКЧтению.Свойство("ДоговорКонтрагента") Тогда
		РеквизитыКЧтению.Вставить("Договор", "ДоговорКонтрагента");
		РеквизитыКЧтению.Вставить("ВидДоговора", "ДоговорКонтрагента.ВидДоговора");
		РеквизитыКЧтению.Вставить("УчетАгентскогоНДСПокупателем", "ДоговорКонтрагента.УчетАгентскогоНДСПокупателем");
		РеквизитыКЧтению.Вставить("УчетАгентскогоНДС", "ДоговорКонтрагента.УчетАгентскогоНДС");
		РеквизитыКЧтению.Вставить("Основание", "ДоговорКонтрагента.Наименование");
		РеквизитыКЧтению.Вставить("ОснованиеДата", "ДоговорКонтрагента.Дата");
		РеквизитыКЧтению.Вставить("ОснованиеНомер", "ДоговорКонтрагента.Номер");
	КонецЕсли;
	
	Если НЕ ЕстьРеквизитИлиСвойствоОбъектаЛок(МетаданныеДокумента, "БанковскийСчетОрганизации") Тогда
		РеквизитыКЧтению.Вставить("БанковскийСчетОрганизации", "Организация.ОсновнойБанковскийСчет");
	КонецЕсли;
	
	Если РеквизитыКЧтению.Количество() > 0 Тогда
		РеквизитыОснования = ЗначенияРеквизитовОбъектаЛок(ДокументОснование, РеквизитыКЧтению);
		СтдКоллекции().ДополнитьСтруктуруЛок(ДанныеШапки, РеквизитыОснования, Истина);
	КонецЕсли;
	
	КППОбособленногоПодразделения = КППОбособленногоПодразделенияПоДокументу(ДокументОснование);
	Если ЗначениеЗаполнено(КППОбособленногоПодразделения) Тогда
		ДанныеШапки.КПППоставщика = КППОбособленногоПодразделения;
	КонецЕсли;
	
	// BSLLS:DuplicateStringLiteral-on
КонецПроцедуры

Функция ДокументыОснованияСчетаФактурыВыданного(СчетФактура)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.ДокументОснование КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Таблица.НомерСтроки";
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДополнитьМассивЗначением(Результат, Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТоварныеДокументыДоКорректировкиПоСчетуФактуреВыданному()
	
	Результат = Новый Массив;
	ИсходныйСчетФактура = ИсходныйСчетФактураПоКорректировочномуСФ(УчетныйДокумент1С);
	
	Если ЗначениеЗаполнено(ИсходныйСчетФактура) Тогда
		ДокументыОснования = ДокументыОснованияСчетаФактурыВыданного(ИсходныйСчетФактура);
		СтдКоллекции().ДополнитьМассивЛок(Результат, ДокументыОснования, Истина);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИсходныйСчетФактураПоКорректировочномуСФ(СчетФактура)
	
	Результат = Документы.СчетФактураВыданный.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДокументыОснования.ИсходныйДокумент КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК ДокументыОснования
	|ГДЕ
	|	ДокументыОснования.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СчетФактура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыПервичныхДокументовПоСчетуФактуреВыданному()
	
	Результат = Новый Массив;
	
	Если ЭтоКорректировочныйСчетФактураНаАванс(УчетныйДокумент1С) Тогда
		Основания = РеквизитыДокументовОснованийКорректировочногоСФНаАванс(УчетныйДокумент1С);
	Иначе
		Основания = ДокументыОснованияКорректировочногоСчетаФактуры(УчетныйДокумент1С);
	КонецЕсли;
	
	Для Каждого Основание Из Основания Цикл
		
		ПервичныйДокумент = НайтиПервичныйДокументУКДПоДокументамОснования(Основание.Ссылка);
		СчетФактура = СчетФактураВыданныйПоДокументуОснованию(ПервичныйДокумент);
		ДобавитьРеквизитыПервичногоДокументаУКДВКоллекцию(Результат, СчетФактура);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыОснованияКорректировочногоСчетаФактуры(СчетФактура)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КорректировкаРеализации.Ссылка КАК Ссылка,
	|	КорректировкаРеализации.Дата КАК Дата,
	|	КорректировкаРеализации.ДоговорКонтрагента КАК Договор
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураШапка
	|		ПО Таблица.Ссылка = СчетФактураШапка.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|		ПО Таблица.ДокументОснование = КорректировкаРеализации.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|	И СчетФактураШапка.ВидСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыВыставленного.Корректировочный)
	|	И НЕ КорректировкаРеализации.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВозвратТоваровОтПокупателя.Ссылка,
	|	ВозвратТоваровОтПокупателя.Дата,
	|	ВозвратТоваровОтПокупателя.ДоговорКонтрагента
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураШапка
	|		ПО Таблица.Ссылка = СчетФактураШапка.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтПокупателя КАК ВозвратТоваровОтПокупателя
	|		ПО Таблица.ДокументОснование = ВозвратТоваровОтПокупателя.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|	И СчетФактураШапка.ВидСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыВыставленного.Корректировочный)
	|	И НЕ ВозвратТоваровОтПокупателя.ПометкаУдаления";
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция РеквизитыДокументовОснованийКорректировочногоСФ(СсылкаДокумента)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Таблица.УчитыватьИсправлениеИсходногоДокумента КАК УчитыватьИсправлениеИсходногоДокумента,
	|	Таблица.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
	|	Таблица.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
	|	Таблица.НомерИсправленияИсходногоДокумента КАК НомерИсправленияИсходногоДокумента,
	|	Таблица.ДатаИсправленияИсходногоДокумента КАК ДатаИсправленияИсходногоДокумента,
	|	Таблица.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &СсылкаДокумента
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаДокумента", СсылкаДокумента);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция РеквизитыДокументовОснованийКорректировочногоСФНаАванс(СсылкаДокумента)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЧАвансы.КорректируемыйСчетФактура КАК Ссылка,
	|	МАКСИМУМ(РеквизитыИсходныхСФ.НомерСчетаФактуры) КАК НомерИсходногоДокумента,
	|	МАКСИМУМ(РеквизитыИсходныхСФ.ДатаСчетаФактуры) КАК ДатаИсходногоДокумента,
	|	"""" КАК НомерИсправленияИсходногоДокумента,
	|	"""" КАК ДатаИсправленияИсходногоДокумента,
	|	ЛОЖЬ КАК УчитыватьИсправлениеИсходногоДокумента,
	|	ТЧАвансы.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.СчетФактураВыданный.Авансы КАК ТЧАвансы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналУчетаСчетовФактур КАК РеквизитыИсходныхСФ
	|		ПО ТЧАвансы.КорректируемыйСчетФактура = РеквизитыИсходныхСФ.СчетФактура
	|ГДЕ
	|	ТЧАвансы.Ссылка = &СсылкаДокумента
	|	И ТЧАвансы.Ссылка.ВидСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыВыставленного.КорректировочныйНаАванс)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧАвансы.КорректируемыйСчетФактура,
	|	ТЧАвансы.НомерСтроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТЧАвансы.НомерСтроки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаДокумента", СсылкаДокумента);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьИсправлениеШапкиУКД(Контракт, ДанныеШапки)
	
	НомерИсправления = СвойствоСтруктурыЛок(ДанныеШапки, "НомерИсправления", "");
	ДатаИсправления = СвойствоСтруктурыЛок(ДанныеШапки, "ДатаИсправления", Дата(1, 1, 1));
	
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		Контракт.НомерИсправления = СокрЛП(НомерИсправления);
		Контракт.ДатаИсправления = ДатаИсправления;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьВалютуШапкиУКД(Контракт, ДанныеШапки)
	
	Если ПересчитыватьСуммыУКДВВалютуРеглУчета(ДанныеШапки) Тогда
		Контракт.ВалютаДокумента = ВалютаРегламентированногоУчета();
	Иначе
		Контракт.ВалютаДокумента = ДанныеШапки.Валюта;
	КонецЕсли;
	Контракт.РасчетыВУсловныхЕдиницах = Ложь;
	
КонецПроцедуры

Функция ПересчитыватьСуммыУКДВВалютуРеглУчета(ДанныеШапки)
	
	ВалютаРегл = ВалютаРегламентированногоУчета();
	ОплатаВВалюте = ОплатаВВалютеПоДоговору(ДанныеШапки.Договор);
	
	Результат = ЗначениеЗаполнено(ВалютаРегл)
		И ДанныеШапки.Валюта <> ВалютаРегл
		И Не ОплатаВВалюте;
	
	Возврат Результат;
	
КонецФункции

Функция ВалютаРегламентированногоУчета()
	
	Результат = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Возврат Результат;
	
КонецФункции

Функция ОплатаВВалютеПоДоговору(Договор)
	
	Результат = Истина;
	
	Если ЗначениеЗаполнено(Договор) Тогда
		
		МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
		ЕстьРеквизитОплатаВВалюте = МодульОбщегоНазначения.ЕстьРеквизитОбъекта(
			"ОплатаВВалюте",
			Договор.Метаданные()
		);
		Если ЕстьРеквизитОплатаВВалюте Тогда
			Результат = ЗначениеРеквизитаОбъектаЛок(Договор, "ОплатаВВалюте");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

