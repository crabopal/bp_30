Функция АдресЮрФизЛицаПоВидуКонтактнойИнформации(ЮрФизЛицо, ВидКИ, ДатаСведений)
	
	Результат = Неопределено;
	СтрокаКИ = КонтактнаяИнформацияПоВиду(ЮрФизЛицо, ВидКИ, ДатаСведений);
	
	Если ЗначениеЗаполнено(СтрокаКИ.Значение) Тогда
		АдресИзJSON = КонтентАдреса().ИзJSON(СтрокаКИ.Значение, СтрокаКИ.Представление);
		Результат = ФиксированныеДанныеЛок(АдресИзJSON);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КонтактнаяИнформацияПоВиду(Владелец, ВидКИ, ДатаСведений)
	
	Результат = КонтактнаяИнформацияПоВидуИзИстории(Владелец, ВидКИ, ДатаСведений);
	
	Если НЕ ЗначениеЗаполнено(Результат.Значение)
		Или НЕ ЗначениеЗаполнено(Результат.Представление) Тогда
		
		Результат = НовыйСтрокаКонтактнойИнформации();
		
		ТипВладельца = ТипЗнч(Владелец);
		
		Запрос = Новый Запрос(ТекстЗапросаКонтактнойИнформации(ТипВладельца));
		Запрос.УстановитьПараметр("Ссылка", Владелец);
		Запрос.УстановитьПараметр("Вид", ВидКИ);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Значение = Выборка.Значение;
			Результат.Представление = Выборка.Представление;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КонтактнаяИнформацияПоВидуИзИстории(Владелец, ВидКИ, ДатаСведений)
	
	Результат = НовыйСтрокаКонтактнойИнформации();
	
	ТипВладельца = ТипЗнч(Владелец);
	
	Запрос = Новый Запрос(ТекстЗапросаИсторииКонтактнойИнформации(ТипВладельца));
	Запрос.УстановитьПараметр("Ссылка", Владелец);
	Запрос.УстановитьПараметр("Вид", ВидКИ);
	Запрос.УстановитьПараметр("Дата", ДатаСведений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Значение = Выборка.Значение;
		Результат.Представление = Выборка.Представление;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредопределенныйВидКонтактнойИнформации(ИменаПредопределенных)
	
	Если ТипЗнч(ИменаПредопределенных) = Тип("Строка") Тогда
		Имена = СтдСтр().СтрРазделитьЛок(ИменаПредопределенных, ",", Ложь);
	Иначе
		Имена = ИменаПредопределенных;
	КонецЕсли;
	
	ИменаПредопределенныхМетаданные = Метаданные.Справочники.ВидыКонтактнойИнформации.ПолучитьИменаПредопределенных();
	МенеджерКИ = Справочники.ВидыКонтактнойИнформации;
	
	Для Каждого Имя Из Имена Цикл
		ИмяПредопределенного = СокрЛП(Имя);
		Если ИменаПредопределенныхМетаданные.Найти(ИмяПредопределенного) <> Неопределено Тогда
			Возврат МенеджерКИ[ИмяПредопределенного];
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

