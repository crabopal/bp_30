Функция ТабличныеДанныеУКДПоСчетФактураВыданный()
	
	Результат = Новый Массив;
	
	СчетФактура = УчетныйДокумент1С;
	ТоварныеДокументы = ДокументыОснованияСчетаФактурыВыданного(УчетныйДокумент1С);
	НомерСтроки = 0;
	
	Для Каждого ТоварныйДокумент Из ТоварныеДокументы Цикл
		
		ТипДокумента = ТипЗнч(ТоварныйДокумент);
		
		Если ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			ТабличныеДанные = ТабличныеДанныеУКДПоКорректировкеРеализации(ТоварныйДокумент, СчетФактура);
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") Тогда
			ТабличныеДанные = ТабличныеДанныеУКДПоВозвратуТоваровОтПокупателя(ТоварныйДокумент, СчетФактура);
		Иначе
			Продолжить;
		КонецЕсли;
		
		СтрокиКонтракта = СтрокиКонтрактаУКДИзТабличныхДанных(ТабличныеДанные, НомерСтроки);
		
		СтдКоллекции().ДополнитьМассивЛок(Результат, СтрокиКонтракта);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокиТабличнойЧастиУКДПоСчетФактураВыданныйНаАванс()
	
	ТоварныйДокумент = УчетныйДокумент1С;
	СчетФактура = СчетФактураВыданныйПоДокументуОснованию(ТоварныйДокумент);
	
	ТабличныеДанные = ТабличныеДанныеУКДПоСчетФактураВыданныйНаАванс(СчетФактура);
	НомерСтроки = 0;
	
	Результат = СтрокиКонтрактаУКДИзТабличныхДанных(ТабличныеДанные, НомерСтроки);
	
	Для Каждого СтрокаКонтракта Из Результат Цикл
		Если Не ЗначениеЗаполнено(СтрокаКонтракта.НоменклатураПредставление) Тогда
			СтрокаКонтракта.НоменклатураПредставление = "Предварительная оплата";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТабличныеДанныеУКДПоСчетФактураВыданныйНаАванс(СчетФактура)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ИнициализироватьВременнуюТаблицуТоваровСчетаФактурыНаАванс(МенеджерВременныхТаблиц, СчетФактура);
	
	ЧастиЗапроса = Новый Массив;
	
	ЧастиЗапроса.Добавить(ТекстЗапросаТаблицаКорректировочногоДокумента());
	ЧастиЗапроса.Добавить(ТекстЗапросаТаблицаКорректируемыеНомераСтрок());
	
	ПредставлениеПоставщика = "";
	ИННКПППоставщика = "";
	АдресПоставщика = "";
	ДопКолонкаПФ = Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = СтдСтр().СтрСоединитьЛок(ЧастиЗапроса, РазделительПакетаЗапросов());
	
	Запрос.УстановитьПараметр("ПредставлениеПоставщика", ПредставлениеПоставщика);
	Запрос.УстановитьПараметр("ИННКПППоставщика", ИННКПППоставщика);
	Запрос.УстановитьПараметр("АдресПоставщика", АдресПоставщика);
	Запрос.УстановитьПараметр("ДополнительнаяКолонкаПечатныхФормДокументов", ДопКолонкаПФ);
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура;
	
	Результат.Вставить("ТаблицаТоваров", РезультатыЗапроса[0].Выгрузить());
	Результат.Вставить("СведенияПрослеживаемости", Новый ТаблицаЗначений);
	Результат.Вставить("КорректируемыеНомераСтрок", РезультатыЗапроса[1].Выгрузить());
	
	Возврат Результат;
	
КонецФункции

Процедура ИнициализироватьВременнуюТаблицуТоваровСчетаФактурыНаАванс(МенеджерВременныхТаблиц, СчетФактура)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапросаВтТаблицаДокументаСчетаФактурыНаАванс();
	Запрос.УстановитьПараметр("Ссылка", СчетФактура);
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ТекстЗапросаВтТаблицаДокументаСчетаФактурыНаАванс()
	
	Результат = "
	|ВЫБРАТЬ
	|	1 КАК НомерТабЧасти,
	|	Авансы.НомерСтроки КАК НомерСтроки,
	|	Авансы.Номенклатура КАК Товар,
	|	Авансы.Номенклатура.Код КАК ТоварКод,
	|	Авансы.Номенклатура.Артикул КАК ТоварАртикул,
	|	Авансы.Содержание КАК ТоварНаименование,
	|	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка) КАК СтранаПроисхождения,
	|	"""" КАК ПредставлениеСтраны,
	|	ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка) КАК НомерГТД,
	|	ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка) КАК НомерГТДДоИзменения,
	|	НЕОПРЕДЕЛЕНО КАК ЕдиницаИзмерения,
	|	0 КАК КоличествоДоИзменения,
	|	0 КАК КоличествоПослеИзменения,
	|	0 КАК ЦенаДоИзменения,
	|	0 КАК ЦенаПослеИзменения,
	|	0 КАК СтоимостьБезНДСДоИзменения,
	|	0 КАК СтоимостьБезНДСПослеИзменения,
	|	Авансы.СуммаНДС КАК СуммаНДСПослеИзменения,
	|	Авансы.СуммаНДСДоКорректировки КАК СуммаНДСДоИзменения,
	|	Авансы.Сумма КАК СтоимостьСНДСПослеИзменения,
	|	Авансы.СуммаДоКорректировки КАК СтоимостьСНДСДоИзменения,
	|	0 КАК РазницаБезНДСУменьшение,
	|	0 КАК РазницаБезНДСУвеличение,
	|	0 КАК РазницаНДСУменьшение,
	|	Авансы.СуммаНДС - Авансы.СуммаНДСДоКорректировки КАК РазницаНДСУвеличение,
	|	0 КАК РазницаСНДСУменьшение,
