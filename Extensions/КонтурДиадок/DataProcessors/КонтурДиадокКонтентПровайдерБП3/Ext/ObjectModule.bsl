	|		ПО ВременнаяТаблицаРеквизиты.Ссылка = ТаблицаДокумента.Ссылка
	|ГДЕ
	|	ТаблицаДокумента.ПрослеживаемыйТовар = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	СведенияОПрослеживаемостиПредварительная.РНПТ,
	|	ТаблицаДокумента.ЕдиницаИзмерения,
	|	ТаблицаДокумента.СтранаПроисхождения,
	|	СведенияОПрослеживаемостиПредварительная.ИдентификаторСтроки,
	|	ЕСТЬNULL(КлассификаторТНВЭД.ЕдиницаИзмерения.Наименование, ""шт""),
	|	ЕСТЬNULL(КлассификаторТНВЭД.ЕдиницаИзмерения.Код, ""796""),
	|	ТаблицаДокумента.КоличествоДоИзменения,
	|	ТаблицаДокумента.КоличествоПослеИзменения,
	|	ВЫБОР
	|		КОГДА СведенияОПрослеживаемостиПредварительная.СуммаДо = 0
	|			ТОГДА СведенияОПрослеживаемостиПредварительная.КоличествоДо * ВЫБОР
	|					КОГДА ВременнаяТаблицаРеквизиты.СуммаВключаетНДС
	|							И ТаблицаДокумента.КоличествоДоИзменения <> 0
	|						ТОГДА (ТаблицаДокумента.СтоимостьСНДСДоИзменения - ТаблицаДокумента.СуммаНДСДоИзменения) / ТаблицаДокумента.КоличествоДоИзменения
	|					КОГДА ВременнаяТаблицаРеквизиты.СуммаВключаетНДС
	|							И ТаблицаДокумента.КоличествоДоИзменения = 0
	|						ТОГДА ТаблицаДокумента.СтоимостьСНДСДоИзменения - ТаблицаДокумента.СуммаНДСДоИзменения
	|					ИНАЧЕ ТаблицаДокумента.ЦенаДоИзменения
	|				КОНЕЦ
	|		ИНАЧЕ СведенияОПрослеживаемостиПредварительная.СуммаДо
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА СведенияОПрослеживаемостиПредварительная.Сумма = 0
	|			ТОГДА СведенияОПрослеживаемостиПредварительная.Количество * ВЫБОР
	|					КОГДА ВременнаяТаблицаРеквизиты.СуммаВключаетНДС
	|							И ТаблицаДокумента.КоличествоПослеИзменения <> 0
	|						ТОГДА (ТаблицаДокумента.СтоимостьСНДСПослеИзменения - ТаблицаДокумента.СуммаНДСПослеИзменения) / ТаблицаДокумента.КоличествоПослеИзменения
	|					КОГДА ВременнаяТаблицаРеквизиты.СуммаВключаетНДС
	|							И ТаблицаДокумента.КоличествоПослеИзменения = 0
	|						ТОГДА ТаблицаДокумента.СтоимостьСНДСПослеИзменения - ТаблицаДокумента.СуммаНДСПослеИзменения
	|					ИНАЧЕ ТаблицаДокумента.ЦенаПослеИзменения
	|				КОНЕЦ
	|		ИНАЧЕ СведенияОПрослеживаемостиПредварительная.Сумма
	|	КОНЕЦ";
	
	Возврат Результат;
	
	// BSLLS:AssignAliasFieldsInQuery-on
КонецФункции

Функция ТекстЗапросаТаблицаКорректируемыеНомераСтрок()
	
	Результат = "
	|ВЫБРАТЬ
	|	СчетФактураВыданныйКорректируемыеНомераСтрок.Ссылка КАК СчетФактура,
	|	СчетФактураВыданныйКорректируемыеНомераСтрок.НомерСтроки КАК НомерСтроки,
	|	СчетФактураВыданныйКорректируемыеНомераСтрок.НомерИсходнойСтроки КАК НомерИсходнойСтроки
	|ИЗ
	|	Документ.СчетФактураВыданный.КорректируемыеНомераСтрок КАК СчетФактураВыданныйКорректируемыеНомераСтрок
	|ГДЕ
	|	СчетФактураВыданныйКорректируемыеНомераСтрок.Ссылка = &СчетФактура
	|	И СчетФактураВыданныйКорректируемыеНомераСтрок.Ссылка.ВидСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыВыставленного.Корректировочный)";
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьВТекстеЗапросаПоляУпаковкиНоменклатуры(ТекстЗапроса)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(Метаданные.Справочники, "УпаковкиНоменклатуры") Тогда
		
		Выражение_ЕдиницаИзмерения = 
			"ЕСТЬNULL(СправочникУпаковка.ЕдиницаИзмерения, СправочникНоменклатура.ЕдиницаИзмерения)";
		Выражение_КоэффициентУпаковки = "ЕСТЬNULL(СправочникУпаковка.Коэффициент, 1)";
		Выражение_УпаковкиНоменклатуры = "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиНоменклатуры КАК СправочникУпаковка
			|		ПО ТаблицаНоменклатуры.Упаковка = СправочникУпаковка.ССылка
			|			И (СправочникУпаковка.Коэффициент > 0)";
		
	Иначе
		
		Выражение_ЕдиницаИзмерения = "СправочникНоменклатура.ЕдиницаИзмерения";
		Выражение_КоэффициентУпаковки = "1";
		Выражение_УпаковкиНоменклатуры = "";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЕдиницаИзмерения", Выражение_ЕдиницаИзмерения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КоэффициентУпаковки", Выражение_КоэффициентУпаковки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//&УпаковкиНоменклатуры", Выражение_УпаковкиНоменклатуры);
	
КонецПроцедуры

Процедура ЗаполнитьВТекстеЗапросаПоляАкциза(ТекстЗапроса)
	
	РеквизитыТоваров = Метаданные.Документы.КорректировкаРеализации.ТабличныеЧасти.Товары.Реквизиты;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(РеквизитыТоваров, "СуммаАкциза") Тогда
		
		Выражение_СуммаАкцизаДоИзменения = "ВЫБОР
			|		КОГДА Реквизиты.Исправление
			|			ТОГДА ТаблицаНоменклатуры.СуммаАкцизаДоКорректировки
			|		ИНАЧЕ ТаблицаНоменклатуры.СуммаАкцизаДоИзменения
			|	КОНЕЦ";
		Выражение_СуммаАкцизаПослеИзменения = "ТаблицаНоменклатуры.СуммаАкциза";
		
	Иначе
		
		Выражение_СуммаАкцизаДоИзменения = "0";
		Выражение_СуммаАкцизаПослеИзменения = "0";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СуммаАкцизаДоИзменения", Выражение_СуммаАкцизаДоИзменения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СуммаАкцизаПослеИзменения", Выражение_СуммаАкцизаПослеИзменения);
	
КонецПроцедуры

Процедура ЗаполнитьВТекстеЗапросаПоляСтранПроисхожденияПоУслугам(ТекстЗапроса)
	
	Если ВУслугахКорректировкиРеализацииЕстьИдентификаторСтроки() Тогда
		Выражение_СтранаПроисхожденияДоИзменения =
			"ЕСТЬNULL(СтраныПроисхожденияПоУслугамСводно.СтранаПроисхожденияДоИзменения, """")";
		Выражение_СтранаПроисхождения = "ЕСТЬNULL(СтраныПроисхожденияПоУслугамСводно.СтранаПроисхождения, """")";
		Выражение_ПредставлениеСтраны = "ЕСТЬNULL(СтраныПроисхожденияПоУслугамСводно.НаименованиеПолное, """")";
		Выражение_ПрослеживаемыйТовар = "ЕСТЬNULL(СтраныПроисхожденияПоУслугамСводно.ПрослеживаемыйТовар, ЛОЖЬ)";
		Выражение_СтраныПроисхожденияПоУслугамСводно =
			"ЛЕВОЕ СОЕДИНЕНИЕ СтраныПроисхожденияПоУслугамСводно КАК СтраныПроисхожденияПоУслугамСводно
			|		ПО ТаблицаНоменклатуры.ИдентификаторСтроки = СтраныПроисхожденияПоУслугамСводно.ИдентификаторСтроки";
	Иначе
		Выражение_СтранаПроисхожденияДоИзменения = """""";
		Выражение_СтранаПроисхождения = """""";
		Выражение_ПредставлениеСтраны = """""";
		Выражение_ПрослеживаемыйТовар = "ЛОЖЬ";
		Выражение_СтраныПроисхожденияПоУслугамСводно = "";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&СтранаПроисхожденияДоИзменения",
		Выражение_СтранаПроисхожденияДоИзменения
	);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтранаПроисхождения", Выражение_СтранаПроисхождения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПредставлениеСтраны", Выражение_ПредставлениеСтраны);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПрослеживаемыйТовар", Выражение_ПрослеживаемыйТовар);
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"//&СтраныПроисхожденияПоУслугамСводно",
		Выражение_СтраныПроисхожденияПоУслугамСводно
	);
	
КонецПроцедуры

Процедура ЗаполнитьВТекстеЗапросаИдентификаторСтрокиУслуг(ТекстЗапроса)
	
	РеквизитыУслуг = Метаданные.Документы.КорректировкаРеализации.ТабличныеЧасти.Услуги.Реквизиты;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(РеквизитыУслуг, "ИдентификаторСтроки") Тогда
		Выражение_ИдентификаторСтроки = "ТаблицаНоменклатуры.ИдентификаторСтроки";
	Иначе
		Выражение_ИдентификаторСтроки = """""";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторСтроки", Выражение_ИдентификаторСтроки);
	
КонецПроцедуры

