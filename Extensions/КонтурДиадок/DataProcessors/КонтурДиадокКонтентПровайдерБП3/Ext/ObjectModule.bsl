Функция НаименованияОрганизацииИзИстории(Организация, ДатаСведений)
	
	Результат = Новый Структура("Наименование, НаименованиеПолное", "", "");
	
	ИспользуетсяИстория = ИспользуетсяИсторияНаименованийСправочника("Организации");
	Если Не ИспользуетсяИстория Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаНаименованияОрганизацииИзИстории());
	Запрос.УстановитьПараметр("Ссылка", Организация);
	Запрос.УстановитьПараметр("Дата", ДатаСведений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Результат.Наименование = Выборка.Наименование;
		Результат.НаименованиеПолное = Выборка.НаименованиеПолное;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НаименованиеКонтрагентаИзИстории(Контрагент, ДатаСведений)
	
	Результат = "";
	
	ИспользуетсяИстория = ИспользуетсяИсторияНаименованийСправочника("Контрагенты");
	Если Не ИспользуетсяИстория Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаНаименованияКонтрагентаИзИстории());
	Запрос.УстановитьПараметр("Ссылка", Контрагент);
	Запрос.УстановитьПараметр("Дата", ДатаСведений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Наименование;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ФИОИзСтроки(Знач СтрокаФИО)
	
	Результат = Новый Структура("Фамилия, Имя, Отчество", "", "", "");
	
	СтрокаФИО = УбратьМаркерИПИзНаименования(СтрокаФИО);
	Части = СтдСтр().СтрРазделитьЛок(СокрЛП(СтрокаФИО), " ", Ложь);
	
	Если Части.Количество() > 0 Тогда
		Результат.Фамилия = Части[0];
	КонецЕсли;
	Если Части.Количество() > 1 Тогда
		Результат.Имя = Части[1];
	КонецЕсли;
	// BSLLS:MagicNumber-off
	Если Части.Количество() > 2 Тогда
		Результат.Отчество = Части[2];
	КонецЕсли;
	// BSLLS:MagicNumber-on
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяИсторияНаименованийСправочника(ИмяСправочника)
	
	ПолноеИмя = "Справочник." + ИмяСправочника + ".ТабличныеЧасти.ИсторияНаименований";
	
	Возврат МетаданныеЕстьТабличнаяЧасть(ПолноеИмя);
	
КонецФункции

Функция УбратьМаркерИПИзНаименования(Наименование)
	
	Результат = "";
	СтрокаФИО = СокрЛП(Наименование);
	Части = СтдСтр().СтрРазделитьЛок(СтрокаФИО, " ", Ложь);
	
	Если Части.Количество() > 0 Тогда
		// BSLLS:IfElseIfEndsWithElse-off
		Если ВРег(Части[0]) = "ИП" Тогда
			Части.Удалить(0);
		ИначеЕсли ВРег(Части[Части.Количество() - 1]) = "ИП" Тогда
			Части.Удалить(Части.Количество() - 1);
		ИначеЕсли НРег(Части[0]) = "индивидуальный" И НРег(Части[1]) = "предприниматель" Тогда
			Части.Удалить(0);
			Части.Удалить(0);
		КонецЕсли;
		// BSLLS:IfElseIfEndsWithElse-on
		Результат = СтдСтр().СтрСоединитьЛок(Части, " ");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаНаименованияОрганизацииИзИстории()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	МАКСИМУМ(История.Период) КАК Период,
	|	История.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ЗначенияНаименований
	|ИЗ
	|	Справочник.Организации.ИсторияНаименований КАК История
	|ГДЕ
	|	История.Ссылка = &Ссылка
	|	И История.Период <= &Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	История.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	История.НаименованиеСокращенное КАК Наименование,
	|	История.НаименованиеПолное КАК НаименованиеПолное
	|ИЗ
	|	ЗначенияНаименований КАК ЗначенияНаименований
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации.ИсторияНаименований КАК История
	|		ПО ЗначенияНаименований.Ссылка = История.Ссылка
	|			И ЗначенияНаименований.Период = История.Период";
	
	Возврат ТекстЗапроса;
	
КонецФункции

