Функция МетаданныеЕстьТабличнаяЧасть(ПолноеИмяТабличнойЧасти)
	
	Результат = Ложь;
	Части = СтдСтр().СтрРазделитьЛок(ПолноеИмяТабличнойЧасти, ".");
	
	КоличествоЧастейИмени = 4;
	Если Части.Количество() = КоличествоЧастейИмени
		И Части[2] = "ТабличныеЧасти" Тогда
		
		ИмяТабличнойЧасти = Части[3];
		
		Если Части[0] = "Справочник" Тогда
			МетаданныеОбъекта = Метаданные.Справочники[Части[1]];
		ИначеЕсли Части[0] = "Документ" Тогда
			МетаданныеОбъекта = Метаданные.Документы[Части[1]];
		Иначе
			Возврат Результат;
		КонецЕсли;
		
		Результат = (МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТабличнойЧасти) <> Неопределено);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьУчетныйДокументУстановлен()
	
	Если Не ЗначениеЗаполнено(УчетныйДокумент1С) Тогда
		ТекстОшибки = НСтр("ru='Не указан документ для сбора контента'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьМассивЗначением(МассивПриемник, Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	Значения = СтдКоллекции().ЗначениеВМассивеЛок(Значение);
	СтдКоллекции().ДополнитьМассивЛок(МассивПриемник, Значения, Истина);
	
КонецПроцедуры

Функция КППНаДатуЛок(Ссылка, ДатаСведений)
	
	МодульУчетНДСБП = ОбщийМодульЛок("УчетНДСБП");
	Результат = МодульУчетНДСБП.КППНаДату(Ссылка, ДатаСведений);
	
	Возврат Результат;
	
КонецФункции

Функция ВУслугахКорректировкиРеализацииЕстьИдентификаторСтроки()
	
	РеквизитыУслуг = Метаданные.Документы.КорректировкаРеализации.ТабличныеЧасти.Услуги.Реквизиты;
	
	Результат = ЕстьРеквизитИлиСвойствоОбъектаЛок(РеквизитыУслуг, "ИдентификаторСтроки");
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоКорректировочныйСчетФактураНаАванс(СсылкаНаОбъект)
	
	Результат = Ложь;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ВидСФ = ЗначениеРеквизитаОбъектаЛок(СсылкаНаОбъект, "ВидСчетаФактуры");
		Результат = (ВидСФ = Перечисления.ВидСчетаФактурыВыставленного.КорректировочныйНаАванс);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоУправлениеАрендой()
	
	ИмяПодсистемы = "Аренда";
	
	ПодсистемыКонфигурации = ОписанияПодсистемКонфигурации();
	ОписаниеПодсистемы = ПодсистемыКонфигурации.Получить(ИмяПодсистемы);
	
	Результат = (ОписаниеПодсистемы <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоВерсияБухгалтерскойПодсистемыНеНиже_3_0_138()
	
	ВерсияПодсистемыБП = ВерсияБухгалтерскойПодсистемы();
	
	Результат = СтдСтр().СравнитьВерсииЛок(ВерсияПодсистемыБП, "3.0.138") >= 0;
	Возврат Результат;
	
КонецФункции

Функция ЭтоВерсияБухгалтерскойПодсистемыНеНиже_3_0_142()
	
	ВерсияПодсистемыБП = ВерсияБухгалтерскойПодсистемы();
	
	Результат = СтдСтр().СравнитьВерсииЛок(ВерсияПодсистемыБП, "3.0.142") >= 0;
	Возврат Результат;
	
КонецФункции

Функция ВерсияБухгалтерскойПодсистемы()
	
	ИмяПодсистемы = ИмяБухгалтерскойПодсистемы();
	
	Если ЗначениеЗаполнено(ИмяПодсистемы) Тогда
		ПодсистемыКонфигурации = ОписанияПодсистемКонфигурации();
		ОписаниеПодсистемы = ПодсистемыКонфигурации.Получить(ИмяПодсистемы);
		Результат = ОписаниеПодсистемы.Версия;
	Иначе
		Результат = Метаданные.Версия;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяБухгалтерскойПодсистемы()
	
	ПодсистемыКонфигурации = ОписанияПодсистемКонфигурации();
	ДопустимыеИмена = ИменаПодсистемБП();
	
	Результат = Неопределено;
	
	Для Каждого ИмяПодсистемы Из ДопустимыеИмена Цикл
		
		Если ПодсистемыКонфигурации.Получить(ИмяПодсистемы) <> Неопределено Тогда
			Результат = ИмяПодсистемы;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОписанияПодсистемКонфигурации()
	
	// Используем служебный интерфейс БСП, т.к. метод ОписанияПодсистем добавлен в
	// программный интерфейс модуля ОбщегоНазначения только в версии БСП 3.0.2 и выше
	ИнтерфейсБСП = ОбщийМодульЛок("СтандартныеПодсистемыПовтИсп");
	Результат = ИнтерфейсБСП.ОписанияПодсистем().ПоИменам;
	Возврат Результат;
	
КонецФункции

Функция ИменаПодсистемБП()
	
	Результат = Новый Массив;
	Результат.Добавить("БухгалтерияПредприятия");
	Результат.Добавить("БухгалтерияПредприятияКОРП");
	Результат.Добавить("БухгалтерияПредприятияБазовая");
	Результат.Добавить("БухгалтерияПредприятияБазовая1");
	Результат.Добавить("БухгалтерияМолокозавода");
	Результат.Добавить("АрендаИУправлениеНедвижимостью");
	Результат.Добавить("БухгалтерияСтроительнойОрганизации");
	Результат.Добавить("БухгалтерияСельскохозяйственногоПредприятия");
	Результат.Добавить("БухгалтерияСельскохозяйственногоПредприятияКОРП");
	
	Возврат Результат;
	
КонецФункции

