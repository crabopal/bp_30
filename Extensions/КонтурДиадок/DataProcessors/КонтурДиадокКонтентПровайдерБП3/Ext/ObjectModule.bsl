Функция СчетФактураВыданныйПоДокументуОснованию(ДокументОснование)
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Возврат ДокументОснование;
	КонецЕсли;
	
	Результат = Документы.СчетФактураВыданный.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СчетФактура.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактура
	|		ПО Таблица.Ссылка = СчетФактура.Ссылка
	|ГДЕ
	|	Таблица.ДокументОснование = &ДокументОснование
	|	И НЕ СчетФактура.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиПервичныйДокументУКДПоДокументамОснования(ДокументСсылка)
	
	Результат = ДокументСсылка;
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Основание = ЗначениеРеквизитаОбъектаЛок(ДокументСсылка, "ДокументРеализации");
		Результат = НайтиПервичныйДокументУКДПоДокументамОснования(Основание);
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") Тогда
		
		ДокументРеализации = ЗначениеРеквизитаОбъектаЛок(ДокументСсылка, "Сделка");
		Если ЗначениеЗаполнено(ДокументРеализации)
			И ТипЗнч(ДокументРеализации) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Результат = ДокументРеализации;
		КонецЕсли;
		
	Иначе
		
		Результат = ДокументСсылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьРеквизитыПервичногоДокументаУКДВКоллекцию(Коллекция, СсылкаДокумента)
	
	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Ссылка", СсылкаДокумента);
	Найденные = СтдКоллекции().НайтиСтрокиМассиваСтруктур(Коллекция, Отбор);
	
	Если Найденные.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыПервичногоДокумента = РеквизитыПервичногоДокументаУКД(СсылкаДокумента);
	Коллекция.Добавить(РеквизитыПервичногоДокумента);
	
КонецПроцедуры

Функция РеквизитыПервичногоДокументаУКД(СсылкаДокумента)
	
	Результат = КонтрактыПровайдеров().НовыйРеквизитыСвязанногоДокумента();
	РеквизитыДокумента = ЗначенияРеквизитовОбъектаЛок(СсылкаДокумента, "Номер, Дата");
	
	Если ТипЗнч(СсылкаДокумента) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Результат.Номер = ПредставлениеНомераСчетаФактурыВыданного(СсылкаДокумента);
		Если Не ЗначениеЗаполнено(Результат.Номер) Тогда
			Результат.Номер = НомерНаПечатьЛокализация(РеквизитыДокумента.Номер);
		КонецЕсли;
	Иначе
		Результат.Номер = НомерНаПечатьЛокализация(РеквизитыДокумента.Номер);
	КонецЕсли;
	
	Результат.Дата = РеквизитыДокумента.Дата;
	Результат.Ссылка = СсылкаДокумента;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДокументовОснования(ЦифровойИндексОбособленногоПодразделения = "")
	
	Результат = Новый Массив;
	
	Отбор = Новый Структура("Номер, Дата");
	
	Если ЭтоКорректировочныйСчетФактураНаАванс(УчетныйДокумент1С) Тогда
		РеквизитыОснований = РеквизитыДокументовОснованийКорректировочногоСФНаАванс(УчетныйДокумент1С);
	ИначеЕсли ТипЗнч(УчетныйДокумент1С) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		РеквизитыОснований = РеквизитыДокументовОснованийКорректировочногоСФ(УчетныйДокумент1С);
	Иначе
		РеквизитыОснований = РеквизитыДокументовОснованийКорректировкиРеализации(УчетныйДокумент1С);
	КонецЕсли;
	
	Для Каждого РеквизитыОснования Из РеквизитыОснований Цикл
		
		Отбор.Номер = РеквизитыОснования.НомерИсходногоДокумента;
		Отбор.Дата = РеквизитыОснования.ДатаИсходногоДокумента;
		
		Найденные = СтдКоллекции().НайтиСтрокиМассиваСтруктур(Результат, Отбор);
		
		Если Найденные.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		РеквизитыДокументаОснования = КонтрактыПровайдеров().НовыйДокументОснованияУКД();
		
		РеквизитыДокументаОснования.Номер = Формат(РеквизитыОснования.НомерИсходногоДокумента, "ЧГ=0");
		РеквизитыДокументаОснования.Дата = РеквизитыОснования.ДатаИсходногоДокумента;
		
		ДополнитьНомерЦифровымИндексомОбособленногоПодразделения(
			РеквизитыДокументаОснования.Номер,
			ЦифровойИндексОбособленногоПодразделения
		);
		
		Если РеквизитыОснования.УчитыватьИсправлениеИсходногоДокумента Тогда
			РеквизитыДокументаОснования.НомерИсправления =
				Формат(РеквизитыОснования.НомерИсправленияИсходногоДокумента, "ЧГ=0");
			РеквизитыДокументаОснования.ДатаИсправления = РеквизитыОснования.ДатаИсправленияИсходногоДокумента;
		КонецЕсли;
		
		Результат.Добавить(РеквизитыДокументаОснования);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоОбособленноеПодразделение(ЮрФизЛицо)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(ЮрФизЛицо) Тогда 
		
		МетаданныеОбъекта = ЮрФизЛицо.Метаданные().Реквизиты;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(МетаданныеОбъекта, "ОбособленноеПодразделение") Тогда
			Результат = ЗначениеРеквизитаОбъектаЛок(ЮрФизЛицо, "ОбособленноеПодразделение");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьНомерЦифровымИндексомОбособленногоПодразделения(
	ПредставлениеНомера,
	ЦифровойИндексОбособленногоПодразделения)
	
	Если Не ЗначениеЗаполнено(ЦифровойИндексОбособленногоПодразделения) Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонНомера = "%1/%2";
	
	ПредставлениеНомера = СтдСтр().СтрШаблонЛок(
		ШаблонНомера,
		ПредставлениеНомера,
		ЦифровойИндексОбособленногоПодразделения
	);
	
КонецПроцедуры

