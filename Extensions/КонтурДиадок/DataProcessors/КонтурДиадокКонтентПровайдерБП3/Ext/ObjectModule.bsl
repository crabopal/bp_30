Функция СтрокаКодИНаименованиеСтраныДляКонтракта(СтранаСсылка)
	
	Результат = Новый Структура("КодСтраны, НаименованиеСтраны", "", "");
	
	РеквизитыСтраны = ЗначенияРеквизитовОбъектаЛок(СтранаСсылка, "Код, Наименование");
	
	Результат.КодСтраны = СокрЛП(РеквизитыСтраны.Код);
	Результат.НаименованиеСтраны = СокрЛП(РеквизитыСтраны.Наименование);
	
	Возврат Результат;
	
КонецФункции

Функция ВыборкаБанковскихРеквизитов(БанковскийСчет)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеСчета.НомерСчета КАК НомерСчета,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкДляРасчетов <> ЗНАЧЕНИЕ(Справочник.Банки.ПустаяСсылка)
	|			ТОГДА БанкРасчетов.Наименование
	|		ИНАЧЕ БанкСчета.Наименование
	|	КОНЕЦ, """") КАК Банк,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкДляРасчетов <> ЗНАЧЕНИЕ(Справочник.Банки.ПустаяСсылка)
	|			ТОГДА БанкРасчетов.Код
	|		ИНАЧЕ БанкСчета.Код
	|	КОНЕЦ, """") КАК БИК,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкДляРасчетов <> ЗНАЧЕНИЕ(Справочник.Банки.ПустаяСсылка)
	|			ТОГДА БанкРасчетов.Адрес
	|		ИНАЧЕ БанкСчета.Адрес
	|	КОНЕЦ, """") КАК АдресБанка,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкДляРасчетов <> ЗНАЧЕНИЕ(Справочник.Банки.ПустаяСсылка)
	|			ТОГДА БанкРасчетов.КоррСчет
	|		ИНАЧЕ БанкСчета.КоррСчет
	|	КОНЕЦ, """") КАК КоррСчет,
	|	&ЦифровойСчет КАК ЦифровойСчет
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК БанкСчета
	|		ПО БанковскиеСчета.Банк = БанкСчета.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК БанкРасчетов
	|		ПО БанковскиеСчета.БанкДляРасчетов = БанкРасчетов.Ссылка
	|ГДЕ
	|	БанковскиеСчета.Ссылка = &БанковскийСчет";
	
	РеквизитыСправочника = Метаданные.Справочники.БанковскиеСчета.Реквизиты;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(РеквизитыСправочника, "ЦифровойСчет") Тогда
		Выражение_ЦифровойСчет = "БанковскиеСчета.ЦифровойСчет";
	Иначе
		Выражение_ЦифровойСчет = "ЛОЖЬ";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЦифровойСчет", Выражение_ЦифровойСчет);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Возврат Результат;
	
КонецФункции

Функция ВидОперацииУКДПоВидуДоговора(ВидДоговора)
	
	Если ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомиссионером")
		Или ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомиссионеромНаЗакупку") Тогда
		
		Результат = КонтрактыПровайдеров().ПеречислениеВидОперацииУКД().РеализацияЧерезКомиссионера;
		
	ИначеЕсли ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомитентом")
		Или ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку") Тогда
		
		Результат = КонтрактыПровайдеров().ПеречислениеВидОперацииУКД().ПередачаНаКомиссию;
		
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НалогообложениеУКД(УчетАгентскогоНДС, УчетАгентскогоНДСПокупателем)
	
	Результат = "";
	Налогообложения = КонтрактыПровайдеров().ПеречислениеНалогообложениеУКД();
	
	Если УчетАгентскогоНДС Тогда
		Результат = Налогообложения.НалоговыйАгент;
	КонецЕсли;
	Если УчетАгентскогоНДСПокупателем Тогда
		Результат = Налогообложения.НДСУПокупателя;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокиКонтрактаУКДИзТабличныхДанных(ТабличныеДанные, НомерСтроки)
	
	Результат = Новый Массив;
	
	ТаблицаТоваров = СвойствоСтруктурыЛок(ТабличныеДанные, "ТаблицаТоваров", Новый ТаблицаЗначений);
	КорректируемыеНомераСтрок = СвойствоСтруктурыЛок(ТабличныеДанные, "КорректируемыеНомераСтрок", Новый ТаблицаЗначений);
	СведенияПрослеживаемости = СвойствоСтруктурыЛок(ТабличныеДанные, "СведенияПрослеживаемости", Новый ТаблицаЗначений);
	
	ТоварныйДокумент = ТоварныйДокументУКД();
	
	Для Каждого СтрокаТЧ Из ТаблицаТоваров Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		ТипНоменклатуры = ТипНоменклатурыУКД(СтрокаТЧ.Номенклатура);
		
		СтрокаКонтракта = КонтрактыПровайдеров().НовыйСтрокаТабличнойЧастиУКД();
		
		СтрокаКонтракта.ТоварныйДокумент = ТоварныйДокумент;
		СтрокаКонтракта.НомерСтрокиДокумента = НомерСтроки;
		СтрокаКонтракта.НомерИсходнойСтроки = НомерИсходнойСтрокиУКД(НомерСтроки, КорректируемыеНомераСтрок);
		СтрокаКонтракта.ИдентификаторСтроки = СтрокаТЧ.ИдентификаторСтроки;
		
		СтрокаКонтракта.Номенклатура = СтрокаТЧ.Номенклатура;
		СтрокаКонтракта.НоменклатураКод = СтрокаТЧ.НоменклатураКод;
		СтрокаКонтракта.НоменклатураПредставление = СтрокаТЧ.НоменклатураПредставление;
		СтрокаКонтракта.ТипНоменклатуры = ТипНоменклатуры;
		СтрокаКонтракта.КодТНВЭД = СтрокаТЧ.ТоварКодТНВЭД;
		
		СтрокаКонтракта.КоличествоДо = СтрокаТЧ.КоличествоДоИзменения;
		СтрокаКонтракта.Количество = СтрокаТЧ.КоличествоПослеИзменения;
		
		СтрокаКонтракта.СтавкаНДС = СтрокаТЧ.СтавкаНДСДоИзменения;
		
		Если СтрокаТЧ.КоличествоДоИзменения > 0 Тогда
			СтрокаКонтракта.ЕдиницаИзмерения = СтрокаТЧ.ЕдиницаИзмерения;
			СтрокаКонтракта.ЕдиницаИзмеренияКод = СтрокаТЧ.ЕдиницаИзмеренияКод;
			СтрокаКонтракта.ЕдиницаИзмеренияНаименование = СтрокаТЧ.ЕдиницаИзмеренияНаименование;
		Иначе
			СтрокаКонтракта.ЕдиницаИзмеренияКод = "";
			СтрокаКонтракта.ЕдиницаИзмеренияНаименование = "";
		КонецЕсли;
		
		Если СтрокаТЧ.КоличествоДоИзменения = 0 Тогда
			СтрокаТЧ.ЦенаДоИзменения = 0;
		ИначеЕсли СтрокаТЧ.ЦенаДоИзменения = 0 Тогда
			СтрокаТЧ.ЦенаДоИзменения = Окр(СтрокаТЧ.СтоимостьБезНДСДоИзменения / СтрокаТЧ.КоличествоДоИзменения, 2);
		КонецЕсли;
		
		Если СтрокаТЧ.КоличествоПослеИзменения = 0 Тогда
			СтрокаТЧ.ЦенаПослеИзменения = СтрокаТЧ.ЦенаДоИзменения;
		ИначеЕсли СтрокаТЧ.ЦенаПослеИзменения = 0 Тогда
			СтрокаТЧ.ЦенаПослеИзменения = Окр(СтрокаТЧ.СтоимостьБезНДСПослеИзменения / СтрокаТЧ.КоличествоПослеИзменения, 2);
		КонецЕсли;
		
		СтрокаКонтракта.ЦенаДо = СтрокаТЧ.ЦенаДоИзменения;
		СтрокаКонтракта.Цена = СтрокаТЧ.ЦенаПослеИзменения;
		СтрокаКонтракта.СуммаБезНДСДо = СтрокаТЧ.СтоимостьБезНДСДоИзменения;
		СтрокаКонтракта.СуммаБезНДС = СтрокаТЧ.СтоимостьБезНДСПослеИзменения;
		СтрокаКонтракта.СуммаНДСДо = СтрокаТЧ.СуммаНДСДоИзменения;
		СтрокаКонтракта.СуммаНДС = СтрокаТЧ.СуммаНДСПослеИзменения;
		СтрокаКонтракта.СуммаСНДСДо = СтрокаТЧ.СтоимостьСНДСДоИзменения;
		СтрокаКонтракта.СуммаСНДС = СтрокаТЧ.СтоимостьСНДСПослеИзменения;
		СтрокаКонтракта.АкцизДо = СтрокаТЧ.АкцизДоИзменения;
		СтрокаКонтракта.Акциз = СтрокаТЧ.Акциз;
		
		СтрокаКонтракта.РазницаБезНДСУвеличение = СтрокаТЧ.РазницаБезНДСУвеличение;
		СтрокаКонтракта.РазницаБезНДСУменьшение = СтрокаТЧ.РазницаБезНДСУменьшение;
		СтрокаКонтракта.РазницаНДСУвеличение = СтрокаТЧ.РазницаНДСУвеличение;
		СтрокаКонтракта.РазницаНДСУменьшение = СтрокаТЧ.РазницаНДСУменьшение;
		СтрокаКонтракта.РазницаСНДСУвеличение = СтрокаТЧ.РазницаСНДСУвеличение;
		СтрокаКонтракта.РазницаСНДСУменьшение = СтрокаТЧ.РазницаСНДСУменьшение;
		СтрокаКонтракта.РазницаАкцизУвеличение = СтрокаТЧ.РазницаАкцизУвеличение;
		СтрокаКонтракта.РазницаАкцизУменьшение = СтрокаТЧ.РазницаАкцизУменьшение;
		
		СтрокаКонтракта.НомерГТД = СтрокаТЧ.НомерГТД;
		СтрокаКонтракта.СтранаПроисхождения = СтрокаТЧ.СтранаПроисхождения;
		
		СтрокаКонтракта.ПрослеживаемыйТовар = СтрокаТЧ.ПрослеживаемыйТовар;
		
		Если НЕ СтрокаТЧ.ПрослеживаемыйТовар Тогда
			СтрокаКонтракта.СведенияДТ = СведенияДТСтрокиКонтрактаУКД(СтрокаТЧ);
		КонецЕсли;
		
		Если СтрокаТЧ.ПрослеживаемыйТовар Тогда
			СтрокаКонтракта.СведенияПрослеживаемости = СведенияПрослеживаемостиДляСтрокиКонтрактаУКД(
				СведенияПрослеживаемости,
				СтрокаТЧ.ИдентификаторСтроки
			);
		КонецЕсли;
		
		Результат.Добавить(СтрокаКонтракта);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТоварныйДокументУКД()
	
	Результат = Неопределено;
	ТипДокумента = ТипЗнч(УчетныйДокумент1С);
	
	Если ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Результат = УчетныйДокумент1С;
	КонецЕсли;
	
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Основания = ДокументыОснованияСчетаФактурыВыданного(УчетныйДокумент1С);
		Если Основания.Количество() > 0 Тогда
			Результат = Основания[0];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипНоменклатурыУКД(Номенклатура)
	
	ТипыНоменклатуры = КонтрактыПровайдеров().ПеречислениеТипыНоменклатуры();
	ЭтоУслуга = ЗначениеРеквизитаОбъектаЛок(Номенклатура, "Услуга");
	
	Если ЭтоУслуга = Истина Тогда
		Результат = ТипыНоменклатуры.Услуга;
	Иначе
		Результат = ТипыНоменклатуры.Товар;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НомерИсходнойСтрокиУКД(НомерСтроки, КорректируемыеНомераСтрок)
	
	Результат = Неопределено;
	
	Если КорректируемыеНомераСтрок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокаСНомером = КорректируемыеНомераСтрок.Найти(НомерСтроки, "НомерСтроки");
	Если СтрокаСНомером <> Неопределено Тогда
		Результат = СтрокаСНомером.НомерИсходнойСтроки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияДТСтрокиКонтрактаУКД(СтрокаТЧ)
	
	Результат = Новый Массив;
	
	ЕстьСведенияДТ = ЗначениеЗаполнено(СтрокаТЧ.НомерГТД)
		Или ЗначениеЗаполнено(СтрокаТЧ.НомерГТДДо);
	
	Если Не ЕстьСведенияДТ Тогда
		Возврат Результат;
	КонецЕсли;
	
	Сведение = КонтрактыПровайдеров().НовыйСведениеДТ();
	Сведение.НомерГТДСсылка = СтрокаТЧ.НомерГТД;
	Сведение.НомерГТДДо = СтрокаТЧ.НомерГТДДоПредставление;
	Сведение.НомерГТД = СтрокаТЧ.НомерГТДПредставление;
	Сведение.Страна = СтрокаТЧ.СтранаПроисхождения;
	Сведение.СтранаКод = СтрокаТЧ.СтранаПроисхожденияКод;
	Сведение.СтранаНаименование = СтрокаТЧ.СтранаПроисхожденияНаименование;
	
	Результат.Добавить(Сведение);
	
	Возврат Результат;
	
КонецФункции

Функция СведенияПрослеживаемостиДляСтрокиКонтрактаУКД(СведенияПрослеживаемости, ИдентификаторСтроки)
	
	Результат = Новый Массив;
	
	Отбор = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	СтрокиПрослеживаемости = СведенияПрослеживаемости.НайтиСтроки(Отбор);
	
	Для каждого СтрокаПрослеживаемости Из СтрокиПрослеживаемости Цикл
		
		Если СтрокаПрослеживаемости.КоличествоПрослеживаемостиДо <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Сведение = КонтрактыПровайдеров().НовыйСведениеПрослеживаемости();
		
		Сведение.ИдентификаторСтроки = СтрокаПрослеживаемости.ИдентификаторСтроки;
		
		Сведение.НомерРНПТСсылка = СтрокаПрослеживаемости.РНПТ;
		Сведение.НомерРНПТ = СокрЛП(СтрокаПрослеживаемости.НомерТовара);
		
		Сведение.Страна = СтрокаПрослеживаемости.СтранаПроисхождения;
		Сведение.СтранаКод = СтрокаПрослеживаемости.СтранаПроисхожденияКод;
		Сведение.СтранаНаименование = СтрокаПрослеживаемости.СтранаПроисхожденияНаименование;
		
		Сведение.ЕдиницаИзмеренияКод = СокрЛП(СтрокаПрослеживаемости.ЕдиницаИзмеренияПрослеживаемостиКод);
		Сведение.ЕдиницаИзмеренияНаименование = СокрЛП(СтрокаПрослеживаемости.ЕдиницаИзмеренияПрослеживаемостиНаименование);
		
		Сведение.КоличествоДо = СтрокаПрослеживаемости.КоличествоПрослеживаемостиДо;
		Сведение.Количество = СтрокаПрослеживаемости.КоличествоПрослеживаемости;
		Сведение.КоличествоУвеличение = СтрокаПрослеживаемости.КоличествоПрослеживаемостиУвеличение;
		Сведение.КоличествоУменьшение = СтрокаПрослеживаемости.КоличествоПрослеживаемостиУменьшение;
		
		ТочностьЧисла = 2;
		
		Сведение.СтоимостьБезНДСДо = Окр(СтрокаПрослеживаемости.СуммаДо, ТочностьЧисла);
		Сведение.СтоимостьБезНДС = Окр(СтрокаПрослеживаемости.Сумма, ТочностьЧисла);
		
		Если СтрокаПрослеживаемости.Сумма >= СтрокаПрослеживаемости.СуммаДо Тогда
			СуммаУвеличение = СтрокаПрослеживаемости.Сумма - СтрокаПрослеживаемости.СуммаДо;
			СуммаУменьшение = 0;
		Иначе
			СуммаУвеличение = 0;
			СуммаУменьшение = СтрокаПрослеживаемости.СуммаДо - СтрокаПрослеживаемости.Сумма;
		КонецЕсли;
		
		Сведение.СтоимостьБезНДСУвеличение = Окр(СуммаУвеличение, ТочностьЧисла);
		Сведение.СтоимостьБезНДСУменьшение = Окр(СуммаУменьшение, ТочностьЧисла);
		
		Результат.Добавить(Сведение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОбщаяСуммаПоКомплектуУКД(СтрокиКомплекта)
	
	Результат = 0;
	
	Для Каждого СтрокаКомплекта Из СтрокиКомплекта Цикл
		Если СтрокаКомплекта.ОбщаяСуммаПоКомплекту <> 0 Тогда
			Результат = СтрокаКомплекта.ОбщаяСуммаПоКомплекту;
			Прервать;
		Иначе
			Результат = Результат + СтрокаКомплекта.СуммаПоРНПТ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СтоимостьПоРНПТСтрокиКомплектаУКД(СуммаБезНДС, ОбщаяСуммаПоКомплекту, СуммаПоРНПТ)
	
	Результат = 0;
	
	Если ОбщаяСуммаПоКомплекту <> 0 Тогда
		Результат = (СуммаБезНДС / ОбщаяСуммаПоКомплекту) * СуммаПоРНПТ;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтавкаНДСИзСоответствия(ПредставлениеБЭД = "", ПрикладноеЗначение = Неопределено)
	
	Результат = Неопределено;
	
	ПеречислениеСтавокНДС = ЗаполнитьСоответствиеСтавокНДС();
	
	Если ЗначениеЗаполнено(ПредставлениеБЭД) Тогда
		
		Результат = ПеречислениеСтавокНДС.Получить(ПредставлениеБЭД);
		
	Иначе
		
		Для Каждого КлючИЗначение Из ПеречислениеСтавокНДС Цикл
			
			Если КлючИЗначение.Значение = ПрикладноеЗначение Тогда
				
				Результат = КлючИЗначение.Ключ;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьСоответствиеСтавокНДС()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить("0", Перечисления.СтавкиНДС.НДС0);
	Результат.Вставить("10", Перечисления.СтавкиНДС.НДС10);
	Результат.Вставить("18", Перечисления.СтавкиНДС.НДС18);
	Результат.Вставить("20", Перечисления.СтавкиНДС.НДС20);
	Результат.Вставить("10/110", Перечисления.СтавкиНДС.НДС10_110);
	Результат.Вставить("18/118", Перечисления.СтавкиНДС.НДС18_118);
	Результат.Вставить("20/120", Перечисления.СтавкиНДС.НДС20_120);
	Результат.Вставить(ПредставлениеСтавкиБезНДС(), Перечисления.СтавкиНДС.БезНДС);
	Результат.Вставить(СтавкаНДСИсчисляетсяНалоговымАгентом(), СтавкаНДСИсчисляетсяНалоговымАгентомПредставление());
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5") Тогда
		Результат.Вставить("5", Перечисления.СтавкиНДС.НДС5);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7") Тогда
		Результат.Вставить("7", Перечисления.СтавкиНДС.НДС7);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22") Тогда
		Результат.Вставить("22", Перечисления.СтавкиНДС.НДС22);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5_105") Тогда
		Результат.Вставить("5/105", Перечисления.СтавкиНДС.НДС5_105);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7_107") Тогда
		Результат.Вставить("7/107", Перечисления.СтавкиНДС.НДС7_107);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22_122") Тогда
		Результат.Вставить("22/122", Перечисления.СтавкиНДС.НДС22_122);
	КонецЕсли;
	
	Результат.Вставить(Перечисления.СтавкиНДС.НДС0, "0");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС10, "10");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС18, "18");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС20, "20");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС10_110, "10/110");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС18_118, "18/118");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС20_120, "20/120");
	Результат.Вставить(Перечисления.СтавкиНДС.БезНДС, ПредставлениеСтавкиБезНДС());
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС5, "5");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС7, "7");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС22, "22");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5_105") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС5_105, "5/105");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7_107") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС7_107, "7/107");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22_122") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС22_122, "22/122");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СуществуетЗначениеПеречисленияСтавкиНДС(ИмяЗначенияСтавкаНДС)
	
	ЗначенияПеречисления = Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления;
	Результат = (ЗначенияПеречисления.Найти(ИмяЗначенияСтавкаНДС) <> Неопределено);
	
