	|	&СуммаАкцизаДоИзменения КАК АкцизДоИзменения,
	|	&СуммаАкцизаПослеИзменения КАК Акциз,
	|	&РазницаАкцизУменьшение КАК РазницаАкцизУменьшение,
	|	&РазницаАкцизУвеличение КАК РазницаАкцизУвеличение
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО ТаблицаДокумента.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ТаблицаДокумента.Товар = Номенклатура.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабЧасти,
	|	НомерСтроки";
	
	МетаданныеТчТовары = Метаданные.Документы.КорректировкаРеализации.ТабличныеЧасти.Товары.Реквизиты;
	
	ЕстьАкцизДоИзменения = ЕстьРеквизитИлиСвойствоОбъектаЛок(МетаданныеТчТовары, "СуммаАкцизаДоИзменения");
	ЕстьАкциз = ЕстьРеквизитИлиСвойствоОбъектаЛок(МетаданныеТчТовары, "СуммаАкциза");
	ЕстьКодыВидовПодакцизныхТоваров = Метаданные.Справочники.Найти("КодыВидовПодакцизныхТоваров") <> Неопределено;
	
	Если ЕстьАкцизДоИзменения
		И ЕстьКодыВидовПодакцизныхТоваров Тогда
		Выражение_СуммаАкцизаДоИзменения =
			"ВЫБОР
			|	КОГДА ТаблицаДокумента.Товар.КодВидаПодакцизногоТовара <> ЗНАЧЕНИЕ(Справочник.КодыВидовПодакцизныхТоваров.ПустаяСсылка)
			|		ТОГДА ТаблицаДокумента.СуммаАкцизаДоИзменения
			|	ИНАЧЕ НЕОПРЕДЕЛЕНО
			|КОНЕЦ";
	ИначеЕсли ЕстьАкцизДоИзменения Тогда
		Выражение_СуммаАкцизаДоИзменения =
			"ВЫБОР
			|	КОГДА ТаблицаДокумента.СуммаАкцизаДоИзменения <> 0
			|		ТОГДА ТаблицаДокумента.СуммаАкцизаДоИзменения
			|	ИНАЧЕ НЕОПРЕДЕЛЕНО
			|КОНЕЦ";
	Иначе
		Выражение_СуммаАкцизаДоИзменения = "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	Если ЕстьАкциз
		И ЕстьКодыВидовПодакцизныхТоваров Тогда
		Выражение_СуммаАкцизаПослеИзменения =
			"ВЫБОР
			|	КОГДА ТаблицаДокумента.Товар.КодВидаПодакцизногоТовара <> ЗНАЧЕНИЕ(Справочник.КодыВидовПодакцизныхТоваров.ПустаяСсылка)
			|		ТОГДА ТаблицаДокумента.СуммаАкцизаПослеИзменения
			|	ИНАЧЕ НЕОПРЕДЕЛЕНО
			|КОНЕЦ";
	ИначеЕсли ЕстьАкциз Тогда
		Выражение_СуммаАкцизаПослеИзменения =
			"ВЫБОР
			|	КОГДА ТаблицаДокумента.СуммаАкцизаПослеИзменения <> 0
			|		ТОГДА ТаблицаДокумента.СуммаАкцизаПослеИзменения
			|	ИНАЧЕ НЕОПРЕДЕЛЕНО
			|КОНЕЦ";
	Иначе
		Выражение_СуммаАкцизаПослеИзменения = "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	Если ЕстьАкцизДоИзменения
		И ЕстьАкциз
		И ЕстьКодыВидовПодакцизныхТоваров Тогда
		
		Выражение_РазницаАкцизУменьшение =
			"ВЫБОР
			|	КОГДА ТаблицаДокумента.Товар.КодВидаПодакцизногоТовара <> ЗНАЧЕНИЕ(Справочник.КодыВидовПодакцизныхТоваров.ПустаяСсылка)
			|		ТОГДА ВЫБОР
			|				КОГДА ТаблицаДокумента.СуммаАкцизаДоИзменения > ТаблицаДокумента.СуммаАкцизаПослеИзменения
			|					ТОГДА ТаблицаДокумента.СуммаАкцизаДоИзменения - ТаблицаДокумента.СуммаАкцизаПослеИзменения
			|				ИНАЧЕ 0
			|			КОНЕЦ
			|	ИНАЧЕ НЕОПРЕДЕЛЕНО
			|КОНЕЦ";
		
		Выражение_РазницаАкцизУвеличение =
			"ВЫБОР
			|	КОГДА ТаблицаДокумента.Товар.КодВидаПодакцизногоТовара <> ЗНАЧЕНИЕ(Справочник.КодыВидовПодакцизныхТоваров.ПустаяСсылка)
			|		ТОГДА ВЫБОР
			|				КОГДА ТаблицаДокумента.СуммаАкцизаПослеИзменения > ТаблицаДокумента.СуммаАкцизаДоИзменения
			|					ТОГДА ТаблицаДокумента.СуммаАкцизаПослеИзменения - ТаблицаДокумента.СуммаАкцизаДоИзменения
			|				ИНАЧЕ 0
			|			КОНЕЦ
			|	ИНАЧЕ НЕОПРЕДЕЛЕНО
			|КОНЕЦ";
		
	ИначеЕсли ЕстьАкцизДоИзменения
		И ЕстьАкциз Тогда
		
		Выражение_РазницаАкцизУменьшение =
			"ВЫБОР
			|		КОГДА ТаблицаДокумента.СуммаАкцизаДоИзменения > ТаблицаДокумента.СуммаАкцизаПослеИзменения
			|			ТОГДА ТаблицаДокумента.СуммаАкцизаДоИзменения - ТаблицаДокумента.СуммаАкцизаПослеИзменения
			|		ИНАЧЕ 0
			|	КОНЕЦ";
		
		Выражение_РазницаАкцизУвеличение =
			"ВЫБОР
			|		КОГДА ТаблицаДокумента.СуммаАкцизаПослеИзменения > ТаблицаДокумента.СуммаАкцизаДоИзменения
			|			ТОГДА ТаблицаДокумента.СуммаАкцизаПослеИзменения - ТаблицаДокумента.СуммаАкцизаДоИзменения
			|		ИНАЧЕ 0
			|	КОНЕЦ";
		
	Иначе
		Выражение_РазницаАкцизУменьшение = "НЕОПРЕДЕЛЕНО";
		Выражение_РазницаАкцизУвеличение = "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СуммаАкцизаДоИзменения", Выражение_СуммаАкцизаДоИзменения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СуммаАкцизаПослеИзменения", Выражение_СуммаАкцизаПослеИзменения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РазницаАкцизУменьшение", Выражение_РазницаАкцизУменьшение);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РазницаАкцизУвеличение", Выражение_РазницаАкцизУвеличение);
	
	Возврат ТекстЗапроса;
	
	// BSLLS:DuplicateStringLiteral-on
КонецФункции

Функция ТекстЗапросаТаблицаСведенияПрослеживаемости()
