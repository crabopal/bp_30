Процедура ЗаполнитьРеквизитыШапкиПоКорректировкеРеализации(Контракт)
	
	ДанныеШапки = ДанныеШапкиУКДПоКорректировкеРеализации();
	
	Контракт.Ссылка = ДанныеШапки.Ссылка;
	Контракт.Номер = ДанныеШапки.Номер;
	Контракт.ПредставлениеНомера = НомерНаПечатьЛокализация(ДанныеШапки.Номер);
	Контракт.Дата = ДанныеШапки.Дата;
	
	ЗаполнитьИсправлениеШапкиУКД(Контракт, ДанныеШапки);
	
	Если ЗначениеЗаполнено(ДанныеШапки.Продавец) Тогда
		Контракт.Продавец = ДанныеШапки.Продавец;
		Контракт.БанковскийСчетПродавца = Неопределено;
	Иначе
		Контракт.Продавец = ДанныеШапки.Организация;
		Контракт.БанковскийСчетПродавца = ДанныеШапки.БанковскийСчетОрганизации;
	КонецЕсли;
	
	Контракт.КПППродавца = ДанныеШапки.КПППоставщика;
	
	Контракт.Покупатель = ДанныеШапки.Контрагент;
	Контракт.БанковскийСчетПокупателя = ДанныеШапки.БанковскийСчетКонтрагента;
	Контракт.КПППокупателя = ДанныеШапки.КПППокупателя;
	
	Контракт.Договор = ДанныеШапки.Договор;
	Контракт.Основание = ДанныеШапки.Основание;
	Контракт.ОснованиеНомер = ДанныеШапки.ОснованиеНомер;
	Контракт.ОснованиеДата = ДанныеШапки.ОснованиеДата;
	
	Контракт.КодВидаОперации = "";
	
	ВидДоговора = СвойствоСтруктурыЛок(ДанныеШапки, "ВидДоговора");
	
	Контракт.ВидОперации = ВидОперацииУКДПоВидуДоговора(ВидДоговора);
	Контракт.Налогообложение = НалогообложениеУКД(
		ДанныеШапки.УчетАгентскогоНДС,
		ДанныеШапки.УчетАгентскогоНДСПокупателем
	);
	
	ЗаполнитьВалютуШапкиУКД(Контракт, ДанныеШапки);
	
	Контракт.ИдентификаторГосКонтракта = ДанныеШапки.ИдентификаторГосКонтракта;
	Контракт.СопроводительныеДокументы = ДанныеШапки.СопроводительныеДокументы;
	
	Контракт.ПервичныеДокументы = РеквизитыПервичныхДокументовПоКорректировкеРеализации();
	Контракт.ДокументыОснования = РеквизитыДокументовОснования();
	
КонецПроцедуры

Функция ДанныеШапкиУКДПоКорректировкеРеализации()
	// BSLLS:QueryNestedFieldsByDot-off
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	// BSLLS:LogicalOrInJoinQuerySection-off
	// BSLLS:JoinWithSubQuery-off
	// BSLLS:JoinWithVirtualTable-off
	// BSLLS:AssignAliasFieldsInQuery-off
	// BSLLS:DuplicateStringLiteral-off
	
	// BSLLS:QueryParseError-off
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Корректировка.Ссылка КАК Ссылка,
	|	Корректировка.Номер КАК Номер,
	|	Корректировка.Дата КАК Дата,
	|	Корректировка.НомерИсправления КАК НомерИсправления,
	|	Корректировка.Дата КАК ДатаИсправления,
	|	ВЫБОР
	|		КОГДА Организации.ОбособленноеПодразделение
	|				И Организации.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА Организации.ГоловнаяОрганизация
	|		ИНАЧЕ Корректировка.Организация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА Контрагенты.Ссылка ЕСТЬ НЕ NULL
	|			ТОГДА ВЫБОР
	|				КОГДА Контрагенты.ОбособленноеПодразделение
	|					И Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|					ТОГДА Контрагенты.ГоловнойКонтрагент
	|				ИНАЧЕ Корректировка.Контрагент
	|			КОНЕЦ
	|		ИНАЧЕ Корректировка.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Контрагенты.ОбособленноеПодразделение
	|			И Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Контрагенты.КПП, """")
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КПППокупателя,
	|	Корректировка.БанковскийСчетОрганизации КАК БанковскийСчетОрганизации,
	|	ВЫБОР
	|		КОГДА Контрагенты.ОбособленноеПодразделение
	|				И Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Контрагенты.ГоловнойКонтрагент.ОсновнойБанковскийСчет
	|		ИНАЧЕ Контрагенты.ОсновнойБанковскийСчет
	|	КОНЕЦ КАК БанковскийСчетКонтрагента,
	|	Корректировка.ВалютаДокумента КАК Валюта,
	|	Корректировка.ДоговорКонтрагента.ВидДоговора КАК ВидДоговора,
	|	Корректировка.ДоговорКонтрагента.Наименование КАК Основание,
	|	Корректировка.ДоговорКонтрагента.Номер КАК ОснованиеНомер,
	|	Корректировка.ДоговорКонтрагента.Дата КАК ОснованиеДата,
	|	Корректировка.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем КАК УчетАгентскогоНДСПокупателем,
	|	Корректировка.ДоговорКонтрагента.УчетАгентскогоНДС КАК УчетАгентскогоНДС,
	|	Корректировка.ДоговорКонтрагента КАК Договор,
	|	"""" КАК ИдентификаторГосКонтракта,
	|	"""" КАК КПППоставщика,
	|	&СопроводительныеДокументы КАК СопроводительныеДокументы
	|ИЗ
	|	Документ.КорректировкаРеализации КАК Корректировка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО Корректировка.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Корректировка.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	Корректировка.Ссылка = &Корректировка";
	// BSLLS:QueryParseError-on
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(УчетныйДокумент1С.Метаданные().Реквизиты, "СопроводительныеДокументы") Тогда
		Выражение_СопроводительныеДокументы = "Корректировка.СопроводительныеДокументы";
	Иначе
		Выражение_СопроводительныеДокументы = """""";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СопроводительныеДокументы", Выражение_СопроводительныеДокументы);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Корректировка", УчетныйДокумент1С);

	РеквизитыДокумента = Запрос.Выполнить().Выгрузить();
	Если РеквизитыДокумента.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru='Не найдены данные корректировки реализации для заполнения шапки УКД.'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	Результат = МодульОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РеквизитыДокумента[0]);

	КППОбособленногоПодразделения = КППОбособленногоПодразделенияПоДокументу(УчетныйДокумент1С);
	Если ЗначениеЗаполнено(КППОбособленногоПодразделения) Тогда
		Результат.КПППоставщика = КППОбособленногоПодразделения;
	КонецЕсли;
	
	ДополнитьДанныеШапкиУКДПоставщиком(Результат);
	
	Возврат Результат;
	// BSLLS:DuplicateStringLiteral-on
	// BSLLS:AssignAliasFieldsInQuery-on
	// BSLLS:JoinWithVirtualTable-on
	// BSLLS:JoinWithSubQuery-on
	// BSLLS:LogicalOrInJoinQuerySection-on
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	// BSLLS:QueryNestedFieldsByDot-on
КонецФункции

Функция РеквизитыПервичныхДокументовПоКорректировкеРеализации()
	
	Результат = Новый Массив;
	ПервичныйДокумент = НайтиПервичныйДокументУКДПоДокументамОснования(УчетныйДокумент1С);
	ДобавитьРеквизитыПервичногоДокументаУКДВКоллекцию(Результат, ПервичныйДокумент);
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДокументовОснованийКорректировкиРеализации(ДокументКорректировки)
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("НомерИсходногоДокумента");
	Реквизиты.Вставить("ДатаИсходногоДокумента");
	Реквизиты.Вставить("НомерИсправленияИсходногоДокумента");
	Реквизиты.Вставить("ДатаИсправленияИсходногоДокумента");
	
	РеквизитыОснования = ЗначенияРеквизитовОбъектаЛок(ДокументКорректировки, Реквизиты);
	
	УчитыватьИсправление =
		ЗначениеЗаполнено(РеквизитыОснования.НомерИсправленияИсходногоДокумента)
		И ЗначениеЗаполнено(РеквизитыОснования.ДатаИсправленияИсходногоДокумента);
	
	РеквизитыОснования.Вставить("УчитыватьИсправлениеИсходногоДокумента", УчитыватьИсправление);
	
	Результат = СтдКоллекции().ЗначениеВМассивеЛок(РеквизитыОснования);
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьДанныеШапкиУКДПоставщиком(ДанныеШапки)
	
	Продавец = Справочники.Контрагенты.ПустаяСсылка();
	
	СчетФактура = СчетФактураВыданныйДляШапкиУКД(ДанныеШапки.Ссылка);
	СводныйКомиссионный = ЗначениеРеквизитаОбъектаЛок(СчетФактура, "СводныйКомиссионный");
	
	Если СводныйКомиссионный = Ложь Тогда
		Продавец = ЗначениеРеквизитаОбъектаЛок(СчетФактура, "Продавец");
	КонецЕсли;
	
	ДанныеШапки.Вставить("Продавец", Продавец);
	
КонецПроцедуры

Функция СчетФактураВыданныйДляШапкиУКД(Документ)
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Результат = Документ;
	Иначе
		Результат = СчетФактураВыданныйПоДокументуОснованию(Документ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

