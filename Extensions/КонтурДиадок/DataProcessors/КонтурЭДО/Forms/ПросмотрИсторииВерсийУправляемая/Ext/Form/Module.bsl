// BSLLS:MissingVariablesDescription-off 
&НаСервере
Перем _ОбработкаОбъект;
// BSLLS:MissingVariablesDescription-on

////////////////////////////////////////////////////////////////////////////////
// Сервисные методы

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции

&НаКлиенте
Функция ОсновнаяФорма() Экспорт
	
	Результат = ВладелецФормы.ОсновнаяФорма();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Модуль_ЯдроНаКлиенте()
	
	Результат = ОсновнаяФорма().Модуль_ЯдроНаКлиенте();
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Объект.Свойство("ОбщийКонтекстКлиентСервер", Объект.ОбщийКонтекстКлиентСервер);
	
	Элементы.Гиперссылка.Видимость = Параметры.ВерсияОт <> "";
	
	Если Параметры.ВерсияОт = "" Тогда
		ЗаполнитьИсториюИзменений("1.0.0");
	Иначе
		ЗаполнитьИсториюИзменений(Параметры.ВерсияОт);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаНажатие(Элемент)
	
	ЗаполнитьИсториюИзменений("1.0.0");
	Элементы.Гиперссылка.Видимость = Ложь;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ЗаполнитьИсториюИзменений(ВерсияОт)
	
	ВерсииИОписания = ОбработкаОбъект().ИсторияВерсийИзМакета(ВерсияОт);
	ЭтаФорма.ОписаниеИзменений = ОбработкаОбъект().ИсторияВерсийКакТекст(ВерсииИОписания);
	
КонецПроцедуры