Функция ИспользуетсяСверкаВзаиморасчетов2_4()
	
	ВерсияУТ = ВерсияТорговойПодсистемыЛок();
	Результат = (__СтдСтр.СравнитьВерсииЛок(ВерсияУТ, "11.5.20.00") >= 0);
	
	Возврат Результат;
	
КонецФункции

