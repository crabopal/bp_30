Процедура ДокументыБезСФ_ДобавитьТекстЗапросаПоДаннымТЧПоУсловию(Запросы, ВидДокумента, ТабличнаяЧасть, Условие)
	
	ТЧ = "Документ." + ВидДокумента + ".ТабличнаяЧасть." + ТабличнаяЧасть;
	Если Метаданные.НайтиПоПолномуИмени(ТЧ) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат =
	"ВЫБРАТЬ
	|    ТабличнаяЧасть.Ссылка КАК Документ,
	|    0 КАК ВсегоПозиций,
	|    0 КАК ПозицийБезНДС,
	|    ЛОЖЬ КАК Исправление,
	|    ЛОЖЬ КАК Корректировка
	|ИЗ
	|    &Таблица КАК ТабличнаяЧасть
	|ГДЕ
	|    НЕ ТабличнаяЧасть.Ссылка.ПометкаУдаления
	|    И ТабличнаяЧасть.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода" + Условие;
	
	Таблица = "Документ." + ВидДокумента + "." + ТабличнаяЧасть;
	Результат = СтрЗаменить(Результат, "&Таблица", Таблица);
	
	Если Запросы.Количество() = 0 Тогда
		Результат = СтрЗаменить(Результат, "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
		Результат = СтрЗаменить(Результат, "ИЗ", "ПОМЕСТИТЬ ВТ_Документы ИЗ");
	КонецЕсли;
	
	Запросы.Добавить(Результат); 
	
КонецПроцедуры

Процедура ДокументыБезСФ_ДобавитьТекстЗапросаПоОтчетуКомитентуОПродажах(Запросы)
	
	Если Не РазрешеноЧтениеТаблицы(Метаданные.Документы.ОтчетКомитенту) Тогда
		Возврат;
	КонецЕсли;
	
	Результат =
	"ВЫБРАТЬ
	|    Док.Ссылка КАК Документ,
	|    0 КАК ВсегоПозиций,
	|    0 КАК ПозицийБезНДС,
	|    ЛОЖЬ КАК Исправление,
	|    ЛОЖЬ КАК Корректировка
	|ИЗ
	|    Документ.ОтчетКомитенту КАК Док
	|ГДЕ
	|    НЕ Док.ПометкаУдаления
	|    И Док.СпособРасчетаВознаграждения <> ЗНАЧЕНИЕ(Перечисление.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается)
	|    И Док.СтавкаНДСВознаграждения = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|    И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	
	Если Метаданные.Справочники.Найти("СтавкиНДС") <> Неопределено Тогда
		Результат = СтрЗаменить(Результат, "Перечисление.СтавкиНДС", "Справочник.СтавкиНДС");
	КонецЕсли;
	
	ДобавитьТекстЗапросаВПакет(Запросы, Результат);   
	
КонецПроцедуры

Процедура ДокументыБезСФ_ДобавитьТекстЗапросаПоВозвратТоваровПоставщику(Запросы)
	
	Если Не РазрешеноЧтениеТаблицы(Метаданные.Документы.ВозвратТоваровПоставщику) Тогда
		Возврат;
	КонецЕсли;
	
	Результат =
	"ВЫБРАТЬ
	|    Док.Ссылка КАК Документ,
	|    0 КАК ВсегоПозиций,
	|    0 КАК ПозицийБезНДС,
	|    ЛОЖЬ КАК Исправление,
	|    ЛОЖЬ КАК Корректировка
	|ИЗ
	|    Документ.ВозвратТоваровПоставщику КАК Док
	|ГДЕ
	|    НЕ Док.ПометкаУдаления
	|    И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	
	ДобавитьТекстЗапросаВПакет(Запросы, Результат);
	
КонецПроцедуры

