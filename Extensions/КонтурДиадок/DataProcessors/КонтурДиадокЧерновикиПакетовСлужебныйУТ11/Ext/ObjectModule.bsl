Функция ТекстЗапроса_ВТ_СчетФактурыПоОтчетуКомиссионера()
	
	Если Не ИспользуетсяСчетФактураКомиссионеру() 
		Или Не РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетФактураКомиссионеру) Тогда
		
		Возврат
		"ВЫБРАТЬ ПЕРВЫЕ 0
		|    НЕОПРЕДЕЛЕНО КАК Документ,
		|    ИСТИНА КАК Проведен,
		|    НЕОПРЕДЕЛЕНО КАК НомерДокумента,
		|    НЕОПРЕДЕЛЕНО КАК ДатаДокумента,
		|    НЕОПРЕДЕЛЕНО КАК Контрагент,
		|    НЕОПРЕДЕЛЕНО КАК Организация,
		|    0 КАК СуммаДокумента,
		|    ЛОЖЬ КАК Сводный,
		|    ЛОЖЬ КАК Корректировочный
		|ПОМЕСТИТЬ ВТ_СчетФактурыПоОтчетуКомиссионера";
		
	КонецЕсли;
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    СчетФактураКомиссионеру.Ссылка КАК Документ,
	|    СчетФактураКомиссионеру.Проведен КАК Проведен,
	|    СчетФактураКомиссионеру.Номер КАК НомерДокумента,
	|    СчетФактураКомиссионеру.Дата КАК ДатаДокумента,
	|    СчетФактураКомиссионеру.Контрагент КАК Контрагент,
	|    СчетФактураКомиссионеру.Организация КАК Организация,
	|    0 КАК СуммаДокумента,
	|    СчетФактураКомиссионеру.Сводный КАК Сводный,
	|    ЛОЖЬ КАК Корректировочный
	|ПОМЕСТИТЬ ВТ_СчетФактурыПоОтчетуКомиссионера
	|ИЗ
	|    Документ.СчетФактураКомиссионеру КАК СчетФактураКомиссионеру
	|ГДЕ
	|    СчетФактураКомиссионеру.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|    И НЕ СчетФактураКомиссионеру.ПометкаУдаления
	|    И НЕ СчетФактураКомиссионеру.Сводный";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_СчетНаОплатуЧерновики(ИмяВременнойТаблицы, ВидПакетаID)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|    Т.Ссылка КАК Документ,
	|    Т.Номер КАК НомерДокумента,
	|    Т.Дата КАК ДатаДокумента,
	|    Т.Контрагент КАК Контрагент,
	|    Т.Организация КАК Организация,
	|    Т.СуммаДокумента КАК СуммаДокумента,
	|    &ВидПакетаID КАК ВидПакетаID
	|ПОМЕСТИТЬ ИмяВременнойТаблицы
	|ИЗ
	|    Документ.СчетНаОплатуКлиенту КАК Т
	|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НастройкиОрганизаций КАК ВТ_Настройки
	|        ПО Т.Организация = ВТ_Настройки.Организация1С
	|            И (ВТ_Настройки.ВидПакетаID = &ВидПакетаID)
	|        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Отправители КАК ВТ_Отправители
	|        ПО Т.Организация = ВТ_Отправители.Организация1С
	|        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПартнерскиеОтношения КАК ВТ_Получатели
	|        ПО Т.Контрагент = ВТ_Получатели.Контрагент1С
	|ГДЕ
	|    Т.Проведен
	|    И Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|    И НЕ Т.ПометкаУдаления
	|    И ВТ_Получатели.Контрагент1С ЕСТЬ NULL
	|    И НЕ ВТ_Отправители.Организация1С ЕСТЬ NULL";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПакетаID", """" + ВидПакетаID + """");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ПервичныеДокументыБезНДСЧерновики(ИмяВременнойТаблицы, ВидПакетаID)
	
	ТекстЗапросаВТДокументыБезНДС = ТекстЗапроса_ВТДокументыБезНДС();
	
	ТекстЗапросаВТ =
	";
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|    Т.Документ КАК Документ,
	|    Т.НомерДокумента КАК НомерДокумента,
	|    Т.ДатаДокумента КАК ДатаДокумента,
	|    Т.Контрагент КАК Контрагент,
	|    Т.Организация КАК Организация,
	|    Т.СуммаДокумента КАК СуммаДокумента,
	|    &ВидПакетаID КАК ВидПакетаID
	|ПОМЕСТИТЬ ИмяВременнойТаблицы
	|ИЗ
	|    ВТ_ДокументыБезНДС КАК Т
	|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НастройкиОрганизаций КАК ВТ_Настройки
	|        ПО Т.Организация = ВТ_Настройки.Организация1С
	|            И (ВТ_Настройки.ВидПакетаID = &ВидПакетаID)
	|            И (НЕ Т.Исправление)
	|            И (НЕ Т.Корректировка)
	|        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Отправители КАК ВТ_Отправители
	|        ПО Т.Организация = ВТ_Отправители.Организация1С
	|        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПартнерскиеОтношения КАК ВТ_Получатели
	|        ПО Т.Контрагент = ВТ_Получатели.Контрагент1С
	|ГДЕ
	|    Т.ДатаДокумента МЕЖДУ &НачалоПериода И &КонецПериода
	|    И Т.Проведен
	|    И ВТ_Получатели.Контрагент1С ЕСТЬ NULL
	|    И НЕ ВТ_Отправители.Организация1С ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ДокументыБезНДС;
	|УНИЧТОЖИТЬ ВТ_ПодходящиеДокументы;
	|УНИЧТОЖИТЬ ВТ_Документы;
	|";
	
	Если ЭтоИсправительныйВидПакета(ВидПакетаID) Тогда
		ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ, "И (НЕ Т.Исправление)", "И (Т.Исправление)");
	КонецЕсли;
	
	Если ЭтоКорректировкаРеализацииБезНДС(ВидПакетаID) Тогда
		ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ, "И (НЕ Т.Корректировка)", "И (Т.Корректировка)");
	КонецЕсли;
	
	ВидПервичногоПакета = "= ""ID_ОсновнойПакет""";
	Если ВидПакетаID <> "ID_ТОРГ12_Акт_БезНДС" Тогда
		ВидПервичногоПакетаПолный = СтрЗаменить(ВидПакетаID, "ID_И", "ID_");
		ВидПервичногоПакетаПолный = СтрЗаменить(ВидПервичногоПакетаПолный, "_БезНДС", "");
		ВидПервичногоПакетаРаздельно = ВидПервичногоПакетаПолный + "_Раздельно";
		ВидПервичногоПакета = "В (""" + ВидПервичногоПакетаПолный + """,""" + ВидПервичногоПакетаРаздельно + """)";
	КонецЕсли;
	
	ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ, "ВТ_Настройки.ВидПакетаID = &ВидПакетаID",
	"ВТ_Настройки.ВидПакетаID " + ВидПервичногоПакета);
	ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ, "&ВидПакетаID", """" + ВидПакетаID + """");
	ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаВТДокументыБезНДС);
	ЧастиЗапроса.Добавить(ТекстЗапросаВТ);
	ТекстЗапроса = СтрСоединить(ЧастиЗапроса, Символы.ПС);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_АктСверкиЧерновики(ИмяВременнойТаблицы, ВидПакетаID, ПолноеИмяТаблицы)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|    Т.Ссылка КАК Документ,
	|    Т.Номер КАК НомерДокумента,
	|    Т.Дата КАК ДатаДокумента,
	|    Т.Контрагент КАК Контрагент,
	|    Т.Организация КАК Организация,
	|    0 КАК СуммаДокумента,
	|    &ВидПакетаID КАК ВидПакетаID
	|ПОМЕСТИТЬ ИмяВременнойТаблицы
	|ИЗ
	|    &ПолноеИмяТаблицы КАК Т
	|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НастройкиОрганизаций КАК ВТ_Настройки
	|        ПО Т.Организация = ВТ_Настройки.Организация1С
	|            И (ВТ_Настройки.ВидПакетаID = &ВидПакетаID)
	|        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Отправители КАК ВТ_Отправители
	|        ПО Т.Организация = ВТ_Отправители.Организация1С
	|        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПартнерскиеОтношения КАК ВТ_Получатели
	|        ПО Т.Контрагент = ВТ_Получатели.Контрагент1С
	|ГДЕ
	|    Т.Проведен
	|    И Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|    И НЕ Т.ПометкаУдаления
	|    И ВТ_Получатели.Контрагент1С ЕСТЬ NULL
	|    И НЕ ВТ_Отправители.Организация1С ЕСТЬ NULL";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПакетаID", """" + ВидПакетаID + """");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ВТДокументыБезНДС()
	
	Запросы = Новый Массив;
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "АктВыполненныхРабот", "Услуги");
	// BSLLS:LineLength-off
	ТекстОтбораДокументов = " И НЕ ТабличнаяЧасть.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаНаКомиссию)";
	// BSLLS:DuplicateStringLiteral-off
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "РеализацияТоваровУслуг", "Товары", ТекстОтбораДокументов);
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "РеализацияУслугПрочихАктивов", "Доходы");
	
	ТекстОтбораДокументов = ТекстЗапрос_ОтборКорректировкиВПервичныхДокументах(); 
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "КорректировкаРеализации", "Товары", ТекстОтбораДокументов, "Истина");
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "КорректировкаРеализации", "Расхождения", ТекстОтбораДокументов, "Истина");
	
	ТекстОтбораДокументов = ТекстЗапрос_ОтборКорректировкиПоСогласованиюСторон();
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "КорректировкаРеализации", "Товары", ТекстОтбораДокументов, , "Истина");
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "КорректировкаРеализации", "Расхождения", ТекстОтбораДокументов, , "Истина");
	
	ТекстОтбораДокументов = " И ТабличнаяЧасть.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаНаКомиссию)";
	ДокументыБезСФ_ДобавитьТекстЗапросаПоДаннымТЧПоУсловию(Запросы, "РеализацияТоваровУслуг", "Товары", ТекстОтбораДокументов);
	// BSLLS:LineLength-on
	// BSLLS:DuplicateStringLiteral-on
	ДокументыБезСФ_ДобавитьТекстЗапросаПоОтчетуКомитентуОПродажах(Запросы);
	ДокументыБезСФ_ДобавитьТекстЗапросаПоВозвратТоваровПоставщику(Запросы);
	
	Если ЕстьДокументПередачаТоваровХранителю() Тогда
		ДокументыБезСФ_ДобавитьТекстЗапросаПередачаТоваровХранителю(Запросы);
	КонецЕсли;
	
	Результат = СтрСоединить(Запросы, ТекстЗапроса_ОбъединитьВсе());
	
	Результат = Результат +
	";
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|    ВТ_Документы.Документ КАК Документ,
	|    ВТ_Документы.Исправление КАК Исправление,
	|    ВТ_Документы.Корректировка КАК Корректировка
	|ПОМЕСТИТЬ ВТ_ПодходящиеДокументы
	|ИЗ
	|    ВТ_Документы КАК ВТ_Документы
	|
	|СГРУППИРОВАТЬ ПО
	|    ВТ_Документы.Документ,
	|    ВТ_Документы.Исправление,
	|    ВТ_Документы.Корректировка
	|
	|ИМЕЮЩИЕ
	|    СУММА(ВТ_Документы.ВсегоПозиций) = СУММА(ВТ_Документы.ПозицийБезНДС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|    ВТ_ПодходящиеДокументы.Документ КАК Документ,
	|    ВТ_ПодходящиеДокументы.Исправление КАК Исправление,
	|    ВТ_ПодходящиеДокументы.Корректировка КАК Корректировка,
	|    ВТ_ПодходящиеДокументы.Документ.Проведен КАК Проведен,
	|    ВТ_ПодходящиеДокументы.Документ.Номер КАК НомерДокумента,
	|    ВТ_ПодходящиеДокументы.Документ.Дата КАК ДатаДокумента,
	|    ВТ_ПодходящиеДокументы.Документ.Контрагент КАК Контрагент,
	|    ВТ_ПодходящиеДокументы.Документ.Организация КАК Организация,
	|    ВТ_ПодходящиеДокументы.Документ.СуммаДокумента КАК СуммаДокумента
	|ПОМЕСТИТЬ ВТ_ДокументыБезНДС
	|ИЗ
	|    ВТ_ПодходящиеДокументы КАК ВТ_ПодходящиеДокументы
	|        ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|        ПО ВТ_ПодходящиеДокументы.Документ = СчетФактураВыданныйДокументыОснования.ДокументОснование
	|ГДЕ
	|    СчетФактураВыданныйДокументыОснования.Ссылка ЕСТЬ NULL";
	
	Возврат Результат;
	
КонецФункции         

Процедура ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(
	Запросы,
	ВидДокумента,
	ТабличнаяЧасть,
	Условие = "",
	Исправление = "Ложь",
	Корректировка = "Ложь")
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ВидДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ РазрешеноЧтениеТаблицы(МетаданныеДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Если МетаданныеДокумента.ТабличныеЧасти.Найти(ТабличнаяЧасть) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Документ,
	|	1 КАК ВсегоПозиций,
	|	ВЫБОР
	|		КОГДА ТабличнаяЧасть.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПозицийБезНДС,
	|	&Исправление КАК Исправление,
	|	&Корректировка КАК Корректировка
	|ИЗ
	|	&Таблица КАК ТабличнаяЧасть
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПолноеИмяДокумента КАК Т
	|		ПО ТабличнаяЧасть.Ссылка = Т.Ссылка
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода" + Условие;
	
	Документ = МетаданныеДокумента.ПолноеИмя();
	Таблица = Документ + "." + ТабличнаяЧасть;
	
	Результат = СтрЗаменить(Результат, "ПолноеИмяДокумента", Документ);
	Результат = СтрЗаменить(Результат, "&Таблица", Таблица);
	Результат = СтрЗаменить(Результат, "&Исправление", Исправление);
	Результат = СтрЗаменить(Результат, "&Корректировка", Корректировка);
	
	Если Метаданные.Справочники.Найти("СтавкиНДС") <> Неопределено Тогда
		Результат = СтрЗаменить(Результат, "Перечисление.СтавкиНДС", "Справочник.СтавкиНДС");
	КонецЕсли;
	
	Если Запросы.Количество() = 0 Тогда
		Результат = СтрЗаменить(Результат, "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
		Результат = СтрЗаменить(Результат, "ИЗ", "ПОМЕСТИТЬ ВТ_Документы ИЗ");
	КонецЕсли;
	
	Запросы.Добавить(Результат);
	
КонецПроцедуры

