КонецФункции

Функция ТекстЗапроса_СчетФактураЧерновики(ИмяВременнойТаблицы, ВидПакетаID, ВидСчетаФактуры)
	
	Если ЕстьПравоЧтенияЖурналаУчетаСчетовФактур() Тогда
		ТекстЗапроса = ТекстЗапроса_СчетФактураЧерновики_ПоРегистру();
	Иначе
		ТекстЗапроса = ТекстЗапроса_СчетФактураЧерновики_ПоДокументу();
	КонецЕсли;
	
	Если ЭтоИсправительныйВидПакета(ВидПакетаID) Тогда
		
		ВидИсправляемогоПакета = СтрЗаменить(ВидПакетаID, "ID_И", "ID_");
		Если ВидПакетаID = "ID_ИСФ" Тогда
			ВидИсправляемогоПакета = "ID_ОсновнойПакет";
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"ВТ_Настройки.ВидПакетаID = &ВидПакетаID",
		"ВТ_Настройки.ВидПакетаID = """ + ВидИсправляемогоПакета + """");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "НЕ Т.Исправление", "Т.Исправление");
		
	КонецЕсли;
	
	Если ВидСчетаФактуры = "Корректировочный" Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "НЕ Т.Корректировочный", "Т.Корректировочный");
		
	ИначеЕсли ВидСчетаФактуры = "НаАванс" Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.СчетФактураВыданный", "Документ.СчетФактураВыданныйАванс");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И НЕ Т.Корректировочный", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И НЕ Т.ДокументОснование ССЫЛКА Документ.ОтчетКомиссионера", "");
		
	КонецЕсли; // BSLLS:IfElseIfEndsWithElse-off
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПакетаID", """" + ВидПакетаID + """");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_СчетФактураЧерновики_ПоРегистру()
	
	Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Ссылка КАК Документ,
	|	Т.Номер КАК НомерДокумента,
	|	Т.Дата КАК ДатаДокумента,
	|	Т.Контрагент КАК Контрагент,
	|	Т.Организация КАК Организация,
	|	СУММА(ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуре, 0) + ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУвеличение, 0) - ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУменьшение, 0)) КАК СуммаДокумента,
	|	&ВидПакетаID КАК ВидПакетаID
	|ПОМЕСТИТЬ ИмяВременнойТаблицы
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НастройкиОрганизаций КАК ВТ_Настройки
	|		ПО Т.Организация = ВТ_Настройки.Организация1С
	|			И (ВТ_Настройки.ВидПакетаID = &ВидПакетаID)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Отправители КАК ВТ_Отправители
	|		ПО Т.Организация = ВТ_Отправители.Организация1С
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПартнерскиеОтношения КАК ВТ_Получатели
	|		ПО Т.Контрагент = ВТ_Получатели.Контрагент1С
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналУчетаСчетовФактур КАК ЖурналУчетаСчетовФактур
	|		ПО Т.Ссылка = ЖурналУчетаСчетовФактур.СчетФактура
	|			И ЖурналУчетаСчетовФактур.ЧастьЖурнала = Значение(Перечисление.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры)
	|ГДЕ
	|	Т.Проведен
	|	И Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ВТ_Получатели.Контрагент1С ЕСТЬ NULL
	|	И НЕ ВТ_Отправители.Организация1С ЕСТЬ NULL
	|	И НЕ Т.Корректировочный
	|	И НЕ Т.Исправление
	|	И НЕ Т.ДокументОснование ССЫЛКА Документ.ОтчетКомиссионера
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Ссылка,
	|	Т.Номер,
	|	Т.Дата,
	|	Т.Контрагент,
	|	Т.Организация";
	
	Возврат Текст;
	
КонецФункции

