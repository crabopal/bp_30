Функция ТекстЗапроса_СчетФактураПоОтчетуКомиссионераЧерновики(ИмяВременнойТаблицы, ВидПакетаID)
	
	ТекстВТ = ТекстЗапроса_ВТ_СчетФактурыПоОтчетуКомиссионера();
	
	Если ЕстьПравоЧтенияЖурналаУчетаСчетовФактур() Тогда
		ТекстВыборки = ТекстЗапроса_СчетФактурыПоОтчетуКомиссионера_ПоРегистру();
	Иначе
		ТекстВыборки = ТекстЗапроса_СчетФактурыПоОтчетуКомиссионера_ПоДокументу();
	КонецЕсли;
	
	ТекстВыборки = СтрЗаменить(ТекстВыборки, "&ВидПакетаID", """" + ВидПакетаID + """");
	ТекстВыборки = СтрЗаменить(ТекстВыборки, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	
	ПолныйТекст = ТекстВТ 
	+ Символы.ПС + ";" + Символы.ПС 
	+ ТекстВыборки 
	+ Символы.ПС + ";" + Символы.ПС 
	+ "УНИЧТОЖИТЬ ВТ_СчетФактурыПоОтчетуКомиссионера";
	
	Возврат ПолныйТекст;
	
КонецФункции

