//  Ссылка - Строка, ЛюбаяСсылка - адрес гиперссылки.
//
Процедура ДобавитьОшибкуВалидации(Ошибки, ТекстОшибки, Ссылка = "")
	
	НоваяОшибка = Новый_ОшибкаВалидации(ТекстОшибки, Ссылка);
	Ошибки.Добавить(НоваяОшибка);
	
КонецПроцедуры

