//{		УКД29

Процедура ЗаполнитьСведенияОМаркировкеУКД29_КонтурМаркировка(Контент)
	
	ПроверитьПодсистемуКонтурМаркировка();
	
	ИсходныеДокументыПередачи = Новый Массив;
	ПередаточныеДокументы = Неопределено;
	ИсправляемыеДокументы = Неопределено;
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если Контент.СлужебнаяИнформация.Свойство("ИсправляемыеДокументы", ИсправляемыеДокументы)
		И ЗначениеЗаполнено(ИсправляемыеДокументы) Тогда
		ИсходныеДокументыПередачи = ИсправляемыеДокументы;
	ИначеЕсли Контент.СлужебнаяИнформация.Свойство("ПередаточныеДокументы", ПередаточныеДокументы)
		И ЗначениеЗаполнено(ПередаточныеДокументы) Тогда 
		ИсходныеДокументыПередачи = ПередаточныеДокументы;
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
	НесколькоДокументовПередачи = 2;
	
	Если КонтурМаркировкаПоддерживаетКорректировочныеДокументы() Тогда
		
		ЗаполнитьСведенияОМаркировкеУКД29_КонтурМаркировкаПоддерживаетКорректировочныеДокументы(Контент);
		
	ИначеЕсли ИспользуетсяКонтурМаркировка33()
		И ИсходныеДокументыПередачи.Количество() < НесколькоДокументовПередачи Тогда
		
		ЗаполнитьСведенияОМаркировкеУКД29_КонтурМаркировка33(Контент, ИсходныеДокументыПередачи);
		
	Иначе
		
		РазвернутаяТаблицаУпаковок = Новый_РазвернутаяТаблицаУпаковок();
		РазвернутаяТаблицаУпаковокДоИзменения = Новый_РазвернутаяТаблицаУпаковок();
		ОшибкиЗаполнения = Новый Массив;
		
		ДокументыПередачи = ВладельцыКодовМаркировки(Контент.InvoiceCorrectionTable.Items);
		
		КонтурМаркировка_ЗаполнитьРазвернутуюТаблицуКодов(РазвернутаяТаблицаУпаковок, ДокументыПередачи, ОшибкиЗаполнения);
		ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
		
		Если ИсходныеДокументыПередачи.Количество() > 0 Тогда
			
			КонтурМаркировка_ЗаполнитьРазвернутуюТаблицуКодов(
				РазвернутаяТаблицаУпаковокДоИзменения,
				ИсходныеДокументыПередачи,
				ОшибкиЗаполнения
			);
			ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
			
		КонецЕсли;
		
		ЗаполнитьСведенияОМаркировкеВКонтентеУКД29_КонтурМаркировка(
			Контент,
			ДокументыПередачи,
			РазвернутаяТаблицаУпаковок,
			РазвернутаяТаблицаУпаковокДоИзменения
		);
		ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_КонтурМаркировка(
			Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
			РазвернутаяТаблицаУпаковок
		);
		ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_КонтурМаркировка(
			Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
			РазвернутаяТаблицаУпаковокДоИзменения
		);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеУКД29_КонтурМаркировкаПоддерживаетКорректировочныеДокументы(Контент)
	
	РазвернутаяТаблицаУпаковок = Новый_РазвернутаяТаблицаУпаковок_КонтурМаркировкаПоддерживаетКорректировочныеДокументы();
	ОшибкиЗаполнения = Новый Массив;
	ТипыИзменений = Перечисление_ТипыИзмененийРазвернутойТаблицыУпаковок();
	
	ЗаполнитьРазвернутуюТаблицуУпаковокСТипомИзмененияИзКонтентаУКД29(
		РазвернутаяТаблицаУпаковок,
		Контент,
		ТипыИзменений.До
	);
	ЗаполнитьРазвернутуюТаблицуУпаковокСТипомИзмененияИзКонтентаУКД29(
		РазвернутаяТаблицаУпаковок,
		Контент,
		ТипыИзменений.После
	);
	
	КонтурМаркировка_ЗаполнитьСведенияОМаркировке(РазвернутаяТаблицаУпаковок, ОшибкиЗаполнения);
	ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
	
	ЗаполнитьСведенияОМаркировкеВКонтентеУКД29_КонтурМаркировкаПоддерживаетКорректировочныеДокументы(
		Контент,
		РазвернутаяТаблицаУпаковок
	);
	ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_КонтурМаркировка33(
		Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
		РазвернутаяТаблицаУпаковок
	);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеУКД29_КонтурМаркировка33(Контент, ИсходныеДокументыПередачи)
	
	РазвернутаяТаблицаУпаковок = Новый_РазвернутаяТаблицаУпаковок_КонтурМаркировка33();
	РазвернутаяТаблицаУпаковокДоИзменения = Новый_РазвернутаяТаблицаУпаковок_КонтурМаркировка33();
	ОшибкиЗаполнения = Новый Массив;
	
	ЗаполнитьРазвернутуюТаблицуУпаковокИзКонтентаУКД29(РазвернутаяТаблицаУпаковок, Контент, Неопределено);
	КонтурМаркировка_ЗаполнитьСведенияОМаркировке(РазвернутаяТаблицаУпаковок, ОшибкиЗаполнения);
	ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
	
	Если ИсходныеДокументыПередачи.Количество() > 0 Тогда
		
		ОшибкиЗаполненияДоИзменения = Новый Массив;
		
		ЗаполнитьРазвернутуюТаблицуУпаковокИзКонтентаУКД29(
			РазвернутаяТаблицаУпаковокДоИзменения,
			Контент,
			ИсходныеДокументыПередачи[0]
		);
		КонтурМаркировка_ЗаполнитьСведенияОМаркировке(РазвернутаяТаблицаУпаковокДоИзменения, ОшибкиЗаполненияДоИзменения);
		ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполненияДоИзменения);
		
	КонецЕсли;
	
	ЗаполнитьСведенияОМаркировкеВКонтентеУКД29_КонтурМаркировка33(
		Контент,
		РазвернутаяТаблицаУпаковок,
		РазвернутаяТаблицаУпаковокДоИзменения
	);
	ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_КонтурМаркировка33(
		Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
		РазвернутаяТаблицаУпаковок
	);
	ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_КонтурМаркировка33(
		Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
		РазвернутаяТаблицаУпаковокДоИзменения
	);
	
КонецПроцедуры

Процедура ЗаполнитьРазвернутуюТаблицуУпаковокСТипомИзмененияИзКонтентаУКД29(
	РазвернутаяТаблицаУпаковок,
	Контент,
	ТипИзменения)
	
	ТипИзмененияДо = Перечисление_ТипыИзмененийРазвернутойТаблицыУпаковок().До;
	НомерСтроки = 0;
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		СлужебнаяИнформацияСтрокиТЧ = СтрокаТЧ.СлужебнаяИнформация;
		
		Если ТипИзменения = ТипИзмененияДо Тогда
			КоличествоПоСтроке = ПривестиКЧислуЛок(СтрокаТЧ["OriginalValues"].Quantity);
		Иначе
			КоличествоПоСтроке = ПривестиКЧислуЛок(СтрокаТЧ["CorrectedValues"].Quantity);
		КонецЕсли;
		
		Если КоличествоПоСтроке = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицыУпаковок = РазвернутаяТаблицаУпаковок.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыУпаковок, СлужебнаяИнформацияСтрокиТЧ);
		
		СтрокаТаблицыУпаковок.ИндексСтроки = НомерСтроки;
		СтрокаТаблицыУпаковок.Количество = КоличествоПоСтроке;
		СтрокаТаблицыУпаковок.ПервичныйДокумент = СлужебнаяИнформацияСтрокиТЧ.ДокументОтгрузки;
		СтрокаТаблицыУпаковок.ТипИзменения = ТипИзменения;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРазвернутуюТаблицуУпаковокИзКонтентаУКД29(
	РазвернутаяТаблицаУпаковок,
	Контент,
	ИсходныйДокумент)
	
	ЭтоУКДНаОснованииВозвратаОтКлиента = СвойствоСтруктуры(
		Контент.СлужебнаяИнформация,
		"ЭтоУКДНаОснованииВозвратаОтКлиента",
		Ложь
	);
	НомерСтроки = 0;
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		СлужебнаяИнформацияСтрокиТЧ = СтрокаТЧ.СлужебнаяИнформация;
		
		Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда
			КоличествоПоСтроке = ПривестиКЧислуЛок(СтрокаТЧ["OriginalValues"].Quantity);
			ПервичныйДокумент = ИсходныйДокумент;
		ИначеЕсли ЭтоУКДНаОснованииВозвратаОтКлиента Тогда
			КоличествоПоСтроке = ПривестиКЧислуЛок(СтрокаТЧ["OriginalValues"].Quantity)
				- ПривестиКЧислуЛок(СтрокаТЧ["CorrectedValues"].Quantity);
			ПервичныйДокумент = СлужебнаяИнформацияСтрокиТЧ.ДокументОтгрузки;
		Иначе
			КоличествоПоСтроке = ПривестиКЧислуЛок(СтрокаТЧ["CorrectedValues"].Quantity);
			ПервичныйДокумент = СлужебнаяИнформацияСтрокиТЧ.ДокументОтгрузки;
		КонецЕсли;
		
		Если КоличествоПоСтроке = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицыУпаковок = РазвернутаяТаблицаУпаковок.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыУпаковок, СлужебнаяИнформацияСтрокиТЧ);
		
		СтрокаТаблицыУпаковок.ИндексСтроки = НомерСтроки;
		СтрокаТаблицыУпаковок.Количество = КоличествоПоСтроке;
		СтрокаТаблицыУпаковок.ПервичныйДокумент = ПервичныйДокумент;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтентеУКД29_КонтурМаркировкаПоддерживаетКорректировочныеДокументы(
	Контент,
	РазвернутаяТаблицаУпаковок)
	
	ОтборПоНомеру = Новый Структура("ИндексСтроки", 0);
	ТипыИзменений = Перечисление_ТипыИзмененийРазвернутойТаблицыУпаковок();
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
		
		СведенияОМаркировке = Неопределено;
		СведенияОМаркировкеДоИзменения = Неопределено;
		
		ОтборПоНомеру.ИндексСтроки = ОтборПоНомеру.ИндексСтроки + 1;
		
		СтрокиТаблицыУпаковок = РазвернутаяТаблицаУпаковок.НайтиСтроки(ОтборПоНомеру);
		
		Для ИндексЭлементаМассива = 0 По СтрокиТаблицыУпаковок.ВГраница() Цикл
			СтрокаТаблицыУпаковок = СтрокиТаблицыУпаковок[ИндексЭлементаМассива];
			
			// BSLLS:IfElseIfEndsWithElse-off
			Если СтрокаТаблицыУпаковок.ТипИзменения = ТипыИзменений.До Тогда
				СведенияОМаркировкеДоИзменения = СтрокаТаблицыУпаковок.СведенияОМаркировке;
			ИначеЕсли СтрокаТаблицыУпаковок.ТипИзменения = ТипыИзменений.После Тогда
				СведенияОМаркировке = СтрокаТаблицыУпаковок.СведенияОМаркировке;
			КонецЕсли;
			// BSLLS:IfElseIfEndsWithElse-on
			
		КонецЦикла;
		
		КодыМаркировки = КодыМаркировкиДляКонтентаУКД29ПоДаннымКонтурМаркировки(СведенияОМаркировке);
		ЗаполнитьКодыМаркировкиНесколькихПартийВСтрокеКонтентаУКД29(
			СтрокаТЧ.CorrectedItemIdentificationNumbers,
			КодыМаркировки
		);
		
		КодыМаркировкиДоИзменения = КодыМаркировкиДляКонтентаУКД29ПоДаннымКонтурМаркировки(СведенияОМаркировкеДоИзменения);
		ЗаполнитьКодыМаркировкиНесколькихПартийВСтрокеКонтентаУКД29(
			СтрокаТЧ.OriginalItemIdentificationNumbers,
			КодыМаркировкиДоИзменения
		);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтентеУКД29_КонтурМаркировка33(
	Контент,
	РазвернутаяТаблицаУпаковок,
	РазвернутаяТаблицаУпаковокДоИзменения)
	
	ЭтоУКДНаОснованииВозвратаОтКлиента = СвойствоСтруктуры(
		Контент.СлужебнаяИнформация,
		"ЭтоУКДНаОснованииВозвратаОтКлиента",
		Ложь
	);
	НомерСтроки = 1;
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
		
		СтрокаТаблицыУпаковок = РазвернутаяТаблицаУпаковок.Найти(НомерСтроки, "ИндексСтроки");
		
		Если СтрокаТаблицыУпаковок <> Неопределено Тогда
			СведенияОМаркировке = СтрокаТаблицыУпаковок.СведенияОМаркировке;
		Иначе
			СведенияОМаркировке = Неопределено;
		КонецЕсли;
		
		СтрокаТаблицыУпаковокДоИзменения = РазвернутаяТаблицаУпаковокДоИзменения.Найти(НомерСтроки, "ИндексСтроки");
		
		Если СтрокаТаблицыУпаковокДоИзменения <> Неопределено Тогда
			СведенияОМаркировкеДоИзменения = СтрокаТаблицыУпаковокДоИзменения.СведенияОМаркировке;
		Иначе
			СведенияОМаркировкеДоИзменения = Неопределено;
		КонецЕсли;
		
		Если ЭтоУКДНаОснованииВозвратаОтКлиента Тогда
			СведенияОМаркировкеПослеИзменения = СведенияОМаркировкеПередаваемыеПослеВозврата(
				СведенияОМаркировке,
				СведенияОМаркировкеДоИзменения
			);
		Иначе
			СведенияОМаркировкеПослеИзменения = СведенияОМаркировке;
		КонецЕсли;
		
		КодыМаркировки = КодыМаркировкиДляКонтентаУКД29ПоДаннымКонтурМаркировки(СведенияОМаркировкеПослеИзменения);
		ЗаполнитьКодыМаркировкиНесколькихПартийВСтрокеКонтентаУКД29(
			СтрокаТЧ.CorrectedItemIdentificationNumbers,
			КодыМаркировки
		);
		
		КодыМаркировкиДоИзменения = КодыМаркировкиДляКонтентаУКД29ПоДаннымКонтурМаркировки(СведенияОМаркировкеДоИзменения);
		ЗаполнитьКодыМаркировкиНесколькихПартийВСтрокеКонтентаУКД29(
			СтрокаТЧ.OriginalItemIdentificationNumbers,
			КодыМаркировкиДоИзменения
		);
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off

Процедура ЗаполнитьСведенияОМаркировкеВКонтентеУКД29_КонтурМаркировка(
	Контент,
	ДокументыПередачи,
	РазвернутаяТаблицаУпаковок,
	РазвернутаяТаблицаУпаковокДоИзменения)
	
	ЭтоУКДНаОснованииВозвратаОтКлиента = СвойствоСтруктуры(
		Контент.СлужебнаяИнформация,
		"ЭтоУКДНаОснованииВозвратаОтКлиента",
		Ложь
	);
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
		
		ТребуемоеКоличество = СтрокаТЧ.OriginalValues.Quantity;
		
		Если ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			
			КодыМаркировки = Новый_СведенияОМаркировке();
			
			ПодобратьКодыМаркировки(
				КодыМаркировки,
				РазвернутаяТаблицаУпаковокДоИзменения,
				СтрокаТЧ.СлужебнаяИнформация,
				ТребуемоеКоличество
			);
			
			ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(СтрокаТЧ.OriginalItemIdentificationNumbers, КодыМаркировки);
			
		КонецЕсли;
		
		ЭтоПолныйВозвратТовара = ЭтоПолныйВозвратТовара(СтрокаТЧ);
		
		Если ЭтоУКДНаОснованииВозвратаОтКлиента Тогда
			
			Если ЭтоПолныйВозвратТовара Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьКодыМаркировкиДляВозвратаОтКлиента(
				СтрокаТЧ,
				РазвернутаяТаблицаУпаковок,
				РазвернутаяТаблицаУпаковокДоИзменения
			);
			
		Иначе
			
			ТребуемоеКоличество = СтрокаТЧ.CorrectedValues.Quantity;
			ТребуемоеКоличество = ?(ТребуемоеКоличество = Неопределено, 0, ТребуемоеКоличество);
			
			Если ЗначениеЗаполнено(ТребуемоеКоличество) ИЛИ ЭтоПолныйВозвратТовара Тогда
				
				КодыМаркировки = Новый_СведенияОМаркировке();
				
				ПодобратьКодыМаркировки(
					КодыМаркировки,
					РазвернутаяТаблицаУпаковок,
					СтрокаТЧ.СлужебнаяИнформация,
					ТребуемоеКоличество,
					ЭтоПолныйВозвратТовара
				);
				
				ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(СтрокаТЧ.CorrectedItemIdentificationNumbers, КодыМаркировки);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
// BSLLS:CognitiveComplexity-on

Процедура ЗаполнитьКодыМаркировкиНесколькихПартийВСтрокеКонтентаУКД29(ItemIdentificationNumbers, СведенияОМаркировке)
	
	Для Каждого СведенияОПартииМаркировки Из СведенияОМаркировке Цикл
		
		ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(ItemIdentificationNumbers, СведенияОПартииМаркировки);
		
	КонецЦикла;
	
КонецПроцедуры


// BSLLS:CognitiveComplexity-off

Функция КодыМаркировкиДляКонтентаУКД29ПоДаннымКонтурМаркировки(ДанныеКонтурМаркировки)
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ДанныеКонтурМаркировки) Тогда
		Возврат Результат;
	КонецЕсли;
	
	КонтурМаркировкаПоддерживаетВесВПартиях = КонтурМаркировкаПоддерживаетВесВПартиях();
	
	ВидыУпаковокКМ = Перечисления.КонтурМаркировка_ВидыУпаковок;
	УпаковкаГрупповая = ВидыУпаковокКМ.Групповая;
	УпаковкаЛогистическая = ВидыУпаковокКМ.Логистическая;
	УпаковкаОбъемноСортовойУчет = ВидыУпаковокКМ.ОбъемноСортовойУчет;
	
	Если КонтурМаркировкаПоддерживаетВесВПартиях Тогда
		УпаковкаПартионныйУчет = ВидыУпаковокКМ.ПартионныйУчет;
	Иначе
		УпаковкаПартионныйУчет = Неопределено;
	КонецЕсли;
	
	ДобавитьКолонкуПартииВСведенияОМаркировке(ДанныеКонтурМаркировки);
	ДобавитьКолонкуПеременнаяХарактеристикаВСведенияОМаркировке(ДанныеКонтурМаркировки);
	
	СведенияОМаркировкеВРазрезеПартий = Новый Соответствие();
	
	Для Каждого СтрокаДанныхКМ Из ДанныеКонтурМаркировки Цикл
		
		ВидУпаковки = СтрокаДанныхКМ.ВидУпаковки;
		ЗначениеШК = СтрокаДанныхКМ.ЗначениеШтрихкода;
		НомерПартии = СтрокаДанныхКМ.НомерПартии;
		
		Если ЗначениеЗаполнено(НомерПартии) Тогда
			НомерПартииКлюч = НомерПартии;
		ИначеЕсли ВидУпаковки = УпаковкаОбъемноСортовойУчет Тогда
			НомерПартииКлюч = ЗначениеШК;
		Иначе
			НомерПартииКлюч = "БезПартии";
		КонецЕсли;
		
		СведенияОМаркировке = СведенияОМаркировкеВРазрезеПартий.Получить(НомерПартииКлюч);
		
		Если СведенияОМаркировке = Неопределено Тогда
			СведенияОМаркировке = Новый_СведенияОМаркировке();
			СведенияОМаркировке.НомерПартии = НомерПартии;
			
			СведенияОМаркировкеВРазрезеПартий.Вставить(НомерПартииКлюч, СведенияОМаркировке);
		КонецЕсли;
		
		Если ВидУпаковки = УпаковкаЛогистическая Тогда
			
			СведенияОМаркировке.ТранспортныеУпаковки.Добавить(ЗначениеШК);
			
		ИначеЕсли ВидУпаковки = УпаковкаГрупповая Тогда
			
			СведенияОМаркировке.ИндивидуальныеУпаковки.Добавить(ЗначениеШК);
			
		ИначеЕсли ВидУпаковки = УпаковкаОбъемноСортовойУчет Тогда
			
			СведенияОМаркировке.ГТИН = СтрокаДанныхКМ.GTIN;
			СведенияОМаркировке.КоличествоТовараВУпаковке = СтрокаДанныхКМ.КоличествоУпаковок;
			
		ИначеЕсли ВидУпаковки = УпаковкаПартионныйУчет Тогда
			
			СведенияОМаркировке.ГТИН = СтрокаДанныхКМ.GTIN;
			СведенияОМаркировке.КоличествоТовараВУпаковке = СтрокаДанныхКМ.КоличествоУпаковок ;
			СведенияОМаркировке.ВесТовара = ПривестиВесТовараКФормату(СтрокаДанныхКМ.Количество);
			
		Иначе
			СведенияОМаркировке.КонтрольныеИдентификационныеЗнаки.Добавить(ЗначениеШК);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СведенияОМаркировкеПартии Из СведенияОМаркировкеВРазрезеПартий Цикл
		Результат.Добавить(СведенияОМаркировкеПартии.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
