Функция ЕстьШтрихкодыУпаковокИСМП(ОбъектМетаданных)
	
	Результат = (ОбъектМетаданных.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") <> Неопределено);
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяРасширеннаяВерсияГосИС()
	
	Попытка
		ИнтерфейсБСП = ОбщийМодульПоИмениЛок("ОбщегоНазначения");
		Результат = ИнтерфейсБСП.ПодсистемаСуществует("ГосИС.БазоваяФункциональность.Расширенная");
	Исключение
		Результат = Ложь;
	КонецПопытки;
	
