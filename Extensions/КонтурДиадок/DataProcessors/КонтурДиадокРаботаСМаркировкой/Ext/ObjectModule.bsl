//{		СВЕДЕНИЯ О МАРКИРОВКЕ КОНТУР МАРКИРОВКА

//{		УПД970

Процедура ЗаполнитьСведенияОМаркировке970_КонтурМаркировка(Контент)
	
	ПроверитьПодсистемуКонтурМаркировка();
	
	Если ИспользуетсяКонтурМаркировка33() Тогда
		
		РазвернутаяТаблицаУпаковок = Новый_РазвернутаяТаблицаУпаковок_КонтурМаркировка33();
		ОшибкиЗаполнения = Новый Массив;
		
		ЗаполнитьРазвернутуюТаблицуУпаковокИзКонтента970(РазвернутаяТаблицаУпаковок, Контент);
		КонтурМаркировка_ЗаполнитьСведенияОМаркировке(РазвернутаяТаблицаУпаковок, ОшибкиЗаполнения);
		ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
		
		ЗаполнитьСведенияОМаркировкеВКонтенте970_КонтурМаркировка33(Контент, РазвернутаяТаблицаУпаковок);
		ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_КонтурМаркировка33(
			Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
			РазвернутаяТаблицаУпаковок
		);
		
	Иначе
		
		РазвернутаяТаблицаУпаковок = Новый_РазвернутаяТаблицаУпаковок();
		ДокументыПередачи = ВладельцыКодовМаркировки(Контент.Table.Items);
		ОшибкиЗаполнения = Новый Массив;
		
		КонтурМаркировка_ЗаполнитьРазвернутуюТаблицуКодов(РазвернутаяТаблицаУпаковок, ДокументыПередачи, ОшибкиЗаполнения);
		ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
		
		ЗаполнитьСведенияОМаркировкеВКонтенте970(Контент, РазвернутаяТаблицаУпаковок);
		ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_КонтурМаркировка(
			Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
			РазвернутаяТаблицаУпаковок
		);
		
	КонецЕсли;
	
КонецПроцедуры


Процедура ЗаполнитьРазвернутуюТаблицуУпаковокИзКонтента970(РазвернутаяТаблицаУпаковок, Контент)
	
	НомерСтроки = 1;
	
	Для Каждого СтрокаТЧ Из Контент.Table.Items Цикл
		
		СлужебнаяИнформацияСтрокиТЧ = СтрокаТЧ.СлужебнаяИнформация;
		
		СтрокаТаблицыУпаковок = РазвернутаяТаблицаУпаковок.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыУпаковок, СлужебнаяИнформацияСтрокиТЧ);
		
		СтрокаТаблицыУпаковок.ИндексСтроки = НомерСтроки;
		СтрокаТаблицыУпаковок.Количество = СтрокаТЧ.Quantity;
		СтрокаТаблицыУпаковок.ПервичныйДокумент = СлужебнаяИнформацияСтрокиТЧ.ДокументОтгрузки;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтенте970_КонтурМаркировка33(Контент, РазвернутаяТаблицаУпаковок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДляОбработкиСведенийОМаркировке();
	
	НомерСтроки = 1;
	
	Для Каждого СтрокаКонтента Из Контент.Table.Items Цикл
		
		СтрокаТаблицы = РазвернутаяТаблицаУпаковок.Найти(НомерСтроки, "ИндексСтроки");
		СведенияОМаркировке = СтрокаТаблицы.СведенияОМаркировке;
		
		НомерСтроки = НомерСтроки + 1;
		
		Если СведенияОМаркировке.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьКолонкуПартииВСведенияОМаркировке(СведенияОМаркировке);
		
		СведенияОМаркировкеДляСтрокиКонтента = Новый Массив;
		
		Запрос.УстановитьПараметр("СведенияОМаркировке", СведенияОМаркировке);
		
		ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
		РезультатПоПартиям = ПакетРезультатовЗапроса[1];
		РезультатПоGTIN = ПакетРезультатовЗапроса[2];
		
		ВыборкаПоGTIN = РезультатПоGTIN.Выбрать();
		НесколькоGTINДляСтрокиДокумента = ВыборкаПоGTIN.Количество() > 1;
		
		ИтогиПоПартиям = РезультатПоПартиям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ИтогиПоПартиям.Следующий() Цикл
			
			СведенияОПартииМаркировки = Новый_СведенияОМаркировке();
			СведенияОПартииМаркировки.НомерПартии = ИтогиПоПартиям.НомерПартии;
			
			ЗаполнитьСведенияОПартииКодамиМаркировкиДляУПД970(
				СведенияОПартииМаркировки,
				ИтогиПоПартиям,
				НесколькоGTINДляСтрокиДокумента
			);
			
			СведенияОМаркировкеДляСтрокиКонтента.Добавить(СведенияОПартииМаркировки);
			
		КонецЦикла;
		
		ЗаполнитьКодыМаркировкиНесколькихПартийВСтрокеКонтента970(СтрокаКонтента, СведенияОМаркировкеДляСтрокиКонтента);
		
	КонецЦикла;
	
КонецПроцедуры

// Переносит коды маркировки в строку контента.
//
// Параметры:
//  СтрокаКонтента - Структура - содержит объект Item970 (см. МодульИнтеграции.Контракт_Item970())
//  СведенияОМаркировке - Массив - содержит коллекции кодов маркировки (см. Новый_СведенияОМаркировке)
//
Процедура ЗаполнитьКодыМаркировкиНесколькихПартийВСтрокеКонтента970(СтрокаКонтента, СведенияОМаркировке)
	
	Для Каждого СведенияОПартииМаркировки Из СведенияОМаркировке Цикл
		
		ЗаполнитьКодыМаркировкиВСтрокеКонтента970(СтрокаКонтента, СведенияОПартииМаркировки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОПартииКодамиМаркировкиДляУПД970(
	СведенияОПартииМаркировки,
	ИтогиПоПартиям,
	НесколькоGTINДляСтрокиДокумента)
	
	КонтурМаркировкаПоддерживаетВесВПартиях = КонтурМаркировкаПоддерживаетВесВПартиях();
	
	ВидыУпаковокКМ = Перечисления.КонтурМаркировка_ВидыУпаковок;
	УпаковкаГрупповая = ВидыУпаковокКМ.Групповая;
	УпаковкаЛогистическая = ВидыУпаковокКМ.Логистическая;
	УпаковкаОбъемноСортовойУчет = ВидыУпаковокКМ.ОбъемноСортовойУчет;
	
	Если КонтурМаркировкаПоддерживаетВесВПартиях Тогда
		УпаковкаПартионныйУчет = ВидыУпаковокКМ.ПартионныйУчет;
	Иначе
		УпаковкаПартионныйУчет = Неопределено;
	КонецЕсли;
	
	ПараметрыЗаполненияОСУИзКонтурМаркировки = Новый Структура;
	ПараметрыЗаполненияОСУИзКонтурМаркировки.Вставить("ПеременнаяХарактеристика", "");
	ПараметрыЗаполненияОСУИзКонтурМаркировки.Вставить("НесколькоGTINДляСтрокиДокумента", НесколькоGTINДляСтрокиДокумента);
	ПараметрыЗаполненияОСУИзКонтурМаркировки.Вставить(
		"КонтурМаркировкаПоддерживаетВесВПартиях",
		КонтурМаркировкаПоддерживаетВесВПартиях
	);
	
	СведенияОМаркировке = ИтогиПоПартиям.Выбрать();
	
	Пока СведенияОМаркировке.Следующий() Цикл
		
		ВидУпаковки = СведенияОМаркировке.ВидУпаковки;
		ЗначениеШК = СведенияОМаркировке.ЗначениеШтрихкода;
		
		Если ВидУпаковки = УпаковкаЛогистическая Тогда
			
			СведенияОПартииМаркировки.ТранспортныеУпаковки.Добавить(ЗначениеШК);
			
		ИначеЕсли ВидУпаковки = УпаковкаГрупповая Тогда
			
			СведенияОПартииМаркировки.ИндивидуальныеУпаковки.Добавить(ЗначениеШК);
			
		ИначеЕсли ВидУпаковки = УпаковкаОбъемноСортовойУчет
			Или ВидУпаковки = УпаковкаПартионныйУчет Тогда
			
			ПараметрыЗаполненияОСУИзКонтурМаркировки.ПеременнаяХарактеристика = СведенияОМаркировке.ПеременнаяХарактеристика;
			
			ЗаполнитьСведенияОМаркировкеДанныеОСУИзКонтурМаркировкиДляУПД970(
				СведенияОПартииМаркировки,
				СведенияОМаркировке,
				ПараметрыЗаполненияОСУИзКонтурМаркировки
			);
		Иначе
			СведенияОПартииМаркировки.КонтрольныеИдентификационныеЗнаки.Добавить(ЗначениеШК);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеДанныеОСУИзКонтурМаркировкиДляУПД970(
	СведенияОМаркировке,
	ДанныеКонтурМаркировки,
	ПараметрыЗаполненияОСУИзКонтурМаркировки)
	
	Если ПараметрыЗаполненияОСУИзКонтурМаркировки.ПеременнаяХарактеристика = "Вес" Тогда
		
		КодОСУСВесом = СформироватьКодОСУСВесом_КонтурМаркировка(ДанныеКонтурМаркировки);
		СведенияОМаркировке.ИндивидуальныеУпаковки.Добавить(КодОСУСВесом);
		
	ИначеЕсли ПараметрыЗаполненияОСУИзКонтурМаркировки.НесколькоGTINДляСтрокиДокумента Тогда
		
		СведенияОМаркировке.ИндивидуальныеУпаковки.Добавить(ДанныеКонтурМаркировки.ЗначениеШтрихкода);
		
	Иначе
		
		СведенияОМаркировке.ГТИН = ДанныеКонтурМаркировки.GTIN;
		
		Если ПараметрыЗаполненияОСУИзКонтурМаркировки.КонтурМаркировкаПоддерживаетВесВПартиях Тогда
			СведенияОМаркировке.КоличествоТовараВУпаковке = ДанныеКонтурМаркировки.КоличествоУпаковок;
		Иначе
			СведенияОМаркировке.КоличествоТовараВУпаковке = ДанныеКонтурМаркировки.Количество;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

