Процедура ЗаполнитьСведенияОМаркировке970_ИСМП(Контент)
	
	Если НЕ ЕстьИнтеграцияИСМП() Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыПередачи = ВладельцыКодовМаркировки(Контент.Table.Items);
	ТаблицаУпаковок = ТаблицаУпаковокИСМП(ДокументыПередачи);
	
	Если Не ЗначениеЗаполнено(ТаблицаУпаковок) Тогда
		Возврат;
	КонецЕсли;
	
	НовыйВариантОпределенияПризнаковМаркируемыхТоваров = Ложь;
	
	Если ИспользуетсяИнтеграцияИСМП_ПартионныйУчет() Тогда
		
		РазвернутаяТаблицаУпаковок = Новый_РазвернутаяТаблицаУпаковок_ИСМП_ПартионныйУчет();
		ТаблицаТоваров = ТаблицаТоваровИСМП(Контент.Table.Items);
		ДанныеШтрихкодовУпаковок = ИСМП_ЧастичноеСодержимоеИКодыОСУ(ТаблицаУпаковок, ТаблицаТоваров, ДокументыПередачи);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП_Ред12(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		ЗаполнитьСведенияОМаркировкеВКонтенте970_ИСМП_ПартионныйУчет(Контент, РазвернутаяТаблицаУпаковок);
		
		НовыйВариантОпределенияПризнаковМаркируемыхТоваров = Истина;
		
	ИначеЕсли ИспользуетсяИнтеграцияИСМП1104() Тогда
		
		РазвернутаяТаблицаУпаковок = Новый_РазвернутаяТаблицаУпаковок_ИСМП_Ред12();
		ТаблицаТоваров = ТаблицаТоваровИСМП(Контент.Table.Items);
		ДанныеШтрихкодовУпаковок = ИСМП_ЧастичноеСодержимоеИКодыОСУ(ТаблицаУпаковок, ТаблицаТоваров, ДокументыПередачи);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП_Ред12(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		ЗаполнитьСведенияОМаркировкеВКонтенте970_ИСМП10127(Контент, РазвернутаяТаблицаУпаковок);
		
		НовыйВариантОпределенияПризнаковМаркируемыхТоваров = Истина;
		
	ИначеЕсли ИспользуетсяИнтеграцияИСМП10127() Тогда
		
		РазвернутаяТаблицаУпаковок = Новый_РазвернутаяТаблицаУпаковок_ИСМП10127();
		ТаблицаТоваров = ТаблицаТоваровИСМП(Контент.Table.Items);
		ДанныеШтрихкодовУпаковок = ИСМП_ЧастичноеСодержимоеИКодыОСУ(ТаблицаУпаковок, ТаблицаТоваров, ДокументыПередачи);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		ЗаполнитьСведенияОМаркировкеВКонтенте970_ИСМП10127(Контент, РазвернутаяТаблицаУпаковок);
		
	Иначе
		
		РазвернутаяТаблицаУпаковок = Новый_РазвернутаяТаблицаУпаковок();
		ДанныеШтрихкодовУпаковок = ИСМП_ЧастичноеСодержимое(ТаблицаУпаковок);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		ЗаполнитьСведенияОМаркировкеВКонтенте970(Контент, РазвернутаяТаблицаУпаковок);
		
	КонецЕсли;
	
	ЕстьМаркировка = ЕстьКодыМаркировки970(Контент);
	
	Если НовыйВариантОпределенияПризнаковМаркируемыхТоваров Тогда
		
		ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_ИСМП_Ред12(
			Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
			РазвернутаяТаблицаУпаковок,
			ЕстьМаркировка
		);
		
	Иначе
		
		ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_ИСМП(
			Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
			РазвернутаяТаблицаУпаковок,
			ЕстьМаркировка
		);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтенте970_ИСМП_ПартионныйУчет(Контент, РазвернутаяТаблицаУпаковок)
	
	Для Каждого СтрокаКонтента Из Контент.Table.Items Цикл
		
		ТребуемоеКоличество = СтрокаКонтента.Quantity;
		
		Если Не ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			Продолжить;
		КонецЕсли;
		
		КодыМаркировки = ПодобратьКодыМаркировки_ИСМП_ПартионныйУчет(
			РазвернутаяТаблицаУпаковок,
			СтрокаКонтента.СлужебнаяИнформация,
			ТребуемоеКоличество
		);
		
		Для Каждого Элемент Из КодыМаркировки Цикл
			ЗаполнитьКодыМаркировкиВСтрокеКонтента970(СтрокаКонтента, Элемент);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

