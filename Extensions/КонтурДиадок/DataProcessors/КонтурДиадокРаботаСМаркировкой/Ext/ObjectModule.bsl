Процедура ЗаполнитьКодыМаркировкиДляВозвратаОтКлиента_ИСМП_ПартионныйУчет(СтрокаТЧ, ДанныеШтрихкодовУпаковок)
	
	Если ВозвращаетсяКодОСУИлиПартионный(ДанныеШтрихкодовУпаковок) Тогда
		
		ТребуемоеКоличество = СтрокаТЧ.CorrectedValues.Quantity;
		Если ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			
			// Найти подходящие кодами маркировки
			КодыМаркировки = ПодобратьКодыМаркировки_ИСМП_ПартионныйУчет(
				ДанныеШтрихкодовУпаковок,
				СтрокаТЧ.СлужебнаяИнформация,
				ТребуемоеКоличество
			);
			
			// Перенести найденные коды маркировки в строку протоконтента
			Для Каждого Элемент Из КодыМаркировки Цикл
				ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(СтрокаТЧ.CorrectedItemIdentificationNumbers, Элемент);
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		СтрокаТЧ.OriginalItemIdentificationNumbers = Новый Массив;
		
		КодыМаркировки = ПодобратьКодыМаркировки_ИСМП_ПартионныйУчет(
			ДанныеШтрихкодовУпаковок,
			СтрокаТЧ.СлужебнаяИнформация,
			СтрокаТЧ.OriginalValues.Quantity
		);
		
		Для Каждого Элемент Из КодыМаркировки Цикл
			ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(СтрокаТЧ.OriginalItemIdentificationNumbers, Элемент);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКодыМаркировкиДляВозвратаОтКлиента_ИСМП10127(
	СтрокаТЧ,
	ДанныеШтрихкодовУпаковок,
	ДанныеШтрихкодовУпаковокДоИзменения)
	
	Если ВозвращаетсяКодОСУИлиПартионный(ДанныеШтрихкодовУпаковок) Тогда
		
		ДанныеШтрихкодовУпаковокИнверсия = ДанныеШтрихкодовУпаковокДоИзменения.Скопировать();
		// колонка "ссылка" теперь указывает не на возврат, а на корректируемый документ!
		ДанныеШтрихкодовУпаковокИнверсия.ЗаполнитьЗначения(Ложь, "Обработан");
		
		ЗаполнитьДанныеШтрихкодовУпаковокИнверсией(ДанныеШтрихкодовУпаковок, ДанныеШтрихкодовУпаковокИнверсия);
		
		ТребуемоеКоличество = СтрокаТЧ.CorrectedValues.Quantity;
		
		Если ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			
			// Инициализировать промежуточную структуру с коллекциями кодов маркировки
			КодыМаркировки = Новый_СведенияОМаркировке();
			
			// Найти подходящие кодами маркировки
			ПодобратьКодыМаркировки_ИСМП10127(
				КодыМаркировки,
				ДанныеШтрихкодовУпаковокИнверсия,
				СтрокаТЧ.СлужебнаяИнформация,
				ТребуемоеКоличество
			);
			
			// Перенести найденные коды маркировки в строку протоконтента
			ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(СтрокаТЧ.CorrectedItemIdentificationNumbers, КодыМаркировки);
			
		КонецЕсли;
		
	Иначе
		
		СтрокаТЧ.OriginalItemIdentificationNumbers = Новый Массив;
		
		КодыМаркировки = Новый_СведенияОМаркировке();
		
		ПодобратьКодыМаркировки_ИСМП10127(
			КодыМаркировки,
			ДанныеШтрихкодовУпаковок,
			СтрокаТЧ.СлужебнаяИнформация,
			СтрокаТЧ.OriginalValues.Quantity
		);
		ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(СтрокаТЧ.OriginalItemIdentificationNumbers, КодыМаркировки);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКодыМаркировкиДляВозвратаОтКлиента(
	СтрокаТЧ,
	ДанныеШтрихкодовУпаковок,
	ДанныеШтрихкодовУпаковокДоИзменения)
	
	ДанныеШтрихкодовУпаковокИнверсия = ДанныеШтрихкодовУпаковокДоИзменения.Скопировать();
	// колонка "ссылка" теперь указывает не на возврат, а на корректируемый документ!
	ДанныеШтрихкодовУпаковокИнверсия.ЗаполнитьЗначения(Ложь, "Обработан");
	
	ЗаполнитьДанныеШтрихкодовУпаковокИнверсией(ДанныеШтрихкодовУпаковок, ДанныеШтрихкодовУпаковокИнверсия);
	
	ТребуемоеКоличество = СтрокаТЧ.OriginalValues.Quantity - СтрокаТЧ.CorrectedValues.Quantity;
	
	Если ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
		
		// Инициализировать промежуточную структуру с коллекциями кодов маркировки
		КодыМаркировки = Новый_СведенияОМаркировке();
		
		// Найти подходящие кодами маркировки
		ПодобратьКодыМаркировки(
			КодыМаркировки,
			ДанныеШтрихкодовУпаковокИнверсия,
			СтрокаТЧ.СлужебнаяИнформация,
			ТребуемоеКоличество
		);
		
		// Перенести найденные коды маркировки в строку протоконтента
		ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(СтрокаТЧ.CorrectedItemIdentificationNumbers, КодыМаркировки);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеШтрихкодовУпаковокИнверсией(ДанныеШтрихкодовУпаковок, ДанныеШтрихкодовУпаковокИнверсия)
	
	Для Каждого СтрокаУпаковкиВозврата Из ДанныеШтрихкодовУпаковок Цикл
		
		Если ЭтоОбъемноСортовойИлиПартионныйУчет(СтрокаУпаковкиВозврата.ВидУпаковки) Тогда
			Продолжить;
		КонецЕсли;
		
		КлючиПараметровОтбора = "Номенклатура, Характеристика, Серия, ЗначениеШтрихкода,";
		КлючиПараметровОтбора = КлючиПараметровОтбора + "ВидУпаковки, ИспользоватьХарактеристики, ИспользоватьСерии";
		
		ПараметрыОтбора = Новый Структура(КлючиПараметровОтбора);
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаУпаковкиВозврата);
		
		УдаляемыеСтроки = ДанныеШтрихкодовУпаковокИнверсия.НайтиСтроки(ПараметрыОтбора);
		
		Пока УдаляемыеСтроки.Количество() > 0 Цикл
			
			УдаляемаяСтрока = УдаляемыеСтроки.Получить(0);
			
			ДанныеШтрихкодовУпаковокИнверсия.Удалить(УдаляемаяСтрока);
			
			УдаляемыеСтроки.Удалить(0);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВозвращаетсяКодОСУИлиПартионный(ДанныеШтрихкодовУпаковок)
	
	Результат = Ложь;
	
	Для Каждого СтрокаУпаковкиВозврата Из ДанныеШтрихкодовУпаковок Цикл
		Если ЭтоОбъемноСортовойИлиПартионныйУчет(СтрокаУпаковкиВозврата.ВидУпаковки) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоПолныйВозвратТовара(СтрокаТЧ)
	
	Результат = ЗначениеЗаполнено(СтрокаТЧ.OriginalValues.Quantity)
		И Не ЗначениеЗаполнено(СтрокаТЧ.CorrectedValues.Quantity);
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьКодыМаркировкиУКД29(Контент)
	
	ЕстьМаркировка = Ложь;
	
	Для Каждого СтрокаКонтента Из Контент.InvoiceCorrectionTable.Items Цикл
		
		Если СтрокаКонтента.OriginalItemIdentificationNumbers.Количество() > 0
			Или СтрокаКонтента.CorrectedItemIdentificationNumbers.Количество() > 0 Тогда
			
			ЕстьМаркировка = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьМаркировка;
	
КонецФункции

