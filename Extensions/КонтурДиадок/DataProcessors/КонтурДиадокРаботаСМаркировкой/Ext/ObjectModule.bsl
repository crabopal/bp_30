		Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
		РазвернутаяТаблицаУпаковок,
		ЕстьМаркировка
	);
	ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_ИСМП_Ред12(
		Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
		РазвернутаяТаблицаУпаковокДоИзменения,
		ЕстьМаркировка
	);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтентеУКД29_ИСМП_ПартионныйУчет(
	Контент,
	РазвернутаяТаблицаУпаковок,
	РазвернутаяТаблицаУпаковокДоИзменения)
	
	ЭтоУКДНаОснованииВозвратаОтКлиента = СвойствоСтруктуры(
		Контент.СлужебнаяИнформация,
		"ЭтоУКДНаОснованииВозвратаОтКлиента",
		Ложь
	);
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
		
		ТребуемоеКоличество = СтрокаТЧ.OriginalValues.Quantity;
		ТребуемоеКоличество = ?(ТребуемоеКоличество = Неопределено, 0, ТребуемоеКоличество);
		
		КодыМаркировкиДоИзменения = ПодобратьКодыМаркировки_ИСМП_ПартионныйУчет(
			РазвернутаяТаблицаУпаковокДоИзменения,
			СтрокаТЧ.СлужебнаяИнформация,
			ТребуемоеКоличество
		);
		
		Для Каждого Элемент Из КодыМаркировкиДоИзменения Цикл
			ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(СтрокаТЧ.OriginalItemIdentificationNumbers, Элемент);
		КонецЦикла;
		
		ЭтоПолныйВозвратТовара = ЭтоПолныйВозвратТовара(СтрокаТЧ);
		Если ЭтоПолныйВозвратТовара Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоУКДНаОснованииВозвратаОтКлиента Тогда
			
			ЗаполнитьКодыМаркировкиДляВозвратаОтКлиента_ИСМП_ПартионныйУчет(
				СтрокаТЧ,
				РазвернутаяТаблицаУпаковок
			);
			
		Иначе
			
			ТребуемоеКоличество = СтрокаТЧ.CorrectedValues.Quantity;
			ТребуемоеКоличество = ?(ТребуемоеКоличество = Неопределено, 0, ТребуемоеКоличество);
			
			КодыМаркировки = ПодобратьКодыМаркировки_ИСМП_ПартионныйУчет(
				РазвернутаяТаблицаУпаковок,
				СтрокаТЧ.СлужебнаяИнформация,
				ТребуемоеКоличество
			);
			
			Для Каждого Элемент Из КодыМаркировки Цикл
				ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(СтрокаТЧ.CorrectedItemIdentificationNumbers, Элемент);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеУКД29_ИСМП10127(Контент, ТаблицаУпаковок, ИсходныйДокумент, ДокументыПередачи)
	
	РазвернутаяТаблицаУпаковок = Новый_РазвернутаяТаблицаУпаковок_ИСМП10127();
	РазвернутаяТаблицаУпаковокДоИзменения = Новый_РазвернутаяТаблицаУпаковок_ИСМП10127();
	ТаблицаТоваров = ТаблицаТоваровИСМПУКД29(Контент.InvoiceCorrectionTable.Items, Ложь);
	ДанныеШтрихкодовУпаковок = ИСМП_ЧастичноеСодержимоеИКодыОСУ(ТаблицаУпаковок, ТаблицаТоваров, ДокументыПередачи);
	
	ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
	
	Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда
		
		ИсходныеДокументыПередачи = Новый Массив;
		ИсходныеДокументыПередачи.Добавить(ИсходныйДокумент);
		
		ТаблицаУпаковокДоИзменения = ТаблицаУпаковокИСМП(ИсходныеДокументыПередачи);
		ИсходныйДокументПередачи = ?(ИсходныеДокументыПередачи.Количество(), ИсходныеДокументыПередачи[0], Неопределено);
		ТаблицаТоваровДоИзменения = ТаблицаТоваровИСМПУКД29(
			Контент.InvoiceCorrectionTable.Items,
			Истина,
			ИсходныйДокументПередачи
		);
		КорректируемыеУпаковкиДоИзменения = УпаковкиПоТаблицеТоваровДоИзменения(
			ТаблицаУпаковокДоИзменения,
			ТаблицаТоваровДоИзменения
		);
		ДанныеШтрихкодовУпаковокДоИзменения = ИСМП_ЧастичноеСодержимоеИКодыОСУ(
			КорректируемыеУпаковкиДоИзменения,
			ТаблицаТоваровДоИзменения,
			ИсходныеДокументыПередачи
		);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковокДоИзменения, ДанныеШтрихкодовУпаковокДоИзменения);
		
	КонецЕсли;
	
	ЗаполнитьСведенияОМаркировкеВКонтентеУКД29_ИСМП10127(
		Контент,
		РазвернутаяТаблицаУпаковок,
		РазвернутаяТаблицаУпаковокДоИзменения
	);
	
	ЕстьМаркировка = ЕстьКодыМаркировкиУКД29(Контент);
	
	ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_ИСМП(
		Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
		РазвернутаяТаблицаУпаковок,
		ЕстьМаркировка
	);
	ЗаполнитьПризнакиМаркируемыхТоваровВКонтенте_ИСМП(
		Контент.СлужебнаяИнформация.ContentsDocumentProductsType,
		РазвернутаяТаблицаУпаковокДоИзменения,
		ЕстьМаркировка
	);
	
КонецПроцедуры

