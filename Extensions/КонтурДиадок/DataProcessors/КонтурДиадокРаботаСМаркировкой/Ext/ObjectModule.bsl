// Возвращает версию модуля Контур.Маркировки
// 
// Возвращаемое значение:
//  Строка, Неопределено - Версия модуля Контур Маркировки.
//                         Если установленная подсистема ниже версии 3.0.0, то вернется 0.0.0.
//                         Если подсистема установлена, но не компилится, то вернется 0.0.0.
//                         Если подсистема или модуль не найдены, то возвращается Неопределено.
//
Функция ВерсияМодуляКонтурМаркировки() Экспорт
	
	Результат = ВерсияУстановленногоМодуляКонтурМаркировка();
	
	Возврат Результат;
	
КонецФункции

// Возвращает сводную информацию о сведениях маркировки для коллекции учетных документов пакета
//
// Параметры:
//  ДокументыУчета	 - Массив	 - Коллекция ссылок на учетные документы пакета
// 
// Возвращаемое значение:
//  Структура - Сводная информация о сведениях маркировки
//
Функция СостояниеМаркировки(ДокументыУчета) Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ВидимостьКоманды", Ложь);
	Результат.Вставить("Заголовок");
	Результат.Вставить("Картинка");
	Результат.Вставить("Подсказка");
	Результат.Вставить("ТекстОшибки");
	
	ОбщийМодульКонтурМаркировка = ОбщийМодульКонтурМаркировка();
	
	ВызывающийМодуль = ИмяВызывающегоМодуляДляКонтурМаркировки();
	
	Если ИспользуетсяКонтурМаркировка318() И ОбщийМодульКонтурМаркировка <> Неопределено Тогда
		
		Попытка
			
			СостояниеМаркировки = ОбщийМодульКонтурМаркировка.МодульМаркировки().СостояниеМаркировки(ДокументыУчета,
				ВызывающийМодуль);
			
		Исключение
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЖурналРегистрации_ЗаписатьОшибку("СостояниеМаркировки", ТекстОшибки);
			
			Результат.ТекстОшибки = ТекстОшибки;
			
		КонецПопытки;
		
		Если ТипЗнч(СостояниеМаркировки) = Тип("Структура") Тогда
			
			ЗаполнитьЗначенияСвойств(Результат, СостояниеМаркировки);
			
			Если НЕ ЗначениеЗаполнено(Результат.Заголовок) Тогда
				Результат.ВидимостьКоманды = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// BSLLS:MissingReturnedValueDescription-off

// Открывает форму просмотра сведений о маркировке (при вызове из ОФ)
//
// Параметры:
//  ФормаВызова		 - Форма	 - Форма, из которой происходит вызов
//  ДокументыУчета	 - Массив	 - Коллекция ссылок на учетные документы пакета
//
Функция ОткрытьСостояниеМаркировки(ФормаВызова, ДокументыУчета) Экспорт
	
	Результат = "";
	
	ОбщийМодульКонтурМаркировка = ОбщийМодульКонтурМаркировкиКлиент();
	
	ВызывающийМодуль = ИмяВызывающегоМодуляДляКонтурМаркировки();
	
	Если ИспользуетсяКонтурМаркировка318() Тогда
		
		Попытка
			
			ОбщийМодульКонтурМаркировка.МодульМаркировкиКлиент().ОткрытьСостояниеМаркировки(ФормаВызова,
			ДокументыУчета, ВызывающийМодуль);
			
		Исключение
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЖурналРегистрации_ЗаписатьОшибку("ОткрытьСведенияОМаркировке", ТекстОшибки);
			
			Результат = ТекстОшибки;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяМодуляИнтеграцииКлиент()
	
	Возврат "ВзаимодействиеКонтурМаркировкаКлиент";
	
КонецФункции

Функция ОбщийМодульКонтурМаркировкиКлиент()
	
	ИмяМодуля = ИмяМодуляИнтеграцииКлиент();
	
	Результат = Вычислить(ИмяМодуля);
	
	Возврат Результат;
	
КонецФункции
