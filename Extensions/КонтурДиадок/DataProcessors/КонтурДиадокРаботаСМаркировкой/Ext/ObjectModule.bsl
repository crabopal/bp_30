Процедура ЗаполнитьСведенияОМаркировкеВКонтенте970(Контент, РазвернутаяТаблицаУпаковок)
	
	Для Каждого СтрокаКонтента Из Контент.Table.Items Цикл
		
		ТребуемоеКоличество = СтрокаКонтента.Quantity;
		
		Если Не ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			Продолжить;
		КонецЕсли;
		
		КодыМаркировки = Новый_СведенияОМаркировке();
		
		ПодобратьКодыМаркировки(КодыМаркировки, РазвернутаяТаблицаУпаковок, СтрокаКонтента.СлужебнаяИнформация, ТребуемоеКоличество);
		ЗаполнитьКодыМаркировкиВСтрокеКонтента970(СтрокаКонтента, КодыМаркировки);
		
	КонецЦикла;
	
КонецПроцедуры

// Переносит коды маркировки в строку контента.
//
// Параметры:
//  СтрокаКонтента - Структура - содержит объект Item970 (см. МодульИнтеграции.Контракт_Item970())
//  КодыМаркировки - Структура - содержит коллекции кодов маркировки (см. Новый_СведенияОМаркировке)
//
Процедура ЗаполнитьКодыМаркировкиВСтрокеКонтента970(СтрокаКонтента, КодыМаркировки)
	
	ИдентификационныйНомер = Неопределено;
	
	Для Каждого Элемент Из КодыМаркировки.ТранспортныеУпаковки Цикл
		
		ИдентификационныйНомер = Новый_ItemIdentificationNumber();
		ИдентификационныйНомер.TransPackageId = Элемент;
		СтрокаКонтента.ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КодыМаркировки.ИндивидуальныеУпаковки) Тогда
		
		ИдентификационныйНомер = Новый_ItemIdentificationNumber();
		
		Для Каждого Элемент Из КодыМаркировки.ИндивидуальныеУпаковки Цикл
			ИдентификационныйНомер.PackageIds.Добавить(Элемент);
		КонецЦикла;
		
		СтрокаКонтента.ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодыМаркировки.КонтрольныеИдентификационныеЗнаки) Тогда
		
		ИдентификационныйНомер = Новый_ItemIdentificationNumber();
		
		Для Каждого Элемент Из КодыМаркировки.КонтрольныеИдентификационныеЗнаки Цикл
			ИдентификационныйНомер.Units.Добавить(Элемент);
		КонецЦикла;
		
		СтрокаКонтента.ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодыМаркировки.ГТИН) И КодыМаркировки.КоличествоТовараВУпаковке > 0 Тогда
		
		ИдентификационныйНомер = Новый_ItemIdentificationNumber();
		ИдентификационныйНомер.MarkedItemsQuantity = КодыМаркировки.КоличествоТовараВУпаковке;
		
		СтрокаКонтента.ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
		СтрокаКонтента.GTIN = КодыМаркировки.ГТИН;
		
	КонецЕсли;
	
	Если ИдентификационныйНомер <> Неопределено
		И ЗначениеЗаполнено(КодыМаркировки.НомерПартии) Тогда
		ИдентификационныйНомер.BatchCode = КодыМаркировки.НомерПартии;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтентеУКД29(
	Контент,
	ДокументыПередачи,
	РазвернутаяТаблицаУпаковок,
	РазвернутаяТаблицаУпаковокДоИзменения)
	
	ЭтоУКДНаОснованииВозвратаОтКлиента = СвойствоСтруктуры(
		Контент.СлужебнаяИнформация,
		"ЭтоУКДНаОснованииВозвратаОтКлиента",
		Ложь
	);
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
		
		ТребуемоеКоличество = СтрокаТЧ.OriginalValues.Quantity;
		
		Если ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			
			КодыМаркировки = Новый_СведенияОМаркировке();
			
			ПодобратьКодыМаркировки(
				КодыМаркировки,
				РазвернутаяТаблицаУпаковокДоИзменения,
				СтрокаТЧ.СлужебнаяИнформация,
				ТребуемоеКоличество
			);
			
			ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(СтрокаТЧ.OriginalItemIdentificationNumbers, КодыМаркировки);
			
		КонецЕсли;
		
		ЭтоПолныйВозвратТовара = ЭтоПолныйВозвратТовара(СтрокаТЧ);
		
		Если ЭтоУКДНаОснованииВозвратаОтКлиента Тогда
			
			Если ЭтоПолныйВозвратТовара Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьКодыМаркировкиДляВозвратаОтКлиента(
				СтрокаТЧ,
				РазвернутаяТаблицаУпаковок,
				РазвернутаяТаблицаУпаковокДоИзменения
			);
			
		Иначе
			
			ТребуемоеКоличество = СтрокаТЧ.CorrectedValues.Quantity;
			ТребуемоеКоличество = ?(ТребуемоеКоличество = Неопределено, 0, ТребуемоеКоличество);
			
			Если ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
				
				КодыМаркировки = Новый_СведенияОМаркировке();
				
				ПодобратьКодыМаркировки(
					КодыМаркировки,
					РазвернутаяТаблицаУпаковок,
					СтрокаТЧ.СлужебнаяИнформация,
					ТребуемоеКоличество
				);
				
				ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(СтрокаТЧ.CorrectedItemIdentificationNumbers, КодыМаркировки);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКодыМаркировкиВСтрокеКонтентаУКД29(ItemIdentificationNumbers, КодыМаркировки)
	
	ИдентификационныйНомер = Неопределено;
	
	Если ЗначениеЗаполнено(КодыМаркировки.ГТИН)
		И КодыМаркировки.КоличествоТовараВУпаковке > 0 Тогда
		
		ЗаполнитьКодыОбъемноСортовогоУчетаУКД29(ItemIdentificationNumbers, КодыМаркировки);
		
	ИначеЕсли ЗначениеЗаполнено(КодыМаркировки.ИндивидуальныеУпаковки)
		И ЗначениеЗаполнено(КодыМаркировки.НомерПартии) Тогда
		
		ЗаполнитьКодыПартионногоУчетаУКД29(КодыМаркировки.НомерПартии, ItemIdentificationNumbers, КодыМаркировки);
		
	Иначе
		
		Для Каждого Элемент Из КодыМаркировки.ТранспортныеУпаковки Цикл
			
			ИдентификационныйНомер = Новый_ItemIdentificationNumberUcd29();
			ИдентификационныйНомер.TransPackageId = Элемент;
			ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(КодыМаркировки.ИндивидуальныеУпаковки) Тогда
			
			ИдентификационныйНомер = Новый_ItemIdentificationNumberUcd29();
			
			Для Каждого Элемент Из КодыМаркировки.ИндивидуальныеУпаковки Цикл
				ИдентификационныйНомер.PackageIds.Добавить(Элемент);
			КонецЦикла;
			
			ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодыМаркировки.КонтрольныеИдентификационныеЗнаки) Тогда
			
			ИдентификационныйНомер = Новый_ItemIdentificationNumberUcd29();
			
			Для Каждого Элемент Из КодыМаркировки.КонтрольныеИдентификационныеЗнаки Цикл
				ИдентификационныйНомер.Units.Добавить(Элемент);
			КонецЦикла;
			
			ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКодыОбъемноСортовогоУчетаУКД29(ItemIdentificationNumbers, КодыМаркировки)
	
	ИдентификационныйНомер = Новый_ItemIdentificationNumberUcd29();
	ИдентификационныйНомер.MarkedItemsQuantity = КодыМаркировки.КоличествоТовараВУпаковке;
	ИдентификационныйНомер.GTIN = КодыМаркировки.ГТИН;
	ИдентификационныйНомер.QuantityWeightMark = КодыМаркировки.ВесТовара;
	ИдентификационныйНомер.BatchCode = КодыМаркировки.НомерПартии;
	
	ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
	
КонецПроцедуры

Процедура ЗаполнитьКодыПартионногоУчетаУКД29(НомерПартии, ItemIdentificationNumbers, КодыМаркировки)
	
	Для Каждого Элемент Из КодыМаркировки.ИндивидуальныеУпаковки Цикл
		
		ИдентификационныйНомер = Новый_ItemIdentificationNumberUcd29();
		
		РезультатРазбора = РазобратьКодУПДКакПартионныйКодЛок(Элемент);
		Если РезультатРазбора.Разобран Тогда
			
			ИдентификационныйНомер.MarkedItemsQuantity = РезультатРазбора.Количество;
			ИдентификационныйНомер.GTIN = РезультатРазбора.ГТИН;
			ИдентификационныйНомер.QuantityWeightMark = ПривестиВесТовараКФормату(РезультатРазбора.Вес);
			ИдентификационныйНомер.BatchCode = НомерПартии;
			
		Иначе
			
			ИдентификационныйНомер.PackageIds.Добавить(Элемент);
			
		КонецЕсли;
		
		ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
		
	КонецЦикла;
	
КонецПроцедуры

Функция РазобратьКодУПДКакПартионныйКодЛок(Знач ЗначениеШтрихкода) // BSLLS:TooManyReturns-off
	// BSLLS:MagicNumber-off
	РезультатРазбора = Новый Структура;
	РезультатРазбора.Вставить("Разобран", Ложь);
	РезультатРазбора.Вставить("ГТИН", "");
	РезультатРазбора.Вставить("Количество", 0);
	РезультатРазбора.Вставить("Вес", 0);
	
	ПозицияТега02 = Найти(ЗначениеШтрихкода, "02"); // BSLLS:DeprecatedFind-off
	
	Если ПозицияТега02 = 0 Тогда
		Возврат РезультатРазбора;
	КонецЕсли;
	
	РезультатРазбора.ГТИН = Сред(ЗначениеШтрихкода, 3, 14);
	ПеременнаяЧастьЗначенияШтрихкода = Прав(ЗначениеШтрихкода, СтрДлина(ЗначениеШтрихкода) - 16);
	
	ПозицияТега3103 = Найти(ПеременнаяЧастьЗначенияШтрихкода, "3103"); // BSLLS:DeprecatedFind-off
	
	Если ПозицияТега3103 > 0 Тогда
		
		ВесСтрокой = Прав(ПеременнаяЧастьЗначенияШтрихкода,
			СтрДлина(ПеременнаяЧастьЗначенияШтрихкода) - ПозицияТега3103 - 4);
		
		РезультатРазбора.Вес = ПривестиКЧислуЛок(ВесСтрокой);
		
		СтрокаКоличество = Лев(ПеременнаяЧастьЗначенияШтрихкода,
			СтрДлина(ПеременнаяЧастьЗначенияШтрихкода) - СтрДлина(ВесСтрокой) - 5);
		
	Иначе
		СтрокаКоличество = ПеременнаяЧастьЗначенияШтрихкода;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаКоличество) Тогда
		Возврат РезультатРазбора;
	КонецЕсли;
	
	ПозицияТега37 = Найти(СтрокаКоличество, "37"); // BSLLS:DeprecatedFind-off
	
	Если ПозицияТега37 = 0 Тогда
		Возврат РезультатРазбора;
	КонецЕсли;
	
	ЗначениеКоличество = Прав(СтрокаКоличество, СтрДлина(СтрокаКоличество) - 2);
	// BSLLS:MagicNumber-on
	РезультатРазбора.Количество = ПривестиКЧислуЛок(ЗначениеКоличество);
	РезультатРазбора.Разобран = Истина;
	
	Возврат РезультатРазбора;
	
КонецФункции

// Подбирает требуемое количество кодов маркировки, удовлетворяющих параметрам номенклатуры.
// В исходной таблице кодов строки с подобранными кодами отмечаются как обработанные.
//
// Параметры:
//  КодыМаркировки					 - Структура - результат подбора (см. Новый_СведенияОМаркировке)
//  РазвернутаяТаблицаУпаковок		 - ТаблицаЗначений - таблица штрихкодов упаковок (см. РазвернутаяТаблицаУпаковок)
//  СлужебнаяИнформация				 - Структура - содержит параметры номенклатуры (см. НоваяСлужебнаяИнформацияСтроки)
//  ТребуемоеКоличество				 - Число - Количество кодов, которые нужно подобрать
//  ПодобратьКодДляПолногоВозрата	 - Булево - подбирать коды для полного возврата или нет
//
// BSLLS:CognitiveComplexity-off
Процедура ПодобратьКодыМаркировки(
	КодыМаркировки,
	РазвернутаяТаблицаУпаковок,
	СлужебнаяИнформация,
	Знач ТребуемоеКоличество,
	ПодобратьКодДляПолногоВозрата = Ложь)
	
	Для Каждого СтрокаУпаковки Из РазвернутаяТаблицаУпаковок Цикл
		
		МожноПодобратьКодПоУпаковке = МожноПодобратьКодМаркировкиПоУпаковке(СтрокаУпаковки, ТребуемоеКоличество, ПодобратьКодДляПолногоВозрата);
		
		Если НЕ МожноПодобратьКодПоУпаковке Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаУпаковки.Номенклатура <> СлужебнаяИнформация.Номенклатура Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаУпаковки.ИспользоватьХарактеристики
			И СтрокаУпаковки.Характеристика <> СлужебнаяИнформация.Характеристика Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаУпаковки.ИспользоватьСерии
			И ЗначениеЗаполнено(СлужебнаяИнформация.Серия)
			И СтрокаУпаковки.Серия <> СлужебнаяИнформация.Серия Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеШК = СтрокаУпаковки.ЗначениеШтрихкода;
		
		Если ЗначениеЗаполнено(ЗначениеШК) Тогда
			
			ВидУпаковки = СтрокаУпаковки.ВидУпаковки;
			
			Если ВидУпаковки = УпаковкаЛогистическая() Тогда
				КодыМаркировки.ТранспортныеУпаковки.Добавить(ЗначениеШК);
			ИначеЕсли ВидУпаковки = УпаковкаГрупповая() Тогда
				КодыМаркировки.ИндивидуальныеУпаковки.Добавить(ЗначениеШК);
			ИначеЕсли ВидУпаковки = УпаковкаОбъемноСортовойУчет() Тогда
				
				СоставКодаОСУ = СоставКодаОСУ(ЗначениеШК);
				
				КодыМаркировки.КоличествоТовараВУпаковке = СоставКодаОСУ.КоличествоТовара;
				КодыМаркировки.ГТИН = СоставКодаОСУ.GTIN;
				
			Иначе
				КодыМаркировки.КонтрольныеИдентификационныеЗнаки.Добавить(ЗначениеШК);
			КонецЕсли;
			
			ТребуемоеКоличество = ТребуемоеКоличество - 1;
			
		КонецЕсли;
		
		СтрокаУпаковки.Обработан = Истина;
		
	КонецЦикла;
	
КонецПроцедуры
// BSLLS:CognitiveComplexity-on

Функция МожноПодобратьКодМаркировкиПоУпаковке(СтрокаУпаковки, ТребуемоеКоличество, ПодобратьКодДляПолногоВозрата)
	
	Результат = Истина;
	
	Если СтрокаУпаковки.Обработан Тогда
		
		Результат = Ложь;
		
	ИначеЕсли ПодобратьКодДляПолногоВозрата 
		И ТребуемоеКоличество = 0 Тогда
		
		ЭтоОСУ = СтрокаУпаковки.ВидУпаковки = УпаковкаОбъемноСортовойУчет();
		
		Если НЕ ЭтоОСУ Тогда
			Результат = Ложь;
		КонецЕсли;
		
	ИначеЕсли ТребуемоеКоличество <= 0 Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Дополняет коллекцию ошибок валидации электронного документа.
//
// Параметры:
