Функция ТекстЗапросаТаблицыУпаковокИСМП(ПолноеИмяОбъекта)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТЧ.Ссылка КАК Ссылка,
	|	ТЧ.ШтрихкодУпаковки КАК Штрихкод
	|ИЗ
	|	&ТЧШтрихкоды КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В (&ВладельцыШтрихкодов)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТЧШтрихкоды", ПолноеИмяОбъекта + ".ШтрихкодыУпаковок");
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция СформироватьКодОСУСВесом_ИСМП(ШтрихкодEAN, Количество, Вес)
	
	GTIN = ГТИНПоШтрихкодуEAN(ШтрихкодEAN);
	КоличествоСтрокой = Формат(Количество, "ЧДЦ=0; ЧН=0; ЧГ=0");
	
	ЭлементыКМ = Новый Массив;
	ЭлементыКМ.Добавить("02");
	ЭлементыКМ.Добавить(GTIN);
	ЭлементыКМ.Добавить("37");
	ЭлементыКМ.Добавить(КоличествоСтрокой);
	
	Если ЗначениеЗаполнено(Вес) Тогда
		
		ГраммВКилограмме = 1000;
		ВесСтрокой = Формат(Вес * ГраммВКилограмме, "ЧЦ=9; ЧДЦ=0; ЧН=0; ЧВН=; ЧГ=0;");
		
		ЭлементыКМ.Добавить("3103");
		ЭлементыКМ.Добавить(ВесСтрокой);
		
	КонецЕсли;
	
	Возврат СтрСоединитьЛок(ЭлементыКМ);
	
КонецФункции

Функция ГТИНПоШтрихкодуEAN(Штрихкод)
	
	ДлинаКодаГТИН14 = 14;
	
	ДлинаШтрихкода = СтрДлина(Штрихкод);
	Если ДлинаШтрихкода > ДлинаКодаГТИН14 Или ДлинаШтрихкода = 0 Тогда
		Возврат "";
	ИначеЕсли ДлинаШтрихкода = ДлинаКодаГТИН14 Тогда
		Возврат Штрихкод;
	Иначе
		Возврат Лев("0000000000000", ДлинаКодаГТИН14 - ДлинаШтрихкода) + Штрихкод;
	КонецЕсли;
	
КонецФункции

