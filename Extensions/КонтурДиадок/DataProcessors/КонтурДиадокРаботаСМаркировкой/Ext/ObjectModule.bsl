Функция ВерсияУстановленногоМодуляКонтурМаркировка()
	
	ИмяМодуля = ИмяМодуляВзаимодействиеКонтурМаркировка();
	
	МетаданныеМодуля = Метаданные.ОбщиеМодули.Найти(ИмяМодуля);
	
	Если МетаданныеМодуля <> Неопределено Тогда
		
		УстановленнаяВерсияПодсистемыКМ = ВерсияУстановленнойПодсистемыКонтурМаркировка();
		НеобходимаяВерсияПодсистемыКМ = "3.0.0";
		
		Если СравнитьВерсии(УстановленнаяВерсияПодсистемыКМ, НеобходимаяВерсияПодсистемыКМ) >= 0 Тогда
			
			// На всякий случай, чтобы мы не падали,
			// если подсистему обновили криво,
			// либо если подсистему обновили нормально, а модуль обновили криво
			Попытка
				
				МодульВзаимодействиеКонтурМаркировка = ОбщийМодульПоИмениЛок(ИмяМодуля);
				
				Результат = МодульВзаимодействиеКонтурМаркировка.ВерсияМодуля();
				
			Исключение
				Результат = НеизвестнаяВерсияПродукта();
			КонецПопытки;
			
		Иначе
			Результат = НеизвестнаяВерсияПродукта();
		КонецЕсли;
		
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВерсияУстановленнойПодсистемыКонтурМаркировка()
	
	ИмяМодуля = "ОбновлениеИнформационнойБазыКонтурМаркировка";
	
	МетаданныеМодуля = Метаданные.ОбщиеМодули.Найти(ИмяМодуля);
	
	Если МетаданныеМодуля <> Неопределено Тогда
		
		Попытка
			
			МодульОбновлениеИнформационнойБазыКонтурМаркировка = ОбщийМодульПоИмениЛок(ИмяМодуля);
			
			Результат = МодульОбновлениеИнформационнойБазыКонтурМаркировка.ВерсияБиблиотеки();
			
		Исключение
			Возврат НеизвестнаяВерсияПродукта();
		КонецПопытки;
		
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


Функция КодТоварнойГруппыПоДаннымКонтурМаркировка(ВидПродукцииКМ)
	
	ПравилаКонвертацииТоварныхГрупп = ПравилаКонвертацииТоварныхГруппКонтурМаркировка();
	
	Результат = ПравилаКонвертацииТоварныхГрупп.Получить(ВидПродукцииКМ);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = КодТоварнойГруппыПусто();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразовывает вид упаковки подсистемы КонтурМаркировка во внутренее представление.
//
// Параметры:
//  ВидУпаковкиКМ - ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок - вид упаковки в формате КМ.
// 
// Возвращаемое значение:
//  Строка - Возможные значения описаны функциями УпаковкаПотребительская(), УпаковкаЛогистическая() и УпаковкаГрупповая()
//
Функция ВидУпаковкиПоДаннымКонтурМаркировка(ВидУпаковкиКМ)
	
	ПравилаКонвертацииУпаковок = ПравилаКонвертацииУпаковокКонтурМаркировка();
	ЗначениеПоУмолчанию = УпаковкаПотребительская();
	
	Результат = ПравилаКонвертацииУпаковок.Получить(ВидУпаковкиКМ);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПравилаКонвертацииТоварныхГруппКонтурМаркировка()
	
	Если _ПравилаКонвертацииТоварныхГруппКМ <> Неопределено Тогда
		Возврат _ПравилаКонвертацииТоварныхГруппКМ;
	КонецЕсли;
	
	Карта = Новый Соответствие;
	
	МетаданныеВидыПродукцииКМ = Метаданные.Перечисления.Найти("КонтурМаркировка_ВидыПродукции");
	
	Если МетаданныеВидыПродукцииКМ <> Неопределено Тогда
		
		ПолнаяКарта = Новый Структура;
		ПолнаяКарта.Вставить("Легпром", КодТоварнойГруппыЛегПром());
		ПолнаяКарта.Вставить("Обувь", КодТоварнойГруппыОбувь());
		ПолнаяКарта.Вставить("Табак", КодТоварнойГруппыТабак());
		ПолнаяКарта.Вставить("Парфюмерия", КодТоварнойГруппыДухи());
		ПолнаяКарта.Вставить("Шины", КодТоварнойГруппыШины());
		ПолнаяКарта.Вставить("Фототовары", КодТоварнойГруппыФотоаппараты());
		ПолнаяКарта.Вставить("Молоко", КодТоварнойГруппыМолочка());
		ПолнаяКарта.Вставить("Велосипеды", КодТоварнойГруппыВелосипеды());
		ПолнаяКарта.Вставить("МедицинскиеИзделия", КодТоварнойГруппыКреслаКоляски());
		ПолнаяКарта.Вставить("АльтернативныйТабак", КодТоварнойГруппыАльтернативныйТабак());
		ПолнаяКарта.Вставить("Вода", КодТоварнойГруппыУпакованнаяВода());
		ПолнаяКарта.Вставить("Пиво", КодТоварнойГруппыПиво());
		ПолнаяКарта.Вставить("НикотиносодержащаяПродукция", КодТоварнойГруппыНикотиносодержащаяПродукция());
		ПолнаяКарта.Вставить("Бады", КодТоварнойГруппыБАД());
		ПолнаяКарта.Вставить("Антисептики", КодТоварнойГруппыАнтисептики());
		ПолнаяКарта.Вставить("Морепродукты", КодТоварнойГруппыМорепродукты());
		ПолнаяКарта.Вставить("БезалкогольныеНапитки", КодТоварнойГруппыБезалкогольныеНапитки());
		
		ВсеЗначения = МетаданныеВидыПродукцииКМ.ЗначенияПеречисления;
		Менеджер = Перечисления.КонтурМаркировка_ВидыПродукции;
		
		Для Каждого КлючЗначение Из ПолнаяКарта Цикл
			Если ВсеЗначения.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
				Карта.Вставить(Менеджер[КлючЗначение.Ключ], КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Карта.Вставить(Менеджер.ПустаяСсылка(), КодТоварнойГруппыПусто());
		
	КонецЕсли;
	
	_ПравилаКонвертацииТоварныхГруппКМ = Новый ФиксированноеСоответствие(Карта);
	
	Возврат _ПравилаКонвертацииТоварныхГруппКМ;
	
КонецФункции

// Формирует правила преобразования видов упаковок подсистемы КонтурМаркировка во внутреннее представление,
// которое используется для заполнения развернутой таблицы упаковок.
// 
// Возвращаемое значение:
//  Соответствие:
//   * Ключ - ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок - вид упаковки в формате КонтурМаркировка.
//   * Значение - Строка - Внутреннее представление вида упаковки.
//
Функция ПравилаКонвертацииУпаковокКонтурМаркировка()
	
	Если _ПравилаКонвертацииУпаковокКМ <> Неопределено Тогда
		Возврат _ПравилаКонвертацииУпаковокКМ;
	КонецЕсли;
	
	_ПравилаКонвертацииУпаковокКМ = Новый Соответствие;
	
	МетаданныеВидыУпаковокКонтурМаркировка = Метаданные.Перечисления.Найти("КонтурМаркировка_ВидыУпаковок");
	Если МетаданныеВидыУпаковокКонтурМаркировка <> Неопределено Тогда
		
		ВидыУпаковокКМ = Перечисления.КонтурМаркировка_ВидыУпаковок;
		
		_ПравилаКонвертацииУпаковокКМ.Вставить(ВидыУпаковокКМ.Групповая, УпаковкаГрупповая());
		_ПравилаКонвертацииУпаковокКМ.Вставить(ВидыУпаковокКМ.Логистическая, УпаковкаЛогистическая());
		_ПравилаКонвертацииУпаковокКМ.Вставить(ВидыУпаковокКМ.Потребительская, УпаковкаПотребительская()); 
		
		ЕстьОбъемноСортовойУчет = МетаданныеВидыУпаковокКонтурМаркировка.ЗначенияПеречисления.Найти("ОбъемноСортовойУчет") <> Неопределено;
		Если ЕстьОбъемноСортовойУчет Тогда
			_ПравилаКонвертацииУпаковокКМ.Вставить(ВидыУпаковокКМ.ОбъемноСортовойУчет, УпаковкаОбъемноСортовойУчет());
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат _ПравилаКонвертацииУпаковокКМ;
	
КонецФункции

Функция ТекстЗапросаДляОбработкиСведенийОМаркировке()
	
	// BSLLS:AssignAliasFieldsInQuery-off
	// BSLLS:DuplicateStringLiteral-off
	
	Результат = "ВЫБРАТЬ
		|	СведенияОмаркировке.ЗначениеШтрихкода КАК ЗначениеШтрихкода,
		|	СведенияОмаркировке.ВидУпаковки КАК ВидУпаковки,
		|	СведенияОмаркировке.GTIN КАК GTIN,
		|	СведенияОмаркировке.Количество КАК Количество,
		|	СведенияОМаркировке.НомерПартии КАК НомерПартии,
		|	&КоличествоУпаковок КАК КоличествоУпаковок,
		|	&ПеременнаяХарактеристика КАК ПеременнаяХарактеристика
		|ПОМЕСТИТЬ ВТСведенияОмаркировке
		|ИЗ
		|	&СведенияОмаркировке КАК СведенияОмаркировке
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТСведенияОмаркировке.ЗначениеШтрихкода КАК ЗначениеШтрихкода,
		|	ВТСведенияОмаркировке.ВидУпаковки КАК ВидУпаковки,
		|	ВТСведенияОмаркировке.GTIN КАК GTIN,
		|	ВТСведенияОмаркировке.Количество КАК Количество,
		|	ВТСведенияОмаркировке.НомерПартии КАК НомерПартии,
		|	ВТСведенияОМаркировке.КоличествоУпаковок КАК КоличествоУпаковок,
		|	ВТСведенияОМаркировке.ПеременнаяХарактеристика КАК ПеременнаяХарактеристика
		|ИЗ
		|	ВТСведенияОмаркировке КАК ВТСведенияОмаркировке
		|ИТОГИ ПО
		|	НомерПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	GTIN Как GTIN
		|ИЗ
		|	ВТСведенияОмаркировке КАК ВТСведенияОмаркировке
		|СГРУППИРОВАТЬ ПО
		|	GTIN
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТСведенияОмаркировке";
	
	// BSLLS:AssignAliasFieldsInQuery-on
	// BSLLS:DuplicateStringLiteral-on
	
