Функция ВерсияПодсистемыИСМП()
	
	Версия = "";
	
	Если Метаданные.ОбщиеМодули.Найти("СтандартныеПодсистемыПовтИсп") <> Неопределено Тогда
		
		МодульСтандартныеПодсистемыПовтИсп = ОбщийМодульПоИмениЛок("СтандартныеПодсистемыПовтИсп");
		
		ОписанияПодсистем = МодульСтандартныеПодсистемыПовтИсп.ОписанияПодсистем().ПоИменам;
		ОписаниеПодсистемыБиблиотекиИнтеграцииИСМП = ОписанияПодсистем.Получить("БиблиотекаИнтеграцииИСМП");
		
		Если НЕ ОписаниеПодсистемыБиблиотекиИнтеграцииИСМП = Неопределено Тогда
			Версия = ОписаниеПодсистемыБиблиотекиИнтеграцииИСМП.Версия;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Версия) Тогда
		
		ОписаниеПодсистемы = Новый Структура;
		ОписаниеПодсистемы.Вставить("Имя", "");
		ОписаниеПодсистемы.Вставить("Версия", "");
		ОписаниеПодсистемы.Вставить("ТребуемыеПодсистемы", Новый Массив);
		ОписаниеПодсистемы.Вставить("РежимВыполненияОтложенныхОбработчиков", "");
		
		МодульОбновлениеИнформационнойБазыИСМП = ОбщийМодульПоИмениЛок("ОбновлениеИнформационнойБазыИСМП");
		МодульОбновлениеИнформационнойБазыИСМП.ПриДобавленииПодсистемы(ОписаниеПодсистемы);
		
		Версия = ОписаниеПодсистемы.Версия;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Версия) Тогда
		Версия = "0.0.0";
	КонецЕсли;
	
	Возврат Версия;
	
КонецФункции

Функция КодТоварнойГруппыПоДаннымИСМП(ВидПродукцииИСМП)
	
	ПравилаКонвертацииВидаПродукции = ПравилаКонвертацииВидаПродукцииИСМП();
	
	Результат = ПравилаКонвертацииВидаПродукции.Получить(ВидПродукцииИСМП);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = КодТоварнойГруппыПусто();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПравилаКонвертацииВидаПродукцииИСМП()
	
	Если _ПравилаКонвертацииВидаПродукцииИСМП <> Неопределено Тогда
		Возврат _ПравилаКонвертацииВидаПродукцииИСМП;
	КонецЕсли;
	
	Карта = Новый Соответствие;
	
	МетаданныеВидыПродукцииИС = Метаданные.Перечисления.Найти("ВидыПродукцииИС");
	
	Если МетаданныеВидыПродукцииИС <> Неопределено Тогда
		
		ПолнаяКарта = Новый Структура;
		ПолнаяКарта.Вставить("ЛегкаяПромышленность", КодТоварнойГруппыЛегПром());
		ПолнаяКарта.Вставить("Обувь", КодТоварнойГруппыОбувь());
		ПолнаяКарта.Вставить("Табак", КодТоварнойГруппыТабак());
		ПолнаяКарта.Вставить("Духи", КодТоварнойГруппыДухи());
		ПолнаяКарта.Вставить("Шины", КодТоварнойГруппыШины());
		ПолнаяКарта.Вставить("Фотоаппараты", КодТоварнойГруппыФотоаппараты());
		ПолнаяКарта.Вставить("МолочнаяПродукцияПодконтрольнаяВЕТИС", КодТоварнойГруппыМолочка());
		ПолнаяКарта.Вставить("МолочнаяПродукцияБезВЕТИС", КодТоварнойГруппыМолочка());
		ПолнаяКарта.Вставить("Велосипеды", КодТоварнойГруппыВелосипеды());
		ПолнаяКарта.Вставить("КреслаКоляски", КодТоварнойГруппыКреслаКоляски());
		ПолнаяКарта.Вставить("АльтернативныйТабак", КодТоварнойГруппыАльтернативныйТабак());
		ПолнаяКарта.Вставить("УпакованнаяВода", КодТоварнойГруппыУпакованнаяВода());
		ПолнаяКарта.Вставить("ПродукцияИзНатуральногоМеха", КодТоварнойГруппыНатуральныйМех());
		ПолнаяКарта.Вставить("Пиво", КодТоварнойГруппыПиво());
		ПолнаяКарта.Вставить("Алкогольная", КодТоварнойГруппыПиво());
		ПолнаяКарта.Вставить("НикотиносодержащаяПродукция", КодТоварнойГруппыНикотиносодержащаяПродукция());
		ПолнаяКарта.Вставить("БАДы", КодТоварнойГруппыБАД());
		ПолнаяКарта.Вставить("Антисептики", КодТоварнойГруппыАнтисептики());
		ПолнаяКарта.Вставить("СоковаяПродукция", КодТоварнойГруппыБезалкогольныеНапитки());
		ПолнаяКарта.Вставить("БезалкогольноеПиво", КодТоварнойГруппыБезалкогольныеНапитки());
		ПолнаяКарта.Вставить("ПивоВПотребительскихУпаковках", КодТоварнойГруппыПиво());
		
		ВсеЗначения = МетаданныеВидыПродукцииИС.ЗначенияПеречисления;
		Менеджер = Перечисления.ВидыПродукцииИС;
		
		Для Каждого КлючЗначение Из ПолнаяКарта Цикл
			Если ВсеЗначения.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
				Карта.Вставить(Менеджер[КлючЗначение.Ключ], КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Карта.Вставить(Менеджер.ПустаяСсылка(), КодТоварнойГруппыПусто());
		
	КонецЕсли;
	
	_ПравилаКонвертацииВидаПродукцииИСМП = Новый ФиксированноеСоответствие(Карта);
	
	Возврат _ПравилаКонвертацииВидаПродукцииИСМП;
	
КонецФункции

// Преобразовывает вид упаковки подсистемы ИСМП во внутренее представление.
//
// Параметры:
//  ВидУпаковкиИСМП - ПеречислениеСсылка.ВидыУпаковокИС - вид упаковки в формате ИСМП.
//  ПравилаКонвертацииУпаковок - Соответствие - правила преобразования (см. ПравилаКонвертацииУпаковокИСМП)
// 
// Возвращаемое значение:
//  Строка - Возможные значения описаны функциями УпаковкаПотребительская(), УпаковкаЛогистическая() и УпаковкаГрупповая()
//
Функция ВидУпаковкиПоДаннымИСМП(ВидУпаковкиИСМП)
	
	ПравилаКонвертацииУпаковок = ПравилаКонвертацииУпаковокИСМП();
	ЗначениеПоУмолчанию = УпаковкаПотребительская();
	
	Результат = ПравилаКонвертацииУпаковок.Получить(ВидУпаковкиИСМП);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует правила преобразования видов упаковок подсистемы ИСМП во внутреннее представление,
// которое используется для заполнения развернутой таблицы упаковок.
// 
// Возвращаемое значение:
//  ФиксированноеСоответствие:
//   * Ключ - ПеречислениеСсылка.ВидыУпаковокИС - вид упаковки в формате ИСМП.
//   * Значение - Строка - Внутреннее представление вида упаковки.
//
Функция ПравилаКонвертацииУпаковокИСМП()
	
	Если _ПравилаКонвертацииУпаковокИСМП <> Неопределено Тогда
		Возврат _ПравилаКонвертацииУпаковокИСМП;
	КонецЕсли;
	
	Карта = Новый Соответствие;
	
	МетаданныеВидыУпаковокИС = Метаданные.Перечисления.Найти("ВидыУпаковокИС");
	Если МетаданныеВидыУпаковокИС <> Неопределено Тогда
		
		ВидыУпаковокИСМП = Перечисления.ВидыУпаковокИС;
		
		Карта.Вставить(ВидыУпаковокИСМП.Групповая, УпаковкаГрупповая());
		Карта.Вставить(ВидыУпаковокИСМП.Логистическая, УпаковкаЛогистическая());
		Карта.Вставить(ВидыУпаковокИСМП.Потребительская, УпаковкаПотребительская());
		
		ЕстьОбъемноСортовойУчет = МетаданныеВидыУпаковокИС.ЗначенияПеречисления.Найти("ОбъемноСортовойУчет") <> Неопределено;
		Если ЕстьОбъемноСортовойУчет Тогда
			Карта.Вставить(ВидыУпаковокИСМП.ОбъемноСортовойУчет, УпаковкаОбъемноСортовойУчет());
		КонецЕсли;
		
		ЕстьПартионныйУчет = (МетаданныеВидыУпаковокИС.ЗначенияПеречисления.Найти("ПартионныйУчет") <> Неопределено);
		Если ЕстьПартионныйУчет Тогда
			Карта.Вставить(ВидыУпаковокИСМП.ПартионныйУчет, ПартионныйУчет());
		КонецЕсли;
		
	КонецЕсли;
	
	_ПравилаКонвертацииУпаковокИСМП = Новый ФиксированноеСоответствие(Карта);
	
	Возврат _ПравилаКонвертацииУпаковокИСМП;
	
КонецФункции

// Проверяет, есть ли у объекта метаданных табличная часть с штрихкодами упаковок товаров.
//
// Параметры:
