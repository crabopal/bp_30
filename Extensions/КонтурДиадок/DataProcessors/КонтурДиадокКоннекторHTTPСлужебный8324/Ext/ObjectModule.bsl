#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// Служебный программный интерфейс

// Объект защищенного соединения лок.
// 
// Параметры:
//  ДополнительныеПараметры - Структура - Дополнительные параметры:
//  * ПроверятьSSL - Булево - ПроверятьSSL 
//                 - СертификатыУдостоверяющихЦентровФайл - Доступен, начиная с версии 8.3.1.
//                 - СертификатыУдостоверяющихЦентровWindows - Доступен, начиная с версии 8.3.1.
//                 - СертификатыУдостоверяющихЦентровОС - Доступен, начиная с версии 8.3.8.
//                 - СертификатыУдостоверяющихЦентровLinux - Доступен, начиная с версии 8.3.8.
//  * ПроверятьКриптоПро - Булево - Создание ЗащищенноеСоединениеКриптоПро.
//                                  Имеет более высокий приоритет над ПроверятьSSL. Доступен, начиная с версии 8.3.24.
//                       - СертификатыУдостоверяющихЦентровФайл - Доступен, начиная с версии 8.3.1.
//                       - СертификатыУдостоверяющихЦентровОС - Доступен, начиная с версии 8.3.8.
//  * КлиентскийСертификатSSL - Неопределено - используется для создания защищенного соединения
//                                             ЗащищенноеСоединениеКриптоПро и ЗащищенноеСоединениеOpenSSL
//                            - СертификатКлиентаФайл - 
//                            - СертификатКлиентаWindows -
//                            - СертификатКлиентаMacOS - Доступен, начиная с версии 8.3.13.
//                            - СертификатКлиентаОС - Доступен, начиная с версии 8.3.21.
//                            - СертификатКлиентаLinux - Доступен, начиная с версии 8.3.21.
//                            - СертификатКриптографии -
// 
// Возвращаемое значение:
//  - ЗащищенноеСоединениеOpenSSL - Объект защищенного соединения SSL
//  - ЗащищенноеСоединениеКриптоПро - Объект защищенного соединения КриптоПро
//  
Функция ОбъектЗащищенногоСоединенияЛок(ДополнительныеПараметры) Экспорт
	
	ВозвращатьКриптоПро = Ложь;
	
	СертификатыУЦ = Неопределено;
	КлиентскийСертификат = Неопределено;
	
	Если ТипЗнч(ДополнительныеПараметры.КлиентскийСертификатSSL) = Тип("СертификатКлиентаФайл")
		Или ТипЗнч(ДополнительныеПараметры.КлиентскийСертификатSSL) = Тип("СертификатКлиентаWindows")
		Или ТипЗнч(ДополнительныеПараметры.КлиентскийСертификатSSL) = Тип("СертификатКлиентаОС")
		Или ТипЗнч(ДополнительныеПараметры.КлиентскийСертификатSSL) = Тип("СертификатКлиентаLinux")
		Или ТипЗнч(ДополнительныеПараметры.КлиентскийСертификатSSL) = Тип("СертификатКлиентаMacOS")
		Или ТипЗнч(ДополнительныеПараметры.КлиентскийСертификатSSL) = Тип("СертификатКриптографии") Тогда
		
		КлиентскийСертификат = ДополнительныеПараметры.КлиентскийСертификатSSL;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.ПроверятьКриптоПро = Истина Тогда
		
		ВозвращатьКриптоПро = Истина;
		
	ИначеЕсли ТипЗнч(ДополнительныеПараметры.ПроверятьКриптоПро) = Тип("СертификатыУдостоверяющихЦентровФайл")
		Или ТипЗнч(ДополнительныеПараметры.ПроверятьКриптоПро) = Тип("СертификатыУдостоверяющихЦентровОС") Тогда
			
		СертификатыУЦ = ДополнительныеПараметры.ПроверятьКриптоПро;
		ВозвращатьКриптоПро = Истина;
		
	КонецЕсли;
	
	Если Не ВозвращатьКриптоПро Тогда
		
		Если ТипЗнч(ДополнительныеПараметры.ПроверятьSSL) = Тип("СертификатыУдостоверяющихЦентровФайл")
			Или ТипЗнч(ДополнительныеПараметры.ПроверятьSSL) = Тип("СертификатыУдостоверяющихЦентровОС")
			Или ТипЗнч(ДополнительныеПараметры.ПроверятьSSL) = Тип("СертификатыУдостоверяющихЦентровWindows")
			Или ТипЗнч(ДополнительныеПараметры.ПроверятьSSL) = Тип("СертификатыУдостоверяющихЦентровLinux") Тогда

			СертификатыУЦ = ДополнительныеПараметры.ПроверятьSSL;

		КонецЕсли;
		
		Возврат Новый ЗащищенноеСоединениеOpenSSL(КлиентскийСертификат, СертификатыУЦ);
		
	Иначе
		
		Возврат Новый ЗащищенноеСоединениеКриптоПро(КлиентскийСертификат, СертификатыУЦ);
		
	КонецЕсли;

КонецФункции

#КонецЕсли