// Создает провайдер текущей конфигурации и привязывает его к учетному документу.
// Параметры:
//  ДокСсылка - ДокументСсылка - учетный документ.
// Возвращаемое значение:
//  ОбработкаОбъект - провайдер текущей конфигурации; не Неопределено.
Функция СоздатьПровайдер(ДокСсылка) Экспорт
	
	ИдентификаторПровайдера = ИмяПровайдера();
	Если ИдентификаторПровайдера = ИдентификаторПровайдераERP() Тогда
		Результат = НовыйПровайдерERP();
	ИначеЕсли ИдентификаторПровайдера = ИдентификаторПровайдераУНФ() Тогда
		Результат = НовыйПровайдерУНФ();
	ИначеЕсли ИдентификаторПровайдера = ИдентификаторПровайдераБП3() Тогда
		Результат = НовыйПровайдерБП3();
	Иначе
		ТекстОшибки = НСтр("ru='Сбор контента не поддерживается в данной версии конфигурации!'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Результат.УстановитьДокумент(ДокСсылка);
	Возврат Результат;
	
КонецФункции

// Возвращает идентификатор провайдера для текущей конфигурации информационной базы.
// Возвращаемое значение:
//  Строка - идентификатор провайдера; пустая строка, если имя конфигурации неизвестно.
Функция ИмяПровайдера() Экспорт
	
	Результат = ИмяПровайдераДляКонфигурации(Метаданные.Имя, Метаданные.Версия);
	Возврат Результат;
	
КонецФункции

// Определяет идентификатор провайдера по имени конфигурации.
// Параметры:
//  ИмяКонфигурации - Строка - имя конфигурации (Метаданные.Имя);
//  ВерсияКонфигурации - Строка - версия конфигурации (Метаданные.Версия); на выбор не влияет.
// Возвращаемое значение:
//  Строка - идентификатор провайдера; пустая строка, если имя конфигурации неизвестно.
Функция ИмяПровайдераДляКонфигурации(ИмяКонфигурации, ВерсияКонфигурации) Экспорт
	
	Результат = "";
	ОписаниеЗаданнойКонфигурации = ОписаниеКонфигурации(ИмяКонфигурации, ВерсияКонфигурации);
	
	Для Каждого ОписаниеПровайдера Из ОписанияПровайдеров() Цикл
		Если ЭтоИзвестнаяКонфигурация(
			ОписаниеПровайдера.МинимальныеВерсииКонфигураций,
			ОписаниеЗаданнойКонфигурации) Тогда
			Результат = ОписаниеПровайдера.Идентификатор;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает идентификатор провайдера линейки ERP, УТ, КА и управления холдингом.
// Возвращаемое значение:
//  Строка - идентификатор провайдера; не пустая.
Функция ИдентификаторПровайдераERP() Экспорт
	
	Возврат "ПровайдерERP";
	
КонецФункции

// Возвращает идентификатор провайдера линейки БП3, управления холдингом и аренды и управления недвижимостью.
// Возвращаемое значение:
//  Строка - идентификатор провайдера; не пустая.
Функция ИдентификаторПровайдераБП3() Экспорт
	
	Возврат "ПровайдерБП3";
	
КонецФункции

// Возвращает идентификатор провайдера конфигурацй УНФ и Розница.
// 
// Возвращаемое значение:
//  Строка - идентификатор провайдера; не пустая.
//
Функция ИдентификаторПровайдераУНФ() Экспорт
	
	Возврат "ПровайдерУНФ";
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МЕТОДЫ

Функция НовыйПровайдерERP()
	
	Если ЭтоВнешняяОбработка() Тогда
		Результат = Новый("ExternalDataProcessorObject.КонтурДиадокКонтентПровайдерERP");
	Иначе
		Результат = Новый("DataProcessorObject.КонтурДиадокКонтентПровайдерERP");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйПровайдерБП3()
	
	Если ЭтоВнешняяОбработка() Тогда
		Результат = Новый("ExternalDataProcessorObject.КонтурДиадокКонтентПровайдерБП3");
	Иначе
		Результат = Новый("DataProcessorObject.КонтурДиадокКонтентПровайдерБП3");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйПровайдерУНФ()
	
	Если ЭтоВнешняяОбработка() Тогда
		Результат = Новый("ExternalDataProcessorObject.КонтурДиадокКонтентПровайдерУНФ");
	Иначе
		Результат = Новый("DataProcessorObject.КонтурДиадокКонтентПровайдерУНФ");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписанияПровайдеров()
	
	Результат = Новый Массив;
	
	Результат.Добавить(ОписаниеПровайдераERP());
	Результат.Добавить(ОписаниеПровайдераБП3());
	Результат.Добавить(ОписаниеПровайдераУНФ());
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеПровайдераERP()
	
	ИдентификаторERP = ИдентификаторПровайдераERP();
	МинимальныеВерсииКонфигураций = МинимальныеВерсииКонфигурацийПровайдераERP();
	Результат = ОписаниеПровайдера(ИдентификаторERP, МинимальныеВерсииКонфигураций);
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеПровайдераБП3()
	
	ИдентификаторБП3 = ИдентификаторПровайдераБП3();
	МинимальныеВерсииКонфигураций = МинимальныеВерсииКонфигурацийПровайдераБП3();
	Результат = ОписаниеПровайдера(ИдентификаторБП3, МинимальныеВерсииКонфигураций);
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеПровайдераУНФ()
	
	ИдентификаторУНФ = ИдентификаторПровайдераУНФ();
	МинимальныеВерсииКонфигураций = МинимальныеВерсииКонфигурацийПровайдераУНФ();
	Результат = ОписаниеПровайдера(ИдентификаторУНФ, МинимальныеВерсииКонфигураций);
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеПровайдера(Идентификатор, МинимальныеВерсииКонфигураций)
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", Идентификатор);
	Результат.Вставить("МинимальныеВерсииКонфигураций", МинимальныеВерсииКонфигураций);
	
	Возврат Результат;
	
КонецФункции

// Возвращает минимальные версии конфигураций, на которые рассчитана библиотека.
// При выборе провайдера проверяется только имя конфигурации:
// более ранние версии тоже могут работать.
// Возвращаемое значение:
//  Массив - описания конфигураций с полями Имя и Версия.
Функция МинимальныеВерсииКонфигурацийПровайдераERP()
	
	Результат = Новый Массив;
	ИмяУправлениеПредприятием = "УправлениеПредприятием";
	ИмяКомплекснаяАвтоматизация = "КомплекснаяАвтоматизация";
	ИмяУправлениеТорговлей = "УправлениеТорговлей";
	
	Результат.Добавить(ОписаниеКонфигурации(ИмяУправлениеПредприятием, "2.4.14"));
	Результат.Добавить(ОписаниеКонфигурации(ИмяУправлениеПредприятием, "2.5.17"));
	Результат.Добавить(ОписаниеКонфигурации(ИмяУправлениеПредприятием, "2.6.1"));
	
	Результат.Добавить(ОписаниеКонфигурации("УправлениеХолдингомERP", "3.2.8"));
	Результат.Добавить(ОписаниеКонфигурации("УправлениеХолдингомERP", "3.1.8"));
	
	Результат.Добавить(ОписаниеКонфигурации(ИмяКомплекснаяАвтоматизация, "2.4.14"));
	Результат.Добавить(ОписаниеКонфигурации(ИмяКомплекснаяАвтоматизация, "2.5.22"));
	Результат.Добавить(ОписаниеКонфигурации(ИмяКомплекснаяАвтоматизация, "2.6.1"));
	
	Результат.Добавить(ОписаниеКонфигурации(ИмяУправлениеТорговлей, "11.4.14"));
	Результат.Добавить(ОписаниеКонфигурации(ИмяУправлениеТорговлей, "11.5.22"));
	Результат.Добавить(ОписаниеКонфигурации(ИмяУправлениеТорговлей, "11.6.1"));
	
	Возврат Результат;
	
КонецФункции

// Возвращает минимальные версии конфигураций, на которые рассчитана библиотека.
// При выборе провайдера проверяется только имя конфигурации:
// более ранние версии тоже могут работать.
// Возвращаемое значение:
//  Массив - описания конфигураций с полями Имя и Версия.
Функция МинимальныеВерсииКонфигурацийПровайдераБП3()
	
	Результат = Новый Массив;
	
	МинимальнаяВерсияБП = "3.0.180";
	
	Результат.Добавить(ОписаниеКонфигурации("БухгалтерияПредприятия", МинимальнаяВерсияБП));
	Результат.Добавить(ОписаниеКонфигурации("БухгалтерияПредприятияКОРП", МинимальнаяВерсияБП));
	Результат.Добавить(ОписаниеКонфигурации("БухгалтерияПредприятияБазовая", МинимальнаяВерсияБП));
	Результат.Добавить(ОписаниеКонфигурации("БухгалтерияПредприятияБазовая1", МинимальнаяВерсияБП));
	
	ИмяУправлениеХолдингом = "УправлениеХолдингом";
	
	Результат.Добавить(ОписаниеКонфигурации("АрендаИУправлениеНедвижимостью", "3.0.177"));
	Результат.Добавить(ОписаниеКонфигурации(ИмяУправлениеХолдингом, "3.1.17"));
	Результат.Добавить(ОписаниеКонфигурации(ИмяУправлениеХолдингом, "3.2.10"));
	Результат.Добавить(ОписаниеКонфигурации(ИмяУправлениеХолдингом, "3.3.1"));
	
	Возврат Результат;
	
КонецФункции

// Возвращает минимальные версии конфигураций УНФ, на которые рассчитана библиотека.
//  При выборе провайдера проверяется только имя конфигурации:
//  более ранние версии тоже могут работать.
// 
// Возвращаемое значение:
//  Массив - описания конфигураций с полями Имя и Версия.
//
Функция МинимальныеВерсииКонфигурацийПровайдераУНФ()
	// BSLLS:DuplicateStringLiteral-off
	
	Результат = Новый Массив;
	
	УправлениеНебольшойФирмой = "УправлениеНебольшойФирмой";
	УправлениеНебольшойФирмойБазовая = "УправлениеНебольшойФирмойБазовая";
	
	Розница = "Розница";
	РозницаБазовая = "РозницаБазовая";
	
	Результат.Добавить(ОписаниеКонфигурации(УправлениеНебольшойФирмой, "1.6.27"));
	Результат.Добавить(ОписаниеКонфигурации(УправлениеНебольшойФирмойБазовая, "1.6.27"));
	
	Результат.Добавить(ОписаниеКонфигурации(УправлениеНебольшойФирмой, "3.0.12"));
	Результат.Добавить(ОписаниеКонфигурации(УправлениеНебольшойФирмойБазовая, "3.0.12"));
	
	Результат.Добавить(ОписаниеКонфигурации(Розница, "3.0.12"));
	Результат.Добавить(ОписаниеКонфигурации(РозницаБазовая, "3.0.12"));
	
	Возврат Результат;
	
	// BSLLS:DuplicateStringLiteral-on
КонецФункции

Функция ОписаниеКонфигурации(Имя, Версия)
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Версия", Версия);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоИзвестнаяКонфигурация(МинимальныеВерсииКонфигураций, ОписаниеТекущейКонфигурации)
	
	Результат = Ложь;
	
	Для Каждого ОписаниеКонфигурации Из МинимальныеВерсииКонфигураций Цикл
		ИдентификаторКонфигурацииСовпадает = ВРег(ОписаниеКонфигурации.Имя) = ВРег(ОписаниеТекущейКонфигурации.Имя);
		
		Если ИдентификаторКонфигурацииСовпадает Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ИНИЦИАЛИЗАЦИЯ

Функция ЭтоВнешняяОбработка()

	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
	ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);

	Возврат ПараметрыПроверки.ИспользуемоеИмяФайла <> Неопределено;

КонецФункции
