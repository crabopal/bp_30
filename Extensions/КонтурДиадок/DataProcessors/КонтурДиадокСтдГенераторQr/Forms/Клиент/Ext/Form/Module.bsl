// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
&НаКлиенте
Перем
ШиринаКолонки, 
ВысотаСтроки,
ОтступЯчеек,
РазмерДанных,
Версия,
Текст,
БайтыДанных,
ЕмкостьДанных;
// BSLLS:MissingVariablesDescription-on

// QR в табличный документ без внешних компонент и HTTP.
// Уровень коррекции L, режим Byte (UTF-8): версия матрицы 1-5 выбирается автоматически по длине UTF-8.
// Маска 000; выравнивающие узоры по ISO/IEC 18004 (для версий 2-5).

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Генерирует табличный документ с изоброжением qr кода, минимальной версии 1-5: L, Byte (UTF-8).
//
// Параметры:
//  Значение - Строка - данные для кодирования (UTF-8, до МаксимальныйРазмерДанных() байт при поддерживаемых версиях).
//
// Возвращаемое значение:                               
// 	ФиксированнаяСтруктура - см. МодельРезультатаГенерацииQRКода
//
&НаКлиенте
Функция Сформировать(Значение) Экспорт
	
	Инициализировать(Значение);
	
	Возврат СформироватьQR(Текст);
	
КонецФункции

// Строит матрицу QR (Массив из Массивов Булево) минимальной версии 1-5: L, Byte (UTF-8).
//
// Параметры:
//  Значение - Строка - данные для кодирования (UTF-8, до МаксимальныйРазмерДанных() байт при поддерживаемых версиях).
//
// Возвращаемое значение:
// 	Массив - массив данных (Массив из Массивов Булево)
//
&НаКлиенте
Функция СформироватьМатрицу(Значение) Экспорт
		
	Инициализировать(Значение);
	
	Возврат СобратьМатрицуПоБайтам();
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Функция МодельРезультатаГенерацииQRКода()
	
	Результат = Новый Структура;
	Результат.Вставить("ТабличныйДокумент");
	Результат.Вставить("Ширина");
	Результат.Вставить("Высота");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура Инициализировать(Значение)
	
	Текст = Значение;
	БайтыДанных = БайтыСтроки();
	РазмерДанных = БайтыДанных.Количество();
	ЕмкостьДанных = ЕмкостьДанных(РазмерДанных);
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьQR(Значение)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Матрица = СформироватьМатрицу(Текст);
	ВывестиМатрицуQRВТабличныйДокумент(Матрица, ТабличныйДокумент);
	
	Результат = МодельРезультатаГенерацииQRКода();
	
	ДлинаОтступаШирина = 4;
	ДлинаОтступаВысота = 6;
	КоэффициентВысоты  = 3;
	
	Результат.ТабличныйДокумент = ТабличныйДокумент;
	Результат.Ширина = РазмерМатрицы() + ДлинаОтступаШирина;
	Результат.Высота = Цел((РазмерМатрицы() + ДлинаОтступаВысота) / КоэффициентВысоты);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

&НаКлиенте
Функция СобратьМатрицуПоБайтам()
	
	Если РазмерДанных > МаксимальныйРазмерДанных() Тогда
		ВызватьИсключение ТекстОшибкиБольшиеДанные();
	КонецЕсли;
	
	Возврат ПостроитьМатрицу();
	
КонецФункции

&НаКлиенте
Процедура ВывестиМатрицуQRВТабличныйДокумент(Матрица, ТабличныйДокумент)
	
	ДобавитьЯчеек = 2;
	
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ЛинияБезГраницы = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
	Размер = Матрица.Количество();
	Всего = Размер + ДобавитьЯчеек * ОтступЯчеек;
	
	Для ИндексСтроки = 1 По Всего Цикл
		ОбластьСтрока = ТабличныйДокумент.Область(ИндексСтроки, , ИндексСтроки);
		ОбластьСтрока.ВысотаСтроки = ВысотаСтроки;
		ОбластьСтрока.АвтоВысотаСтроки = Ложь;
	КонецЦикла;
	
	Для ИндексКолонки = 1 По Всего Цикл
		ОбластьКолонка = ТабличныйДокумент.Область(, ИндексКолонки, , ИндексКолонки);
		ОбластьКолонка.ШиринаКолонки = ШиринаКолонки;
	КонецЦикла;
	
	// BSLLS:StyleElementConstructors-off
	БелыйЗначение = 255;
	Черный = Новый Цвет(0, 0, 0);
	Белый = Новый Цвет(БелыйЗначение, БелыйЗначение, БелыйЗначение);
	// BSLLS:StyleElementConstructors-on
	
	Для Ряд = 0 По Всего - 1 Цикл
		
		Для Колонка = 0 По Всего - 1 Цикл
			
			ОбластьЯчейка = ТабличныйДокумент.Область(Ряд + 1, Колонка + 1, Ряд + 1, Колонка + 1);
			ОбластьЯчейка.ГраницаСлева = ЛинияБезГраницы;
			ОбластьЯчейка.ГраницаСверху = ЛинияБезГраницы;
			ОбластьЯчейка.ГраницаСправа = ЛинияБезГраницы;
			ОбластьЯчейка.ГраницаСнизу = ЛинияБезГраницы;
			Внутри = (Ряд >= ОтступЯчеек 
				И Ряд < ОтступЯчеек + Размер 
				И Колонка >= ОтступЯчеек 
				И Колонка < ОтступЯчеек + Размер);
			
			Если Внутри Тогда
				Если Матрица[Ряд - ОтступЯчеек][Колонка - ОтступЯчеек] Тогда
					ОбластьЯчейка.ЦветФона = Черный;
				Иначе
					ОбластьЯчейка.ЦветФона = Белый;
				КонецЕсли;
			Иначе
				ОбластьЯчейка.ЦветФона = Белый;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПостроитьМатрицу() 
	
	// BSLLS:Typo-off
	ИндексПаддинга = 0;	
	// BSLLS:Typo-on
	Два = 2;
	Бит4 = 4;
	
	ПотокБитов = Новый Массив; // массив из 0/1
	ДобавитьБиты(ПотокБитов, Бит4, КоличествоБит4()); // 0100 - Byte mode
	ДобавитьБиты(ПотокБитов, РазмерДанных, БитВБайте()); // счётчик для версий 1..9
	
	Для Каждого Байт Из БайтыДанных Цикл
		ДобавитьБиты(ПотокБитов, Байт, БитВБайте());
	КонецЦикла;
	
	ДобавитьБиты(ПотокБитов, 0, Мин(БитВТерминаторе(), ЕмкостьДанных - ПотокБитов.Количество())); // Terminator
	
	Пока ПотокБитов.Количество() % БитВБайте() <> 0 Цикл
		ПотокБитов.Добавить(0);
	КонецЦикла;	
	
	Пока ПотокБитов.Количество() < ЕмкостьДанных Цикл
		Если ИндексПаддинга % Два = 0 Тогда
			ДобавитьБиты(ПотокБитов, МагическоеЧислоРидаСоломона1(), БитВБайте());
		Иначе
			ДобавитьБиты(ПотокБитов, МагическоеЧислоРидаСоломона2(), БитВБайте());
		КонецЕсли;
		// BSLLS:Typo-off
		ИндексПаддинга = ИндексПаддинга + 1;
		// BSLLS:Typo-on
	КонецЦикла;
	
	КодовыеСловаДанных = Новый Массив;
	Для Номер = 0 По ЧислоКодовыхСлов(РазмерДанных) - 1 Цикл
		КодовыеСловаДанных.Добавить(БайтИзБитов(ПотокБитов, Номер * БитВБайте()));
	КонецЦикла;
	
	КодовыеСловаEC = ВычислитьКодовыеСловаКоррекции(КодовыеСловаДанных, 
		КоличествоКодовыхСловКоррекцииОшибок(РазмерДанных)); 
	
	ПолныйПоток = Новый Массив;
	Для Ном = 0 По КодовыеСловаДанных.Количество() - 1 Цикл
		ДобавитьБиты(ПолныйПоток, КодовыеСловаДанных[Ном], БитВБайте());
	КонецЦикла;
	Для Ном = 0 По КодовыеСловаEC.Количество() - 1 Цикл
		ДобавитьБиты(ПолныйПоток, КодовыеСловаEC[Ном], БитВБайте());
	КонецЦикла;
	
	Матрица = ИнициализироватьМатрицу();
	УстановитьТаймингПоРазмеру(Матрица);
	РазместитьПоисковыеМаркерыИРазделители(Матрица);
	РазместитьВыравнивающийУзор(Матрица, РазмерДанных);
	Матрица[СтрокаЗаглушки(РазмерДанных)][8] = Истина;
	Матрица[8][8] = Истина; // до финальной форматной информации; маска эту ячейку не трогает
	
	ЗаполнитьБитовыйПотокВМатрицу(Матрица, ПолныйПоток);
	
	Маска = 0; // фиксированная маска 000 для простоты (валидно)
	ПрименитьМаску(Матрица, Маска);
	ДобавитьФорматнуюИнформацию(Матрица, Маска);
	
	Возврат Матрица;
	
КонецФункции

&НаКлиенте
Функция БайтыСтроки()
	
	Результат = Новый Массив;
	
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		КодСимвола = КодСимвола(Сред(Текст, Позиция, 1));
		ДобавитьБайтыЮТФ8ПоКодуСимвола(Результат, КодСимвола);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьБайтыЮТФ8ПоКодуСимвола(МассивБайт, КодСимвола)
	
	Если КодСимвола < 128 Тогда
		// 1 байт: 0xxxxxxx
		МассивБайт.Добавить(КодСимвола);
		
	ИначеЕсли КодСимвола < 2048 Тогда
		// 2 байта: 110xxxxx 10xxxxxx
		МассивБайт.Добавить(192 + Цел(КодСимвола / 64));
		МассивБайт.Добавить(128 + (КодСимвола % 64));
		
	ИначеЕсли КодСимвола < 65536 Тогда
		// 3 байта: 1110xxxx 10xxxxxx 10xxxxxx
		МассивБайт.Добавить(224 + Цел(КодСимвола / 4096));
		МассивБайт.Добавить(128 + Цел((КодСимвола % 4096) / 64));
		МассивБайт.Добавить(128 + (КодСимвола % 64));
		
	Иначе
		// 4 байта: для редких символов > U+FFFF
		МассивБайт.Добавить(240 + Цел(КодСимвола / 262144));
		МассивБайт.Добавить(128 + Цел((КодСимвола % 262144) / 4096));
		МассивБайт.Добавить(128 + Цел((КодСимвола % 4096) / 64));
		МассивБайт.Добавить(128 + (КодСимвола % 64));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьБиты(Поток, Знач Значение, КоличествоБит)
	
	Для НомерБита = 0 По КоличествоБит - 1 Цикл
		
		Сдвиг = КоличествоБит - 1 - НомерБита;
		Если ПобитовоеИЛок(Значение, ПобитовыйСдвигВлевоЛок(1, Сдвиг)) <> 0 Тогда
			Поток.Добавить(1);
		Иначе
			Поток.Добавить(0);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция БайтИзБитов(Поток, Смещение)
	
	Результат = 0;
	Для НомБита = 0 По БитВБайте() - 1 Цикл
		Если Поток[Смещение + НомБита] = 1 Тогда
			Результат = ПобитовоеИлиЛок(Результат, ПобитовыйСдвигВлевоЛок(1, 7 - НомБита));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ИнициализироватьМатрицу()
	
	Возврат ИнициализироватьМатрицуКвадрат(РазмерМатрицы());
	
КонецФункции

&НаКлиенте
Функция ИнициализироватьМатрицуКвадрат(Размер)

	Результат = Новый Массив;
	
	Для Ряд = 0 По Размер - 1 Цикл
		
		ДанныеСтроки = Новый Массив;
		Для Колонка = 0 По Размер - 1 Цикл
			ДанныеСтроки.Добавить(Ложь);
		КонецЦикла;
		
		Результат.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция РазмерМатрицы()

	Если РазмерДанных <= РазмерВерсия1() Тогда
		Результат = 21;
	ИначеЕсли РазмерДанных <= РазмерВерсия2() Тогда
		Результат = 25;
	ИначеЕсли РазмерДанных <= РазмерВерсия3() Тогда
		Результат = 29;
	ИначеЕсли РазмерДанных <= РазмерВерсия4() Тогда
		Результат = 33;
	ИначеЕсли РазмерДанных <= РазмерВерсия5() Тогда
		Результат = 37;
	Иначе
		ВызватьИсключение ТекстОшибкиБольшиеДанные();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура РазместитьПоисковыеМаркерыИРазделители(Матрица)
	
	// Поисковые узоры 7×7 в углах + разделители (для квадратных матриц версий 1-5).
	Узор = Новый Массив;
	СтандартныйРазмер = 7;
	
	Для Ряд = 0 По СтандартныйРазмер - 1 Цикл
		
		Строка = Новый Массив;	
		Для Колонка = 0 По СтандартныйРазмер - 1 Цикл
			// Стандартный узор 7×7: внешняя рамка + внутренний квадрат 3×3 по центру; «кольцо» между ними - белое.
			Значение = (Ряд = 0 Или Ряд = 6 Или Колонка = 0 Или Колонка = 6)
				Или (Ряд >= 2 И Ряд <= 4 И Колонка >= 2 И Колонка <= 4);
			Строка.Добавить(Значение);
		КонецЦикла;
		
		Узор.Добавить(Строка);
		
	КонецЦикла;
	
	Для Ряд = 0 По СтандартныйРазмер - 1 Цикл
		Для Колонка = 0 По СтандартныйРазмер - 1 Цикл
			Матрица[Ряд][Колонка] = Узор[Ряд][Колонка];
		КонецЦикла;
	КонецЦикла;
	
	СмещениеВторогоУзла = Матрица.Количество() - СтандартныйРазмер;
	Для Ряд = 0 По СтандартныйРазмер - 1 Цикл
		Для Колонка = 0 По СтандартныйРазмер - 1 Цикл
			Матрица[Ряд][СмещениеВторогоУзла + Колонка] = Узор[Ряд][Колонка];
		КонецЦикла;
	КонецЦикла;
	
	Для Ряд = 0 По СтандартныйРазмер - 1 Цикл
		Для Колонка = 0 По СтандартныйРазмер - 1 Цикл
			Матрица[СмещениеВторогоУзла + Ряд][Колонка] = Узор[Ряд][Колонка];
		КонецЦикла;
	КонецЦикла;
	
	// Разделители вокруг узоров
	Размер = Матрица.Количество();
	Для НомРазд = 0 По СтандартныйРазмер Цикл
		
		Матрица[СтандартныйРазмер][НомРазд] = Ложь;
		Матрица[НомРазд][СтандартныйРазмер] = Ложь;
		Матрица[СтандартныйРазмер][Размер - 1 - НомРазд] = Ложь;
		Матрица[НомРазд][Размер - 8] = Ложь;
		Матрица[Размер - 1 - НомРазд][СтандартныйРазмер] = Ложь;
		Матрица[Размер - 8][НомРазд] = Ложь; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТаймингПоРазмеру(Матрица)
	
	// ISO 18004: чередование на всей строке 6 и столбце 6; зоны маяков задаются позже поверх.
	
	Делитель = 2;
	НомерРяда = 6;
	НомерКолонки = 6;
	
	Размер = Матрица.Количество();
	Для Колонка = 0 По Размер - 1 Цикл
		Матрица[НомерРяда][Колонка] = ((Колонка % Делитель) = 0);
	КонецЦикла;
	Для Ряд = 0 По Размер - 1 Цикл
		Матрица[Ряд][НомерКолонки] = ((Ряд % Делитель) = 0);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазместитьQRВыравнивающийУзор5x5ПоЦентру(Матрица, РядЦентр, КолонкаЦентр)
	
	Для Ряд = -2 По 2 Цикл
		Для Колонка = -2 По 2 Цикл
			// Модуль через Макс: max(|Ряд|,|Колонка|) как в ISO 18004 для узора 5×5.
			Матрица[РядЦентр + Ряд][КолонкаЦентр + Колонка] = (Макс(Макс(Ряд, -Ряд), Макс(Колонка, -Колонка)) <> 1);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазместитьВыравнивающийУзор(Матрица, Размер)
	
	Если Размер <= РазмерВерсия1() Тогда
		Возврат; // Не требуется
	ИначеЕсли Размер <= РазмерВерсия2() Тогда
		РазместитьВыравнивающийУзорВерсия2(Матрица);
	ИначеЕсли Размер <= РазмерВерсия3() Тогда
		РазместитьВыравнивающийУзорВерсия3(Матрица);
	ИначеЕсли Размер <= РазмерВерсия4() Тогда
		РазместитьВыравнивающийУзорВерсия4(Матрица);
	ИначеЕсли Размер <= РазмерВерсия5() Тогда
		РазместитьВыравнивающийУзорВерсия5(Матрица);
	Иначе
		ВызватьИсключение ТекстОшибкиБольшиеДанные();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазместитьВыравнивающийУзорВерсия2(Матрица)
	
	// Версия 2: один узор с центром (18,18) - Nayuki/qrcodegen.
	
	РядЦентр = 18;
	КолонкаЦентр = 18;
	
	РазместитьQRВыравнивающийУзор5x5ПоЦентру(Матрица, РядЦентр, КолонкаЦентр);
	
КонецПроцедуры

