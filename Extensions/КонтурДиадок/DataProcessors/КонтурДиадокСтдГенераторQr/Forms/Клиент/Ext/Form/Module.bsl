&НаКлиенте
Процедура ДобавитьФорматнуюИнформацию(Матрица, Маска)
	
	// 15 бит для L + маска 000. Строка MSB слева; индекс i = 0 - LSB (как get_bit в Nayuki).
	// В спецификации координаты (x, y) - столбец, строка; в матрице Матрица[Строка][Столбец] = Матрица[y][x].
	ФорматБиты = ФорматныеБитыLSBСначала("111011111000100");
	
	Размер = Матрица.Количество();
	
	// Первая копия (ISO / Nayuki _draw_format_bits)
	Для Ряд = 0 По 5 Цикл
		Матрица[Ряд][8] = (ФорматБиты[Ряд] = 1);
	КонецЦикла;
	Матрица[7][8] = (ФорматБиты[6] = 1);
	Матрица[8][8] = (ФорматБиты[7] = 1);
	Матрица[8][7] = (ФорматБиты[8] = 1);
	Для НомБита = 9 По 14 Цикл
		Матрица[8][14 - НомБита] = (ФорматБиты[НомБита] = 1);
	КонецЦикла;
	
	// Вторая копия
	Для НомБита = 0 По 7 Цикл
		Матрица[8][Размер - 1 - НомБита] = (ФорматБиты[НомБита] = 1);
	КонецЦикла;
	Для НомБита = 8 По 14 Цикл
		Матрица[Размер - 15 + НомБита][8] = (ФорматБиты[НомБита] = 1);
	КонецЦикла;
	Матрица[Размер - 8][8] = Истина; // всегда тёмный: (x,y) = (8, 13) → М[13][8]
	
КонецПроцедуры

&НаКлиенте
Функция ФорматныеБитыLSBСначала(Значение)
	
	Результат = Новый Массив;
	Для Индекс = 0 По 14 Цикл
		Символ = Сред(Значение, 15 - Индекс, 1);
		Если Символ = "1" Тогда
			Результат.Добавить(1);
		Иначе
			Результат.Добавить(0);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ВычислитьКодовыеСловаКоррекции(Сообщение, ЧислоСимволовEC)
	
	Логарифмы = ТаблицаЛогарифмовGF256();
	АнтиЛогарифмы = ТаблицаАнтиЛогарифмовGF256();
	
	Генератор = Новый Массив;
	Генератор.Добавить(1);
	
	Для НомСтепени = 0 По ЧислоСимволовEC - 1 Цикл
		МножительМногочлен = Новый Массив;
		МножительМногочлен.Добавить(1); // 1 + α^i·x (порядок коэффициентов: свободный член, x)
		МножительМногочлен.Добавить(АнтиЛогарифмы[НомСтепени]);
		Генератор = УмножитьМногочленыGF256(Генератор, МножительМногочлен, Логарифмы, АнтиЛогарифмы);
	КонецЦикла;
	
	Блок = Новый Массив;
	Для Каждого Элемент Из Сообщение Цикл
		Блок.Добавить(Элемент);
	КонецЦикла;
	Для Отступ = 1 По ЧислоСимволовEC Цикл
		Блок.Добавить(0);
	КонецЦикла;
	
	Для НомСимвола = 0 По Сообщение.Количество() - 1 Цикл
		Коэффициент = Блок[НомСимвола];
		Если Коэффициент = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для ПозицияКоэффициента = 1 По Генератор.Количество() - 1 Цикл
			Если Генератор[ПозицияКоэффициента] <> 0 Тогда                                
				Число1 = Блок[НомСимвола + ПозицияКоэффициента];
				Число2 = GF256Умножить(Коэффициент, Генератор[ПозицияКоэффициента], Логарифмы, АнтиЛогарифмы);
				Блок[НомСимвола + ПозицияКоэффициента] = ПобитовоеИсключительноеИлиЛок(Число1, Число2);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Результат = Новый Массив;
	Для НомОстатка = Сообщение.Количество() По Блок.Количество() - 1 Цикл
		Результат.Добавить(Блок[НомОстатка]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция GF256Умножить(Значение1, Значение2, Логарифм, Антилогарифм)
	
	Если Значение1 = 0 Или Значение2 = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Индекс = Логарифм[Значение1] + Логарифм[Значение2];
	Пока Индекс >= РазмерПолеГалуа() Цикл
		Индекс = Индекс - РазмерПолеГалуа();
	КонецЦикла;
	
	Возврат Антилогарифм[Индекс];
	
КонецФункции

&НаКлиенте
Функция УмножитьМногочленыGF256(Значение1, Значение2, Логарифм, Антилогарифм)
	
	Результат = Новый Массив;
	КорректорДва = 2;
	
	Для НомРез = 0 По Значение1.Количество() + Значение2.Количество() - КорректорДва Цикл
		Результат.Добавить(0);
	КонецЦикла;
	
	Для НомерЗначение1 = 0 По Значение1.Количество() - 1 Цикл
		Если Значение1[НомерЗначение1] = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для НомерЗначение2 = 0 По Значение2.Количество() - 1 Цикл
			Если Значение2[НомерЗначение2] = 0 Тогда
				Продолжить;
			КонецЕсли;                       
			Число1 = Результат[НомерЗначение1 + НомерЗначение2];
			Число2 = GF256Умножить(Значение1[НомерЗначение1], Значение2[НомерЗначение2], Логарифм, Антилогарифм);
			Результат[НомерЗначение1 + НомерЗначение2] = ПобитовоеИсключительноеИлиЛок(Число1, Число2);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция GF256УмножитьНаДва(Значение)
	
	Число2 = 128;
	Число3 = 285;
	Число4 = 255;
	
	Результат = ПобитовыйСдвигВлевоЛок(Значение, 1);
	Если ПобитовоеИЛок(Значение, Число2) <> 0 Тогда
		Результат = ПобитовоеИсключительноеИлиЛок(Результат, Число3); // 0x11D
	КонецЕсли;
	
	Возврат ПобитовоеИЛок(Результат, Число4);
	
КонецФункции

&НаКлиенте
Функция ТаблицаЛогарифмовGF256()
	
	Результат = Новый Массив;
	РазмерМассива = 255;
	
	Для Позиция = 0 По РазмерМассива Цикл
		Результат.Добавить(0);
	КонецЦикла;
	
	ЭлементМассива = 1;
	Для Степень = 0 По РазмерМассива - 1 Цикл
		Результат[ЭлементМассива] = Степень;
		ЭлементМассива = GF256УмножитьНаДва(ЭлементМассива);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ТаблицаАнтиЛогарифмовGF256()
	
	Результат = Новый Массив;
	РазмерМассива = 255;
	
	Для Позиция = 0 По РазмерМассива Цикл
		Результат.Добавить(0);
	КонецЦикла;
	
	ЭлементМассива = 1;
	Для Степень = 0 По РазмерМассива - 1 Цикл
		Результат[Степень] = ЭлементМассива;
		ЭлементМассива = GF256УмножитьНаДва(ЭлементМассива);
	КонецЦикла;
	
	Результат[РазмерМассива] = Результат[0];
	Возврат Результат;
	
КонецФункции

