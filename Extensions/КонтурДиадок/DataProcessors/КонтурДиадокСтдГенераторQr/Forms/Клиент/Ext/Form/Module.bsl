&НаКлиенте
Процедура ЗаполнитьБитовыйПотокВМатрицу(Матрица, ПотокБитов)
	
	ПоследнийИндекс = Матрица.Количество() - 1;
	НаправлениеВверх = Истина;
	Колонка = ПоследнийИндекс;
	БитИндекс = 0;
	
	Пока Колонка > 0 Цикл
		Если Колонка = 6 Тогда
			Колонка = Колонка - 1;
		КонецЕсли;
		
		Если НаправлениеВверх Тогда
			РядНачало = ПоследнийИндекс;
			РядКонец = 0;
			ШагРяд = -1;
		Иначе
			РядНачало = 0;
			РядКонец = ПоследнийИндекс;
			ШагРяд = 1;
		КонецЕсли;
		
		Ряд = РядНачало;
		Пока (ШагРяд = -1 И Ряд >= РядКонец) Или (ШагРяд = 1 И Ряд <= РядКонец) Цикл
			Для СмещениеКолонки = 0 По 1 Цикл
				ИндексКолонки = Колонка - СмещениеКолонки;
				Если Не Зарезервировано(Матрица, Ряд, ИндексКолонки, РазмерДанных) Тогда
					Если БитИндекс < ПотокБитов.Количество() Тогда
						Матрица[Ряд][ИндексКолонки] = (ПотокБитов[БитИндекс] = 1);
						БитИндекс = БитИндекс + 1;
					Иначе
						Матрица[Ряд][ИндексКолонки] = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Ряд = Ряд + ШагРяд;
		КонецЦикла;
		
		Колонка = Колонка - 2;
		НаправлениеВверх = Не НаправлениеВверх;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция Зарезервировано(Матрица, Ряд, Колонка, РазмерДанных)

	Если РазмерДанных <= РазмерВерсия1() Тогда
		Результат = ЗарезервированоВерсия1(Матрица, Ряд, Колонка);
	ИначеЕсли РазмерДанных <= РазмерВерсия2() Тогда
		Результат = ЗарезервированоВерсия2(Матрица, Ряд, Колонка);
	ИначеЕсли РазмерДанных <= РазмерВерсия3() Тогда
		Результат = ЗарезервированоВерсия3(Матрица, Ряд, Колонка);
	ИначеЕсли РазмерДанных <= РазмерВерсия4() Тогда
		Результат = ЗарезервированоВерсия4(Матрица, Ряд, Колонка);
	ИначеЕсли РазмерДанных <= РазмерВерсия5() Тогда
		Результат = ЗарезервированоВерсия5(Матрица, Ряд, Колонка);
	Иначе
		ВызватьИсключение ТекстОшибкиБольшиеДанные();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗарезервированоВерсия1(Матрица, Ряд, Колонка)
	
	Результат = (Ряд < 9 И Колонка < 9)
		Или (Ряд < 9 И Колонка > 12)
		Или (Ряд > 12 И Колонка < 9 )
		Или (Ряд = 6 Или Колонка = 6);
		
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗарезервированоВерсия2(Матрица, Ряд, Колонка)
	
	Размер = Матрица.Количество();
	Результат = (Ряд < 9 И Колонка < 9)
		Или (Ряд < 9 И Колонка >= Размер - 8)
		Или (Ряд >= Размер - 8 И Колонка < 9)
		Или (Ряд = 6 Или Колонка = 6)
		Или (Ряд >= 16 И Ряд <= 20 И Колонка >= 16 И Колонка <= 20);
	
	Возврат Результат;
	
КонецФункции

