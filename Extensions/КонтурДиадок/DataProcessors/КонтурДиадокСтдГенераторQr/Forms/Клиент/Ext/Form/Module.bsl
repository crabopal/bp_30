&НаКлиенте
Процедура ПрименитьМаску(Матрица, Маска)
	
	Если РазмерДанных <= РазмерВерсия1() Тогда
		ПрименитьМаскуВерсия1(Матрица, Маска);
	ИначеЕсли РазмерДанных <= РазмерВерсия2() Тогда
		ПрименитьМаскуВерсия2(Матрица, Маска);
	ИначеЕсли РазмерДанных <= РазмерВерсия3() Тогда
		ПрименитьМаскуВерсия3(Матрица, Маска);
	ИначеЕсли РазмерДанных <= РазмерВерсия4() Тогда
		ПрименитьМаскуВерсия4(Матрица, Маска);
	ИначеЕсли РазмерДанных <= РазмерВерсия5() Тогда
		ПрименитьМаскуВерсия5(Матрица, Маска);
	Иначе
		ВызватьИсключение ТекстОшибкиБольшиеДанные();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьМаскуВерсия1(Матрица, Маска)
	
	ГраницаМаски = 20;
	
	Для Ряд = 0 По ГраницаМаски Цикл
		Для Колонка = 0 По ГраницаМаски Цикл
			Если ЗарезервированоВерсия1(Матрица, Ряд, Колонка) Тогда
				Продолжить;
			КонецЕсли;
			Если Ряд = 8 И Колонка = 8 Тогда
				Продолжить;
			КонецЕсли;
			Применять = Ложь;
			Если Маска = 0 Тогда
				Применять = ((Ряд + Колонка) % 2 = 0);
			ИначеЕсли Маска = 1 Тогда
				Применять = (Ряд % 2 = 0);
			ИначеЕсли Маска = 2 Тогда
				Применять = (Колонка % 3 = 0);
			ИначеЕсли Маска = 3 Тогда
				Применять = ((Ряд + Колонка) % 3 = 0);
			ИначеЕсли Маска = 4 Тогда
				Применять = ((Цел(Колонка / 3) + Цел(Ряд / 2)) % 2 = 0);
			ИначеЕсли Маска = 5 Тогда
				Применять = (((Ряд * Колонка) % 2) + ((Ряд * Колонка) % 3) = 0);
			ИначеЕсли Маска = 6 Тогда
				Применять = ((((Ряд * Колонка) % 2) + ((Ряд * Колонка) % 3)) % 2 = 0);
			Иначе
				Применять = ((((Ряд + Колонка) % 2) + ((Ряд * Колонка) % 3)) % 2 = 0);
			КонецЕсли;
			Если Применять Тогда
				Матрица[Ряд][Колонка] = Не Матрица[Ряд][Колонка];
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

