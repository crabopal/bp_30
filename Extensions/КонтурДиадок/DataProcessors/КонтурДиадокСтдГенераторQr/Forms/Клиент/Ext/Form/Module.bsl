Функция ТекстОшибкиБольшиеДанные()
	
	Текст = "Для QR уровня L в режиме Byte (версии 1-%1%) допускается не более %2% байт в UTF-8.";
	
	Результат = СтрЗаменить(Текст, "%1%", МаксимальнаяПоддерживаемаяВерсия());
	Результат = СтрЗаменить(Результат, "%2%", МаксимальныйРазмерДанных());
			
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПобитовоеИЛок(Знач Число1, Знач Число2)
	
	Результат = 0;
	МаскаБита = 1;
	Делитель = 2;
	
	Пока Число1 > 0 Или Число2 > 0 Цикл
		
		Если Число1 % Делитель = 1 И Число2 % Делитель = 1 Тогда
			Результат = Результат + МаскаБита;
		КонецЕсли;
		
		МаскаБита = МаскаБита * Делитель;
		Число1 = Цел(Число1 / Делитель);
		Число2 = Цел(Число2 / Делитель);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПобитовоеИлиЛок(Знач Число1, Знач Число2)
	
	Результат = 0;
	Множитель = 1;
	Делитель = 2;
	
	ДлинаЦикла = 31;
	
	Для НомерБита = 0 По ДлинаЦикла Цикл
		БитА = Число1 % Делитель;
		БитБ = Число2 % Делитель;
		Если БитА = 1 Или БитБ = 1 Тогда
			Результат = Результат + Множитель;
		КонецЕсли;
		Число1 = Цел(Число1 / Делитель);
		Число2 = Цел(Число2 / Делитель);
		Множитель = Множитель * Делитель;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПобитовоеИсключительноеИлиЛок(Знач Число1, Знач Число2)
	
	Результат = 0;
	Множитель = 1;
	Делитель = 2;
	
	ДлинаЦикла = 31;
	
	Для НомерБита = 0 По ДлинаЦикла Цикл
		Если (Число1 % Делитель) <> (Число2 % Делитель) Тогда
			Результат = Результат + Множитель;
		КонецЕсли;
		Число1 = Цел(Число1 / Делитель);
		Число2 = Цел(Число2 / Делитель);
		Множитель = Множитель * Делитель;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПобитовыйСдвигВлевоЛок(Знач Число, Знач Сдвиг)
	
	Если Сдвиг <= 0 Тогда
		Возврат Число;
	КонецЕсли;
	
	Результат = Число;
	Для НомерСдвига = 1 По Сдвиг Цикл
		Результат = Результат * 2;
	КонецЦикла;
	
	// Как в 8.3+: аргументы - 32-битные без знака, старшие биты отбрасываются.
	Пока Результат > 4294967295 Цикл
		Результат = Результат - 4294967296;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

