// МАППИНГ В КОНТРАКТ

Функция СтрокаКодИНаименованиеСтраныДляКонтракта(СтранаСсылка)
	
	Результат = Новый Структура("КодСтраны, НаименованиеСтраны", "", "");

	РеквизитыСтраны = ЗначенияРеквизитовОбъектаЛок(СтранаСсылка, "Код, Наименование");
	
	Результат.КодСтраны = СокрЛП(РеквизитыСтраны.Код);
	Результат.НаименованиеСтраны = СокрЛП(РеквизитыСтраны.Наименование);
	
	Возврат Результат;
	
КонецФункции

Функция СведенияДТСтрокиКонтрактаУКД(СтрокаТЧ)
	
	Результат = Новый Массив;
	
	ЕстьСведенияДТ = ЗначениеЗаполнено(СтрокаТЧ.НомерГТД)
		Или ЗначениеЗаполнено(СтрокаТЧ.СтранаПроисхождения);
	
	Если Не ЕстьСведенияДТ Тогда
		Возврат Результат;
	КонецЕсли;
	
	Сведение = КонтрактыПровайдеров().НовыйСведениеДТ();
	Сведение.НомерГТДСсылка = СтрокаТЧ.НомерГТД;
	Сведение.НомерГТДДо = СтрокаТЧ.НомерГТДПредставление;
	Сведение.НомерГТД = СтрокаТЧ.НомерГТДПредставление;
	Сведение.Страна = СтрокаТЧ.СтранаПроисхождения;
	Сведение.СтранаКод = СтрокаТЧ.СтранаПроисхожденияКод;
	Сведение.СтранаНаименование = СтрокаТЧ.СтранаПроисхожденияНаименование;
	
	Результат.Добавить(Сведение);
	
	Возврат Результат;
	
КонецФункции

Функция КоличествоПрослеживаемостиСтрокиУКД(СтрокаТЧ)
	
	Результат = Новый Структура;
	Результат.Вставить("Количество", СтрокаТЧ.КоличествоПоРНПТ);
	Результат.Вставить("КоличествоДо", СтрокаТЧ.КоличествоПоРНПТДо);
	Результат.Вставить("Увеличение", СтрокаТЧ.КоличествоПрослежУвеличение);
	Результат.Вставить("Уменьшение", СтрокаТЧ.КоличествоПрослежУменьшение);
	
	Если Не ЗначениеЗаполнено(Результат.Количество)
		И Не ЗначениеЗаполнено(Результат.КоличествоДо) Тогда
		Результат.Количество = СтрокаТЧ.Количество;
		Результат.КоличествоДо = СтрокаТЧ.КоличествоДо;
		Если Результат.Количество >= Результат.КоличествоДо Тогда
			Результат.Увеличение = Результат.Количество - Результат.КоличествоДо;
			Результат.Уменьшение = 0;
		Иначе
			Результат.Увеличение = 0;
			Результат.Уменьшение = Результат.КоличествоДо - Результат.Количество;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияПрослеживаемостиДляСтрокиКонтрактаУКД(СтрокаТЧ, Комплектующие)
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ.КоличествоПоРНПТ)
		И НЕ ЗначениеЗаполнено(СтрокаТЧ.КоличествоПоРНПТДо)
		И НЕ ЗначениеЗаполнено(СтрокаТЧ.НомерГТД) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокиКомплекта = Новый Массив;
	Если ЗначениеЗаполнено(Комплектующие) Тогда
		СтрокиКомплекта = Комплектующие.НайтиСтроки(
			Новый Структура("НомерГТД", СтрокаТЧ.НомерГТД));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокиКомплекта) Тогда
		Результат = СведенияПрослеживаемостиКомплектаУКД(
			СтрокаТЧ,
			СтрокиКомплекта);
	Иначе
		Сведение = КонтрактыПровайдеров().НовыйСведениеПрослеживаемости();
		Сведение.НомерРНПТСсылка = СтрокаТЧ.НомерГТД;
		Сведение.НомерРНПТ = СокрЛП(СтрокаТЧ.НомерГТДПредставление);
		
		Сведение.Страна = СтрокаТЧ.СтранаПроисхожденияКод;
		Сведение.СтранаКод = СтрокаТЧ.СтранаПроисхожденияКод;
		Сведение.СтранаНаименование = СтрокаТЧ.СтранаПроисхожденияНаименование;
		
		Сведение.ЕдиницаИзмеренияКод = СокрЛП(СтрокаТЧ.ЕдиницаИзмеренияТНВЭДКод);
		Сведение.ЕдиницаИзмеренияНаименование = СокрЛП(
			СтрокаТЧ.ЕдиницаИзмеренияТНВЭДНаименование);
		
		Количества = КоличествоПрослеживаемостиСтрокиУКД(СтрокаТЧ);
		Сведение.КоличествоДо = Количества.КоличествоДо;
		Сведение.Количество = Количества.Количество;
		Сведение.КоличествоУвеличение = Количества.Увеличение;
		Сведение.КоличествоУменьшение = Количества.Уменьшение;
		
		Сведение.СтоимостьБезНДСДо = СтрокаТЧ.СуммаБезНДСДо;
		Сведение.СтоимостьБезНДС = СтрокаТЧ.СуммаБезНДС;
		Сведение.СтоимостьБезНДСУвеличение = СтрокаТЧ.РазницаБезНДСУвеличение;
		Сведение.СтоимостьБезНДСУменьшение = СтрокаТЧ.РазницаБезНДСУменьшение;
		
		Результат.Добавить(Сведение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияПрослеживаемостиКомплектаУКД(СтрокаТЧ, СтрокиКомплекта)
	
	Результат = Новый Массив;
	ОбщаяСуммаПоКомплекту = ОбщаяСуммаПоКомплектуУКД(СтрокиКомплекта);
	
	Для Каждого СтрокаКомплекта Из СтрокиКомплекта Цикл
		
		Сведение = КонтрактыПровайдеров().НовыйСведениеПрослеживаемости();
		Сведение.НомерРНПТСсылка = СтрокаКомплекта.НомерРНПТСсылка;
		Сведение.НомерРНПТ = СокрЛП(СтрокаКомплекта.НомерРНПТ);
		
		СтранаКод = СокрЛП(СтрокаКомплекта.СтранаКод);
		СтранаНаименование = СтрокаКомплекта.СтранаНаименование;
		Если Не ЗначениеЗаполнено(СтранаКод) Тогда
			СтранаКод = СтрокаТЧ.СтранаПроисхожденияКод;
			СтранаНаименование = СтрокаТЧ.СтранаПроисхожденияНаименование;
		КонецЕсли;
		Сведение.Страна = СтранаКод;
		Сведение.СтранаКод = СтранаКод;
		Сведение.СтранаНаименование = СтранаНаименование;
		
		Сведение.ЕдиницаИзмеренияКод = СокрЛП(СтрокаКомплекта.ЕдиницаИзмеренияКод);
		Сведение.ЕдиницаИзмеренияНаименование = СокрЛП(
			СтрокаКомплекта.ЕдиницаИзмеренияНаименование);
		
		Сведение.КоличествоДо = СтрокаКомплекта.Количество * СтрокаТЧ.КоличествоПоРНПТДо;
		Сведение.Количество = СтрокаКомплекта.Количество * СтрокаТЧ.КоличествоПоРНПТ;
		Сведение.КоличествоУвеличение =
			СтрокаКомплекта.Количество * СтрокаТЧ.КоличествоПрослежУвеличение;
		Сведение.КоличествоУменьшение =
			СтрокаКомплекта.Количество * СтрокаТЧ.КоличествоПрослежУменьшение;
		
		Сведение.СтоимостьБезНДСДо = СтоимостьПоРНПТСтрокиКомплектаУКД(
			СтрокаТЧ.СуммаБезНДСДо,
			ОбщаяСуммаПоКомплекту,
			СтрокаКомплекта.СуммаПоРНПТ);
		Сведение.СтоимостьБезНДС = СтоимостьПоРНПТСтрокиКомплектаУКД(
			СтрокаТЧ.СуммаБезНДС,
			ОбщаяСуммаПоКомплекту,
			СтрокаКомплекта.СуммаПоРНПТ);
		Сведение.СтоимостьБезНДСУвеличение = СтоимостьПоРНПТСтрокиКомплектаУКД(
			СтрокаТЧ.РазницаБезНДСУвеличение,
			ОбщаяСуммаПоКомплекту,
			СтрокаКомплекта.СуммаПоРНПТ);
		Сведение.СтоимостьБезНДСУменьшение = СтоимостьПоРНПТСтрокиКомплектаУКД(
			СтрокаТЧ.РазницаБезНДСУменьшение,
			ОбщаяСуммаПоКомплекту,
			СтрокаКомплекта.СуммаПоРНПТ);
		
		Результат.Добавить(Сведение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СтоимостьПоРНПТСтрокиКомплектаУКД(СуммаБезНДС, ОбщаяСуммаПоКомплекту, СуммаПоРНПТ)
	
	Результат = 0;
	Если ОбщаяСуммаПоКомплекту <> 0 Тогда
		Результат = (СуммаБезНДС / ОбщаяСуммаПоКомплекту) * СуммаПоРНПТ;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбщаяСуммаПоКомплектуУКД(СтрокиКомплекта)
	
	Результат = 0;
	Для Каждого СтрокаКомплекта Из СтрокиКомплекта Цикл
		Если СтрокаКомплекта.ОбщаяСуммаПоКомплекту <> 0 Тогда
			Результат = СтрокаКомплекта.ОбщаяСуммаПоКомплекту;
			Прервать;
		Иначе
			Результат = Результат + СтрокаКомплекта.СуммаПоРНПТ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПрослеживаемыеКомплектующиеПоТаблицеТоваровУКД(ТаблицаТоваров)
	
	Результат = Неопределено;
	ИмяТабличнойЧасти =
		"Справочник.НомераГТД.ТабличныеЧасти.ПрослеживаемыеКомплектующие";
	Если МетаданныеЕстьТабличнаяЧасть(ИмяТабличнойЧасти) Тогда
		НомераГТД = НомераГТДТаблицыТоваровУКД(ТаблицаТоваров);
		Если НомераГТД.Количество() > 0 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапросаПрослеживаемыхКомплектующихУКД();
			Запрос.УстановитьПараметр("НомераГТД", НомераГТД);
			Результат = Запрос.Выполнить().Выгрузить();
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НомераГТДТаблицыТоваровУКД(ТаблицаТоваров)
	
	Результат = Новый Массив;
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		Если СтрокаТовара.ПрослеживаемыйТовар
			И ЗначениеЗаполнено(СтрокаТовара.НомерГТД)
			И Результат.Найти(СтрокаТовара.НомерГТД) = Неопределено Тогда
			Результат.Добавить(СтрокаТовара.НомерГТД);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаПрослеживаемыхКомплектующихУКД()
	
	ПолеСуммаПоРНПТ = "0";
	Если ЕстьРеквизитПрослеживаемыхКомплектующихНомеровГТД("СуммаПоРНПТ") Тогда
		ПолеСуммаПоРНПТ = "ЕСТЬNULL(Комплектующие.СуммаПоРНПТ, 0)";
	КонецЕсли;
	
	ПолеОбщаяСумма = "0";
	Если ЕстьРеквизитНомеровГТД("СуммаПоРНПТ") Тогда
		ПолеОбщаяСумма = "ЕСТЬNULL(Комплект.СуммаПоРНПТ, 0)";
	КонецЕсли;
	
	Результат =
	"ВЫБРАТЬ
	|	Комплектующие.Ссылка КАК НомерГТД,
	|	Комплектующие.НомерРНПТ КАК НомерРНПТСсылка,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(РНПТ.РегистрационныйНомер, """") = """"
	|			ТОГДА ЕСТЬNULL(РНПТ.Код, """")
	|		ИНАЧЕ РНПТ.РегистрационныйНомер
	|	КОНЕЦ КАК НомерРНПТ,
	|	Комплектующие.КоличествоПоРНПТ КАК Количество,
	|	%Поле_СуммаПоРНПТ КАК СуммаПоРНПТ,
	|	%Поле_ОбщаяСуммаПоКомплекту КАК ОбщаяСуммаПоКомплекту,
	|	ЕСТЬNULL(Единицы.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ЕСТЬNULL(Единицы.Представление, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(Страны.Код, """") КАК СтранаКод,
	|	ЕСТЬNULL(Страны.Наименование, """") КАК СтранаНаименование
	|ИЗ
	|	Справочник.НомераГТД.ПрослеживаемыеКомплектующие КАК Комплектующие
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК РНПТ
	|		ПО Комплектующие.НомерРНПТ = РНПТ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК Комплект
	|		ПО Комплектующие.Ссылка = Комплект.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК Единицы
	|		ПО Комплектующие.ЕдиницаИзмеренияТНВЭД = Единицы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК Страны
	|		ПО РНПТ.СтранаПроисхождения = Страны.Ссылка
	|ГДЕ
	|	Комплектующие.Ссылка В (&НомераГТД)";
	
	Результат = СтрЗаменить(
		Результат,
		"%Поле_ОбщаяСуммаПоКомплекту",
		ПолеОбщаяСумма);
	Результат = СтрЗаменить(
		Результат,
		"%Поле_СуммаПоРНПТ",
		ПолеСуммаПоРНПТ);
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьРеквизитНомеровГТД(ИмяРеквизита)
	
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	Результат = МодульОбщегоНазначения.ЕстьРеквизитОбъекта(
		ИмяРеквизита,
		Метаданные.Справочники.НомераГТД);
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьРеквизитПрослеживаемыхКомплектующихНомеровГТД(ИмяРеквизита)
	
	Результат = Ложь;
	ИмяТабличнойЧасти =
		"Справочник.НомераГТД.ТабличныеЧасти.ПрослеживаемыеКомплектующие";
	Если МетаданныеЕстьТабличнаяЧасть(ИмяТабличнойЧасти) Тогда
		МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
		МетаданныеТЧ = Метаданные.Справочники.НомераГТД.ТабличныеЧасти.ПрослеживаемыеКомплектующие;
		Результат = МодульОбщегоНазначения.ЕстьРеквизитОбъекта(ИмяРеквизита, МетаданныеТЧ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокиКонтрактаУКДИзТабличныхДанных(ТаблицаТоваров)
	
	Результат = Новый Массив;
	
	ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров();
	Комплектующие = Неопределено;
	Если ИспользуетсяУчетПрослеживаемыхТоваров Тогда
		Комплектующие = ПрослеживаемыеКомплектующиеПоТаблицеТоваровУКД(ТаблицаТоваров);
	КонецЕсли;
	
	ТоварныйДокумент = ТоварныйДокументУКД();
	НомерСтроки = 0;
	ЕстьНомерСтрокиИсходногоСФ =
		ТаблицаТоваров.Колонки.Найти("НомерСтрокиИсходногоСФ") <> Неопределено;
	
	Для Каждого СтрокаТЧ Из ТаблицаТоваров Цикл
		
		Если СтрокаТоваровУКДБезИзменений(СтрокаТЧ) Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
		ТипНоменклатуры = ТипНоменклатурыУКД(СтрокаТЧ.Номенклатура);
		
		СтрокаКонтракта = КонтрактыПровайдеров().НовыйСтрокаТабличнойЧастиУКД();
		
		СтрокаКонтракта.ТоварныйДокумент = ТоварныйДокумент;
		СтрокаКонтракта.НомерСтрокиДокумента = НомерСтроки;
		СтрокаКонтракта.НомерИсходнойСтроки = НомерИсходнойСтрокиУКД(
			СтрокаТЧ,
			ЕстьНомерСтрокиИсходногоСФ);

		СтрокаКонтракта.Номенклатура = СтрокаТЧ.Номенклатура;
		СтрокаКонтракта.НоменклатураКод = СтрокаТЧ.НоменклатураКод;
		СтрокаКонтракта.НоменклатураПредставление = СтрокаТЧ.НоменклатураНаименование;
		СтрокаКонтракта.ТипНоменклатуры = ТипНоменклатуры;
		СтрокаКонтракта.КодТНВЭД = СтрокаТЧ.КодТНВЭД;
		СтрокаКонтракта.ЕдиницаИзмерения = СтрокаТЧ.ЕдиницаИзмерения;
		СтрокаКонтракта.ЕдиницаИзмеренияКод = СтрокаТЧ.ЕдиницаИзмеренияКод;
		СтрокаКонтракта.ЕдиницаИзмеренияНаименование = СтрокаТЧ.ЕдиницаИзмеренияНаименование;
		СтрокаКонтракта.Упаковка = СтрокаТЧ.Упаковка;
		СтрокаКонтракта.Характеристика = СтрокаТЧ.Характеристика;
		СтрокаКонтракта.ХарактеристикаНаименование = СтрокаТЧ.ХарактеристикаНаименование;
		СтрокаКонтракта.Серия = СтрокаТЧ.Серия;
		СтрокаКонтракта.СерияПредставление = СтрокаТЧ.СерияНаименование;
		
		СтрокаКонтракта.КоличествоДо = СтрокаТЧ.КоличествоДо;
		СтрокаКонтракта.Количество = СтрокаТЧ.Количество;
		
		СтрокаКонтракта.СтавкаНДС = СтрокаТЧ.СтавкаНДС;
		
		СтрокаКонтракта.ЦенаДо = СтрокаТЧ.ЦенаДо;
		СтрокаКонтракта.Цена = СтрокаТЧ.Цена;
		СтрокаКонтракта.СуммаБезНДСДо = СтрокаТЧ.СуммаБезНДСДо;
		СтрокаКонтракта.СуммаБезНДС = СтрокаТЧ.СуммаБезНДС;
		СтрокаКонтракта.СуммаНДСДо = СтрокаТЧ.СуммаНДСДо;
		СтрокаКонтракта.СуммаНДС = СтрокаТЧ.СуммаНДС;
		СтрокаКонтракта.СуммаСНДСДо = СтрокаТЧ.СуммаСНДСДо;
		СтрокаКонтракта.СуммаСНДС = СтрокаТЧ.СуммаСНДС;
		СтрокаКонтракта.АкцизДо = СтрокаТЧ.АкцизДоИзменения;
		СтрокаКонтракта.Акциз = СтрокаТЧ.АкцизПослеИзменения;

		СтрокаКонтракта.РазницаБезНДСУвеличение = СтрокаТЧ.РазницаБезНДСУвеличение;
		СтрокаКонтракта.РазницаБезНДСУменьшение = СтрокаТЧ.РазницаБезНДСУменьшение;
		СтрокаКонтракта.РазницаНДСУвеличение = СтрокаТЧ.РазницаНДСУвеличение;
		СтрокаКонтракта.РазницаНДСУменьшение = СтрокаТЧ.РазницаНДСУменьшение;
		СтрокаКонтракта.РазницаСНДСУвеличение = СтрокаТЧ.РазницаСНДСУвеличение;
		СтрокаКонтракта.РазницаСНДСУменьшение = СтрокаТЧ.РазницаСНДСУменьшение;
		СтрокаКонтракта.РазницаАкцизУвеличение = СтрокаТЧ.РазницаАкцизУвеличение;
		СтрокаКонтракта.РазницаАкцизУменьшение = СтрокаТЧ.РазницаАкцизУменьшение;
		
		СтрокаКонтракта.НомерГТД = СтрокаТЧ.НомерГТД;
		СтрокаКонтракта.СтранаПроисхождения = СтрокаТЧ.СтранаПроисхождения;
		
		СтрокаКонтракта.ПрослеживаемыйТовар = СтрокаТЧ.ПрослеживаемыйТовар;
		
		Если НЕ СтрокаТЧ.ПрослеживаемыйТовар Тогда
			СтрокаКонтракта.СведенияДТ = СведенияДТСтрокиКонтрактаУКД(СтрокаТЧ);
		КонецЕсли;
		
		Если ИспользуетсяУчетПрослеживаемыхТоваров
			И СтрокаТЧ.ПрослеживаемыйТовар Тогда
			СтрокаКонтракта.СведенияПрослеживаемости = СведенияПрослеживаемостиДляСтрокиКонтрактаУКД(СтрокаТЧ, Комплектующие);
		КонецЕсли;
		
		Результат.Добавить(СтрокаКонтракта);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТоварныйДокументУКД()

	Результат = Неопределено;
	ТипДокумента = ТипЗнч(УчетныйДокумент1С);

	Если ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Результат = УчетныйДокумент1С;
	КонецЕсли;

	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Основания = ДокументыОснованияСчетаФактурыВыданного(УчетныйДокумент1С);
		Если Основания.Количество() > 0 Тогда
			Результат = Основания[0];
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СтрокаТоваровУКДБезИзменений(СтрокаТЧ)

	Результат = Ложь;
	СтрокаБезРасхождений = СтрокаТЧ.РазницаБезНДСУвеличение = СтрокаТЧ.РазницаБезНДСУменьшение
		И СтрокаТЧ.РазницаНДСУвеличение = СтрокаТЧ.РазницаНДСУменьшение
		И СтрокаТЧ.РазницаСНДСУвеличение = СтрокаТЧ.РазницаСНДСУменьшение;
	Если СтрокаБезРасхождений Тогда
		КоличествоРавно = (СтрокаТЧ.Количество = СтрокаТЧ.КоличествоДо);
		РНПТНоль = (Не ЗначениеЗаполнено(СтрокаТЧ.КоличествоПоРНПТ)
			И Не ЗначениеЗаполнено(СтрокаТЧ.КоличествоПоРНПТДо));
		Результат = КоличествоРавно И РНПТНоль;
	КонецЕсли;

	Возврат Результат;

КонецФункции

