// ЮР ФИЗ ЛИЦА

Функция ДатаСведений(Знач ЗначДатаИзПараметра = Неопределено)

	Если ЗначениеЗаполнено(ЗначДатаИзПараметра) Тогда
		Результат = ЗначДатаИзПараметра;
	Иначе
		Результат = ТекущаяДатаСеанса();
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция КППКонтрагентаНаДату(Контрагент, ДатаСведений)
	
	Результат = "";
	ИмяРеквизитаКПП = "КПП";
	
	Если Не ЗначениеЗаполнено(ДатаСведений) Тогда
		Результат = ЗначениеРеквизитаОбъектаЛок(Контрагент, ИмяРеквизитаКПП);
		Возврат Результат;
	КонецЕсли;
	
	Если Не МетаданныеЕстьТабличнаяЧасть("Справочник.Контрагенты.ТабличныеЧасти.ИсторияКПП") Тогда
		Результат = ЗначениеРеквизитаОбъектаЛок(Контрагент, ИмяРеквизитаКПП);
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ИсторияКППКонтрагентов.Период) КАК Период,
	|	ИсторияКППКонтрагентов.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ЗначенияКПП
	|ИЗ
	|	Справочник.Контрагенты.ИсторияКПП КАК ИсторияКППКонтрагентов
	|ГДЕ
	|	ИсторияКППКонтрагентов.Ссылка = &Контрагент
	|	И ИсторияКППКонтрагентов.Период <= &ДатаСведений
	|
	|СГРУППИРОВАТЬ ПО
	|	ИсторияКППКонтрагентов.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсторияКППКонтрагентов.КПП КАК КПП
	|ИЗ
	|	ЗначенияКПП КАК ЗначенияКПП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты.ИсторияКПП КАК ИсторияКППКонтрагентов
	|		ПО ЗначенияКПП.Ссылка = ИсторияКППКонтрагентов.Ссылка
	|			И ЗначенияКПП.Период = ИсторияКППКонтрагентов.Период";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.КПП;
	Иначе
		Результат = ЗначениеРеквизитаОбъектаЛок(Контрагент, ИмяРеквизитаКПП);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьРеквизитыПоОрганизации(Реквизиты, Организация, ДатаСведений)
	
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Ссылка");
	ИменаРеквизитов.Добавить("ЮридическоеФизическоеЛицо");
	ИменаРеквизитов.Добавить("ЮрФизЛицо");
	ИменаРеквизитов.Добавить("ИНН");
	ИменаРеквизитов.Добавить("ОГРН");
	ИменаРеквизитов.Добавить("ДатаРегистрации");
	ИменаРеквизитов.Добавить("КодПоОКПО");
	ИменаРеквизитов.Добавить("СтранаРегистрации");
	ИменаРеквизитов.Добавить("ИндивидуальныйПредприниматель");
	ИменаРеквизитов.Добавить("СвидетельствоСерияНомер");
	ИменаРеквизитов.Добавить("СвидетельствоДатаВыдачи");
	Если ЭтоВерсияТорговойПодсистемыНеНиже_11_5_19() Тогда
		ИменаРеквизитов.Добавить("КрупнейшийНалогоплательщик");
	КонецЕсли;
	ИменаРеквизитов.Добавить("ОбособленноеПодразделение");
	ИменаРеквизитов.Добавить("РегистрацияВНалоговомОргане");
	ИменаРеквизитов.Добавить("Наименование");
	ИменаРеквизитов.Добавить("НаименованиеПолное");

	ИсходныеДанные = ЗначенияРеквизитовОбъектаЛок(Организация, ИменаРеквизитов);
	
	НаименованияИзИстории = НаименованияОрганизацииИзИстории(Организация, ДатаСведений);
	Если ЗначениеЗаполнено(НаименованияИзИстории.Наименование) Тогда
		ИсходныеДанные.Наименование = НаименованияИзИстории.Наименование;
		ИсходныеДанные.НаименованиеПолное = НаименованияИзИстории.НаименованиеПолное;
	КонецЕсли;
	
	Если ИсходныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда
		
		ЗаполнитьРеквизитыИПОрганизации(Реквизиты, ИсходныеДанные);
		
	ИначеЕсли ИсходныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		
		ЗаполнитьРеквизитыИностранногоЮрЛицаОрганизации(Реквизиты, ИсходныеДанные);
		
	Иначе
		
		ЗаполнитьРеквизитыЮрЛицаОрганизации(Реквизиты, Организация, ИсходныеДанные, ДатаСведений);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыПоРегистрацииВНалоговомОргане(Реквизиты, РегистрацияВНалоговомОргане, ДатаФакт)
	
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Владелец");
	ИменаРеквизитов.Добавить("КПП");
	ИменаРеквизитов.Добавить("ДатаПостановкиНаУчет");
	ИменаРеквизитов.Добавить("НаименованиеОбособленногоПодразделения");
	
	ИсходныеДанные = ЗначенияРеквизитовОбъектаЛок(РегистрацияВНалоговомОргане, ИменаРеквизитов);
	
	ЗаполнитьРеквизитыПоОрганизации(Реквизиты, ИсходныеДанные.Владелец, ДатаФакт);
	
	Реквизиты.ЮрЛицо.Наименование = ИсходныеДанные.НаименованиеОбособленногоПодразделения;
	Реквизиты.ЮрЛицо.НаименованиеПолное = ИсходныеДанные.НаименованиеОбособленногоПодразделения;
	Реквизиты.ЮрЛицо.ДатаРегистрации = ИсходныеДанные.ДатаПостановкиНаУчет;
	Реквизиты.ЮрЛицо.КПП = ИсходныеДанные.КПП;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыПоКонтрагенту(Реквизиты, Контрагент, ДатаСведений)
	
	ИменаРеквизитов = Новый Структура;
	ИменаРеквизитов.Вставить("Ссылка");
	ИменаРеквизитов.Вставить("ЮридическоеФизическоеЛицо");
	ИменаРеквизитов.Вставить("ЮрФизЛицо");
	ИменаРеквизитов.Вставить("ИНН");
	ИменаРеквизитов.Вставить("КПП");
	ИменаРеквизитов.Вставить("НалоговыйНомер");
	ИменаРеквизитов.Вставить("РегистрационныйНомер");
	ИменаРеквизитов.Вставить("КодПоОКПО");
	ИменаРеквизитов.Вставить("СтранаРегистрации");
	ИменаРеквизитов.Вставить("ОбособленноеПодразделение");
	ИменаРеквизитов.Вставить("Наименование");
	ИменаРеквизитов.Вставить("НаименованиеПолное");
	ИменаРеквизитов.Вставить("ДатаРегистрации", "ЕСТЬNULL(Партнер.ДатаРегистрации, ДАТАВРЕМЯ(1, 1, 1))");
	
	ИсходныеДанные = ЗначенияРеквизитовОбъектаЛок(Контрагент, ИменаРеквизитов);
	
	НаименованиеИзИстории = НаименованиеКонтрагентаИзИстории(Контрагент, ДатаСведений);
	Если ЗначениеЗаполнено(НаименованиеИзИстории) Тогда
		ИсходныеДанные.Наименование = НаименованиеИзИстории;
	КонецЕсли;
	
	ИсходныеДанные.Вставить("ОГРН", "");
	
	Если ЗначениеЗаполнено(ИсходныеДанные.РегистрационныйНомер) Тогда
		ИсходныеДанные.ОГРН = ИсходныеДанные.РегистрационныйНомер;
	КонецЕсли;
	
	ЭтоРезидент = (ИсходныеДанные.СтранаРегистрации = Справочники.СтраныМира.Россия);
	
	Если ИсходныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда
		
		ИсходныеДанные.ДатаРегистрации = Дата(1, 1, 1);
		ЗаполнитьРеквизитыИПКонтрагента(Реквизиты, ИсходныеДанные);
		
	ИначеЕсли ИсходныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		
		Если ЭтоРезидент Тогда
			ЗаполнитьРеквизитыФизЛицаКонтрагента(Реквизиты, ИсходныеДанные);
		Иначе
			Реквизиты.ИностранноеФизЛицо = КонтрактыПровайдеров().НовыйРеквизитыИностранногоЛица();
			ЗаполнитьДанныеИностранногоЛица(Реквизиты.ИностранноеФизЛицо, ИсходныеДанные);
		КонецЕсли;
		
	ИначеЕсли ИсходныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		
		ЗаполнитьРеквизитыИностранногоЮрЛицаКонтрагента(Реквизиты, ИсходныеДанные);
		
	Иначе
		
		ЗаполнитьРеквизитыЮрЛицаКонтрагента(Реквизиты, Контрагент, ИсходныеДанные, ДатаСведений);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыФизЛицаКонтрагента(Реквизиты, ИсходныеДанные)
	
	Реквизиты.ФизЛицо = КонтрактыПровайдеров().НовыйРеквизитыФизЛица();
	ЗаполнитьДанныеФизическогоЛица(Реквизиты.ФизЛицо, ИсходныеДанные);
	Реквизиты.ФизЛицо.ИНН = ИсходныеДанные.ИНН;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыИПОрганизации(Реквизиты, ИсходныеДанные)
	
	Реквизиты.ИП = КонтрактыПровайдеров().НовыйРеквизитыИП();
	ЗаполнитьДанныеИндивидуальногоПредпринимателя(Реквизиты.ИП, ИсходныеДанные);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыИностранногоЮрЛицаОрганизации(Реквизиты, ИсходныеДанные)
	
	Реквизиты.ИностранноеЮрЛицо = КонтрактыПровайдеров().НовыйРеквизитыИностранногоЛица();
	ЗаполнитьДанныеИностранногоЛица(Реквизиты.ИностранноеЮрЛицо, ИсходныеДанные);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыЮрЛицаОрганизации(Реквизиты, Организация, ИсходныеДанные, ДатаСведений)
	
	Если ЭтоРедакцияТорговойПодсистемыНиже_11_5() Тогда
		КПП = ЗначениеРеквизитаОбъектаЛок(Организация, "КПП");
	Иначе
		МодульОрганизации = ОбщийМодульЛок("ОрганизацииЛокализация");
		КПП = Неопределено;
		Если ЭтоВерсияТорговойПодсистемыНеНиже_11_5_19() Тогда
			Если ИсходныеДанные.КрупнейшийНалогоплательщик Тогда
				КПП = КППКрупнейшегоНалогоплательщикаНаДату(Организация, ДатаСведений);
			КонецЕсли;
		КонецЕсли;
		Если КПП = Неопределено Тогда
			КПП = МодульОрганизации.КППНаДату(Организация, ДатаСведений);
		КонецЕсли;
	КонецЕсли;
	
	Реквизиты.ЮрЛицо = КонтрактыПровайдеров().НовыйРеквизитыЮрЛица();
	ЗаполнитьДанныеЮридическогоЛица(Реквизиты.ЮрЛицо, ИсходныеДанные, КПП);
	
КонецПроцедуры

Функция КППКрупнейшегоНалогоплательщикаНаДату(Организация, ДатаСведений)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос(ТекстЗапросаКППКрупнейшегоНалогоплательщикаНаДату());
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", ДатаСведений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.КПП;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаКППКрупнейшегоНалогоплательщикаНаДату()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	МАКСИМУМ(История.Период) КАК Период,
	|	История.СтруктурнаяЕдиница КАК Организация
	|ПОМЕСТИТЬ ДатыРегистрацииКрупнейшего
	|ИЗ
	|	РегистрСведений.КрупнейшийНалогоплательщикИсторияРегистрацийВНалоговомОргане КАК История
	|ГДЕ
	|	История.СтруктурнаяЕдиница = &Организация
	|	И История.Период <= &Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	История.СтруктурнаяЕдиница
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Регистрации.КПП КАК КПП
	|ИЗ
	|	ДатыРегистрацииКрупнейшего КАК ДатыРегистрацииКрупнейшего
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КрупнейшийНалогоплательщикИсторияРегистрацийВНалоговомОргане КАК История
	|		ПО ДатыРегистрацииКрупнейшего.Организация = История.СтруктурнаяЕдиница
	|			И ДатыРегистрацииКрупнейшего.Период = История.Период
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК Регистрации
	|		ПО История.РегистрацияВНалоговомОргане = Регистрации.Ссылка";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ЗаполнитьРеквизитыИПКонтрагента(Реквизиты, ИсходныеДанные)
	
	Реквизиты.ИП = КонтрактыПровайдеров().НовыйРеквизитыИП();
	ЗаполнитьДанныеИндивидуальногоПредпринимателя(Реквизиты.ИП, ИсходныеДанные);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыИностранногоЮрЛицаКонтрагента(Реквизиты, ИсходныеДанные)
	
	Реквизиты.ИностранноеЮрЛицо = КонтрактыПровайдеров().НовыйРеквизитыИностранногоЛица();
	ЗаполнитьДанныеИностранногоЛица(Реквизиты.ИностранноеЮрЛицо, ИсходныеДанные);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыЮрЛицаКонтрагента(Реквизиты, Контрагент, ИсходныеДанные, ДатаСведений)
	
	КПП = КППКонтрагентаНаДату(Контрагент, ДатаСведений);
	
	Реквизиты.ЮрЛицо = КонтрактыПровайдеров().НовыйРеквизитыЮрЛица();
	ЗаполнитьДанныеЮридическогоЛица(Реквизиты.ЮрЛицо, ИсходныеДанные, КПП);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеФизическогоЛица(Реквизиты, ИсходныеДанные)
	
	ФизЛицо = Неопределено;
	ИсходныеДанные.Свойство("ИндивидуальныйПредприниматель", ФизЛицо);
	
	Если ЗначениеЗаполнено(ФизЛицо) Тогда
		ЧастиФИО = ЗначенияРеквизитовОбъектаЛок(ФизЛицо, "Фамилия, Имя, Отчество");
	Иначе
		
		СтрокаФИО = ИсходныеДанные.НаименованиеПолное;
		Если Не ЗначениеЗаполнено(СтрокаФИО) Тогда
			СтрокаФИО = ИсходныеДанные.Наименование;
		КонецЕсли;
		
		ЧастиФИО = ФИОИзСтроки(СтрокаФИО);
		
	КонецЕсли;
	
	Реквизиты.ФИО.Фамилия = ЧастиФИО.Фамилия;
	Реквизиты.ФИО.Имя = ЧастиФИО.Имя;
	Реквизиты.ФИО.Отчество = ЧастиФИО.Отчество;
	
	ЗаполнитьСтрануЮрФизЛица(Реквизиты.Страна, ИсходныеДанные.СтранаРегистрации);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеИностранногоЛица(Реквизиты, ИсходныеДанные)
	
	Реквизиты.Наименование = ИсходныеДанные.Наименование;
	Реквизиты.НаименованиеПолное = ИсходныеДанные.НаименованиеПолное;
	Реквизиты.ИныеСведения = СокрЛП(ИсходныеДанные.ОГРН);
	
	Если ИсходныеДанные.Свойство("НалоговыйНомер") Тогда
		Реквизиты.НалоговыйНомер = ИсходныеДанные.НалоговыйНомер;
	КонецЕсли;
	
	ЗаполнитьСтрануЮрФизЛица(Реквизиты.Страна, ИсходныеДанные.СтранаРегистрации);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеЮридическогоЛица(Реквизиты, ИсходныеДанные, КПП)
	
	Реквизиты.Наименование = ИсходныеДанные.Наименование;
	Реквизиты.НаименованиеПолное = ИсходныеДанные.НаименованиеПолное;
	Реквизиты.КПП = КПП;
	Реквизиты.ИНН = ИсходныеДанные.ИНН;
	Реквизиты.ОГРН = ИсходныеДанные.ОГРН;
	Реквизиты.КодПоОКПО = ИсходныеДанные.КодПоОКПО;
	Реквизиты.ДатаРегистрации = ИсходныеДанные.ДатаРегистрации;
	
	ЗаполнитьСтрануЮрФизЛица(Реквизиты.Страна, ИсходныеДанные.СтранаРегистрации);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеИндивидуальногоПредпринимателя(Реквизиты, ИсходныеДанные)
	
	ЗаполнитьДанныеФизическогоЛица(Реквизиты, ИсходныеДанные);
	
	Реквизиты.ИНН = ИсходныеДанные.ИНН;
	Реквизиты.ОГРН = ИсходныеДанные.ОГРН;
	Реквизиты.ДатаРегистрации = ИсходныеДанные.ДатаРегистрации;
	
	СерияНомерСвидетельства = "";
	ДатаСвидетельства = Неопределено;
	
	ИсходныеДанные.Свойство("СвидетельствоСерияНомер", СерияНомерСвидетельства);
	ИсходныеДанные.Свойство("СвидетельствоДатаВыдачи", ДатаСвидетельства);
	
	Если ЗначениеЗаполнено(СерияНомерСвидетельства) Или ЗначениеЗаполнено(ДатаСвидетельства) Тогда
		Реквизиты.Свидетельство = СтдСтр().СтрШаблонЛок(
			НСтр("ru = 'свидетельство %1 от %2'"),
			СерияНомерСвидетельства,
			Формат(ДатаСвидетельства, "ДЛФ=D"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСтрануЮрФизЛица(Реквизиты, Страна)

	Если Не ЗначениеЗаполнено(Страна) Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтраны = СтрокаКодИНаименованиеСтраныДляКонтракта(Страна);
	
	Реквизиты.Код = ДанныеСтраны.КодСтраны;
	Реквизиты.Наименование = ДанныеСтраны.НаименованиеСтраны;
	
КонецПроцедуры

Функция ТелефонЮрФизЛица(ЮрФизЛицо, ДатаСведений)
	
	Результат = "";
	ВидКИ = ВидКонтактнойИнформацииТелефон(ЮрФизЛицо);
	
	Если ЗначениеЗаполнено(ВидКИ) Тогда
		СтрокаКИ = КонтактнаяИнформацияПоВиду(ЮрФизЛицо, ВидКИ, ДатаСведений);
		Результат = СтрокаКИ.Представление;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭлектроннаяПочтаЮрФизЛица(ЮрФизЛицо, ДатаСведений)
	
	Результат = "";
	ВидКИ = ВидКонтактнойИнформацииЭлектроннаяПочта(ЮрФизЛицо);
	
	Если ЗначениеЗаполнено(ВидКИ) Тогда
		СтрокаКИ = КонтактнаяИнформацияПоВиду(ЮрФизЛицо, ВидКИ, ДатаСведений);
		Результат = СтрокаКИ.Представление;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КППОбособленногоПодразделенияПоДокументу(Документ)

	Результат = "";
	
	СведенияОбособленногоПодразделения = СведенияОбособленногоПодразделенияПродавцаПоДокументу(Документ);
	Если СведенияОбособленногоПодразделения <> Неопределено Тогда
		Результат = СведенияОбособленногоПодразделения.КПП;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОбособленногоПодразделенияПродавцаПоДокументу(Документ)

	Результат = Неопределено;
	
	РеквизитыДокумента = РеквизитыДокументаДляСведенийОбособленногоПодразделения(Документ);
	
	Если Не ЗначениеЗаполнено(РеквизитыДокумента.Организация) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Подразделение Из КандидатыДляОпределенияОбособленногоПодразделенияПродавца(РеквизитыДокумента) Цикл
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = ДанныеРегистрацииВНалоговомОрганеПоПодразделению(
				РеквизитыДокумента.Организация,
				Подразделение,
				РеквизитыДокумента.Дата);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		РеквизитыОрганизации = ЗначенияРеквизитовОбъектаЛок(
			РеквизитыДокумента.Организация,
			"ОбособленноеПодразделение, КПП");
		
		Если РеквизитыОрганизации.ОбособленноеПодразделение Тогда
			Результат = Новый Структура;
			Результат.Вставить("КПП", РеквизитыОрганизации.КПП);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КандидатыДляОпределенияОбособленногоПодразделенияПродавца(РеквизитыДокумента)

	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(РеквизитыДокумента.ПодразделениеСклада) Тогда
		Результат.Добавить(РеквизитыДокумента.ПодразделениеСклада);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыДокумента.Подразделение)
		И Результат.Найти(РеквизитыДокумента.Подразделение) = Неопределено Тогда
		Результат.Добавить(РеквизитыДокумента.Подразделение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДокументаДляСведенийОбособленногоПодразделения(Документ)

	Результат = Новый Структура;
	Результат.Вставить("Дата");
	Результат.Вставить("Организация");
	Результат.Вставить("Склад");
	Результат.Вставить("Подразделение");
	Результат.Вставить("ПодразделениеСклада");
	
	РеквизитыКЧтению = Новый Структура;
	РеквизитыМетаданных = Документ.Метаданные().Реквизиты;

	Для Каждого ЗначениеКлюч Из Результат Цикл
		Если РеквизитыМетаданных.Найти(ЗначениеКлюч.Ключ) <> Неопределено Тогда
			РеквизитыКЧтению.Вставить(ЗначениеКлюч.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Если РеквизитыКЧтению.Свойство("Склад") Тогда
		РеквизитыКЧтению.Вставить("ПодразделениеСклада", "Склад.Подразделение");
	КонецЕсли;
	
	Если РеквизитыКЧтению.Количество() > 0 Тогда
		ЗначенияРеквизитов = ЗначенияРеквизитовОбъектаЛок(Документ, РеквизитыКЧтению);
		СтдКоллекции().ДополнитьСтруктуруЛок(Результат, ЗначенияРеквизитов, Истина);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеРегистрацииВНалоговомОрганеПоПодразделению(Организация, Подразделение, ДатаСведений)

	Результат = Неопределено;
	
	Если ЭтоРедакцияТорговойПодсистемыНиже_11_5() Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РегНО.КПП КАК КПП
		|ИЗ
		|	РегистрСведений.РегистрацииВНалоговомОргане КАК Регистрации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК РегНО
		|		ПО Регистрации.РегистрацияВНалоговомОргане = РегНО.Ссылка
		|ГДЕ
		|	Регистрации.Организация = &Организация
		|	И Регистрации.Подразделение = &Подразделение";
		
	Иначе
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	СрезРегистраций.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане
		|ПОМЕСТИТЬ ВтСрезРегистрацийПоПодразделению
		|ИЗ
		|	РегистрСведений.РегистрацииВНалоговомОргане.СрезПоследних(
		|		&ДатаСведений,
		|		Организация = &Организация
		|			И Подразделение = &Подразделение) КАК СрезРегистраций
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СпрРегистрации.КПП КАК КПП
		|ИЗ
		|	ВтСрезРегистрацийПоПодразделению КАК СрезРегистраций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК СпрРегистрации
		|		ПО СрезРегистраций.РегистрацияВНалоговомОргане = СпрРегистрации.Ссылка
		|ГДЕ
		|	СпрРегистрации.ДатаСнятияСУчета = ДАТАВРЕМЯ(1, 1, 1)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СпрРегистрации.КПП КАК КПП
		|ИЗ
		|	ВтСрезРегистрацийПоПодразделению КАК СрезРегистраций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК СпрРегистрации
		|		ПО СрезРегистраций.РегистрацияВНалоговомОргане = СпрРегистрации.Ссылка
		|ГДЕ
		|	СпрРегистрации.ДатаСнятияСУчета > &ДатаСведений";
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Новый Структура;
		Результат.Вставить("КПП", Выборка.КПП);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

