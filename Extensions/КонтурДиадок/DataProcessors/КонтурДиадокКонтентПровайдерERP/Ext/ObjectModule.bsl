// ШАПКА

Процедура ЗаполнитьРеквизитыШапкиПоКорректировкеРеализации(Контракт)
	
	ДанныеШапки = ДанныеШапкиУКДПоКорректировкеРеализации();

	Контракт.Ссылка = ДанныеШапки.Ссылка;
	Контракт.Номер = ДанныеШапки.Номер;
	Контракт.ПредставлениеНомера = НомерНаПечатьЛокализация(ДанныеШапки.Номер);
	Контракт.Дата = ДанныеШапки.Дата;
	ЗаполнитьИсправлениеШапкиУКД(Контракт, ДанныеШапки);

	ЗаполнитьПродавцаИСоставителяШапкиУКД(Контракт, ДанныеШапки);
	
	Контракт.Покупатель = ДанныеШапки.Контрагент;
	Контракт.БанковскийСчетПокупателя = ДанныеШапки.БанковскийСчетКонтрагента;
	Контракт.КПППокупателя = ДанныеШапки.КПППокупателя;
	
	Контракт.Договор = ДанныеШапки.Договор;
	Контракт.Соглашение = ДанныеШапки.Соглашение;
	Контракт.Основание = ДанныеШапки.Основание;
	Контракт.ОснованиеНомер = ДанныеШапки.ОснованиеНомер;
	Контракт.ОснованиеДата = ДанныеШапки.ОснованиеДата;
	
	Контракт.КодВидаОперации = "";
	Контракт.ВидОперации = ВидОперацииУКДПоХозяйственнойОперации(
		СтдКоллекции().СвойствоСтруктурыЛок(ДанныеШапки, "ХозяйственнаяОперация", Неопределено));
	Контракт.Налогообложение = НалогообложениеУКД(ДанныеШапки.НалогообложениеНДС);
	
	ЗаполнитьВалютуШапкиУКД(Контракт, ДанныеШапки);
	Контракт.ИдентификаторГосКонтракта = ДанныеШапки.ИдентификаторГосКонтракта;
	
	Контракт.ПервичныеДокументы = РеквизитыПервичныхДокументовПоКорректировкеРеализации();
	Контракт.ДокументыОснования = РеквизитыДокументовОснованияПоКорректировкеРеализации();
	
	ЗаполнитьВариантВыбытияМаркированнойПродукции(Контракт);
	
	ЗаполнитьПокупателяКлиентомПриРеализацииЧерезКомиссионера(
		Контракт,
		СтдКоллекции().СвойствоСтруктурыЛок(ДанныеШапки, "КлиентКонтрагент", Неопределено));

КонецПроцедуры

Функция ДанныеШапкиУКДПоКорректировкеРеализации()
	// BSLLS:QueryNestedFieldsByDot-off
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	// BSLLS:LogicalOrInJoinQuerySection-off
	// BSLLS:JoinWithSubQuery-off
	// BSLLS:JoinWithVirtualTable-off
	// BSLLS:AssignAliasFieldsInQuery-off
	// BSLLS:DuplicateStringLiteral-off

	// BSLLS:QueryParseError-off
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Корректировка.Ссылка КАК Ссылка,
	|	Корректировка.Номер КАК Номер,
	|	Корректировка.Дата КАК Дата,
	|	Корректировка.ДокументОснование.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	ВЫБОР
	|		КОГДА Организации.ОбособленноеПодразделение
	|				И Организации.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА Организации.ГоловнаяОрганизация
	|		ИНАЧЕ Корректировка.Организация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА Контрагенты.Ссылка ЕСТЬ НЕ NULL
	|			ТОГДА ВЫБОР
	|				КОГДА Контрагенты.ОбособленноеПодразделение
	|					И Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|					ТОГДА Контрагенты.ГоловнойКонтрагент
	|				ИНАЧЕ Корректировка.Контрагент
	|			КОНЕЦ
	|		КОГДА ОрганизацииКонтрагент.Ссылка ЕСТЬ НЕ NULL
	|			ТОГДА ВЫБОР
	|				КОГДА ОрганизацииКонтрагент.ОбособленноеПодразделение
	|					И ОрганизацииКонтрагент.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|					ТОГДА ОрганизацииКонтрагент.ГоловнаяОрганизация
	|				ИНАЧЕ Корректировка.Контрагент
	|			КОНЕЦ
	|		ИНАЧЕ Корректировка.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Грузополучатели.ОбособленноеПодразделение
	|			И Грузополучатели.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			И Грузополучатели.ГоловнойКонтрагент = Корректировка.Контрагент
	|			И Грузополучатели.КПП <> """"
	|		ТОГДА ЕСТЬNULL(Грузополучатели.КПП, """")
	|		КОГДА Контрагенты.ОбособленноеПодразделение
	|			И Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Контрагенты.КПП, """")
	|		КОГДА ОрганизацииКонтрагент.ОбособленноеПодразделение
	|			И ОрганизацииКонтрагент.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(ОрганизацииКонтрагент.КПП, """")
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КПППокупателя,
	|	%Поле_КорректировкаКлиентКонтрагент КАК КлиентКонтрагент,
	|	Корректировка.БанковскийСчетОрганизации КАК БанковскийСчетОрганизации,
	|	Корректировка.БанковскийСчетКонтрагента КАК БанковскийСчетКонтрагента,
	|	Корректировка.Валюта КАК Валюта,
	|	Корректировка.Основание КАК Основание,
	|	Корректировка.ОснованиеНомер КАК ОснованиеНомер,
	|	Корректировка.ОснованиеДата КАК ОснованиеДата,
	|	Корректировка.НалогообложениеНДС КАК НалогообложениеНДС,
	|	Корректировка.Договор КАК Договор,
	|	Корректировка.Соглашение КАК Соглашение,
	|	"""" КАК ИдентификаторГосКонтракта,
	|	"""" КАК КПППоставщика
	|ИЗ
	|	Документ.КорректировкаРеализации КАК Корректировка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО Корректировка.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Корректировка.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Грузополучатели
	|		ПО Корректировка.Грузополучатель = Грузополучатели.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК ОрганизацииКонтрагент
	|		ПО Корректировка.Контрагент = ОрганизацииКонтрагент.Ссылка
	|ГДЕ
	|	Корректировка.Ссылка = &Корректировка";
	// BSLLS:QueryParseError-on
	
	ПодставитьПоляИзПараметровСбораУКД(ТекстЗапроса, ПараметрыСбораУКД().ПоляШапки);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Корректировка", УчетныйДокумент1С);

	РеквизитыДокумента = Запрос.Выполнить().Выгрузить();
	Если РеквизитыДокумента.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru='Не найдены данные корректировки реализации для заполнения шапки УКД.'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	Результат = МодульОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РеквизитыДокумента[0]);

	КППОбособленногоПодразделения = КППОбособленногоПодразделенияПоДокументу(УчетныйДокумент1С);
	Если ЗначениеЗаполнено(КППОбособленногоПодразделения) Тогда
		Результат.КПППоставщика = КППОбособленногоПодразделения;
	КонецЕсли;
	
	ДополнитьДанныеШапкиУКДПоставщиком(Результат);

	Возврат Результат;
	// BSLLS:DuplicateStringLiteral-on
	// BSLLS:AssignAliasFieldsInQuery-on
	// BSLLS:JoinWithVirtualTable-on
	// BSLLS:JoinWithSubQuery-on
	// BSLLS:LogicalOrInJoinQuerySection-on
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	// BSLLS:QueryNestedFieldsByDot-on
КонецФункции

Функция ТоварныеДокументыДоКорректировкиПоКорректировкеРеализации()

	Результат = Новый Массив;
	СвязанныеДокументы = ТаблицаСвязанныхКорректировокРеализации(УчетныйДокумент1С);

	Если СвязанныеДокументы.Количество() > 1 Тогда
		ТоварныйДокументДоКорректировки = СвязанныеДокументы[1].Подчиненный;
	Иначе
		ТоварныйДокументДоКорректировки = НайтиПервичныйДокументУКДПоДокументамОснования(УчетныйДокумент1С);
	КонецЕсли;

	ДополнитьМассивЗначением(Результат, ТоварныйДокументДоКорректировки);

	Возврат Результат;

КонецФункции

Функция ТаблицаСвязанныхКорректировокРеализации(ДокументКорректировки)
	// BSLLS:QueryNestedFieldsByDot-off
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	// BSLLS:LogicalOrInJoinQuerySection-off
	// BSLLS:JoinWithSubQuery-off
	// BSLLS:JoinWithVirtualTable-off
	// BSLLS:AssignAliasFieldsInQuery-off
	// BSLLS:DuplicateStringLiteral-off

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.ВидКорректировки КАК ВидКорректировки,
	|	ДанныеДокумента.МоментВремени КАК МоментВремени
	|ПОМЕСТИТЬ ТаблицаДанныхДокумента
	|ИЗ
	|	Документ.КорректировкаРеализации КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Основной,
	|	ДанныеДокумента.Ссылка КАК Подчиненный,
	|	ДанныеДокумента.МоментВремени КАК МоментВремени
	|ИЗ
	|	ТаблицаДанныхДокумента КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка
	|	И ДанныеДокумента.ВидКорректировки В (
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияПерепоставленногоТовара),
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратНедопоставленногоТовара))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТекущийДокумент.Ссылка,
	|	ТекущийДокумент.ДокументОснование,
	|	ТекущийДокумент.ДокументОснование.МоментВремени
	|ИЗ
	|	Документ.КорректировкаРеализации КАК ТекущийДокумент
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокумента КАК ДанныеДокумента
	|		ПО ТекущийДокумент.Ссылка = ДанныеДокумента.Ссылка
	|ГДЕ
	|	НЕ ДанныеДокумента.ВидКорректировки В (
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияПерепоставленногоТовара),
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратНедопоставленногоТовара))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТекущийДокумент.Ссылка,
	|	ПредыдущиеДокументы.Ссылка,
	|	ПредыдущиеДокументы.МоментВремени
	|ИЗ
	|	Документ.КорректировкаРеализации КАК ТекущийДокумент
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокумента КАК ДанныеДокумента
	|		ПО ТекущийДокумент.Ссылка = ДанныеДокумента.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК ПредыдущиеДокументы
	|		ПО ТекущийДокумент.ДокументОснование = ПредыдущиеДокументы.ДокументОснование
	|			И ТекущийДокумент.МоментВремени >= ПредыдущиеДокументы.МоментВремени
	|ГДЕ
	|	ПредыдущиеДокументы.Проведен
	|	И НЕ ДанныеДокумента.ВидКорректировки В (
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияПерепоставленногоТовара),
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратНедопоставленногоТовара))
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментВремени УБЫВ";
	Запрос.УстановитьПараметр("Ссылка", ДокументКорректировки);

	Возврат Запрос.Выполнить().Выгрузить();
	// BSLLS:DuplicateStringLiteral-on
	// BSLLS:AssignAliasFieldsInQuery-on
	// BSLLS:JoinWithVirtualTable-on
	// BSLLS:JoinWithSubQuery-on
	// BSLLS:LogicalOrInJoinQuerySection-on
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-on
	// BSLLS:QueryNestedFieldsByDot-on
КонецФункции

Функция РеквизитыПервичныхДокументовПоКорректировкеРеализации()
	
	Результат = Новый Массив;
	ПервичныйДокумент = НайтиПервичныйДокументУКДПоДокументамОснования(УчетныйДокумент1С);
	ДобавитьРеквизитыПервичногоДокументаУКДВКоллекцию(Результат, ПервичныйДокумент);
	
	Возврат Результат;
	
КонецФункции

Функция НайтиПервичныйДокументУКДПоДокументамОснования(ДокументСсылка)
	
	Результат = ДокументСсылка;
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Основание = ЗначениеРеквизитаОбъектаЛок(ДокументСсылка, "ДокументОснование");
		Результат = НайтиПервичныйДокументУКДПоДокументамОснования(Основание);
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВозвратТоваровОтКлиента") Тогда
		
		ДокументРеализации = ЗначениеРеквизитаОбъектаЛок(ДокументСсылка, "ДокументРеализации");
		Если ЗначениеЗаполнено(ДокументРеализации)
			И ТипЗнч(ДокументРеализации) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Результат = ДокументРеализации;
		КонецЕсли;
		
	Иначе
		
		Результат = ДокументСсылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СчетФактураВыданныйПоДокументуОснованию(ДокументОснование)
	
	Результат = Документы.СчетФактураВыданный.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СчетФактура.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактура
	|		ПО Таблица.Ссылка = СчетФактура.Ссылка
	|ГДЕ
	|	Таблица.ДокументОснование = &ДокументОснование
	|	И НЕ СчетФактура.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьРеквизитыПервичногоДокументаУКДВКоллекцию(Коллекция, СсылкаДокумента)
	
	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Ссылка", СсылкаДокумента);
	Найденные = СтдКоллекции().НайтиСтрокиМассиваСтруктур(Коллекция, Отбор);
	Если Найденные.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыПервичногоДокумента = РеквизитыПервичногоДокументаУКД(СсылкаДокумента);
	Коллекция.Добавить(РеквизитыПервичногоДокумента);
	
КонецПроцедуры

Функция РеквизитыПервичногоДокументаУКД(СсылкаДокумента)
	
	Результат = КонтрактыПровайдеров().НовыйРеквизитыСвязанногоДокумента();
	РеквизитыДокумента = ЗначенияРеквизитовОбъектаЛок(СсылкаДокумента, "Номер, Дата");
	
	Если ТипЗнч(СсылкаДокумента) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Результат.Номер = ПредставлениеНомераСчетаФактурыВыданного(СсылкаДокумента);
		Если Не ЗначениеЗаполнено(Результат.Номер) Тогда
			Результат.Номер = РеквизитыДокумента.Номер;
		КонецЕсли;
	Иначе
		Результат.Номер = НомерНаПечатьЛокализация(РеквизитыДокумента.Номер);
	КонецЕсли;
	
	Результат.Дата = РеквизитыДокумента.Дата;
	Результат.Ссылка = СсылкаДокумента;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДокументовОснованияПоКорректировкеРеализации()
	
	Результат = Новый Массив;
	Основание = ЗначениеРеквизитаОбъектаЛок(УчетныйДокумент1С, "ДокументОснование");
	ДобавитьРеквизитыДокументаОснованияУКДВКоллекцию(Результат, Основание);
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДокументовОснованияПоСчетуФактуреВыданному()
	
	Результат = Новый Массив;
	ПредыдущиеСчетаФактуры = ПредыдущиеСчетаФактурыКорректировочногоСФ(УчетныйДокумент1С);
	
	Для Каждого СчетФактура Из ПредыдущиеСчетаФактуры Цикл
		ДобавитьРеквизитыДокументаОснованияУКДВКоллекцию(Результат, СчетФактура);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПредыдущиеСчетаФактурыКорректировочногоСФ(СчетФактура)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧТовары.ПредыдущийСчетФактура КАК Ссылка,
	|	МИНИМУМ(ТЧТовары.НомерСтроки) КАК НомерСтроки
	|ИЗ
	|	Документ.СчетФактураВыданный.Товары КАК ТЧТовары
	|ГДЕ
	|	ТЧТовары.Ссылка = &Ссылка
	|	И ТЧТовары.ПредыдущийСчетФактура <> ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧТовары.ПредыдущийСчетФактура
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", СчетФактура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДополнитьМассивЗначением(Результат, Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьРеквизитыДокументаОснованияУКДВКоллекцию(Коллекция, СсылкаДокумента)
	
	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Реквизиты = РеквизитыДокументаОснованияУКД(СсылкаДокумента);
	Найденные = СтдКоллекции().НайтиСтрокиМассиваСтруктур(Коллекция, Реквизиты);
	Если Найденные.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Коллекция.Добавить(Реквизиты);
	
КонецПроцедуры

Функция РеквизитыДокументаОснованияУКД(СсылкаДокумента)
	
	Результат = КонтрактыПровайдеров().НовыйДокументОснованияУКД();
	
	Если ТипЗнч(СсылкаДокумента) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЗаполнитьРеквизитыДокументаОснованияПоСчетуФактуре(Результат, СсылкаДокумента);
	Иначе
		ЗаполнитьРеквизитыДокументаОснованияПоПервичномуДокументу(Результат, СсылкаДокумента);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьРеквизитыДокументаОснованияПоПервичномуДокументу(Результат, СсылкаДокумента)
	
	РеквизитыДокумента = ЗначенияРеквизитовОбъектаЛок(СсылкаДокумента, "Номер, Дата");
	Результат.Номер = НомерНаПечатьЛокализация(РеквизитыДокумента.Номер);
	Результат.Дата = РеквизитыДокумента.Дата;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыДокументаОснованияПоСчетуФактуре(Результат, СчетФактура)
	
	РеквизитыДокумента = ЗначенияРеквизитовОбъектаЛок(
		СчетФактура,
		"Номер, Дата, Исправление, НомерИсправления, СчетФактураОснование");
	
	Результат.Номер = ПредставлениеНомераСчетаФактурыВыданного(СчетФактура);
	Если Не ЗначениеЗаполнено(Результат.Номер) Тогда
		Результат.Номер = РеквизитыДокумента.Номер;
	КонецЕсли;
	
	ДатаДокумента = РеквизитыДокумента.Дата;
	
	Если РеквизитыДокумента.Исправление Тогда
		Если ЗначениеЗаполнено(РеквизитыДокумента.СчетФактураОснование) Тогда
			ДатаОснования = ЗначениеРеквизитаОбъектаЛок(РеквизитыДокумента.СчетФактураОснование, "Дата");
			Результат.Дата = ДатаОснования;
		Иначе
			Результат.Дата = ДатаДокумента;
		КонецЕсли;
		Результат.НомерИсправления = СокрЛП(РеквизитыДокумента.НомерИсправления);
		Результат.ДатаИсправления = ДатаДокумента;
	Иначе
		Результат.Дата = ДатаДокумента;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьВариантВыбытияМаркированнойПродукции(Контракт)
	
	Если Контракт.ПервичныеДокументы.Количество() = 0
		Или Не ЕстьУчетВыбытияМаркированнойПродукции() Тогда
		Возврат;
	КонецЕсли;
	
	ДокументРеализации = Неопределено;
	
	Для Каждого ПервичныйДокумент Из Контракт.ПервичныеДокументы Цикл
		
		Если ТипЗнч(ПервичныйДокумент.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			ДокументРеализации = ПервичныйДокумент.Ссылка;
			Прервать;
		КонецЕсли;

		Если ТипЗнч(ПервичныйДокумент.Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			ДокументРеализации = ДокументРеализацииПоСчетуФактуре(ПервичныйДокумент.Ссылка);
			Если ДокументРеализации <> Неопределено Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЦикла;
	
	Если ДокументРеализации <> Неопределено Тогда
		
		ВариантВыбытия = ЗначениеРеквизитаОбъектаЛок(ДокументРеализации, "ВариантВыбытияМаркируемойПродукции");
		Контракт.ВариантВыбытияМаркированнойПродукции =
			НормализованноеЗначениеВариантаВыбытияМаркированнойПродукции(ВариантВыбытия);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДокументРеализацииПоСчетуФактуре(СчетФактура)

	ОснованияСФ = ДокументыОснованияСчетаФактурыВыданного(СчетФактура);
	Для Каждого Основание Из ОснованияСФ Цикл
		Пока ТипЗнч(Основание) = Тип("ДокументСсылка.КорректировкаРеализации") Цикл
			Основание = ЗначениеРеквизитаОбъектаЛок(Основание, "ДокументОснование");
		КонецЦикла;
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Возврат Основание;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция НормализованноеЗначениеВариантаВыбытияМаркированнойПродукции(ЗначениеИБ)
	
	Результат = "";
	Если Не ЗначениеЗаполнено(ЗначениеИБ) Тогда
		Возврат Результат;
	КонецЕсли;

	ВариантыВыбытия = Новый Соответствие;
	
	ПеречисленияВариантыВыбытия = КонтрактыПровайдеров().ПеречислениеВариантыВыбытияМаркированнойПродукции();
	
	Если СтдСтр().СравнитьВерсииЛок(ВерсияТорговойПодсистемы(), "11.6.2") >= 0 Тогда
		
		КлючВариантаВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВариантыВыбытияМаркируемойПродукции.ДляСобственныхНужд");
		ВариантыВыбытия.Вставить(КлючВариантаВыбытия, ПеречисленияВариантыВыбытия.ДляСобственныхНужд);
			
		КлючВариантаВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВариантыВыбытияМаркируемойПродукции.БезвозмезднаяПередача");
		ВариантыВыбытия.Вставить(КлючВариантаВыбытия, ПеречисленияВариантыВыбытия.БезвозмезднаяПередача);
			
		КлючВариантаВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВариантыВыбытияМаркируемойПродукции.ДляПроизводственныхЦелей");
		ВариантыВыбытия.Вставить(КлючВариантаВыбытия, ПеречисленияВариантыВыбытия.ДляПроизводственныхЦелей);
			
		КлючВариантаВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВариантыВыбытияМаркируемойПродукции.ПродажаПоГосКонтракту");
		ВариантыВыбытия.Вставить(КлючВариантаВыбытия, ПеречисленияВариантыВыбытия.ПродажаПоГосКонтракту);
		
	Иначе
			
		КлючВариантаВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВариантыВыбытияМаркируемойПродукции.ИспользованиеПокупателемДляСобственныхНужд");
		ВариантыВыбытия.Вставить(КлючВариантаВыбытия, ПеречисленияВариантыВыбытия.ДляСобственныхНужд);
			
		КлючВариантаВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВариантыВыбытияМаркируемойПродукции.БезвозмезднаяПередачаПокупателю");
		ВариантыВыбытия.Вставить(КлючВариантаВыбытия, ПеречисленияВариантыВыбытия.БезвозмезднаяПередача);
		
	КонецЕсли;
	
	Результат = ВариантыВыбытия.Получить(ЗначениеИБ);
	Если Результат = Неопределено Тогда
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьУчетВыбытияМаркированнойПродукции()
	
	Результат = Ложь;
	
	ВерсияПодсистемы = ВерсияТорговойПодсистемы();
	
	Если СтдСтр().СравнитьВерсииЛок(ВерсияПодсистемы, "11.5.7.288") >= 0
		Или (ЭтоРедакцияТорговойПодсистемыНиже_11_5()
			И СтдСтр().СравнитьВерсииЛок(ВерсияПодсистемы, "11.4.14.95") >= 0) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

