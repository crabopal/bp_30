Процедура АктуализироватьРасчетыСКонтрагентами()

	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on

	ДокументыКАктуализации = ДокументыДляАктуализацииРасчетовСКонтрагентами();
	Если ДокументыКАктуализации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоРедакцияТорговойПодсистемыНеНиже_11_5() Тогда
		РегистрыСведений["СуммыДокументовВВалютахУчета"].РассчитатьСуммыДокументовВВалютахУчета(
			ДокументыКАктуализации);
	Иначе
		РегистрыСведений["СуммыДокументовВВалютеРегл"].РассчитатьСуммыДокументовВВалютеРегл(
			ДокументыКАктуализации);
	КонецЕсли;

КонецПроцедуры

Функция ДокументыДляАктуализацииРасчетовСКонтрагентами()

	ДокументыОснования = Новый Массив;

	ТипДокумента = ТипЗнч(УчетныйДокумент1С);

	// BSLLS:IfElseIfEndsWithElse-off
	Если ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		ДокументыОснования.Добавить(УчетныйДокумент1С);
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Основания = ДокументыОснованияКорректировочногоСчетаФактуры(УчетныйДокумент1С);
		Для Каждого Основание Из Основания Цикл
			ДополнитьМассивЗначением(ДокументыОснования, Основание.Ссылка);
		КонецЦикла;
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on

	Результат = Новый Массив;
	Для Каждого Документ Из ДокументыОснования Цикл
		Если ТребуетсяАктуализацияРасчетовСКонтрагентами(Документ) Тогда
			Результат.Добавить(Документ);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТребуетсяАктуализацияРасчетовСКонтрагентами(Документ)

	Реквизиты = ЗначенияРеквизитовОбъектаЛок(Документ, "Валюта, Организация");
	Результат = Реквизиты.Валюта <> ВалютаРегламентированногоУчета(Реквизиты.Организация);
	Возврат Результат;

КонецФункции

