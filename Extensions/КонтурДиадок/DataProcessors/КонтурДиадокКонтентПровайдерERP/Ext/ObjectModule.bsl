// ТАБЛИЦА

Функция ТаблицаТоваровУКДПоКорректировкеРеализации()
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ИнициализироватьВременнуюТаблицуДанныхДокументовУКД(МенеджерВременныхТаблиц);
	
	ПоместитьВременнуюТаблицуТоваровКорректировкиРеализацииУКД(МенеджерВременныхТаблиц);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ТекстЗапроса = ТекстЗапросаТабличнойЧастиУКДПоКорректировкеРеализации();

	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВыводитьБазовыеЕдиницыИзмерения", Константы.ВыводитьБазовыеЕдиницыИзмерения.Получить());
	Запрос.УстановитьПараметр("КолонкаКодов", ИмяКолонкиКодовНоменклатурыПечатныхФорм());
	Запрос.УстановитьПараметр("ВидПродукции", ВидыМаркируемойПродукцииИСМП());

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ИнициализироватьВременнуюТаблицуДанныхДокументовУКД(МенеджерВременныхТаблиц)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапросаВременныхТаблицДокументаКорректировкиРеализацииУКД();
	Запрос.УстановитьПараметр("Ссылка", УчетныйДокумент1С);
	ХозОперацииРеализацииЧерезКомиссионера =
		ХозяйственныеОперацииРеализацииЧерезКомиссионера();
	Запрос.УстановитьПараметр(
		"ХозОперацииРеализацииЧерезКомиссионера",
		ХозОперацииРеализацииЧерезКомиссионера);
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПоместитьВременнуюТаблицуТоваровКорректировкиРеализацииУКД(МенеджерВременныхТаблиц)
	
	ПараметрыСбора = ПараметрыСбораУКД();
	ПересчитыватьВВалютуРегл = ПересчитыватьСуммыУКДВВалютуРеглУчетаПоДаннымДокументов(МенеджерВременныхТаблиц);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если Метаданные.Справочники.Найти("СтатьиКалькуляции") <> Неопределено Тогда
		Запрос.УстановитьПараметр(
			"ПустаяСтатьяКалькуляции",
			ПредопределенноеЗначение("Справочник.СтатьиКалькуляции.ПустаяСсылка"));
	Иначе
		Запрос.УстановитьПараметр("ПустаяСтатьяКалькуляции", "");
	КонецЕсли;

	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета", Константы.ВалютаУправленческогоУчета.Получить());
	Запрос.УстановитьПараметр("ПересчитыватьВВалютуРегл", ПересчитыватьВВалютуРегл);
	Запрос.УстановитьПараметр("ВключаяДоКорректировки", Истина);
	Запрос.УстановитьПараметр("ВключаяНомераГТД", Истина);
	Запрос.УстановитьПараметр("ПустаяГТД", Справочники.НомераГТД.ПустаяСсылка());
	
	Запрос.УстановитьПараметр(
		"ХозОперацииИзлишковИНедостач",
		ХозяйственныеОперацииИзлишковИНедостач());
	Запрос.УстановитьПараметр(
		"ТипыКорректировкиДоВводаОстатков",
		ТипыКорректировкиДоВводаОстатковУКД());
	Запрос.УстановитьПараметр("ТипКорректировкиОбычная", ТипКорректировкиОбычнаяУКД());
	
	ВариантОтраженияУчестьПриИнвентаризации = ВариантОтраженияКорректировкиРеализацииУКД(
		"УвеличитьРеализациюУчестьПриИнвентаризации");
	Запрос.УстановитьПараметр(
		"ВариантОтраженияУвеличитьРеализациюУчестьПриИнвентаризации",
		ВариантОтраженияУчестьПриИнвентаризации);
	ВариантОтраженияУменьшитьСкладскиеОстатки = ВариантОтраженияКорректировкиРеализацииУКД(
		"УвеличитьРеализациюУменьшитьСкладскиеОстатки");
	Запрос.УстановитьПараметр(
		"ВариантОтраженияУвеличитьРеализациюУменьшитьСкладскиеОстатки",
		ВариантОтраженияУменьшитьСкладскиеОстатки);
	Запрос.УстановитьПараметр(
		"ВариантОтраженияУвеличитьРеализацию",
		ВариантОтраженияКорректировкиРеализацииУКД("УвеличитьРеализацию"));
	
	Запрос.УстановитьПараметр("ПустаяНоменклатураПартнера", ПустаяНоменклатураПартнера());
	
	Если Не ПараметрыСбора.ЕстьПодсистемаПрослеживаемости Тогда
		Запрос.УстановитьПараметр("ИспользоватьУчетПрослеживаемыхИмпортныхТоваров", Ложь);
		Запрос.УстановитьПараметр("ДатаНачалаУчетаПрослеживаемыхИмпортныхТоваров", Дата(1, 1, 1));
		Запрос.УстановитьПараметр("ИдентификаторУведомлениеОВвозеПрослеживаемыхТоваров", "");
	Иначе
		МодульПрослеживаемости = ОбщийМодульЛок("УчетПрослеживаемыхТоваровЛокализация");
		МодульПрослеживаемости.УстановитьПараметрыИспользованияУчетаПрослеживаемыхТоваров(Запрос);
	КонецЕсли;
	
	ИмяОпцииПодакцизныеТовары = "ИспользоватьПодакцизныеТовары";
	Если ПараметрыСбора.ЕстьПодсистемаПодакцизныхТоваров Тогда
		ЗначениеОпцииПодакцизныеТовары = ПолучитьФункциональнуюОпцию(ИмяОпцииПодакцизныеТовары);
		Запрос.УстановитьПараметр(ИмяОпцииПодакцизныеТовары, ЗначениеОпцииПодакцизныеТовары);
	Иначе
		Запрос.УстановитьПараметр(ИмяОпцииПодакцизныеТовары, Ложь);
	КонецЕсли;
	
	СформироватьВТСуммыДокументаВВалютахУчетаКорректировкиРеализацииУКД(Запрос);
	
	Запрос.УстановитьПараметр("ОснованиеНеЗаписанногоДокумента", Неопределено);
	
	Запрос.Текст = ТекстЗапросаВтВидыЗапасовКорректировкиРеализацииУКД();
	Запрос.Выполнить();
	
	Запрос.УстановитьПараметр(
		"ПредыдущиеДокументы",
		ТаблицаПредыдущихДокументовКорректировкиРеализации(Запрос));
	
	ТекстЗапроса = ТекстЗапросаВременнойТаблицыТоваровКорректировкиРеализации();
	ДополнитьТекстЗапросаТаблицыТоваровКорректировкиРеализацииНаборами(ТекстЗапроса);
	Запрос.УстановитьПараметр(
		"ЗаполненаЕдиницаИзмеренияВеса",
		ЗначениеЗаполнено(Константы.ЕдиницаИзмеренияВеса.Получить()));

	Запрос.Текст = ТекстЗапроса;
	
	Запрос.Выполнить();
	
КонецПроцедуры

// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MethodSize-off
Функция ТекстЗапросаВременнойТаблицыТоваровКорректировкиРеализации()
	// BSLLS:QueryNestedFieldsByDot-off
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	// BSLLS:LogicalOrInJoinQuerySection-off
	// BSLLS:JoinWithSubQuery-off
	// BSLLS:JoinWithVirtualTable-off
	// BSLLS:AssignAliasFieldsInQuery-off
	// BSLLS:DuplicateStringLiteral-off
	
	Результат =
	"ВЫБРАТЬ
	|	ПредыдущиеДокументы.Основной КАК Основной,
	|	ПредыдущиеДокументы.Предыдущий КАК Предыдущий
	|
	|ПОМЕСТИТЬ ПредыдущиеДокументы
	|ИЗ
	|	&ПредыдущиеДокументы КАК ПредыдущиеДокументы
	|;
	|/////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Ссылка КАК Ссылка,
	|	ТаблицаТоваров.Содержание КАК Содержание,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	%Поле_ТаблицаТоваровНоменклатураПартнера КАК НоменклатураПартнера,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.Упаковка КАК Упаковка,
	|	МАКСИМУМ(ТаблицаТоваров.НомерСтроки) КАК НомерСтроки
	|
	|ПОМЕСТИТЬ СтрокиТоваров
	|ИЗ
	|	Документ.КорректировкаРеализации.Товары КАК ТаблицаТоваров
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ТаблицаДанныхДокументов КАК ДанныеДокументов
	|	ПО
	|		ТаблицаТоваров.Ссылка = ДанныеДокументов.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТоваров.Ссылка,
	|	ТаблицаТоваров.Номенклатура,
	|	%Поле_ТаблицаТоваровНоменклатураПартнера,
	|	ТаблицаТоваров.Содержание,
	|	ТаблицаТоваров.Характеристика,
	|	ТаблицаТоваров.Упаковка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТаблицаТоваров.Ссылка,
	|	ТаблицаТоваров.Номенклатура,
	|	ТаблицаТоваров.Характеристика,
	|	ТаблицаТоваров.Упаковка
	|;
	|/////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязанныеДокументы.Основной КАК Ссылка,
	|	Товары.НоменклатураНабора КАК НоменклатураНабора,
	|	Товары.ХарактеристикаНабора КАК ХарактеристикаНабора,
	|	ЛОЖЬ КАК ВернутьМногооборотнуюТару,
	|	"""" КАК Содержание,
	|	Товары.Номенклатура КАК Номенклатура,
	|	%Поле_ТоварыНоменклатураПартнера КАК НоменклатураПартнера,
	|	%Поле_ТоварыНоменклатураПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	Товары.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
	|	&ПустаяГТД КАК НомерГТД,
	|	Товары.Количество КАК Количество,
	|	Товары.Количество КАК КоличествоУпаковок,
	|	0 КАК КоличествоПоРНПТ,
	|	ЕСТЬNULL(СуммыРегл.СуммаБезНДСРегл, Товары.СуммаСНДС - Товары.СуммаНДС) КАК СуммаБезНДС,
	|	
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	
	|	ЕСТЬNULL(СуммыРегл.СуммаНДСРегл, Товары.СуммаНДС) КАК СуммаНДС,
	|	
	|	ЛОЖЬ КАК ЭтоТовар,
	|	ЛОЖЬ КАК ЭтоНеВозвратнаяТара,
	|	ЛОЖЬ КАК ДоКорректировки
	|ПОМЕСТИТЬ ВсеУслуги
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСвязанныеДокументы КАК СвязанныеДокументы
	|		ПО Товары.Ссылка = СвязанныеДокументы.Подчиненный
	|		ЛЕВОЕ СОЕДИНЕНИЕ %Поле_РегистрСуммыДокументов КАК СуммыРегл
	|		ПО Товары.Ссылка = СуммыРегл.Регистратор
	|			%Поле_СоедСуммыИдТовары
	|			И СуммыРегл.Активность
	|			И &ПересчитыватьВВалютуРегл
	|ГДЕ
	|	Товары.Номенклатура.ТипНоменклатуры НЕ В (
	|		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар),
	|		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара))
	|	ИЛИ Товары.Номенклатура.ТипНоменклатуры ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СвязанныеДокументы.Основной КАК Ссылка,
	|	Товары.НоменклатураНабора КАК НоменклатураНабора,
	|	Товары.ХарактеристикаНабора КАК ХарактеристикаНабора,
	|	ЛОЖЬ КАК ВернутьМногооборотнуюТару,
	|	Товары.Содержание КАК Содержание,
	|	Товары.Номенклатура КАК Номенклатура,
	|	%Поле_ТоварыНоменклатураПартнера КАК НоменклатураПартнера,
	|	%Поле_ТоварыНоменклатураПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	Товары.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
	|	&ПустаяГТД КАК НомерГТД,
	|	Товары.Количество КАК Количество,
	|	Товары.Количество КАК КоличествоУпаковок,
	|	0 КАК КоличествоПоРНПТ,
	|	ЕСТЬNULL(СуммыРегл.СуммаБезНДСРегл, Товары.СуммаСНДС - Товары.СуммаНДС) КАК СуммаБезНДС,
	|	
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	
	|	ЕСТЬNULL(СуммыРегл.СуммаНДСРегл, Товары.СуммаНДС) КАК СуммаНДС,
	|	
	|	ЛОЖЬ КАК ЭтоТовар,
	|	ЛОЖЬ КАК ЭтоНеВозвратнаяТара,
	|	ЛОЖЬ КАК ДоКорректировки
	|ИЗ
	|	Документ.АктВыполненныхРабот.Услуги КАК Товары
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСвязанныеДокументы КАК СвязанныеДокументы
	|		ПО Товары.Ссылка = СвязанныеДокументы.Подчиненный
	|		ЛЕВОЕ СОЕДИНЕНИЕ %Поле_РегистрСуммыДокументов КАК СуммыРегл
	|		ПО Товары.Ссылка = СуммыРегл.Регистратор
	|			%Поле_СоедСуммыИдТовары
	|			И СуммыРегл.Активность
	|			И &ПересчитыватьВВалютуРегл
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СвязанныеДокументы.Основной КАК Ссылка,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка),
	|	ЛОЖЬ КАК ВернутьМногооборотнуюТару,
	|	Товары.Содержание КАК Содержание,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
	|	&ПустаяНоменклатураПартнера КАК НоменклатураПартнера,
	|	ЛОЖЬ КАК ПрослеживаемыйТовар,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
