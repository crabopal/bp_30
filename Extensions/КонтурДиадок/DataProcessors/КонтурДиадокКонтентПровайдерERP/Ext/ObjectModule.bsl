Функция ТаблицаТоваровУКДПоСчетФактураВыданный()

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	МассивЗапросов = Новый Массив;
	МассивЗапросов.Добавить(ТекстЗапросаТоваровСчетФактураВыданныйУКД());
	МассивЗапросов.Добавить(ТекстЗапросаТаблицыДанныхДокументовДляНаборовУКД());
	МассивЗапросов.Добавить(ТекстЗапросаВременнойТаблицыНаборовУКД());
	МассивЗапросов.Добавить(ТекстЗапросаТаблицыТоваровСУчетомНаборовУКД());
	Запрос.Текст = СтдСтр().СтрСоединитьЛок(МассивЗапросов, РазделительПакетаЗапросов());

	Запрос.УстановитьПараметр("СчетФактура", УчетныйДокумент1С);
	Запрос.УстановитьПараметр("КолонкаКодов", ИмяКолонкиКодовНоменклатурыПечатныхФорм());
	УстановитьПараметрыЗапросаНаборовУКД(Запрос);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ТекстЗапросаТоваровСчетФактураВыданныйУКД()

	Если ЭтоРедакцияТорговойПодсистемыНиже_11_5() Тогда
		Результат = ТекстЗапросаТоваровСчетФактураВыданныйУКД_11_4();
	Иначе
		Результат = ТекстЗапросаТоваровСчетФактураВыданныйУКД_11_5();
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ТекстЗапросаТоваровСчетФактураВыданныйУКД_11_4()
	// BSLLS:QueryNestedFieldsByDot-off
	// BSLLS:LogicalOrInTheWhereSectionOfQuery-off
	// BSLLS:LogicalOrInJoinQuerySection-off
	// BSLLS:JoinWithSubQuery-off
	// BSLLS:JoinWithVirtualTable-off
	// BSLLS:AssignAliasFieldsInQuery-off
	// BSLLS:DuplicateStringLiteral-off

	Результат =
	"ВЫБРАТЬ
	|	ТЧТовары.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ТЧТовары.НомерСтрокиПриПечати <> 0
	|			ТОГДА ТЧТовары.НомерСтрокиПриПечати
	|		ИНАЧЕ ТЧТовары.НомерСтроки
	|	КОНЕЦ КАК НомерСтроки,
	|	ТЧТовары.НомерСтрокиИсходногоСФ КАК НомерСтрокиИсходногоСФ,
	|	ТЧТовары.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ТЧТовары.Содержание = """"
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(ВЫРАЗИТЬ(НоменклатураДанные.НаименованиеПолное КАК СТРОКА(1000)), """") = """"
	|						ТОГДА ЕСТЬNULL(НоменклатураДанные.Наименование, """")
	|					ИНАЧЕ НоменклатураДанные.НаименованиеПолное
	|				КОНЕЦ
