// ШАПКА

Процедура ЗаполнитьРеквизитыШапкиУКДПоСчетФактураВыданный(Контракт)

	ДанныеШапки = ДанныеШапкиУКДПоСчетФактураВыданный();

	Контракт.Ссылка = ДанныеШапки.Ссылка;
	Контракт.Номер = ДанныеШапки.Номер;
	Если ЗначениеЗаполнено(ДанныеШапки.ПредставлениеНомера) Тогда
		Контракт.ПредставлениеНомера = ДанныеШапки.ПредставлениеНомера;
	Иначе
		Контракт.ПредставлениеНомера = ПредставлениеНомераСчетаФактурыВыданного(ДанныеШапки.Ссылка);
	КонецЕсли;
	Контракт.Дата = ДанныеШапки.Дата;
	ЗаполнитьИсправлениеШапкиУКД(Контракт, ДанныеШапки);

	ЗаполнитьПродавцаИСоставителяШапкиУКД(Контракт, ДанныеШапки);
	
	Контракт.Покупатель = ДанныеШапки.Контрагент;
	Контракт.БанковскийСчетПокупателя = ДанныеШапки.БанковскийСчетКонтрагента;
	Контракт.КПППокупателя = ДанныеШапки.КПППокупателя;

	Контракт.Договор = ДанныеШапки.Договор;
	Контракт.Соглашение = ДанныеШапки.Соглашение;
	Контракт.Основание = ДанныеШапки.Основание;
	Контракт.ОснованиеНомер = ДанныеШапки.ОснованиеНомер;
	Контракт.ОснованиеДата = ДанныеШапки.ОснованиеДата;
	
	Контракт.КодВидаОперации = СокрЛП(СтдКоллекции().СвойствоСтруктурыЛок(ДанныеШапки, "КодВидаОперации", ""));
	Контракт.ВидОперации = ВидОперацииУКДПоСчетуФактуре(ДанныеШапки);
	Контракт.Налогообложение = НалогообложениеУКД(ДанныеШапки.НалогообложениеНДС);
	
	ЗаполнитьВалютуШапкиУКД(Контракт, ДанныеШапки);
	Контракт.ИдентификаторГосКонтракта = ДанныеШапки.ИдентификаторГосКонтракта;
	Контракт.ЭтоВозвратТоваровОтКлиента = ДанныеШапки.ЭтоВозвратТоваровОтКлиента;

	Контракт.ПервичныеДокументы = РеквизитыПервичныхДокументовПоСчетуФактуреВыданному();
	Контракт.ДокументыОснования = РеквизитыДокументовОснованияПоСчетуФактуреВыданному();
	
	ЗаполнитьВариантВыбытияМаркированнойПродукции(Контракт);
	
	ЗаполнитьПокупателяКлиентомПриРеализацииЧерезКомиссионера(
		Контракт,
		СтдКоллекции().СвойствоСтруктурыЛок(ДанныеШапки, "КлиентКонтрагент", Неопределено));

КонецПроцедуры

Процедура ЗаполнитьПокупателяКлиентомПриРеализацииЧерезКомиссионера(Контракт, Клиент)

	ВидыОперации = КонтрактыПровайдеров().ПеречислениеВидОперацииУКД();
	Если Контракт.ВидОперации = ВидыОперации.РеализацияЧерезКомиссионера
		И ЗначениеЗаполнено(Клиент) Тогда
		РеквизитыПокупателя = ПокупательИКПППоСсылкеУчастника(Клиент);
		Контракт.Покупатель = РеквизитыПокупателя.Покупатель;
		Контракт.КПППокупателя = РеквизитыПокупателя.КПППокупателя;
	КонецЕсли;

КонецПроцедуры

Функция ПокупательИКПППоСсылкеУчастника(СсылкаУчастника)

	Результат = Новый Структура;
	Результат.Вставить("Покупатель", СсылкаУчастника);
	Результат.Вставить("КПППокупателя", "");

	Если ТипЗнч(СсылкаУчастника) = Тип("СправочникСсылка.Контрагенты") Тогда
		Результат = ПокупательИКПППоКонтрагенту(СсылкаУчастника);
	КонецЕсли;
	Если ТипЗнч(СсылкаУчастника) = Тип("СправочникСсылка.Организации") Тогда
		Результат = ПокупательИКПППоОрганизации(СсылкаУчастника);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПокупательИКПППоКонтрагенту(Контрагент)

	Результат = Новый Структура;
	Результат.Вставить("Покупатель", Контрагент);
	Результат.Вставить("КПППокупателя", "");

	Реквизиты = ЗначенияРеквизитовОбъектаЛок(
		Контрагент,
		"ОбособленноеПодразделение, ГоловнойКонтрагент, КПП");
	Если Реквизиты.ОбособленноеПодразделение
		И ЗначениеЗаполнено(Реквизиты.ГоловнойКонтрагент) Тогда
		Результат.Покупатель = Реквизиты.ГоловнойКонтрагент;
		Если ЗначениеЗаполнено(Реквизиты.КПП) Тогда
			Результат.КПППокупателя = Реквизиты.КПП;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПокупательИКПППоОрганизации(Организация)

	Результат = Новый Структура;
	Результат.Вставить("Покупатель", Организация);
	Результат.Вставить("КПППокупателя", "");

	Реквизиты = ЗначенияРеквизитовОбъектаЛок(
		Организация,
		"ОбособленноеПодразделение, ГоловнаяОрганизация, КПП");
	Если Реквизиты.ОбособленноеПодразделение
		И ЗначениеЗаполнено(Реквизиты.ГоловнаяОрганизация) Тогда
		Результат.Покупатель = Реквизиты.ГоловнаяОрганизация;
		Если ЗначениеЗаполнено(Реквизиты.КПП) Тогда
			Результат.КПППокупателя = Реквизиты.КПП;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьПродавцаИСоставителяШапкиУКД(Контракт, ДанныеШапки)
	
	Если ЗначениеЗаполнено(ДанныеШапки.Поставщик)
		И ДанныеШапки.Поставщик <> ДанныеШапки.Организация Тогда
		
		Контракт.Составитель = ДанныеШапки.Организация;
		Контракт.Продавец = ДанныеШапки.Поставщик;
		
	Иначе
		
		Контракт.Продавец = ДанныеШапки.Организация;
		Контракт.БанковскийСчетПродавца = ДанныеШапки.БанковскийСчетОрганизации;
		Контракт.КПППродавца = ДанныеШапки.КПППоставщика;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьВалютуШапкиУКД(Контракт, ДанныеШапки)

	Если ПересчитыватьСуммыУКДВВалютуРеглУчета(ДанныеШапки) Тогда
		Контракт.ВалютаДокумента = ВалютаРегламентированногоУчета(ДанныеШапки.Организация);
	Иначе
		Контракт.ВалютаДокумента = ДанныеШапки.Валюта;
	КонецЕсли;
	Контракт.РасчетыВУсловныхЕдиницах = Ложь;

КонецПроцедуры

Функция ПересчитыватьСуммыУКДВВалютуРеглУчетаПоДаннымДокументов(МенеджерВременныхТаблиц)

	Результат = Ложь;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДанныеДокументов.Валюта КАК Валюта,
	|	ДанныеДокументов.Организация КАК Организация,
	|	ДанныеДокументов.Договор КАК Договор,
	|	ДанныеДокументов.Соглашение КАК Соглашение
	|ИЗ
	|	ТаблицаДанныхДокументов КАК ДанныеДокументов";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = ПересчитыватьСуммыУКДВВалютуРеглУчета(Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПересчитыватьСуммыУКДВВалютуРеглУчета(ДанныеШапки)

	ВалютаРегл = ВалютаРегламентированногоУчета(ДанныеШапки.Организация);
	ОплатаВВалюте = ОплатаВВалютеПоДоговоруИСоглашению(
		ДанныеШапки.Договор,
		ДанныеШапки.Соглашение);
	Результат = ЗначениеЗаполнено(ВалютаРегл)
		И ДанныеШапки.Валюта <> ВалютаРегл
		И Не ОплатаВВалюте;

	Возврат Результат;

КонецФункции

Функция ОплатаВВалютеПоДоговоруИСоглашению(Договор, Соглашение)

	Результат = Истина;

	УсловияРасчетов = Договор;
	Если Не ЗначениеЗаполнено(УсловияРасчетов) Тогда
		УсловияРасчетов = Соглашение;
	КонецЕсли;

	Если ЗначениеЗаполнено(УсловияРасчетов) Тогда
		МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
		ЕстьРеквизитОплатаВВалюте = МодульОбщегоНазначения.ЕстьРеквизитОбъекта(
			"ОплатаВВалюте",
			УсловияРасчетов.Метаданные());
		Если ЕстьРеквизитОплатаВВалюте Тогда
			Результат = ЗначениеРеквизитаОбъектаЛок(УсловияРасчетов, "ОплатаВВалюте");
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ВалютаРегламентированногоУчета(Организация)

	Если ПараметрыСбораУКД().РасчетыСКлиентамиПоВалютеКонстанты Тогда
		Результат = Константы.ВалютаРегламентированногоУчета.Получить();
	ИначеЕсли ЗначениеЗаполнено(Организация) Тогда
		Результат = ЗначениеРеквизитаОбъектаЛок(Организация, "ВалютаРегламентированногоУчета");
	Иначе
		Результат = Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ДополнитьДанныеШапкиУКДПоставщиком(ДанныеШапки)
	
	Поставщик = Справочники.Контрагенты.ПустаяСсылка();
	
	СчетФактура = СчетФактураВыданныйДляШапкиУКД(ДанныеШапки.Ссылка);
	Если ЭтоСчетФактураПеревыставленный(СчетФактура) Тогда
		Поставщик = ПоставщикСчетаФактурыПеревыставленный(СчетФактура);
	КонецЕсли;
	
	ДанныеШапки.Вставить("Поставщик", Поставщик);
	
КонецПроцедуры

Функция СчетФактураВыданныйДляШапкиУКД(Документ)

	Если ТипЗнч(Документ) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Результат = Документ;
	Иначе
		Результат = СчетФактураВыданныйПоДокументуОснованию(Документ);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// BSLLS:Typo-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MissingParameterDescription-off
Функция ЭтоСчетФактураПеревыставленный(СчетФактура)

	// BSLLS:MissingReturnedValueDescription-on
	// BSLLS:MissingParameterDescription-on
	// BSLLS:Typo-on

	Результат = Ложь;
	Если ЗначениеЗаполнено(СчетФактура)
		// BSLLS:Typo-off
		И ПараметрыСбораУКД().ЕстьРеквизитПеревыставленный Тогда
		Результат = (ЗначениеРеквизитаОбъектаЛок(СчетФактура, "Перевыставленный") = Истина);
		// BSLLS:Typo-on
	КонецЕсли;

	Возврат Результат;

КонецФункции

// BSLLS:Typo-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MissingParameterDescription-off
Функция ПоставщикСчетаФактурыПеревыставленный(СчетФактура)

	// BSLLS:MissingReturnedValueDescription-on
	// BSLLS:MissingParameterDescription-on
	// BSLLS:Typo-on

	Результат = Справочники.Контрагенты.ПустаяСсылка();

	Если ЗначениеЗаполнено(СчетФактура)
		И ПараметрыСбораУКД().ЕстьСчетФактураПолученныйОтПродавца Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СчетФактураПолученный.Контрагент КАК Поставщик
		|ИЗ
		|	Документ.СчетФактураВыданный.Товары КАК СчетФактураВыданныйТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|		ПО СчетФактураВыданныйТовары.СчетФактураПолученныйОтПродавца = СчетФактураПолученный.Ссылка
		|ГДЕ
		|	СчетФактураВыданныйТовары.Ссылка = &СчетФактура";
		Запрос.УстановитьПараметр("СчетФактура", СчетФактура);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Поставщик;
		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ДанныеШапкиУКДПоСчетФактураВыданный()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетФактура.Ссылка КАК Ссылка,
	|	СчетФактура.Номер КАК Номер,
	|	СчетФактура.ПредставлениеНомера КАК ПредставлениеНомера,
	|	СчетФактура.КодВидаОперации КАК КодВидаОперации,
	|	ВЫБОР
	|		КОГДА СчетФактура.Исправление
	|			ТОГДА ЕСТЬNULL(ИсходныйСчетФактура.Дата, ДАТАВРЕМЯ(1, 1, 1))
	|		ИНАЧЕ СчетФактура.Дата
	|	КОНЕЦ КАК Дата,
	|	СчетФактура.Исправление КАК Исправление,
	|	СчетФактура.НомерИсправления КАК НомерИсправления,
	|	СчетФактура.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА СчетФактура.Исправление
	|			ТОГДА СчетФактура.Дата
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ КАК ДатаИсправления,
	|	ВЫБОР
	|		КОГДА Организации.ОбособленноеПодразделение
	|				И Организации.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА Организации.ГоловнаяОрганизация
	|		ИНАЧЕ СчетФактура.Организация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА Контрагенты.Ссылка ЕСТЬ НЕ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА Контрагенты.ОбособленноеПодразделение
	|							И Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|						ТОГДА Контрагенты.ГоловнойКонтрагент
	|					ИНАЧЕ СчетФактура.Контрагент
	|				КОНЕЦ
	|		КОГДА ОрганизацииКонтрагент.Ссылка ЕСТЬ НЕ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА ОрганизацииКонтрагент.ОбособленноеПодразделение
	|							И ОрганизацииКонтрагент.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|						ТОГДА ОрганизацииКонтрагент.ГоловнаяОрганизация
	|					ИНАЧЕ СчетФактура.Контрагент
	|				КОНЕЦ
	|		ИНАЧЕ СчетФактура.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА СчетФактура.КППКонтрагента <> """"
	|			ТОГДА СчетФактура.КППКонтрагента
	|		КОГДА Контрагенты.ОбособленноеПодразделение
	|				И Контрагенты.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Контрагенты.КПП, """")
	|		КОГДА ОрганизацииКонтрагент.ОбособленноеПодразделение
	|				И ОрганизацииКонтрагент.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА ОрганизацииКонтрагент.КПП
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КПППокупателя,
	|	"""" КАК КПППоставщика,
	|	СчетФактура.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	|	%Поле_СчетФактураРеализацияЧерезКомиссионера КАК РеализацияЧерезКомиссионера
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК ИсходныйСчетФактура
	|		ПО СчетФактура.СчетФактураОснование = ИсходныйСчетФактура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО СчетФактура.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО СчетФактура.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК ОрганизацииКонтрагент
	|		ПО СчетФактура.Контрагент = ОрганизацииКонтрагент.Ссылка
	|ГДЕ
	|	СчетФактура.Ссылка = &СчетФактура";
	Запрос.УстановитьПараметр("СчетФактура", УчетныйДокумент1С);

	ПолеРеализацияЧерезКомиссионера = "ЛОЖЬ";
	Если ПараметрыСбораУКД().ЕстьРеализацияЧерезКомиссионера Тогда
		ПолеРеализацияЧерезКомиссионера = "СчетФактура.РеализацияЧерезКомиссионера";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(
		Запрос.Текст,
		"%Поле_СчетФактураРеализацияЧерезКомиссионера",
		ПолеРеализацияЧерезКомиссионера);

	РеквизитыДокумента = Запрос.Выполнить().Выгрузить();
	Если РеквизитыДокумента.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru='Не найдены данные счета-фактуры выданного для заполнения шапки УКД.'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	Результат = МодульОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РеквизитыДокумента[0]);

	ДополнитьДанныеШапкиУКДРеквизитамиДокументаОснования(Результат);
	ДополнитьДанныеШапкиУКДПоставщиком(Результат);
	
	Возврат Результат;

КонецФункции

Процедура ДополнитьДанныеШапкиУКДРеквизитамиДокументаОснования(ДанныеШапки)
	
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Основание");
	ИменаРеквизитов.Добавить("ОснованиеНомер");
	ИменаРеквизитов.Добавить("ОснованиеДата");
	ИменаРеквизитов.Добавить("Договор");
	ИменаРеквизитов.Добавить("Соглашение");
	ИменаРеквизитов.Добавить("НалогообложениеНДС");
	ИменаРеквизитов.Добавить("БанковскийСчетОрганизации");
	ИменаРеквизитов.Добавить("БанковскийСчетКонтрагента");
	ИменаРеквизитов.Добавить("ХозяйственнаяОперация");
	ИменаРеквизитов.Добавить("КлиентКонтрагент");
	
	ДанныеШапки.Вставить("ЭтоВозвратТоваровОтКлиента", Ложь);
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		ДанныеШапки.Вставить(ИмяРеквизита);
	КонецЦикла;
	
	ДокументыОснования = ДокументыОснованияСчетаФактурыВыданного(ДанныеШапки.Ссылка);
	Если ДокументыОснования.Количество() = 0
		Или Не ЗначениеЗаполнено(ДокументыОснования[0]) Тогда
		Возврат;
	КонецЕсли;

	ДокументОснование = ДокументыОснования[0];
	
	ДанныеШапки.ЭтоВозвратТоваровОтКлиента =
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ВозвратТоваровОтКлиента");
		
	МодульОбщегоНазначения = ОбщийМодульЛок("ОбщегоНазначения");
	МетаданныеДокумента = ДокументОснование.Метаданные();
	
	РеквизитыКЧтению = Новый Структура;
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Если МодульОбщегоНазначения.ЕстьРеквизитОбъекта(ИмяРеквизита, МетаданныеДокумента) Тогда
			РеквизитыКЧтению.Вставить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;

	Если РеквизитыКЧтению.Количество() > 0 Тогда
		РеквизитыОснования = ЗначенияРеквизитовОбъектаЛок(ДокументОснование, РеквизитыКЧтению);
		СтдКоллекции().ДополнитьСтруктуруЛок(ДанныеШапки, РеквизитыОснования, Истина);
	КонецЕсли;
	
	КППОбособленногоПодразделения = КППОбособленногоПодразделенияПоДокументу(ДокументОснование);
	Если ЗначениеЗаполнено(КППОбособленногоПодразделения) Тогда
		ДанныеШапки.КПППоставщика = КППОбособленногоПодразделения;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьИсправлениеШапкиУКД(Контракт, ДанныеШапки)

	НомерИсправления = СтдКоллекции().СвойствоСтруктурыЛок(ДанныеШапки, "НомерИсправления", "");
	ДатаИсправления = СтдКоллекции().СвойствоСтруктурыЛок(ДанныеШапки, "ДатаИсправления", Дата(1, 1, 1));

	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		Контракт.НомерИсправления = СокрЛП(НомерИсправления);
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаИсправления) Тогда
		Контракт.ДатаИсправления = ДатаИсправления;
	КонецЕсли;

КонецПроцедуры

Функция ТоварныеДокументыДоКорректировкиПоСчетуФактуреВыданному()

	Результат = Новый Массив;
	ИсходныйСчетФактура = ИсходныйСчетФактураПоКорректировочномуСФ(УчетныйДокумент1С);
	Если ЗначениеЗаполнено(ИсходныйСчетФактура) Тогда
		ДокументыОснования = ДокументыОснованияСчетаФактурыВыданного(ИсходныйСчетФактура);
		СтдКоллекции().ДополнитьМассивЛок(Результат, ДокументыОснования, Истина);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ИсходныйСчетФактураПоКорректировочномуСФ(СчетФактура)

	Результат = Документы.СчетФактураВыданный.ПустаяСсылка();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТЧТовары.ПредыдущийСчетФактура КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.Товары КАК ТЧТовары
	|ГДЕ
	|	ТЧТовары.Ссылка = &Ссылка
	|	И ТЧТовары.ПредыдущийСчетФактура <> ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка", СчетФактура);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ДокументыОснованияСчетаФактурыВыданного(СчетФактура)

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.ДокументОснование КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Таблица.НомерСтроки";
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДополнитьМассивЗначением(Результат, Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РеквизитыПервичныхДокументовПоСчетуФактуреВыданному()
	
	Результат = Новый Массив;
	Основания = ДокументыОснованияКорректировочногоСчетаФактуры(УчетныйДокумент1С);
	
	Для Каждого Основание Из Основания Цикл
		
		ПервичныйДокумент = НайтиПервичныйДокументУКДПоДокументамОснования(Основание.Ссылка);
		СчетФактура = СчетФактураВыданныйПоДокументуОснованию(ПервичныйДокумент);
		ДобавитьРеквизитыПервичногоДокументаУКДВКоллекцию(Результат, СчетФактура);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыОснованияКорректировочногоСчетаФактуры(СчетФактура)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.ДокументОснование КАК Ссылка,
	|	Таблица.ПорядковыеНомераСтрок КАК ПорядковыеНомераСтрок,
	|	Таблица.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураШапка
	|		ПО Таблица.Ссылка = СчетФактураШапка.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|		ПО Таблица.ДокументОснование = КорректировкаРеализации.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|	И СчетФактураШапка.Корректировочный
	|	И НЕ КорректировкаРеализации.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таблица.ДокументОснование,
	|	Таблица.ПорядковыеНомераСтрок,
	|	Таблица.НомерСтроки
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураШапка
	|		ПО Таблица.Ссылка = СчетФактураШапка.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтКлиента КАК ВозвратТоваровОтКлиента
	|		ПО Таблица.ДокументОснование = ВозвратТоваровОтКлиента.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|	И СчетФактураШапка.Корректировочный
	|	И НЕ ВозвратТоваровОтКлиента.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

