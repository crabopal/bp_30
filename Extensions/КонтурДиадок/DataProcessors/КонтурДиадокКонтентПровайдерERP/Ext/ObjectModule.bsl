Функция ТаблицаПредыдущихДокументовКорректировкиРеализации(Запрос)
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СвязанныеДокументы.Основной КАК Основной,
	|	СвязанныеДокументы.Подчиненный КАК Предыдущий
	|ИЗ
	|	ВтСвязанныеДокументы КАК СвязанныеДокументы
	|
	|ГДЕ
	|	СвязанныеДокументы.Подчиненный <> СвязанныеДокументы.Основной
	|
	|УПОРЯДОЧИТЬ ПО
	|	СвязанныеДокументы.МоментВремени УБЫВ
	|
	|ИТОГИ ПО
	|	СвязанныеДокументы.Основной
	|";
	РезультатЗапроса = Запрос.Выполнить();
	
	ТипыПредыдущихДокументов = Новый Массив;
	ТипыПредыдущихДокументов.Добавить(Тип("ДокументСсылка.КорректировкаРеализации"));
	ТипыПредыдущихДокументов.Добавить(Тип("ДокументСсылка.ПервичныйДокумент"));
	ТипыПредыдущихДокументов.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
	ТипыПредыдущихДокументов.Добавить(Тип("ДокументСсылка.АктВыполненныхРабот"));
	ТипыПредыдущихДокументов.Добавить(Тип("ДокументСсылка.РеализацияУслугПрочихАктивов"));
	
	Если ПараметрыСбораУКД().ЕстьОтчетДавальцу2_5 Тогда
		ТипыПредыдущихДокументов.Добавить(Тип("ДокументСсылка.ОтчетДавальцу2_5"));
	КонецЕсли;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Основной", Новый ОписаниеТипов("ДокументСсылка.КорректировкаРеализации"));
	Результат.Колонки.Добавить("Предыдущий", Новый ОписаниеТипов(ТипыПредыдущихДокументов));
	
	ВыборкаПоСсылкам = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоСсылкам.Следующий() Цикл
		Выборка = ВыборкаПоСсылкам.Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТабличныеДанныеУКДПоКорректировкеРеализации()
	
	ТаблицаТоваров = ТаблицаТоваровУКДПоКорректировкеРеализации();
	
	Результат = СтрокиКонтрактаУКДИзТабличныхДанных(ТаблицаТоваров);
		
	Возврат Результат;
	
КонецФункции

