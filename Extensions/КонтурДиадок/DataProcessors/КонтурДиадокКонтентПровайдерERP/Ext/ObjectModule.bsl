Процедура ПодставитьПоляИзПараметровСбораУКД(ТекстЗапроса, КартаПолей)

	КлючиПоУбываниюДлины = КлючиКартыПоУбываниюДлины(КартаПолей);
	Для Каждого Ключ Из КлючиПоУбываниюДлины Цикл
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"%Поле_" + Ключ,
			КартаПолей[Ключ]);
	КонецЦикла;

КонецПроцедуры

Функция КлючиКартыПоУбываниюДлины(КартаПолей)

	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из КартаПолей Цикл
		Результат.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Граница = Результат.ВГраница();
	Для Индекс = 0 По Граница Цикл
		Для Внутренний = 0 По Граница - Индекс - 1 Цикл
			Если СтрДлина(Результат[Внутренний]) < СтрДлина(Результат[Внутренний + 1]) Тогда
				Буфер = Результат[Внутренний];
				Результат[Внутренний] = Результат[Внутренний + 1];
				Результат[Внутренний + 1] = Буфер;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

