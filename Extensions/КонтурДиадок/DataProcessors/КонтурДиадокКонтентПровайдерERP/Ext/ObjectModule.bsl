Функция ТипНоменклатурыУКД(Номенклатура)

	ТипыНоменклатуры = КонтрактыПровайдеров().ПеречислениеТипыНоменклатуры();
	ТипНоменклатуры = ЗначениеРеквизитаОбъектаЛок(Номенклатура, "ТипНоменклатуры");
	
	Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
		Результат = ТипыНоменклатуры.Товар;
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
		Результат = ТипыНоменклатуры.Услуга;
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
		Результат = ТипыНоменклатуры.Работа;
	Иначе
		Результат = ТипыНоменклатуры.Иное;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьПредставлениеНоменклатурыСчетаФактурыПоОтчетуДавальцу(СтрокиКонтракта)

	ПервичныйДокумент = НайтиПервичныйДокументУКДПоДокументамОснования(ТоварныйДокументУКД());
	Если ТипЗнч(ПервичныйДокумент) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Основания = ДокументыОснованияСчетаФактурыВыданного(ПервичныйДокумент);
		Если Основания.Количество() > 0 Тогда
			ПервичныйДокумент = НайтиПервичныйДокументУКДПоДокументамОснования(Основания[0]);
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоОтчетДавальцу2_5(ПервичныйДокумент) Тогда
		
		ШаблонСодержания = НСтр("ru = 'Услуга по выпуску продукции ""%1"" из давальческого сырья'");
		ТипыНоменклатуры = КонтрактыПровайдеров().ПеречислениеТипыНоменклатуры();
		
		Для Каждого СтрокаКонтракта Из СтрокиКонтракта Цикл
			ЗаполнитьСодержаниеСтрокиТовараОтчетаДавальцу(
				СтрокаКонтракта,
				ШаблонСодержания,
				ТипыНоменклатуры);
		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСодержаниеСтрокиТовараОтчетаДавальцу(СтрокаКонтракта, ШаблонСодержания, ТипыНоменклатуры)

	Если СтрокаКонтракта.ТипНоменклатуры = ТипыНоменклатуры.Товар Тогда
		
		РеквизитыНоменклатуры = ЗначенияРеквизитовОбъектаЛок(
			СтрокаКонтракта.Номенклатура,
			"НаименованиеПолное, Наименование");
		
		НаименованиеДляШаблона = СокрЛП(РеквизитыНоменклатуры.НаименованиеПолное);
		Если Не ЗначениеЗаполнено(НаименованиеДляШаблона) Тогда
			НаименованиеДляШаблона = СокрЛП(РеквизитыНоменклатуры.Наименование);
		КонецЕсли;
		
		СтрокаКонтракта.НоменклатураПредставление = СтдСтр().СтрШаблонЛок(
			ШаблонСодержания,
			НаименованиеДляШаблона);
		СтрокаКонтракта.ТипНоменклатуры = ТипыНоменклатуры.Услуга;
	
	КонецЕсли;

КонецПроцедуры

Функция ЭтоОтчетДавальцу2_5(Ссылка)

	Результат = Ложь;
	Если ПараметрыСбораУКД().ЕстьОтчетДавальцу2_5 Тогда
		Результат = (ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОтчетДавальцу2_5"));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПредставлениеСтавкиНДССправочника(ЗначениеСтавкиНДС)

	Результат = XMLСтрока(ЗначениеРеквизитаОбъектаЛок(ЗначениеСтавкиНДС, "Ставка"));
	СтавкаБезНДС = ПредопределенноеЗначение("Справочник.СтавкиНДС.БезНДС");
	Если ЗначениеСтавкиНДС = СтавкаБезНДС Тогда
		Результат = "без НДС";
	Иначе
		Если ЗначениеРеквизитаОбъектаЛок(ЗначениеСтавкиНДС, "РасчетнаяСтавка") Тогда
			СтавкаЧисло = ЗначениеРеквизитаОбъектаЛок(ЗначениеСтавкиНДС, "Ставка");
			// BSLLS:MagicNumber-off
			Результат = XMLСтрока(СтавкаЧисло) + "/" + XMLСтрока(СтавкаЧисло + 100);
			// BSLLS:MagicNumber-on
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПредставлениеСтавкиНДСПеречисления(ЗначениеСтавкиНДС)

	Результат = Строка(ЗначениеСтавкиНДС);
	ИмяЗначения = XMLСтрока(ЗначениеСтавкиНДС);
	Если ИмяЗначения = "БезНДС" Тогда
		Результат = "без НДС";
	Иначе
		Если СтдСтр().СтрНачинаетсяСЛок(ИмяЗначения, "НДС") Тогда
			ИндексПослеПрефиксаНДС = 4;
			Хвост = Сред(ИмяЗначения, ИндексПослеПрефиксаНДС);
			ПозицияРазделителя = СтдСтр().СтрНайтиЛок(Хвост, "_");
			Если ПозицияРазделителя = 0 Тогда
				Результат = Хвост;
			Иначе
				Результат = Лев(Хвост, ПозицияРазделителя - 1) + "/" + Сред(Хвост, ПозицияРазделителя + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция МетаданныеЕстьТабличнаяЧасть(ПолноеИмяТабличнойЧасти)
	
	Результат = Ложь;
	Части = СтдСтр().СтрРазделитьЛок(ПолноеИмяТабличнойЧасти, ".");
	
	КоличествоЧастейИмени = 4;
	Если Части.Количество() = КоличествоЧастейИмени
		И Части[2] = "ТабличныеЧасти" Тогда
		
		ИмяТабличнойЧасти = Части[3];
		
		Если Части[0] = "Справочник" Тогда
			МетаданныеОбъекта = Метаданные.Справочники[Части[1]];
		ИначеЕсли Части[0] = "Документ" Тогда
			МетаданныеОбъекта = Метаданные.Документы[Части[1]];
		Иначе
			Возврат Результат;
		КонецЕсли;
		
		Результат = (МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТабличнойЧасти) <> Неопределено);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВыборкаБанковскихРеквизитов(БанковскийСчет)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеСчета.НомерСчета КАК НомерСчета,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкДляРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификаторБанков.ПустаяСсылка)
	|			ТОГДА БанкРасчетов.Наименование
	|		ИНАЧЕ КлассификаторБанков.Наименование
	|	КОНЕЦ, """") КАК Банк,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкДляРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификаторБанков.ПустаяСсылка)
	|			ТОГДА БанкРасчетов.Код
	|		ИНАЧЕ КлассификаторБанков.Код
	|	КОНЕЦ, """") КАК БИК,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкДляРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификаторБанков.ПустаяСсылка)
	|			ТОГДА БанкРасчетов.Адрес
	|		ИНАЧЕ КлассификаторБанков.Адрес
	|	КОНЕЦ, """") КАК АдресБанка,
	|	ЕСТЬNULL(ВЫБОР
	|		КОГДА БанковскиеСчета.БанкДляРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификаторБанков.ПустаяСсылка)
	|			ТОГДА БанкРасчетов.КоррСчет
	|		ИНАЧЕ КлассификаторБанков.КоррСчет
	|	КОНЕЦ, """") КАК КоррСчет,
	|	БанковскиеСчета.СчетЦифровогоРубля КАК ЦифровойСчет
	|ИЗ
	|	Справочник.%1 КАК БанковскиеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторБанков КАК КлассификаторБанков
	|		ПО БанковскиеСчета.Банк = КлассификаторБанков.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторБанков КАК БанкРасчетов
	|		ПО БанковскиеСчета.БанкДляРасчетов = БанкРасчетов.Ссылка
	|ГДЕ
	|	БанковскиеСчета.Ссылка = &БанковскийСчет";
	Если ЭтоРедакцияТорговойПодсистемыНиже_11_5() Тогда
		ВыражениеЛожь = "ЛОЖЬ";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "БанковскиеСчета.СчетЦифровогоРубля", ВыражениеЛожь);
	КонецЕсли;
	Если ТипЗнч(БанковскийСчет) = Тип("СправочникСсылка.БанковскиеСчетаОрганизаций") Тогда
		ИмяСправочника = "БанковскиеСчетаОрганизаций";
	Иначе
		ИмяСправочника = "БанковскиеСчетаКонтрагентов";
	КонецЕсли;
	ТекстЗапроса = СтдСтр().СтрШаблонЛок(ТекстЗапроса, ИмяСправочника);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Возврат Результат;
	
КонецФункции

