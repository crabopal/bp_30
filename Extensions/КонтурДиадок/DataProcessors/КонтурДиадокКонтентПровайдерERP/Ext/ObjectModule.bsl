Функция ПараметрыСбораУКД_11_5()

	ЕстьПодсистемаПодакцизныхТоваров = ЕстьРеквизитТабличнойЧастиКорректировкиРеализации(
		"ВидыЗапасовСписание",
		"СуммаАкциза");

	ЕстьОтчетДавальцу2_5 = Метаданные.Документы.Найти("ОтчетДавальцу2_5") <> Неопределено;
	ЕстьСтавкаНДСВВидахЗапасовОтчетаДавальцу = Ложь;
	Если ЕстьОтчетДавальцу2_5 Тогда
		ЕстьСтавкаНДСВВидахЗапасовОтчетаДавальцу = ЕстьРеквизитТабличнойЧастиДокумента(
			"ОтчетДавальцу2_5",
			"ВидыЗапасов",
			"СтавкаНДС");
	КонецЕсли;
	ИмяТабличнойЧастиАктаВыполненныхРабот =
		"Документ.АктВыполненныхРабот.ТабличныеЧасти.ВидыЗапасов";
	ЕстьВидыЗапасовАктаВыполненныхРабот = МетаданныеЕстьТабличнаяЧасть(
		ИмяТабличнойЧастиАктаВыполненныхРабот);

	ПоляВтВидыЗапасов = ПоляВтВидыЗапасовСбораУКД_11_5(
		ЕстьПодсистемаПодакцизныхТоваров,
		ЕстьСтавкаНДСВВидахЗапасовОтчетаДавальцу);

	Результат = Новый Структура;
	Результат.Вставить("ЕстьОтчетДавальцу2_5", ЕстьОтчетДавальцу2_5);
	Результат.Вставить(
		"ЕстьВидыЗапасовАктаВыполненныхРабот",
		ЕстьВидыЗапасовАктаВыполненныхРабот);
	Результат.Вставить("ЕстьДанныеКорректировокДоВводаОстатков", Истина);
	Результат.Вставить("ЕстьТипыКорректировки", Истина);
	Результат.Вставить("ЕстьНоменклатураПартнера", Истина);
	Результат.Вставить("ЕстьВариантыОтраженияКорректировки", Истина);
	Результат.Вставить("ЕстьИнтеграцияИСМП", Истина);
	Результат.Вставить("ЕстьРеализацияЧерезКомиссионера", Истина);
	// BSLLS:Typo-off
	Результат.Вставить("ЕстьРеквизитПеревыставленный", ЕстьРеквизитСчетаФактурыВыданного("Перевыставленный"));
	// BSLLS:Typo-on
	Результат.Вставить("ЕстьСчетФактураПолученныйОтПродавца",
		ЕстьРеквизитТоваровСчетаФактурыВыданного("СчетФактураПолученныйОтПродавца"));
	Результат.Вставить("ЕстьПодсистемаПрослеживаемости", Истина);
	Результат.Вставить("ЕстьПодсистемаПодакцизныхТоваров", ЕстьПодсистемаПодакцизныхТоваров);
	Результат.Вставить("РасчетыСКлиентамиПоВалютеКонстанты", Ложь);
	Результат.Вставить("ПоляШапки", ПоляШапкиСбораУКД_11_5());
	Результат.Вставить("ПоляВременныхТаблицДокумента", ПоляВременныхТаблицДокументаСбораУКД_11_5());
	Результат.Вставить("ПоляВременнойТаблицыТоваров", ПоляВременнойТаблицыТоваровСбораУКД_11_5());
	Результат.Вставить("ПоляВтВидыЗапасов", ПоляВтВидыЗапасов);
	Результат.Вставить("ПоляТабличнойЧасти", ПоляТабличнойЧастиСбораУКД_11_5());
	Возврат Результат;

КонецФункции

