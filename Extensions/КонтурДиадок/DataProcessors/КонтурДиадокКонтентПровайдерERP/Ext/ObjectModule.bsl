Функция НомерНаПечатьЛокализация(НомерДокумента)
	
	УдалитьПрефиксИнформационнойБазы = Истина;
	УдалитьПользовательскийПрефикс = Ложь;
	
	МодульПрефиксацияОбъектов = ОбщийМодульЛок("ПрефиксацияОбъектовКлиентСервер");
	Результат = МодульПрефиксацияОбъектов.НомерНаПечать(
		НомерДокумента,
		УдалитьПрефиксИнформационнойБазы,
		УдалитьПользовательскийПрефикс);
				
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеНомераСчетаФактурыВыданного(СчетФактура)

	Результат = "";

	РеквизитыСФ = ЗначенияРеквизитовОбъектаЛок(СчетФактура, "Исправление, СчетФактураОснование");
	Если РеквизитыСФ.Исправление Тогда
		Результат = ЗначениеРеквизитаОбъектаЛок(РеквизитыСФ.СчетФактураОснование, "ПредставлениеНомера");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Результат) Тогда
		СчетФактураОбъект = СчетФактура.ПолучитьОбъект();
		Результат = Документы.СчетФактураВыданный.ПолучитьПредставлениеНомера(СчетФактураОбъект);
	КонецЕсли;

	Возврат Результат;

КонецФункции

