	|		И ТаблицаТоваров.ВариантПредставленияНабораВПечатныхФормах В (
	|			&ВариантТолькоКомплектующие, &ВариантНаборИКомплектующие))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВременнаяТаблицаНаборы.Ссылка КАК Ссылка,
	|	ВременнаяТаблицаНаборы.НомерСтроки КАК НомерСтроки,
	|	ВременнаяТаблицаНаборы.НомерСтрокиИсходногоСФ КАК НомерСтрокиИсходногоСФ,
	|	ВременнаяТаблицаНаборы.НоменклатураНабора КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ДанныеНоменклатуры.НаименованиеПолное КАК СТРОКА(1000)), """") = """"
	|			ТОГДА ЕСТЬNULL(ДанныеНоменклатуры.Наименование, """")
	|		ИНАЧЕ ДанныеНоменклатуры.НаименованиеПолное
	|	КОНЕЦ КАК НоменклатураНаименование,
	|	ВЫБОР
	|		КОГДА &КолонкаКодов = ""Артикул""
	|			ТОГДА ЕСТЬNULL(ДанныеНоменклатуры.Артикул, """")
	|		ИНАЧЕ ЕСТЬNULL(ДанныеНоменклатуры.Код, """")
	|	КОНЕЦ КАК НоменклатураКод,
	|	ВременнаяТаблицаНаборы.КодТНВЭД КАК КодТНВЭД,
	|	ВременнаяТаблицаНаборы.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ДанныеНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(Единицы.Представление, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(Единицы.Код, """") КАК ЕдиницаИзмеренияКод,
	|	%Поле_НаборыЕдиницаИзмеренияТНВЭДНаименование КАК ЕдиницаИзмеренияТНВЭДНаименование,
	|	%Поле_НаборыЕдиницаИзмеренияТНВЭДКод КАК ЕдиницаИзмеренияТНВЭДКод,
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
	|	ВременнаяТаблицаНаборы.ХарактеристикаНабора КАК Характеристика,
	|	ЕСТЬNULL(ВременнаяТаблицаНаборы.ХарактеристикаНабора.НаименованиеПолное, """") КАК ХарактеристикаНаименование,
	|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
	|	"""" КАК СерияНаименование,
	|	ВременнаяТаблицаНаборы.НомерГТД КАК НомерГТД,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.НомерГТД.РегистрационныйНомер = """"
	|			ТОГДА ВЫРАЗИТЬ(ВременнаяТаблицаНаборы.НомерГТД.Код КАК СТРОКА(50))
	|		ИНАЧЕ ВременнаяТаблицаНаборы.НомерГТД.РегистрационныйНомер
	|	КОНЕЦ КАК НомерГТДПредставление,
	|	ВременнаяТаблицаНаборы.НомерГТД.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ЕСТЬNULL(Страны.Код, """") КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(Страны.Наименование, """") КАК СтранаПроисхожденияНаименование,
	|	ВременнаяТаблицаНаборы.Количество КАК Количество,
	|	ВременнаяТаблицаНаборы.КоличествоДо КАК КоличествоДо,
	|	ВременнаяТаблицаНаборы.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
	|	ВременнаяТаблицаНаборы.КоличествоПоРНПТДо КАК КоличествоПоРНПТДо,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.КоличествоПоРНПТ >= ВременнаяТаблицаНаборы.КоличествоПоРНПТДо
	|			ТОГДА ВременнаяТаблицаНаборы.КоличествоПоРНПТ - ВременнаяТаблицаНаборы.КоличествоПоРНПТДо
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоПрослежУвеличение,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.КоличествоПоРНПТ < ВременнаяТаблицаНаборы.КоличествоПоРНПТДо
	|			ТОГДА ВременнаяТаблицаНаборы.КоличествоПоРНПТДо - ВременнаяТаблицаНаборы.КоличествоПоРНПТ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоПрослежУменьшение,
	|	ВременнаяТаблицаНаборы.СуммаБезНДС КАК СуммаБезНДС,
	|	ВременнаяТаблицаНаборы.СуммаНДС КАК СуммаНДС,
	|	ВременнаяТаблицаНаборы.СуммаБезНДС + ВременнаяТаблицаНаборы.СуммаНДС КАК СуммаСНДС,
	|	ВременнаяТаблицаНаборы.СуммаБезНДСДо КАК СуммаБезНДСДо,
	|	ВременнаяТаблицаНаборы.СуммаНДСДо КАК СуммаНДСДо,
	|	ВременнаяТаблицаНаборы.СуммаБезНДСДо + ВременнаяТаблицаНаборы.СуммаНДСДо КАК СуммаСНДСДо,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.Количество = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(ВременнаяТаблицаНаборы.СуммаБезНДС / ВременнаяТаблицаНаборы.Количество КАК ЧИСЛО(21, 8))
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.КоличествоДо = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВременнаяТаблицаНаборы.СуммаБезНДСДо / ВременнаяТаблицаНаборы.КоличествоДо
	|	КОНЕЦ КАК ЦенаДо,
	|	ВременнаяТаблицаНаборы.СтавкаНДС КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.СуммаБезНДС >= ВременнаяТаблицаНаборы.СуммаБезНДСДо
	|			ТОГДА ВременнаяТаблицаНаборы.СуммаБезНДС - ВременнаяТаблицаНаборы.СуммаБезНДСДо
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК РазницаБезНДСУвеличение,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.СуммаБезНДС < ВременнаяТаблицаНаборы.СуммаБезНДСДо
	|			ТОГДА ВременнаяТаблицаНаборы.СуммаБезНДСДо - ВременнаяТаблицаНаборы.СуммаБезНДС
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК РазницаБезНДСУменьшение,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.СуммаНДС >= ВременнаяТаблицаНаборы.СуммаНДСДо
	|			ТОГДА ВременнаяТаблицаНаборы.СуммаНДС - ВременнаяТаблицаНаборы.СуммаНДСДо
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК РазницаНДСУвеличение,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.СуммаНДС < ВременнаяТаблицаНаборы.СуммаНДСДо
	|			ТОГДА ВременнаяТаблицаНаборы.СуммаНДСДо - ВременнаяТаблицаНаборы.СуммаНДС
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК РазницаНДСУменьшение,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.СуммаБезНДС + ВременнаяТаблицаНаборы.СуммаНДС >=
	|				ВременнаяТаблицаНаборы.СуммаБезНДСДо + ВременнаяТаблицаНаборы.СуммаНДСДо
	|			ТОГДА ВременнаяТаблицаНаборы.СуммаБезНДС + ВременнаяТаблицаНаборы.СуммаНДС -
	|				(ВременнаяТаблицаНаборы.СуммаБезНДСДо + ВременнаяТаблицаНаборы.СуммаНДСДо)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК РазницаСНДСУвеличение,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.СуммаБезНДС + ВременнаяТаблицаНаборы.СуммаНДС <
	|				ВременнаяТаблицаНаборы.СуммаБезНДСДо + ВременнаяТаблицаНаборы.СуммаНДСДо
	|			ТОГДА -(ВременнаяТаблицаНаборы.СуммаБезНДС + ВременнаяТаблицаНаборы.СуммаНДС -
	|				(ВременнаяТаблицаНаборы.СуммаБезНДСДо + ВременнаяТаблицаНаборы.СуммаНДСДо))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК РазницаСНДСУменьшение,
	|	ВременнаяТаблицаНаборы.СуммаАкцизаДо КАК АкцизДоИзменения,
	|	ВременнаяТаблицаНаборы.СуммаАкциза КАК АкцизПослеИзменения,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.ОблагаетсяАкцизом
	|				И ВременнаяТаблицаНаборы.СуммаАкциза >= ВременнаяТаблицаНаборы.СуммаАкцизаДо
	|			ТОГДА ВременнаяТаблицаНаборы.СуммаАкциза - ВременнаяТаблицаНаборы.СуммаАкцизаДо
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК РазницаАкцизУвеличение,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблицаНаборы.ОблагаетсяАкцизом
	|				И ВременнаяТаблицаНаборы.СуммаАкциза < ВременнаяТаблицаНаборы.СуммаАкцизаДо
	|			ТОГДА ВременнаяТаблицаНаборы.СуммаАкцизаДо - ВременнаяТаблицаНаборы.СуммаАкциза
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК РазницаАкцизУменьшение
	|ИЗ
	|	ВременнаяТаблицаНаборы КАК ВременнаяТаблицаНаборы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ДанныеНоменклатуры
	|		ПО ВременнаяТаблицаНаборы.НоменклатураНабора = ДанныеНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК Единицы
	|		ПО ДанныеНоменклатуры.ЕдиницаИзмерения = Единицы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК Страны
	|		ПО ВременнаяТаблицаНаборы.НомерГТД.СтранаПроисхождения = Страны.Ссылка
	|ГДЕ
	|	ВременнаяТаблицаНаборы.ВариантПредставленияНабораВПечатныхФормах = &ВариантТолькоНабор
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ПодставитьПоляИзПараметровСбораУКД(Результат, ПараметрыСбораУКД().ПоляТабличнойЧасти);
	
	Возврат Результат;
