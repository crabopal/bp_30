// РЕКВИЗИТЫ ШАПКИ

// Устанавливает учетный документ, по которому провайдер собирает контент.
// Параметры:
//  ДокСсылка - ДокументСсылка - ссылка на документ конфигурации.
Процедура УстановитьДокумент(ДокСсылка) Экспорт

	УчетныйДокумент1С = ДокСсылка;
	
КонецПроцедуры

// Возвращает реквизиты шапки УКД по установленному учетному документу.
// Возвращаемое значение:
//  ФиксированнаяСтруктура - контракт реквизитов шапки УКД.
Функция РеквизитыШапкиУКД() Экспорт
	
	ПроверитьУчетныйДокументУстановлен();

	Результат = КонтрактыПровайдеров().НовыйРеквизитыШапкиУКД();
	ТипДокумента = ТипЗнч(УчетныйДокумент1С);

	Если ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда

		ЗаполнитьРеквизитыШапкиПоКорректировкеРеализации(Результат);

	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ЗаполнитьРеквизитыШапкиУКДПоСчетФактураВыданный(Результат);

	Иначе

		ТекстОшибки = СтдСтр().СтрШаблонЛок(
			НСтр("ru='Неподдерживаемый тип документа: %1'"),
			ТипДокумента);
		ВызватьИсключение ТекстОшибки;

	КонецЕсли;

	Возврат ФиксированныеДанныеЛок(Результат);

КонецФункции

// Возвращает ссылки на товарные документы до корректировки текущего УКД.
// Возвращаемое значение:
//  ФиксированныйМассив - ссылки на документы; не Неопределено;
//  пустой массив допустим; без пустых элементов и без счетов-фактур.
Функция ТоварныеДокументыДоКорректировкиУКД() Экспорт

	ПроверитьУчетныйДокументУстановлен();

	Результат = Новый Массив;
	ТипДокумента = ТипЗнч(УчетныйДокумент1С);

	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Результат = ТоварныеДокументыДоКорректировкиПоСчетуФактуреВыданному();
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Результат = ТоварныеДокументыДоКорректировкиПоКорректировкеРеализации();
	Иначе
		ТекстОшибки = СтдСтр().СтрШаблонЛок(
			НСтр("ru='Неподдерживаемый тип документа: %1'"),
			ТипДокумента);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Возврат ФиксированныеДанныеЛок(Результат);

КонецФункции

// Возвращает реквизиты договора контрагента по ссылке на договор.
// Параметры:
//  ДоговорСсылка - СправочникСсылка.ДоговорыКонтрагентов - договор.
// Возвращаемое значение:
//  ФиксированнаяСтруктура - контракт реквизитов договора.
Функция РеквизитыДоговора(ДоговорСсылка) Экспорт

	Реквизиты = КонтрактыПровайдеров().НовыйРеквизитыСвязанногоДокумента();
	Реквизиты.Ссылка = ДоговорСсылка;

	ИсходныеДанные = ЗначенияРеквизитовОбъектаЛок(
		ДоговорСсылка, "Наименование, Номер, Дата, НаименованиеДляПечати");

	Реквизиты.Наименование = ИсходныеДанные.Наименование;
	Если ЗначениеЗаполнено(ИсходныеДанные.НаименованиеДляПечати) Тогда
		Реквизиты.Наименование = ИсходныеДанные.НаименованиеДляПечати;
	КонецЕсли;
	Реквизиты.Номер = ИсходныеДанные.Номер;
	Реквизиты.Дата = ИсходныеДанные.Дата;

	Возврат ФиксированныеДанныеЛок(Реквизиты);

КонецФункции

// Возвращает реквизиты соглашения с клиентом по ссылке.
// Параметры:
//  СоглашениеСсылка - СправочникСсылка.СоглашенияСКлиентами - соглашение.
// Возвращаемое значение:
//  ФиксированнаяСтруктура - контракт реквизитов соглашения.
Функция РеквизитыСоглашения(СоглашениеСсылка) Экспорт

	Реквизиты = КонтрактыПровайдеров().НовыйРеквизитыСвязанногоДокумента();
	Реквизиты.Ссылка = СоглашениеСсылка;

	ИсходныеДанные = ЗначенияРеквизитовОбъектаЛок(СоглашениеСсылка, "Наименование, Номер, Дата");

	Реквизиты.Наименование = ИсходныеДанные.Наименование;
	Реквизиты.Номер = ИсходныеДанные.Номер;
	Реквизиты.Дата = ИсходныеДанные.Дата;

	Возврат ФиксированныеДанныеЛок(Реквизиты);

КонецФункции

// Возвращает признак использования договоров контрагентов в соглашении с клиентом.
// Параметры:
//  СоглашениеСсылка - СправочникСсылка.СоглашенияСКлиентами - соглашение.
// Возвращаемое значение:
//  Булево - Истина, если основанием служит договор контрагента или соглашение не заполнено.
Функция ИспользуютсяДоговорыКонтрагентов(СоглашениеСсылка) Экспорт

	Результат = Истина;
	Если ЗначениеЗаполнено(СоглашениеСсылка) Тогда
		Результат = ЗначениеРеквизитаОбъектаЛок(
			СоглашениеСсылка, "ИспользуютсяДоговорыКонтрагентов");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает код и полное наименование валюты по ссылке на элемент справочника Валюты.
// Параметры:
//  ВалютаСсылка - СправочникСсылка.Валюты - валюта документа.
// Возвращаемое значение:
//  ФиксированнаяСтруктура - контракт реквизитов валюты; Наименование - полное наименование.
Функция РеквизитыВалюты(ВалютаСсылка) Экспорт

	Реквизиты = КонтрактыПровайдеров().НовыйРеквизитыВалюты();
	ИсходныеДанные = ЗначенияРеквизитовОбъектаЛок(ВалютаСсылка, "Код, Наименование, НаименованиеПолное");

	Реквизиты.Код = ИсходныеДанные.Код;
	Реквизиты.Наименование = ИсходныеДанные.НаименованиеПолное;
	Если Не ЗначениеЗаполнено(Реквизиты.Наименование) Тогда
		Реквизиты.Наименование = ИсходныеДанные.Наименование;
	КонецЕсли;

	Возврат ФиксированныеДанныеЛок(Реквизиты);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ТАБЛИЧНЫЕ ДАННЫЕ

// Возвращает строки табличной части УКД по установленному учетному документу.
// Возвращаемое значение:
//  ФиксированныйМассив - строки контракта табличной части УКД.
Функция СтрокиТабличнойЧастиУКД() Экспорт

	ПроверитьУчетныйДокументУстановлен();
	АктуализироватьРасчетыСКонтрагентами();

	Результат = Новый Массив;
	ТипДокумента = ТипЗнч(УчетныйДокумент1С);

	Если ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Результат = ТабличныеДанныеУКДПоКорректировкеРеализации();
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Результат = ТабличныеДанныеУКДПоСчетФактураВыданный();
	Иначе
		ТекстОшибки = СтдСтр().СтрШаблонЛок(
			НСтр("ru='Неподдерживаемый тип документа: %1'"),
			ТипДокумента);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Возврат ФиксированныеДанныеЛок(Результат);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СВЕДЕНИЯ О ЮР ФИЗ ЛИЦАХ

// Возвращает реквизиты участника по ссылке на организацию, контрагента или регистрацию в налоговом органе.
// Параметры:
//  ЮрФизЛицо - СправочникСсылка - участник; пустая ссылка - Неопределено.
//  ДатаСведений - Дата, Неопределено - дата сведений; если не заполнена - текущая дата сеанса.
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - контракт реквизитов участника.
Функция ДанныеЮрФизЛица(ЮрФизЛицо, ДатаСведений = Неопределено) Экспорт

	Результат = Неопределено;
	ДатаФакт = ДатаСведений(ДатаСведений);

	Если ЗначениеЗаполнено(ЮрФизЛицо) Тогда

		Реквизиты = КонтрактыПровайдеров().НовыйРеквизитыУчастника();
		Реквизиты.Ссылка = ЮрФизЛицо;

		Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда
			ЗаполнитьРеквизитыПоОрганизации(Реквизиты, ЮрФизЛицо, ДатаФакт);
		ИначеЕсли ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.РегистрацииВНалоговомОргане") Тогда
			ЗаполнитьРеквизитыПоРегистрацииВНалоговомОргане(Реквизиты, ЮрФизЛицо, ДатаФакт);
		Иначе
			ЗаполнитьРеквизитыПоКонтрагенту(Реквизиты, ЮрФизЛицо, ДатаФакт);
		КонецЕсли;

		Телефон = ТелефонЮрФизЛица(ЮрФизЛицо, ДатаФакт);
		Если ЗначениеЗаполнено(Телефон) Тогда
			Реквизиты.Контакты.Телефоны.Добавить(Телефон);
		КонецЕсли;

		ЭлектроннаяПочта = ЭлектроннаяПочтаЮрФизЛица(ЮрФизЛицо, ДатаФакт);
		Если ЗначениеЗаполнено(ЭлектроннаяПочта) Тогда
			Реквизиты.Контакты.ЭлектроннаяПочта.Добавить(ЭлектроннаяПочта);
		КонецЕсли;

		Результат = ФиксированныеДанныеЛок(Реквизиты);

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает юридический адрес участника в контракте адреса ФНС.
// Параметры:
//  ЮрФизЛицо - СправочникСсылка - организация или контрагент.
//  ДатаСведений - Дата, Неопределено - дата сведений; если не заполнена - текущая дата сеанса.
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - контракт адреса ФНС.
Функция ЮридическийАдресЮрФизЛица(ЮрФизЛицо, ДатаСведений = Неопределено) Экспорт

	Результат = Неопределено;
	ВидКИ = ВидКонтактнойИнформацииЮридическийАдрес(ЮрФизЛицо);
	ДатаФакт = ДатаСведений(ДатаСведений);

	Если ЗначениеЗаполнено(ВидКИ) Тогда
		Результат = АдресЮрФизЛицаПоВидуКонтактнойИнформации(ЮрФизЛицо, ВидКИ, ДатаФакт);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает фактический адрес участника в контракте адреса ФНС.
// Параметры:
//  ЮрФизЛицо - СправочникСсылка - организация или контрагент.
//  ДатаСведений - Дата, Неопределено - дата сведений; если не заполнена - текущая дата сеанса.
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - контракт адреса ФНС.
Функция ФактическийАдресЮрФизЛица(ЮрФизЛицо, ДатаСведений = Неопределено) Экспорт

	Результат = Неопределено;
	ВидКИ = ВидКонтактнойИнформацииФактическийАдрес(ЮрФизЛицо);
	ДатаФакт = ДатаСведений(ДатаСведений);

	Если ЗначениеЗаполнено(ВидКИ) Тогда
		Результат = АдресЮрФизЛицаПоВидуКонтактнойИнформации(ЮрФизЛицо, ВидКИ, ДатаФакт);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает адрес в контракте адреса ФНС из JSON-строки контактной информации.
// Параметры:
//  СтрокаJSON - Строка - JSON адреса; если не заполнена - возвращает Неопределено.
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - контракт адреса ФНС; Неопределено, если строка пустая.
Функция ЗначениеАдресаИзJSON(СтрокаJSON) Экспорт
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(СтрокаJSON) Тогда
		Представление = "";
		АдресИзJSON = КонтентАдреса().ИзJSON(СтрокаJSON, Представление);
		Результат = ФиксированныеДанныеЛок(АдресИзJSON);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает адрес в контракте адреса ФНС из строкового представления.
// Параметры:
//  СтрокаАдреса - Строка - представление адреса; если не заполнена - возвращает Неопределено.
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - контракт адреса ФНС;
//   сейчас всегда Неопределено (разбор представления не поддержан).
Функция ЗначениеАдресаИзПредставления(СтрокаАдреса) Экспорт
	
	Результат = Неопределено;
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОЧИЕ СВЕДЕНИЯ

// Возвращает реквизиты банковского счета по ссылке.
// Параметры:
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - банковский счет.
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - контракт банковского счета.
Функция БанковскиеРеквизиты(БанковскийСчет) Экспорт

	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = ВыборкаБанковскихРеквизитов(БанковскийСчет);
	Если Выборка.Следующий() Тогда

		Реквизиты = КонтрактыПровайдеров().НовыйБанковскийСчет();
		Реквизиты.НомерСчета = Выборка.НомерСчета;
		Реквизиты.КоррСчет = Выборка.КоррСчет;
		Реквизиты.БИК = Выборка.БИК;
		Реквизиты.АдресБанка = Выборка.АдресБанка;

		Если Выборка.ЦифровойСчет Тогда
			Реквизиты.Банк = "";
		Иначе
			Реквизиты.Банк = Выборка.Банк;
		КонецЕсли;

		Результат = ФиксированныеДанныеЛок(Реквизиты);

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает строковое представление ставки НДС для печатной формы / контракта.
// Параметры:
//  ЗначениеСтавкиНДС - СправочникСсылка.СтавкиНДС, ПеречислениеСсылка.СтавкиНДС - ставка;
//   если не заполнена - пустая строка.
// Возвращаемое значение:
//  Строка - представление ставки ("без НДС", "20", "20/120" и т.п.); не Неопределено.
Функция ПредставлениеСтавкиНДС(ЗначениеСтавкиНДС) Экспорт
	
	Результат = "";
	
	Если Не ЗначениеЗаполнено(ЗначениеСтавкиНДС) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ИспользуетсяБЭД19() Тогда
		Результат = ПредставлениеСтавкиНДССправочника(ЗначениеСтавкиНДС);
	Иначе
		Результат = ПредставлениеСтавкиНДСПеречисления(ЗначениеСтавкиНДС);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

