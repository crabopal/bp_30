Функция ШаблонПоВидуДокумента(ВидДокумента)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	ШаблоныДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШаблоныВходящихДокументов КАК ШаблоныДокументов
	|ГДЕ
	|	ШаблоныДокументов.ВидДокумента = &ВидДокумента
	|	И НЕ ШаблоныДокументов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	
	Запрос.Параметры.Вставить("ВидДокумента", ВидДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПодписантИзДанныхПодписи(ДанныеПодписи)
	
	ПолноеИмяПодписанта = Неопределено;
	
	Попытка
		
		МодульЭлектроннаяПодпись = ОбщийМодульПоИмениЛок("ЭлектроннаяПодпись");
		МодульКриптографияБЭДСлужебныйКлиентСервер = ОбщийМодульПоИмениЛок("КриптографияБЭДСлужебныйКлиентСервер");
		
		МенеджерКриптографииЛок = МодульЭлектроннаяПодпись.МенеджерКриптографии("ЧтениеПодписи");
		Сертификаты = МенеджерКриптографииЛок.ПолучитьСертификатыИзПодписи(ДанныеПодписи);
		Сертификат = МодульКриптографияБЭДСлужебныйКлиентСервер.НайтиСертификатПодписавшейСтороныРекурсивно(Сертификаты);
		СвойстваСубъекта = МодульЭлектроннаяПодпись.СвойстваСубъектаСертификата(Сертификат);
		
	Исключение
		
		ШаблонОшибки = НСтр(
			"ru='Не удалось получить данные подписанта из подписи:
			|%1'"
		);
		ТекстОшибки = СтдСтр().СтрШаблонЛок(
			ШаблонОшибки,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		// BSLLS:UsageWriteLogEvent-off
		ЗаписьЖурналаРегистрации("Диадок", УровеньЖурналаРегистрации.Предупреждение, , , ТекстОшибки);
		// BSLLS:UsageWriteLogEvent-on
		
	КонецПопытки;
	
	ПолноеИмяПодписанта = СтдСтр().СтрШаблонЛок(
		"%1 %2 %3",
		СвойстваСубъекта.Имя,
		СвойстваСубъекта.Фамилия,
		СвойстваСубъекта.Отчество
	);
	
	Возврат СокрЛП(ПолноеИмяПодписанта);
	
КонецФункции

Функция КонтактноеЛицо(Подписант, Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	КонтактныеЛица.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтактныеЛица КАК КонтактныеЛица
	|ГДЕ
	|	КонтактныеЛица.Владелец = &Владелец
	|	И КонтактныеЛица.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Запрос.УстановитьПараметр("Наименование", Подписант);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = Справочники.КонтактныеЛица.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НоваяЗаписьДокумент1С(ПараметрыСоздания)
	
	Результат = Справочники.ВходящиеДокументы.СоздатьЭлемент();
	
	Если ЗначениеЗаполнено(ПараметрыСоздания.ШаблонДокумента) Тогда
		МодульШаблоныДокументов = ОбщийМодульПоИмениЛок("ШаблоныДокументов");
		МодульШаблоныДокументов.ЗаполнитьРеквизитыДокументаПоШаблону(ПараметрыСоздания.ШаблонДокумента, Результат);
	КонецЕсли;
	
	Результат.ИсходящийНомер = ПараметрыСоздания.НомерДокумента;
	Результат.ИсходящаяДата = ПараметрыСоздания.ДатаДокумента;
	Результат.ДатаСоздания = ТекущаяДата();
	Результат.Заголовок = ПараметрыСоздания.ИмяФайла;
	Результат.Организация = ПараметрыСоздания.Организация;
	Результат.Отправитель = ПараметрыСоздания.Контрагент;
	Результат.ВидДокумента = ПараметрыСоздания.ВидДокумента;
	Результат.Валюта = ПараметрыСоздания.Валюта;
	Результат.Сумма = ПараметрыСоздания.СуммаДокумента;
	Результат.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Результат.Зарегистрировал = ПараметрыСеанса.ТекущийПользователь;
	Результат.ФормаДокумента = Перечисления.ВариантыФормДокументов.Электронная;
	Результат.Подписал = ПараметрыСоздания.КонтактноеЛицо;
	
	Результат.Записать();
	
	МодульДелопроизводство = ОбщийМодульПоИмениЛок("Делопроизводство");
	МодульДелопроизводство.ЗаписатьСостояниеДокумента(
		Результат.Ссылка,
		ТекущаяДата(),
		Перечисления.СостоянияДокументов.НаРассмотрении,
		Справочники.Пользователи.ПустаяСсылка()
	);
	
	Возврат Результат;
	
КонецФункции

