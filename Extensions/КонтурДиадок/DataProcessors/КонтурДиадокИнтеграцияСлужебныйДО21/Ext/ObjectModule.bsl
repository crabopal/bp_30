#Область ПрограммныйИнтерфейс

// Формирует список документов на отправку
//
// Параметры:
//  ВидПакетаID - Строка - идентификатор вида пакета
//  ВидДокумента1С - СправочникСсылка - Запись справочника видов документов - основание ЭД на отправку
//  ПризнакНаОтправку - ПланВидовХарактеристик - Признак готовновти документа на отправку
//  Запрос - Запрос - Запрос документов на отправку
// 
// Возвращаемое значение:
//  Массив - Имена временных таблиц с данными для отправки
//
Функция ПодготовитьДанныеДляОтправки(ВидПакетаID, ВидДокумента1С, ПризнакНаОтправку, Запрос) Экспорт
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(ВидПакетаID) Тогда
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Справочники.ИсходящиеДокументы) Тогда
			ИмяВТ = ДобавитьТаблицу_ИсходящиеДокументы(Запрос, ВидДокумента1С, ПризнакНаОтправку, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
		Если РазрешеноЧтениеТаблицы(Метаданные.Справочники.ВнутренниеДокументы) Тогда
			ИмяВТ = ДобавитьТаблицу_ВнутренниеДокументы(Запрос, ВидДокумента1С, ПризнакНаОтправку, ВидПакетаID);
			Результат.Добавить(ИмяВТ);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает виды документов из текущей конфигурации для поиска в модуле
// 
// Возвращаемое значение:
//  Массив - Предопределенные виды документов конфигурации для поиска в модуле
//
Функция ВидыПредопределенныхДокументовДляПоискаВМодуле() Экспорт
	
	СправочникиКонфигурации = Метаданные.Справочники;
	
	Результат = Новый Массив;
	Результат.Добавить(СправочникиКонфигурации.ИсходящиеДокументы);
	Результат.Добавить(СправочникиКонфигурации.ВнутренниеДокументы);
	
	Возврат Результат;
	
КонецФункции

// Создает объект учета на основании данных электронного документа
//
// Параметры:
//  Документ - Структура - см. Ядро.Контракт_Документ
//  ИдентификаторОперации - Строка - Идентификатор правила создания объекта учета из входящего ЭД
// 
// Возвращаемое значение:
//  СправочникСсылка - Созданный объект учета
//
Функция НовыйДокумент1С(Документ, ИдентификаторОперации) Экспорт
	
	ПараметрыСоздания = ПараметрыСозданияДокумента(Документ, ИдентификаторОперации);
	Результат = НоваяЗаписьДокумент1С(ПараметрыСоздания);
	
	Возврат Результат;
	
КонецФункции

// Возвращает виды оснований для формирования электронных документов на отправку
// 
// Возвращаемое значение:
//  Массив - Виды оснований ЭД
//
Функция СправочникДокументыНаОтправку() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Тип("СправочникСсылка.ВидыИсходящихДокументов"));
	Результат.Добавить(Тип("СправочникСсылка.ВидыВнутреннихДокументов"));
	
	Возврат Результат;
	
КонецФункции

// Возвращает типы объектов метаданных для создания записей информационной базы на основании данных ЭД
// 
// Возвращаемое значение:
//  Массив - Виды объектов учета для создания из электронных документов
//
Функция СправочникДокументыВходящие() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Тип("СправочникСсылка.ШаблоныВходящихДокументов"));
	
	МодульДелопроизводство = ОбщийМодульПоИмениЛок("Делопроизводство");
	Если МодульДелопроизводство.ИспользоватьВидыВходящихДокументов() Тогда
		Результат.Добавить(Тип("СправочникСсылка.ВидыВходящихДокументов"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает запись справочника ВходящиеДокументы по реквизитам ЭД
//
// Параметры:
//  ПараметрыОтбора - Структура - Параметры отбора документа
//  ВидДокумента1С - СправочникСсылка - Ссылка на шаблон документа, сопоставленный с типом ЭД
// 
// Возвращаемое значение:
//  СправочникСсылка, Неопределено - Результат поиска документа
//
Функция ПолучитьДокументы1С(ПараметрыОтбора, ВидДокумента1С) Экспорт
	
	Результат = Неопределено;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВходящиеДокументы КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.Организация В (&Организация)
	|	И Т.Отправитель В (&Контрагент)
	|	И Т.ИсходящаяДата = &ДатаДокумента
	|	И Т.ИсходящийНомер = &НомерДокумента";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Для Каждого Элемент Из ПараметрыОтбора Цикл
		Запрос.УстановитьПараметр(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает имя объекта метаданных для ручного сопоставления с входящим ЭД
//
// Возвращаемое значение:
//  Строка - Имя объекта метаданных текущей конфигурации
//
Функция ПравилаСопоставленияДокумента() Экспорт
	
	Результат = "ВходящиеДокументы";
	
	Возврат Результат;
	
КонецФункции

// Возвращает объекты ИБ которые могут быть сопоставлены с типами ЭД
// 
// Возвращаемое значение:
//  Массив - Ссылки на объекты метаданных для сопоставления с типами ЭД
//
Функция ВладельцыНастроекВходящегоДО() Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыВходящихДокументов КАК Т
	|ГДЕ
	|	Т.ЭтоГруппа = ЛОЖЬ
	|	И Т.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Справочник.ШаблоныВходящихДокументов КАК Т
	|ГДЕ
	|	Т.ЭтоГруппа = ЛОЖЬ
	|	И Т.ПометкаУдаления = ЛОЖЬ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Результат = РезультатЗапроса.ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ВспомогательныеМетоды

Функция ДобавитьТаблицу_ИсходящиеДокументы(Запрос, ВидДокумента1С, ПризнакНаОтправку, ВидПакетаID)
	
	ИмяВременнойТаблицы = СтдСтр().СтрШаблонЛок("Диадок_ДокументыНаОтправку_Исходящие_%1", ВидПакетаID);
	
	Запрос.Текст = ТекстЗапроса_ИсходящиеДокументы(ИмяВременнойТаблицы, ВидПакетаID);
	
	Запрос.УстановитьПараметр("ВидДокумента1С", ВидДокумента1С);
	Запрос.УстановитьПараметр("ПризнакНаОтправку", ПризнакНаОтправку);
	
	Запрос.Выполнить();
	
	Возврат ИмяВременнойТаблицы;
	
КонецФункции

Функция ДобавитьТаблицу_ВнутренниеДокументы(Запрос, ВидДокумента1С, ПризнакНаОтправку, ВидПакетаID)
	
	ИмяВременнойТаблицы = СтдСтр().СтрШаблонЛок("Диадок_ДокументыНаОтправку_Внутренние_%1", ВидПакетаID);
	
	Запрос.Текст = ТекстЗапроса_ВнутренниеДокументы(ИмяВременнойТаблицы, ВидПакетаID);
	
	Запрос.УстановитьПараметр("ВидДокумента1С", ВидДокумента1С);
	Запрос.УстановитьПараметр("ПризнакНаОтправку", ПризнакНаОтправку);
	
	Запрос.Выполнить();
	
	Возврат ИмяВременнойТаблицы;
	
КонецФункции

Функция ТекстЗапроса_ИсходящиеДокументы(ИмяВременнойТаблицы, ВидПакетаID)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Т.Ссылка КАК Документ,
	|	Т.РегистрационныйНомер КАК НомерДокумента,
	|	Т.ДатаСоздания КАК ДатаДокумента,
	|	Получатели1С.Получатель КАК Контрагент,
	|	Т.Организация КАК Организация,
	|	Т.Сумма КАК СуммаДокумента,
	|	&ВидПакетаID КАК ВидПакетаID
	|ПОМЕСТИТЬ ИмяВременнойТаблицы
	|ИЗ
	|	Справочник.ИсходящиеДокументы КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НастройкиОрганизаций КАК ВТ_Настройки
	|		ПО Т.Организация = ВТ_Настройки.Организация1С
	|			И (ВТ_Настройки.ВидПакетаID = &ВидПакетаID)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Отправители КАК ВТ_Отправители
	|		ПО Т.Организация = ВТ_Отправители.Организация1С
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИсходящиеДокументы.Получатели КАК Получатели1С
	|		ПО Т.Ссылка = Получатели1С.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПартнерскиеОтношения КАК ВТ_Получатели
	|		ПО Получатели1С.Получатель = ВТ_Получатели.Контрагент1С
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИсходящиеДокументы.ДополнительныеРеквизиты КАК ДопРеквизиты
	|		ПО Т.Ссылка = ДопРеквизиты.Ссылка
	|ГДЕ
	|	Т.ДатаСоздания МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ ВТ_Отправители.Организация1С ЕСТЬ NULL
	|	И НЕ ВТ_Получатели.Контрагент1С ЕСТЬ NULL
	|	И Т.ВидДокумента = &ВидДокумента1С
	|	И ДопРеквизиты.Свойство = &ПризнакНаОтправку
	|	И ДопРеквизиты.Значение = Истина";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПакетаID", """" + ВидПакетаID + """");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ВнутренниеДокументы(ИмяВременнойТаблицы, ВидПакетаID)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Т.Ссылка КАК Документ,
	|	Т.РегистрационныйНомер КАК НомерДокумента,
	|	Т.ДатаСоздания КАК ДатаДокумента,
	|	Т.Контрагент КАК Контрагент,
	|	Т.Организация КАК Организация,
	|	Т.Сумма КАК СуммаДокумента,
	|	&ВидПакетаID КАК ВидПакетаID
	|ПОМЕСТИТЬ ИмяВременнойТаблицы
	|ИЗ
	|	Справочник.ВнутренниеДокументы КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НастройкиОрганизаций КАК ВТ_Настройки
	|		ПО Т.Организация = ВТ_Настройки.Организация1С
	|			И (ВТ_Настройки.ВидПакетаID = &ВидПакетаID)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Отправители КАК ВТ_Отправители
	|		ПО Т.Организация = ВТ_Отправители.Организация1С
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПартнерскиеОтношения КАК ВТ_Получатели
	|		ПО Т.Контрагент = ВТ_Получатели.Контрагент1С
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВнутренниеДокументы.ДополнительныеРеквизиты КАК ДопРеквизиты
	|		ПО Т.Ссылка = ДопРеквизиты.Ссылка
	|ГДЕ
	|	Т.ДатаСоздания МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ ВТ_Отправители.Организация1С ЕСТЬ NULL
	|	И НЕ ВТ_Получатели.Контрагент1С ЕСТЬ NULL
	|	И Т.ВидДокумента = &ВидДокумента1С
	|	И ДопРеквизиты.Свойство = &ПризнакНаОтправку
	|	И ДопРеквизиты.Значение = Истина";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидПакетаID", """" + ВидПакетаID + """");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция РазрешеноЧтениеТаблицы(ОбъектМетаданных)
	
	Результат = ПравоДоступа("Чтение", ОбъектМетаданных);
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыСозданияДокумента(ДанныеДокумента, ИдентификаторОперации)
	
	Результат = НовыеПараметрыСозданияДокумента();
	Результат.СуммаДокумента = ДанныеДокумента.Реквизиты.Сумма;
	Результат.СуммаНДС = ДанныеДокумента.Реквизиты.СуммаНДС;
	Результат.ИмяФайла = ДанныеДокумента.ИмяФайла;
	Результат.НомерДокумента = ДанныеДокумента.Реквизиты.Номер;
	Результат.ДатаДокумента = ДанныеДокумента.Реквизиты.Дата;
	
	ПараметрыПравилаСоздания = СтдСтр().РазложитьСтрокуВМассивПодстрокЛок(ИдентификаторОперации, "#");
	КоличествоЧастейИдентификатора = 2;
	Если ПараметрыПравилаСоздания.Количество() <> КоличествоЧастейИдентификатора Тогда
		ШаблонОшибки = НСтр("ru='Неожиданное значение правила создания: %1'");
		ВызватьИсключение СтдСтр().СтрШаблонЛок(ШаблонОшибки, ИдентификаторОперации);
	КонецЕсли;
	
	ТипЗначения = ПараметрыПравилаСоздания[0];
	ИдентификаторТипа = ПараметрыПравилаСоздания[1];
	
	Если ТипЗначения = Строка(Тип("СправочникСсылка.ШаблоныВходящихДокументов")) Тогда
		
		Результат.ШаблонДокумента = ШаблоныВходящихДокументовСсылкаПоИдентификатору(ИдентификаторТипа);
		Результат.ВидДокумента = Результат.ШаблонДокумента.ВидДокумента;
		
	ИначеЕсли ТипЗначения = Строка(Тип("СправочникСсылка.ВидыВходящихДокументов")) Тогда
		
		Результат.ВидДокумента = ВидыВходящихДокументовСсылкаПоИдентификатору(ИдентификаторТипа);
		Результат.ШаблонДокумента = ШаблонПоВидуДокумента(Результат.ВидДокумента);
		
	Иначе
		
		ШаблонОшибки = НСтр("ru='Неожиданный тип значения для создания: %1'");
		ВызватьИсключение СтдСтр().СтрШаблонЛок(ШаблонОшибки, ТипЗначения);
		
	КонецЕсли;
	
	Отправитель = ДанныеДокумента.Отправитель.Организация;
	Получатель = ДанныеДокумента.Получатель.Организация;
	
	МодульДелопроизводство = ОбщийМодульПоИмениЛок("Делопроизводство");
	
	Результат.Валюта = Справочники.Валюты.НайтиПоКоду(ДанныеДокумента.Реквизиты.КодВалюты);
	Если НЕ ЗначениеЗаполнено(Результат.Валюта) Тогда
		Результат.Валюта = МодульДелопроизводство.ПолучитьВалютуПоУмолчанию();
	КонецЕсли;
	
	Результат.Организация = Получатель;
	Результат.Контрагент = Отправитель;
	
	КонтактноеЛицо = Неопределено;
	Подпись = Неопределено;
	ХранилищеКонтента = Неопределено;
	
	ЕстьДанныеДокументооборота = (
		ЗначениеЗаполнено(ДанныеДокумента.Документооборот)
		И ДанныеДокумента.Документооборот.Свойство("ХранилищеКонтента", ХранилищеКонтента)
		И ДанныеДокумента.Документооборот.ХранилищеКонтента.Свойство("Подпись", Подпись)
		И ЗначениеЗаполнено(Отправитель)
	);
	
	Если ЕстьДанныеДокументооборота Тогда
		
		ХранилищеКонтента = ДанныеДокумента.Документооборот.ХранилищеКонтента;
		ПолноеИмяПодписанта = ПодписантИзДанныхПодписи(ХранилищеКонтента.Подпись.ДанныеПодписи);
		КонтактноеЛицо = КонтактноеЛицо(ПолноеИмяПодписанта, Отправитель);
		
	КонецЕсли;
	
	Результат.КонтактноеЛицо = КонтактноеЛицо;
	
	Возврат Результат;
	
КонецФункции

