// BSLLS:CodeOutOfRegion-off
&НаСервере
Перем _ОбработкаОбъект; // Кэш объекта обработки

// BSLLS:MissingVariablesDescription-off
// BSLLS:UnusedLocalVariable-off
// BSLLS:Typo-off
&НаКлиенте
Перем СтдЛок, СтдДиалогиЛок, ЗакрыватьФормуБезПодтверждения;
// BSLLS:Typo-on
// BSLLS:UnusedLocalVariable-on
// BSLLS:MissingVariablesDescription-on

&НаСервере
Функция ОбработкаОбъект()
	
	Если _ОбработкаОбъект = Неопределено Тогда
		_ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат _ОбработкаОбъект;
	
КонецФункции
// BSLLS:CodeOutOfRegion-on

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ВладельцыФайлов") Тогда
		ВладельцыФайлов = Параметры.ВладельцыФайлов;
	Иначе
		ВладельцыФайлов = Новый Массив;
	КонецЕсли;
	Параметры.Свойство(
		"ИмяПроцедурыДобавленияМетрики",
		ИмяПроцедурыДобавленияМетрики);
	
	ЗаполнитьДеревоФайлов(ВладельцыФайлов);
	
КонецПроцедуры

// Параметры:
//  Отказ - Булево - Признак отмены закрытия.
//  ЗавершениеРаботы - Булево - Признак закрытия при завершении работы приложения.
//  ТекстПредупреждения - Строка - Текст предупреждения при завершении работы.
//  СтандартнаяОбработка - Булево - Признак выполнения стандартной обработки.
// BSLLS:UnusedParameters-off
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗакрыватьФормуБезПодтверждения = Истина
		ИЛИ ЗавершениеРаботы
		ИЛИ КорзинаФайлов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	Оповещение = СтдОбщегоНазначения().ОписаниеОповещения(
			"ПослеВопросаОЗакрытииСВыбраннымиФайлами",
			ЭтотОбъект);
	СтдДиалоги().ПоказатьВопросЛок(
		Оповещение,
		"В списке выбранных файлов есть файлы. Закрыть форму без добавления файлов?",
		КнопкиВопросаЗакрытия("Закрыть без добавления"), ,
		КодВозвратаДиалога.ОК,
		"Закрытие формы");
	
	// BSLLS:UnusedParameters-on
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоФайлов(ВладельцыФайлов)
	
	ФайлыИнформационнойБазы.ПолучитьЭлементы().Очистить();
	
	Для Каждого ВладелецФайлов Из ВладельцыФайлов Цикл
		ДобавитьВладельцаФайловВДерево(ВладелецФайлов);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВладельцаФайловВДерево(Знач ВладелецФайлов)
	
	Если НЕ ЗначениеЗаполнено(ВладелецФайлов)
		ИЛИ ВладелецФайловУжеДобавлен(ВладелецФайлов) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаВладельца = ФайлыИнформационнойБазы.ПолучитьЭлементы().Добавить();
	СтрокаВладельца.Пометка = Ложь;
	СтрокаВладельца.Представление = Строка(ВладелецФайлов);
	СтрокаВладельца.ВидСтроки = ВидСтрокиВладелец();
	СтрокаВладельца.Владелец = ВладелецФайлов;
	СтрокаВладельца.Источник = ВладелецФайлов;
	СтрокаВладельца.Картинка = КартинкаСтрокиФайловИнформационнойБазы(ВидСтрокиВладелец());
	
	ДобавитьСтрокиПечатныхФорм(СтрокаВладельца, ВладелецФайлов);
	ДобавитьСтрокиПрисоединенныхФайлов(СтрокаВладельца, ВладелецФайлов);
	
КонецПроцедуры

&НаСервере
Функция ВладелецФайловУжеДобавлен(ВладелецФайлов)
	
	Для Каждого СтрокаВладельца Из ФайлыИнформационнойБазы.ПолучитьЭлементы() Цикл
		Если СтрокаВладельца.Владелец = ВладелецФайлов Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция КартинкаСтрокиФайловИнформационнойБазы(Знач ВидСтроки)
	
	Если ВидСтроки = ВидСтрокиПечатнаяФорма() Тогда
		Возврат БиблиотекаКартинок.Печать;
	ИначеЕсли ВидСтроки = ВидСтрокиВладелец()
		ИЛИ ВидСтроки = ВидСтрокиПрисоединенныйФайл() Тогда
		Возврат БиблиотекаКартинок.Документ;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ДобавитьСтрокиПрисоединенныхФайлов(СтрокаВладельца, ВладелецФайлов)
	
	ДоступныеФайлы = ОбработкаОбъект().ДоступныеФайлыДляВыбора(ВладелецФайлов, УникальныйИдентификатор);
	ДобавитьСтрокиДоступныхФайлов(
		СтрокаВладельца,
		ДоступныеФайлы,
		НСтр("ru = 'Файлы (%1)'"),
		КартинкаСтрокиФайловИнформационнойБазы(ВидСтрокиПрисоединенныйФайл()));
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокиПечатныхФорм(СтрокаВладельца, ВладелецФайлов)
	
	ДоступныеПечатныеФормы = ОбработкаОбъект().ДоступныеПечатныеФормыДляВыбора(ВладелецФайлов);
	ДобавитьСтрокиДоступныхФайлов(
		СтрокаВладельца,
		ДоступныеПечатныеФормы,
		НСтр("ru = 'Печатные формы (%1)'"),
		КартинкаСтрокиФайловИнформационнойБазы(ВидСтрокиПечатнаяФорма()));
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокиДоступныхФайлов(СтрокаВладельца, ДоступныеФайлы, ЗаголовокГруппы, Картинка)
	
	ПредставлениеГруппы = СтрЗаменить(
			ЗаголовокГруппы,
			"%1",
			Строка(ДоступныеФайлы.Количество()));
	СтрокаГруппа = ДобавитьСтрокуФайловИнформационнойБазы(
			СтрокаВладельца,
			ПредставлениеГруппы,
			ВидСтрокиГруппа(),
			СтрокаВладельца.Владелец,
			Неопределено,
			Картинка);
	
	Для Каждого ОписаниеФайла Из ДоступныеФайлы Цикл
		СтрокаФайла = ДобавитьСтрокуФайловИнформационнойБазы(
				СтрокаГруппа,
				ОписаниеФайла.Представление,
				ОписаниеФайла.ВидСтроки,
				ОписаниеФайла.Владелец,
				ОписаниеФайла.Источник,
				Картинка);
		СтрокаФайла.ИмяФайла = ОписаниеФайла.ИмяФайла;
		СтрокаФайла.Размер = ОписаниеФайла.Размер;
		СтрокаФайла.ИдентификаторКомандыПечати = ОписаниеФайла.ИдентификаторКомандыПечати;
		СтрокаФайла.МенеджерПечати = ОписаниеФайла.МенеджерПечати;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьСтрокуФайловИнформационнойБазы(
		СтрокаРодитель,
		Представление,
		ВидСтроки,
		Владелец,
		Источник = Неопределено,
		Картинка = Неопределено)
	
	НоваяСтрока = СтрокаРодитель.ПолучитьЭлементы().Добавить();
	НоваяСтрока.Пометка = Ложь;
	НоваяСтрока.Представление = Представление;
	НоваяСтрока.ВидСтроки = ВидСтроки;
	НоваяСтрока.Владелец = Владелец;
	НоваяСтрока.Источник = Источник;
	НоваяСтрока.Картинка = Картинка;
	
	Возврат НоваяСтрока;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидСтрокиВладелец()
	Возврат "Владелец";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидСтрокиГруппа()
	Возврат "Группа";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидСтрокиПрисоединенныйФайл()
	Возврат "ПрисоединенныйФайл";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидСтрокиПечатнаяФорма()
	Возврат "ПечатнаяФорма";
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ДобавитьВладельцаФайловВДерево(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВПакет(Команда)
	
	Метрики_ДобавлениеФайловИз1С_ЗаписатьДействиеНаФорме("ЗавершитьВыборФайлов");
	
	Если КорзинаФайлов.Количество() = 0 Тогда
		Оповещение = СтдОбщегоНазначения().ОписаниеОповещения(
				"ПослеВопросаОЗавершенииСПустойКорзиной",
				ЭтотОбъект);
		СтдДиалоги().ПоказатьВопросЛок(
			Оповещение,
			"Файлы не выбраны. Закрыть форму без добавления файлов?",
			КнопкиВопросаЗакрытия("Закрыть"), ,
			КодВозвратаДиалога.Отмена,
			"Завершение выбора файлов");
		Возврат;
	КонецЕсли;
	
	// BSLLS:UnusedLocalVariable-off
	ЗакрыватьФормуБезПодтверждения = Истина;
	// BSLLS:UnusedLocalVariable-on
	Закрыть(РезультатКорзиныФайлов());
	
КонецПроцедуры

// Параметры:
//  Команда - КомандаФормы - Выполняемая команда.
// BSLLS:UnusedParameters-off
&НаКлиенте
Процедура Отменить(Команда)
	
	Метрики_ДобавлениеФайловИз1С_ЗаписатьДействиеНаФорме("Отменить");
	Закрыть(РезультатКорзиныФайлов(Ложь));
	
	// BSLLS:UnusedParameters-on
КонецПроцедуры

// Параметры:
//  Результат - КодВозвратаДиалога - Выбранная пользователем команда.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры оповещения.
// BSLLS:UnusedParameters-off
&НаКлиенте
Процедура ПослеВопросаОЗавершенииСПустойКорзиной(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		// BSLLS:UnusedLocalVariable-off
		ЗакрыватьФормуБезПодтверждения = Истина;
		// BSLLS:UnusedLocalVariable-on
		Закрыть(РезультатКорзиныФайлов());
	КонецЕсли;
	
	// BSLLS:UnusedParameters-on
КонецПроцедуры

// Параметры:
//  Результат - КодВозвратаДиалога - Выбранная пользователем команда.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры оповещения.
// BSLLS:UnusedParameters-off
&НаКлиенте
Процедура ПослеВопросаОЗакрытииСВыбраннымиФайлами(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		// BSLLS:UnusedLocalVariable-off
		ЗакрыватьФормуБезПодтверждения = Истина;
		// BSLLS:UnusedLocalVariable-on
		Закрыть(РезультатКорзиныФайлов(Ложь));
	КонецЕсли;
	
	// BSLLS:UnusedParameters-on
КонецПроцедуры

&НаКлиенте
Функция КнопкиВопросаЗакрытия(ПредставлениеКнопкиЗакрытия)
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.ОК, ПредставлениеКнопкиЗакрытия);
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Вернуться к выбору");
	
	Возврат Кнопки;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьВладельцаФайлов(Команда)
	
	Метрики_ДобавлениеФайловИз1С_ЗаписатьДействиеНаФорме("ДобавитьИсточникФайлов");
	
	// BSLLS:UsingThisForm-off
	ОповещениеОВыборе = СтдОбщегоНазначения().ОписаниеОповещения(
			"ЗавершитьВыборОбъектаИнформационнойБазы",
			ЭтотОбъект);
	ИмяФормыКлиентскогоМодуля = "DataProcessor.КонтурДиадокФайлыИнформационнойБазы.Форма.Клиент";
	Если ЭтоВнешняяОбработкаЛок() Тогда
		ИмяФормыКлиентскогоМодуля = "External" + ИмяФормыКлиентскогоМодуля;
	КонецЕсли;
	// BSLLS:GetFormMethod-off
	КлиентскийМодуль = ПолучитьФорму(ИмяФормыКлиентскогоМодуля, , ЭтотОбъект);
	// BSLLS:GetFormMethod-on
	КлиентскийМодуль.НачатьВыборОбъектаИнформационнойБазы(
		ОповещениеОВыборе,
		ЭтотОбъект,
		Метрики_ОписаниеОповещения());
	// BSLLS:UsingThisForm-on
	
КонецПроцедуры

// BSLLS:CommandModuleExportMethods-off
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранный объект информационной базы.
//  ДополнительныеПараметры - Структура, Неопределено - Дополнительные параметры оповещения.
&НаКлиенте
Процедура ЗавершитьВыборОбъектаИнформационнойБазы(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ДобавитьВладельцаФайловВДерево(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры
// BSLLS:CommandModuleExportMethods-on

&НаКлиенте
Процедура Метрики_ДобавлениеФайловИз1С_ЗаписатьДействиеНаФорме(ДействиеНаФорме)
	
	Метрики_ДобавитьПоведение(
		"ДействияНаФормеВыбораФайлов",
		ДействиеНаФорме,
		Метрики_ДобавлениеФайловИз1С_НаименованиеФормы());
	
КонецПроцедуры

&НаКлиенте
Функция Метрики_ДобавлениеФайловИз1С_НаименованиеФормы()
	Возврат "ВыборФайлов";
КонецФункции

&НаКлиенте
Процедура ФайлыИнформационнойБазыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДобавитьТекущуюСтрокуФайловИнформационнойБазыВКорзину();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьФайл(Команда)
	
	ДобавитьТекущуюСтрокуФайловИнформационнойБазыВКорзину();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТекущуюСтрокуФайловИнформационнойБазыВКорзину()
	
	ТекущиеДанные = Элементы.ФайлыИнформационнойБазы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено
		ИЛИ НЕ ЭтоСтрокаФайлаДляДобавления(ТекущиеДанные) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьФайлВКорзину(ОписаниеВыбраннойСтроки(ТекущиеДанные));
	Метрики_ДобавлениеФайловИз1С_ЗаписатьДействиеНаФорме("Выбрать");
	
КонецПроцедуры

&НаКлиенте
Функция ОписаниеВыбраннойСтроки(СтрокаФайла)
	
	Результат = Новый Структура;
	Результат.Вставить("ВидСтроки", СтрокаФайла.ВидСтроки);
	Результат.Вставить("Источник", СтрокаФайла.Источник);
	Результат.Вставить("Владелец", СтрокаФайла.Владелец);
	Результат.Вставить("ИмяФайла", СтрокаФайла.ИмяФайла);
	Результат.Вставить("Представление", СтрокаФайла.Представление);
	Результат.Вставить("ИдентификаторКомандыПечати", СтрокаФайла.ИдентификаторКомандыПечати);
	Результат.Вставить("МенеджерПечати", СтрокаФайла.МенеджерПечати);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЭтоСтрокаФайлаДляДобавления(СтрокаФайла)
	
	Возврат СтрокаФайла.ВидСтроки = ВидСтрокиПрисоединенныйФайл()
		ИЛИ СтрокаФайла.ВидСтроки = ВидСтрокиПечатнаяФорма();
	
КонецФункции

&НаКлиенте
Процедура ДобавитьФайлВКорзину(ОписаниеФайла)
	
	РезультатПолученияФайлов = ДанныеФайлаДляКорзиныВызовСервера(ОписаниеФайла);
	
	Если ЗначениеЗаполнено(РезультатПолученияФайлов.ТекстПредупреждения) Тогда
		ПоказатьПредупреждениеЛок(Неопределено, РезультатПолученияФайлов.ТекстПредупреждения, 0, "");
	КонецЕсли;
	
	Для Каждого ДанныеФайла Из РезультатПолученияФайлов.ДанныеФайлов Цикл
		Если КорзинаСодержитФайл(ДанныеФайла) Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьСтрокуКорзины(ДанныеФайла, ОписаниеФайла);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ДанныеФайлаДляКорзиныВызовСервера(Знач ОписаниеФайла)
	
	ВыбранныеФайлы = Новый Массив;
	ВыбранныеФайлы.Добавить(ОписаниеФайла);
	
	ПараметрыПолученияФайлов = Новый Структура("ИдентификаторФормы", УникальныйИдентификатор);
	Возврат ОбработкаОбъект().ДанныеФайловДляДобавленияВПакет(
		ВыбранныеФайлы,
		ПараметрыПолученияФайлов,
		УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Функция КорзинаСодержитФайл(ДанныеФайла)
	
	Для Каждого СтрокаКорзины Из КорзинаФайлов Цикл
		Если СтрокаКорзины.ИмяФайла = ДанныеФайла.ИмяФайла
			И СтрокаКорзины.ИмяОбъектаИнформационнойБазы = ДанныеФайла.ИмяОбъектаИнформационнойБазы
			И СтрокаКорзины.ИмяВыбранногоФайлаИнформационнойБазы
			= ДанныеФайла.ИмяВыбранногоФайлаИнформационнойБазы Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьСтрокуКорзины(ДанныеФайла, ОписаниеФайла)
	
	СтрокаКорзины = КорзинаФайлов.Добавить();
	СтрокаКорзины.Представление = ДанныеФайла.ИмяФайла;
	СтрокаКорзины.ВидСтроки = ОписаниеФайла.ВидСтроки;
	СтрокаКорзины.Картинка = КартинкаСтрокиФайловИнформационнойБазы(ОписаниеФайла.ВидСтроки);
	СтрокаКорзины.ДвоичныеДанныеФайла = ДанныеФайла.ДвоичныеДанныеФайла;
	СтрокаКорзины.ИмяФайла = ДанныеФайла.ИмяФайла;
	СтрокаКорзины.РазмерФайла = ДанныеФайла.РазмерФайла;
	СтрокаКорзины.Владелец = ДанныеФайла.Владелец;
	СтрокаКорзины.ИмяОбъектаИнформационнойБазы = ДанныеФайла.ИмяОбъектаИнформационнойБазы;
	СтрокаКорзины.ИмяВыбранногоФайлаИнформационнойБазы = ДанныеФайла.ИмяВыбранногоФайлаИнформационнойБазы;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзКорзины(Команда)
	
	ТекущиеДанные = Элементы.КорзинаФайлов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		КорзинаФайлов.Удалить(ТекущиеДанные);
		Метрики_ДобавлениеФайловИз1С_ЗаписатьДействиеНаФорме("Удалить");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция РезультатКорзиныФайлов(ДобавлятьФайлы = Истина)
	
	ДанныеФайлов = Новый Массив;
	
	Если ДобавлятьФайлы Тогда
		Для Каждого СтрокаКорзины Из КорзинаФайлов Цикл
			ДанныеФайла = Новый Структура;
			ДанныеФайла.Вставить("ДвоичныеДанныеФайла", СтрокаКорзины.ДвоичныеДанныеФайла);
			ДанныеФайла.Вставить("ИмяФайла", СтрокаКорзины.ИмяФайла);
			ДанныеФайла.Вставить("РазмерФайла", СтрокаКорзины.РазмерФайла);
			ДанныеФайла.Вставить("Владелец", СтрокаКорзины.Владелец);
			ДанныеФайла.Вставить("ИмяОбъектаИнформационнойБазы", СтрокаКорзины.ИмяОбъектаИнформационнойБазы);
			ДанныеФайла.Вставить(
				"ИмяВыбранногоФайлаИнформационнойБазы",
				СтрокаКорзины.ИмяВыбранногоФайлаИнформационнойБазы);
			ДанныеФайлов.Добавить(ДанныеФайла);
		КонецЦикла;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеФайлов", ДанныеФайлов);
	Результат.Вставить("ТекстПредупреждения", "");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура Метрики_ДобавитьПоведение(Действие, Метка, НаименованиеФормы, ДополнительныеПеременные = Неопределено)
	
	Метрика = Новый Структура;
	Метрика.Вставить("ТипМетрики", "Поведение");
	Метрика.Вставить("Категория", "ДобавлениеФайловИз1С");
	Метрика.Вставить("Действие", Действие);
	Метрика.Вставить("Метка", Метка);
	Метрика.Вставить("НаименованиеФормы", НаименованиеФормы);
	Метрика.Вставить("ДополнительныеПеременные", ДополнительныеПеременные);
	ОписаниеОповещенияДобавленияМетрики = Метрики_ОписаниеОповещения();
	Если ОписаниеОповещенияДобавленияМетрики = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтдОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(
		ОписаниеОповещенияДобавленияМетрики,
		Метрика);
	
КонецПроцедуры

&НаКлиенте
Функция Метрики_ОписаниеОповещения()
	
	Если ВладелецФормы = Неопределено
		ИЛИ ПустаяСтрока(ИмяПроцедурыДобавленияМетрики) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтдОбщегоНазначения().ОписаниеОповещения(
		ИмяПроцедурыДобавленияМетрики,
		ВладелецФормы);
	
КонецФункции

&НаКлиенте
Процедура ПоказатьВыборЭлемента(
		Список,
		ОписаниеОповещенияОЗавершении = Неопределено,
		ЗаголовокОкнаВыбора = "",
		Элемент = Неопределено)
	
	СтдДиалоги().ПоказатьВыборЭлементаСпискаЗначений(
		Список,
		ОписаниеОповещенияОЗавершении,
		ЗаголовокОкнаВыбора,
		Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредупреждениеЛок(
		ОписаниеОповещения,
		Текст,
		Таймаут,
		Заголовок)
	
	СтдДиалоги().ПоказатьПредупреждениеЛок(ОписаниеОповещения, Текст, Таймаут, Заголовок);
	
КонецПроцедуры

&НаКлиенте
Функция СтдОбщегоНазначения()
	Возврат Стд().ОбщегоНазначения();
КонецФункции

&НаКлиенте
Функция Стд()
	
	Если СтдЛок = Неопределено Тогда
		ИмяФормыСтд = "DataProcessor.КонтурДиадокСтд.Форма.Клиент";
		Если ЭтоВнешняяОбработкаЛок() Тогда
			ИмяФормыСтд = "External" + ИмяФормыСтд;
		КонецЕсли;
		// BSLLS:GetFormMethod-off
		// BSLLS:UsingThisForm-off
		СтдЛок = ПолучитьФорму(ИмяФормыСтд, , ЭтаФорма);
		// BSLLS:UsingThisForm-on
		// BSLLS:GetFormMethod-on
	КонецЕсли;
	
	Возврат СтдЛок;
	
КонецФункции

&НаКлиенте
Функция СтдДиалоги()	
	Возврат Стд().Диалоги();
КонецФункции

&НаСервере
Функция ЭтоВнешняяОбработкаЛок()
	Возврат ОбработкаОбъект().ЭтоВнешняяОбработка();
КонецФункции
