&НаКлиенте
Функция Стд()
	
	Если СтдЛок = Неопределено Тогда
		ИмяФормыСтд = "DataProcessor.КонтурДиадокСтд.Форма.Клиент";
		Если ЭтоВнешняяОбработка() Тогда
			ИмяФормыСтд = "External" + ИмяФормыСтд;
		КонецЕсли;
		// BSLLS:GetFormMethod-off
		// BSLLS:UsingThisForm-off
		СтдЛок = ПолучитьФорму(ИмяФормыСтд, , ЭтаФорма);
		// BSLLS:UsingThisForm-on
		// BSLLS:GetFormMethod-on
	КонецЕсли;
	
	Возврат СтдЛок;
	
КонецФункции

&НаКлиенте
Функция СтдДиалоги()	
	Возврат Стд().Диалоги();
КонецФункции

&НаКлиенте
Функция ИмяФормыБиблиотеки(ИмяФормы)
	Префикс = ?(ЭтоВнешняяОбработка(), "ExternalDataProcessor", "DataProcessor");
	Возврат Префикс + ".КонтурДиадокФайлыИнформационнойБазы.Форма." + ИмяФормы;
КонецФункции

&НаСервере
Функция ЭтоВнешняяОбработка()
	Возврат ОбработкаОбъект().ЭтоВнешняяОбработка();
КонецФункции
