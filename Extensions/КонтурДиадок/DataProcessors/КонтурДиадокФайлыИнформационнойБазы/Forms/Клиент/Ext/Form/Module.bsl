// BSLLS:CodeOutOfRegion-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:UnusedLocalVariable-off
&НаКлиенте
Перем СтдЛок, СтдДиалогиЛок; // Кэш клиентских библиотек.
// BSLLS:UnusedLocalVariable-on
// BSLLS:MissingVariablesDescription-on

&НаСервере
Перем ОбъектОбработкиЛок; // Кэш объекта обработки.

&НаСервере
Функция ОбработкаОбъект()
	
	Если ОбъектОбработкиЛок = Неопределено Тогда
		ОбъектОбработкиЛок = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат ОбъектОбработкиЛок;
	
КонецФункции
// BSLLS:CodeOutOfRegion-on

// Формирует параметры открытия подбора файлов из информационной базы.
//
// Параметры:
//  ВладельцыФайлов - Массив, Неопределено - объекты информационной базы, файлы которых надо показать.
//   Если массив пустой, библиотека сначала откроет выбор владельца.
//  ФормаВладелец - ФормаКлиентскогоПриложения, Неопределено - форма-владелец открываемых форм.
//   Если не передана, используется клиентская форма библиотеки.
//  ПоказыватьПредупреждениеЕслиНедоступно - Булево - признак показа предупреждения при недоступной библиотеке.
//  ИмяПроцедурыДобавленияМетрики - Строка - имя экспортной процедуры формы-владельца для записи метрики.
//
// Возвращаемое значение:
//  Структура:
//   * ВладельцыФайлов - Массив - объекты информационной базы для подбора файлов.
//   * ФормаВладелец - ФормаКлиентскогоПриложения - владелец открываемых форм.
//   * ПоказыватьПредупреждениеЕслиНедоступно - Булево - признак показа предупреждения.
//   * ИмяПроцедурыДобавленияМетрики - Строка - имя экспортной процедуры формы-владельца для записи метрики.
&НаКлиенте
Функция ПараметрыОткрытия(
		Знач ВладельцыФайлов = Неопределено,
		Знач ФормаВладелец = Неопределено,
		Знач ПоказыватьПредупреждениеЕслиНедоступно = Ложь,
		Знач ИмяПроцедурыДобавленияМетрики = "") Экспорт
	
	Если ВладельцыФайлов = Неопределено Тогда
		ВладельцыФайлов = Новый Массив;
	КонецЕсли;
	
	Если ФормаВладелец = Неопределено Тогда
		// BSLLS:UsingThisForm-off
		ФормаВладелец = ЭтаФорма;
		// BSLLS:UsingThisForm-on
	КонецЕсли;
	
	Возврат Новый Структура(
		"ВладельцыФайлов, ФормаВладелец, ПоказыватьПредупреждениеЕслиНедоступно, "
		+ "ИмяПроцедурыДобавленияМетрики",
		ВладельцыФайлов,
		ФормаВладелец,
		ПоказыватьПредупреждениеЕслиНедоступно,
		ИмяПроцедурыДобавленияМетрики);
	
КонецФункции

// Открывает подбор файлов из информационной базы и возвращает выбранные файлы через оповещение.
//
// Параметры:
//  ОписаниеОповещенияОВыборе - ОписаниеОповещения - оповещение, которое будет вызвано после закрытия формы подбора.
//   В результат передается структура формы подбора с выбранными файлами.
//  ПараметрыОткрытияФормы - Структура, Неопределено - параметры, сформированные функцией ПараметрыОткрытия().
&НаКлиенте
Процедура ОткрытьФормуДобавления(Знач ОписаниеОповещенияОВыборе, Знач ПараметрыОткрытияФормы = Неопределено) Экспорт
	
	Если ПараметрыОткрытияФормы = Неопределено Тогда
		ПараметрыОткрытияФормы = ПараметрыОткрытия();
	КонецЕсли;
	
	Если НЕ ДоступноДобавление() Тогда
		
		ПоказыватьПредупреждениеЕслиНедоступно = Ложь;
		ПараметрыОткрытияФормы.Свойство("ПоказыватьПредупреждениеЕслиНедоступно", ПоказыватьПредупреждениеЕслиНедоступно);
		
		Если ПоказыватьПредупреждениеЕслиНедоступно Тогда
			ТекстПредупреждения = "Добавление файлов из информационной базы доступно только в конфигурациях"
				+ " с подсистемами БСП ""Печать"" или ""Работа с файлами"".";
			ПоказатьПредупреждениеЛок(Неопределено, ТекстПредупреждения, 0, "");
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	ВладельцыФайлов = Новый Массив;
	ПараметрыОткрытияФормы.Свойство("ВладельцыФайлов", ВладельцыФайлов);
	
	// BSLLS:UsingThisForm-off
	ФормаВладелец = ЭтаФорма;
	// BSLLS:UsingThisForm-on
	ПараметрыОткрытияФормы.Свойство("ФормаВладелец", ФормаВладелец);
	ИмяПроцедурыДобавленияМетрики = "";
	ПараметрыОткрытияФормы.Свойство(
		"ИмяПроцедурыДобавленияМетрики",
		ИмяПроцедурыДобавленияМетрики);
	ОписаниеОповещенияДобавленияМетрики = Метрики_ОписаниеОповещения(
			ФормаВладелец,
			ИмяПроцедурыДобавленияМетрики);
	Если ВладельцыФайлов.Количество() = 0 Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОписаниеОповещенияОВыборе", ОписаниеОповещенияОВыборе);
		ДополнительныеПараметры.Вставить("ПараметрыОткрытияФормы", ПараметрыОткрытияФормы);
		ДополнительныеПараметры.Вставить("ФормаВладелец", ФормаВладелец);
		// BSLLS:UsingThisForm-off
		ПослеВыбораВладельца = СтдОбщегоНазначения().ОписаниеОповещения(
				"ПродолжитьОткрытиеПослеВыбораВладельца",
				ЭтаФорма,
				ДополнительныеПараметры);
		// BSLLS:UsingThisForm-on
		НачатьВыборОбъектаИнформационнойБазы(
			ПослеВыбораВладельца,
			ФормаВладелец,
			ОписаниеОповещенияДобавленияМетрики);
		Возврат;
	КонецЕсли;
	
	Метрики_ДобавитьСтатистику(
		"ОткрытиеФормы",
		"ВыборФайлов",
		ОписаниеОповещенияДобавленияМетрики);
	ОткрытьФормуВыбораФайлов(
		ВладельцыФайлов,
		ФормаВладелец,
		ОписаниеОповещенияОВыборе,
		ИмяПроцедурыДобавленияМетрики);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОткрытиеПослеВыбораВладельца(ВыбранныйВладелецФайлов, ДополнительныеПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВыбранныйВладелецФайлов) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытияФормы = ДополнительныеПараметры.ПараметрыОткрытияФормы;
	ПараметрыОткрытияФормы.ВладельцыФайлов = Новый Массив;
	ПараметрыОткрытияФормы.ВладельцыФайлов.Добавить(ВыбранныйВладелецФайлов);
	
	ОткрытьФормуДобавления(ДополнительныеПараметры.ОписаниеОповещенияОВыборе, ПараметрыОткрытияФормы);
	
КонецПроцедуры

// Открывает форму выбора файлов для указанных владельцев.
//
// Параметры:
//  ВладельцыФайлов - Массив - объекты информационной базы, файлы которых надо показать.
//  ФормаВладелец - ФормаКлиентскогоПриложения, Неопределено - форма-владелец открываемой формы.
//  ОписаниеОповещенияОВыборе - ОписаниеОповещения - оповещение, вызываемое после закрытия формы подбора.
//  ИмяПроцедурыДобавленияМетрики - Строка - имя экспортной процедуры формы-владельца для записи метрики.
&НаКлиенте
Процедура ОткрытьФормуВыбораФайлов(
		ВладельцыФайлов,
		ФормаВладелец,
		ОписаниеОповещенияОВыборе,
		ИмяПроцедурыДобавленияМетрики)
	
	ПараметрыФормы = Новый Структура(
			"ВладельцыФайлов, ЗакрыватьПриЗакрытииВладельца, ИмяПроцедурыДобавленияМетрики",
			ВладельцыФайлов,
			Истина,
			ИмяПроцедурыДобавленияМетрики);
	ИмяФормыВыбораФайлов = ИмяФормыБиблиотеки("ВыборФайловИзИнформационнойБазы");
	ОткрытьФормуСовместимо(
		ИмяФормыВыбораФайлов,
		ПараметрыФормы,
		ФормаВладелец,
		,
		,
		,
		ОписаниеОповещенияОВыборе);
	
КонецПроцедуры

// Открывает форму с учетом отличий платформы 8.2/8.3 и режима модальности.
//
// Параметры:
//  ИмяФормы - Строка - полное имя открываемой формы.
//  ПараметрыФормы - Структура, Неопределено - параметры открываемой формы.
//  Владелец - ФормаКлиентскогоПриложения, Неопределено - форма-владелец.
//  Уникальность - Булево, Строка, Неопределено - ключ уникальности формы.
//  Окно - ОкноКлиентскогоПриложения, Неопределено - окно открытия формы.
//  НавигационнаяСсылка - Строка, Неопределено - навигационная ссылка формы.
//  ОписаниеОповещенияОЗакрытии - ОписаниеОповещения, Неопределено - оповещение о закрытии формы.
//  РежимОткрытияОкна - РежимОткрытияОкнаФормы, Неопределено - режим открытия окна.
// BSLLS:MissingParameterDescription-off
// BSLLS:NumberOfOptionalParams-off
// BSLLS:NumberOfParams-off
&НаКлиенте
Процедура ОткрытьФормуСовместимо(
		ИмяФормы,
		ПараметрыФормы = Неопределено,
		Владелец = Неопределено,
		Уникальность = Ложь,
		Окно = Неопределено,
		НавигационнаяСсылка = Неопределено,
		ОписаниеОповещенияОЗакрытии = Неопределено,
		РежимОткрытияОкна = Неопределено) Экспорт
	// BSLLS:NumberOfParams-on
	// BSLLS:NumberOfOptionalParams-on
	// BSLLS:MissingParameterDescription-on
	
	МодальностьЗапрещена = МодальностьЗапрещенаНаСервере();
	
	Если НЕ МодальностьЗапрещена Тогда
		ОткрыватьМодально = Истина;
		Если РежимОткрытияОкна = Неопределено
			ИЛИ РежимОткрытияОкна = РежимОткрытияОкнаФормы.Независимый Тогда
			ОткрыватьМодально = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
	ОткрытьФорму(
		ИмяФормы,
		ПараметрыФормы,
		Владелец,
		Уникальность,
		Окно,
		НавигационнаяСсылка,
		ОписаниеОповещенияОЗакрытии,
		РежимОткрытияОкна);
	#Иначе
	Если МодальностьЗапрещена Тогда
		Выполнить(
			"ОткрытьФорму(ИмяФормы, ПараметрыФормы, Владелец, Уникальность, Окно, "
			+ "НавигационнаяСсылка, ОписаниеОповещенияОЗакрытии, РежимОткрытияОкна)");
	ИначеЕсли ОткрыватьМодально ИЛИ ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезультатОткрытия = Вычислить("ОткрытьФормуМодально(ИмяФормы, ПараметрыФормы, Владелец)");
		СтдОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(
			ОписаниеОповещенияОЗакрытии,
			РезультатОткрытия);
	Иначе
		Выполнить("ОткрытьФорму(ИмяФормы, ПараметрыФормы, Владелец, Уникальность, Окно)");
	КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция МодальностьЗапрещенаНаСервере()
	
	// BSLLS:UseSystemInformation-off
	СистемнаяИнформация = Новый СистемнаяИнформация;
	// BSLLS:UseSystemInformation-on
	Если СтдОбщегоНазначенияНаСервере().СравнитьВерсииЛок(СистемнаяИнформация.ВерсияПриложения, "8.3.4") < 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Возврат Строка(Метаданные.РежимИспользованияМодальности) <> "Использовать";
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция СтдОбщегоНазначенияНаСервере()
	
	Если ЭтоВнешняяОбработка() Тогда
		Возврат Новый("ExternalDataProcessorObject.КонтурДиадокСтдОбщегоНазначения");
	Иначе
		Возврат Новый("DataProcessorObject.КонтурДиадокСтдОбщегоНазначения");
	КонецЕсли;
	
КонецФункции

// Проверяет, можно ли добавить в пакет файлы из информационной базы.
//
// Возвращаемое значение:
//  Булево - Истина, если серверная библиотека доступна хотя бы для присоединенных файлов или печатных форм.
&НаКлиенте
Функция ДоступноДобавление() Экспорт
	Возврат ДоступноДобавлениеВызовСервера();
КонецФункции

&НаСервере
Функция ДоступноДобавлениеВызовСервера()
	Возврат ОбработкаОбъект().ДоступноДобавление();
КонецФункции

// Получает данные выбранных файлов для дальнейшего добавления в пакет Диадока.
//
// Параметры:
//  ВыбранныеФайлы - Массив - описания выбранных присоединенных файлов и печатных форм.
//  ПараметрыПолученияФайлов - Структура, Неопределено - дополнительные параметры получения файлов.
//
// Возвращаемое значение:
//  Структура - результат серверной функции ДанныеФайловДляДобавленияВПакет().
&НаКлиенте
Функция ДанныеФайловДляДобавленияВПакет(
		Знач ВыбранныеФайлы,
		Знач ПараметрыПолученияФайлов = Неопределено) Экспорт
	
	Возврат ДанныеФайловДляДобавленияВПакетВызовСервера(ВыбранныеФайлы, ПараметрыПолученияФайлов);
	
КонецФункции

&НаСервере
Функция ДанныеФайловДляДобавленияВПакетВызовСервера(Знач ВыбранныеФайлы, Знач ПараметрыПолученияФайлов)
	Возврат ОбработкаОбъект().ДанныеФайловДляДобавленияВПакет(
		ВыбранныеФайлы,
		ПараметрыПолученияФайлов,
		УникальныйИдентификатор);
КонецФункции

// Начинает интерактивный выбор объекта информационной базы и возвращает выбранный объект через оповещение.
//
// Параметры:
//  ОписаниеОповещенияОВыборе - ОписаниеОповещения - оповещение, в которое будет передан выбранный объект.
//  ФормаВладелец - ФормаКлиентскогоПриложения, Неопределено - форма-владелец открываемых форм выбора.
//  ОписаниеОповещенияДобавленияМетрики - ОписаниеОповещения, Неопределено - обработчик немедленной записи метрики.
&НаКлиенте
Процедура НачатьВыборОбъектаИнформационнойБазы(
		Знач ОписаниеОповещенияОВыборе,
		Знач ФормаВладелец = Неопределено,
		Знач ОписаниеОповещенияДобавленияМетрики = Неопределено) Экспорт
	
	СписокВыбора = СписокВыбораТиповОбъектовИнформационнойБазы();
	Если СписокВыбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Метрики_ДобавитьСтатистику(
		"ОткрытиеФормы",
		"ВыборТипаИсточникаФайлов",
		ОписаниеОповещенияДобавленияМетрики);
	ДополнительныеПараметры = Новый Структура(
			"ОписаниеОповещенияОВыборе, ФормаВладелец, ОписаниеОповещенияДобавленияМетрики",
			ОписаниеОповещенияОВыборе,
			ФормаВладелец,
			ОписаниеОповещенияДобавленияМетрики);
	
	// BSLLS:UsingThisForm-off
	Оповещение = СтдОбщегоНазначения().ОписаниеОповещения(
			"ПродолжитьВыборПослеВыбораТипа",
			ЭтаФорма,
			ДополнительныеПараметры);
	// BSLLS:UsingThisForm-on
	ПоказатьВыборЭлемента(СписокВыбора, Оповещение, "Выберите тип источника файлов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыборПослеВыбораТипа(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяМетаданных = ВыбранныйЭлемент.Значение;
	Метрики_ДобавитьПоведение(
		"ВыборТипаИсточникаФайлов",
		ИмяМетаданных,
		"ВыборТипаИсточникаФайлов",
		ДополнительныеПараметры.ОписаниеОповещенияДобавленияМетрики);
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	// BSLLS:UsingThisForm-off
	ОповещениеОЗакрытии = СтдОбщегоНазначения().ОписаниеОповещения(
			"ЗавершитьВыборОбъектаИнформационнойБазы",
			ЭтаФорма,
			ДополнительныеПараметры);
	// BSLLS:UsingThisForm-on
	ОткрытьФормуСовместимо(
		ИмяМетаданных + ".ФормаВыбора",
		ПараметрыФормыВыбора,
		ДополнительныеПараметры.ФормаВладелец,
		,
		,
		,
		ОповещениеОЗакрытии);
	
КонецПроцедуры

// BSLLS:CommandModuleExportMethods-off
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранный объект информационной базы.
//  ДополнительныеПараметры - Структура, Неопределено - Дополнительные параметры оповещения.
&НаКлиенте
Процедура ЗавершитьВыборОбъектаИнформационнойБазы(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	СтдОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(
		ДополнительныеПараметры.ОписаниеОповещенияОВыборе,
		ВыбранноеЗначение);
	
КонецПроцедуры
// BSLLS:CommandModuleExportMethods-on

&НаКлиенте
Процедура Метрики_ДобавитьСтатистику(
		Действие,
		НаименованиеФормы,
		ОписаниеОповещенияДобавленияМетрики)
	
	Метрика = Метрики_НоваяМетрика("Статистика", Действие, , НаименованиеФормы);
	Метрики_Записать(Метрика, ОписаниеОповещенияДобавленияМетрики);
	
