&НаКлиенте
Процедура Метрики_ДобавитьПоведение(
		Действие,
		Метка,
		НаименованиеФормы,
		ОписаниеОповещенияДобавленияМетрики)
	
	Метрика = Метрики_НоваяМетрика("Поведение", Действие, Метка, НаименованиеФормы);
	Метрики_Записать(Метрика, ОписаниеОповещенияДобавленияМетрики);
	
КонецПроцедуры

&НаКлиенте
Функция Метрики_НоваяМетрика(ТипМетрики, Действие, Метка, НаименованиеФормы)
	
	Метрика = Новый Структура;
	Метрика.Вставить("ТипМетрики", ТипМетрики);
	Метрика.Вставить("Категория", "ДобавлениеФайловИз1С");
	Метрика.Вставить("Действие", Действие);
	Метрика.Вставить("Метка", Метка);
	Метрика.Вставить("НаименованиеФормы", НаименованиеФормы);
	Метрика.Вставить("ДополнительныеПеременные", Неопределено);
	
	Возврат Метрика;
	
КонецФункции

&НаКлиенте
Процедура Метрики_Записать(Метрика, ОписаниеОповещенияДобавленияМетрики)
	
	Если ОписаниеОповещенияДобавленияМетрики = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтдОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(
		ОписаниеОповещенияДобавленияМетрики,
		Метрика);
	
КонецПроцедуры

&НаКлиенте
Функция Метрики_ОписаниеОповещения(ФормаВладелец, ИмяПроцедурыДобавленияМетрики)
	
	Если ФормаВладелец = Неопределено
		ИЛИ ПустаяСтрока(ИмяПроцедурыДобавленияМетрики) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтдОбщегоНазначения().ОписаниеОповещения(
		ИмяПроцедурыДобавленияМетрики,
		ФормаВладелец);
	
КонецФункции

