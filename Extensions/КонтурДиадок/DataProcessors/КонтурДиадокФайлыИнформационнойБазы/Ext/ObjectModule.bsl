////////////////////////////////////////////////////////////////////////////////
// Работа с файлами информационной базы для добавления в пакет Диадока.

////////////////////////////////////////////////////////////////////////////////
// ПЕРЕМЕННЫЕ МОДУЛЯ

// BSLLS:CodeOutOfRegion-off
// BSLLS:UnusedLocalVariable-off
Перем СтдОбщегоНазначенияЛок, СтдСтрЛок, ДоступностьПодсистемБСПЛок;
// BSLLS:UnusedLocalVariable-on
// BSLLS:CodeOutOfRegion-on

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Проверяет, можно ли добавить в пакет хотя бы один вид файлов из информационной базы.
// Доступность рассчитывается по наличию поддерживаемых подсистем БСП и кэшируется в объекте библиотеки.
//
// Возвращаемое значение:
//  Булево - Истина, если доступно добавление присоединенных файлов или печатных форм.
Функция ДоступноДобавление() Экспорт
	
	Возврат ДоступноДобавлениеПрисоединенныхФайлов()
	ИЛИ ДоступноДобавлениеПечатныхФорм();
	
КонецФункции

// Проверяет, можно ли добавить в пакет присоединенные файлы объектов информационной базы.
// Доступность означает, что в конфигурации есть подсистема и общий модуль БСП для работы с файлами.
//
// Возвращаемое значение:
//  Булево - Истина, если библиотека может получить присоединенные файлы через БСП "Работа с файлами".
Функция ДоступноДобавлениеПрисоединенныхФайлов() Экспорт
	
	Возврат ДоступностьПодсистемБСП().РаботаСФайлами;
	
КонецФункции

// Инициализирует параметры получения данных присоединенного файла через БСП.
//
// Возвращаемое значение:
//  Структура:
//   * ДляРедактирования - Булево - Признак захвата файла для редактирования.
//   * ИдентификаторФормы - УникальныйИдентификатор, Неопределено - Идентификатор формы для временного хранилища.
//   * ВызыватьИсключение - Булево - Признак вызова исключений при ошибках получения файла.
//   * ПолучатьСсылкуНаДвоичныеДанные - Булево - Признак получения адреса двоичных данных во временном хранилище.
Функция ПараметрыДанныхФайла() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДляРедактирования", Ложь);
	Результат.Вставить("ИдентификаторФормы", Неопределено);
	Результат.Вставить("ВызыватьИсключение", Истина);
	Результат.Вставить("ПолучатьСсылкуНаДвоичныеДанные", Истина);
	
	Возврат Результат;
	
КонецФункции

// Проверяет, можно ли добавить в пакет печатные формы объектов информационной базы.
// Доступность означает, что в конфигурации есть подсистема и общий модуль БСП для печати.
//
// Возвращаемое значение:
//  Булево - Истина, если библиотека может получить команды печати через БСП "Печать".
Функция ДоступноДобавлениеПечатныхФорм() Экспорт
	
	Возврат ДоступностьПодсистемБСП().Печать;
	
КонецФункции

// Возвращает доступные команды печати объекта, которые можно сформировать для добавления в пакет.
// Исключает групповые, отключенные, скрытые, дублирующиеся и запрещенные для ЭДО команды.
//
// Параметры:
//  ВладелецФайлов - ЛюбаяСсылка - Объект информационной базы, для которого получаются команды печати.
//
// Возвращаемое значение:
//  Массив - СтрокаТаблицыЗначений - команды печати БСП.
Функция ДоступныеКомандыПечати(ВладелецФайлов) Экспорт
	
	КомандыПечати = Новый Массив;
	МодульУправлениеПечатью = СтдОбщегоНазначения().ОбщийМодульЛок("УправлениеПечатью");
	МетаданныеВладельца = ВладелецФайлов.Метаданные();
	Попытка
		КомандыПечатиОбъекта = МодульУправлениеПечатью.КомандыПечатиОбъектаДоступныеДляВложений(МетаданныеВладельца);
	Исключение
		КомандыПечатиОбъекта = МодульУправлениеПечатью.КомандыПечатиОбъекта(МетаданныеВладельца);
	КонецПопытки;
	ЗапрещенныеКомандыПечати = ЗапрещенныеКомандыПечатиДляФормированияДокумента();
	УникальныеКомандыПечати = Новый Соответствие;
	
	Для Каждого КомандаПечати Из КомандыПечатиОбъекта Цикл
		КомандаПечатиБезГруппы =
			СтдСтр().СтрНайтиЛок(КомандаПечати.Идентификатор, ",") = 0;
		
		КомандаПечатиДоступнаДляВложения = НЕ КомандаПечати.Отключена
			И КомандаПечатиБезГруппы
			И НЕ ПустаяСтрока(КомандаПечати.МенеджерПечати)
			И НЕ КомандаПечати.СразуНаПринтер
			И НЕ КомандаПечати.СкрытаФункциональнымиОпциями
			И КомандаПечатиДоступнаДляВладельца(КомандаПечати, ВладелецФайлов)
			И ЗапрещенныеКомандыПечати[КомандаПечати.Идентификатор] <> Истина
			И УникальныеКомандыПечати[КомандаПечати.Идентификатор] <> Истина;
		Если НЕ КомандаПечатиДоступнаДляВложения Тогда
			Продолжить;
		КонецЕсли;
		УникальныеКомандыПечати[КомандаПечати.Идентификатор] = Истина;
		КомандыПечати.Добавить(КомандаПечати);
	КонецЦикла;
	
	Возврат КомандыПечати;
	
КонецФункции

Функция ЗапрещенныеКомандыПечатиДляФормированияДокумента()
	
	ЗапрещенныеКоманды = Новый Массив;
	ДобавитьЗапрещенныеКомандыПечатиДляФормированияДокумента(
		ЗапрещенныеКоманды,
		"ОбменСКонтрагентамиПереопределяемый");
	ДобавитьЗапрещенныеКомандыПечатиДляФормированияДокумента(
		ЗапрещенныеКоманды,
		"ОбменСГИСЭПД");
	
	Результат = Новый Соответствие;
	Для Каждого ИдентификаторКоманды Из ЗапрещенныеКоманды Цикл
		Результат[ИдентификаторКоманды] = Истина;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьЗапрещенныеКомандыПечатиДляФормированияДокумента(ЗапрещенныеКоманды, ИмяМодуля)
	
	Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модуль = СтдОбщегоНазначения().ОбщийМодульЛок(ИмяМодуля);
	Попытка
		Модуль.ПриОпределенииПечатныхФормЗапрещенныхДляФормированияДокумента(ЗапрещенныеКоманды);
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

// Возвращает доступные присоединенные файлы объекта информационной базы.
// Файлы с пометкой удаления и файлы, данные которых БСП не вернула, в результат не попадают.
//
// Параметры:
//  ВладелецФайлов - ЛюбаяСсылка - Объект информационной базы, для которого получаются присоединенные файлы.
//  ИдентификаторФормы - УникальныйИдентификатор, Неопределено - Идентификатор формы для временного хранилища.
//
// Возвращаемое значение:
//  Массив - Структура - данные файлов БСП РаботаСФайлами.ДанныеФайла без двоичных данных файла.
Функция ДоступныеФайлы(ВладелецФайлов, ИдентификаторФормы = Неопределено) Экспорт
	
	ДоступныеФайлы = Новый Массив;
	Если НЕ ДоступноДобавлениеПрисоединенныхФайлов() Тогда
		Возврат ДоступныеФайлы;
	КонецЕсли;
	
	Если НЕ ЭтоВладелецПрисоединенныхФайлов(ВладелецФайлов) Тогда
		Возврат ДоступныеФайлы;
	КонецЕсли;
	
	МодульРаботаСФайлами = СтдОбщегоНазначения().ОбщийМодульЛок("РаботаСФайлами");
	ПрисоединенныеФайлыОбъекта = Новый Массив;
	МодульРаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ВладелецФайлов, ПрисоединенныеФайлыОбъекта);
	
	Для Каждого ПрисоединенныйФайл Из ПрисоединенныеФайлыОбъекта Цикл
		
		ПараметрыДанныхФайла = ПараметрыДанныхФайла();
		ПараметрыДанныхФайла.ИдентификаторФормы = ИдентификаторФормы;
		ПараметрыДанныхФайла.ПолучатьСсылкуНаДвоичныеДанные = Ложь;
		ПараметрыДанныхФайла.ВызыватьИсключение = Ложь;
		
		ДанныеФайла = МодульРаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл, ПараметрыДанныхФайла);
		Если ДанныеФайла = Неопределено
			ИЛИ ДанныеФайла.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		ДоступныеФайлы.Добавить(ДанныеФайла);
		
	КонецЦикла;
	
	Возврат ДоступныеФайлы;
	
КонецФункции

// Возвращает описания присоединенных файлов объекта для формы выбора файлов.
//
// Параметры:
//  ВладелецФайлов - ЛюбаяСсылка - объект информационной базы, для которого получаются присоединенные файлы.
//  ИдентификаторФормы - УникальныйИдентификатор, Неопределено - идентификатор формы для временного хранилища.
//
// Возвращаемое значение:
//  Массив - Структура - описания строк выбора присоединенных файлов:
//   * ВидСтроки - Строка - "ПрисоединенныйФайл".
//   * Представление - Строка - имя файла для показа в форме выбора.
//   * Источник - ЛюбаяСсылка - ссылка на присоединенный файл.
//   * Владелец - ЛюбаяСсылка - владелец присоединенного файла.
//   * ИмяФайла - Строка - имя файла.
//   * Размер - Число - размер файла в байтах.
//   * ИдентификаторКомандыПечати - Строка - пустая строка.
//   * МенеджерПечати - Строка - пустая строка.
Функция ДоступныеФайлыДляВыбора(ВладелецФайлов, ИдентификаторФормы = Неопределено) Экспорт
	
	Результат = Новый Массив;
	Для Каждого ДанныеФайла Из ДоступныеФайлы(ВладелецФайлов, ИдентификаторФормы) Цикл
		Результат.Добавить(ОписаниеПрисоединенногоФайлаДляВыбора(ДанныеФайла, ВладелецФайлов));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает доступные печатные формы объекта информационной базы.
//
// Параметры:
//  ВладелецФайлов - ЛюбаяСсылка - Объект информационной базы, для которого получаются печатные формы.
//
// Возвращаемое значение:
//  Массив - СтрокаТаблицыЗначений - команды печати БСП, доступные для формирования файла.
Функция ДоступныеПечатныеФормы(ВладелецФайлов) Экспорт
	
	Если НЕ ДоступноДобавлениеПечатныхФорм() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Возврат ДоступныеКомандыПечати(ВладелецФайлов);
	
КонецФункции

// Возвращает описания печатных форм объекта для формы выбора файлов.
//
// Параметры:
//  ВладелецФайлов - ЛюбаяСсылка - объект информационной базы, для которого получаются печатные формы.
//
// Возвращаемое значение:
//  Массив - Структура - описания строк выбора печатных форм:
//   * ВидСтроки - Строка - "ПечатнаяФорма".
//   * Представление - Строка - представление команды печати.
//   * Источник - Неопределено - для печатной формы источник выбирается по команде печати.
//   * Владелец - ЛюбаяСсылка - владелец печатной формы.
//   * ИмяФайла - Строка - пустая строка.
//   * Размер - Число - 0.
//   * ИдентификаторКомандыПечати - Строка - идентификатор команды печати.
//   * МенеджерПечати - Строка - менеджер печати команды.
Функция ДоступныеПечатныеФормыДляВыбора(ВладелецФайлов) Экспорт
	
	Результат = Новый Массив;
	Для Каждого КомандаПечати Из ДоступныеПечатныеФормы(ВладелецФайлов) Цикл
		Результат.Добавить(ОписаниеПечатнойФормыДляВыбора(КомандаПечати, ВладелецФайлов));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает список типов объектов информационной базы, доступных для выбора владельца файлов.
// Типы берутся из определяемых типов БСП для файлов и актуальных настроек подсистемы печати.
//
// Возвращаемое значение:
//  СписокЗначений - список полных имен метаданных с представлениями.
// BSLLS:CommandModuleExportMethods-off
// BSLLS:ServerSideExportFormMethod-off
Функция СписокВыбораТиповОбъектовИнформационнойБазы() Экспорт
	
	СписокВыбора = Новый СписокЗначений;
	ДобавленныеТипы = Новый Соответствие;
	
	Если ДоступноДобавлениеПрисоединенныхФайлов() Тогда
		ДобавитьТипыОпределяемогоТипаВСписокВыбора(
			СписокВыбора,
			ДобавленныеТипы,
			"ВладелецПрисоединенныхФайлов");
		ДобавитьТипыОпределяемогоТипаВСписокВыбора(
			СписокВыбора,
			ДобавленныеТипы,
			"ВладелецФайлов");
	КонецЕсли;
	
	Если ДоступноДобавлениеПечатныхФорм() Тогда
		ДобавитьТипыПечатныхОбъектовВСписокВыбора(
			СписокВыбора,
			ДобавленныеТипы);
	КонецЕсли;
	
	СписокВыбора.СортироватьПоПредставлению();
	Возврат СписокВыбора;
	
КонецФункции
// BSLLS:ServerSideExportFormMethod-on
// BSLLS:CommandModuleExportMethods-on

Функция КомандаПечатиДоступнаДляВладельца(КомандаПечати, ВладелецФайлов)
	
	Если КомандаПечати.УсловияВидимости.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого УсловиеВидимости Из КомандаПечати.УсловияВидимости Цикл
		Если ТипЗнч(УсловиеВидимости) <> Тип("Структура")
			ИЛИ НЕ УсловиеВидимости.Свойство("Реквизит") Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ УсловиеВидимостиКомандыПечатиВыполняется(УсловиеВидимости, ВладелецФайлов) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция УсловиеВидимостиКомандыПечатиВыполняется(УсловиеВидимости, ВладелецФайлов)
	
	Результат = Истина;
	ИмяРеквизита = УсловиеВидимости.Реквизит;
	Если СтдОбщегоНазначения().ЕстьРеквизитИлиСвойствоОбъектаЛок(ВладелецФайлов, ИмяРеквизита) Тогда
		
		ЗначениеРеквизита = СтдОбщегоНазначения().ЗначениеРеквизитаОбъектаЛок(ВладелецФайлов, ИмяРеквизита);
		ВидСравненияУсловия = УсловиеВидимости.ВидСравнения;
		ЗначениеУсловия = УсловиеВидимости.Значение;
		
		Если ВидСравненияУсловия = ВидСравненияКомпоновкиДанных.Заполнено Тогда
			Результат = ЗначениеЗаполнено(ЗначениеРеквизита);
		ИначеЕсли ВидСравненияУсловия = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
			Результат = НЕ ЗначениеЗаполнено(ЗначениеРеквизита);
		Иначе
			РезультатСписочногоСравнения = СписочноеУсловиеВидимостиВыполняется(
					ВидСравненияУсловия,
					ЗначениеРеквизита,
					ЗначениеУсловия);
			Если РезультатСписочногоСравнения <> Неопределено Тогда
				Результат = РезультатСписочногоСравнения;
			Иначе
				Результат = УсловиеСравненияЗначенийВыполняется(
					ВидСравненияУсловия,
					ЗначениеРеквизита,
					ЗначениеУсловия);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СписочноеУсловиеВидимостиВыполняется(
		ВидСравненияУсловия,
		ЗначениеРеквизита,
		ЗначениеУсловия)
	
	Если ТипЗнч(ЗначениеУсловия) = Тип("СписокЗначений") Тогда
		ЗначениеЕстьВСписке = ЗначениеУсловия.НайтиПоЗначению(ЗначениеРеквизита) <> Неопределено;
	ИначеЕсли ТипЗнч(ЗначениеУсловия) = Тип("Массив")
		ИЛИ ТипЗнч(ЗначениеУсловия) = Тип("ФиксированныйМассив") Тогда
		ЗначениеЕстьВСписке = ЗначениеУсловия.Найти(ЗначениеРеквизита) <> Неопределено;
	Иначе
		ЗначениеЕстьВСписке = ЗначениеРеквизита = ЗначениеУсловия;
	КонецЕсли;
	
	Если ВидСравненияУсловия = ВидСравнения.ВСписке
		ИЛИ ВидСравненияУсловия = ВидСравненияКомпоновкиДанных.ВСписке Тогда
		Возврат ЗначениеЕстьВСписке;
	КонецЕсли;
	
	Если ВидСравненияУсловия = ВидСравнения.НеВСписке
		ИЛИ ВидСравненияУсловия = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
		Возврат НЕ ЗначениеЕстьВСписке;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция УсловиеСравненияЗначенийВыполняется(
		ВидСравненияУсловия,
		ЗначениеРеквизита,
		ЗначениеУсловия)
	
	Результат = Истина;
	Если ВидСравненияУсловия = ВидСравнения.НеРавно
		ИЛИ ВидСравненияУсловия = ВидСравненияКомпоновкиДанных.НеРавно Тогда
		Результат = ЗначениеРеквизита <> ЗначениеУсловия;
	ИначеЕсли ВидСравненияУсловия = ВидСравнения.Равно
		ИЛИ ВидСравненияУсловия = ВидСравненияКомпоновкиДанных.Равно Тогда
		Результат = ЗначениеРеквизита = ЗначениеУсловия;
	ИначеЕсли ВидСравненияУсловия = ВидСравнения.Больше
		ИЛИ ВидСравненияУсловия = ВидСравненияКомпоновкиДанных.Больше Тогда
		Результат = ЗначениеРеквизита > ЗначениеУсловия;
	ИначеЕсли ВидСравненияУсловия = ВидСравнения.БольшеИлиРавно
		ИЛИ ВидСравненияУсловия = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
		Результат = ЗначениеРеквизита >= ЗначениеУсловия;
	ИначеЕсли ВидСравненияУсловия = ВидСравнения.Меньше
		ИЛИ ВидСравненияУсловия = ВидСравненияКомпоновкиДанных.Меньше Тогда
		Результат = ЗначениеРеквизита < ЗначениеУсловия;
	ИначеЕсли ВидСравненияУсловия = ВидСравнения.МеньшеИлиРавно
		ИЛИ ВидСравненияУсловия = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
		Результат = ЗначениеРеквизита <= ЗначениеУсловия;
	Иначе
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьТипыОпределяемогоТипаВСписокВыбора(
		СписокВыбора,
		ДобавленныеТипы,
		ИмяОпределяемогоТипа)
	
	ОпределяемыйТип = Метаданные.ОпределяемыеТипы.Найти(ИмяОпределяемогоТипа);
	Если ОпределяемыйТип = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТипЗначения Из ОпределяемыйТип.Тип.Типы() Цикл
		ДобавитьТипВСписокВыбора(
			СписокВыбора,
			ДобавленныеТипы,
			ТипЗначения);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьТипыПечатныхОбъектовВСписокВыбора(СписокВыбора, ДобавленныеТипы)
	
	МодульУправлениеПечатьюПовтИсп = СтдОбщегоНазначения().ОбщийМодульЛок("УправлениеПечатьюПовтИсп");
	Если МодульУправлениеПечатьюПовтИсп = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьОбъектыНастроекПечатиВСписокВыбора(
		СписокВыбора,
		ДобавленныеТипы,
		МодульУправлениеПечатьюПовтИсп);
	ДобавитьОбъектыСКомандамиПечатиВСписокВыбора(
		СписокВыбора,
		ДобавленныеТипы,
		МодульУправлениеПечатьюПовтИсп);
	
КонецПроцедуры

Процедура ДобавитьОбъектыНастроекПечатиВСписокВыбора(
		СписокВыбора,
		ДобавленныеТипы,
		МодульУправлениеПечатьюПовтИсп)
	
	Попытка
		НастройкиПечати = МодульУправлениеПечатьюПовтИсп.НастройкиПечати();
	Исключение
		Возврат;
	КонецПопытки;
	
	Для Каждого ОбъектМенеджер Из НастройкиПечати.ОбъектыПечати Цикл
		ДобавитьМенеджерОбъектаПечатиВСписокВыбора(
			СписокВыбора,
			ДобавленныеТипы,
			ОбъектМенеджер);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьОбъектыСКомандамиПечатиВСписокВыбора(
		СписокВыбора,
		ДобавленныеТипы,
		МодульУправлениеПечатьюПовтИсп)
	
	Попытка
		ОбъектыСКомандамиПечати = МодульУправлениеПечатьюПовтИсп.ОбъектыСКомандамиПечати();
	Исключение
		Возврат;
	КонецПопытки;
	
	ЭтоМассивМенеджеров = ТипЗнч(ОбъектыСКомандамиПечати) = Тип("Массив");
	Для Каждого Элемент Из ОбъектыСКомандамиПечати Цикл
		Если ЭтоМассивМенеджеров Тогда
			ОбъектМенеджер = Элемент;
		Иначе
			ОбъектМенеджер = Элемент.Ключ;
		КонецЕсли;
		
		ДобавитьМенеджерОбъектаПечатиВСписокВыбора(
			СписокВыбора,
			ДобавленныеТипы,
			ОбъектМенеджер);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьМенеджерОбъектаПечатиВСписокВыбора(
		СписокВыбора,
		ДобавленныеТипы,
		ОбъектМенеджер)
	
	МетаданныеТипа = Метаданные.НайтиПоТипу(ТипЗнч(ОбъектМенеджер));
	Если МетаданныеТипа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьМетаданныеВСписокВыбора(
		СписокВыбора,
		ДобавленныеТипы,
		МетаданныеТипа);
	
КонецПроцедуры

Процедура ДобавитьТипВСписокВыбора(
		СписокВыбора,
		ДобавленныеТипы,
		ТипЗначения)
	
	МетаданныеТипа = Метаданные.НайтиПоТипу(ТипЗначения);
	Если МетаданныеТипа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьМетаданныеВСписокВыбора(
		СписокВыбора,
		ДобавленныеТипы,
		МетаданныеТипа);
	
КонецПроцедуры

Процедура ДобавитьМетаданныеВСписокВыбора(
		СписокВыбора,
		ДобавленныеТипы,
		МетаданныеТипа)
	
	ПолноеИмяМетаданных = МетаданныеТипа.ПолноеИмя();
	Если ДобавленныеТипы[ПолноеИмяМетаданных] = Истина
		ИЛИ НЕ ТипМетаданныхДоступенДляВыбора(МетаданныеТипа) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавленныеТипы[ПолноеИмяМетаданных] = Истина;
	СписокВыбора.Добавить(ПолноеИмяМетаданных, МетаданныеТипа.Синоним);
	
КонецПроцедуры

Функция ТипМетаданныхДоступенДляВыбора(МетаданныеТипа)
	
	Если НЕ ЭтоСсылочныйТипМетаданных(МетаданныеТипа) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ПравоДоступа("Чтение", МетаданныеТипа) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПрефиксНеиспользуемогоТипа = "Удалить";
	ИмяМетаданных = СокрЛП(МетаданныеТипа.Имя);
	
	Если Лев(ИмяМетаданных, СтрДлина(ПрефиксНеиспользуемогоТипа)) = ПрефиксНеиспользуемогоТипа Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МодульОбщегоНазначения = СтдОбщегоНазначения().ОбщийМодульЛок("ОбщегоНазначения");
	Возврат МодульОбщегоНазначения.ОбъектМетаданныхДоступенПоФункциональнымОпциям(МетаданныеТипа);
	
КонецФункции

Функция ЭтоСсылочныйТипМетаданных(МетаданныеТипа)
	
	Возврат Метаданные.Справочники.Содержит(МетаданныеТипа)
	ИЛИ Метаданные.Документы.Содержит(МетаданныеТипа)
	ИЛИ Метаданные.БизнесПроцессы.Содержит(МетаданныеТипа)
	ИЛИ Метаданные.Задачи.Содержит(МетаданныеТипа)
	ИЛИ Метаданные.ПланыСчетов.Содержит(МетаданныеТипа)
	ИЛИ Метаданные.ПланыОбмена.Содержит(МетаданныеТипа)
	ИЛИ Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеТипа)
	ИЛИ Метаданные.ПланыВидовРасчета.Содержит(МетаданныеТипа);
	
КонецФункции

// Получает данные выбранных файлов для дальнейшего добавления в пакет Диадока.
// Присоединенные файлы читает через БСП "Работа с файлами", печатные формы формирует в PDF.
//
// Параметры:
//  ВыбранныеФайлы - Массив - описания выбранных присоединенных файлов и печатных форм:
//   * ВидСтроки - Строка - "Файл" или "ПечатнаяФорма".
//   * Источник - ЛюбаяСсылка, Неопределено - присоединенный файл для строк вида "Файл".
//   * Владелец - ЛюбаяСсылка - владелец файла или печатной формы.
//   * ИдентификаторКомандыПечати - Строка - идентификатор команды для строк вида "ПечатнаяФорма".
//  ПараметрыПолученияФайлов - Структура, Неопределено - дополнительные параметры получения файлов:
//   * ИдентификаторФормы - УникальныйИдентификатор, Неопределено - идентификатор формы для временного хранилища.
//  ИдентификаторФормы - УникальныйИдентификатор, Неопределено - Идентификатор формы для временного хранилища.
//
// Возвращаемое значение:
//  Структура:
//   * ДанныеФайлов - Массив - файлы для добавления в пакет:
//    ** ДвоичныеДанныеФайла - ДвоичныеДанные - содержимое файла.
//    ** ИмяФайла - Строка - имя файла.
//    ** РазмерФайла - Число - размер файла в байтах.
//    ** Владелец - ЛюбаяСсылка - объект информационной базы, из которого получен файл.
//    ** ИмяОбъектаИнформационнойБазы - Строка - представление владельца файла.
//    ** ИмяВыбранногоФайлаИнформационнойБазы - Строка - представление выбранного файла для пакета.
//   * ТекстПредупреждения - Строка - Предупреждения, которые надо показать пользователю.
Функция ДанныеФайловДляДобавленияВПакет(
		Знач ВыбранныеФайлы,
		Знач ПараметрыПолученияФайлов = Неопределено,
		Знач ИдентификаторФормы = Неопределено) Экспорт
	
	Результат = Новый Структура("ДанныеФайлов, ТекстПредупреждения", Новый Массив, "");
	БольшиеФайлы = Новый Массив;
	МаксимальныйРазмерФайлаМб = 400;
	КоличествоБайтВКилобайте = 1024;
	МаксимальныйРазмерФайла = МаксимальныйРазмерФайлаМб * КоличествоБайтВКилобайте * КоличествоБайтВКилобайте;
	
	Если ИдентификаторФормы = Неопределено
		И ПараметрыПолученияФайлов <> Неопределено Тогда
		ПараметрыПолученияФайлов.Свойство("ИдентификаторФормы", ИдентификаторФормы);
	КонецЕсли;
	
	МодульРаботаСФайлами = СтдОбщегоНазначения().ОбщийМодульЛок("РаботаСФайлами");
	
	Для Каждого ВыбранныйФайл Из ВыбранныеФайлы Цикл
		
		ОписаниеВыбора = ОписаниеВыбораФайла(ВыбранныйФайл);
		ВидСтроки = "";
		ОписаниеВыбора.Свойство("ВидСтроки", ВидСтроки);
		
		Если ВидСтроки = "ПечатнаяФорма" Тогда
			ДобавитьДанныеПечатнойФормыДляДобавленияВПакет(
				ОписаниеВыбора,
				Результат,
				БольшиеФайлы,
				МаксимальныйРазмерФайла);
		Иначе
			ДобавитьДанныеПрисоединенногоФайлаДляДобавленияВПакет(
				ОписаниеВыбора,
				Результат,
				БольшиеФайлы,
				МаксимальныйРазмерФайла,
				МодульРаботаСФайлами,
				ИдентификаторФормы);
		КонецЕсли;
		
	КонецЦикла;
	
	Если БольшиеФайлы.Количество() > 0 Тогда
		ТекстПредупреждения = "Размер отправляемого файла не должен превышать "
			+ Формат(МаксимальныйРазмерФайлаМб, "ЧГ=0") + " Мб.
			|Невозможно добавить следующие файлы:";
		Для Каждого ИмяБольшогоФайла Из БольшиеФайлы Цикл
			ТекстПредупреждения = ТекстПредупреждения + "
				|- " + ИмяБольшогоФайла;
		КонецЦикла;
		Результат.ТекстПредупреждения = Результат.ТекстПредупреждения
			+ ?(Результат.ТекстПредупреждения = "", "", Символы.ПС)
			+ ТекстПредупреждения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьДанныеПрисоединенногоФайлаДляДобавленияВПакет(
		ОписаниеВыбора,
		Результат,
		БольшиеФайлы,
		МаксимальныйРазмерФайла,
		МодульРаботаСФайлами,
		ИдентификаторФормы)
	
	ПрисоединенныйФайл = ОписаниеВыбора.Источник;
	Если НЕ ЗначениеЗаполнено(ПрисоединенныйФайл) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыДанныхФайла = ПараметрыДанныхФайла();
	ПараметрыДанныхФайла.ИдентификаторФормы = ИдентификаторФормы;
	ПараметрыДанныхФайла.ПолучатьСсылкуНаДвоичныеДанные = Ложь;
	ДанныеФайла = МодульРаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл, ПараметрыДанныхФайла);
	
	Если ДанныеФайла.Размер > МаксимальныйРазмерФайла Тогда
		БольшиеФайлы.Добавить(ДанныеФайла.ИмяФайла);
		Возврат;
	КонецЕсли;
	
	ПараметрыДанныхФайла.ПолучатьСсылкуНаДвоичныеДанные = Истина;
	ДанныеФайла = МодульРаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл, ПараметрыДанныхФайла);
	АдресДвоичныхДанныхФайла = ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресДвоичныхДанныхФайла);
	УдалитьИзВременногоХранилища(АдресДвоичныхДанныхФайла);
	
	ОписаниеФайла = Новый Структура;
	ОписаниеФайла.Вставить("ДвоичныеДанныеФайла", ДвоичныеДанныеФайла);
	ОписаниеФайла.Вставить("ИмяФайла", ДанныеФайла.ИмяФайла);
	ОписаниеФайла.Вставить("РазмерФайла", ДанныеФайла.Размер);
	ОписаниеФайла.Вставить("Владелец", ОписаниеВыбора.Владелец);
	ОписаниеФайла.Вставить(
		"ИмяОбъектаИнформационнойБазы",
		ИмяОбъектаИнформационнойБазы(ОписаниеВыбора.Владелец));
	ОписаниеФайла.Вставить("ИмяВыбранногоФайлаИнформационнойБазы", "Файл." + ДанныеФайла.ИмяФайла);
	Результат.ДанныеФайлов.Добавить(ОписаниеФайла);
	
КонецПроцедуры

Процедура ДобавитьДанныеПечатнойФормыДляДобавленияВПакет(
		ОписаниеВыбора,
		Результат,
		БольшиеФайлы,
		МаксимальныйРазмерФайла)
	
	КомандаПечати = КомандаПечати(ОписаниеВыбора);
	Если КомандаПечати = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ФайлыПечатныхФорм = ФайлыПечатнойФормы(
				КомандаПечати,
				ОписаниеВыбора.Владелец);
	Исключение
		ОбработатьОшибкуФормированияПечатнойФормы(
			ОписаниеВыбора,
			Результат,
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	
	Если ФайлыПечатныхФорм = Неопределено Тогда
		ОбработатьОшибкуФормированияПечатнойФормы(
			ОписаниеВыбора,
			Результат,
			НСтр("ru = 'Печатная форма не вернула файл.'"));
		Возврат;
	КонецЕсли;
	КоличествоСформированныхФайлов = 0;
	
	Для Каждого ФайлПечатнойФормы Из ФайлыПечатныхФорм Цикл
		КоличествоСформированныхФайлов = КоличествоСформированныхФайлов + 1;
		Если ФайлПечатнойФормы.ДвоичныеДанные.Размер() > МаксимальныйРазмерФайла Тогда
			БольшиеФайлы.Добавить(ФайлПечатнойФормы.ИмяФайла);
			Продолжить;
		КонецЕсли;
		
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("ДвоичныеДанныеФайла", ФайлПечатнойФормы.ДвоичныеДанные);
		ОписаниеФайла.Вставить("ИмяФайла", ФайлПечатнойФормы.ИмяФайла);
		ОписаниеФайла.Вставить("РазмерФайла", ФайлПечатнойФормы.ДвоичныеДанные.Размер());
		ОписаниеФайла.Вставить("Владелец", ОписаниеВыбора.Владелец);
		ОписаниеФайла.Вставить(
			"ИмяОбъектаИнформационнойБазы",
			ИмяОбъектаИнформационнойБазы(ОписаниеВыбора.Владелец));
		ОписаниеФайла.Вставить(
			"ИмяВыбранногоФайлаИнформационнойБазы",
			"ПечатнаяФорма." + ОписаниеВыбора.ИдентификаторКомандыПечати);
		Результат.ДанныеФайлов.Добавить(ОписаниеФайла);
	КонецЦикла;
	
	Если КоличествоСформированныхФайлов = 0 Тогда
		ОбработатьОшибкуФормированияПечатнойФормы(
			ОписаниеВыбора,
			Результат,
			НСтр("ru = 'Печатная форма не вернула файл.'"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьОшибкуФормированияПечатнойФормы(
		ОписаниеВыбора,
		Результат,
		Ошибка)
	
	ПредставлениеПечатнойФормы = ОписаниеВыбора.Представление;
	ТекстПредупреждения = НСтр("ru = 'Не удалось сформировать печатную форму:'")
		+ " " + ПредставлениеПечатнойФормы + ".";
	Результат.ТекстПредупреждения = Результат.ТекстПредупреждения
		+ ?(Результат.ТекстПредупреждения = "", "", Символы.ПС)
		+ ТекстПредупреждения;
	
	ЗаписатьОшибкуФормированияПечатнойФормыВЖурналРегистрации(
		Ошибка,
		ПредставлениеПечатнойФормы,
		ИмяОбъектаИнформационнойБазы(ОписаниеВыбора.Владелец));
	
КонецПроцедуры

Процедура ЗаписатьОшибкуФормированияПечатнойФормыВЖурналРегистрации(
		Ошибка,
		ПредставлениеПечатнойФормы,
		ИмяОбъектаИнформационнойБазы)
	
	Если ТипЗнч(Ошибка) = Тип("ИнформацияОбОшибке") Тогда
		// BSLLS:DeprecatedMethods8317-off
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		// BSLLS:DeprecatedMethods8317-on
	Иначе
		ТекстОшибки = СокрЛП(Ошибка);
	КонецЕсли;
	
	Комментарий = "Печатная форма: " + ПредставлениеПечатнойФормы
		+ Символы.ПС + "Объект 1С: " + ИмяОбъектаИнформационнойБазы;
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Комментарий = Комментарий + Символы.ПС + ТекстОшибки;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		"Диадок.ДобавлениеФайловИз1С.ФормированиеПечатнойФормы",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		Комментарий);
	
КонецПроцедуры

Функция ИмяОбъектаИнформационнойБазы(ВладелецФайлов)
	
	Если НЕ ЗначениеЗаполнено(ВладелецФайлов) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ВладелецФайлов.Метаданные().ПолноеИмя();
	
КонецФункции

Функция ФайлыПечатнойФормы(КомандаПечати, Владелец)
	
	МодульУправлениеПечатью = СтдОбщегоНазначения().ОбщийМодульЛок("УправлениеПечатью");
	КомандаПечатиДляФормирования = КомандаПечатиДляФормирования(КомандаПечати);
	ОбъектыПечати = Новый Массив;
	ОбъектыПечати.Добавить(Владелец);
	ПараметрыПечати = КомандаПечатиДляФормирования.ДополнительныеПараметры;
	Если ПараметрыПечати = Неопределено Тогда
		ПараметрыПечати = Новый Структура;
	КонецЕсли;
	СформированныеПечатныеФормы = МодульУправлениеПечатью.СформироватьПечатныеФормы(
			КомандаПечатиДляФормирования.МенеджерПечати,
			КомандаПечатиДляФормирования.Идентификатор,
		ОбъектыПечати,
			ПараметрыПечати);
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ДвоичныеДанные", Новый ОписаниеТипов("ДвоичныеДанные"));
	
	Для Каждого ПечатнаяФорма Из СформированныеПечатныеФормы.КоллекцияПечатныхФорм Цикл
		ОфисныеДокументы = ЗначениеСвойстваПечатнойФормы(
				ПечатнаяФорма,
				"ОфисныеДокументы");
		Если ЗначениеЗаполнено(ОфисныеДокументы) Тогда
			Для Каждого ОфисныйДокумент Из ОфисныеДокументы Цикл
				ФайлПечатнойФормы = Результат.Добавить();
				ФайлПечатнойФормы.ИмяФайла = ОфисныйДокумент.Значение;
				ФайлПечатнойФормы.ДвоичныеДанные = ПолучитьИзВременногоХранилища(ОфисныйДокумент.Ключ);
				УдалитьИзВременногоХранилища(ОфисныйДокумент.Ключ);
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ПечатнаяФорма.ТабличныйДокумент) <> Тип("ТабличныйДокумент")
			ИЛИ ПечатнаяФорма.ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// BSLLS:FileSystemAccess-off
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");
		ПечатнаяФорма.ТабличныйДокумент.Записать(
			ИмяВременногоФайла,
			ТипФайлаТабличногоДокумента.PDF);
		
		ФайлПечатнойФормы = Результат.Добавить();
		ФайлПечатнойФормы.ИмяФайла = ИмяФайлаПечатнойФормы(
				ПечатнаяФорма,
				КомандаПечатиДляФормирования,
				Владелец);
		ФайлПечатнойФормы.ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
		// BSLLS:UsingSynchronousCalls-off
		УдалитьФайлы(ИмяВременногоФайла);
		// BSLLS:UsingSynchronousCalls-on
		// BSLLS:FileSystemAccess-on
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяФайлаПечатнойФормы(ПечатнаяФорма, КомандаПечати, Владелец)
	
	СинонимМакета = ЗначениеСвойстваПечатнойФормы(ПечатнаяФорма, "СинонимМакета");
	ИмяФайлаПечатнойФормы = ЗначениеСвойстваПечатнойФормы(
			ПечатнаяФорма,
			"ИмяФайлаПечатнойФормы");
	
	ИмяФайла = Неопределено;
	ЗаполнитьИмяФайлаПечатнойФормыПоПравиламБСП(
		Владелец,
		ИмяФайлаПечатнойФормы,
		СинонимМакета,
		ИмяФайла);
	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		ИмяФайла = КомандаПечати.Представление;
		Если ЗначениеЗаполнено(СинонимМакета) Тогда
			ИмяФайла = СинонимМакета;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НормализованноеИмяФайлаПечатнойФормы(ИмяФайла + ".pdf");
	
КонецФункции

Процедура ЗаполнитьИмяФайлаПечатнойФормыПоПравиламБСП(
		Владелец,
		ИмяФайлаПечатнойФормы,
		СинонимМакета,
		ИмяФайла)
	
	Попытка
		МодульУправлениеПечатью = СтдОбщегоНазначения().ОбщийМодульЛок("УправлениеПечатью");
		ИмяФайла = МодульУправлениеПечатью.ИмяФайлаПечатнойФормыОбъекта(
				Владелец,
				ИмяФайлаПечатнойФормы,
				СинонимМакета);
	Исключение
		ИмяФайла = Неопределено;
	КонецПопытки;
	
КонецПроцедуры

Функция НормализованноеИмяФайлаПечатнойФормы(ИмяФайла)
	
	Попытка
		МодульОбщегоНазначенияКлиентСервер = СтдОбщегоНазначения().ОбщийМодульЛок("ОбщегоНазначенияКлиентСервер");
		Возврат МодульОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайла);
	Исключение
		Возврат ИмяФайла;
	КонецПопытки;
	
КонецФункции

Функция ЗначениеСвойстваПечатнойФормы(ПечатнаяФорма, ИмяСвойства)
	
	Попытка
		Возврат ПечатнаяФорма[ИмяСвойства];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Возвращает команду печати в формате, пригодном для формирования файла.
//
// Параметры:
//  КомандаПечати - СтрокаТаблицыЗначений, Структура - Команда печати БСП.
//
// Возвращаемое значение:
//  Структура - Команда печати с учетом идентификатора в комплекте.
Функция КомандаПечатиДляФормирования(КомандаПечати) Экспорт
	
	КомандаПечатиВФайл = Новый Структура;
	Для Каждого КлючИЗначение Из КомандаПечати Цикл
		КомандаПечатиВФайл.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	Если КомандаПечатиВФайл.Свойство("ДополнительныеПараметры")
		И КомандаПечатиВФайл.ДополнительныеПараметры.Свойство("ИдентификаторВКомплекте")
		И ЗначениеЗаполнено(КомандаПечатиВФайл.ДополнительныеПараметры.ИдентификаторВКомплекте) Тогда
		КомандаПечатиВФайл.Идентификатор = КомандаПечатиВФайл.ДополнительныеПараметры.ИдентификаторВКомплекте;
	КонецЕсли;
	
	Возврат КомандаПечатиВФайл;
	
КонецФункции

// Возвращает команду печати по описанию выбранной строки формы подбора.
//
// Параметры:
//  ОписаниеВыбора - Структура - Описание выбранной печатной формы.
//
// Возвращаемое значение:
//  Структура, Неопределено - Команда печати для формирования.
Функция КомандаПечати(ОписаниеВыбора) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ОписаниеВыбора.Владелец)
		ИЛИ НЕ ЗначениеЗаполнено(ОписаниеВыбора.ИдентификаторКомандыПечати) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаКомандыПечати = Неопределено;
	Для Каждого КомандаПечати Из ДоступныеКомандыПечати(ОписаниеВыбора.Владелец) Цикл
		Если КомандаПечати.Идентификатор = ОписаниеВыбора.ИдентификаторКомандыПечати Тогда
			СтрокаКомандыПечати = КомандаПечати;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаКомандыПечати = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КомандаПечати = Новый Структура;
	Для Каждого Колонка Из СтрокаКомандыПечати.Владелец().Колонки Цикл
		КомандаПечати.Вставить(Колонка.Имя, СтрокаКомандыПечати[Колонка.Имя]);
	КонецЦикла;
	
	Возврат КомандаПечати;
	
КонецФункции

Функция ОписаниеПрисоединенногоФайлаДляВыбора(ДанныеФайла, ВладелецФайлов)
	
	Результат = НовоеОписаниеФайлаДляВыбора();
	Результат.ВидСтроки = "ПрисоединенныйФайл";
	Результат.Представление = ДанныеФайла.ИмяФайла;
	Результат.Источник = ДанныеФайла.Ссылка;
	Результат.Владелец = ВладелецФайлов;
	Результат.ИмяФайла = ДанныеФайла.ИмяФайла;
	Результат.Размер = ДанныеФайла.Размер;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеПечатнойФормыДляВыбора(КомандаПечати, ВладелецФайлов)
	
	Результат = НовоеОписаниеФайлаДляВыбора();
	Результат.ВидСтроки = "ПечатнаяФорма";
	Результат.Представление = КомандаПечати.Представление;
	Результат.Владелец = ВладелецФайлов;
	Результат.ИдентификаторКомандыПечати = КомандаПечати.Идентификатор;
	Результат.МенеджерПечати = КомандаПечати.МенеджерПечати;
	
	Возврат Результат;
	
КонецФункции

Функция НовоеОписаниеФайлаДляВыбора()
	
	Результат = Новый Структура;
	Результат.Вставить("ВидСтроки", "");
	Результат.Вставить("Представление", "");
	Результат.Вставить("Источник", Неопределено);
	Результат.Вставить("Владелец", Неопределено);
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("Размер", 0);
	Результат.Вставить("ИдентификаторКомандыПечати", "");
	Результат.Вставить("МенеджерПечати", "");
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеВыбораФайла(ВыбранныйФайл)
	
	Если ТипЗнч(ВыбранныйФайл) = Тип("Структура") Тогда
		Возврат ВыбранныйФайл;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ВидСтроки", "ПрисоединенныйФайл");
	Результат.Вставить("Источник", ВыбранныйФайл);
	Результат.Вставить("Владелец", Неопределено);
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("Представление", Строка(ВыбранныйФайл));
	Результат.Вставить("ИдентификаторКомандыПечати", "");
	Результат.Вставить("МенеджерПечати", "");
	
	Возврат Результат;
	
КонецФункции

