#Область СлужебныйПрограммныйИнтерфейс

Функция ОбновитьРасширениеКонтурДиадок() Экспорт
	
	Возврат КонтурДиадокОбновлениеСервер.ОбновитьРасширениеКонтурДиадок();
	
КонецФункции

// Проверяет, включён ли безопасный режим у расширения Контур.Диадок
//
// Возвращаемое значение:
//  - Булево - Истина, если безопасный режим установлен
//
Функция УстановленБезопасныйРежимРасширения() Экспорт

    Расширение = КонтурДиадокОбновлениеСервер.РасширениеКонфигурацииКонтурДиадок();
	Если Расширение = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
	
	Возврат (Расширение.БезопасныйРежим <> Ложь);
		
КонецФункции

#КонецОбласти