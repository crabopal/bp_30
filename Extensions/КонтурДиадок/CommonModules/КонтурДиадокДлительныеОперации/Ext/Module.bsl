// Выполняет команду обработки и помещает результат во временное хранилище.
//
// Параметры:
//  ИдентификаторКоманды - Строка - идентификатор команды обработки
//  ПараметрыКоманды	 - Структура - параметры команды (см. Ядро.ДлительныеОперации_ПараметрыВыполненияКоманды())
//  АдресРезультата		 - Строка - адрес временного хранилища
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыКоманды, АдресРезультата) Экспорт
	
	ОбработкаОбъект = Обработки["КонтурДиадокЯдро"].Создать();
	ОбработкаОбъект.ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыКоманды);
	
	Если ТипЗнч(АдресРезультата) = Тип("Строка") И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		АдресРезультата = ПоместитьВоВременноеХранилище(ПараметрыКоманды.РезультатВыполнения, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

#Если Сервер Тогда

// Настраивает доступ к только что установленному CFE в новом сеансе.
//
// Параметры:
//  ВыбранныеПользователи - Массив - выбранные пользователи БСП.
//  АдресРезультата - Строка - адрес результата во временном хранилище.
Процедура НастроитьДоступПослеУстановки(ВыбранныеПользователи, АдресРезультата) Экспорт
	
	ИмяНастройки = "Модуль Диадок";
	Результат = Новый Структура("Состояние,КоличествоПользователей", "НеВыбраныПользователи", 0);
	Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение "Для настройки доступа нужны административные права.";
	КонецЕсли;
	Если НЕ ДоступнаАвтоматическаяНастройкаДоступа() Тогда
		ВызватьИсключение
			"Конфигурация не поддерживает автоматическую настройку доступа расширения через БСП.";
	КонецЕсли;
	ПользователиГруппы = ПользователиДоступаИнсталлятора(ВыбранныеПользователи);
	НачатьТранзакцию();
	Попытка
		Роль = ИдентификаторРолиДоступаИнсталлятора();
		Профиль = ОбъектНастройкиДоступаИнсталлятора("ПрофилиГруппДоступа", "КонтурДиадок.Инсталлятор.Профиль");
		ПрофильИзменен = Профиль.ЭтоНовый() ИЛИ Профиль.Наименование <> ИмяНастройки
			ИЛИ НЕ ЗначениеЗаполнено(Профиль.Комментарий);
		Если НЕ ЗначениеЗаполнено(Профиль.Комментарий) Тогда
			Профиль.Комментарий = "КонтурДиадок.Инсталлятор.Профиль";
		КонецЕсли;
		ПрофильИзменен = НастроитьРольПрофиляУстановщика(Профиль, Роль) ИЛИ ПрофильИзменен;
		Если ПрофильИзменен Тогда
			Профиль.Наименование = ИмяНастройки;
			Профиль.Записать();
		КонецЕсли;
		Группа = ОбъектНастройкиДоступаИнсталлятора("ГруппыДоступа", "КонтурДиадок.Инсталлятор.Группа");
		Если НЕ Группа.ЭтоНовый() И Группа.Профиль <> Профиль.Ссылка Тогда
			ВызватьИсключение "Группа доступа Диадока связана с другим профилем.";
		КонецЕсли;
		ГруппаИзменена = Группа.ЭтоНовый() ИЛИ Группа.Наименование <> ИмяНастройки
			ИЛИ НЕ ЗначениеЗаполнено(Группа.Комментарий);
		Если НЕ ЗначениеЗаполнено(Группа.Комментарий) Тогда
			Группа.Комментарий = "КонтурДиадок.Инсталлятор.Группа";
		КонецЕсли;
		Группа.Наименование = ИмяНастройки;
		Группа.Профиль = Профиль.Ссылка;
		ГруппаИзменена = ДобавитьПользователейГруппыУстановщика(Группа, ПользователиГруппы) ИЛИ ГруппаИзменена;
		Если ГруппаИзменена Тогда
			Группа.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	// Профиль и группа сохранены. Обновление пользователей ИБ выполняется отдельно.
	Попытка
		МодульУправлениеДоступом = Вычислить("УправлениеДоступом");
		МодульУправлениеДоступом.ОбновитьРолиПользователей(ПользователиГруппы);
		Если ПользователиГруппы.Количество() > 0 Тогда
			Результат.Состояние = "Настроено";
		КонецЕсли;
	Исключение
		Результат.Состояние = "ОшибкаОбновленияРолей";
		Результат.Вставить("Ошибка", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Результат.КоличествоПользователей = ПользователиГруппы.Количество();
	Результат.Вставить("Профиль", Профиль.Ссылка);
	Результат.Вставить("Группа", Группа.Ссылка);
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

Функция ДоступнаАвтоматическаяНастройкаДоступа()
	ИменаСправочников = Новый Структура(
		"ПрофилиГруппДоступа,ГруппыДоступа,Пользователи,ИдентификаторыОбъектовРасширений");
	Для Каждого ИмяСправочника Из ИменаСправочников Цикл
		Если Метаданные.Справочники.Найти(ИмяСправочника.Ключ) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	ИменаМодулей = Новый Структура("ОбщегоНазначения,Пользователи,УправлениеДоступом");
	Для Каждого ИмяМодуля Из ИменаМодулей Цикл
		Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля.Ключ) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Метаданные.РегистрыСведений.Найти("ПараметрыРаботыВерсийРасширений") <> Неопределено
	И Метаданные.Справочники.ПрофилиГруппДоступа.ТабличныеЧасти.Найти("Роли") <> Неопределено
	И Метаданные.Справочники.ГруппыДоступа.ТабличныеЧасти.Найти("Пользователи") <> Неопределено
	И Метаданные.Справочники.ГруппыДоступа.Реквизиты.Найти("Профиль") <> Неопределено
	И Метаданные.Справочники.Пользователи.Реквизиты.Найти("ИдентификаторПользователяИБ") <> Неопределено;
КонецФункции

Функция ПользователиДоступаИнсталлятора(ВыбранныеПользователи)
	МодульПользователи = Вычислить("Пользователи");
	ДанныеВыбора = МодульПользователи.СформироватьДанныеВыбораПользователя("", Ложь, Ложь, Ложь);
	ПользователиГруппы = Новый Массив;
	Для Каждого Пользователь Из ВыбранныеПользователи Цикл
		Если ДанныеВыбора.НайтиПоЗначению(Пользователь) = Неопределено
			ИЛИ НЕ ЗначениеЗаполнено(Пользователь) ИЛИ Пользователь.ПометкаУдаления Тогда
			ВызватьИсключение "Выбранный пользователь БСП больше недоступен для настройки доступа.";
		КонецЕсли;
		Если ПользователиГруппы.Найти(Пользователь) = Неопределено Тогда
			ПользователиГруппы.Добавить(Пользователь);
		КонецЕсли;
	КонецЦикла;
	Возврат ПользователиГруппы;
КонецФункции

Функция ИдентификаторРолиДоступаИнсталлятора()
	МенеджерРасширений = Вычислить("РасширенияКонфигурации");
	Расширения = МенеджерРасширений.Получить(Новый Структура("Имя", "КонтурДиадок"));
	Если Расширения.Количество() <> 1 Тогда
		ВызватьИсключение "Установленное расширение Диадока не найдено.";
	КонецЕсли;
	Расширение = Расширения[0];
	Если НЕ Расширение.Активно Тогда
		ВызватьИсключение "Для настройки доступа сначала установите и включите расширение Диадока.";
	КонецЕсли;
	РольМетаданных = Метаданные.Роли.Найти("КонтурДиадокПользователь");
	Если РольМетаданных = Неопределено Тогда
		ВызватьИсключение "В новом сеансе не подключена роль пользователя Диадока из установленного расширения.";
	КонецЕсли;
	РасширениеРоли = РольМетаданных.РасширениеКонфигурации();
	Если РасширениеРоли = Неопределено ИЛИ РасширениеРоли.Имя <> Расширение.Имя Тогда
		ВызватьИсключение "Роль пользователя Диадока не принадлежит установленному расширению.";
	КонецЕсли;
	// БСП сама заполняет ключ роли и данные текущей версии расширений.
	Справочники["ИдентификаторыОбъектовРасширений"].ОбновитьДанныеСправочника();
	МодульОбщегоНазначения = Вычислить("ОбщегоНазначения");
	Роль = МодульОбщегоНазначения.ИдентификаторОбъектаМетаданных(РольМетаданных);
	Если ТипЗнч(Роль) <> Тип("СправочникСсылка.ИдентификаторыОбъектовРасширений") Тогда
		ВызватьИсключение "Роль пользователя Диадока не принадлежит расширению.";
	КонецЕсли;
	Если Роль.ИмяРасширения <> Расширение.Имя ИЛИ Роль.ПолноеИмя <> РольМетаданных.ПолноеИмя() Тогда
		ВызватьИсключение "Идентификатор роли пользователя Диадока не соответствует установленному расширению.";
	КонецЕсли;
	Возврат Роль;
КонецФункции

Функция ОбъектНастройкиДоступаИнсталлятора(ИмяСправочника, Отметка)
	
	ИмяНастройки = "Модуль Диадок";
	Блокировка = Новый БлокировкаДанных;
	Блокировка.Добавить("Справочник." + ИмяСправочника);
	Блокировка.Заблокировать();
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Комментарий ИЗ Справочник." + ИмяСправочника
		+ " ГДЕ НЕ ЭтоГруппа И НЕ ПометкаУдаления
		|И (Наименование = &Наименование ИЛИ ВЫРАЗИТЬ(Комментарий КАК СТРОКА(128)) = &Отметка)");
	Запрос.УстановитьПараметр("Наименование", ИмяНастройки);
	Запрос.УстановитьПараметр("Отметка", Отметка);
	Кандидаты = Новый Массив;
	Для Каждого СтрокаНастройки Из Запрос.Выполнить().Выгрузить() Цикл
		Если СтрокаНастройки.Ссылка.Наименование = ИмяНастройки ИЛИ СтрокаНастройки.Комментарий = Отметка Тогда
			Кандидаты.Добавить(СтрокаНастройки.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Если Кандидаты.Количество() > 1 Тогда
		ВызватьИсключение "Найдено несколько профилей или групп Модуль Диадок. Проверьте настройки доступа.";
	КонецЕсли;
	Если Кандидаты.Количество() = 0 Тогда
		Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
	Иначе
		Объект = Кандидаты[0].ПолучитьОбъект();
	КонецЕсли;
	Возврат Объект;
	
КонецФункции

// Добавляет роль установщика, если ее еще нет, и сохраняет существующий состав профиля.
//
// Параметры:
//  Профиль - СправочникОбъект.ПрофилиГруппДоступа - настраиваемый профиль.
//  Роль - СправочникСсылка.ИдентификаторыОбъектовРасширений - целевая роль.
//
// Возвращаемое значение:
//  Булево - состав ролей профиля изменен.
Функция НастроитьРольПрофиляУстановщика(Профиль, Роль)
	Если Профиль.Роли.Найти(Роль, "Роль") <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Профиль.Роли.Добавить().Роль = Роль;
	Возврат Истина;
КонецФункции

// Добавляет выбранных пользователей, сохраняя существующих участников группы.
//
// Параметры:
//  Группа - СправочникОбъект.ГруппыДоступа - настраиваемая группа.
//  ПользователиГруппы - Массив - выбранные пользователи БСП.
//
// Возвращаемое значение:
//  Булево - состав участников группы изменен.
Функция ДобавитьПользователейГруппыУстановщика(Группа, ПользователиГруппы)
	Изменена = Ложь;
	Для Каждого Пользователь Из ПользователиГруппы Цикл
		Если Группа.Пользователи.Найти(Пользователь, "Пользователь") = Неопределено Тогда
			Группа.Пользователи.Добавить().Пользователь = Пользователь;
			Изменена = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Изменена;
КонецФункции

#КонецЕсли
